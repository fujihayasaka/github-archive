{
  "$schema": "http://json-schema.org/draft-04/hyper-schema",
  "id": "https://schema.github.com/v3/extended-enterprise-scim-user.json",
  "title": "SCIM /Users",
  "description": "SCIM /Users provisioning endpoints",
  "type": "object",
  "definitions": {
    "schemas": {
      "description": "SCIM schema used.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "example": "urn:ietf:params:scim:schemas:core:2.0:User"
      }
    },
    "id": {
      "description": "Unique identifier of an external identity",
      "example": "1b78eada-9baa-11e6-9eb6-a431576d590e",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "enterprise_id": {
      "description": "The ID of the enterprise.",
      "type": "integer"
    },
    "externalId": {
      "description": "The ID of the User.",
      "type": "string",
      "example": "a7b0f98395"
    },
    "active": {
      "description": "The active status of the User.",
      "type": "boolean",
      "example": true
    },
    "Operations": {
      "description": "Set of operations to be performed",
      "example": [
        {
          "op": "replace",
          "value": {
            "active": false
          }
        }
      ],
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "Add",
              "remove",
              "Remove",
              "replace",
              "Replace"
            ],
            "description": "The patch operation to perform."
          },
          "path": {
            "type": "string",
            "description": "The path of the attribute to modify (e.g., userName, name.givenName).",
            "oneOf": [
              {
                "enum": [
                  "userName",
                  "externalId",
                  "active",
                  "displayName",
                  "name",
                  "name.givenName",
                  "name.familyName",
                  "name.formatted",
                  "roles",
                  "emails"
                ]
              },
              {
                "pattern": "^emails\\[type eq \\\".*\\\"\\].value$"
              },
              {
                "pattern": "^(?!userName|externalId|active|displayName|name|roles|emails|groups).*$"
              }
            ]
          },
          "value": {
            "oneOf": [
              {
                "$ref": "#/definitions/stringValue"
              },
              {
                "$ref": "#/definitions/booleanValue"
              },
              {
                "$ref": "#/definitions/objectValue"
              },
              {
                "$ref": "#/definitions/emailsArray"
              },
              {
                "$ref": "#/definitions/rolesArray"
              }
            ]
          }
        },
        "required": [
          "op"
        ]
      }
    },
    "userName": {
      "description": "Configured by the admin. Could be an email, login, or username",
      "example": "someone@example.com",
      "type": "string"
    },
    "displayName": {
      "description": "The name of the user, suitable for display to end-users",
      "example": "Jon Doe",
      "type": "string"
    },
    "name": {
      "type": "object",
      "properties": {
        "givenName": {
          "type": [
            "string",
            "null"
          ]
        },
        "familyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "formatted": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [],
      "example": "Jane User"
    },
    "emails": {
      "description": "user emails",
      "example": [
        "someone@example.com",
        "another@example.com"
      ],
      "type": "array",
      "minItems": 1,
      "items": {
        "properties": {
          "value": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          }
        },
        "required": [
          "value"
        ]
      }
    },
    "roles": {
      "description": "user roles",
      "example": [
        "user",
        "enterprise_owner"
      ],
      "type": "array",
      "items": {
        "properties": {
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary": {
            "type": "boolean"
          }
        },
        "required": [
          "value"
        ]
      }
    },
    "groups": {
      "description": "associated groups",
      "type": "array",
      "items": {
        "properties": {
          "value": {
            "type": "string"
          },
          "display": {
            "type": "string"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "resourceType": {
          "type": "string",
          "example": "User"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "example": "2019-01-24T22:45:36.000Z"
        },
        "lastModified": {
          "type": "string",
          "format": "date-time",
          "example": "2019-01-24T22:45:36.000Z"
        },
        "location": {
          "type": "string",
          "format": "uri",
          "example": "https://api.github.com/scim/v2/enterprises/myorg-123abc55141bfd8f/Users/c42772b5-2029-11e9-8543-9264a97dec8d"
        }
      }
    },
    "stringValue": {
      "type": "string",
      "description": "The value for simple attributes (e.g., userName)."
    },
    "booleanValue": {
      "type": "boolean",
      "description": "Value can be a boolean (true/false)"
    },
    "objectValue": {
      "type": "object",
      "description": "Value can be an object",
      "additionalProperties": true,
      "properties": {
        "password": {
          "type": "string",
          "description": "The password value to set for the attribute, this is removed in SCIM."
        },
        "displayName": {
          "type": "string",
          "description": "The name of the user, suitable for display to end-users."
        },
        "active": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "The active status of the User."
        },
        "userName": {
          "type": "string",
          "description": "Configured by the admin. Could be an email, login, or username."
        },
        "externalId": {
          "type": "string",
          "description": "The ID of the User."
        },
        "givenName": {
          "type": "string",
          "description": "The given name of the user, or first name in the case of a person."
        },
        "familyName": {
          "type": "string",
          "description": "The surname of the user, or last name in the case of a person."
        },
        "formatted": {
          "type": "string",
          "description": "The full name, including all middle names, titles, and suffixes as appropriate, formatted for display (e.g., 'Mr. John Q. Public, III')."
        }
      }
    },
    "emailsArray": {
      "type": "array",
      "minItems": 1,
      "description": "Value can be an array of emails",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "primary": {
            "type": "boolean",
            "description": "Indicates whether this email or roles is the primary value."
          },
          "value": {
            "type": "string",
            "description": "The value to set for the attribute."
          },
          "type": {
            "type": "string",
            "enum": [
              "work",
              "home",
              "other"
            ],
            "description": "The type of email address (only used if modifying emails)."
          }
        },
        "required": [
          "value"
        ]
      }
    },
    "rolesArray": {
      "type": "array",
      "minItems": 1,
      "description": "Value can be an array of roles",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "primary": {
            "type": "boolean",
            "description": "Indicates whether this roles is the primary."
          },
          "display": {
            "type": "string",
            "description": "A human-readable name, primarily used for display purposes."
          },
          "value": {
            "type": "string",
            "description": "The value to set for the attribute."
          },
          "type": {
            "type": "string",
            "description": "The type of a role (only used if modifying roles)."
          }
        },
        "required": [
          "value",
          "display"
        ]
      }
    }
  },
  "links": [
    {
      "title": "Update a user attribute",
      "href": "/scim/v2/enterprises/{enterprise_id}/Users/{external_identity_guid}",
      "method": "PATCH",
      "rel": "patch",
      "schema": {
        "properties": {
          "Operations": {
            "$ref": "#/definitions/Operations"
          }
        },
        "required": [
          "Operations"
        ],
        "type": "object"
      }
    },
    {
      "href": "/scim/v2/enterprises/{enterprise_id}/Users",
      "method": "POST",
      "rel": "provision",
      "title": "Provision a user",
      "schema": {
        "properties": {
          "userName": {
            "$ref": "#/definitions/userName"
          },
          "displayName": {
            "$ref": "#/definitions/displayName"
          },
          "name": {
            "$ref": "#/definitions/name"
          },
          "emails": {
            "$ref": "#/definitions/emails"
          },
          "groups": {
            "$ref": "#/definitions/groups"
          },
          "roles": {
            "$ref": "#/definitions/roles"
          }
        },
        "required": [
          "userName"
        ],
        "type": "object"
      }
    },
    {
      "title": "Update a provisioned enterprise membership",
      "href": "/scim/v2/enterprises/{enterprise_id}/Users/{external_identity_guid}",
      "method": "PUT",
      "rel": "update",
      "schema": {
        "properties": {
          "userName": {
            "$ref": "#/definitions/userName"
          },
          "displayName": {
            "$ref": "#/definitions/displayName"
          },
          "name": {
            "$ref": "#/definitions/name"
          },
          "emails": {
            "$ref": "#/definitions/emails"
          },
          "groups": {
            "$ref": "#/definitions/groups"
          },
          "roles": {
            "$ref": "#/definitions/roles"
          }
        },
        "required": [
          "userName"
        ],
        "type": "object"
      }
    },
    {
      "title": "Remove a user from the enterprise",
      "method": "DELETE",
      "rel": "deprovision",
      "href": "/scim/v2/enterprises/{enterprise_id}/Users/{external_identity_guid}",
      "schema": {
        "additionalProperties": false,
        "type": [
          "object",
          "null"
        ]
      }
    }
  ],
  "properties": {
    "schemas": {
      "$ref": "#/definitions/schemas"
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "enterprise_id": {
      "$ref": "#/definitions/enterprise_id"
    },
    "externalId": {
      "$ref": "#/definitions/externalId"
    },
    "operations": {
      "$ref": "#/definitions/Operations"
    },
    "userName": {
      "$ref": "#/definitions/userName"
    },
    "displayName": {
      "$ref": "#/definitions/displayName"
    },
    "name": {
      "$ref": "#/definitions/name"
    },
    "emails": {
      "$ref": "#/definitions/emails"
    },
    "active": {
      "$ref": "#/definitions/active"
    },
    "groups": {
      "$ref": "#/definitions/groups"
    },
    "roles": {
      "$ref": "#/definitions/roles"
    },
    "meta": {
      "$ref": "#/definitions/meta"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "schemas",
    "externalId",
    "userName",
    "name",
    "emails",
    "active",
    "meta"
  ]
}
