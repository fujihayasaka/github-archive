{
  "$schema": "http://json-schema.org/draft-04/hyper-schema",
  "id": "https://schema.github.com/v3/issue-assignee.json",
  "title": "Issue Assignee",
  "description": "Someone assigned to an issue",
  "type": "object",
  "definitions": {
    "assignees": {
      "description": "The usernames of assignees on an issue.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "example": [
        "hubot",
        "github"
      ]
    },
    "target_repo": {
      "description": "The target repository for cross-repo Copilot assignments in the format 'owner/repo'. Only used when assigning Copilot bot.",
      "type": "string",
      "example": "octocat/hello-world"
    },
    "base_branch": {
      "description": "The base branch to use for Copilot's pull request. Only used when assigning Copilot bot.",
      "type": "string",
      "example": "main"
    },
    "custom_instructions": {
      "description": "Custom instructions to provide to Copilot for solving the issue. Only used when assigning Copilot bot.",
      "type": "string"
    },
    "custom_agent": {
      "description": "Custom agent to use for Copilot assignment. Only used when assigning Copilot bot.",
      "type": "string"
    },
    "model": {
      "description": "The model to use for Copilot's code generation. Only used when assigning Copilot bot.",
      "type": "string",
      "example": "gpt-4o"
    },
    "agent_assignment": {
      "description": "Configuration for Copilot agent assignment. Only used when assigning Copilot bot.",
      "type": "object",
      "properties": {
        "target_repo": {
          "$ref": "#/definitions/target_repo"
        },
        "base_branch": {
          "$ref": "#/definitions/base_branch"
        },
        "custom_instructions": {
          "$ref": "#/definitions/custom_instructions"
        },
        "custom_agent": {
          "$ref": "#/definitions/custom_agent"
        },
        "model": {
          "$ref": "#/definitions/model"
        }
      },
      "additionalProperties": false
    },
    "owner": {
      "description": "The owner of the repository.",
      "type": "string"
    },
    "repo": {
      "description": "The name of the repository.",
      "type": "string"
    },
    "repository_id": {
      "description": "The ID of the repository.",
      "type": "integer",
      "example": 42
    },
    "issue_number": {
      "description": "The number of the issue.",
      "type": "integer"
    }
  },
  "links": [
    {
      "title": "Add assignees to an issue",
      "method": "POST",
      "rel": "create",
      "href": "/repositories/{repository_id}/issues/{issue_number}/assignees",
      "schema": {
        "properties": {
          "assignees": {
            "$ref": "#/definitions/assignees"
          },
          "agent_assignment": {
            "$ref": "#/definitions/agent_assignment"
          }
        },
        "additionalProperties": false,
        "type": [
          "object",
          "null"
        ]
      }
    },
    {
      "title": "Remove assignees from an issue",
      "method": "DELETE",
      "rel": "delete",
      "href": "/repositories/{repository_id}/issues/{issue_number}/assignees",
      "schema": {
        "properties": {
          "assignees": {
            "$ref": "#/definitions/assignees"
          }
        },
        "additionalProperties": false,
        "type": [
          "object",
          "null"
        ]
      }
    }
  ]
}
