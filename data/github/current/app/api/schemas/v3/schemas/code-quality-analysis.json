{
  "$schema": "http://json-schema.org/draft-04/hyper-schema",
  "additionalProperties": false,
  "definitions": {
    "commit_oid": {
      "example": "f921edcc74d6b492ec068f5aa02b0e9a2cd45f5b",
      "maxLength": 40,
      "minLength": 40,
      "pattern": "^[0-9a-f]+$",
      "type": "string"
    },
    "ref": {
      "example": "refs/heads/master",
      "pattern": "^refs/(heads|pull|tags)/.*$",
      "type": "string"
    },
    "sarif": {
      "type": "string"
    }
  },
  "id": "https://schema.github.com/v3/code-quality-analysis.json",
  "links": [
    {
      "href": "/repositories/{repository_id}/code-quality/analysis",
      "method": "PUT",
      "rel": "upload-analysis",
      "schema": {
        "additionalProperties": true,
        "properties": {
          "commit_oid": {
            "$ref": "#/definitions/commit_oid"
          },
          "ref": {
            "$ref": "#/definitions/ref"
          },
          "sarif": {
            "$ref": "#/definitions/sarif"
          }
        },
        "required": [
          "commit_oid",
          "ref",
          "sarif"
        ],
        "type": "object"
      },
      "title": "Upload a new analysis"
    }
  ],
  "type": "object"
}
