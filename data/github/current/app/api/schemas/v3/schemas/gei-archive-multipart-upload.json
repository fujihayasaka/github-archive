{
  "$schema": "http://json-schema.org/draft-04/hyper-schema",
  "id": "https://schema.github.com/v3/gei-archive-multipart-upload.json",
  "title": "GeiArchiveMultipartUpload",
  "description": "Migration archives used for GitHub Enterprise Importer (GEI) migrations.",
  "type": "object",
  "definitions": {
    "guid": {
      "description": "The GUID of the migration archive.",
      "example": "049f0f74-6675-4432-a428-a019a7e5e894",
      "type": "string"
    },
    "organization_id": {
      "description": "The ID of the organization.",
      "example": 159,
      "type": "integer"
    },
    "name": {
      "description": "The name of the migration archive.",
      "example": "gei_archive.tar.gz",
      "type": "string"
    },
    "size": {
      "description": "The size of the archive, in bytes.",
      "example": 12,
      "type": "integer"
    },
    "content_type": {
      "description": "The content type of the request.",
      "default": "application/octet-stream",
      "example": "application/octet-stream",
      "type": "string"
    },
    "part_number": {
      "description": "The number of the part being uploaded.",
      "example": 12,
      "type": "integer"
    },
    "upload_id": {
      "description": "The multipart upload ID for uploading parts.",
      "example": "7rYES.KaBwJQdcEDKDMMAUTn33BFT0kSx89n11TP0p6Qtqdo5j0XgeX6UPZlokzAEj8I0li_SZaijKMD52IenKRy9J_3kpZPA6M8H0KOAWBIhEQGcvr02y0x2LIeVxP8",
      "type": "string"
    },
    "sha256": {
      "description": "The SHA256 sum of the request body.",
      "example": "29b16ba558d9a2c5a1544fcf15c31051587b7ea86e1bb6ccf1ef51fe8421f9f0",
      "type": "string"
    }
  },
  "links": [
    {
      "href": "/internal/organizations/{organization_id}/gei/archive/multi-part/start/policies",
      "method": "POST",
      "rel": "create",
      "title": "Start a multipart migration archive upload.",
      "schema": {
        "properties": {
          "name": {
            "$ref": "#/definitions/name"
          },
          "size": {
            "$ref": "#/definitions/size"
          },
          "content_type": {
            "$ref": "#/definitions/content_type"
          }
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    {
      "href": "/internal/organizations/{organization_id}/gei/archive/multi-part/continue/policies",
      "method": "POST",
      "rel": "continue",
      "title": "Continue a multipart migration archive upload.",
      "schema": {
        "properties": {
          "guid": {
            "$ref": "#/definitions/guid"
          },
          "part_number": {
            "$ref": "#/definitions/part_number"
          },
          "upload_id": {
            "$ref": "#/definitions/upload_id"
          },
          "sha256": {
            "$ref": "#/definitions/sha256"
          }
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "guid",
          "part_number",
          "upload_id",
          "sha256"
        ]
      }
    },
    {
      "href": "/internal/organizations/{organization_id}/gei/archive/multi-part/complete/policies",
      "method": "POST",
      "rel": "complete",
      "title": "Complete a multipart migration archive upload.",
      "schema": {
        "properties": {
          "guid": {
            "$ref": "#/definitions/guid"
          },
          "organization_id": {
            "$ref": "#/definitions/organization_id"
          },
          "part_number": {
            "$ref": "#/definitions/part_number"
          },
          "upload_id": {
            "$ref": "#/definitions/upload_id"
          },
          "sha256": {
            "$ref": "#/definitions/sha256"
          }
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "guid",
          "part_number",
          "upload_id",
          "sha256"
        ]
      }
    }
  ],
  "properties": {
    "guid": {
      "$ref": "#/definitions/guid"
    },
    "organization_id": {
      "$ref": "#/definitions/organization_id"
    },
    "name": {
      "$ref": "#/definitions/name"
    },
    "size": {
      "$ref": "#/definitions/size"
    },
    "upload_id": {
      "$ref": "#/definitions/upload_id"
    },
    "part_number": {
      "$ref": "#/definitions/part_number"
    },
    "content_type": {
      "$ref": "#/definitions/content_type"
    },
    "sha256": {
      "$ref": "#/definitions/sha256"
    }
  },
  "additionalProperties": false
}
