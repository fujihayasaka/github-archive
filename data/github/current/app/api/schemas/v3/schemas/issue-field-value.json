{
  "$schema": "http://json-schema.org/draft-04/hyper-schema",
  "id": "https://schema.github.com/v3/issue-field-value.json",
  "title": "Issue Field Value",
  "description": "Issue field value for an issue",
  "type": "object",
  "definitions": {
    "field_id": {
      "description": "The ID of the issue field",
      "type": "integer",
      "example": 42
    },
    "value": {
      "description": "The value to set for the field",
      "oneOf": [
        {
          "type": "string",
          "description": "The value to set for text, single_select, or date fields"
        },
        {
          "type": "number",
          "description": "The value to set for number fields"
        }
      ]
    },
    "repository_id": {
      "description": "The ID of the repository.",
      "type": "integer",
      "example": 42
    },
    "issue_number": {
      "description": "The number of the issue",
      "type": "integer",
      "example": 1
    }
  },
  "links": [
    {
      "title": "Add issue field values to an issue",
      "method": "POST",
      "rel": "add-issue-field-values",
      "href": "/repositories/{repository_id}/issues/{issue_number}/issue-field-values",
      "schema": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field_id": {
                  "$ref": "#/definitions/field_id"
                },
                "value": {
                  "$ref": "#/definitions/value"
                }
              },
              "required": [
                "field_id",
                "value"
              ],
              "additionalProperties": false
            }
          },
          {
            "type": "object",
            "properties": {
              "issue_field_values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field_id": {
                      "$ref": "#/definitions/field_id"
                    },
                    "value": {
                      "$ref": "#/definitions/value"
                    }
                  },
                  "required": [
                    "field_id",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "issue_field_values"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "title": "Set issue field values for an issue",
      "method": "PUT",
      "rel": "set-issue-field-values",
      "href": "/repositories/{repository_id}/issues/{issue_number}/issue-field-values",
      "schema": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field_id": {
                  "$ref": "#/definitions/field_id"
                },
                "value": {
                  "$ref": "#/definitions/value"
                }
              },
              "required": [
                "field_id",
                "value"
              ],
              "additionalProperties": false
            }
          },
          {
            "type": "object",
            "properties": {
              "issue_field_values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field_id": {
                      "$ref": "#/definitions/field_id"
                    },
                    "value": {
                      "$ref": "#/definitions/value"
                    }
                  },
                  "required": [
                    "field_id",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "issue_field_values"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  ]
}
