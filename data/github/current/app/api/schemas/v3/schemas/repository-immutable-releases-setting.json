{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://schema.github.com/v3/repository-immutable-releases-setting.json",
  "title": "Repository Immutable Releases Settings",
  "description": "Manage the setting for immutable releases on a repository.",
  "links": [
    {
      "title": "Enable immutable releases for a repository.",
      "method": "PUT",
      "rel": "enable",
      "href": "/repositories/{repository_id}/immutable-releases",
      "schema": {
        "properties": {},
        "additionalProperties": false,
        "type": [
          "object",
          "null"
        ]
      }
    },
    {
      "title": "Disable immutable releases for a repository.",
      "method": "DELETE",
      "rel": "disable",
      "href": "/repositories/{repository_id}/immutable-releases",
      "schema": {
        "properties": {},
        "additionalProperties": false,
        "type": [
          "object",
          "null"
        ]
      }
    }
  ]
}
