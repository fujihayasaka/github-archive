{
  "$schema": "http://json-schema.org/draft-04/hyper-schema",
  "id": "https://schema.github.com/v3/code-scanning-alert.json",
  "type": "object",
  "definitions": {
    "manual_state": {
      "description": "Alert states that a user can set an alert to.",
      "example": "open",
      "type": "string",
      "enum": [
        "open",
        "dismissed"
      ]
    },
    "closed_reason": {
      "example": "false positive",
      "type": "string",
      "enum": [
        "false positive",
        "won't fix",
        "used in tests"
      ]
    },
    "dismissed_comment": {
      "example": "This alert is not actually correct, because there's a sanitizer included in the library.",
      "type": "string",
      "maxLength": 280
    },
    "create_request": {
      "description": "If true, attempt to create an alert dismissal request.",
      "example": true,
      "type": "boolean"
    },
    "assignees": {
      "x-unpublished": true,
      "description": "The list of users to assign to the code scanning alert. An empty array unassigns all previous assignees from the alert.",
      "example": [
        "octocat",
        "monalisa"
      ],
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      }
    }
  },
  "links": [
    {
      "title": "Set the status of an alert",
      "method": "PATCH",
      "rel": "set-alert-status",
      "href": "/repositories/{repository_id}/code-scanning/alerts/{alert_number}",
      "schema": {
        "properties": {
          "state": {
            "$ref": "#/definitions/manual_state"
          },
          "dismissed_reason": {
            "$ref": "#/definitions/closed_reason"
          },
          "dismissed_comment": {
            "$ref": "#/definitions/dismissed_comment"
          },
          "create_request": {
            "$ref": "#/definitions/create_request"
          },
          "assignees": {
            "$ref": "#/definitions/assignees"
          }
        },
        "anyOf": [
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "assignees"
            ]
          }
        ],
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
  "additionalProperties": false
}
