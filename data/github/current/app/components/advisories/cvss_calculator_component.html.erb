<cvss-calculator
  data-target="<%= calculator_target %>"
  data-action="vectorStringSelectionChange:severity-selection-next#handleCalculatorSelectionChanged"
  data-validation-json-hash="<%= json_validation_hash.to_json %>"
  data-default-vector-string="<%= default_vector_string %>"
  data-cvss-version-preamble="<%= cvss_version_preamble %>"
  data-is-cvss-v4="<%= is_cvss_v4 %>"
  <%= "hidden" if hidden? %>
>
  <%= render Primer::Beta::Link.new(href: score_documentation_url, target: "_blank", rel: "noopener noreferrer", display: :inline_block, font_size: 6, mt: 2, mx: [nil, nil, 2], test_selector: "cvss-score-documentation-link") do %>
    Learn more about CVSS scoring
  <% end %>
  <div class="d-flex flex-wrap mt-2 mx-md-2 mb-n2">
    <div class="col-12 col-lg-6">
      <% metrics_to_render.each do |metric| %>
        <% metric.each_key do |metric_category| %>
          <% metric[metric_category].each do |metric_sub_category| %>
            <%= render Advisories::MetricSelectionFieldNextComponent.new(metric_sub_category: metric_sub_category, metric_selection_classes: "mr-lg-4") %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</cvss-calculator>
