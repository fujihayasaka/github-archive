<% if enablement_blocked? %>
  <%= render(Primer::Alpha::Banner.new(scheme: :danger, test_selector: "code-security-disabled-metered-usage")) { "Enablement for GitHub Code Security features is locked for new repositories due to a billing issue. Once resolved, it may take a few minutes for changes to apply." } %>
<% end %>

<%= render Primer::Box.new(display: :flex, justify_content: :space_between, align_items: :center, border: :bottom, mt: 3, pb: 2, test_selector: "code-security-section-head") do %>
  <%= render(Primer::Beta::Heading.new(tag: :h3)) { "Code Security" } %>
  <% if show_button? %>
    <% if @button_disabled %>
      <div <%= test_selector("locked-code-security-button") %>>
        <%= render Primer::Beta::Octicon.new(:"shield-lock", color: :muted, test_selector: "shield-icon") %>
        <%= code_security_enabled ? "Enabled" : "Disabled" %>
      </div>
    <% else %>
      <%= render CodeSecurity::EnableDisableComponent.new(
        repository: @repository,
        enabled: code_security_enabled,
        update_path: update_security_products_settings_path(@repository.owner, @repository),
        code_quality_enabled: code_quality_enabled,
      )%>
    <% end %>
  <% end %>
<% end %>

<%= render Primer::Beta::Text.new(tag: :p, pt: 2) do %>
  <%= billing_text %> <%= render(Primer::Beta::Link.new(href: helpers.docs_url("billing/about-billing-for-github-advanced-security"), classes: "Link--inTextBlock")) { "Learn more about Code Security billing." } %>
<% end %>

<% if @button_disabled_message.present? %>
  <%= render(Primer::Alpha::Banner.new) { @button_disabled_message } %>
<% end %>
