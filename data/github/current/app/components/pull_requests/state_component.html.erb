<%= render Primer::Beta::State.new(**{ title: title, scheme: color, size: @size, classes: class_name }.merge(@args)) do %>
  <% if octicon_name == "git-pull-request-unlisted" %>
    <%= helpers.svg("public/static/images/modules/pulls/git-pull-request-unlisted.svg", width: 16, height: 16, data: {"test-selector": "pull-request-unlisted"}) %> <%= label %>
  <% else %>
    <%= helpers.octicon(octicon_name, height: octicon_height) %> <%= label %>
  <% end %>
<% end %>
