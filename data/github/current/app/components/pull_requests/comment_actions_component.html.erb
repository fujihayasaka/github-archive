 <% if custom_actions.any? %>
  <comment-actions>
    <div class="d-flex flex-items-center gap-2 ml-3 mr-n2">
      <% custom_actions.each do |action| %>
        <% if action.is_a?(CommentAction::Record::CopilotChatAction)  %>
          <%= render Primer::Beta::Button.new(size: :small, data: {
              copilot_prompt: action.prompt,
              action: "click:comment-actions#openCopilotChat",
              target: "comment-actions.button"
            }) do |button| %>
            <% button.with_leading_visual_icon(icon: :copilot) %>
            <%= action.name %>
          <% end %>
        <% elsif action.is_a?(CommentAction::Record::LinkAction) %>
          <%= render Primer::Beta::Button.new(size: :small, tag: :a, href: action.url) do |button| %>
            <%= action.name %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </comment-actions>
<% end %>
