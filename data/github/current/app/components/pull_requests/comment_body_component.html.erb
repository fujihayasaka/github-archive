<div class="edit-comment-hide">
  <%= render PullRequests::CommentMinimizeFormComponent.new(comment: comment) %>
  <task-lists disabled sortable>
    <div class="<%= body_classes %>">
    <% if body_html.present?%>
      <%= body_html %>
    <% else %>
      <p class="color-fg-muted">
        <em> <%= PLACEHOLDER_MESSAGE %> </em>
      </p>
    <% end %>
    <% if comment.is_a?(PullRequestReview) %>
      <%= render PullRequests::Copilot::ApplyChangesButtonComponent.new(
        comment: comment,
        pull_request: pull_request,
        comment_permalink: comment_permalink,
        is_overview_comment: true
      ) %>
    <% end %>
    </div>
  </task-lists>
  <%= actions %>
</div>
