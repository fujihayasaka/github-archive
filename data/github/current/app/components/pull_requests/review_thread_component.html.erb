<turbo-frame id="review-thread-or-comment-id-<%= review_thread_or_comment.id %>" target="_top">
  <% if use_new_collapsible? %>
    <review-thread-collapsible
      class="<%= class_names(
        'review-thread-component js-comment-container js-resolvable-timeline-thread-container border rounded-2 d-block',
        'tmp-mb-3': !rendering_on_files_tab,
        'open': !collapse_by_default?,
      ) %>"
      <%= test_selector("is-outdated") if outdated? %>
      data-resolved="<%= resolved? %>"
      <% if deferred_content_url %>data-deferred-content-url="<%= deferred_content_url %>"<% end %>
      <% if resolved_thread_comments_ids %>data-hidden-comment-ids="<%= resolved_thread_comments_ids %>"<% end %>
    >
      <%# Header — single chevron button rotated via CSS open class %>
      <div
        class="d-flex flex-items-center p-2 rounded-top-2 bgColor-muted <%= class_names("js-toggle-outdated-comments": collapse_by_default?) %>"
        <%= test_selector("file-header") %>
        <%= "hidden" if summary_hidden? %>
        data-action="mouseenter:review-thread-collapsible#preload"
      >
        <%= render Primer::Beta::IconButton.new(
          icon: :"chevron-right",
          scheme: :invisible,
          size: :small,
          "aria-label": ARIA_LABEL,
          "aria-expanded": !collapse_by_default?,
          data: {
            target: "review-thread-collapsible.button",
            action: "click:review-thread-collapsible#toggle",
          },
          classes: "flex-shrink-0 mr-2 review-thread-chevron",
        ) %>

        <span class="flex-auto tmp-mr-3 d-flex flex-items-center">
          <% if !rendering_on_files_tab %>
            <% if resource_path %>
              <a href="<%= resource_path %>" class="text-mono text-small Link--primary wb-break-all mr-2"><%= filename %></a>
            <% else %>
              <span class="text-mono text-small wb-break-all mr-2"><%= filename %></span>
            <% end %>
          <% elsif resolved? %>
            <div class="d-lg-inline d-block">
              <% if resolved_by_actor %>
                <strong><%= resolved_by_actor.display_login %></strong> marked this conversation as resolved.
              <% else %>
                This conversation was marked as resolved.
              <% end %>
            </div>
          <% end %>

          <% if fixed_alert? %>
            <%= render Primer::Beta::Label.new(scheme: :secondary, title: "Label: Fixed", test_selector: "fixed-label") do %>
              Fixed
            <% end %>
          <% elsif dismissed_alert? %>
            <%= render Primer::Beta::Label.new(scheme: :secondary, title: "Label: Dismissed", test_selector: "dismissed-label") do %>
              Dismissed
            <% end %>
          <% elsif outdated? %>
            <%= render Primer::Beta::Label.new(scheme: (resolved? ? :secondary : :warning), title: "Label: Outdated") do %>
              Outdated
            <% end %>
          <% end %>
        </span>
        <% if resolved? || collapse_by_default? %>
          <%= render Primer::Beta::Button.new(scheme: :link, color: :muted, font_size: 6, classes: "review-thread-show-text", "data-action": "click:review-thread-collapsible#toggle") do |button| %>
            <% button.with_leading_visual_icon(icon: :unfold) %>
            Show <%= collapse_reason_message %>
          <% end %>
          <%= render Primer::Beta::Button.new(scheme: :link, color: :muted, font_size: 6, classes: "review-thread-hide-text", "data-action": "click:review-thread-collapsible#toggle") do |button| %>
            <% button.with_leading_visual_icon(icon: :fold) %>
            Hide <%= collapse_reason_message %>
          <% end %>
        <% end %>
      </div>

      <%# Body — thread content %>
      <% if collapse_by_default? %>
        <div data-target="review-thread-collapsible.body" hidden <%= test_selector("deferred-review-thread-body") %>>
          <%= render Primer::Alpha::IncludeFragment.new do %>
            <%= render(Primer::Beta::Spinner.new(size: :large, mx: :auto, display: :block, "aria-label": "Loading", classes: "tmp-my-3")) %>
          <% end %>
        </div>
      <% else %>
        <div data-target="review-thread-collapsible.body" <%= test_selector("review-thread-body") %>>
          <%= render PullRequests::ReviewThreadBodyComponent.new(
            review_thread_or_comment: review_thread_or_comment,
            pull_request: pull_request,
            rendering_on_files_tab: rendering_on_files_tab,
          ) %>
        </div>
      <% end %>
    </review-thread-collapsible>
  <% else %>
    <details-collapsible>
      <%= render Primer::Beta::Details.new(
        mb: rendering_on_files_tab ? 0 : 3,
        border: true,
        border_radius: 2,
        classes: "review-thread-component js-comment-container js-resolvable-timeline-thread-container Details-element",
        reset: true,
        open: !collapse_by_default?,
        data: {
          resolved: resolved?,
          "deferred-details-content-url": deferred_content_url,
          "hidden-comment-ids": resolved_thread_comments_ids,
          target: "details-collapsible.detailsElement",
        },
        test_selector: (outdated? ? "is-outdated" : nil)
      ) do |component| %>
        <% component.with_summary(
          hidden: summary_hidden?,
          button: false,
          py: 2,
          px: 3,
          border_radius: 2,
          bg: :subtle,
          classes: class_names("js-toggle-outdated-comments": collapse_by_default?),
          test_selector: 'file-header',
          "aria-expanded": !summary_hidden?,
          "aria-label": summary_aria_label,
          data: {
            target: "details-collapsible.summaryElement",
            action: "click:details-collapsible#toggle",
            "aria-label-closed": ARIA_LABEL_EXPAND,
            "aria-label-open": ARIA_LABEL_COLLAPSE,
          },
        ) do %>
          <div class="d-flex flex-items-center">
            <span class="flex-auto tmp-mr-3 d-flex flex-items-center">
              <% if !rendering_on_files_tab %>
                <% if resource_path %>
                  <a href="<%= resource_path %>" class="text-mono text-small Link--primary wb-break-all mr-2"><%= filename %></a>
                <% else %>
                  <span class="text-mono text-small wb-break-all mr-2"><%= filename %></span>
                <% end %>
              <% elsif resolved? %>
                <div class="d-lg-inline d-block">
                  <% if resolved_by_actor %>
                    <strong><%= resolved_by_actor.display_login %></strong> marked this conversation as resolved.
                  <% else %>
                    This conversation was marked as resolved.
                  <% end %>
                </div>
              <% end %>

              <% if fixed_alert? %>
                <%= render Primer::Beta::Label.new(scheme: :secondary, title: "Label: Fixed", test_selector: "fixed-label") do %>
                  Fixed
                <% end %>
              <% elsif dismissed_alert? %>
                <%= render Primer::Beta::Label.new(scheme: :secondary, title: "Label: Dismissed", test_selector: "dismissed-label") do %>
                  Dismissed
                <% end %>
              <% elsif outdated? %>
                <%= render Primer::Beta::Label.new(scheme: (resolved? ? :secondary : :warning), title: "Label: Outdated") do %>
                  Outdated
                <% end %>
              <% end %>
            </span>
            <% if resolved? || collapse_by_default? %>
              <span class="btn-link color-fg-muted f6 Details-content--closed"><%= primer_octicon(icon: :unfold, mr: 1) %>Show <%= collapse_reason_message %></span>
              <span class="btn-link color-fg-muted f6 Details-content--open"><%= primer_octicon(icon: :fold, mr: 1) %>Hide <%= collapse_reason_message %></span>
            <% end %>
          </div>
        <% end %>

        <% if collapse_by_default? %>
          <% component.with_body(test_selector: "deferred-review-thread-body") do %>
            <%= render Primer::Alpha::IncludeFragment.new do %>
              <%= render(Primer::Beta::Spinner.new(size: :large, mx: :auto, display: :block, "aria-label": "Loading", classes: "tmp-my-3")) %>
            <% end %>
          <% end %>
        <% else %>
          <% component.with_body(test_selector: "review-thread-body") do %>
            <%= render PullRequests::ReviewThreadBodyComponent.new(
              review_thread_or_comment: review_thread_or_comment,
              pull_request: pull_request,
              rendering_on_files_tab: rendering_on_files_tab,
            ) %>
          <% end %>
        <% end %>
      <% end %>
    </details-collapsible>
  <% end %>
</turbo-frame>
