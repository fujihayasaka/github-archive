<%= render Primer::Beta::Popover.new(
  position: :absolute,
  pt: 1,
  right: 1,
  left: 1,
  hide: :whenNarrow,
  classes: "js-notice"
) do |component| %>
  <% component.with_heading do %>
    <%= heading %>
  <% end %>
  <% component.with_body(position: :relative, caret: :top_left, mt: 0, style: "width: 315px;") do %>
    <p>
      <%= body_text %>
    </p>
      <table>
        <tr>
          <td>
            <%= render Primer::Beta::Button.new(
              type: :button,
              tag: :a,
              scheme: :default,
              href: "https://gh.io/copilot-code-review-docs",
              style: "margin-right: 20px;",
              "target": "_blank",
              "aria-label": "Learn more about Copilot code review"
            ) do %>
              Learn more
            <% end %>
          </td>
          <td>
            <%= render Primer::Beta::Button.new(type: :submit, scheme: :invisible, classes: "js-notice-dismiss js-dismiss-copilot-popover", "data-url": dismiss_url) do %>OK, dismiss<% end %>
            <%= csrf_hidden_input_for dismiss_url, class: "js-data-url-csrf" %>
          </td>
        </tr>
      </table>
  <% end %>
<% end %>
