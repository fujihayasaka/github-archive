<div class="d-flex flex-items-center">
  <div class="flex-shrink-0 pt-1 pl-3">
    <span role="status" aria-label="<%= icon_tooltip %>">
      <%= helpers.octicon(icon, class: icon_class) %>
    </span>
  </div>
  <div class="flex-shrink-0 pt-1 pl-2">
    <strong><%= pull_request.title %></strong>
    <%= render(Primer::Beta::Link.new(href: helpers.pull_request_path(pull_request), muted: true)) do %>
      #<%= pull_request.number %>
    <% end %>
  </div>
</div>
