<% if ccr_listener_enabled? %>
  <div class="d-flex gap-1">
    <%= render(Primer::Beta::IconButton.new(
      tag: :button,
      size: :small,
      scheme: :invisible,
      icon: :thumbsup,
      "aria-label": "Positive Feedback",
      data: { 'comment-id': comment_id, 'feedback-type': "POSITIVE" },
    )) %>
    <%= render(Primer::Beta::IconButton.new(
      tag: :button,
      size: :small,
      scheme: :invisible,
      icon: :thumbsdown,
      "aria-label": "Negative Feedback",
      data: { 'comment-id': comment_id, 'feedback-type': "NEGATIVE" },
    )) %>
  </div>
<% else %>
  <%= render_react_partial name: "copilot-code-review-feedback", props: { commentId: comment_id, feedbackOptions: feedback_options, feedbackPath: feedback_path, additionalParameters: additional_parameters } %>
<% end %>
