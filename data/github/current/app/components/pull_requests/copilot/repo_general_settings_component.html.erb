<% if repo_custom_instructions_feature_enabled? %>
  <%= render Primer::Box.new(test_selector: "code-review-repo-general-settings", mt: 4) do %>
    <%= render Primer::Beta::Subhead.new(hide_border: true, test_selector: "code review repo general settings") do |box| %>
      <% box.with_heading(tag: :h2, font_size: 4) do %>
        General settings
      <% end %>
    <% end %>

    <%= render Primer::Box.new(id: "code-review-general-settings-list") do %>
      <%= render Primer::Beta::BorderBox.new do |component| %>
        <% component.with_row(flex: 1, display: :flex, justify_content: :space_between, align_items: :center) do %>
          <%= render(Primer::Box.new(display: :flex, direction: :column)) do %>
            <%= render(Primer::Beta::Text.new(tag: :p, font_weight: :bold, mb: 1, test_selector: "custom-instructions-setting-text")) do %>
              Use custom instructions when reviewing pull requests
            <% end %>
            <%= render(Primer::Beta::Text.new(tag: :p)) do %>
              Copilot references <%= render Primer::Beta::Link.new(
                test_selector: "custom-instructions-docs-link",
                href: helpers.docs_url("copilot/add-repo-custom-instructions"),
                classes: "Link--inTextBlock",
                ).with_content("repository custom instructions")
              %> when reviewing pull requests.
            <% end %>
          <% end %>
          <%= render(Primer::Box.new(display: :flex, align_items: :center, classes: "gap-2")) do %>
            <%= render(Primer::Alpha::ToggleSwitch.new(
              size: :small,
              checked: repo_custom_instructions_enabled?,
              src: repo_custom_instructions_toggle_form_src,
              csrf_token: repo_custom_instructions_toggle_form_csrf_token,
              "aria-label": "Repository code review custom instructions enablement",
            ))  %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
