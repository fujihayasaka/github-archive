<% if issue_event.message.present? %>
  <%# Keeping this code in to make previously erroring messages still appear %>
  <%= render(PullRequests::TimelineEvents::CopilotWorkFinishedFailureComponent.new(issue_event:, pull_request:)) %>
<% else %>
  <%= render(PullRequests::TimelineEvents::TimelineItemComponent.new(issue_event: issue_event, render_actor: false, render_app: false, icon: "repo-push")) do |component| %>
    <% component.with_body do %>
      <% if session_url.present? %>
        <strong><%= agent_name %></strong> <%= safe_link_to action_phrase, session_url, title: "View session", class: "Link--secondary" %> on behalf of <%= render "issues/events/actor_link", actor: issue_event.actor %>
      <% else %>
        <strong><%= agent_name %></strong> <%= action_phrase %> on behalf of <%= render "issues/events/actor_link", actor: issue_event.actor %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
