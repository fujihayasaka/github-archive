<%= render(PullRequests::TimelineEvents::TimelineItemComponent.new(issue_event: issue_event, render_actor: false, render_app: false, icon: "git-branch")) do |component| %>
  <% component.with_body do %>
    <% if session_url.present? %>
      <strong>Copilot</strong> <%= safe_link_to "started work", session_url, title: "View session", class: "Link--secondary" %> on behalf of <%= render "issues/events/actor_link", actor: issue_event.actor %>
      <% component.with_action do %>
        <%= render Primer::Beta::Button.new(tag: :a, size: :small, href: session_url, float: :right, "aria-label": "View session #{issue_event.source_id}") do %>
          View session
        <% end %>
      <% end %>
    <% else %>
      <strong>Copilot</strong> started work on behalf of <%= render "issues/events/actor_link", actor: issue_event.actor %>
    <% end %>
  <% end %>
<% end %>
