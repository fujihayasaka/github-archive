<%= render(PullRequests::TimelineEvents::TimelineItemComponent.new(issue_event: issue_event, render_actor: false, render_app: false, icon: "git-branch")) do |component| %>
  <% component.with_body do %>
    <strong>Copilot</strong> stopped work on behalf of <%= render "issues/events/actor_link", actor: issue_event.actor %> due to an error
  <% end %>
  <% component.with_additional_details do %>
    <div class="mt-2 d-flex flex-items-start gap-2">
      <%= render(Primer::Beta::Octicon.new(
        icon: :"x-circle-fill",
        style: "margin-top: var(--base-size-2);",
        color: :danger
      )) %>
      <% if session_path.present? %>
        <%= render(Primer::Beta::Link.new(href: session_path, scheme: :secondary)) { error_message } %>
      <% else %>
        <%= error_message %>
      <% end %>
    </div>
  <% end %>
<% end %>
