<div class="d-flex flex-items-center border circle borderColor-muted py-1 px-2 gap-1 fgColor-muted f6 lh-condensed-ultra mb-2 mr-2" <%= test_selector("parent-pull-request-token") %>>
  <% if octicon_name == "git-pull-request-unlisted" %>
    <%= helpers.svg("public/static/images/modules/pulls/git-pull-request-unlisted.svg", width: 16, height: 16, data: {"test-selector": "pull-request-unlisted"}) %>
  <% else %>
    <%= primer_octicon(octicon_name) %>
  <% end %>

  <span class="py-1">Parent:</span>
  <%= render Primer::Beta::Truncate.new(max_width: 200) do |c| %>
    <% c.with_item(max_width: 200) do %>
      <%= render Primer::Beta::Link.new(href: pull_request_path(parent_pull_request), scheme: :secondary) do %>
        <%= parent_pull_request.title %>
      <% end %>
    <% end %>
  <% end %>
</div>
