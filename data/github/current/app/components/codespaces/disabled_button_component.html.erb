<%# erblint:counter DeprecatedComponentsCounter 1 %>
<div class="d-flex flex-column">
  <button
    id="<%= disabled_button_id if primer_tooltip? %>"
    type="button"
    class="<%= btn_class %> <%= tooltip_class unless primer_tooltip? %>"
    aria-label="Codespace creation is disabled"
    disabled
    <%= test_selector("codespaces-create-button-disabled") %>>
    <%= render Primer::Truncate.new.with_content(text) %>
  </button>

  <% if primer_tooltip? %>
    <%= render(Primer::Alpha::Tooltip.new(
      for_id: disabled_button_id,
      type: :description,
      text: "Codespace creation is disabled",
      direction: primer_tooltip_direction,
    )) %>
  <% end %>
</div>
