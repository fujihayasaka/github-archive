<%# erblint:counter FlashMigrationCounter 1 %>
<div class="flash flash-warn js-notice" style="<%=@style%>">
  <%= form_tag dismiss_notice_path(UserNotice::CODESPACES_MAINTENANCE_2025_05_28_NOTICE), :class => "js-notice-dismiss d-flex flex-items-center gap-3" do %>
    <span class="flex-1">
      Codespaces is undergoing maintenance. Users may experience connection issues during this time, for more details please visit <%= render Primer::Beta::Link.new(href: "https://www.githubstatus.com", classes: "Link--inTextBlock") do %> this announcement <% end %>.
    </span>
    <%= button_tag(type: "submit",
      class: "btn-link flex-self-start",
      data: {},
      "aria-label": "Dismiss") do %>
      <span class="d-inline-block">
        <%= render(Primer::Beta::Octicon.new(icon: :x, color: :muted, "aria-label": "Dismiss", classes: "m-0")) %>
      </span>
    <% end %>
  <% end %>
</div>
