<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%= render Primer::Box.new(display: :flex, justify_content: :space_between) do %>
  <%= render Primer::Box.new do %>
    <%= render Primer::Beta::Text.new(tag: :div, font_weight: :bold, id: "codespace-region-select-label").with_content("Region") %>
      <%= render Primer::Beta::Text.new(
        tag: :div,
        color: :muted,
        font_size: :small,
        id: "codespace-region-select-description"
      ).with_content("Your codespace will run in the selected region") %>
  <% end %>
  <% if current_user&.feature_flag_enabled?(:codespaces_accessible_region_selector, default: false) %>
    <input type="hidden" name="geo" value="<%= selected_location %>" data-target="new-codespace.geoInput">
    <%= render(Primer::Alpha::ActionMenu.new(
      dynamic_label: true,
      select_variant: :single,
      anchor_align: :end,
      data: { action: "itemActivated:new-codespace#geoUpdated" },
      id: "geo-menu-list",
    )) do |panel| %>
      <% panel.with_show_button(
        font_weight: :normal,
        aria: {
          describedby: "codespace-region-select-label codespace-region-select-description"
        }
      ) do |button| %>
        <% button.with_trailing_action_icon(icon: :"triangle-down") %>
        <% if selected_location %>
          <%= display_name(selected_location) %>
        <% else %>
          Select a location
        <% end %>
      <% end %>
      <% geos.each do |geo| %>
        <% panel.with_item(label: display_name(geo), "data-value": geo, active: geo == selected_location ) %>
      <% end %>
    <% end %>
  <% else %>
    <input type="hidden" name="geo" value="<%= selected_location %>" data-target="new-codespace.geoInput">
    <details class="details-reset details-overlay position-relative">
      <%= render Primer::ButtonComponent.new(tag: :summary, display: :block, mt: 1, "aria-describedby": "codespace-region-select-label codespace-region-select-description") do %>
        <span data-menu-button class="text-normal">
          <% if selected_location %>
            <span><%= display_name(selected_location) %></span>
          <% else %>
            <span>Select a location</span>
          <% end %>
        </span>
        <span class="dropdown-caret float-right mt-2"></span>
      <% end %>
      <details-menu class="select-menu-modal width-full position-absolute right-0" style="z-index: 99; min-width: 140px;"><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
        <div class="select-menu-list" id="geo-menu-list">
          <% geos.each do |geo| %>
            <label class="select-menu-item <%= "selected" if geo == selected_location %>" tabindex="0" role="menuitemradio">
              <%= render Primer::Beta::Octicon.new(icon: "check", classes: "select-menu-item-icon") %>
              <div class="select-menu-item-text">
                <input type="radio" name="geo" value="<%= geo %>" <% if geo == selected_location %>checked<% end %> aria-checked="<%= geo == selected_location %>" data-autosubmit>
                <span class="select-menu-item-text text-normal" data-menu-button-contents><%= display_name(geo) %></span>
              </div>
            </label>
          <% end %>
        </div>
      </details-menu>
    </details>
  <% end %>
<% end %>
