<%= render(Primer::Beta::BorderBox.new(padding: :default, classes: @usage_banner_message.present? ? "rounded-bottom-0 border-bottom-0" : "tmp-mb-3", test_selector: "aic-free-usage-summary")) do |component| %>
  <%= component.with_row do %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
      <%= render(Primer::Box.new(flex: 1)) do %>
        <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Inline suggestions" } %>
      <% end %>
      <%= render(Primer::Box.new(display: :flex, align_items: :center, flex: 1, justify_content: :flex_end)) do %>
        <%= render(Copilot::AicProgressBarComponent.new(percent: @limited_user_suggestions_used_percentage)) %>
      <% end %>
    <% end %>
  <% end %>
  <%= component.with_row do %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
      <%= render(Primer::Box.new(flex: 1)) do %>
        <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Included credits" } %>
      <% end %>
      <%= render(Primer::Box.new(display: :flex, align_items: :center, flex: 1, justify_content: :flex_end)) do %>
        <%= render(Copilot::AicProgressBarComponent.new(percent: @limited_user_chat_used_percentage)) %>
      <% end %>
    <% end %>
  <% end %>
  <% if @show_persistent_upgrade_cta %>
    <%# Persistent upgrade CTA row for Free users %>
    <%= component.with_footer(bg: :subtle, py: 2) do %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
        <%= render(Primer::Beta::Text.new(tag: :span, color: :muted, test_selector: "upgrade-plan-cta-text")) do %>
          Upgrade your Copilot plan for higher usage limits, premium models, AI reviews and more.
        <% end %>
        <%= render(Primer::Beta::Button.new(
          tag: :a,
          href: copilot_pro_signup_path,
          scheme: :default,
          test_selector: "upgrade-plan-cta",
          data: analytics_click_attributes(
            category: "user_copilot_settings",
            action: "upgrade_clicked",
            label: "ref_cta:tbb_free_upgrade_button"
          )
        )) do %>
          Upgrade plan
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<% if @usage_banner_message.present? %>
  <%= render(Primer::Alpha::Banner.new(
    scheme: @usage_banner_scheme == :danger ? :danger : :default,
    icon: @usage_banner_scheme == :danger ? :stop : :info,
    test_selector: "usage-banner",
    align_content: :center,
    classes: "rounded-top-0 tmp-mb-3",
  )) do |banner| %>
    <% if @show_upgrade_cta %>
      <% banner.with_action_content do %>
        <%= render(Primer::Beta::Button.new(
          tag: :a,
          href: copilot_pro_signup_path,
          scheme: :default,
          test_selector: "upgrade-plan-cta",
          data: analytics_click_attributes(
            category: "user_copilot_settings",
            action: "upgrade_clicked",
            label: "ref_cta:tbb_free_quota_exhausted_upgrade_button"
          )
        )) { "Upgrade plan" } %>
      <% end %>
    <% end %>
    <%= @usage_banner_message %>
  <% end %>
<% end %>
