<%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :spacious) do %>
  <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
    <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4) do %>
      Account
    <% end %>

    <%= render Primer::Box.new(border: true, border_radius: 2, bg: :default, classes: "tmp-p-3") do %>
      <%= render Primer::Alpha::Stack.new(direction: :horizontal, justify: :space_between) do %>
        <div class="d-flex flex-items-center">
          <%= render GitHub::AvatarComponent.new(actor: user, size: 32, classes: "tmp-mr-3") %>

          <div>
            <%= render Primer::Beta::Text.new(tag: :p, font_size: 5, font_weight: :bold, mb: 0) do %>
              <%= user.safe_profile_name %> · <%= user.email %>
            <% end %>

            <%= render Primer::Beta::Text.new(tag: :p, font_size: 5, color: :muted, mb: 0) do %>
              Personal account
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
    <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4) do %>
      Billing frequency
    <% end %>

    <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
      <%
        monthly_pricing = helpers.copilot_signup_pricing(
          product_key: Copilot::INDIVIDUAL_MAX_PRODUCT_KEY,
          billing_cycle: "monthly",
          user: user
        )
        yearly_pricing = helpers.copilot_signup_pricing(
          product_key: Copilot::INDIVIDUAL_MAX_PRODUCT_KEY,
          billing_cycle: "yearly",
          user: user
        )
      %>
      <%= render "copilot/signup/billing_frequency_fields",
        payment_duration: payment_duration,
        monthly_price: Copilot::COPILOT_MAX_MONTHLY_BASE_PRICE,
        yearly_price: Copilot::COPILOT_MAX_YEARLY_BASE_PRICE,
        monthly_pricing: monthly_pricing,
        yearly_pricing: yearly_pricing
      %>
    <% end %>
  <% end %>

  <% if show_billing_information_container? %>
    <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal, data: { target: has_billing_information? ? nil : "billing-checkout.billingInformationWrapper" }) do %>
      <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4) do %>
        Billing information
      <% end %>

      <% if billing_info_exists_without_errors? %>
        <%= render Primer::Box.new(border: true, border_radius: 2, bg: :default, classes: "js-edit-user-personal-profile-wrapper tmp-p-3", test_selector: "billing-information-summary") do %>
          <%= render Primer::Alpha::Stack.new(direction: :horizontal, justify: :space_between) do %>
            <div class="d-flex">
              <%= render Primer::Beta::Octicon.new(:location, size: :small, color: :muted, mr: 2, style: "margin-top: 2px;") %>

              <ul class="list-style-none">
                <li><%= billing_information.fullname %></li>
                <li><%= billing_information.address1 %></li>
                <li><%= billing_information.address2 %></li>
                <li><%= billing_information.city %>, <%= billing_information.country_is_united_states? ? billing_information.us_state : billing_information.region %> <%= billing_information.postal_code %></li>
                <li><%= billing_information.country.name %></li>

                <% if billing_information.vat_code.present? %>
                  <li class="mt-2">VAT/GST: <%= billing_information.vat_code %></li>
                <% end %>
              </ul>
            </div>

            <% if user.is_allowed_to_edit_billing_information? %>
              <%= render Primer::Beta::Button.new(font_size: 6, classes: "js-edit-user-personal-profile",
                data: { action: "click:billing-checkout#editBillingInformation", targets: "billing-checkout.editButtons" }
              ) do %>
                Edit<span class="sr-only"> billing information</span>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <div class="js-name-address-collection-wrapper" <%= "hidden" if hide_billing_information_form? %> <%= test_selector("billing-information-form") %>>
        <%= render Primer::Box.new(border: true, border_radius: 2, bg: :default, classes: "tmp-p-3") do %>
          <fieldset>
            <legend class="sr-only">Billing information</legend>

            <%= render Billing::Settings::NameAddressFormComponent.new(
              target: user,
              payment_flow_loaded_from: "COPILOT",
              return_to: return_to_path,
            ) %>
          </fieldset>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if show_payment_method_container? %>
    <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal, classes: "js-payment-methods-wrapper", test_selector: "payment-method-container") do %>
      <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4) do %>
        Payment method
      <% end %>

      <%= render Primer::Box.new(border: true, border_radius: 2, bg: :default, classes: "tmp-p-3") do %>
        <%= render Billing::Settings::PaymentMethodFormComponent.new(
          target: user,
          new_name_address_design: true,
          signature_view_context: Billing::Zuora::HostedPaymentsPage::COPILOT_SIGNATURE_VIEW_CONTEXT,
          return_to: return_to_path
        ) %>

        <div class="form-group m-0">
          <input type="reset" value="Cancel" class="btn js-sponsors-cancel-edit-payment-method-btn" data-action="click:billing-checkout#cancelEditPaymentMethod" hidden>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if has_commercial_restrictions? %>
    <%= render(TradeCompliance::TradeScreeningRestrictionNoticeComponent.new(
      target: user,
      title: "You can't proceed with your payment",
      feature_type: :copilot,
    )) %>
  <% end %>
<% end %>
