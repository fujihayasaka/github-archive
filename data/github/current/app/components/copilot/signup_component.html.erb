<div style="<%= @fullscreen ? "min-height: 80vh; padding-bottom: 48px": "" %>" data-hpc>
  <% if heading.present? %>
    <%= render(Site::SectionComponent.new(theme: :dark, class: "overflow-hidden tmp-px-3 tmp-px-md-0 position-relative", style: "background-color: #000" )) do %>
      <%= render(Primer::Box.new(classes: "hero-graphic-container")) do %>
        <%= render(Primer::Alpha::Image.new(src: image_path("modules/copilot/copilot-background.jpg"), alt: "GitHub Copilot Background Graphic", classes: "hero-graphic")) %>
      <% end %>
      <%= render(Primer::Box.new(display: :flex, direction: :column, align_items: :center, w: :full, bg: :transparent, position: :relative, text_align: :center, classes: "tmp-p-4")) do %>
        <%= render(Primer::Alpha::Image.new(src: image_path("modules/copilot/copilot-enterprise-badge.png"), alt: "GitHub Copilot Logo", height: 200, width: 200, mt: -6)) %>
        <%= render(Primer::Beta::Heading.new(tag: :h1, test_selector: "copilot_signup_heading", mt: -6)) do %>
          <%= heading %>
        <% end %>
        <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, test_selector: "copilot_signup_subheading")) do %>
          <%= subheading %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% if new_heading.present? %>
    <%= render(Site::SectionComponent.new(class: "overflow-hidden tmp-px-3 tmp-px-md-0 position-relative")) do %>
      <%= render(Primer::Box.new(display: :flex, direction: :column, align_items: :center, w: :full, bg: :transparent, position: :relative, text_align: :center, classes: "tmp-p-4")) do %>
        <%= render(Primer::Beta::Octicon.new(:copilot, height: 48, color: :subtle)) %>
        <%= render(Primer::Beta::Heading.new(tag: :h1, test_selector: "copilot_signup_heading")) do %>
          <%= new_heading %>
        <% end %>
        <% if subheading.present? %>
          <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, test_selector: "copilot_signup_subheading")) do %>
            <%= subheading %>
          <% end%>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= render(Primer::Box.new) do %>
    <%= render(Primer::Box.new(test_selector: "copilot_signup_main")) do %>
      <%= main %>
    <% end %>
  <% end %>
</div>
