<%= render(Primer::Box.new(display: :flex, align_items: :center, direction: :row, flex: 1, justify_content: :flex_end)) do %>
  <%= render(Primer::Beta::Text.new(tag: :span, mr: 2, color: :muted)) do %>
    <% if @label.present? %>
      <%= @label %>
    <% else %>
      <%= "#{number_with_precision(percent, precision: 0)}% used" %>
    <% end %>
  <% end %>
  <%= render(Primer::Box.new(flex: 1, classes: "tmp-ml-2", style: "max-width: 300px")) do %>
    <%= render(Primer::Beta::ProgressBar.new(size: :small)) do |bar| %>
      <%= bar.with_item(percentage: percent, bg: emphasis_color) %>
    <% end %>
  <% end %>
<% end %>
