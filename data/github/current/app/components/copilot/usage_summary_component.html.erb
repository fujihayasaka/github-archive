<%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
  <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Usage" } %>
<% end %>
<%= render(Primer::Beta::BorderBox.new(padding: :default, mb: 3)) do |component| %>
  <%= component.with_row do %>
    <%= render(Primer::Box.new(id: "copilot-overages-usage", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
      <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
        <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
          <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
            <%= Copilot::COPILOT_PREMIUM_REQUESTS %>
          <% end %>
          <%= render(Primer::Box.new) do %>
            <%= @percent_used %>%
          <% end %>
        <% end %>
        <%= render(Primer::Beta::Text.new(tag: :p, mt: 2, mb: 2, mr: 6, color: :muted, id: "copilot_overages_progress_bar", col: 12)) do %>
          <%= render(Primer::Beta::ProgressBar.new(size: :large)) do |component| %>
            <%= component.with_item(percentage: @percent_used, bg: @emphasis) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
      <% if render_numbers? %>
        <%= render(Primer::Beta::Text.new(tag: :p, color: :muted)) do %>
          As of <%= render(Primer::Beta::RelativeTime.new(datetime: @timestamp_utc)) %>,
          you have used <%= @used %> of <%= @entitlement %> premium requests this month.
          <% if @overage_count.to_i > 0 && @percent_used.to_f >= 100.0 %>
            You have also used <%= @overage_count %> additional paid premium <%= pluralized_overage %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted)) do %>
        Please note that there may be a delay in the displayed usage percentage. The premium request entitlement for your plan will reset at the start of next month. To enable additional premium requests,
        <%= render(Primer::Beta::Link.new(href: "/settings/billing/budgets", scheme: :default, muted: false, underline: true)) { "update your Copilot premium request budget" } %>.
      <% end %>
    <% end %>
  <% end %>
<% end %>
