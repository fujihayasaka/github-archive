<%= render(Copilot::Purchase::CheckoutSectionComponent.new(heading: heading)) do |component| %>
  <% component.with_children do %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, col: 12)) do %>
      <%= render(Primer::Box.new(display: :flex, direction: :column, mr: 3, col: 10)) do %>
        <%= render(Primer::Beta::Text.new(font_weight: :bold)) { Copilot::BUSINESS_PRODUCT_NAME } %>
        <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) do %>
          For organizations ready to improve engineering velocity, code quality, and developer experience. See all features on Business plan.
        <% end %>
      <% end %>
      <%= render(Primer::Box.new(display: :flex, direction: :column, col: 2, text_align: :right)) do %>
        <%= render(Primer::Beta::Text.new(font_weight: :bold)) { "$#{Copilot::COPILOT_BUSINESS_MONTHLY_BASE_PRICE} / user" } %>
        <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) { "per month" } %>
      <% end %>
    <% end %>

    <% if is_business? && !is_standalone_business? %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, col: 12, mt: 4)) do %>
        <%= render(Primer::Box.new(display: :flex, direction: :column, mr: 3, col: 10)) do %>
          <%= render(Primer::Beta::Text.new(font_weight: :bold)) { Copilot::ENTERPRISE_PRODUCT_NAME } %>
          <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) do %>
              For companies looking to customize Copilot to their organization and infuse AI across the developer workflow. See all features on Enterprise plan.
          <% end %>
        <% end %>
        <%= render(Primer::Box.new(display: :flex, direction: :column, col: 2, text_align: :right)) do %>
          <%= render(Primer::Beta::Text.new(font_weight: :bold)) { "$#{Copilot::COPILOT_ENTERPRISE_MONTHLY_BASE_PRICE} / user" } %>
          <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) { "per month" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
