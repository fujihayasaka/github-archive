<%= render(Primer::Box.new(display: :flex, justify_content: :space_between, align_items: :center, mb: 3)) do %>
  <%= render(Primer::Beta::Text.new(tag: :p, font_size: 4, font_weight: :bold, mb: 0)) { heading } if heading.present? %>
  <% if heading_link.present? %>
    <%= render(Primer::Beta::Button.new(scheme: :secondary)) { "Edit" } %>
  <% end %>
<% end %>
<%= subheading if subheading.present? %>
<%= render(Primer::Beta::BorderBox.new(padding: :default, box_shadow: true, mb: 5)) do |component| %>
  <% component.with_body do %>
    <%= children %>
  <% end %>
  <% if footer.present? %>
    <% component.with_footer(px: 3, py: 2) do %>
      <%= footer %>
    <% end %>
  <% end %>
<% end %>
