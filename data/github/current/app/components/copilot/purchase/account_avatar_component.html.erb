<%= render(Primer::Box.new(display: :flex)) do %>
  <%= render(Primer::Beta::Avatar.new(shape: :square, src: avatar_url, alt: name, size: 40)) %>
  <%= render(Primer::Box.new(display: :flex, direction: :column, pl: 3)) do %>
    <%= render(Primer::Beta::Text.new(font_weight: :bold)) { name } %>
    <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) do %>
      <%= "#{account_type(account)}" %><% if show_account_info %><%= " • #{child_entities_string}" %><% end %>
    <% end %>
  <% end %>
<% end %>
