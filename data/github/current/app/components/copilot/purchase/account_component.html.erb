<%= render(Copilot::Purchase::CheckoutSectionComponent.new(heading: "Account")) do |component| %>
  <% component.with_subheading do %>
    <%=
      render(Copilot::Purchase::IneligibleInfoComponent.new(
        selected_account: account,
        eligibility: accounts_eligibility
      ))
    %>
  <% end %>

  <% component.with_children do %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, align_items: :center)) do %>
      <%= render(Copilot::Purchase::AccountAvatarComponent.new(account: account)) %>

      <copilot-plan-account-select>
        <%= render(Primer::Alpha::SelectPanel.new(data: { target: 'copilot-plan-account-select.panel' }, fetch_strategy: :local, title: "Pick an account")) do |panel| %>
          <% panel.with_show_button do |button| %>
            <% button.with_leading_visual_icon(icon: :'arrow-switch') %> Switch
          <% end %>
          <% accounts.each do |account| %>
            <% panel.with_avatar_item(
              username: account[:slug],
              src: account[:avatar_url],
              avatar_arguments: { shape: :square },
              description_scheme: :inline,
              active: account_is_selected?(account),
              pl: 0,
              ml: 0,
              data: { name: account[:slug], type: account[:type] }
            ) do |item| %>
              <% item.with_description.with_content(account[:type]) %>
            <% end %>
          <% end %>
        <% end %>
      </copilot-plan-account-select>
    <% end %>
  <% end %>
<% end %>
