<% if account_is_adminable_by_user? %>
  <%= render(Copilot::Purchase::BillingContactComponent.new(selected_account: selected_account)) %>
  <%= render(Copilot::Purchase::PaymentMethodComponent.new(selected_account: selected_account)) %>
<% else %>
  <%= render(Copilot::Purchase::CheckoutSectionComponent.new(heading: "Billing information" )) do |component| %>
    <% component.with_children do %>
      <%= render(Primer::Beta::Octicon.new(icon: :shield, size: :small, mr: 2)) %>
      <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) do %>
        Your payment details are managed by <%= render(Primer::Beta::Link.new(underline: true, href: enterprise_path(selected_account))) { owning_account_name(selected_account) } %>. Read the <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_BILLING_DOCUMENTATION, underline: true)) { "billing documentation" } %>.
      <% end %>
    <% end %>
  <% end %>
<% end %>
