<% account_type = selected_account.is_a?(::Business) ? :enterprise : :organization %>
<% if can_see_billing? %>
  <% if invoiced? %>
    <%= render(Copilot::Purchase::CheckoutSectionComponent.new(heading: "Billing Information" )) do |component| %>
      <% component.with_children do %>
        <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) do %>
          This account is billed via invoice.
        <% end %>
      <% end %>
    <% end %>
  <% elsif has_azure_account? %>
    <%= render(Copilot::Purchase::CheckoutSectionComponent.new(heading: "Payment method" )) do |component| %>
      <% component.with_children do %>
        <div class="Box">
          <div class="Box-header d-flex flex-items-center">
            <div class="Box-title flex-auto ml-1 pl-2">
              <div <%= test_selector("azure-metered-billing-section") %>>
                Metered billing via Azure
              </div>
            </div>
          </div>
          <div class="Box-row d-flex flex-items-center color-fg-muted">
            <div class="d-flex width-full">
              <div class="d-flex flex-items-center">
                <%= render(Primer::Beta::Octicon.new(:link, height: 24)) %>
              </div>
              <div class="flex-1 ml-4">
                <div class="flex-auto text-left text-bold color-fg-muted">
                  <%= selected_account.customer&.azure_subscription_id %>
                </div>
                <div class="color-fg-muted flex-auto" <%= test_selector "azure_subscription_id" %>>
                  <%= selected_account.customer&.azure_subscription_name || "Subscription" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
   <%= render(Copilot::BillingInfoComponent.new(
      user: selected_account,
      subscribe_path: nil,
      payment_duration: "monthly",
      show_header: true,
      show_footer: false,
      show_border: true,
      return_to_path: copilot_plan_purchase_path(
        account_type => selected_account,
        utm_source: request.query_parameters[:utm_source],
        utm_medium: request.query_parameters[:utm_medium],
        utm_campaign: request.query_parameters[:utm_campaign],
        utm_term: request.query_parameters[:utm_term],
        utm_content: request.query_parameters[:utm_content],
        new_signup: request.query_parameters[:new_signup]
      ))) %>
    <% end %>
<% else %>
  <%= render(Copilot::Purchase::CheckoutSectionComponent.new(heading: "Billing Information" )) do |component| %>
    <% component.with_children do %>
      <%= render(Primer::Beta::Octicon.new(icon: :shield, size: :small, mr: 2)) %>
      <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) do %>
        Your payment details are managed by <%= render(Primer::Beta::Link.new(underline: true, href: enterprise_path(owning_account_name(selected_account)))) { owning_account_name(selected_account) } %>. Read the <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_BILLING_DOCUMENTATION, underline: true)) { "billing documentation" } %>.
      <% end %>
    <% end %>
  <% end %>
<% end %>
