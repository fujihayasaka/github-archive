<%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
  <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Usage" } %>
<% end %>
<%= render(Primer::Beta::BorderBox.new(padding: :default, classes: show_banner? ? "rounded-bottom-0 border-bottom-0" : "tmp-mb-3")) do |component| %>
  <%= component.with_row do %>
    <%= render(Primer::Box.new(display: :flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
      <%= render(Primer::Box.new(display: :flex, align_items: :center, direction: :row, flex: 1)) do %>
        <%= render(Primer::Beta::Text.new(tag: :span, mr: 2, font_weight: :bold)) { "Monthly Limit" } %>
        <%=
          render(
            partial: "copilot/aic/popover",
            locals: {
              heading: "Monthly Limit",
              body: "Usage limit per month, resets automatically. AI credit usage counts toward your monthly limit. Ask your account manager about increasing your overage when monthly limit is hit.",
              aria_label: "About Monthly Limit"
            }
          )
        %>
      <% end %>
      <%= render(Primer::Box.new(display: :flex, align_items: :center, direction: :row, flex: 1, justify_content: :flex_end, style: "max-width: 35%;")) do %>
        <% if usage_blocked? %>
          <%= render(Primer::Beta::Label.new(scheme: :danger, test_selector: "usage-blocked-badge")) { "Usage blocked" } %>
        <% elsif has_monthly_budget? %>
          <%= render(Copilot::AicProgressBarComponent.new(percent: @percent_used)) %>
        <% else %>
          <%= render(Primer::Beta::Label.new) { "No usage limit" } %>
        <% end %>
      <% end %>
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :span, color: :muted, font_size: "00")) { usage_limit_label } %>
  <% end %>
<% end %>
<% if show_banner? %>
  <%= render(Primer::Alpha::Banner.new(
    scheme: :danger,
    icon: :stop,
    test_selector: "usage-banner",
    classes: "rounded-top-0 tmp-mb-3",
  )) do %>
    <%= banner_text %>
  <% end %>
<% end %>
