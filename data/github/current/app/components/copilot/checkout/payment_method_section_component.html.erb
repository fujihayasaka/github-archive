<%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal, classes: "js-payment-methods-wrapper", test_selector: "payment-method-container") do %>
  <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4) do %>
    Payment method
  <% end %>

  <%= render Primer::Box.new(border: true, border_radius: 2, bg: :default, classes: "tmp-p-3") do %>
    <%= render Billing::Settings::PaymentMethodFormComponent.new(
      target: user,
      new_name_address_design: true,
      signature_view_context: Billing::Zuora::HostedPaymentsPage::COPILOT_SIGNATURE_VIEW_CONTEXT,
      return_to: return_to_path,
      show_auth_notice: true,
    ) %>

    <div class="form-group m-0">
      <input type="reset" value="Cancel" class="btn js-sponsors-cancel-edit-payment-method-btn" data-action="click:billing-checkout#cancelEditPaymentMethod" hidden>
    </div>
  <% end %>
<% end %>
