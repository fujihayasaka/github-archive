<copilot-overage-budget
  data-budgets-url="<%= @budgets_url %>"
  data-customer-id="<%= @customer_id %>"
  data-budget-uuid="<%= @budget_uuid %>"
  data-pricing-target-id="<%= @pricing_target_id %>"
>
<%= render(Primer::Alpha::Dialog.new(
  title: "Additional usage budget",
  id: "overage-budget-dialog",
  size: :medium,
)) do |d| %>
  <% d.with_show_button(scheme: :invisible, color: :accent, size: :small, test_selector: "edit-overage-budget") do %>
    <%= render(Primer::Beta::Octicon.new(:pencil, size: :small, classes: "tmp-mr-1")) %> Edit budget
  <% end %>
  <% d.with_body do %>
    <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, classes: "tmp-mb-3")) do %>
      Cap your maximum spend on additional pay-as-you-go usage when you run out of AI credits included with your plan.
    <% end %>
    <%= form_with(url: "#", id: "overage-budget-form", data: { target: "copilot-overage-budget.form", action: "submit:copilot-overage-budget#submit", test_selector: "overage-budget-form" }) do %>
      <%= render(Primer::Beta::Text.new(tag: :label, font_weight: :bold, display: :block, classes: "tmp-mb-1", "for": "budget_amount")) do %>
        Budget amount
      <% end %>
      <div class="d-flex flex-items-center mb-1">
        <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold, classes: "tmp-mr-1")) { "$" } %>
        <%= number_field_tag :budget_amount, @budget_amount, min: 0, step: 1, class: "form-control input-sm", id: "budget_amount", style: "width: 120px;", "aria-label": "Budget amount in dollars" %>
      </div>
      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: "00", classes: "tmp-mb-0")) do %>
        Setting budget amount as $0 disables additional usage spend
      <% end %>
    <% end %>
    <p data-target="copilot-overage-budget.errorMessage" class="color-fg-danger tmp-mt-2" hidden></p>
  <% end %>
  <% d.with_footer do %>
    <div class="d-flex flex-justify-between flex-items-center width-full">
      <%= render(Primer::Beta::Link.new(href: @budgets_url, scheme: :default, muted: false)) do %>
        More options
      <% end %>
      <div class="d-flex gap-2">
        <%= render(Primer::Beta::Button.new(data: { close_dialog_id: "overage-budget-dialog" }, test_selector: "cancel-overage-budget")) do %>
          Cancel
        <% end %>
        <%= render(Primer::Beta::Button.new(scheme: :primary, data: { action: "click:copilot-overage-budget#submit" }, test_selector: "submit-overage-budget")) do %>
          Update budget
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
</copilot-overage-budget>
