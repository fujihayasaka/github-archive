<%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row, test_selector: "copilot-mcp-registry-configuration-section")) do %>
  <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
    <%= render(Primer::Beta::Text.new(tag: :span, classes: "tmp-mb-1", font_weight: :bold)) do %>
      <%= @display_name %>
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :p, classes: "tmp-mb-1 tmp-mr-3", color: :muted)) do %>
      <%= description %>
    <% end %>
  <% end %>

  <%= render(Primer::Box.new(display: :flex, align_items: :center, gap: 3)) do %>
    <%= render(Primer::Box.new(display: :flex, align_items: :center, gap: 2, classes: "tmp-mr-3")) do %>
      <%= render(Primer::Beta::Octicon.new(icon: :"dot-fill", color: :muted, classes: "tmp-mr-1")) %>
      <%= render(Primer::Beta::Text.new(color: :muted)) { "Not set" } %>
    <% end %>

    <%= render(Primer::Alpha::Dialog.new(
      title: "Configure MCP Registry",
      id: dialog_id,
      position: :center,
      size: :medium_portrait
    )) do |dialog| %>
      <% dialog.with_show_button(disabled: !can_write) { "Configure" } %>
      <% dialog.with_header(show_divider: true) do %>
        <strong>Configure MCP Registry</strong>
      <% end %>

      <% dialog.with_body do %>
        <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, classes: "tmp-mb-3")) do %>
          Configure which MCP servers Copilot can use for this enterprise.
        <% end %>

        <div class="js-mcp-toggle-test" data-submit-path="<%= submit_path %>" data-registry-id="<%= registry&.id %>">
          <input type="hidden" name="registry_type" value="<%= registry&.registry_type || 'external' %>" class="js-mcp-type-value">
          <%= render(Primer::Alpha::SegmentedControl.new(
            aria: { label: "Registry type" },
            classes: "tmp-mb-3",
            full_width: true
          )) do |component| %>
            <% component.with_item(
              tag: :a,
              href: "#panel-test-external",
              label: "External Registry",
              selected: true
            ) %>
            <% component.with_item(
              tag: :a,
              href: "#panel-test-github",
              label: "GitHub Registry"
            ) %>
          <% end %>
        </div>

        <div id="panel-test-external">
          <div class="tmp-pt-3">
            <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, classes: "tmp-mb-3")) do %>
              Ideal if you already have a centralized registry.
            <% end %>

            <div class="form-group tmp-mb-3">
              <label class="form-label" for="registry-url-input">Registry URL</label>
              <input
                type="url"
                id="registry-url-input"
                class="form-control input-block"
                placeholder="https://your-registry-url-here"
                aria-label="Registry URL"
                <%= "disabled" unless can_write %>
              >
            </div>

            <div class="form-checkbox">
              <label>
                <input type="checkbox" <%= "disabled" unless can_write %>>
                Use registry as allowlist
              </label>
            </div>
          </div>
        </div>

        <div id="panel-test-github" hidden>
          <div class="tmp-pt-3">
            <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, classes: "tmp-mb-3")) do %>
              Manage your MCP allowlist directly in GitHub.
            <% end %>

            <div class="form-group tmp-mb-3">
              <label class="form-label">Registry URL</label>
              <div>
                <%= render(Primer::Beta::Link.new(href: "https://github.com/mcp", target: "_blank", rel: "noopener noreferrer")) do %>
                  https://github.com/mcp
                <% end %>
              </div>
            </div>

            <div class="github-allowlist-toggle-wrapper">
              <input
                type="checkbox"
                <%= "disabled" unless can_write %>
                id="github-allowlist-checkbox"
              >
              <label for="github-allowlist-checkbox" class="tmp-mb-3">
                Enable GitHub allowlist
              </label>

              <div class="form-group tmp-mb-3 github-allowlist-select">
                <%= render(Primer::Alpha::ActionMenu.new) do |menu| %>
                  <% menu.with_show_button(disabled: !can_write) do |button| %>
                    Select allowlist
                    <%= render(Primer::Beta::Octicon.new(icon: :"triangle-down", classes: "tmp-ml-1")) %>
                  <% end %>
                  <% menu.with_item(label: "Core MCP Servers") %>
                  <% menu.with_item(label: "First-party MCP Servers") do |item| %>
                    <% item.with_leading_visual_icon(icon: :check) %>
                    First-party MCP Servers
                  <% end %>
                  <% menu.with_divider %>
                  <% menu.with_item(label: "Manage allowlists") %>
                <% end %>
              </div>
            </div>

            <style>
              .github-allowlist-toggle-wrapper .github-allowlist-select {
                display: none;
              }
              .github-allowlist-toggle-wrapper input:checked ~ .github-allowlist-select {
                display: block;
              }
            </style>
          </div>
        </div>

      <% end %>
      <% dialog.with_footer(show_divider: true) do %>
        <div class="d-flex flex-justify-end gap-2">
          <%= render(Primer::Beta::Button.new(
            data: { "close-dialog-id": dialog_id }
          )) { "Cancel" } %>
          <%= render(Primer::Beta::Button.new(
            scheme: :primary,
            disabled: !can_write
          )) { "Save" } %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
