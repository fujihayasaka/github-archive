<%= render ::Copilot::Policies::UserSettingsRowComponent.new(
  value: @copilot_user.telemetry_enabled? ? 'enabled' : 'disabled',
  copilot_user: @copilot_user,
  policy_name: "telemetry",
  display_name: "Allow GitHub to use my data for AI model training",
  enablement_text: "",
  setting_changed: @setting_changed,
  policy_blocked_by: "",
  ) do |component| %>
    <%= component.with_description do %>
      Allow GitHub to collect and use my Inputs, Outputs, and associated context to train and improve AI models. Read more in the
      <%= render(Primer::Beta::Link.new(href: Copilot::github_general_privacy_statement_url, classes: "Link--inTextBlock")) do %>
        Privacy Statement
      <% end %>.
      <% if render_github_employee_text? %>
        <span class="d-block mt-2">
          If you are located in the United States, your data may be used for training unless you opt out. Data from
          Hubbers located outside the United States will not be used for training regardless of the value of this
          setting, even when this setting is enabled. In addition, for Hubbers in the U.S. that opt-in certain data is
          excluded from training based on a Hubber's role, team, or the types of data accessed in the course of their
          work.
        </span>
      <% end %>
    <% end %>
<% end %>
