<%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row, test_selector: "copilot-mcp-allowlist-section")) do %>
  <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
    <%= render(Primer::Beta::Text.new(tag: :span, classes: "tmp-mb-1", font_weight: :bold)) do %>
      <%= @display_name %>
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, classes: "tmp-mb-1 tmp-mr-3")) do %>
      <%= description %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::IconButton.new(
    tag: :a,
    href: mcp_allowlists_enterprise_ai_controls_enterprise_path(@configurable),
    icon: :"chevron-right",
    "aria-label": "Configure MCP Allowlists",
    scheme: :invisible,
    size: :medium,
  )) %>
<% end %>
