<%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row, ml: 3, test_selector: "copilot-mcp-allowlist")) do %>
  <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
    <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
      <%= @display_name %>
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :p, mb: 1, mr: 3, color: :muted)) do %>
      <%= description %>
    <% end %>
  <% end %>

  <% if disabled %>
    <%= render Primer::Beta::Button.new(tag: :summary, disabled: true) do %>
      <span data-menu-button><%= current_label %></span>
    <% end %>
  <% else %>
    <%= render Primer::Alpha::ActionMenu.new(
                select_variant: :single,
                anchor_align: :end,
                show_dividers: true,
                dynamic_label: true,
                anchor_side: :outside_bottom,
                size: :auto, # needed so the menu won't scrol vertically
                overlay_arguments: {
                  style: "width:min(320px, 100vw - 2rem)"
                }, # used to set the width of the menu to the same as size: small
              ) do |menu|
        menu.with_show_button do |button|
          button.with_trailing_action_icon(icon: :"triangle-down")
          "Select an access level"
        end

        menu_items.each do |menu_item|
          menu.with_item(
            label: menu_item.text,
            href: submit_path,
            method: path_method,
            form_arguments: {
              method: path_method,
              inputs: [
                {
                  name: "copilot_mcp_allowlist[registry_access]",
                  value: menu_item.value
                },
                {
                  name: "copilot_mcp_allowlist[registry_url]",
                  value: @copilot_business.mcp_registry_url
                }
              ]
            },
            active: menu_item.checked?,
          ) do |item|
            item.with_description.with_content(menu_item.description)
          end
          menu.with_divider unless menu_item.value == menu_items.last.value
        end
      end %>
  <% end %>
<% end %>
