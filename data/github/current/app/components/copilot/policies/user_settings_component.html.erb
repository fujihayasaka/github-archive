<copilot-user-settings
  data-onboarding="<%= onboarding? %>"
  data-enabled="<%= !(@disabled || @copilot_user.is_enterprise_managed?) %>"
  data-dashboard-entry-point-path="<%= copilot_dashboard_entry_point_enabled_path %>"
>
  <% if error? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger)) do %>
      <% if !@error_message.nil? %>
        <%= @error_message %>
      <% else %>
        <span id="cfi-error-text">Select an option below to continue.</span>
      <% end %>
    <% end %>
  <% end %>

  <% if has_single_seat? %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
      <%= render(Primer::Box.new) do %>
        <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
        <%= render(Primer::Beta::Text.new(color: :muted)) do %>
          Managed by <%= link_to(copilot_provider&.display_login, h(copilot_provider_path), class: "Link--inTextBlock") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= form_with(
    url: @submit_path,
    method: "put",
    data: {
      target: "copilot-user-settings.form",
    }
  ) do |f| %>
    <% if show_custom_instructions_sso_banner? %>
      <%= render ConditionalAccess::UnauthorizedAccountsComponent.new(
        classes: "Box my-1",
        container_classes: "mb-3",
        resource_label: "organizations",
        cap_filter: cap_filter,
        accounts: orgs_with_custom_instructions,
      )%>
    <% end %>


    <%# ============== START OF BILLING POLICIES SECTION ============== %>
    <%# today, overages is the only billing policy %>
    <%# if more billing policies are added in the future, the conditions need to be modified/removed %>
    <% if render_billing_section? %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
        <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Billing" } %>
      <% end %>

      <%= render(Primer::Beta::BorderBox.new(padding: :default, mb: 3)) do |component| %>
        <% if render_copilot_overages_policy? %>
          <%= component.with_row do %>
            <input type="hidden" name="overages" value="<%= overages_value %>">
            <%= render(Primer::Box.new(id: "copilot-overages-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
                <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                  <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                    <%= Copilot::COPILOT_OVERAGES %>
                  <% end %>
                  <% if is_readonly_mode? %>
                    <%= render(Primer::Box.new) do %>
                      <%= render_enablement_text("overages", copilot_policy_overages_text) %>
                    <% end %>
                  <% else %>
                    <%= render(
                      Primer::Alpha::ToggleSwitch.new(
                        size: :small,
                        status_label_position: :start,
                        csrf_token: "",
                        id: "overagesToggle",
                        checked: @copilot_user.overages_enabled?,
                        aria: { label: "Opt in for access to Copilot overages" },
                        data: {
                          action: "click:copilot-user-settings#updateOveragesSetting",
                          target: "copilot-user-settings.overagesToggle",
                          checked: @copilot_user.overages_enabled?,
                        }
                      )
                    ) %>
                  <% end %>
                <% end %>
                <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_overages_label", col: 10)) do %>
                  Enables usage of additional premium requests beyond the amount included in your plan, applicable across all Copilot interfaces, including Mobile. You will be billed at $0.04 per premium request.
                  <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, col: 10)) do %>
                    <%= inline_docs_link("", "Learn more.") %>
                  <% end %>
                  <% if !has_single_seat? && @copilot_user.overages_disabled? && !@copilot_user.has_cfi_access? %>
                    <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_overages_setting_managed_by_label", col: 10)) do %>
                      <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
                      <%= policy_blocked_by(:overages) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <% if render_billable_customer_menu? %>
          <%= component.with_row do %>
            <input type="hidden" name="billable_customer" value="<%= @copilot_user.billable_customer_id %>">
            <%= render(Primer::Box.new(id: "copilot-overages-billable-customer", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
                <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, direction: :row)) do %>
                  <div>
                    <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                      <%= Copilot::COPILOT_BILLABLE_CUSTOMER %>
                    <% end %>
                    <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, color: :muted, id: "billable_customer_label", col: 10)) do %>
                      Choose who pays for your Copilot premium requests usage<%= enabled_copilot_premium_products %>. Included usage from their license applies.
                    <% end %>
                  </div>
                  <%= render Primer::Alpha::ActionMenu.new(
                    select_variant: :single,
                    anchor_align: :end,
                    dynamic_label: true,
                    data: {
                      action: "click:copilot-user-settings#updateBillableCustomer",
                      target: "copilot-user-settings.billableCustomerMenu",
                    }) do |menu| %>
                    <% menu.with_show_button do |button|
                      button.with_trailing_action_icon(icon: :"triangle-down")
                      billable_customer_button_text
                    end %>
                    <% copilot_customers.each do |customer| %>
                      <% menu.with_item(
                          label: customer[:name],
                          data: { value: customer[:id] },
                          active: @copilot_user.billable_customer_id == customer[:id],
                      ) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%# ============== END OF BILLING POLICIES SECTION ============== %>

    <%# =================== START OF USAGE SECTION ====================== %>

    <% if limited_access_user? && @copilot_user.feature_flag_enabled?(:copilot_ftp_settings_upgrade, default: false) %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
        <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Usage" } %>
      <% end %>

      <%= render(Primer::Beta::BorderBox.new(mb: 3)) do |component| %>
        <%= component.with_row do %>
          <% if show_new_quota_ui? %>
            <div <%= test_selector("copilot-quota-usage-partial") %>>
              <%= render_react_partial name: "copilot-quota-usage", props: quota_usage_partial_props %>
            </div>
          <% else %>
            <%= render(Primer::Box.new(test_selector: "copilot-usage-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
                <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                  <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                    You are using Copilot for free
                  <% end %>
                <% end %>
                <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, test_selector: "copilot-usage-policy-label", col: 10)) do %>
                  Responses are limited to 2,000 code completions and 50 chat messages per month.
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <%= component.with_footer(py: new_ui_any_quota_exhausted? ? 3 : 2, **usage_footer_args) do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Box.new(display: :inline_flex, direction: :row, align_items: :center)) do %>
                  <% if new_ui_any_quota_exhausted? %>
                    <%= render(Primer::Beta::Octicon.new(icon: :info, size: :small, color: :attention, mx: 2, aria_hidden: true)) %>
                  <% end %>
                  <%= render(Primer::Beta::Text.new(test_selector: "copilot-usage-reset-indicator", tag: :span, color: new_ui_any_quota_exhausted? ? :default : :muted)) do %>
                    <% if new_ui_any_quota_exhausted? %>You've reached your free plan limit.<% end %>
                    Upgrade for higher limits, premium models, AI reviews.
                    <% if limited_user_reset_date %>
                      <% if new_ui_any_quota_exhausted? %><br><% end %>
                      Free responses reset in <%= pluralize((limited_user_reset_date - Date.current).to_i, 'day') %>.
                    <% end %>
                  <% end %>
                <% end %>
                <%= render Primer::Beta::Button.new(
                  tag: :a,
                  ml: 2,
                  scheme: new_ui_any_quota_exhausted? ? :primary : :default,
                  href: copilot_pro_signup_path,
                  data: analytics_click_attributes(
                    category: "user_copilot_settings",
                    action: "upgrade_clicked",
                    label: new_ui_any_quota_exhausted? ? "ref_cta:quota_exhausted_upgrade_button" : "ref_cta:quota_not_exhausted_upgrade_button"
                  )
                ).with_content("Upgrade") %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%# ==================== END OF USAGE SECTION ======================= %>

    <%# ============== START OF FEATURES POLICIES SECTION ============== %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
      <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Features" } %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(padding: :default, mb: 3)) do |component| %>

      <% if show_custom_instructions_options? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(id: "copilot-chat-default-custom-instructions", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, test_selector: :copilot_chat_default_custom_instructions)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                  <%= Copilot::COPILOT_DEFAULT_CUSTOM_INSTRUCTIONS %>
                <% end %>
                  <%= render(Primer::Alpha::SelectPanel.new(
                    fetch_strategy: :local,
                    title: "Select an organization",
                    use_experimental_non_local_form: user_feature_enabled?(:primer_select_panel_use_experimental_non_local_form),
                    form_arguments: { builder: f, name: "default_org_custom_instructions" },
                    data: {
                      action: "click:copilot-user-settings#updateDefaultOrgCustomInstructions",
                      target: "copilot-user-settings.defaultOrgCustomInstructions"
                    }
                    )) do |panel| %>
                    <% panel.with_show_button(
                      "data-test-selector": "default-custom-instructions",
                      "aria-label": "Default custom instructions #{default_custom_instructions_org.display_login}") do |button| %>
                      <% button.with_trailing_action_icon(icon: :"triangle-down") %>

                      <div class="d-flex flex-justify-end flex-items-center">
                        <%= render(GitHub::AvatarComponent.new(actor: default_custom_instructions_org, mr: 2)) %>
                        <%= default_custom_instructions_org.display_login %>
                      </div>
                    <% end %>

                    <% authorized_orgs_with_custom_instructions.each do |org| %>
                      <% panel.with_avatar_item(
                        username: org.display_login,
                        src: helpers.avatar_url_for(org),
                        avatar_arguments: { shape: :square },
                        description_scheme: :inline,
                        test_selector: "default-custom-instructions-option",
                        active: default_custom_instructions_org&.id == org.id,
                        content_arguments: { data: {
                          value: org.id,
                          login: org.display_login,
                          avatar: helpers.avatar_url_for(org)
                        }},
                      ) do |item| %>
                        <% item.with_description.with_content(org.display_login) %>
                      <% end %>
                    <% end %>
                  <% end %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_default_custom_instructions_label", col: 10)) do %>
                You belong to multiple organizations with Copilot access. Set a default instruction for general chat.
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if !limited_access_user? && @copilot_user.feature_flag_enabled?(:copilot_next_edit_suggestions, default: false) %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            value: @copilot_user.editor_preview_features,
            copilot_user: @copilot_user,
            policy_name: "editor_preview_features",
            display_name: Copilot::EDITOR_PREVIEW_FEATURES,
            enablement_text: render_read_only_enablement_text("editor_preview_features", @copilot_user.editor_preview_features_enabled?, true),
            setting_changed: false,
            policy_blocked_by: (!has_single_seat? && @copilot_user.editor_preview_features_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:editor_preview_features) : "",
            ) do |component| %>
              <%= component.with_description do %>
                You can use preview features in your editor. <%= inline_docs_link(Copilot::EDITOR_PREVIEW_FEATURES_DOCS, "Learn more.") %>
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if !limited_access_user? && !@copilot_user.has_cfi_access? && @copilot_user.feature_flag_enabled?(:copilot_agent_mode_show_policy, default: false) %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            value: @copilot_user.agent_mode,
            copilot_user: @copilot_user,
            policy_name: "agent_mode",
            display_name: Copilot::AGENT_MODE,
            enablement_text: render_read_only_enablement_text("agent_mode", @copilot_user.agent_mode_enabled?, true),
            setting_changed: false,
            policy_blocked_by: (!has_single_seat? && @copilot_user.agent_mode_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:agent_mode) : "",
            ) do |component| %>
              <%= component.with_description do %>
                You can use agent mode in your editor.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= component.with_row do %>
        <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
          value: @copilot_user.dotcom_chat,
          copilot_user: @copilot_user,
          policy_name: "dotcom_chat",
          display_name: Copilot::COPILOT_IN_DOTCOM,
          enablement_text: render_read_only_enablement_text("dotcom_chat", @copilot_user.dotcom_chat_enabled?, true),
          setting_changed: false,
          policy_blocked_by: (!has_single_seat? && @copilot_user.dotcom_chat_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:dotcom_chat) : "",
          preview: !(has_copilot_enterprise_access? || @copilot_user.feature_flag_enabled?(:copilot_chat_dotcom_ga, default: true)),
          ) do |component| %>
            <%= component.with_description do %>
              <%= subtext %>
            <% end %>
        <% end %>
      <% end %>

      <% unless limited_access_user? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            value: @copilot_user.cli,
            copilot_user: @copilot_user,
            policy_name: "cli",
            display_name: Copilot::CLI_UI_NAME,
            enablement_text: render_read_only_enablement_text("cli", @copilot_user.cli_enabled?, true),
            setting_changed: false,
            policy_blocked_by: (!has_single_seat? && @copilot_user.cli_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:cli) : "",
            ) do |component| %>
              <%= component.with_description do %>
                You can use <%= inline_docs_link(Copilot::COPILOT_FOR_CLI_USAGE_DOCUMENTATION, "GitHub Copilot for assistance in terminal") %>.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if !limited_access_user? && @copilot_user.feature_flag_enabled?(:copilot_extension_access, default: false) && copilot_access_through_org_or_business? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            value: @copilot_user.copilot_extensions,
            copilot_user: @copilot_user,
            policy_name: "copilot_extensions",
            display_name: Copilot::COPILOT_EXTENSION,
            enablement_text: render_read_only_enablement_text("copilot_extensions", @copilot_user.copilot_extensions_enabled?, true),
            setting_changed: changed?(:copilot_extensions),
            policy_blocked_by: (!has_single_seat? && @copilot_user.copilot_extensions_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:copilot_extensions) : "",
            ) do |component| %>
              <%= component.with_description do %>
                <% if @copilot_user.copilot_extensions_enabled? && !@copilot_user.user_object.is_enterprise_managed? %>
                  You can use GitHub Copilot Extensions and install them to your personal account. To enable for organization repositories and data, you must request installation from an administrator in <%= link_to(copilot_provider&.display_login, h(copilot_provider_path), class: "Link--inTextBlock") %>.
                <% elsif @copilot_user.copilot_extensions_enabled? && @copilot_user.user_object.is_enterprise_managed? %>
                    You can use GitHub Copilot Extensions, but you cannot install them onto your individual account. An organization owner must install them at the organization level. You can contact an administrator in <%= link_to(copilot_provider&.display_login, h(copilot_provider_path), class: "Link--inTextBlock") %> to request access.
                <% else %>
                  GitHub Copilot Extensions are not available for use in your account. You can contact an administrator in <%= link_to(copilot_provider&.display_login, h(copilot_provider_path), class: "Link--inTextBlock") %> to request access.
                <% end %>
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if @copilot_user.feature_flag_enabled?(:copilot_desktop_user_refactor, default: false) %>
        <% if Copilot::Policies::Desktop.available_for?(@copilot_user) %>
          <%= component.with_row do %>
            <%= render ::Copilot::Policies::UserFormComponent.new(
              policy_class: Copilot::Policies::Desktop,
              copilot_user: @copilot_user,
              enablement_text: render_read_only_enablement_text("desktop", Copilot::Policies::Desktop.effective_value(@copilot_user) == "enabled", true),
              setting_changed: false,
              policy_blocked_by: (!has_single_seat? && @copilot_user.desktop_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:desktop) : "",
              ) do |component| %>
                <%= component.with_description do %>
                  You can use <%= inline_docs_link(Copilot::Policies::Desktop.documentation_url, "GitHub Copilot for assistance in GitHub Desktop") %>.
                <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <% if render_desktop_policy? %>
          <%= component.with_row do %>
            <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
              value: @copilot_user.desktop,
              copilot_user: @copilot_user,
              policy_name: "desktop",
              display_name: Copilot::COPILOT_DESKTOP,
              enablement_text: render_read_only_enablement_text("desktop", @copilot_user.desktop_enabled?, true),
              setting_changed: false,
              policy_blocked_by: (!has_single_seat? && @copilot_user.desktop_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:desktop) : "",
              preview: !@copilot_user.feature_flag_enabled?(:copilot_desktop_no_preview_badge, default: false)
              ) do |component| %>
                <%= component.with_description do %>
                  You can use <%= inline_docs_link(Copilot::COPILOT_IN_DESKTOP_DOCUMENTATION, "GitHub Copilot for assistance in GitHub Desktop") %>.
                <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>


      <% unless limited_access_user? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            value: @copilot_user.chat_setting,
            copilot_user: @copilot_user,
            policy_name: "chat",
            display_name: Copilot::COPILOT_CHAT_IN_IDE,
            enablement_text: render_read_only_enablement_text("chat", @copilot_user.chat_enabled?, true),
            setting_changed: false,
            policy_blocked_by: (!has_single_seat? && @copilot_user.chat_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:chat_enabled) : "",
            ) do |component| %>
              <%= component.with_description do %>
                You can use <%= inline_docs_link(Copilot::COPILOT_CHAT_IDE_DOCS, "GitHub Copilot Chat in the IDE") %> to explain a piece of code, propose bug fixes, or generate unit tests in a chat interface from your editor.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% unless limited_access_user? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            value: @copilot_user.mobile_chat,
            copilot_user: @copilot_user,
            policy_name: "mobile_chat",
            display_name: Copilot::COPILOT_CHAT_IN_MOBILE,
            enablement_text: render_read_only_enablement_text("mobile_chat", @copilot_user.mobile_chat_enabled?, true),
            setting_changed: false,
            policy_blocked_by: (!has_single_seat? && @copilot_user.mobile_chat_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:mobile_chat) : "",
            ) do |component| %>
              <%= component.with_description do %>
                You can use <%= inline_docs_link(Copilot::COPILOT_CHAT_MOBILE_DOCS, "Copilot Chat in GitHub Mobile") %> personalized to a codebase.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= component.with_row do %>
        <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
          value: @copilot_user.bing_github_chat,
          copilot_user: @copilot_user,
          policy_name: "copilot_policy_bing",
          display_name: Copilot::COPILOT_BING_ACCESS,
          enablement_text: render_read_only_enablement_text("bing_github_chat", @copilot_user.bing_github_chat_enabled?),
          setting_changed: changed?(:github_chat_bing_access_setting),
          policy_blocked_by: (!has_single_seat? && @copilot_user.bing_github_chat_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:bing_github_chat) : "",
          ) do |component| %>
            <%= component.with_description do %>
              Copilot can answer questions about new trends and give improved answers, via Bing. See
              <%= inline_docs_link(Copilot::MICROSOFT_PRIVACY_STATEMENT_URL, "Microsoft Privacy Statement") %>
            <% end %>
        <% end %>
      <% end %>

      <% if has_individual_access? && !render_code_review_policy? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            value: @copilot_user.automatic_code_review,
            copilot_user: @copilot_user,
            policy_name: "automatic_code_review",
            display_name: Copilot::AUTOMATIC_CODE_REVIEW,
