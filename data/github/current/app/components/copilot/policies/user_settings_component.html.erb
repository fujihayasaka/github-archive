<copilot-user-settings
  data-onboarding="<%= onboarding? %>"
  data-enabled="<%= !(@disabled || @copilot_user.is_enterprise_managed?) %>"
  data-dashboard-entry-point-emu-fix="<%= @copilot_user.feature_enabled?(:copilot_dashboard_entry_point_emu_fix) %>"
  data-dashboard-entry-point-path="<%= copilot_dashboard_entry_point_enabled_path %>"
>
  <% if error? %>
    <%= render(Primer::Box.new(bg: :danger, border: true, border_radius: 3, border_color: :danger_emphasis, p: 3, mb: 4)) do |component| %>
      <%= render(Primer::Box.new(color: :danger, font_weight: :light)) do %>
        <%= render(Primer::Beta::Octicon.new(mr: 2, icon: :stop)) %>
        <span id="cfi-error-text">Select an option below to continue.</span>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
    <% if has_single_seat? %>
      <%= render(Primer::Box.new) do %>
        <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
        <%= render(Primer::Beta::Text.new(color: :muted)) do %>
          Managed by <%= link_to(copilot_provider&.display_login, h(copilot_provider_path), class: "Link--inTextBlock") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= form_with(
    url: @submit_path,
    method: "put",
    data: {
      target: "copilot-user-settings.form",
    }
  ) do |f| %>
    <input type="hidden" name="public_code_suggestions" value="<%= public_code_suggestion_value %>">
    <input type="hidden" name="copilot_policy_bing" value="<%= copilot_policy_bing_value %>">

    <% if show_custom_instructions_sso_banner? %>
      <%= render ConditionalAccess::UnauthorizedAccountsComponent.new(
        classes: "Box my-1",
        container_classes: "mb-3",
        resource_label: "organizations",
        cap_filter: cap_filter,
        accounts: orgs_with_custom_instructions,
      )%>
    <% end %>


    <%# ============== START OF BILLING POLICIES SECTION ============== %>
    <%# today, overages is the only billing policy %>
    <%# if more billing policies are added in the future, the conditions need to be modified/removed %>
    <% if !limited_access_user? && @copilot_user.feature_enabled?(:copilot_overages) %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
        <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Billing" } %>
      <% end %>

      <%= render(Primer::Beta::BorderBox.new(padding: :default, mb: 3)) do |component| %>
        <%= component.with_row do %>
          <input type="hidden" name="overages" value="<%= overages_value %>">
          <%= render(Primer::Box.new(id: "copilot-overages-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                  <%= Copilot::COPILOT_OVERAGES %>
                <% end %>
                <% if is_readonly_mode? %>
                  <%= render(Primer::Box.new) do %>
                    <%= render_enablement_text("overages", copilot_policy_overages_text) %>
                  <% end %>
                <% else %>
                  <%= render(Primer::Box.new(display: :flex, direction: :row)) do %>
                    <% if changed?(:overages_setting) %>
                      <%= render Primer::Box.new(display: :flex, direction: :column, mr: 1, classes: 'hx_anim-fade-out') do %>
                        <%= render Primer::Beta::Octicon.new(icon: "check", size: :small, mt: 2, mr: 2, color: :success) %>
                      <% end %>
                    <% end %>
                    <%= render GitHub::MenuComponent.new(
                      id: "overages_menu",
                      tag: :button,
                      style: "opacity: 0.5; pointer-events: none;",
                      items: overages_menu_items,
                      align: :right,
                      data: {
                        action: "click:copilot-user-settings#updateOveragesSetting",
                        target: "copilot-user-settings.overages"
                      }) do |menu| %><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
                      <% menu.with_summary do %>
                        <%= render Primer::Beta::Button.new(tag: :summary) do |component| %>
                          <% component.with_trailing_action_icon(icon: "triangle-down") %>
                          <span data-menu-button><%= menu.default_selection_text || "Select an option" %></span>
                        <% end %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_overages_label", col: 10)) do %>
                If enabled, additional premium requests beyond the included amount for each license will be billed.
                <%= inline_docs_link("", "Learn more.") %>
                <% if !has_single_seat? && @copilot_user.overages_disabled? && !@copilot_user.has_cfi_access? %>
                  <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_overages_setting_managed_by_label", col: 10)) do %>
                    <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
                    <%= policy_blocked_by(:overages) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%# ============== END OF BILLING POLICIES SECTION ============== %>

    <%# ============== START OF FEATURES POLICIES SECTION ============== %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
      <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Features" } %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(padding: :default, mb: 3)) do |component| %>

      <% if show_custom_instructions_options? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(id: "copilot-chat-default-custom-instructions", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, test_selector: :copilot_chat_default_custom_instructions)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                  <%= Copilot::COPILOT_DEFAULT_CUSTOM_INSTRUCTIONS %>
                <% end %>
                  <%= render(Primer::Alpha::SelectPanel.new(
                    fetch_strategy: :local,
                    title: "Select an organization",
                    form_arguments: { builder: f, name: "default_org_custom_instructions" },
                    data: {
                      action: "click:copilot-user-settings#updateDefaultOrgCustomInstructions",
                      target: "copilot-user-settings.defaultOrgCustomInstructions"
                    }
                    )) do |panel| %>
                    <% panel.with_show_button(
                      "data-test-selector": "default-custom-instructions",
                      "aria-label": "Default custom instructions #{default_custom_instructions_org.display_login}") do |button| %>
                      <% button.with_trailing_action_icon(icon: :"triangle-down") %>

                      <div class="d-flex flex-justify-end flex-items-center">
                        <%= render(GitHub::AvatarComponent.new(actor: default_custom_instructions_org, mr: 2)) %>
                        <%= default_custom_instructions_org.display_login %>
                      </div>
                    <% end %>

                    <% authorized_orgs_with_custom_instructions.each do |org| %>
                      <% panel.with_avatar_item(
                        username: org.display_login,
                        src: helpers.avatar_url_for(org),
                        avatar_arguments: { shape: :square },
                        description_scheme: :inline,
                        test_selector: "default-custom-instructions-option",
                        active: default_custom_instructions_org&.id == org.id,
                        content_arguments: { data: {
                          value: org.id,
                          login: org.display_login,
                          avatar: helpers.avatar_url_for(org)
                        }},
                      ) do |item| %>
                        <% item.with_description.with_content(org.display_login) %>
                      <% end %>
                    <% end %>
                  <% end %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_default_custom_instructions_label", col: 10)) do %>
                You belong to multiple organizations with Copilot access. Set a default instruction for general chat.
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if !limited_access_user? && @copilot_user.feature_enabled?(:copilot_next_edit_suggestions) %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(id: "copilot-editor-preview-features-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
                <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                  <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                    <%= Copilot::EDITOR_PREVIEW_FEATURES %>
                  <% end %>
                  <%= render_enablement_text("editor_preview_features", @copilot_user.editor_preview_features_enabled? ? "Enabled" : "Disabled") %>
                <% end %>
                <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_cli_setting_label", col: 10)) do %>
                  You can use preview features in your editor.
                  <% if !has_single_seat? && @copilot_user.editor_preview_features_disabled? %>
                    <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_editor_preview_features_setting_managed_by_label", col: 10)) do %>
                      <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
                      <%= policy_blocked_by(:editor_preview_features) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
        <% end %>
      <% end %>

      <%= component.with_row do %>
        <%= render(Primer::Box.new(id: "copilot-in-dotcom-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
          <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
              <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                <%= Copilot::COPILOT_IN_DOTCOM %>
                <% unless has_copilot_enterprise_access? || @copilot_user.feature_enabled?(:copilot_chat_dotcom_ga) %>
                  <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2)) do %>
                    Preview
                  <% end %>
                <% end %>
              <% end %>
              <%= render_enablement_text("dotcom_chat", @copilot_user.dotcom_chat_enabled? ? "Enabled" : "Disabled") %>
            <% end %>
            <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_dotcom_setting_label", col: 10)) do %>
              <% prs_subtext = "" %>
              <% prs_subtext += ", Copilot for pull requests" unless limited_access_user? %>
              <% bing_subtext = "" %>
              <% bing_subtext += ", knowledge base search" if @copilot_user.has_knowledge_bases? %>
              <% if @copilot_user.beta_features_github_chat_enabled? %>
                <% bing_subtext += ", and all of the preview features" %>
              <% else %>
                <% bing_subtext += ", but not preview features" %>
              <% end %>
              You can use Copilot Chat in GitHub.com<%= prs_subtext %><%= bing_subtext %>.
              <%= inline_docs_link(Copilot::COPILOT_DOTCOM_CHAT_DOCUMENTATION, "Learn more about Copilot in GitHub.com") %>              <% end %>
            <% if !has_single_seat? && @copilot_user.dotcom_chat_disabled? && !@copilot_user.has_cfi_access? %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_dotcom_setting_managed_by_label", col: 10)) do %>
                <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
                <%= policy_blocked_by(:dotcom_chat) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% unless limited_access_user? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(id: "copilot-cli-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                  <%= Copilot::CLI_UI_NAME %>
                <% end %>
                <%= render_enablement_text("cli", @copilot_user.cli_enabled? ? "Enabled" : "Disabled") %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_cli_setting_label", col: 10)) do %>
                You can use <%= inline_docs_link(Copilot::COPILOT_FOR_CLI_USAGE_DOCUMENTATION, "GitHub Copilot for assistance in terminal") %>.
                <% if !has_single_seat? && @copilot_user.cli_disabled? %>
                  <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_cli_setting_managed_by_label", col: 10)) do %>
                    <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
                    <%= policy_blocked_by(:cli) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if !limited_access_user? && @copilot_user.feature_enabled?(:copilot_extension_access) && copilot_access_through_org_or_business? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(id: "copilot-extensions-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                  <%= Copilot::COPILOT_EXTENSION %>
                <% end %>
                <%= render_enablement_text("copilot_extensions", copilot_extensions) %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_extensions_setting_label", col: 10)) do %>
                <% if @copilot_user.copilot_extensions_enabled? && !@copilot_user.user_object.is_enterprise_managed? %>
                  You can use GitHub Copilot Extensions and install them to your personal account. To enable for organization repositories and data, you must request installation from an administrator in <%= link_to(copilot_provider&.display_login, h(copilot_provider_path), class: "Link--inTextBlock") %>.
                <% elsif @copilot_user.copilot_extensions_enabled? && @copilot_user.user_object.is_enterprise_managed? %>
                   You can use GitHub Copilot Extensions, but you cannot install them onto your individual account. An organization owner must install them at the organization level. You can contact an administrator in <%= link_to(copilot_provider&.display_login, h(copilot_provider_path), class: "Link--inTextBlock") %> to request access.
                <% else %>
                  GitHub Copilot Extensions are not available for use in your account. You can contact an administrator in <%= link_to(copilot_provider&.display_login, h(copilot_provider_path), class: "Link--inTextBlock") %> to request access.
                <% end %>
                <% if !has_single_seat? && @copilot_user.copilot_extensions_disabled? %>
                  <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_extensions_setting_managed_by_label", col: 10)) do %>
                    <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
                    <%= policy_blocked_by(:copilot_extensions) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if render_desktop_policy? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(id: "copilot-desktop-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                  <%= Copilot::COPILOT_DESKTOP %>
                  <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2)) do %>
                    Preview
                  <% end %>
                <% end %>
                <%= render_enablement_text("desktop", @copilot_user.desktop_enabled? ? "Enabled" : "Disabled") %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_desktop_setting_label", col: 10)) do %>
                You can use <%= inline_docs_link(Copilot::COPILOT_IN_DESKTOP_USAGE_DOCUMENTATION, "GitHub Copilot for assistance in GitHub Desktop") %>.
                <% if !has_single_seat? && @copilot_user.desktop_disabled? %>
                  <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_desktop_setting_managed_by_label", col: 10)) do %>
                    <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
                    <%= policy_blocked_by(:desktop) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% unless limited_access_user? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(id: "copilot-chat-ide-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                  <%= Copilot::COPILOT_CHAT_IN_IDE %>
                <% end %>
                <%= render_enablement_text("ide_chat", @copilot_user.chat_enabled? ? "Enabled" : "Disabled") %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_chat_ide_label", col: 10)) do %>
                You can use <%= inline_docs_link(Copilot::COPILOT_CHAT_IDE_DOCS, "GitHub Copilot Chat in the IDE") %> to explain a piece of code, propose bug fixes, or generate unit tests in a chat interface from your editor.
                <% if !has_single_seat? && @copilot_user.chat_disabled? %>
                  <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_chat_setting_managed_by_label", col: 10)) do %>
                    <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
                    <%= policy_blocked_by(:chat_enabled) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% unless limited_access_user? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(id: "copilot-mobile-chat-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                  <%= Copilot::COPILOT_CHAT_IN_MOBILE %>
                <% end %>
                <%= render(Primer::Box.new) do %>
                  <%= render_enablement_text("mobile_chat", @copilot_user.mobile_chat_enabled? ? "Enabled" : "Disabled") %>
                <% end %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_mobile_setting_label", col: 10)) do %>
                You can use <%= inline_docs_link(Copilot::COPILOT_CHAT_MOBILE_DOCS, "Copilot Chat in GitHub Mobile") %> personalized to a codebase.
                <% if !has_single_seat? && !@copilot_user.mobile_chat_enabled? %>
                  <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_mobile_chat_setting_managed_by_label", col: 10)) do %>
                    <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
                    <%= policy_blocked_by(:mobile_chat) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= component.with_row do %>
        <%= render(Primer::Box.new(id: "copilot-bing-chat-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
          <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
              <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                <%= Copilot::COPILOT_BING_ACCESS %>
              <% end %>
              <% if is_readonly_mode? %>
                <%= render(Primer::Box.new) do %>
                  <%= render_enablement_text("bing_access", copilot_policy_bing_text) %>
                <% end %>
              <% else %>
                <%= render(Primer::Box.new(display: :flex, direction: :row)) do %>
                  <% if changed?(:github_chat_bing_access_setting) %>
                    <%= render Primer::Box.new(display: :flex, direction: :column, mr: 1, classes: 'hx_anim-fade-out') do %>
                      <%= render Primer::Beta::Octicon.new(icon: "check", size: :small, mt: 2, mr: 2, color: :success) %>
                    <% end %>
                  <% end %>
                  <%= render GitHub::MenuComponent.new(
                    id: "copilot_policy_bing_menu",
                    tag: :button,
                    style: "opacity: 0.5; pointer-events: none;",
                    items: bing_menu_items,
                    align: :right,
                    data: {
                      action: "click:copilot-user-settings#updateCopilotPolicyBing",
                      target: "copilot-user-settings.copilotPolicyBing"
                    }) do |menu| %><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
                    <% menu.with_summary do %>
                      <%= render Primer::Beta::Button.new(tag: :summary) do |component| %>
                        <% component.with_trailing_action_icon(icon: "triangle-down") %>
                        <span data-menu-button><%= menu.default_selection_text || "Select an option" %></span>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
            <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_bing_access_label", col: 10)) do %>
