<copilot-user-settings
  data-onboarding="<%= onboarding? %>"
  data-enabled="<%= !(@disabled || @copilot_user.is_enterprise_managed?) %>"
  data-dashboard-entry-point-path="<%= copilot_dashboard_entry_point_enabled_path %>"
  <%= test_selector("user-settings") %>
>
  <% if error? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger)) do %>
      <% if !@error_message.nil? %>
        <%= @error_message %>
      <% else %>
        <span id="cfi-error-text">Select an option below to continue.</span>
      <% end %>
    <% end %>
  <% end %>

  <% if has_single_seat? %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
      <%= render(Primer::Box.new) do %>
        <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
        <%= render(Primer::Beta::Text.new(color: :muted)) do %>
          Managed by <%= link_to(copilot_provider&.display_login, h(copilot_provider&.provider_path), class: "Link--inTextBlock") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= form_with(
    url: @submit_path,
    method: "put",
    data: {
      target: "copilot-user-settings.form",
    }
  ) do |f| %>
    <% if show_custom_instructions_sso_banner? %>
      <%= render ConditionalAccess::UnauthorizedAccountsComponent.new(
        classes: "Box my-1",
        container_classes: "tmp-mb-3",
        resource_label: "organizations",
        cap_filter: cap_filter,
        accounts: orgs_with_custom_instructions,
      )%>
    <% end %>


    <%# ============== START OF BILLING POLICIES SECTION ============== %>
    <% if render_billing_section? %>
      <% if render_billable_customer_menu? %>
        <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
        <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Billing" } %>
        <% end %>

        <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-4")) do |component| %>
          <%= component.with_row do %>
            <input type="hidden" name="billable_customer" value="<%= @copilot_user.billable_customer_id %>">
            <%= render(Primer::Box.new(id: "copilot-overages-billable-customer", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
                <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, direction: :row)) do %>
                  <div>
                    <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                      <%= Copilot::COPILOT_BILLABLE_CUSTOMER %>
                    <% end %>
                    <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, color: :muted, id: "billable_customer_label", col: show_usage_for_copilot_seat? ? 12 : 10)) do %>
                      <% if show_usage_for_copilot_seat? %>
                        Select who pays for your AI credits usage (Copilot, Copilot coding agent, and Spark).
                      <% else %>
                        Choose who pays for your Copilot premium requests usage (Copilot, Spark, and Copilot cloud agent). Included usage from their license applies.
                      <% end %>
                    <% end %>
                  </div>
                  <%= render Primer::Alpha::ActionMenu.new(
                    select_variant: :single,
                    anchor_align: :end,
                    dynamic_label: true,
                    data: {
                      action: "click:copilot-user-settings#updateBillableCustomer",
                      target: "copilot-user-settings.billableCustomerMenu",
                    }) do |menu| %>
                    <% menu.with_show_button do |button|
                      button.with_trailing_action_icon(icon: :"triangle-down")
                      billable_customer_button_text
                    end %>
                    <% copilot_customers.each do |customer| %>
                      <% menu.with_item(
                          label: customer[:name],
                          data: { value: customer[:id] },
                          active: @copilot_user.billable_customer_id == customer[:id],
                      ) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if show_usage_for_copilot_seat? %>
      <%= render(Copilot::AicSeatUsageComponent.new(copilot_user: @copilot_user)) %>
    <% end %>
    <%# ============== END OF BILLING POLICIES SECTION ============== %>

    <%# =================== START OF USAGE SECTION ====================== %>

    <% if limited_access_user? && @copilot_user.use_token_based_billing? %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
        <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Usage" } %>
      <% end %>
      <%= render(Copilot::AicFreeUsageSummaryComponent.new(@copilot_user)) %>
    <% elsif limited_access_user? && !@copilot_user.use_token_based_billing? %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
        <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Usage" } %>
      <% end %>
      <%= render(Primer::Beta::BorderBox.new( classes: "tmp-mb-3")) do |component| %>
        <%= component.with_row do %>
          <% if show_new_quota_ui? %>
            <%= render(::Copilot::Policies::Quota::UsageComponent.new(
              completions_percentage_used: completions_quota_used,
              chat_percentage_used: chat_quota_used,
              any_quotas_exhausted: any_quota_exhausted?,
            )) %>
          <% else %>
            <%= render(Primer::Box.new(test_selector: "copilot-usage-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
                <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                  <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                    You are using Copilot for free
                  <% end %>
                <% end %>
                <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, color: :muted, test_selector: "copilot-usage-policy-label", col: 10, classes: "tmp-mr-6")) do %>
                  Responses are limited to 2,000 code completions and 50 chat messages per month.
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <%= component.with_footer(py: new_ui_any_quota_exhausted? ? 3 : 2, **usage_footer_args) do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Box.new(display: :inline_flex, direction: :row, align_items: :center)) do %>
                  <% if new_ui_any_quota_exhausted? %>
                    <%= render(Primer::Beta::Octicon.new(icon: :info, size: :small, color: :attention, mx: 2, aria_hidden: true)) %>
                  <% end %>
                  <%= render(Primer::Beta::Text.new(test_selector: "copilot-usage-reset-indicator", tag: :span, color: new_ui_any_quota_exhausted? ? :default : :muted)) do %>
                      <% if new_ui_any_quota_exhausted? %>You've reached your free plan limit.<% end %>
                      <% unless @copilot_user.cfi_paid_plan_upgrade_restricted? %>
                        Upgrade for higher limits, premium models, AI reviews.
                      <% end %>
                    <% if limited_user_reset_date %>
                      <% if new_ui_any_quota_exhausted? %><br><% end %>
                      Free responses reset in <%= pluralize((limited_user_reset_date - Date.current).to_i, 'day') %>.
                    <% end %>
                    <% if @copilot_user.cfi_paid_plan_upgrade_restricted? %>
                      Plan upgrades are temporarily unavailable. <a class="Link--inTextBlock" href="https://github.blog/news-insights/company-news/changes-to-github-copilot-individual-plans/">Read more</a>.<%# erblint:disable GitHub::Accessibility::AvoidGenericLinkText %>
                    <% end %>
                  <% end %>
                <% end %>
                <% unless @copilot_user.cfi_paid_plan_upgrade_restricted? %>
                  <%= render Primer::Beta::Button.new(
                    tag: :a,
                    ml: 2,
                    scheme: new_ui_any_quota_exhausted? ? :primary : :default,
                    href: copilot_pro_signup_path,
                    data: analytics_click_attributes(
                      category: "user_copilot_settings",
                      action: "upgrade_clicked",
                      label: new_ui_any_quota_exhausted? ? "ref_cta:quota_exhausted_upgrade_button" : "ref_cta:quota_not_exhausted_upgrade_button"
                    )
                  ).with_content("Upgrade") %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%# ==================== END OF USAGE SECTION ======================= %>

    <%# ============== START OF FEATURES POLICIES SECTION ============== %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
      <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Features" } %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>

      <% if show_custom_instructions_options? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(id: "copilot-chat-default-custom-instructions", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, test_selector: :copilot_chat_default_custom_instructions)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                  <%= Copilot::COPILOT_DEFAULT_CUSTOM_INSTRUCTIONS %>
                <% end %>
                  <%= render(Primer::Alpha::SelectPanel.new(
                    fetch_strategy: :local,
                    title: "Select an organization",
                    form_arguments: { builder: f, name: "default_org_custom_instructions" },
                    data: {
                      action: "click:copilot-user-settings#updateDefaultOrgCustomInstructions",
                      target: "copilot-user-settings.defaultOrgCustomInstructions"
                    }
                    )) do |panel| %>
                    <% panel.with_show_button(
                      "data-test-selector": "default-custom-instructions",
                      "aria-label": "Default custom instructions #{default_custom_instructions_org.display_login}") do |button| %>
                      <% button.with_trailing_action_icon(icon: :"triangle-down") %>

                      <div class="d-flex flex-justify-end flex-items-center">
                        <%= render(GitHub::AvatarComponent.new(actor: default_custom_instructions_org, mr: 2)) %>
                        <%= default_custom_instructions_org.display_login %>
                      </div>
                    <% end %>

                    <% authorized_orgs_with_custom_instructions.each do |org| %>
                      <% panel.with_avatar_item(
                        username: org.display_login,
                        src: helpers.avatar_url_for(org),
                        avatar_arguments: { shape: :square },
                        description_scheme: :inline,
                        test_selector: "default-custom-instructions-option",
                        active: default_custom_instructions_org&.id == org.id,
                        content_arguments: { data: {
                          value: org.id,
                          login: org.display_login,
                          avatar: helpers.avatar_url_for(org)
                        }},
                      ) do |item| %>
                        <% item.with_description.with_content(org.display_login) %>
                      <% end %>
                    <% end %>
                  <% end %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, color: :muted, id: "copilot_default_custom_instructions_label", col: 10, classes: "tmp-mr-6")) do %>
                You belong to multiple organizations with Copilot access. Set a default instruction for general chat.
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if !limited_access_user? && @copilot_user.feature_flag_enabled?(:copilot_next_edit_suggestions, default: false) %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::EditorPreviewFeatures,
            copilot_user: @copilot_user,
            setting_changed: false,
            readonly: true,
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                You can use preview features in your editor. <%= inline_docs_link(Copilot::Policies::EditorPreviewFeatures.documentation_url, "Learn more.") %>
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if !limited_access_user? && !@copilot_user.has_cfi_access? && @copilot_user.feature_flag_enabled?(:copilot_agent_mode_show_policy, default: false) %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::AgentMode,
            copilot_user: @copilot_user,
            setting_changed: false,
            readonly: true,
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                You can use <%= render(Primer::Beta::Link.new(href: Copilot::Policies::AgentMode.documentation_url, classes: "Link--inTextBlock")) { Copilot::Policies::AgentMode.display_name } %>
                to interact with Copilot for the purpose of reasoning through requests, planning tasks, and making changes to the codebase.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if !limited_access_user? && !@copilot_user.has_cfi_access? && Copilot::Policies::AgentModeAutoApprove.available_for?(@copilot_user) %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::AgentModeAutoApprove,
            copilot_user: @copilot_user,
            setting_changed: false,
            readonly: true,
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                If enabled, you can use <%= Copilot::Policies::AgentModeAutoApprove.display_name %> (currently supported by JetBrains plugin only).
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if Copilot::Policies::BlackbirdExternalIndexing.available_for?(@copilot_user) %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::BlackbirdExternalIndexing,
            copilot_user: @copilot_user,
            setting_changed: false,
            readonly: copilot_access_through_org_or_business?,
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                If enabled you can use <%= render(Primer::Beta::Link.new(href: Copilot::Policies::BlackbirdExternalIndexing.documentation_url, classes: "Link--inTextBlock")) { Copilot::Policies::BlackbirdExternalIndexing.display_name } %> to index your non-GitHub repositories in VSCode.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= component.with_row do %>
        <%= render ::Copilot::Policies::UserFormComponent.new(
          policy_class: Copilot::Policies::DotcomChat,
          copilot_user: @copilot_user,
          setting_changed: false,
          readonly: true,
          all_policies: all_policies,
          has_single_seat: has_single_seat?
          ) do |component| %>
            <%= component.with_description do %>
              <%= subtext %>
            <% end %>
        <% end %>
      <% end %>

      <%= component.with_row do %>
        <%= render ::Copilot::Policies::UserFormComponent.new(
          policy_class: Copilot::Policies::Cli,
          copilot_user: @copilot_user,
          setting_changed: false,
          readonly: true,
          all_policies: all_policies,
          has_single_seat: has_single_seat?
          ) do |component| %>
            <%= component.with_description do %>
              You can use <%= inline_docs_link(Copilot::Policies::Cli.documentation_url, "GitHub Copilot for assistance in terminal") %>.
            <% end %>
        <% end %>
      <% end %>

      <% if Copilot::Policies::Desktop.available_for?(@copilot_user) %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::Desktop,
            copilot_user: @copilot_user,
            setting_changed: changed?(Copilot::Policies::Desktop.instrumentation_key),
            readonly: is_readonly_mode? || !Copilot::Policies::Desktop.editable_by_user?(@copilot_user),
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                You can use <%= inline_docs_link(Copilot::Policies::Desktop.documentation_url, "GitHub Copilot for assistance in GitHub Desktop") %>.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% unless limited_access_user? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::EditorChat,
            copilot_user: @copilot_user,
            setting_changed: false,
            readonly: true,
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                You can use <%= inline_docs_link(Copilot::Policies::EditorChat.documentation_url, "GitHub Copilot Chat in the IDE") %> to explain a piece of code, propose bug fixes, or generate unit tests in a chat interface from your editor.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% unless limited_access_user? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::MobileChat,
            copilot_user: @copilot_user,
            setting_changed: false,
            readonly: true,
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                You can use <%= inline_docs_link(Copilot::Policies::MobileChat.documentation_url, "Copilot Chat in GitHub Mobile") %> personalized to a codebase.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= component.with_row do %>
        <%= render ::Copilot::Policies::UserFormComponent.new(
          policy_class: Copilot::Policies::Bing,
          copilot_user: @copilot_user,
          setting_changed: changed?(Copilot::Policies::Bing.instrumentation_key),
          readonly: is_readonly_mode?,
          all_policies: all_policies,
          has_single_seat: has_single_seat?
          ) do |component| %>
            <%= component.with_description do %>
              Copilot can answer questions about new trends and give improved answers, via Bing. See
              <%= inline_docs_link(Copilot::Policies::Bing.documentation_url, "Microsoft Privacy Statement") %>
            <% end %>
        <% end %>
      <% end %>

      <% if Copilot::Policies::ModelNativeSearch.available_for?(@copilot_user) %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::ModelNativeSearch,
            copilot_user: @copilot_user,
            setting_changed: changed?(Copilot::Policies::ModelNativeSearch.instrumentation_key),
            readonly: is_readonly_mode?,
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                <%= helpers.render_policy_description(Copilot::Policies::ModelNativeSearch.user_setting_description(@copilot_user)) %>
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if Copilot::Policies::ExperimentalAutoModels.available_for?(@copilot_user) %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::ExperimentalAutoModels,
            copilot_user: @copilot_user,
            setting_changed: changed?(Copilot::Policies::ExperimentalAutoModels.instrumentation_key),
            readonly: is_readonly_mode?,
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                <%= helpers.render_policy_description(Copilot::Policies::ExperimentalAutoModels.user_setting_description(@copilot_user)) %>
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if has_individual_access? && !render_code_review_policy? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserFormComponent.new(
            policy_class: Copilot::Policies::AutomaticCodeReview,
            copilot_user: @copilot_user,
            setting_changed: changed?(Copilot::Policies::AutomaticCodeReview.instrumentation_key),
            readonly: is_readonly_mode?,
            all_policies: all_policies,
            has_single_seat: has_single_seat?
            ) do |component| %>
              <%= component.with_description do %>
                Copilot will automatically review your pull requests.
                <%= inline_docs_link(Copilot::Policies::AutomaticCodeReview.documentation_url, "Learn more about configuring automatic code reviews.") %>
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if render_model_policies? %>
        <% if copilot_access_through_org_or_business? || Copilot::Policies::Models::Afos.available_for?(@copilot_user) %>
          <%= component.with_row do %>
            <%= render ::Copilot::Policies::UserFormComponent.new(
              policy_class: Copilot::Policies::Models::Afos,
              copilot_user: @copilot_user,
              setting_changed: changed?(Copilot::Policies::Models::Afos.instrumentation_key),
              readonly: is_readonly_mode?,
              all_policies: all_policies,
              has_single_seat: has_single_seat?
              ) do |component| %>
                <%= component.with_description do %>
                  You can use the latest <%= Copilot::Policies::Models::Afos.display_name %> model.
                  <%= inline_docs_link(Copilot::Policies::Models::Afos.documentation_url, "Learn more about how GitHub Copilot serves #{Copilot::Policies::Models::Afos.display_name}.") %>
                <% end %>
            <% end %>
          <% end %>
        <% end %>

        <% if Copilot::Policies::Models::Daisy.available_for?(@copilot_user) %>
          <%= component.with_row do %>
            <%= render ::Copilot::Policies::UserFormComponent.new(
              policy_class: Copilot::Policies::Models::Daisy,
              copilot_user: @copilot_user,
              setting_changed: changed?(Copilot::Policies::Models::Daisy.instrumentation_key),
              readonly: is_readonly_mode?,
              all_policies: all_policies,
              has_single_seat: has_single_seat?
              ) do |component| %>
                <%= component.with_description do %>
                  You can use the latest <%= Copilot::Policies::Models::Daisy.display_name %> model.
                  <%= inline_docs_link(Copilot::Policies::Models::Daisy.documentation_url, "Learn more about how GitHub Copilot serves #{Copilot::Policies::Models::Daisy.display_name}.") %>
                <% end %>
            <% end %>
          <% end %>
        <% end %>

        <% if Copilot::Policies::Models::Bento.available_for?(@copilot_user) %>
          <%= component.with_row do %>
            <%= render ::Copilot::Policies::UserFormComponent.new(
              policy_class: Copilot::Policies::Models::Bento,
              copilot_user: @copilot_user,
              setting_changed: changed?(Copilot::Policies::Models::Bento.instrumentation_key),
              readonly: bento_readonly?,
              all_policies: all_policies,
              has_single_seat: has_single_seat?
              ) do |component| %>
                <%= component.with_description do %>
                  You can use the latest <%= Copilot::Policies::Models::Bento.display_name %> model.
                  <%= inline_docs_link(Copilot::Policies::Models::Bento.documentation_url, "Learn more about how GitHub Copilot serves #{Copilot::Policies::Models::Bento.display_name}.") %>
                <% end %>
            <% end %>
          <% end %>
        <% end %>

        <% if Copilot::Policies::Models::Aofo.available_for?(@copilot_user) %>
          <%= component.with_row do %>
