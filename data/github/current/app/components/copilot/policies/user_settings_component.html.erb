            <% end %>
        <% end %>
      <% end %>

      <% if render_code_review_policy? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            copilot_user: @copilot_user,
            value: @copilot_user.code_review_enabled? ? 'enabled' : 'disabled',
            policy_name: "code_review",
            display_name: Copilot::COPILOT_CODE_REVIEW,
            enablement_text: render_read_only_enablement_text("code_review", @copilot_user.code_review_enabled?, true),
            setting_changed: changed?(:code_review_setting),
            menu_items: [],
            policy_blocked_by: (@copilot_user.code_review_disabled? && @copilot_user.has_cfe_access?) ? policy_blocked_by(:code_review) : "",
            preview: false,
            ) do |component| %>
              <%= component.with_description do %>
                Use Copilot to <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_CODE_REVIEW_DOCUMENTATION, classes: "Link--inTextBlock")) { "review your code" } %> and generate <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_FOR_PRS_DOCUMENTATION, classes: "Link--inTextBlock")) { "pull request summaries" } %>.
              <% end %>
          <% end %>
          <% if has_individual_access? %>
            <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
              value: @copilot_user.automatic_code_review,
              copilot_user: @copilot_user,
              policy_name: "automatic_code_review",
              display_name: "Automatically request #{Copilot::COPILOT_CODE_REVIEW}",
              enablement_text: render_read_only_enablement_text("automatic_code_review", @copilot_user.automatic_code_review_enabled?),
              setting_changed: changed?(:automatic_code_review_setting),
              policy_blocked_by: (!has_single_seat? && @copilot_user.automatic_code_review_disabled? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:automatic_code_review) : "",
              sub_setting: true,
              ) do |component| %>
                <%= component.with_description do %>
                  Use Copilot to automatically review all the pull requests you've created.
                <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if render_swe_agent_policies? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            copilot_user: @copilot_user,
            value: @copilot_user.swe_agent,
            policy_name: "swe_agent",
            display_name: Copilot::COPILOT_SWE_AGENT,
            enablement_text: render_read_only_enablement_text("swe_agent", @copilot_user.swe_agent_enabled?, true),
            setting_changed: changed?(:swe_agent_setting),
            menu_items: [],
            policy_blocked_by: (@copilot_user.swe_agent_disabled? && @copilot_user.has_cfe_access?) ? policy_blocked_by(:swe_agent) : "",
            preview: true,
            ) do |component| %>
              <%= component.with_description do %>
                Delegate tasks to <%= Copilot::COPILOT_SWE_AGENT %> in repositories where it is enabled
                <%= render(Primer::Beta::Link.new(href: "https://gh.io/assigncopilot", classes: "Link--inTextBlock")) { "Learn more" } %>.
              <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if render_mcp_policy? %>
        <%= component.with_row do %>
          <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
            copilot_user: @copilot_user,
            value: @copilot_user.mcp,
            policy_name: "mcp",
            display_name: Copilot::COPILOT_MCP_SERVERS,
            enablement_text: render_read_only_enablement_text("mcp", @copilot_user.mcp_enabled?, true),
            setting_changed: changed?(:mcp_setting),
            menu_items: [],
            policy_blocked_by: (@copilot_user.mcp_disabled? && @copilot_user.has_cfe_access?) ? policy_blocked_by(:mcp) : "",
            preview: false,
            ) do |component| %>
              <%= component.with_description do %>
                Connect MCP servers to Copilot in
                <% if @copilot_user.feature_flag_enabled?(:mcp_clients_ga_release, default: false) %>
                  <% if @copilot_user.has_copilot_standalone_business? %>
                  all Copilot editors.
                  <% else %>
                  all Copilot editors and Coding Agent. Note that Coding Agent is in public preview.
                  <% end %>
                <% else %>
                  Visual Studio Code and Coding Agent. MCP support is GA in VS Code, while Coding Agent is in public preview.
                <% end %>
                <% if @copilot_user.has_copilot_standalone_business? %>
                  See MCP docs for <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/copilot/customizing-copilot/extending-copilot-chat-with-mcp", classes: "Link--inTextBlock")) { "Copilot Chat" } %>.
                <% else %>
                  See MCP docs for <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/copilot/customizing-copilot/extending-copilot-chat-with-mcp", classes: "Link--inTextBlock")) { "Copilot Chat" } %> and <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/copilot/customizing-copilot/extending-copilot-coding-agent-with-mcp", classes: "Link--inTextBlock")) { "Coding Agent" } %>.
                <% end %>
              <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%# ============== END OF FEATURES POLICIES SECTION ============== %>

    <%# ============== START OF PRIVACY POLICIES SECTION ============== %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
      <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Privacy" } %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(padding: :default, mb: 3)) do |component| %>
      <%= component.with_row do %>
        <%= render ::Copilot::Policies::UserSettingsRowComponent.new(
          copilot_user: @copilot_user,
          value: public_code_suggestions_value,
          policy_name: "public_code_suggestions",
          display_name: Copilot::COPILOT_PUBLIC_CODE_SUGGESTIONS_UI,
          enablement_text: render_read_only_enablement_text("public_code_suggestions", @copilot_user.block_public_code_suggestions?, enabled_text: "Blocked", disabled_text: "Allowed"),
          setting_changed: changed?(:snippy_setting),
          menu_items: Copilot::Policies::Menus::ALLOW_OR_BLOCK,
          policy_blocked_by: (!has_single_seat? && @copilot_user.block_public_code_suggestions? && !@copilot_user.has_cfi_access?) ? policy_blocked_by(:public_code_suggestions) : "",
          ) do |component| %>
            <%= component.with_description do %>
              <% if @copilot_user.is_enterprise_managed? || @copilot_user.has_cfb_access? || @copilot_user.has_copilot_standalone_business? %>
                GitHub Copilot can provide you with details about matching code when you accept such suggestions. <%= inline_docs_link(Copilot::COPILOT_PUBLIC_CODE_SUGGESTIONS_DOCS, "Learn more") %>.
              <% else %>
                Copilot can allow or block suggestions matching public code. Learn more about
                <%= render(Primer::Beta::Link.new(href: helpers.docs_url("copilot/configure-organization-matching-policies"), classes: "Link--inTextBlock")) { "code suggestions" } %>.
              <% end %>
            <% end %>
        <% end %>
      <% end %>

      <% unless is_readonly_mode? %>
        <% component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
            <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
              <%= render(Primer::Box.new(display: :flex, direction: :row)) do %>
                <%= render(Primer::Beta::Text.new(tag: :p, font_weight: :bold, mb: 1)) do %>
                  <input
                    type="checkbox"
                    id="copilot_settings_telemetry"
                    name="telemetry"
                    value="Allow"
                    class="mr-1" <%= @copilot_user&.telemetry_enabled? ? "checked" : "" %>
                    data-action="click:copilot-user-settings#handleSubmit"
                    data-target="copilot-user-settings.telemetry"
                    aria-label="Allow GitHub to use my code snippets from the code editor for product improvements"
                    disabled
                  >
                  <label for="telemetry">
                    Allow GitHub to use my data for product improvements
                  </label>
                <% end %>
                <% if changed?(:telemetry_configuration) %>
                  <%= render Primer::Box.new(display: :flex, direction: :column, ml: 1, classes: 'hx_anim-fade-out') do %>
                    <%= render Primer::Beta::Octicon.new(icon: "check", size: :small, mr: 2, color: :success) %>
                  <% end %>
                <% end %>
              <% end %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, color: :muted)) do %>
                Allow GitHub, its affiliates and third parties to use my data, including Prompts, Suggestions, and Code Snippets, for product improvements. More information in the
                <%= render(Primer::Beta::Link.new(href: helpers.docs_url("copilot/about-github-copilot-individual-privacy"), classes: "Link--inTextBlock")) do %>
                  Privacy Statement
                <% end %>.
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% unless is_readonly_mode? %>
        <% component.with_row do %>
          <% if @copilot_user.has_cfi_access? %>
            <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
                <%= render(Primer::Box.new(display: :flex, direction: :row, justify_content: :space_between)) do %>
                  <%= render(Primer::Box.new(display: :flex, direction: :row)) do %>
                    <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
                      Allow GitHub to use my data for AI model training
                    <% end %>
                  <% end %>
                  <%= render(Primer::Box.new(display: :flex, direction: :row)) do %>
                    Disabled
                  <% end %>
                <% end %>

                <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, color: :muted)) do %>
                  Allow GitHub, its affiliates and third parties to use my data, including Prompts, Suggestions, and Code Snippets, for AI model training. More information in the
                  <%= render(Primer::Beta::Link.new(href: helpers.docs_url("copilot/about-github-copilot-individual-privacy"), classes: "Link--inTextBlock")) do %>
                    Privacy Statement
                  <% end %>.
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%# ============== END OF PRIVACY POLICIES SECTION ============== %>

    <%= render(Primer::Beta::Text.new(tag: :p, mt: 1, color: :muted, font_size: :small)) do %>
      <% unless features_for_data_retention.empty? %>
        <%= features_for_data_retention %> and updated <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_SPECIFIC_TERMS, classes: "Link--inTextBlock")) { "Product Terms" } %> apply.
      <% end %>
      For more information about the data your organization receives regarding your use of GitHub Copilot, please review <%= render(Primer::Beta::Link.new(href: Copilot::github_general_privacy_statement_url, classes: "Link--inTextBlock")) { "GitHub's Privacy Statement" } %>.
    <% end %>

    <% if onboarding? %>
      <%= render(Primer::Beta::Button.new(
        scheme: :primary,
        size: :medium,
        type: :submit,
        disabled: true,
        id: "copilot_settings_submit",
        data: {
          target: "copilot-user-settings.submit"
        }
      )) do %>
        Save and complete setup
      <% end %>
    <% end %>
  <% end %>
</copilot-user-settings>
