<%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, test_selector: "copilot-byok")) do %>
  <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
    <h3 class="mb-2">
      Enable custom models
      <%= render Primer::Beta::Label.new(scheme: :success, classes: "ml-2").with_content("Preview") %>
    </h3>
    <div class="d-flex flex-justify-between flex-items-start flex-md-items-center flex-column flex-md-row">
      <p class="col-10 color-fg-muted tmp-mb-3 tmp-mb-md-0" <%= test_selector("custom-models-summary") %>>
        Enable to allow your organizations to configure and use custom models via API key. When using custom models, GitHub is allowed to share your data with third-party services, including Azure and OpenAI, using your provided key.
      </p>
      <div>
        <% if !can_write %>
          <%= render Primer::Beta::Button.new(tag: :summary, disabled: true) do %>
            <span data-menu-button><%= enabled? ? "Enabled" : "Disabled" %></span>
          <% end %>
        <% else %>
          <%= render(Primer::Alpha::ActionMenu.new(
            select_variant: :single,
            dynamic_label: true,
            overlay_arguments: { size: :small }
          )) do |menu| %>
            <% menu.with_show_button do |button| %>
              <% button.with_trailing_action_icon(icon: :"triangle-down") %>
              <%= enabled? ? "Enabled" : "Disabled" %>
            <% end %>
            <% menu.with_item(
              label: "Enabled",
              active: enabled?,
              href: submit_path,
              form_arguments: {
                method: :put,
                inputs: [{
                  name: "enable_copilot_custom_models",
                  value: "enable"
                }, {
                  name: "return_to",
                  value: return_to
                }]
              }
            ) %>
            <% menu.with_item(
              label: "Disabled",
              active: !enabled?,
              href: submit_path,
              form_arguments: {
                method: :put,
                inputs: [{
                  name: "enable_copilot_custom_models",
                  value: "disable"
                }, {
                  name: "return_to",
                  value: return_to
                }]
              }
            ) %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
