<%= render(Primer::Box.new(
  display: :flex,
  justify_content: :space_between,
  flex: 1,
  direction: [:column, nil, :row],
  align_items: [:flex_start, nil, :center],
  classes: "border-top tmp-mt-3 tmp-pt-3 tmp-pl-3",
  test_selector: "copilot-memory-exports",
)) do %>
  <%= render(Primer::Box.new(
    display: :inline_flex,
    justify_content: :space_between,
    flex: 1,
    direction: :column,
    classes: "tmp-mb-3 tmp-mb-md-0",
  )) do %>
    <%= render(Primer::Beta::Text.new(tag: :span, classes: "tmp-mb-1", font_weight: :bold)) do %>
      Download user memories
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, classes: "tmp-mb-0 tmp-mr-3")) do %>
      Download user-scoped Copilot memories for all users with Copilot seats billed to <%= entity_name %>.
    <% end %>
  <% end %>

  <%= render(Primer::Alpha::Dialog.new(
    title: "Download user memories?",
    id: dialog_id,
    position: :center,
    size: :medium_portrait,
  )) do |dialog| %>
    <% dialog.with_show_button(
      test_selector: "copilot-memory-exports-request-button",
      aria: { label: "Download user memories" },
    ) do %>
      Download
    <% end %>

    <% dialog.with_header(show_divider: true) do %>
      <strong>Download user memories?</strong>
    <% end %>

    <% dialog.with_body do %>
      <%= render(Primer::Beta::Text.new(tag: :p, classes: "tmp-mb-3")) do %>
        This will download user-scoped Copilot memories for all users with Copilot seats billed to <%= entity_name %>.
      <% end %>
      <%= render(Primer::Beta::Text.new(tag: :p, classes: "tmp-mb-0")) do %>
        <%= confirmation_text %>
      <% end %>
    <% end %>

    <% dialog.with_footer(show_divider: true) do %>
      <%= render(Primer::Beta::Button.new(data: { close_dialog_id: dialog_id })) do %>
        Cancel
      <% end %>

      <%= render(Primer::Beta::Button.new(
        type: :button,
        scheme: :danger,
        data: { close_dialog_id: dialog_id },
        test_selector: "copilot-memory-exports-confirm-button",
      )) do %>
        Download memories
      <% end %>
    <% end %>
  <% end %>
<% end %>
