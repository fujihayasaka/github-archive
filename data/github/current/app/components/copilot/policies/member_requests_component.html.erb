<%= render(Primer::Box.new(display: :flex, align_items: :center, mb: 2, mt: 2)) do %>
  <% if requesting_users.any? %>
    <%= render(Primer::Beta::AvatarStack.new(disable_expand: true, style: "pointer-events: none")) do |stack| %>
      <% requesting_users.take(5).each do |user| %>
        <% stack.with_avatar(
          src: helpers.avatar_url_for(user, 20),
          alt: user.name,
          size: 20,
          square: false
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::Text.new(tag: :span, color: :muted, font_size: :small)) do %>
    <%= formatted_count_text %>
  <% end %>

  <% if show_enterprise_member_requests_link? %>
    <%= render(Primer::Beta::Link.new(
      href: enterprise_member_requests_path,
      font_size: :small,
      ml: 2,
      test_selector: "view-all-member-requests-link"
    )) { "View all requests" } %>
  <% end %>
<% end %>
