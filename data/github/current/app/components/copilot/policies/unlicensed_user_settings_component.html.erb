<copilot-user-settings
  data-onboarding="false"
  data-enabled="true"
  data-dashboard-entry-point-path="<%= copilot_dashboard_entry_point_enabled_path %>"
  <%= test_selector("unlicensed-user-settings") %>
>
  <%= form_with(
    url: @submit_path,
    method: "put",
    data: {
      target: "copilot-user-settings.form",
    }
  ) do |f| %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
      <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Privacy" } %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
      <%= component.with_row do %>
        <%= render ::Copilot::Policies::TelemetrySettingsRowComponent.new(
          copilot_user: @copilot_user,
          setting_changed: changed?(:telemetry_configuration),
        ) %>
      <% end %>
    <% end %>

    <%= render(Primer::Beta::Text.new(tag: :p, mt: 1, color: :muted, font_size: :small, classes: "tmp-mb-6")) do %>
      For more information about the data GitHub receives regarding your use of GitHub Copilot, please review <%= render(Primer::Beta::Link.new(href: Copilot::github_general_privacy_statement_url, classes: "Link--inTextBlock")) { "GitHub's Privacy Statement" } %>.
    <% end %>
  <% end %>
</copilot-user-settings>
