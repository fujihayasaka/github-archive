<%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row, test_selector: "copilot-a-chat")) do %>
  <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
    <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
      Anthropic Claude 3.5 Sonnet in Copilot
      <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2)) { "Preview" } %>
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 3, color: :muted)) do %>
      If enabled, organizations can access the latest Claude 3.5 Sonnet model. Learn more about
      <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_A_CHAT_DOCS, classes: "Link--inTextBlock")) { "how GitHub Copilot serves Claude 3.5 Sonnet" } %>.
    <% end %>
  <% end %>

  <% form_fields = capture do %>
    <input type="hidden" name="tab" value="models">
    <%= render GitHub::MenuComponent.new(items: menu_items, input_id: @input_id, align: :right) do |menu| %><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
      <% menu.with_summary do %>
        <%= render Primer::Beta::Button.new(tag: :summary) do |component| %>
          <% component.with_trailing_action_icon(icon: "triangle-down") %>
          <span data-menu-button><%= menu.default_selection_text || "Select a policy"%></span>
        <% end %>
      <% end %>
    <% end%>
  <% end %>

  <%= form_with url: submit_path, class: "d-inline", method: :put do %>
    <%= form_fields %>
  <% end %>
<% end %>
