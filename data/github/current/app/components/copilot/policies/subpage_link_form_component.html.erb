<%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row, test_selector: "copilot-subpage-box-#{id}")) do %>
  <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
    <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
      <% @title %>
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 3, color: :muted)) do %>
      <% @description %>
    <% end %>
  <% end %>

  <%= render Primer::Beta::IconButton.new(
    scheme: :invisible,
    icon: "chevron-right",
    size: :medium,
    tag: :a,
    align: :right,
    id: id,
    test_selector: "copilot-subpage-link-#{id}",
    "aria-label": "Go to #{@title} settings",
    href: @path) %>

<% end %>
