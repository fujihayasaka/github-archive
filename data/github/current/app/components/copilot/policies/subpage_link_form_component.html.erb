<% content = capture do %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row, mt: -1, mb: -1, test_selector: "copilot-subpage-box-#{id}")) do %>
    <%= render(Primer::Box.new(display: :flex, align_items: :center, flex: 1, direction: :row)) do %>
      <% if @icon %>
        <%= render(Primer::Box.new(display: :flex, align_items: :center, border: true, border_radius: 2, p: 2, color: :muted, classes: "tmp-mr-3")) do %>
          <%= render(Primer::Beta::Octicon.new(
            icon: @icon,
            size: :small,
          )) %>
        <% end %>
      <% end %>
      <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
        <% if @can_read %>
          <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
            <%= @title %>
          <% end %>
        <% else %>
          <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold, color: :muted)) do %>
            <%= @title %>
          <% end %>
        <% end %>
        <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, color: :muted, classes: "tmp-mr-3")) do %>
          <%= @description %>
        <% end %>
      <% end %>
    <% end %>

    <% if @can_write %>
      <%= render Primer::Beta::Octicon.new(
        icon: "chevron-right",
        size: :small,
        align: :right,
        id: id,
        test_selector: "copilot-subpage-chevron-#{id}") %>
    <% end %>
  <% end %>
<% end %>

<% if @can_read %>
  <%= render(Primer::Beta::Link.new(href: @path, scheme: :primary, underline: false)) do %>
    <%= content %>
  <% end %>
<% else %>
  <%= content %>
<% end %>
