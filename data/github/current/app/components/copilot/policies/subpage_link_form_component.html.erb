<%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row, mt: -1, mb: -1, test_selector: "copilot-subpage-box-#{id}")) do %>
  <%= render(Primer::Box.new(display: :flex, align_items: :center, flex: 1, direction: :row)) do %>
    <% if @icon %>
      <%= render(Primer::Box.new(display: :flex, align_items: :center, mr: 3)) do %>
        <% if @can_read %>
          <%= render(Primer::Beta::IconButton.new(
            scheme: :default,
            icon: @icon,
            size: :medium,
            tag: :a,
            href: @path,
            "aria-label": "Go to #{@title} settings")) %>
        <% else %>
          <%= render(Primer::Beta::IconButton.new(
            scheme: :default,
            icon: @icon,
            size: :medium,
            disabled: true,
            "aria-label": "Go to #{@title} settings")) %>
        <% end %>
      <% end %>
    <% end %>
    <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
      <% if @can_read %>
        <%= render(Primer::Beta::Text.new(tag: :a, href: @path, mb: 1, font_weight: :bold, classes: "Link--primary")) do %>
          <%= @title %>
        <% end %>
      <% else %>
        <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold, color: :muted)) do %>
          <%= @title %>
        <% end %>
      <% end %>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 3, color: :muted)) do %>
        <%= @description %>
      <% end %>
    <% end %>
  <% end %>

  <% if @can_write %>
    <%= render Primer::Beta::IconButton.new(
      scheme: :invisible,
      icon: "chevron-right",
      size: :medium,
      tag: :a,
      href: @path,
      align: :right,
      id: id,
      test_selector: "copilot-subpage-chevron-#{id}",
      "aria-label": "#{@title} settings") %>
  <% end %>

<% end %>
