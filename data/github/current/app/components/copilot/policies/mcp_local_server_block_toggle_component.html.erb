<%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row, test_selector: "copilot-mcp-local-server-block-toggle")) do %>
  <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
    <%= render(Primer::Beta::Text.new(tag: :span, classes: "tmp-mb-1", font_weight: :bold)) do %>
      <%= @display_name %>
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, classes: "tmp-mb-1 tmp-mr-3")) do %>
      <%= description %>
    <% end %>
  <% end %>

  <%#
    TODO: When backend is ready, configure csrf_token and src for the toggle:
    - csrf_token: form_authenticity_token
    - src: endpoint URL for toggling local server block setting
  %>
  <%= render(
    Primer::Alpha::ToggleSwitch.new(
      csrf_token: "",
      src: "",
      checked: false,
      enabled: can_write,
      aria: { label: @display_name },
    )
  ) %>
<% end %>
