<copilot-business-settings-toggle>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
    <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
      <label for="<%= policy_id %>">
        <%= display_name %>
      </label>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 3, color: :muted)) do %>
        <%= description %>
      <% end %>
    <% end %>
    <%= form_with url: submit_path, class: "d-inline", method: :put, data: { target: "copilot-business-settings-toggle.settingForm" } do %>
      <input type="hidden" name="tab" value="<%= tab %>">
      <input type="hidden" value="disabled" name="<%= policy_id %>" data-target="copilot-business-settings-toggle.settingInput">
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 1, font_weight: :bold)) do %>
        <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
          <%= render(
            Primer::Alpha::ToggleSwitch.new(
              size: :small,
              status_label_position: :start,
              csrf_token: "",
              id: policy_id,
              checked: checked?,
              aria: { label: display_name },
              data: {
                action: "click:copilot-business-settings-toggle#toggleSetting",
                target: "copilot-business-settings-toggle.settingCheckbox",
                checked: checked?
              }
            )
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</copilot-business-settings-toggle>
