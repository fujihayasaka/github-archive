<%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row, test_selector: "copilot-model-#{@model.model_key}")) do %>
  <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
    <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
      <%= @model.name %>
      <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2)) { "Preview" }  if @model.preview %>
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :p, mb: 1, color: :muted, classes: "tmp-mr-3")) do %>
      If enabled, organizations can access the latest <%= @model.name %> model in Copilot.
      <% if @model.documentation_link.present? && @model.documentation_link_text.present? %>
        <%= render(Primer::Beta::Link.new(href: @model.documentation_link, classes: "Link--inTextBlock")) { @model.documentation_link_text }  %>
      <% end %>
    <% end %>
  <% end %>

  <% if @disabled || !accessible? %>
    <%= render Primer::Beta::Button.new(tag: :summary, disabled: true) do %>
      <span data-menu-button><%= current_label %></span>
    <% end %>
  <% elsif accessible? %>
    <%= render Primer::Alpha::ActionMenu.new(
        select_variant: :single,
        anchor_align: :end,
        show_dividers: true,
        dynamic_label: true,
        anchor_side: :outside_bottom,
        size: :auto, # needed so the menu won't scroll vertically
        overlay_arguments: {
          style: "width:min(320px, 100vw - 2rem)"
        }, # used to set the width of the menu to the same as size: small
      ) do |menu|
      menu.with_show_button do |button|
        button.with_trailing_action_icon(icon: :"triangle-down")
        "Select a policy"
      end

      menu_items.each do |menu_item|
        menu.with_item(
          label: menu_item.label,
          href: submit_path,
          form_arguments: {
            method: :put,
            inputs: [{
              name: "model_registry_policy[#{@model.model_key}]",
              value: menu_item.value
            }, {
              name: "tab",
              value: "models",
            }],
          },
          active: menu_item.checked?,
        ) do |item|
          item.with_description.with_content(menu_item.description)
        end
        menu.with_divider unless menu_item.label == menu_items.last.label
      end
    end %>
  <% end %>

<% end %>
