<copilot-business-settings>
  <% if render_shareable_component? %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, test_selector: policy_id.dasherize)) do %>
      <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
        <label for="<%= policy_id %>">
          Opt in for access to <%= product_preview_name %> preview features
        </label>
        <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 3, color: :muted)) do %>
          If enabled, members licensed through organizations within this enterprise can access previews of new <%= parent_product_name %> features. Use of previews is subject to
          <%= render(Primer::Beta::Link.new(href: github_copilot_previews_term_url, classes: "Link--inTextBlock")) { "GitHub's pre-release terms" } %>.
        <% end %>
      <% end %>
      <%= form_with url: submit_path, class: "d-inline", method: :put, data: { target: "copilot-business-settings.#{form_target}" } do %>
        <input type="hidden" name="tab" value="policies">
        <%= render(Primer::Beta::Text.new(tag: :p, mb: 1, font_weight: :bold)) do %>
          <input type="hidden" value="disabled" name="<%= policy_id %>">
          <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
            <%= render(
              Primer::Alpha::ToggleSwitch.new(
                size: :small,
                status_label_position: :start,
                csrf_token: "",
                id: policy_id,
                checked: checked?,
                aria: { label: "Opt in for access to Copilot preview features" },
                data: {
                  action: "click:copilot-business-settings##{toggle_action}",
                  target: "copilot-business-settings.#{toggle_target}",
                  checked: checked?
                }
              )
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, test_selector: "copilot-beta-features-opt-in")) do %>
      <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
        <label for="copilot_beta_features_opt_in">
          Opt in for access to Copilot preview features
        </label>
        <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 3, color: :muted)) do %>
          If enabled, organizations can use previews of new Copilot in GitHub.com features. Use of previews is subject to
          <%= render(Primer::Beta::Link.new(href: github_copilot_previews_term_url, classes: "Link--inTextBlock")) { "GitHub's preview terms" } %>.
        <% end %>
      <% end %>
      <%= form_with url: submit_path, class: "d-inline", method: :put, data: { target: "copilot-business-settings.betaFeaturesOptInForm" } do %>
        <input type="hidden" name="tab" value="policies">
        <%= render(Primer::Beta::Text.new(tag: :p, mb: 1, font_weight: :bold)) do %>
          <input type="hidden" value="disabled" name="copilot_beta_features_opt_in">
          <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
            <%= render(
              Primer::Alpha::ToggleSwitch.new(
                size: :small,
                status_label_position: :start,
                csrf_token: "",
                id: "copilot_beta_features_opt_in",
                checked: @copilot_object.beta_features_github_chat_enabled?,
                aria: { label: "Opt in for access to Copilot preview features" },
                data: {
                  action: "click:copilot-business-settings#toggleBetaFeaturesOptIn",
                  target: "copilot-business-settings.betaFeaturesOptInCheckbox",
                  checked: @copilot_object.beta_features_github_chat_enabled?
                }
              )
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</copilot-business-settings>
