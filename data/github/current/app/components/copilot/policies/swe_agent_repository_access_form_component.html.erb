<copilot-business-settings>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
    <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
      <label for="copilot_swe_agent_repository_access">
        Block <%= Copilot::COPILOT_SWE_AGENT %> in all repositories owned by <%= configurable.name %>
      </label>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 3, color: :muted)) do %>
        When enabled, <%= Copilot::COPILOT_SWE_AGENT %> will be blocked from accessing all repositories owned by <%= configurable.name %>, for all users—including those not managed by this enterprise.
      <% end %>
    <% end %>
    <%= form_tag submit_path, class: "d-inline", method: :put, "aria-label": "Block Copilot coding agent", data: { autosubmit: true } do %>
      <input type="hidden" name="tab" value="policies">
      <%= render(Primer::Beta::Text.new(tag: :p, font_weight: :bold)) do %>
        <input type="hidden" value="disabled" name="copilot_swe_agent_repository_access">
        <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
          <%= render(
              Primer::Alpha::ToggleSwitch.new(
                size: :small,
                status_label_position: :start,
                csrf_token: "",
                id: "copilot_swe_agent_repository_access",
                checked: checked?,
                aria: { label: "Block #{Copilot::COPILOT_SWE_AGENT} in all enterprise repositories owned by #{configurable.name}" },
                data: {
                  action: "click:copilot-business-settings#toggleSweAgentRepositoryAccess",
                  target: "copilot-business-settings.sweAgentRepositoryAccessCheckbox",
                  checked: configurable.swe_agent_repository_access_enabled?
                }
              )
            ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</copilot-business-settings>
