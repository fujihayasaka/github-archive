<%= render(Primer::Alpha::Stack.new(direction: :vertical)) do %>
  <%= render(Primer::Alpha::Stack.new(direction: :horizontal, align: :stretch, test_selector: "copilot-quota-usage")) do %>
    <%= render(::Copilot::Policies::Quota::FeatureUsageBarComponent.new(
      feature_name: "Code completions",
      feature_key: "code-completions",
      percentage_used: completions_percentage_used,
      any_quotas_exhausted: any_quotas_exhausted,
      has_error: has_error
    ))%>
    <%= render(::Copilot::Policies::Quota::FeatureUsageBarComponent.new(
      feature_name: "Chat messages",
      feature_key: "chat-messages",
      percentage_used: chat_percentage_used,
      any_quotas_exhausted: any_quotas_exhausted,
      has_error: has_error
    ))%>
  <% end %>
  <% if has_error %>
    <%= render(Primer::Alpha::Stack.new(direction: :horizontal, align: :center, justify: :start, role: "alert", gap: :condensed)) do %>
      <%= render(Primer::Beta::Octicon.new(icon: :"alert-fill", size: :xsmall, color: :attention, aria_hidden: true)) %>
      <%= render(Primer::Beta::Text.new(font_size: :small, font_weight: :emphasized, color: :attention)) do %>
        There was a problem loading your Copilot usage.
        <%= render(Primer::Beta::Link.new(href: "", underline: false)) do %>
          Try again
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
