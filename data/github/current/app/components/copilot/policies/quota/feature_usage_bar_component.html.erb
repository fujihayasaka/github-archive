<%= render(Primer::Alpha::StackItem.new(grow: true, style: "flex-basis: 0; min-width: 0", test_selector: "copilot-quota-#{feature_key}")) do %>
  <%= render(Primer::Alpha::Stack.new(direction: :horizontal, justify: :space_between, mb: 2, w: :full)) do %>
    <span><%= feature_name %></span>
    <span <%= test_selector("copilot-quota-value-#{feature_key}") %>><%= percentage_used_text %></span>
  <% end %>
  <%= render(Primer::Beta::ProgressBar.new(aria: { label: aria_label }, test_selector: "copilot-quota-bar-#{feature_key}")) do |bar| %>
    <%= bar.with_item(percentage: percentage, bg: progress_bar_color) %>
  <% end %>
<% end %>
