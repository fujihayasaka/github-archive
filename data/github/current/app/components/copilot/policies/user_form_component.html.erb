<input type="hidden" name="<%= policy_name %>" value="<%= value %>">
<%= render(Primer::Box.new(id: "copilot-#{policy_name}-policy", display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center)) do %>
  <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
    <%= render(Primer::Box.new(display: :inline_flex, align_items: :center, justify_content: :space_between, direction: :row)) do %>
      <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
        <%= display_name %>
        <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2)) { "Preview" }  if preview %>
      <% end %>
      <% if enablement_text.present? %>
        <%= render(Primer::Box.new) do %>
          <%= enablement_text %>
        <% end %>
      <% else %>
        <%= render(Primer::Box.new(display: :flex, direction: :row)) do %>
          <% if setting_changed %>
            <%= render Primer::Box.new(display: :flex, direction: :column, mr: 1, classes: 'hx_anim-fade-out') do %>
              <%= render Primer::Beta::Octicon.new(icon: "check", size: :small, mt: 2, mr: 2, color: :success) %>
            <% end %>
          <% end %>

          <%= render Primer::Alpha::ActionMenu.new(
              select_variant: :single,
              anchor_align: :end,
              size: :small,
              show_dividers: true,
              dynamic_label: true,
              anchor_side: :outside_bottom,
            ) do |menu|
              menu.with_show_button do |button|
                button.with_trailing_action_icon(icon: :"triangle-down")
                "Select an option"
              end

              menu_items.each do |menu_item|
                menu.with_item(
                  label: menu_item.label,
                  active: menu_item.checked?,
                  data: {
                    action: "click:copilot-user-settings#updateSetting",
                    target: "copilot-user-settings.#{policy_name}",
                    "policy-name": policy_name,
                    value: menu_item.value,
                  },
                ) do |item|
                  item.with_description.with_content(menu_item.description)
                end
                menu.with_divider unless menu_item.label == menu_items.last.label
              end
            end %>
        <% end %>
      <% end %>
    <% end %>
    <% if description.present? %>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 6, color: :muted, id: "copilot_#{policy_name}_label", col: 10)) do %>
        <%= description %>
      <% end %>
    <% end %>
    <% if policy_blocked_by.present? %>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, mr: 6, color: :muted, id: "copilot_#{policy_name}_setting_managed_by_label", col: 10)) do %>
        <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", size: :small, color: :muted)) %>
        <%= policy_blocked_by %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

