<copilot-business-settings>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, test_selector: "code-review-repository-access")) do %>
    <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
      <label for="copilot_code_review_repository_access">
        Block <%= Copilot::COPILOT_CODE_REVIEW %> in all enterprise repositories
      </label>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 3, color: :muted)) do %>
        If enabled, <%= Copilot::COPILOT_CODE_REVIEW %> will be blocked in all repositories in this enterprise for all users, even if they are not assigned a Copilot license by this enterprise.
      <% end %>
    <% end %>
    <%= form_tag submit_path, class: "d-inline", method: :put, "aria-label": "Block Copilot code review", data: { target: "copilot-business-settings.codeReviewRepositoryAccessForm" } do %>
      <input type="hidden" name="tab" value="policies">
      <%= render(Primer::Beta::Text.new(tag: :p, font_weight: :bold)) do %>
        <input type="hidden" value="disabled" name="copilot_code_review_repository_access">
        <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
          <%= render(
            Primer::Alpha::ToggleSwitch.new(
              size: :small,
              status_label_position: :start,
              csrf_token: "",
              id: "copilot_code_review_repository_access",
              checked: checked?,
              aria: { label: "Block Copilot code review in all enterprise repositories" },
              data: {
                action: "click:copilot-business-settings#toggleCodeReviewRepositoryAccess",
                target: "copilot-business-settings.codeReviewRepositoryAccessCheckbox",
                checked: checked?
              }
            )
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</copilot-business-settings>
