<%= helpers.render_nothing_on_error do %>
  <%= render(Primer::Alpha::Banner.new(
    icon: :info,
    scheme: :default,
    test_selector: "rbi-outstanding-upgrade-payment",
  )) do |banner| %>
    <% banner.with_action_content do %>
      <%= render(Primer::Beta::Button.new(
        tag: :a,
        href: pay_path,
        data: { test_selector: "complete-payment-button" },
      )) do %>
        Complete your payment
      <% end %>
      <%= form_with url: cancel_path, method: :delete, class: "d-inline-block" do %>
        <%= render(Primer::Beta::Button.new(
          tag: :button,
          type: :submit,
          data: { test_selector: "cancel-upgrade-button" },
        )) do %>
          Cancel upgrade
        <% end %>
      <% end %>
    <% end %>
    <strong>Complete your payment to activate <%= product_name %>.</strong>
    Your plan upgrade is waiting on a manual payment. Under Reserve Bank of India (RBI) regulations,
    automatic card payments are disabled on your account, so you'll need to authorize this payment to
    finish activating your subscription.
  <% end %>
<% end  %>
