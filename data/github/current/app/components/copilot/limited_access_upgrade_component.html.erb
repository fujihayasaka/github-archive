<% if new_checklist_enabled? %>
  <%= render_react_partial(name: "copilot-free-user-checklist", props: react_partial_props) if show_free_user_checklist? %>
<% else %>
  <%= render Primer::Beta::BorderBox.new(
    font_size: 5,
    test_selector: "user-level-upgrade-component",
    mb: 4
  ) do |component| %>
    <% component.with_body do %>
      <%= render(Primer::Beta::Text.new(tag: :p, font_size: 5, font_weight: :bold)) do %>
        You are using Copilot for free
      <% end %>

      <%= render Primer::Beta::Text.new(tag: :p, mb: 3, color: :muted) do %>
        Responses are limited to 2,000 code completions and 50 chat messages per month.
      <% end %>

      <hr>

      <%= render(Primer::Beta::Text.new(tag: :p, font_size: 5, font_weight: :bold)) do %>
        Get unlimited usage with Copilot Pro
      <% end %>

      <ul style="list-style: none">
        <li class="mb-2">
          <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1, color: :accent)) %>
          <%= render(Primer::Beta::Text.new(color: :muted)) { "Unlimited messages and interactions" } %>
        </li>
        <li class="mb-2">
          <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1, color: :accent)) %>
          <%= render(Primer::Beta::Text.new(color: :muted)) { "Access to the latest models" } %>
        </li>
        <li class="mb-2">
          <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1, color: :accent)) %>
          <%= render(Primer::Beta::Text.new(color: :muted)) { "Customize conversations to your private codebase and extensions" } %>
        </li>
      </ul>

      <%= render Primer::Box.new(display: :flex, classes: "gap-2", mt: 3) do %>
        <%= render(Primer::Beta::Button.new(
          scheme: :default,
          tag: :a,
          target: "_blank",
          href: copilot_pro_signup_path,
          "aria-label": "Click to view signup for Copilot Pro",
          data: analytics_click_attributes(
            category: "copilot_settings",
            action: "click_to_upgrade_copilot",
          )
        )) do %>
          <%= @copilot_user.eligible_for_trial? ? "Start a free trial" : "Upgrade to Pro" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
