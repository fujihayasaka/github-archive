<div class="mb-3 f6 fgColor-muted text-semibold">
  Suggested changeset
  <%= render(Primer::Beta::Counter.new(count: ordered_diff_entries.count, test_selector: "counter-label",  ml: 2)) %>
</div>
<% ordered_diff_entries.each do |diff_entry| %>
  <%= render Suggestions::UnifiedDiffComponent.new(
    diff_entry: diff_entry,
    file_highlighting: file_highlighting&.[](diff_entry.path),
    hydro_click_tracking_payload:,
    not_collapsed: ordered_diff_entries.count < 10 && diff_entry.line_count < 70,
    skip_view_patch_menu_item:,
  ) do |component| %>
    <% component.with_header_additions do %>
      <% if header_type == :apply_button %>
        <%= render(Primer::Beta::Button.new(
          id: "apply-button-#{diff_entry.path}-#{diff_entry.to_diff_text.hash}",
          scheme: :secondary,
          size: :small,
          type: :button,
          test_selector: "multi-file-diff-component-apply-button",
          data: { path: diff_entry.path })) do |component|
            component.with_tooltip(text: "", direction: :n, visibility: :hidden)
            "Apply"
          end%>
      <% elsif header_type == :default %>
        <% unless current_path == diff_entry.path %>
          <div>
            <%= render(Primer::Beta::Label.new(scheme: :default, display: :inline_flex, test_selector: "unified-diff-outside-changed-files")) { "Outside changed files" } %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
