<%= render Suggestions::UnifiedDiffComponent.new(
  diff_entry:,
  file_highlighting:,
  hydro_click_tracking_payload:,
  skip_view_patch_menu_item: true,
) do |component| %>
  <% component.with_header_additions do%>
    <%= render(Primer::Beta::Button.new(
      id: "apply-button-#{index}-#{diff_entry.to_diff_text.hash}",
      flex_shrink: 0,
      scheme: :secondary,
      size: :small,
      type: :button,
      test_selector: "suggested-changes-diff-component-apply-button",
      data: { index:, path: diff_entry.path })) do |component|
        component.with_tooltip(text: "", direction: :n, visibility: :hidden)
        "Apply"
      end %>
  <% end %>
<% end %>
