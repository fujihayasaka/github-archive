<% banner_text = capture do %>
  <%= message %>
  Visit the <a href="https://gh.io/team-limits">team limits page</a> to learn more.
<% end %>

<% if reached? %>
  <%= render(Primer::Alpha::Banner.new(
    icon: :stop,
    scheme: :danger,
    test_selector: "limits-banner",
    classes: "tmp-mt-3 tmp-mb-3")) do %>
    <%= banner_text %>
  <% end %>
<% elsif approaching? && !warning_dismissed? %>
  <%= render(GitHub::FlashActionDismissibleComponent.new(
    level: :warning,
    dismissible_path: dismissal_path,
    dismissible_method: "delete",
    test_selector: "limits-banner",
    classes: "tmp-mt-3 tmp-mb-3")) do |c| %>
    <% c.with_text do %>
      <%= banner_text %>
    <% end %>
  <% end %>
<% end %>
