<% if cve_epss.present? %>
<div <%= helpers.test_selector "cve_epss_section" %>>
  <%= render Primer::Box.new(display: :inline_block, align_items: :center, gap: '10px', color: :default, border: :bottom, style: "border-style: none none dashed !important;") do %>
    <%= render(Primer::Alpha::Dialog.new(title: title, size: :small, position: :center, position_narrow: :fullscreen)) do |component| %>
      <% component.with_show_button(scheme: :link, text_align: :left, color: :default) do %>
        <%= render Primer::Box.new(display: :flex, align_items: :center, no_delay: true, multiline: true, test_selector: "cve_epss_percentage").with_content(epss_percentage) %>
      <% end %>
      <% component.with_body do %>
        <%= render Primer::Box.new(display: :flex, align_items: :center, font_size: :small, no_delay: true, multiline: true, test_selector: "cve_epss_definition") do %>
          <%= render Primer::Beta::Text.new(display: :inline_block) do %>
            This score estimates the probability of this vulnerability being exploited within the next 30 days.
            Data provided by <a href="https://www.first.org/epss/user-guide" target="_blank" rel="noopener noreferrer">FIRST</a>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= render Primer::Box.new(display: :inline_block, align_items: :center, gap: '5px', color: :default).with_content(epss_percentile) %>
</div>
<% end %>
