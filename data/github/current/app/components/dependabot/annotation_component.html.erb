<div <%= test_selector("dependabot-annotation") %>>
  <%= div_if_inline(class: "Details js-details-container check-annotation check-annotation-#{ warning_level } py-3", id: "annotation_#{annotation_id}", data: {"test-selector" => "inline-dependabot-annotation"}) do %>
    <% if inline %>
      <%= render partial: "diff/inline_annotation_header", locals: {
          warning_level: warning_level,
          filename: nil,
          end_line: nil
      } %>
    <% end %>
    <p class="ml-3 mb-2 pl-4 mr-2 flex-shrink-0 d-flex flex-items-center">
      <%= primer_octicon(:"mark-github") %>
      <span class="mx-1 text-bold">Dependabot / Copilot Autofix</span>
    </p>

    <p class="ml-3 mb-0 pl-4 text-bold d-flex flex-items-start">
      <span class="annotation-title pr-2">
        <%= annotation_title %>
      </span>
    </p>

    <div class="pt-2 pl-4 ml-3 overflow-auto code-scanning-font-size-inherit cs-message">
      <%= annotation_message %>
    </div>

  <% end %>
</div>
