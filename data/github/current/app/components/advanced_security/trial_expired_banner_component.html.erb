<div class="color-bg-severe color-border-severe d-md-flex flex-items-center flex-justify-between py-2 tmp-px-3 h6 border-bottom" <%= test_selector("trial_expired_banner") %>>
  <div class="d-flex flex-items-center flex-justify-between flex-md-justify-start">
    <div <%= test_selector("trial_expired_text") %>>
      <div class="d-block mr-2 color-fg-severe">
        <%= render(Hydro::TrackViewComponent.new(name: "advanced_security/trial_expired_banner")) %>
        <span style="font-weight: bold"><%= render(Primer::Beta::Octicon.new(icon: "clock", size: :small, color: :severe, mr: 2)) %>Your GitHub Advanced Security trial has expired</span>
      </div>
    </div>
  </div>

  <div class="d-none d-md-flex flex-items-center flex-shrink-0" <%= test_selector("trial_expired_actions") %>>
    <% if enterprise_admin? %>
      <a href="https://resources.github.com/contact/security/" class="d-block tmp-ml-5 tmp-mr-3 color-fg-severe"
        <%= safe_analytics_click_attributes(
            category: "advanced_security_trial_expired_banner",
            action: "talk_to_us",
            label: "ref_cta:talk_to_us;ref_loc:advanced_security_trial_expired_banner",
        ) %>
        <%= test_selector("trial_expired_talk_to_us") %>
      >
        Talk to us
      </a>
    <% end %>
    <div <%= test_selector("trial_expired_buy_advanced_security") %>>
      <%= render(Primer::Beta::Button.new(
        tag: :a,
        color: :accent,
        scheme: :secondary,
        href: buy_button_href,
        data: analytics_click_attributes(
          category: "advanced_security_trial_expired_banner",
          action: "click_buy_advanced_security",
          label: "ref_cta:buy_advanced_security;ref_loc:advanced_security_trial_expired_banner",
        ),
      )) { "Buy Advanced Security" } %>
    </div>
  </div>
</div>
