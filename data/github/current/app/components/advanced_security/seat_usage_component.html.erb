<div class="flex-1 mr-4" <%= test_selector("ghas-seat-usage-component") %>>
  <div class="d-flex flex-justify-between flex-items-center gap-2" <%= test_selector sku_title.parameterize %>>
    <span class="d-flex flex-items-center f3 fgColor-default" <%= test_selector "ghas-seat-usage" %>>
      <% if billable_entity? || !@unlimited %>
        <%= number_with_delimiter @consumed_licenses %>
      <% else %>
        <%# In unlimited mode, we don't show the meter, so we need to provide more context here about the breakdown between this organization and other organizations in the entity. %>
        <%= number_with_delimiter entity_licenses %> (<%= number_with_delimiter other_entities_licenses %> in other organizations)
      <% end %>
      <% if @unlimited && additional_metered_licenses > 0 %>
        <span class="f4" <%= test_selector("ghas-additional-metered-usage") %>>(+<%= additional_metered_licenses %> from <%= link_to "GitHub Connect", helpers.docs_url("billing/metered-ghas-connect"), class: "Link--inTextBlock" %>)</span>
      <% elsif !@unlimited && server_only_committers > 0 %>
        <span class="f4 pl-1" <%= test_selector("ghas-server-only-committers") %>>(+<%= server_only_committers %> from GitHub Connect)</span>
      <% end %>
    </span>
    <% unless @unlimited %>
      <span class="<%= @allowance_exceeded ? "fgColor-danger" : "fgColor-muted" %>">
        <span <%= test_selector("ghas-seats-available") %>>
          <%= number_with_delimiter available_licenses %>
        </span>
        available
      </span>
    <% end %>
  </div>
  <% unless @unlimited %>
    <div role="meter"
      aria-label="<%= @label.present? ? @label : 'Licenses' %>"
      aria-valuetext="<%= value_text %>"
      aria-valuenow=<%= @consumed_licenses %>
      aria-valuemax=<%= @purchased_licenses%>
    >
    <%= render(Primer::Beta::ProgressBar.new(size: @size, mt: 1)) do |component| %>
      <% if billable_entity? %>
        <% component.with_item(bg: :accent_emphasis, percentage: consumed_licenses_percent) %>
      <% else %>
        <% if entity_licenses_percent > 0 %>
        <% component.with_item(bg: :accent_emphasis, percentage: entity_licenses_percent) %>
      <% end %>
        <% component.with_item(bg: :success_emphasis, percentage: other_entities_licenses_percent) %>
      <% end %>
    <% end %>
    <% if !billable_entity? %>
      <%= render(Primer::Box.new(
        display: :flex,
        justify_content: :flex_end,
        mt: 1, test_selector: "ghas-seat-usage-legend"
      )) do %>
        <div>
          <%= render Primer::Beta::Octicon.new(:"dot-fill", color: :accent) %>
          This organization
          <span class="fgColor-muted">
            <%= entity_licenses %>
          </span>
        </div>
        <div class="ml-2">
          <%= render Primer::Beta::Octicon.new(:"dot-fill", color: :success) %>
          Other organizations
          <span class="fgColor-muted">
            <%= other_entities_licenses %>
          </span>
        </div>
      <% end %>
    <% end %>
    </div>
  <% end %>
  <% unless bundled? %>
    <span class="text-small" test_selector="ghas-sku-type">
      <%= sku_title %>
    </span>
  <% end %>
</div>
