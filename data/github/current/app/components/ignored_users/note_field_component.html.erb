<%# Validation happens client-side in the JS because we need it to update as a user types
%>
<%= render Primer::Alpha::TextArea.new(
  caption:,
  full_width: true,
  label: "Add an optional note",
  name: :note,
  value: @note || "",
  id: @text_field_id,
  data: { test_selector: "ignored_user_note_text_field", character_limit: IgnoredUser::MAX_NOTE_LENGTH },
  style: "resize: vertical",
  classes: "js-ignored-user-note-field",
) %>
<span class="sr-only" id="ignored-user-character-count-sr" aria-live="polite" aria-atomic="true"></span>
