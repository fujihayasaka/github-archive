<%= render(Primer::BaseComponent.new(
  tag: :article,
  display: :flex,
  direction: :column,
  w: :full,
  py: 3,
  test_selector: "dashboard-feed-learn-component"
)) do %>
  <%= render(Primer::BaseComponent.new(
    tag: :header,
    display: :flex,
    align_items: :center,
    justify_content: :space_between
  )) do %>
    <%= render(Primer::Box.new(
      display: :flex,
      align_items: :center
    )) do %>
      <%= render(Primer::Beta::Text.new(
        display: :inline_flex,
        mr: 2,
        p: 2,
        classes: "circle",
        style: "background-color: var(--bgColor-neutral-muted, var(--color-scale-gray-2));"
      )) do %>
        <%= render(Primer::Beta::Octicon.new(:"north-star", color: :subtle, aria: { hidden: true })) %>
      <% end %>
      <%= render(Primer::Beta::Heading.new(
        tag: :h3,
        color: :muted,
        font_size: 5,
        font_weight: :normal
      ).with_content("Learn with a tutorial project")) %>
    <% end %>
    <%= render(Primer::Alpha::ActionMenu.new(
      select_variant: :none,
      anchor_align: :end,
      anchor_side: :outside_bottom,
      size: :small)) do |menu| %>
      <% menu.with_show_button(
        scheme: :invisible,
        size: :small,
        aria: { label: "Why am I seeing this?" }) do |button| %>
        <%= render(Primer::Beta::Octicon.new(icon: :"kebab-horizontal", color: :default)) %>
      <% end %>
      <% menu.with_item(
        label: "Remove from dashboard",
        href: dismiss_notice_path(notice: notice_name),
        form_arguments: { method: :post }
      ) %>
    <% end %>
  <% end %>
  <ul class="d-flex flex-wrap mt-2 gutter-sm-condensed" style="list-style-type: none;">
    <% TUTORIAL_PROJECTS.each do |p| %>
      <li class="col-sm-12 col-md-6 mb-3">
        <%= render(Primer::Beta::Link.new(
          href: p[:url],
          display: :flex,
          direction: :column,
          border: true,
          border_radius: 2,
          box_shadow: :medium,
          bg: :overlay,
          p: 3,
          h: :full,
          aria: { describedby: p[:id] },
          data: analytics_click_attributes(
            category: "dashboard-feed-learn-component",
            action: "click.#{p[:name].parameterize}",
            label: "target:#{p[:url]}",
          )
        )) do %>
          <%= render(Primer::Beta::Text.new(color: :accent, font_weight: :bold)) { p[:name] } %>
          <%= render(Primer::Beta::Text.new(
            id: p[:id],
            color: :muted,
          ).with_content(p[:description])) %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= render(Primer::Beta::Link.new(href: "https://skills.github.com", mt: 1)) { "See more tutorial projects" } %>
<% end %>
