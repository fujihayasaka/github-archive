<div class="flex-1">
  <% if expiration_date %>
    <div class="ml-3">
      <div class="f5 fgColor-default text-semibold">
        Valid until
      </div>
      <div class="f4 text-emphasized">
        <%= expiration_date_formatted %>
      </div>
      <% if !expired? %>
        <div class="f6 fgColor-muted">
          (includes support and updates)
        </div>
      <% else %>
        <% unless has_renewal? %>
          <%= render(Primer::Beta::Label.new(tag: :div, scheme: :danger)) { "Expired" } %>
        <% end %>
      <% end %>
      <% if has_renewal? %>
        <%= render(Primer::Beta::Label.new(tag: :div, scheme: :success)) { "Renewed from #{renewal_scheduled_start_datetime_formatted}" } %>
      <% end %>
    </div>
  <% end %>
</div>
