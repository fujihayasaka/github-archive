<%= render(Primer::Alpha::Banner.new(scheme: :danger, full: false, icon: "alert", mb: 3, mt: 3)) do %>
  <% if current_user_admin? %>
    <div class="text-small" <%= test_selector "warning-description" %>>
      Your account has reached its current usage limit for <b>Actions</b>. Get in touch with our customer support team to continue.
    </div>
  <% else %>
    <div class="text-small" <%= test_selector "warning-description" %>>
      Your account has reached its current usage limit for <b>Actions</b>. Please contact your admin to continue.
    </div>
  <% end %>
<% end %>
