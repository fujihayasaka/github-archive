<%= helpers.render_nothing_on_error do %>
  <section aria-label="Payment Retry Banner">
    <%= render Primer::Alpha::Banner.new(
      scheme: banner_scheme,
      icon: banner_icon,
      border_radius: 0,
      dismiss_scheme: dismissable? ? :remove : :none,
      name: "retry_payment_banner",
      test_selector: "retry-payment-banner"
    ) do |flash| %>
      <strong><%= banner_title %></strong>
      <% if show_retry_button? || show_update_button? %>
        <% flash.with_action_content do %>
          <%= form_with url: billing_retry_payments_path, method: :post do |form| %>
            <%= form.hidden_field :customer_id, value: customer.id %>
            <% if show_update_button? %>
              <%= render Primer::Beta::Button.new(
                tag: :a,
                href: path_to_payment_page,
                data: { test_selector: "update-payment-button" }
              ) do |button| %>
                Update payment method
              <% end %>
            <% end %>
            <% if show_retry_button? %>
                <%= render Primer::Beta::Button.new(
                  tag: :button,
                  type: :submit,
                  data: {
                    test_selector: "retry-payment-button"
                  },
                  aria: { label: "Retry failed payment" }
                ) do |button| %>
                  Retry payment
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <br>
      <%= banner_message %>
      <% if payment_state == :failed %>
        <%= render(Primer::Beta::Link.new(href: learn_more_url, classes: "Link--inTextBlock")) { "Learn more" } %>
      <% end %>
    <% end %>
  </section>
<% end %>
