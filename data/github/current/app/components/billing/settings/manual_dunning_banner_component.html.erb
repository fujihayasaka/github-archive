<%= render(Primer::Alpha::Banner.new(scheme: :warning, icon: :alert, display: :flex, dismiss_scheme: :remove)) do |b| %>
  Your payment is overdue for usage on GitHub.

  <% if pay_now_path.present? %>
    <% b.with_action_content do %>
      <%= render Primer::Beta::Button.new(
        tag: :a,
        href: pay_now_path,
      ) do %>
        Pay now
      <% end %>
    <% end %>
  <% end %>
  <div class="mt-2">
    Please make a payment by <%= formatted_due_date %> to continue to use paid services.
    <%= link_to "Check out the docs", GitHub.rbi_manual_payment_url, class: "Link--inTextBlock" %>, or <a class="Link--inTextBlock" href="<%= contact_path %>">contact support</a> with any questions.
  </div>
<% end %>
