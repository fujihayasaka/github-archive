<%= render(Primer::Alpha::Banner.new(mb: 3, icon: :stop, scheme: :danger, dismiss_scheme: :hide, test_selector: "enterprise_with_outstanding_invoices_warning")) do |component| %>
  Please pay your outstanding invoice or <%= link_to "contact sales", "/renewals-help", class: "Link--inTextBlock" %> before <%= blocked_user_action %>.

  <% if render_pay_cta? %>
    <% component.with_action_content do %>
      <% render(Primer::Beta::Button.new(href: enterprise_billing_url, tag: :a)) do %>
        Pay Invoice
      <% end %>
    <% end %>
  <% end %>
<% end %>
