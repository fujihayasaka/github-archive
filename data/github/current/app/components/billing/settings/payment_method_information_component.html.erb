<%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, mt: 1, test_selector: "notice-payment-method-update-message")) do %>
  <%= render(Primer::Beta::Octicon.new(icon: "info")) %>
  <% if has_unpaid_invoices? %>
    When you update your card, any unpaid invoices will be charged.
  <% else %>
    When you update your card, a temporary authorization hold may be placed to verify your card.
  <% end %>
<% end %>
