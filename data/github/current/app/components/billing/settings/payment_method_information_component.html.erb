<div class="js-payment-method-update-notice" <%= "hidden" if hide_update_notices %>>
  <% if show_prepaid_cards_not_supported_message? %>
    <%= render(Primer::Alpha::Banner.new(icon: :"credit-card", scheme: :warning, display: :flex, test_selector: "notice-prepaid-cards-not-supported-message", classes: "tmp-mb-3")) do %>
      <%= prepaid_cards_not_supported_message %>
    <% end %>
  <% end %>
  <% if show_payment_method_verification_message? %>
    <%= render Primer::Alpha::Banner.new(icon: :info, display: :flex, test_selector: "notice-payment-method-verification-message", classes: "tmp-mb-3") do %>
      <%= payment_method_verification_message %>
    <% end %>
  <% end %>
</div>

<% if show_separate_auth_notice? %>
  <%= render Primer::Alpha::Banner.new(icon: :info, display: :flex, test_selector: "notice-payment-method-auth-hold-message", classes: "tmp-mb-3") do %>
    <%= authorization_hold_message %>
  <% end %>
<% end %>
