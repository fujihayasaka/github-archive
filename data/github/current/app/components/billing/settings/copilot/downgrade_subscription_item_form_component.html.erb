<div class="color-fg-muted">
  <% if heading? %>
    <div class="mb-4">
      <%= heading %>
    </div>
  <% end %>

  <%= body %>
  If downgraded, your access to <%= product_name %> will expire on <span class="text-bold"><%= next_billing_date %></span>. After that, you'll be switched to GitHub <%= Copilot.individual_pro_product_name %>.

  <hr>

  <%= form_with url: copilot_pro_plus_downgrade_path, method: :post, local: true  do |f| %>
    <%= f.hidden_field :payment_duration, value: "#{subscription_item.interval}ly" %>
    <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: false)) do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": dialog_id })) { "Keep #{product_name}" } %>
      <%= render(Primer::Beta::Button.new(scheme: :danger, type: :submit, size: :medium, "data-disable-with": "Downgrading...")) do %>
          Downgrade to <%= Copilot.individual_pro_product_name %>
      <% end %>
    <% end %>
  <% end %>
</div>
