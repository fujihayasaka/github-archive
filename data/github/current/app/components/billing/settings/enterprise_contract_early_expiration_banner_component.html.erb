<div class="mb-3 js-notice" id="notice-banner">
  <div class="d-flex flex-justify-between flex-items-center color-bg-attention border color-border-attention rounded-2 p-2" <%= test_selector("enterprise-contract-early-expiration-banner") %>>
    <div class="d-flex flex-items-center">
      <%= render(Primer::Beta::Octicon.new(:alert, size: :small, color: :attention, ml: 1)) %>
      <span class="m-2 text-normal" >Your GitHub Enterprise contract expires on <span class="text-bold"><%= billing_end_date %></span>. Renew now to keep your experience as smooth as possible.</span>
    </div>
    <div class="d-flex flex-items-center">
      <%= render Primer::Beta::Button.new(size: :medium, scheme: :secondary, tag: :a, mr: 3, href: billing_renew_enterprise_path(@business)) do %>
        Renew now
      <% end %>
      <%= form_tag growth_notice_dismissals_path, method: :post, class: "js-notice-dismiss" do %>
        <input type="hidden" name="notice" value="<%= notice_name %>">
        <input type="hidden" name="business_id" value="<%= business.id %>">
        <input type="hidden" name="expires" value="<%= dismissal_period %>">
        <%= render Primer::Beta::CloseButton.new(
          type: :submit,
          ml: 1,
          aria: { label: "Hide this notice" },
          color: :attention,
          data: analytics_click_attributes(
            category: "contract_renewal",
            action: "decline_dialog_to_renew_enterprise_account",
            label: "business_id:#{business.id};current_user:#{current_user.id}"
          )
        ) %>
      <% end %>
    </div>
  </div>
</div>
