<div class="<%= wrapper_class %> js-user-personal-profile-summary" <%= test_selector("name-address-summary-container") %>>
  <% if short_summary? %>
    <div class="d-flex">
      <%= render GitHub::AvatarComponent.new(actor: contact_owner, size: 32, mr: 2) %>
      <ul class="list-style-none">
        <li class="text-bold"><%= contact.fullname %></li>
        <li class="color-fg-muted text-small"><%= contact_owner %></li>
      </ul>
    </div>
  <% else %>
    <ul class="float-left list-style-none">
      <% if show_avatar_header? %>
        <li class="d-flex mb-3 lh-condensed">
          <%= render GitHub::AvatarComponent.new(actor: contact_owner, size: 32, mr: 2) %>
          <ul class="list-style-none">
            <li class="text-bold"><%= contact.fullname %></li>
            <li class="color-fg-muted text-small"><%= contact_owner %></li>
          </ul>
        </li>
      <% else %>
        <li class="pb-2 text-small<%= ' text-bold' if !unbold_contact_name_text_style %>"><%= contact.fullname %></li>
      <% end %>
      <li class="color-fg-muted text-small"><%= contact.address1 %> </li>
      <li class="color-fg-muted text-small"><%= contact.address2 %> </li>
      <% if contact.country_is_united_states? %>
        <li class="color-fg-muted text-small"><%= contact.city %>, <%= contact.us_state %> <%= contact.postal_code %> </li>
      <% else %>
        <li class="color-fg-muted text-small"><%= contact.city %>, <%= contact.region %> <%= contact.postal_code %> </li>
      <% end %>
      <li class="color-fg-muted text-small"><%= contact.country.name %> </li>
      <% if contact.vat_code.present? %>
        <li class="pt-2 color-fg-muted text-small">VAT/GST: <%= contact.vat_code %> </li>
      <% end %>
    </ul>
  <% end %>
</div>
