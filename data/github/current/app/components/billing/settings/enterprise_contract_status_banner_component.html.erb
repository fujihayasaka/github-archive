<div class="js-notice" id="notice-banner">
  <%= render(
    Primer::Alpha::Banner.new(scheme: color_scheme, mb: 3, classes: "js-notice-dismiss")
  ) do |component| %>
    <%= text %>

    <% component.with_action_content(display: :flex, align_items: :center) do %>
      <% if has_action? %>
        <%= render Primer::Beta::Button.new(size: :medium, scheme: :secondary, tag: :a, href: action_url) do %>
          <%= action_text %>
        <% end %>
      <% end %>
      <%= form_tag growth_notice_dismissals_path, method: :post, class: "js-notice-dismiss" do %>
        <input type="hidden" name="notice" value="<%= NOTICE_NAME %>">
        <input type="hidden" name="business_id" value="<%= business.id %>">
        <input type="hidden" name="expires" value="<%= dismissal_expires_at %>">
        <%= render Primer::Beta::IconButton.new(
          type: :submit,
          ml: 1,
          scheme: :invisible,
          icon: :x,
          aria: { label: "Hide this notice" },
          data: analytics_click_attributes(
            category: "contract_renewal",
            action: "decline_dialog_to_renew_enterprise_account",
            label: "organization_id:#{business.id};actor_id:#{current_user.id}"
          )
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
