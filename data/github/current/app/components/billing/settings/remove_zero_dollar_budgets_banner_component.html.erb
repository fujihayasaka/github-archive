<%= render(Primer::Alpha::Banner.new(mb: 3, icon: :alert, scheme: :warning, dismiss_scheme: :none, test_selector: "remove_zero_dollar_budgets_banner_selector")) do |component| %>
  <div class="d-flex flex-justify-between flex-items-start">
    <div class="flex-auto">
      <% if !@launched %>
        <strong>Coming soon:</strong>
        Account-level $0 Copilot premium request budgets will be removed beginning December 2, 2025. To avoid premium request paid usage, review and update your premium request paid usage policies before then.
        <%= link_to('Learn more about premium requests', 'https://docs.github.com/en/enterprise-cloud@latest/copilot/how-tos/manage-and-track-spending/manage-request-allowances#setting-a-policy-for-paid-usage', class: 'Link--inTextBlock') %>
      <% else %>
        <strong>$0 premium request budget removals have begun:</strong>
        We will email you when your account-level $0 premium request budget has been removed. If you haven’t already, review your <%= link_to "premium request overage policy", copilot_policy_path, class: 'Link--inTextBlock' %> to avoid unexpected charges.
      <% end %>
    </div>
  </div>
<% end %>
