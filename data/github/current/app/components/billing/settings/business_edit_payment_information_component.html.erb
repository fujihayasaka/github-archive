<%  GlobalInstrumenter.instrument("account_screening_profile.form_loaded", {
        actor: current_user,
        action: :LOADED,
        payment_flow_page: "BUSINESS",
        target_type: :BUSINESS,
        target_id: business.id,
        target_name: business.name
}) %>

<% if flash[:address_validation_error] %>
  <%= render(Primer::Alpha::Banner.new(full: false, full_when_narrow: false, dismiss_scheme: :remove, scheme: :danger, my: 3, test_selector: "address-validation-error-flash")) do %>
    <%= flash[:address_validation_error] %>
  <% end %>
<% end %>

<div style="max-width: <%= constrained_layout ? '100%' : '600px' %>;">
  <%= primer_form_with model: billing_contact, url: billing_settings_update_payment_information_enterprise_path(business), html: { class: "js-name-address-collection" }, method: :put do |fields| %>
    <%= render(
      Billing::Settings::BusinessEditPaymentInformationForm.new(
        fields,
        business: business,
        return_to: return_to,
        show_form: show_form
      )
    ) %>
    <%= csrf_hidden_input_for "/account/stash_contact", method: :post, class: "js-stash-billing-info-csrf" %>
  <% end %>
</div>
