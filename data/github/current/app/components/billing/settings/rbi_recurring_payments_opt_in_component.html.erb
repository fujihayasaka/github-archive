<% if eligible_for_opt_in? %>
  <%= render(Primer::Alpha::Banner.new(
    scheme: :default,
    icon: :info,
    test_selector: "rbi-recurring-payments-opt-in",
    classes: "tmp-mb-3 tmp-mt-3",
  )) do %>
    <p class="text-semibold">Recurring payments now available</p>
    <div class="tmp-mt-1">
      You can now set up automatic recurring payments instead of making one-time monthly transactions.
    </div>
    <div class="tmp-mt-2">
      <%= form_with url: opt_in_path, method: :post do %>
        <%= render Primer::Beta::Button.new(
          type: :submit,
          scheme: :primary,
          test_selector: "rbi-opt-in-button",
        ) do %>
          Enable recurring payments
        <% end %>
      <% end %>
    </div>
  <% end %>
<% elsif opted_in_pending_card_update? %>
  <%= render(Primer::Alpha::Banner.new(
    scheme: :warning,
    icon: :alert,
    test_selector: "rbi-pending-card-update",
    classes: "tmp-mb-3 tmp-mt-3",
  )) do %>
    <p class="text-semibold">Almost done!</p>
    <div class="tmp-mt-1">
      Recurring payments are enabled. Please update your payment method below to complete setup.
    </div>
  <% end %>
<% end %>
