<% if allowed_to_update? %>
  <%= render Primer::Beta::Button.new(
    type: :button,
    font_size: 6,
    classes: edit_button_classes,
    "aria-label": edit_button_aria_label,
    test_selector: "payment-method") do %>
      <%= edit_button_text %>
  <% end %>
<% end %>

<% if show_remove_button? %>
  <%= render(Primer::Alpha::Dialog.new(
    title: "Confirm removing payment method",
    id: "remove-payment-method-dialog",
    size: :large,
    classes: "Overlay--size-auto",
  )) do |d| %>
    <% d.with_header(text_align: :left) { "" } %>
    <% d.with_show_button(scheme: :danger, type: :button, font_size: 6, ml: 2, test_selector: "remove-payment-method-button") do %>
      Remove
    <% end %>
    <% d.with_body(text_align: :left) do %>
      <%= render Primer::Alpha::Banner.new(icon: :alert, scheme: :warning, mb: 3, mt: -2) do %>
        Removing the payment method will result in your <%= account_type %> account losing access to paid features and services billed against this payment method.
      <% end %>

      <%= render Primer::Beta::Text.new(tag: :p, font_weight: :bold, mb: 2) do %>
        Important considerations:
      <% end %>
      <%= render Primer::Beta::Text.new do %>
        <ul class="mb-3 pl-3">
          <li class="mb-2">Instead of removing, you can edit and add a different payment method to your account in order to continue to use paid features and avoid any product interruptions.</li>
          <li class="mb-2">Removing the payment method does not impact any other settings and configurations for your account.</li>
          <li class="mb-2">Once removed, you can add another payment method at anytime to resume using paid features and services.</li>
        </ul>
      <% end %>
    <% end %>
    <% d.with_footer(show_divider: false) do %>
      <%= form_tag helpers.target_payment_method_path(account), :method => :delete, id: "remove-payment-method-form", "data-test-selector": "payment-method-removal-form-wrapper" do %>
        <% if return_to.present? %>
          <%= hidden_field_tag "return_to", return_to %>
        <% end %>
        <div class="d-flex gap-2 flex-justify-end">
          <%= render(Primer::Beta::Button.new(data: { close_dialog_id: "remove-payment-method-dialog" }, test_selector: "cancel-remove-payment-method")) do %>
            Cancel
          <% end %>
          <%= render(Primer::Beta::Button.new(scheme: :danger, type: :submit, test_selector: "confirm-remove-payment-method")) do %>
            Remove payment method
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
