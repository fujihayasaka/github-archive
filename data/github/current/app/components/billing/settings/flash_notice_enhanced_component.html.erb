<section aria-label="Billing flash notice" class="mb-3" <%= test_selector("billing-enhanced-notice") %>>
  <%= render(Primer::Alpha::Banner.new(full: false, dismiss_scheme: :remove, icon: :info, scheme: :default)) do %>
    <% if heading.present? %>
      <strong <%= test_selector("billing-enhanced-notice-header") %>><%= heading %></strong>
    <% end %>

    <div <%= test_selector("billing-enhanced-notice-message") %>><%= message %></div>

    <% if action_text.present? && action_href.present? %>
      <div class="mt-2" <%= test_selector("billing-enhanced-notice-action") %>>
        <%= render(Primer::Beta::Button.new(size: :small, scheme: :default, tag: :a, href: action_href).with_content(action_text)) %>
      </div>
    <% end %>
  <% end %>
</section>
