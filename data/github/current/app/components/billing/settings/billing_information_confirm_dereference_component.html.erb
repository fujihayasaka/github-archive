<div class="Box-body">
  <p>
    You are about to remove the billing information for this organization.
    <% if target.has_linked_billing_contact? && !target.has_linked_billing_contact_to_actor?(actor: actor) %>
      This organization has billing information linked with another admin account which will be unlinked and removed.
    <% end %>
    Are you sure you want to do this?
  </p>
</div>
<div class="Box-footer" <%= test_selector "billing-info-dereference-form-wrapper" %>>
  <%= render_billing_info_inputs(url_for: unlink_trade_screening_record_from_org_path) do %>
    <% if return_to.present? %>
      <%= hidden_field_tag "return_to", return_to %>
    <% end %>
    <%= hidden_field_tag "target", :organization %>
    <%= hidden_field_tag "organization_id", target.display_login %>
    <%= render Primer::Beta::Button.new(
      type: :submit,
      scheme: :danger,
      block: true,
      name: 'unlink_billing_info_from_org',
    ).with_content("Remove billing information") %>
  <% end %>
</div>
