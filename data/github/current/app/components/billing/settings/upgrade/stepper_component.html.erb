<% if read_only? %>
  <%= render Primer::BaseComponent.new(tag: :div, display: :flex, direction: :column, align_items: :flex_start, test_selector: "seats-stepper-input-read-only") do %>
    <%= render(Primer::Box.new(bg: :subtle, py: 2, border: true, border_radius: 2, classes: "tmp-px-3")) do %>
      <%= render(Primer::Beta::Text.new(font_weight: :bold)) do %>
        <%= seats %>
      <% end %>

      <%= render(Primer::Beta::Text.new(color: :subtle, ml: 1)) do %>
        <%= label.pluralize(seats) %>
      <% end %>
    <% end %>

    <%= context %>
  <% end %>
<% else %>
  <%= render Primer::BaseComponent.new(tag: :div, **system_arguments.merge(classes: class_names(system_arguments[:classes], "tmp-my-3"))) do %>
    <%= render Primer::BaseComponent.new(tag: :div, display: :flex, "align-items": :center ) do %>
      <%= remove_seat_control %>
      <%= input %>
      <%= add_seat_control %>
      <% if show_label %>
        <%= render Primer::BaseComponent.new(tag: :span, align_self: :center, ml: 2, color: :muted, classes: stepper_label_classes ) do %>
          <%= stepper_label %>
        <% end %>
      <% end %>
    <% end %>
    <% if show_inline_errors? %>
      <%= render Primer::BaseComponent.new(
        tag: :p,
        classes: @type == :plan_upgrade ? "js-minimum-seats" : "",
        font_size: 6,
        data: @type == :manage_subscription ? { target: "manage-subscription.min_error" } : {},
        color: :muted, mt: 2, mb: 0, hidden: true, ) do %>
        <%= render(Primer::Beta::Octicon.new(icon: :alert, color: :attention, mr: 2)) %><%= min_error_message %>
      <% end %>
      <%= render Primer::BaseComponent.new(
        tag: :p,
        classes: @type == :plan_upgrade ? "js-maximum-seats" : "",
        font_size: 6,
        data: @type == :manage_subscription ? { target: "manage-subscription.max_error" } : {},
        color: :attention, mt: 2, mb: 0, hidden: true) do %>
        <%= render(Primer::Beta::Octicon.new(icon: "alert-fill", size: :small, color: :attention, mr: 2)) %><%= max_error_message %>
      <% end %>
    <% end %>

    <%= context %>
  <% end %>
<% end %>
