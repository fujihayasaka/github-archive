<% if allowed_to_update? %>
  <%= render Primer::Beta::Button.new(
    type: :button,
    font_size: 6,
    classes: edit_button_classes,
    "aria-label": edit_button_aria_label,
    test_selector: "payment-method") do %>
      <%= edit_button_text %>
  <% end %>
<% end %>

<% if show_remove_button? %>
  <%= render(Primer::Alpha::Dialog.new(
    title: "Remove your #{account.friendly_payment_method_name}",
    id: "remove-payment-method-dialog",
    size: :medium,
  )) do |d| %>
    <% d.with_header(show_divider: true, text_align: :left) { "" } %>
    <% d.with_show_button(color: :danger, type: :button, font_size: 6, ml: 2, test_selector: "remove-payment-method-button") do %>
      Remove
    <% end %>
    <% d.with_body(text_align: :left) do %>
       <%= render Billing::Settings::ConfirmRemovePaymentMethodComponent.new(target: account, return_to: return_to) %>
    <% end %>
  <% end %>
<% end %>
