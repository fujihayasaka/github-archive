<section aria-label="<%= section_label.to_s.capitalize %>">
  <%= render(Primer::Alpha::Banner.new(icon: :alert, scheme: flash_scheme, dismiss_scheme: :none, full: true, test_selector: "enterprise-contract-global-expiration-banner")) do |component| %>
    <%= banner_message %>

    <% component.with_action_content do %>
      <%= render Primer::Beta::Button.new(size: :medium, scheme: button_scheme, tag: :a, href: "https://github.com/renewals-help") do %>
        Contact Sales
      <% end %>

      <%= render Primer::Beta::Button.new(size: :medium, scheme: :secondary, tag: :a, ml: 2, href: billing_renew_enterprise_path(@business)) do %>
        Renew now
      <% end %>
    <% end %>
  <% end %>
</section>
