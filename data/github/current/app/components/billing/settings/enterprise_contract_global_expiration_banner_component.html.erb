<section aria-label="<%= section_label.to_s.capitalize %>">
  <%= render(Primer::Alpha::Banner.new(icon: :alert, scheme: flash_scheme, dismiss_scheme: :none, full: true, test_selector: "enterprise-contract-global-expiration-banner")) do |component| %>
    <%= banner_message %>

    <% component.with_action_content do %>
      <%= render Primer::Beta::Button.new(size: :medium, scheme: button_scheme, tag: :a, href: "/renewals-help", test_selector: "enterprise-renew-contact-sales-button", data: { **click_tracking_attributes(cta: "contact_sales") }) do %>
        Contact sales
      <% end %>

      <% if business.sales_managed_subscription_self_serve_eligible? %>
        <%= render Primer::Beta::Button.new(size: :medium, scheme: :secondary, tag: :a, ml: 2, href: renew_button_path, test_selector: "enterprise-renew-button", data: { **click_tracking_attributes(cta: "renew") }) do %>
          <%= renew_button_text %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
