<% if render? %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, mb: 3)) do %>
    <%= render(Primer::Beta::Text.new(tag: :h2, font_size: 4, font_weight: :bold)) { "Billing" } %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :default, mb: 3)) do |component| %>
    <% component.with_row(scheme: :default) do %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :space_around, align_items: :center, flex: :auto, direction: :row)) do %>
        <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
          <%= render(Primer::Beta::Text.new(tag: :span, mb: 1, font_weight: :bold)) do %>
            <%= policy[:title] %>
            <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2)) { "Preview" }  if @preview %>
          <% end %>
          <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 3, color: :muted)) do %>
            <%= policy[:description] %>
            <% if link_path && link_text %>
              <%= render(Primer::Beta::Link.new(href: link_path, classes: "Link--inTextBlock")) { link_text } %>
            <% end %>
          <% end %>
        <% end %>

        <% if @disabled %>
          <%= render Primer::Beta::Button.new(tag: :summary, disabled: true) do %>
            <span data-menu-button <%= test_selector "cfb-policies-overages-feature-locked"%>><%= current_label %></span>
          <% end %>
        <% else %>
          <% unless @is_multi_select_enabled %>
            <%= render Primer::Alpha::ActionMenu.new(
                        select_variant: :single,
                        anchor_align: :end,
                        show_dividers: true,
                        dynamic_label: true,
                        anchor_side: :outside_bottom,
                        size: :auto, # needed so the menu won't scrol vertically
                        overlay_arguments: {
                          style: "width:min(320px, 100vw - 2rem)"
                        }, # used to set the width of the menu to the same as size: small
                      ) do |menu|
                menu.with_show_button do |button|
                  button.with_trailing_action_icon(icon: :"triangle-down")
                  "Select a policy"
                end

                policy[:options].each do |menu_item|
                  next if menu_item.key?(:is_available) && !menu_item[:is_available]
                  menu.with_item(
                    label: menu_item[:label],
                    href: submit_path(menu_item[:value]),
                    form_arguments: {
                      method: :put,
                      inputs: [{
                        name: menu_item[:label],
                        value: menu_item[:value]
                      }],
                    },
                    active: menu_item[:checked?],
                  ) do |item|
                    item.with_description.with_content(menu_item[:description])
                  end
                  menu.with_divider unless menu_item[:label] == policy[:options].last[:label]
                end
              end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if @is_multi_select_enabled %>
      <div class="PolicyMultiSelectToggles">
        <% policy[:options].each do |option| %>
          <% next unless option[:is_available] %>
          <% component.with_row(scheme: :default, ml: 5) do %>
            <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, mb: 1)) do %>
              <%= render(Primer::Box.new(display: :inline_flex, justify_content: :space_between, flex: 1, direction: :column)) do %>
                <label for="toggle_<%= option[:value] %>">
                  <%= option[:label] %>
                </label>
                <%= render(Primer::Beta::Text.new(tag: :p, mb: 2, mr: 3, color: :muted)) do %>
                  <%= option[:description] %>
                <% end %>
              <% end %>
              <%= form_with url: multi_select_submit_path(value: option[:value], enabled: !option[:checked?]), class: "d-inline", method: :put, local: true do |f| %>
                <%= f.hidden_field :option, value: option[:value] %>
                <%= render(
                  Primer::Alpha::ToggleSwitch.new(
                    size: :small,
                    status_label_position: :start,
                    csrf_token: "",
                    id: "toggle_#{option[:value]}",
                    checked: option[:checked?],
                    aria: { label: option[:label] },
                    data: {
                      action: "click:copilot-business-settings-toggle#toggleSetting",
                      target: "copilot-business-settings-toggle.settingCheckbox",
                      checked: option[:checked?]
                    }
                  )
                ) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

  <% end %>
<% end %>
