<%= render_nothing_on_error do %>
  <section aria-label="Sales Tax Information Banner">
    <%= render Primer::Alpha::Banner.new(
      scheme: :warning,
      icon: :alert,
      border_radius: 0,
      name: "sales_tax_banner",
      test_selector: "sales-tax-banner"
    ) do |flash| %>
      <% if needs_to_validate_address? %>
        <strong><%= address_validation_required_title %></strong> <%= address_validation_required_text %>
        <a class="Link--inTextBlock" target="_blank" rel="noopener noreferrer" href="<%= sales_tax_changelog_link %>">Learn more about this change.</a>
        <% flash.with_action_content do %>
          <%= render Primer::Beta::Button.new(tag: :a, href: path_to_payment_page) do |button| %>
            Update billing
          <% end %>
        <% end %>
      <% elsif needs_sales_tax_change_notification? %>
        <%= sales_tax_change_notification_text %>
        <a class="Link--inTextBlock" target="_blank" rel="noopener noreferrer" href="<%= sales_tax_changelog_link %>">Learn more about this change.</a>
      <% end %>
    <% end %>
  </section>
<% end %>
