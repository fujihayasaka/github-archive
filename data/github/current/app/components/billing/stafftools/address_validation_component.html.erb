<hr class="bleed-flush">
<p>The button below validates the billing address for tax calculation purposes. This ensures the address is properly formatted for accurate tax computation.</p>
<%= form_tag validate_address_form_path, class: "d-flex flex-items-center", method: :put do %>
  <%= render Primer::Beta::Button.new(
    scheme: :danger,
    "data-disable-with": "Validating address",
    type: :submit
  ).with_content("Validate billing address") %>
<% end %>
