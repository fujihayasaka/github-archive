<div class="Box tmp-mt-3 tmp-mb-3">
  <div class="Box-header d-flex flex-items-center flex-justify-between">
    <h3 class="Box-title">Copilot Pooled Entitlement</h3>
    <%= form_tag refresh_form_path, method: :post do %>
      <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary) do %>Refresh<% end %>
    <% end %>
  </div>
  <div class="Box-body">
    <p>Captures the pooled entitlement amount in <code>billing-platform</code> which is calculated from the customers current CFB and CE license counts.</p>
    <% if error? %>
      <p class="flash flash-error"><%= error_message %></p>
    <% else %>
      <table class="width-full">
        <thead>
          <tr>
            <th class="text-left">Field</th>
            <th class="text-left">Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="text-bold">Discount target amount</td>
            <td><%= discount_target_amount %></td>
          </tr>
          <tr>
            <td class="text-bold">Discount state current amount</td>
            <td><%= discount_state_current_amount %></td>
          </tr>
          <tr>
            <td class="text-bold">Discount state target amount</td>
            <td><%= discount_state_target_amount %></td>
          </tr>
          <tr>
            <td class="text-bold">Discount fully applied?</td>
            <td><%= discount_state_fully_applied %></td>
          </tr>
        </tbody>
      </table>
      <div class="tmp-mt-3">
        <p class="text-bold mb-2">Reset current amount</p>
        <div class="d-flex flex-items-center">
          <%= form_tag reset_current_amount_form_path, method: :post, class: "tmp-mr-4" do %>
            <%= hidden_field_tag :current_amount, "0" %>
            <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, "data-confirm": "Are you sure you want to reset the pooled entitlement current amount to $0? This action cannot be undone.") do %>Reset to $0<% end %>
          <% end %>
          <span class="color-fg-muted tmp-mr-4">or</span>
          <%= form_tag reset_current_amount_form_path, method: :post, class: "d-flex flex-items-center" do %>
            <div class="tmp-mr-2">
              <%= text_field_tag :current_amount, nil, type: :number, step: "0.01", min: "0", class: "form-control", placeholder: "0.00", required: true, "aria-label": "Custom amount in dollars" %>
            </div>
            <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, "data-confirm": "Are you sure you want to reset the pooled entitlement current amount? This action cannot be undone.") do %>Set Custom Amount<% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
