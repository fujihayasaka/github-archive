<div class="Box Box--condensed">
  <% if header? || title %>
    <div class="Box-header d-flex flex-items-center">
      <% if header? %>
        <%= header %>
      <% else %>
        <h3 class="Box-title flex-auto"><%= title %></h3>
      <% end %>
    </div>
  <% end %>
  <% if coupons.empty? %>
    <div class="Box-row color-fg-muted"><%= empty_message %></div>
  <% else %>
    <% coupons.each do |coupon| %>
      <div class="Box-row">
        <%= link_to biztools_coupon_path(coupon.code), class: "Link--inTextBlock" do %>
          <%= coupon.code %>
          <span class="color-fg-muted">
            &ndash; <%= human_details(coupon) %>
          </span>
          <span class='float-right'><%= expiration(coupon) %></span>
        <% end %>
        <% if coupon.limit > 0 %>
          <%= render(Primer::Beta::ClipboardCopy.new(
            "aria-label": "Copy to clipboard",
            ml: 2, mr: 2, color: :muted,
            value: coupon.code,
            )) %>
        <% end %>
        <p class='small'>
          <% if single_use?(coupon) %>
            <% if (user = coupon.users.first) %>
              Used by
              <% if site_admin? %>
                <%= link_to(user.to_s, stafftools_user_path(user), class: "Link--inTextBlock") %>
              <% else %>
                <%= user.to_s %>
              <% end %>
            <% else %>
              <% if coupon.business_plus_only_coupon? %>
                Unused - <%= link_to("Trial", business_try_url(:code => coupon.code), class: "Link--inTextBlock") %>
              <% else %>
                Unused
              <% end %>
            <% end %>
          <% else %>
            <%= usage(coupon) %>
          <% end %>
        </p>
      </div>
    <% end %>
  <% end %>
</div>
<% if paginated? %>
  <div class="paginate-container tmp-mt-3">
    <%= helpers.will_paginate coupons, params: pagination_params %>
  </div>
<% end %>
