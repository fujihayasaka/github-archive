<div class="d-flex flex-items-center flex-justify-between">
  <div>
    <% if coupon.synced_to_zuora? %>
      <% if sync_errors.empty? %>
        <%= render(Primer::Beta::Label.new(scheme: :success, py: 1)) do %>
          <%= primer_octicon("check-circle", mr: 1, classes: "v-align-text-top") %> Product Catalog: synced
        <% end %>
      <% else %>
        <%= render(Primer::Beta::Label.new(scheme: :attention, py: 1)) do %>
          <%= primer_octicon("alert", mr: 1, classes: "v-align-text-top") %> Product Catalog: partially synced
        <% end %>
      <% end %>
    <% else %>
      <%= render(Primer::Beta::Label.new(scheme: :attention, py: 1)) do %>
        <%= primer_octicon("alert", mr: 1, classes: "v-align-text-top") %> Product Catalog: not synced yet
      <% end %>
    <% end %>


    <% if sync_errors.any? %>
      <% sync_errors.each do |cycle, detail| %>
        <div class="text-small color-fg-danger mt-2" <%= test_selector("zuora_detail_#{cycle}") %>>
          <%= render Primer::Beta::Octicon.new(icon: :alert, size: :small, color: :danger, mr: 1) %>
          <strong><%= cycle.humanize %>:</strong> <%= detail %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="flex-self-start">
    <%= form_tag biztools_coupon_zuora_sync_path(coupon), method: :post do %>
      <%= render(Primer::Beta::Button.new(size: :small, type: :submit, data: { disable_with: "Syncing..." })) do %>
        <%= primer_octicon("sync", mr: 1, classes: "v-align-text-top") %> Sync with Zuora
      <% end %>
    <% end %>
  </div>
</div>
