<adjacent-text-nodes-menu>
  <%= render Primer::Alpha::ActionMenu.new(align: :right) do |menu| %>
    <% menu.with_show_button(scheme: :link, classes: "color-text-white", aria: { label: "Adjacent Text Node Actions" }) do |b| %>
      <%= primer_octicon(:typography) %>
      <% b.with_tooltip(text: "Debug Adjacent Text Nodes") %>
    <% end %>
    <% menu.with_item(data: { "action": "click:adjacent-text-nodes-menu#highlight" }) do %>
      Highlight adjacent text nodes
    <% end %>
    <% menu.with_item(data: { "action": "click:adjacent-text-nodes-menu#merge" }) do %>
      Merge all adjacent text nodes
    <% end %>
  <% end %>
</adjacent-text-nodes-menu>
