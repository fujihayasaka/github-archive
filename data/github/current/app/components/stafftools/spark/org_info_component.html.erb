<div class="site-admin-box">
  <h4>
    <%= primer_octicon(:"sparkles-fill") %>
    <%= link_to "Spark", stafftools_user_spark_path(organization) %>
  </h4>
  <ul class="site-admin-detail-list">
    <li>
      <%= primer_octicon(:people) %>
      <%= link_to pluralize(users_with_sparks_count, "user"), stafftools_user_spark_path(organization) %> with Spark workbenches
    </li>
    <li>
      <%= primer_octicon(:project) %>
      <%= link_to pluralize(total_sparks_count, "total Spark workbench", "total Spark workbenches"), stafftools_user_spark_path(organization) %>
    </li>
    <li>
      <%= primer_octicon(:share) %>
      <%= pluralize(sparks_shared_to_org_count, "Spark workbench", "Spark workbenches") %> shared to this organization
    </li>
  </ul>
</div>
