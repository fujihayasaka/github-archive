<div class="site-admin-box">
  <h4>
    <%= primer_octicon(:"sparkles-fill") %>
    <%= link_to "Spark", stafftools_user_spark_path(user) %>
  </h4>
  <ul class="site-admin-detail-list">
    <li>
      <% if has_spark_access? %>
        <%= primer_octicon(:check, classes: "success") %>
      <% else %>
        <%= primer_octicon(:x, classes: "danger") %>
      <% end %>
      Spark access: <%= access_status %>
    </li>
    <li>
      <%= primer_octicon(:project) %>
      <%= link_to pluralize(total_spark_workbenches, "Spark workbench"), stafftools_user_spark_path(user) %>
    </li>
  </ul>
</div>
