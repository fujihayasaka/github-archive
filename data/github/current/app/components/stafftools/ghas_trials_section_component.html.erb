<%# GHAS Trials Section - Grouped management for both Secret Protection and Code Security trials %>
<%= render(Primer::Beta::BorderBox.new(mb: 4)) do |section| %>
  <% section.with_header do %>
    <%= content_tag(:h2, class: "Box-title", test_selector: "ghas-trial-section-title") do %>
      GHAS Trial Management
    <% end %>
  <% end %>

  <% section.with_row do %>
    <div class="d-flex flex-column">
      <%= content_tag(:div, class: "mb-4", test_selector: "secret-protection-trial") do %>
          <%= render Stafftools::GhasTrialManagementComponent.new(billable_entity: billable_entity, sku: secret_security_sku) %>
      <% end %>

      <%= content_tag(:div, class: "mb-4", test_selector: "code-security-trial") do %>
        <%= render Stafftools::GhasTrialManagementComponent.new(billable_entity: billable_entity, sku: code_security_sku) %>
      <% end %>
    </div>
  <% end %>
<% end %>
