<%# GHAS Trials Section - Management for all GHAS trial types %>
<%= render(Primer::Beta::BorderBox.new(mb: 4)) do |section| %>
  <% section.with_header do %>
    <%= content_tag(:h2, class: "Box-title", test_selector: "ghas-trial-section-title") do %>
      GHAS Trials
    <% end %>
  <% end %>

  <% section.with_row do %>
    <div class="d-flex flex-column">
      <%# Self-Serve GHAS Trial Management %>
      <%= content_tag(:div, class: "mb-4 pb-4 border-bottom", test_selector: "self-serve-ghas-trial") do %>
        <%= render Stafftools::GhasSelfServeTrialManagementComponent.new(billable_entity: billable_entity) %>
      <% end %>

      <%# Sales-Led Trials (Secret Protection and Code Security) %>
      <div class="mt-4">
        <%= content_tag(:div, class: "mb-4 pb-4 border-bottom", test_selector: "secret-protection-trial") do %>
            <%= render Stafftools::GhasTrialManagementComponent.new(billable_entity: billable_entity, sku: secret_security_sku) %>
        <% end %>

        <%= content_tag(:div, class: "mb-4", test_selector: "code-security-trial") do %>
          <%= render Stafftools::GhasTrialManagementComponent.new(billable_entity: billable_entity, sku: code_security_sku) %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
