<%# GHAS Trials Section - Management for all GHAS trial types %>
<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-4")) do |section| %>
  <% section.with_header do %>
    <%= content_tag(:h2, class: "Box-title", test_selector: "ghas-trial-section-title") do %>
      GHAS Trials
    <% end %>
  <% end %>

  <% section.with_row do %>
    <div class="d-flex flex-column">
      <% if billable_entity.is_a?(Business) %>
        <%# Self-Serve GHAS Trial Management (includes Per SKU trial management for Businesses) %>
        <%= content_tag(:div, test_selector: "self-serve-ghas-trial") do %>
          <%= render Stafftools::GhasSelfServeTrialManagementComponent.new(billable_entity: billable_entity) %>
        <% end %>
      <% else %>
        <%# Per-SKU trial management for non-Business entities (e.g., Organizations) %>
        <%= content_tag(:div, class: "tmp-mb-4 tmp-pb-4 border-bottom", test_selector: "secret-protection-trial") do %>
          <%= render Stafftools::GhasTrialManagementComponent.new(billable_entity: billable_entity, sku: secret_security_sku) %>
        <% end %>

        <%= content_tag(:div, test_selector: "code-security-trial") do %>
          <%= render Stafftools::GhasTrialManagementComponent.new(billable_entity: billable_entity, sku: code_security_sku) %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
