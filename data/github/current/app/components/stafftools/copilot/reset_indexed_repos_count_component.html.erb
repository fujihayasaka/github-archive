<% if show_component? %>
  <%= render(Primer::Beta::BorderBox.new(color: :muted, classes: "border-top-0")) do |component| %>
    <% component.with_body(style: "padding: 10px") do %>
      <div class="js-details-container Details">
        <div style="float: right;">
          <%= form_tag stafftools_user_copilot_reset_indexed_repos_count_path(copilot_user.user_object.display_login), method: :put do %>
            <%= render(Primer::Alpha::Dialog.new(
              title: "Reset Indexed Repositories Count",
              size: :xlarge,
              dialog_id: "copilot-indexed-repositories-count",
              align: :left,
            )) do |dialog| %>
              <% dialog.with_show_button(scheme: :danger, test_selector: "reset_indexed_repositories_button") do %>
                Reset Count
              <% end %>
              <% dialog.with_body do %>
                Reset the current count of indexed repositories for this user back to 0?
              <% end %>

              <% dialog.with_footer(show_divider: true) do %>
                <%= render(Primer::Beta::Button.new(id: "reset_btn", scheme: :danger, type: :submit)) do |c| %>
                  Reset
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <h4>Reset Indexed Repositories Count</h4>
        <p>
          This user is using <%= count %> of their quota of <%= quota %> indexed repositories. Reset the usage count back to 0.
        </p>
      </div>
    <% end %>
  <% end %>
<% end %>
