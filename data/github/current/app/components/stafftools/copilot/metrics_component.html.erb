<%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "tmp-mt-4")) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Metrics
    <% end %>
  <% end %>
  <% component.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2 width-full">
        <div class="d-flex flex-items-start flex-wrap" style="gap: 8px;">
          <%= form_tag stafftools_user_copilot_generate_activity_csv_path(copilot_organization.organization_object.display_login), :method => :post do %>
            <%= render(Primer::Beta::ButtonGroup.new) do |component| %>
              <% component.with_button(type: :submit, id: "copilot-activity-export-button", test_selector: "copilot-activity-export-button") do |button| %>
                <% button.with_leading_visual_icon(icon: :download) %>
                Export Organization Activity Details
              <% end %>
            <% end %>
          <% end %>
          <%= render(Primer::Beta::ButtonGroup.new) do |component| %>
            <% component.with_button(tag: :a, href: base_url + "?q=" + acceptances_by_language_query, target: "_blank") { "View Acceptances In App Insights" } %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
