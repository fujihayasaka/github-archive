<%= render(Primer::Alpha::Dialog.new(
  title: "Delete Copilot Seat Assignment",
  subtitle: "",
  id: "delete-copilot-seat-assignment-#{copilot_seat_assignment.id}",
  size: :xlarge,
)) do |d| %>
  <% d.with_show_button(scheme: :link, title: "Cancel") do %>
    <%= render(Primer::Beta::Octicon.new(:"x-circle", color: :danger, scheme: :danger)) %>
  <% end %>
  <% d.with_body do %>
    <br>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger)) do %>
      This will automatically delete the <%= copilot_seat_assignment.seats.size %> seats associated with this <%= copilot_seat_assignment.assignable_type %> seat assignment.
      Users with these seats will lose access to Copilot as soon as their seat is deleted. The background job may take a few minutes to complete.
    <% end %>
    <% if copilot_seat_assignment.pending_cancellation? %>
        <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
          This seat assignment is already scheduled to be cancelled at the end of the billing period.
        <% end %>
    <% end %>
    <% unless user_assignment? %>
      <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
        This is a non-User (<%= copilot_seat_assignment.assignable_type %>) seat assignment. Cancelling will affect all <%= copilot_seat_assignment.seats.size %> associated seats.
      <% end %>
    <% end %>
  <% end %>
  <% d.with_footer do %>
    <% unless copilot_seat_assignment.pending_cancellation? %>
      <%= form_tag schedule_form_url, method: :put do %>
        <%= hidden_field_tag :seat_assignment_id, copilot_seat_assignment.id, id: "cancel_seat_assignment_schedule_id_#{copilot_seat_assignment.id}" %>
        <%= hidden_field_tag :organization_id, copilot_seat_assignment.organization_id %>
        <%= hidden_field_tag :operation, "cancel" %>
        <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit)) { "Schedule Cancellation for #{owner_billing_cycle_end}" } %>
      <% end %>
    <% end %>
    <%= form_tag cancel_form_url, method: :delete do %>
      <%= hidden_field_tag :seat_assignment_id, copilot_seat_assignment.id, id: "cancel_seat_assignment_id_#{copilot_seat_assignment.id}" %>
      <%= hidden_field_tag :organization_id, copilot_seat_assignment.organization_id %>
      <%= render(Primer::Beta::Button.new(scheme: :danger, type: :submit)) { "Cancel Immediately" } %>
    <% end %>
  <% end %>
<% end %>
