<% if show_component? %>
  <%= render(Primer::Beta::BorderBox.new(color: :muted, classes: "border-top-0")) do |component| %>
    <% component.with_body(style: "padding: 10px") do %>
      <div class="js-details-container Details">
        <div style="float: right;">
          <%= form_tag stafftools_user_copilot_cancel_and_refund_path(copilot_user.user_object.display_login, subscription_type: :pro_plus), method: :put, data: { turbo: false } do %>
            <%= render(Primer::Alpha::Dialog.new(
              title: "Cancel and Refund Copilot Pro+",
              size: :xlarge,
              dialog_id: "copilot-pro-plus-cancel",
              align: :left,
            )) do |dialog| %>
              <% dialog.with_show_button(scheme: :danger, test_selector: "cancel_and_refund_pro_plus_button") do %>
                Cancel and Refund
              <% end %>
              <% dialog.with_body do %>
                Canceling this user's Copilot Pro+ subscription will immediately remove their access to Copilot Pro+ and refund them for the remaining days in their billing cycle.
              <% end %>

              <% dialog.with_footer(show_divider: true) do %>
                <%= render(Primer::Beta::Button.new(id: "pro_plus_cancel_btn", scheme: :danger, type: :submit)) do |c| %>
                  Cancel and Refund
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <h4>Cancel and Refund Copilot Pro+</h4>
        <p>
          Canceling this user's Copilot Pro+ subscription will immediately remove their access to Copilot Pro+ and refund them for the remaining days in their billing cycle.
        </p>
      </div>
    <% end %>
  <% end %>
<% end %>
