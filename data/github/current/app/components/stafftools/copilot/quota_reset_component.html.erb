<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Quota
    <% end %>
  <% end %>

  <% if limited_user&.present? %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Subscribed?",
        limited_user.subscribed?,
        "Has this user subscribed to Copilot?"
      ) %>
    <% end %>
  <% end %>

  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Reset Date",
      copilot_user.quota_reset_date,
      "Date this user's Copilot quota will reset"
    ) %>
  <% end %>

  <% if copilot_user.consumptive_user? %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Overages Enabled?",
        public_user.overages_enabled?,
        "Can this user incur overages for premium usage?"
      ) %>
    <% end %>
  <% end %>

  <% if copilot_user.has_multi_access? %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Billable Customer",
        Customer.find_by(id: public_user.billable_customer_ids.first)&.name || false,
        "Has this user selected a billable customer for premium usage?"
      ) %>
    <% end %>
  <% end %>

  <% component.with_row do %>
    <%= primer_form_with(url: stafftools_user_copilot_update_quotas_path(copilot_user), method: :post) do |f| %>
      <% copilot_user.quota_snapshots.each do |feature, details| %>
        <% if can_access_free_feature?(feature) || can_access_premium_feature?(feature) %>
          <%= render(
            Primer::Alpha::TextField.new(
              name: "quotas[#{feature}]",
              label: "#{feature.titleize} Quota",
              value: details[:remaining],
              data: { test_selector: "quotas_#{feature}" },
            )
          ) %>
        <% end %>
      <% end %>
      <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, display: :inline, mr: 2, mt: 2, "aria-label": "Save Quotas") do %>
        Save quotas
      <% end %>
    <% end %>
  <% end %>
<% end %>
<br>
<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Quota Actions
    <% end %>
  <% end %>
  <% component.with_row do %>
    <% if limited_user&.present? %>
      <%= render(Primer::Beta::Button.new(
          scheme: :secondary,
          size: :medium,
          id: "quota_events",
          tag: :a,
          target: "_blank",
          href: data_dot_chat_quota_events_link
        )) { "View Chat Events" } %>
      <%= render(Primer::Beta::Button.new(
          scheme: :secondary,
          size: :medium,
          id: "quota_events",
          tag: :a,
          target: "_blank",
          href: data_dot_completions_quota_events_link
        )) { "View Completions Events" } %>
        <%= render(Primer::Beta::Button.new(
            scheme: :secondary,
            size: :medium,
            id: "free_over_quota_events",
            tag: :a,
            target: "_blank",
            href: data_dot_over_quota_events_link
          )) { "View OverQuota Events" } %>
    <% else %>
      <%= render(Primer::Beta::Button.new(
          scheme: :secondary,
          size: :medium,
          id: "quota_events",
          tag: :a,
          target: "_blank",
          href: data_dot_chat_quota_events_link
        )) { "View Chat Events" } %>
      <%= render(Primer::Beta::Button.new(
          scheme: :secondary,
          size: :medium,
          id: "premium_quota_events",
          tag: :a,
          target: "_blank",
          href: data_dot_premium_events_link
        )) { "View Premium Events" } %>
      <%= render(Primer::Beta::Button.new(
          scheme: :secondary,
          size: :medium,
          id: "premium_quota_events",
          tag: :a,
          target: "_blank",
          href: data_dot_billing_usage_link
        )) { "View Premium Billing Usage" } %>
    <% end %>
    <%= render(Primer::Beta::Button.new(
        scheme: :secondary,
        size: :medium,
        id: "quota_processed_events",
        tag: :a,
        target: "_blank",
        href: data_dot_quota_processed_events_link
      )) { "View Quota Processed Events" } %>
  <% end %>
<% end %>
<br>
