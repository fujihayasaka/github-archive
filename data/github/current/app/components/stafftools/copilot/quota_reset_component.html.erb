<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Quota
    <% end %>
  <% end %>

  <% if limited_user&.present? %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Subscribed?",
        limited_user.subscribed?,
        "Has this user subscribed to Copilot?"
      ) %>
    <% end %>
  <% end %>

  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Reset Date",
      copilot_user.quota_reset_date,
      "Date this user's Copilot quota will reset"
    ) %>
  <% end %>

  <% component.with_row do %>
    <%= primer_form_with(url: stafftools_user_copilot_update_quotas_path(copilot_user), method: :post) do |f| %>
      <% copilot_user.quota_snapshots.each do |feature, details| %>
        <% if can_access_free_feature?(feature) || can_access_premium_feature?(feature) %>
          <%= render(
            Primer::Alpha::TextField.new(
              name: "quotas[#{feature}]",
              label: "#{feature.titleize} Quota",
              value: details[:remaining],
              data: { test_selector: "quotas_#{feature}" },
            )
          ) %>
        <% end %>
      <% end %>
      <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, display: :inline, mr: 2, mt: 2, "aria-label": "Save Quotas") do %>
        Save quotas
      <% end %>
    <% end %>
  <% end %>

  <% if limited_user&.present? %>
    <% component.with_footer(scheme: :warning) do %>
      <%= render(Primer::Beta::Button.new(
          scheme: :secondary,
          size: :medium,
          id: "free_quota_events",
          tag: :a,
          target: "_blank",
          href: data_dot_quota_events_link
        )) { "View Free Quota Events" } %>
      <%= render(Primer::Beta::Button.new(
          scheme: :secondary,
          size: :medium,
          id: "free_quota_processed_events",
          tag: :a,
          target: "_blank",
          href: data_dot_quota_processed_events_link
        )) { "View Free Quota Processed Events" } %>
      <%= render(Primer::Beta::Button.new(
          scheme: :secondary,
          size: :medium,
          id: "free_over_quota_events",
          tag: :a,
          target: "_blank",
          href: data_dot_over_quota_events_link
        )) { "View Free OverQuota Events" } %>
      <%= form_tag stafftools_user_copilot_unsubscribe_limited_user_path(copilot_user),
        :method => :post,
        name: "copilot-free-unsubscribe",
        class: "d-inline-block" do %>
        <%= render(Primer::Beta::Button.new(
          scheme: :danger,
          size: :medium,
          id: "cancel_copilot_free",
          tag: :button,
          type: :submit,
        )) { "Unsubscribe" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<br>
