<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% tbb_result, err = copilot_user.calculate_use_token_based_billing %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Quota
    <% end %>
  <% end %>

  <% if limited_user&.present? %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Subscribed?",
        limited_user.subscribed?,
        "Has this user subscribed to Copilot?"
      ) %>
    <% end %>
  <% end %>

  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Reset Date",
      copilot_user.quota_reset_date,
      "Date this user's Copilot quota will reset"
    ) %>
  <% end %>

  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Token Based Billing",
      tbb_result || err.presence,
      "Indicates whether the user should be billed via Token Based Billing.",
      label_scheme: tbb_result ? :success : :danger
    ) %>
  <% end %>

  <% if copilot_user.consumptive_user? %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Overages Enabled?",
        public_user.overages_enabled?,
        "Can this user incur overages for premium usage?"
      ) %>
    <% end %>
  <% end %>

  <% if copilot_user.has_multi_access? %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Billable Customer",
        Customer.find_by(id: public_user.billable_customer_ids.first)&.name || false,
        "Has this user selected a billable customer for premium usage?"
      ) %>
    <% end %>
  <% end %>

  <% component.with_row do %>
    <%= primer_form_with(url: stafftools_user_copilot_update_quotas_path(copilot_user), method: :post) do |f| %>
      <% copilot_user.quota_snapshots.each do |feature, details| %>
        <% if can_access_free_feature?(feature) || can_access_premium_feature?(feature) %>
          <%= render(
            Primer::Alpha::TextField.new(
              name: "quotas[#{feature}]",
              label: "#{feature.titleize} Quota",
              value: details[:quota_remaining],
              data: { test_selector: "quotas_#{feature}" },
            )
          ) %>
        <% end %>
      <% end %>
      <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, display: :inline, mr: 2, mt: 2, "aria-label": "Save Quotas") do %>
        Save quotas
      <% end %>
    <% end %>
  <% end %>

  <% interval_snapshots = copilot_user.interval_snapshots %>
  <% if interval_snapshots.any? %>
    <% interval_snapshots.each do |feature, details| %>
      <% component.with_row do %>
        <div class="d-flex flex-column" style="width: 100%;">
          <span class="text-bold mb-1" <%= tag.attributes(data: { test_selector: "interval_#{feature}_label" }) %>><%= feature.titleize %></span>
          <span class="color-fg-muted f6 mb-1">Percent remaining</span>
          <% pct = details[:percent_remaining].to_f %>
          <% bar_color = pct > 50 ? "color-bg-success-emphasis" : (pct >= 20 ? "color-bg-attention-emphasis" : "color-bg-danger-emphasis") %>
          <div class="d-flex flex-items-center mb-1" style="width: 100%;">
            <div class="rounded-2 overflow-hidden mr-2" style="flex: 1; height: 8px; background: var(--bgColor-neutral-muted, var(--color-neutral-muted));">
              <div class="<%= bar_color %> rounded-2" style="width: <%= [pct, 100].min %>%; height: 100%;" <%= tag.attributes(data: { test_selector: "interval_#{feature}_bar" }) %>></div>
            </div>
            <span class="f6 text-bold" style="min-width: 45px; text-align: right;" <%= tag.attributes(data: { test_selector: "interval_#{feature}_remaining" }) %>><%= format("%.1f%%", pct) %></span>
          </div>
          <% if details[:quota_reset_at].is_a?(Integer) && details[:quota_reset_at] > 0 %>
            <span class="color-fg-muted f6" <%= tag.attributes(data: { test_selector: "interval_#{feature}_reset_at" }) %>>Resets at: <%= Time.at(details[:quota_reset_at]).utc.strftime("%Y-%m-%d %H:%M UTC") %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <% component.with_row do %>
      <%= primer_form_with(url: stafftools_user_copilot_reset_usage_intervals_path(copilot_user), method: :post) do |f| %>
        <p class="mb-2 color-fg-muted">
          Reset the immediate (5h) and extended (7d) usage interval counters. This will clear all accumulated usage and restart the windows.
        </p>
        <%= render Primer::Beta::Button.new(scheme: :danger, type: :submit, display: :inline, mt: 2, "aria-label": "Reset Usage Intervals", data: { test_selector: "reset_usage_intervals_button" }) do %>
          Reset Usage Intervals
        <% end %>
      <% end %>
    <% end %>
  <% elsif copilot_user.consumptive_user? && copilot_user.use_token_based_billing? %>
    <% component.with_row do %>
      <div class="d-flex flex-items-center" <%= tag.attributes(data: { test_selector: "no_interval_snapshots_message" }) %>>
        <%= render(Primer::Beta::Octicon.new(icon: :info, color: :muted, mr: 2)) %>
        <span class="color-fg-muted">No usage interval data available at this time. Try refreshing the page in a few moments.</span>
      </div>
    <% end %>
  <% end %>
<% end %>
<br>
<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Quota Actions
    <% end %>
  <% end %>
  <% component.with_row do %>
    <div class="mb-2">
      Limited user quota events

      <% if limited_user&.present? %>
        <%= render Primer::Beta::Label.new(tag: :div, scheme: :success) do %>
          Active
        <% end %>
      <% end %>
    </div>
    <%= render(Primer::Beta::Button.new(
      scheme: :secondary,
      size: :medium,
      id: "quota_events",
      tag: :a,
      target: "_blank",
      href: data_dot_chat_quota_events_link
    )) { "View Chat Events" } %>
    <%= render(Primer::Beta::Button.new(
      scheme: :secondary,
      size: :medium,
      id: "quota_processed_events",
      tag: :a,
      target: "_blank",
      href: data_dot_quota_processed_events_link
    )) { "View Quota Processed Events" } %>
    <%= render(Primer::Beta::Button.new(
      scheme: :secondary,
      size: :medium,
      id: "quota_events",
      tag: :a,
      target: "_blank",
      href: data_dot_completions_quota_events_link
    )) { "View Completions Events" } %>
    <%= render(Primer::Beta::Button.new(
      scheme: :secondary,
      size: :medium,
      id: "free_over_quota_events",
      tag: :a,
      target: "_blank",
      href: data_dot_over_quota_events_link
    )) { "View OverQuota Events" } %>

    <hr>

    <div class="mb-2">
      Premium user quota events

      <% if limited_user.nil? %>
        <%= render Primer::Beta::Label.new(tag: :div, scheme: :success) do %>
          Active
        <% end %>
      <% end %>
    </div>
    <%= render(Primer::Beta::Button.new(
      scheme: :secondary,
      size: :medium,
      id: "quota_events",
      tag: :a,
      target: "_blank",
      href: data_dot_chat_quota_events_link
    )) { "View Chat Events" } %>
    <%= render(Primer::Beta::Button.new(
      scheme: :secondary,
      size: :medium,
      id: "quota_processed_events_premium",
      tag: :a,
      target: "_blank",
      href: data_dot_quota_processed_events_link
    )) { "View Quota Processed Events" } %>
    <%= render(Primer::Beta::Button.new(
      scheme: :secondary,
      size: :medium,
      id: "premium_quota_events",
      tag: :a,
      target: "_blank",
      href: data_dot_premium_events_link
    )) { "View Premium Events" } %>
    <%= render(Primer::Beta::Button.new(
      scheme: :secondary,
      size: :medium,
      id: "premium_billing_usage",
      tag: :a,
      target: "_blank",
      href: data_dot_billing_usage_link
    )) { "View Premium Billing Usage" } %>
  <% end %>
<% end %>
<br>
