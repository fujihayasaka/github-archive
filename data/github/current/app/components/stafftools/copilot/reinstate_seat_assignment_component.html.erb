<%= render(Primer::Alpha::Dialog.new(
    title: "Reinstate Access for Copilot Seat Assignment",
    subtitle: "",
    id: "reinstate-copilot-seat-assignment-#{copilot_seat_assignment.id}",
    size: :xlarge,
)) do |d| %>
  <% d.with_show_button(scheme: :link, title: "Reinstate Access") do %>
    <%= render(Primer::Beta::Octicon.new(:unlock, color: :attention), aria: { label: "Show options", hidden: false }) %>
  <% end %>
  <% d.with_body do %>
    <br>
    <% if !copilot_seat_assignment.access_revoked? %>
      <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
        This seat assignment already has access, clicking this button will do nothing.
      <% end %>
    <% end %>
    <%= render(Primer::Alpha::Banner.new(scheme: :default)) do %>
      This will queue a background job that will remove the access_revoked_at date for the seat assignment. The background job may take a few minutes to complete.
    <% end %>
  <% end %>
  <% d.with_footer do %>
    <%= form_tag stafftools_copilot_seat_assignment_path(copilot_seat_assignment), method: :put do %>
        <%= hidden_field_tag :seat_assignment_id, copilot_seat_assignment.id, id: "reinstate_seat_assignment_id_#{copilot_seat_assignment.id}" %>
        <%= hidden_field_tag :organization_id, organization.id, id: "reinstate_organization_id_#{copilot_seat_assignment.id}" %>
        <%= hidden_field_tag :job, "reinstate_user" %>
        <%= render(Primer::Beta::Button.new(scheme: :danger, type: :submit)) { "Reinstate" } %>
    <% end %>
  <% end %>
<% end %>
