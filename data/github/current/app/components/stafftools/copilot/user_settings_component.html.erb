<% if current_user && current_user.feature_flag_enabled?(:copilot_stafftools_settings_refactor, default: false) %>
  <%= render Stafftools::Copilot::SettingsComponent.new(@configurable) do |component| %>
    <% if has_cfi_access %>
      <% component.with_prepended_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Copilot Visibility",
          @configurable.show_copilot_enabled? ? "Enabled" : "Disabled",
          "Whether Copilot functionality appears in the navigation bar, search, and dashboard (Default Enabled)",
          label_scheme: @configurable.show_copilot_enabled? ? :success : :danger
        ) %>
      <% end %>
      <% component.with_prepended_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Telemetry",
          @configurable.telemetry_enabled? ? "Enabled" : "Disabled",
          "Whether this user has allowed GitHub to use their code snippets for product improvements (Default Enabled)",
          label_scheme: @configurable.telemetry_enabled? ? :success : :danger
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, mb: 4)) do |component| %>
    <% component.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Copilot Settings
      <% end %>
    <% end %>
    <% if has_cfi_access %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Copilot Visibility",
          @configurable.show_copilot_enabled? ? "Enabled" : "Disabled",
          "Whether Copilot functionality appears in the navigation bar, search, and dashboard (Default Enabled)",
          label_scheme: @configurable.show_copilot_enabled? ? :success : :danger
        ) %>
      <% end %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Telemetry",
          @configurable.telemetry_enabled? ? "Enabled" : "Disabled",
          "Whether this user has allowed GitHub to use their code snippets for product improvements (Default Enabled)",
          label_scheme: @configurable.telemetry_enabled? ? :success : :danger
        ) %>
      <% end %>
    <% end %>
    <% component.with_row do %>
      <% text = "GitHub.com Copilot Features" %>
      <% unless dotcom_chat_enabled? %>
        <% text += " #{policy_blocked_by(:dotcom_chat)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_IN_DOTCOM,
        label(dotcom_chat_enabled?, configurable.dotcom_chat_disabled?),
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: label_scheme(label(dotcom_chat_enabled?, configurable.dotcom_chat_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Whether this user has access to Copilot Chat in IDEs" %>
      <% unless chat_enabled? %>
        <% text += " #{policy_blocked_by(:chat_enabled)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_CHAT_IN_IDE,
        label(chat_enabled?, configurable.chat_disabled?),
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: label_scheme(label(chat_enabled?, configurable.chat_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "GitHub.com preview features" %>
      <% unless dotcom_chat_enabled? %>
        <% text += " #{policy_blocked_by(:dotcom_chat)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::DOTCOM_PREVIEW_FEATURES,
        beta_features_github_chat_enabled? ? "Enabled" : "Disabled",
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: beta_features_github_chat_enabled? ? :success : :danger
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Editor Preview Features" %>
      <% if !editor_preview_features_enabled? %>
        <% text += " #{policy_blocked_by(:editor_preview_features)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::EDITOR_PREVIEW_FEATURES,
        label(editor_preview_features_enabled?, public_user.editor_preview_features_disabled?),
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: label_scheme(label(editor_preview_features_enabled?, public_user.editor_preview_features_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Agent Mode" %>
      <% if !agent_mode_enabled? %>
        <% text += " #{policy_blocked_by(:agent_mode)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::AGENT_MODE,
        label(agent_mode_enabled?, public_user.agent_mode_disabled?),
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: label_scheme(label(agent_mode_enabled?, public_user.agent_mode_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Whether this user has enabled Copilot to auto review PRs they authored in their repos" %>
      <% unless automatic_code_review_enabled? %>
        <% text += " #{policy_blocked_by(:automatic_code_review)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::AUTOMATIC_CODE_REVIEW,
        automatic_code_review_enabled? ? "Enabled" : "Disabled",
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: automatic_code_review_enabled? ? :success : :danger
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Whether this user has access to Copilot Chat in GitHub Mobile" %>
      <% unless mobile_chat_enabled? %>
        <% text += " #{policy_blocked_by(:mobile_chat)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_CHAT_IN_MOBILE,
        mobile_chat_enabled? ? "Enabled" : "Disabled",
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: mobile_chat_enabled? ? :success : :danger
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Whether this user has access to Copilot in the CLI" %>
      <% unless cli_enabled? %>
        <% text += " #{policy_blocked_by(:cli)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::CLI_UI_NAME,
        label(cli_enabled?, configurable.cli_disabled?),
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: label_scheme(label(cli_enabled?, configurable.cli_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Whether this user has access to Copilot in GitHub Desktop" %>
      <% unless desktop_enabled? %>
        <% text += " #{policy_blocked_by(:desktop)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_DESKTOP,
        label(desktop_enabled?, configurable.desktop_disabled?),
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: label_scheme(label(desktop_enabled?, configurable.desktop_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Whether this user has access to Copilot Extensions" %>
      <% unless copilot_extensions_enabled? %>
        <% text += " #{policy_blocked_by(:copilot_extensions)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_EXTENSION,
        label(copilot_extensions_enabled?, configurable.copilot_extensions_disabled?),
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: label_scheme(label(copilot_extensions_enabled?, configurable.copilot_extensions_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Whether Copilot can access Bing for this user" %>
      <% unless @configurable.bing_github_chat_enabled? %>
        <% text += " #{policy_blocked_by(:bing_github_chat)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_BING_ACCESS,
        bing_github_chat_enabled? ? "Allow" : "Block",
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: bing_github_chat_enabled? ? :success : :danger
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "User feedback opt in" %>
      <% unless dotcom_chat_enabled? %>
        <% text += " #{policy_blocked_by(:dotcom_chat)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "User feedback collection",
        user_feedback_opt_in_enabled? ? "Enabled" : "Disabled",
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: user_feedback_opt_in_enabled? ? :success : :danger
      ) %>
    <% end %>
    <% component.with_row do %>
      <% text = "Whether this user has allowed or blocked suggestions matching public code" %>
      <% unless @configurable.allow_public_code_suggestions? %>
        <% text += " #{policy_blocked_by(:public_code_suggestions)}" %>
      <% end %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_PUBLIC_CODE_SUGGESTIONS,
        public_code_suggestions_label,
        text.html_safe, # rubocop:disable Rails/OutputSafety
        label_scheme: public_code_suggestions_label_scheme(public_code_suggestions_label)
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_CONTENT_EXCLUSION,
        content_exclusions_enabled? ? "Enabled" : "Disabled",
        "Is Content exclusions active for this user?",
        label_scheme: content_exclusions_enabled? ? :success : :danger
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_O1,
        label(o1_enabled?, public_user.o1_disabled?),
        "Can users use the o1 family of models in Copilot?",
        label_scheme: label_scheme(label(o1_enabled?, public_user.o1_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_O3,
        label(o3_enabled?, public_user.o3_disabled?),
        "Can users use the o3 family of models in Copilot?",
        label_scheme: label_scheme(label(o3_enabled?, public_user.o3_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_O_FF,
        label(o_ff_enabled?, public_user.o_ff_disabled?),
        "Can users use the #{Copilot::COPILOT_O_FF} in Copilot?",
        label_scheme: label_scheme(label(o_ff_enabled?, public_user.o_ff_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_OFO,
        label(public_user.ofo_enabled?, public_user.ofo_disabled?),
        "Can user use the #{Copilot::COPILOT_OFO} model in Copilot?",
        label_scheme: label_scheme(label(public_user.ofo_enabled?, public_user.ofo_disabled?),)
