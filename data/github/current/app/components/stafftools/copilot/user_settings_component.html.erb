        label(public_user.grok_code_enabled?, public_user.grok_code_disabled?),
        "Can user use the #{Copilot::COPILOT_GROK_CODE} model in Copilot?",
        label_scheme: label_scheme(label(public_user.grok_code_enabled?, public_user.grok_code_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
