          label_scheme: @configurable.dashboard_entry_point_enabled? ? :success : :danger
      ) %>
    <% end %>
    <% if current_user && current_user.feature_flag_enabled_or_raise?(:copilot_overages) # rubocop:disable GitHub/FeatureManagement/NoVexiActorFeatureFlagEnabledOrRaiseUsage %>
