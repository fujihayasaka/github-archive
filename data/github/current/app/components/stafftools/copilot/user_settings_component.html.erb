    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_O_FM,
        label(public_user.o_fm_enabled?, public_user.o_fm_disabled?),
        "Can user use the #{Copilot::COPILOT_O_FM} model in Copilot?",
        label_scheme: label_scheme(label(public_user.o_fm_enabled?, public_user.o_fm_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_O_T,
        label(public_user.o_t_enabled?, public_user.o_t_disabled?),
        "Can user use the #{Copilot::COPILOT_O_T} model in Copilot?",
        label_scheme: label_scheme(label(public_user.o_t_enabled?, public_user.o_t_disabled?),)
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_OFCT,
        label(public_user.ofct_enabled?, public_user.ofct_disabled?),
        "Can user use the #{Copilot::COPILOT_OFCT} model in Copilot?",
        label_scheme: label_scheme(label(public_user.ofct_enabled?, public_user.ofct_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_A_CHAT,
        label(a_chat_enabled?, public_user.a_chat_disabled?),
        "Can the user use the latest Claude 3.5 Sonnet model from Anthropic?",
        label_scheme: label_scheme(label(a_chat_enabled?, public_user.a_chat_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_A_F,
        label(a_f_enabled?, public_user.a_f_disabled?),
        "Can the user use the latest Claude 3.7 Sonnet model from Anthropic?",
        label_scheme: label_scheme(label(a_f_enabled?, public_user.a_f_disabled?),)
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_AFOS,
        label(public_user.afos_enabled?, public_user.afos_disabled?),
        "Can user use the #{Copilot::COPILOT_AFOS} model in Copilot?",
        label_scheme: label_scheme(label(public_user.afos_enabled?, public_user.afos_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_AL,
        label(public_user.al_enabled?, public_user.al_disabled?),
        "Can user use the #{Copilot::COPILOT_AL} model in Copilot?",
        label_scheme: label_scheme(label(public_user.al_enabled?, public_user.al_disabled?))
      ) %>
    <% end %>
    <% if current_user && current_user.feature_flag_enabled_or_raise?(:copilot_o_f) # rubocop:disable GitHub/FeatureManagement/NoVexiActorFeatureFlagEnabledOrRaiseUsage %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          Copilot::COPILOT_O_F,
          label(o_f_enabled?, public_user.o_f_disabled?),
          "TEMP O_F",
          label_scheme: label_scheme(label(o_f_enabled?, public_user.o_f_disabled?),)
        ) %>
      <% end %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_G_CHAT,
        label(g_chat_enabled?, public_user.g_chat_disabled?),
        "Can users use the Gemini 2.0 Flash model in Copilot?",
        label_scheme: label_scheme(label(g_chat_enabled?, public_user.g_chat_disabled?),)
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_G_TF,
        label(public_user.g_tf_enabled?, public_user.g_tf_disabled?),
        "Can user use the #{Copilot::COPILOT_G_TF} model in Copilot?",
        label_scheme: label_scheme(label(public_user.g_tf_enabled?, public_user.g_tf_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_GTFF,
        label(public_user.g_tf_enabled?, public_user.g_tf_disabled?),
        "Can user use the #{Copilot::COPILOT_GTFF} model in Copilot?",
        label_scheme: public_user.gtff_enabled? ? :success : :danger
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_OBMB,
        label(public_user.obmb_enabled?, public_user.obmb_disabled?),
        "Can user use the #{Copilot::COPILOT_OBMB} model in Copilot?",
        label_scheme: label_scheme(label(public_user.obmb_enabled?, public_user.obmb_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_OBMW,
        label(public_user.obmw_enabled?, public_user.obmw_disabled?),
        "Can user use the #{Copilot::COPILOT_OBMW} model in Copilot?",
        label_scheme: label_scheme(label(public_user.obmw_enabled?, public_user.obmw_disabled?))
      ) %>
    <% end %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
