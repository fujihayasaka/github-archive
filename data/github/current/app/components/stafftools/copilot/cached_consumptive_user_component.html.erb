<%= render(Primer::Beta::BorderBox.new(padding: :condensed, mb: 4)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Cached Consumptive User (Limiter)
    <% end %>

    <% component.with_row do %>
      <% if consumptive_user.present? && !consumptive_user.empty? %>
        <%= render Primer::Box.new(
          p: 3,
          bg: :subtle,
          border: true,
          border_radius: 2
        ) do %>
          <pre style="margin: 0; white-space: pre-wrap; font-family: monospace;"><%= JSON.pretty_generate(consumptive_user) %></pre>
        <% end %>
      <% else %>
        <%= render Primer::Box.new(
          p: 3,
          bg: :subtle,
          border: true,
          border_radius: 2
        ) do %>
          <p style="margin: 0; color: #656d76; font-style: italic;">
            No consumptive user data available. This may indicate:
          </p>
          <ul style="margin: 8px 0 0 20px; color: #656d76;">
            <li>User has no analytics tracking ID</li>
            <li>Service is temporarily unavailable</li>
            <li>User has no quota data</li>
          </ul>
        <% end %>
      <% end %>
      <br>
      <%= primer_form_with(url: stafftools_user_copilot_refresh_quotas_cache_path(copilot_user), method: :post) do |f| %>
        <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, "aria-label": "Refresh limiter cache") do %>
          Refresh limiter cache
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
