  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, mb: 4)) do |component| %>
    <% component.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Copilot Settings
      <% end %>
    <% end %>

    <%= prepended_rows.each do |row| %>
      <% component.with_row do %>
        <%= row %>
      <% end %>
    <% end %>

    <% policies.each do |policy| %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::SettingDetailComponent.new(
          policy_class: policy,
          copilot_entity: configurable,
        ) %>
      <% end %>
    <% end %>
  <% end %>

<% if configurable.feature_flag_enabled?(:copilot_model_registry_ui, default: false) && model_registry_models.any? %>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, mb: 4)) do |component| %>
    <% component.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Copilot Model Registry Settings
      <% end %>
    <% end %>

    <% model_registry_models.each do |model| %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::ModelPolicySettingDetailComponent.new(
          model: model,
          copilot_entity: configurable,
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
