<%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "tmp-mt-4")) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Cached Organization (Limiter)
    <% end %>

    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "PRU (Premium Request Usage)",
        pru_setting,
        "Premium Request Usage overage policy setting for Copilot (live from billing platform)",
        label_scheme: pru_label_scheme,
      ) %>
    <% end %>

    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "CCR Direct Org Billing (Allow members without a Copilot license to use Copilot code review in github.com)",
        ccr_direct_org_billing_setting,
        "Policy setting for Copilot code review direct organization billing (live from database)",
        label_scheme: ccr_direct_org_billing_label_scheme,
      ) %>
    <% end %>

    <% component.with_row do %>
      <% if cached_organization.present? && !cached_organization.empty? %>
        <%= render Primer::Box.new(
          bg: :subtle,
          border: true,
          border_radius: 2,
          classes: "tmp-p-3") do %>
          <pre style="margin: 0; white-space: pre-wrap; font-family: monospace;"><%= JSON.pretty_generate(cached_organization) %></pre>
        <% end %>
      <% else %>
        <%= render Primer::Box.new(
          bg: :subtle,
          border: true,
          border_radius: 2,
          classes: "tmp-p-3") do %>
          <p style="margin: 0; color: #656d76; font-style: italic;">
            No cached organization data available. This may indicate:
          </p>
          <ul style="margin: 8px 0 0 20px; color: #656d76;">
            <li>Org has no analytics tracking ID</li>
            <li>Service is temporarily unavailable</li>
            <li>Org has not been processed and cached by the Limiter</li>
          </ul>
        <% end %>
      <% end %>
      <br>
      <%= primer_form_with(url: stafftools_user_copilot_refresh_quotas_cache_path(copilot_organization), method: :post) do |f| %>
        <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, "aria-label": "Refresh limiter cache") do %>
          Refresh Limiter Cache
        <% end %>
      <% end %>
      <br>
      <%= primer_form_with(url: stafftools_user_copilot_refresh_quotas_cache_path(copilot_organization, all_users: true), method: :post) do |f| %>
        <%= render Primer::Beta::Button.new(scheme: :danger, type: :submit, "aria-label": "Refresh limiter cache for all users") do %>
          Refresh Limiter Cache for All Users
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
