<%= render(Primer::Beta::BorderBox.new(padding: :condensed, mt: 4)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Seat Assignment History (<%= @seat_history.size %>)
    <% end %>
  <% end %>

  <% component.with_row do %>
    <table class="width-full">
      <thead>
        <tr class="border-bottom">
          <th class="p-2">Date</th>
          <th class="p-2 text-center">Seats Added</th>
          <th class="p-2 text-center">Seats Deleted</th>
        </tr>
      </thead>
      <tbody>
        <% paginated_history.each do |date, changes| %>
          <tr class="border-bottom">
            <td class="p-2"><%= date.strftime("%B %d, %Y") %></td>
            <td class="p-2 text-center">
              <span data-test-id="seats-added">
                <%= changes[:added] %>
              </span>
            </td>
            <td class="p-2 text-center">
              <span data-test-id="seats-deleted">
                <%= changes[:deleted] %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="d-flex flex-justify-center p-3">
      <%= will_paginate(paginated_history, param_name: "seat_history_page") %>
    </div>
  <% end %>
<% end %>
