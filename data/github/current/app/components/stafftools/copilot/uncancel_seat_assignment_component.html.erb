<%= render(Primer::Alpha::Dialog.new(
    title: "Remove Pending Cancellation for Copilot Seat Assignment",
    subtitle: "",
    id: "remove-cancellation-copilot-seat-assignment-#{copilot_seat_assignment.id}",
    size: :xlarge,
)) do |d| %>
  <% d.with_show_button(scheme: :link, title: "Remove Pending Cancellation") do %>
    <%= render(Primer::Beta::Octicon.new(:unlock, color: :attention), aria: { label: "Show options", hidden: false }) %>
  <% end %>
  <% d.with_body do %>
    <br>
    <% if !copilot_seat_assignment.pending_cancellation_date? %>
      <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
        This seat assignment already has no pending cancellation, clicking this button will do nothing.
      <% end %>
    <% end %>
    <%= render(Primer::Alpha::Banner.new(scheme: :default)) do %>
      This will queue a background job that will remove the pending_cancellation_date date for the seat assignment. The background job may take a few minutes to complete.
    <% end %>
  <% end %>
  <% d.with_footer do %>
    <%= form_tag @form_url, method: :put do %>
        <%= hidden_field_tag :seat_assignment_id, copilot_seat_assignment.id, id: "uncancel_seat_assignment_id_#{copilot_seat_assignment.id}" %>
        <%= hidden_field_tag :operation, "uncancel" %>
        <%= render(Primer::Beta::Button.new(scheme: :danger, type: :submit)) { "Uncancel" } %>
    <% end %>
  <% end %>
<% end %>
