<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Complimentary Subscription
    <% end %>
  <% end %>
  <% component.with_row do %>
    <%= render(Primer::Alpha::Banner.new) do %>
      <p class="text-bold">Hello Hubbers 👋🏼!!</p>
      <p>Please don't share complimentary user qualification information with customers! We reserve the right to change the qualifications at any time. This information should be for <span class="text-bold">internal use only</span>.</p>
    <% end %>
  <% end %>
  <% if copilot_user.edu_signup_enabled? && (free_user.nil? || free_user.type == Copilot::FreeUser::EDUCATIONAL) %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Has Active Copilot Student Subscription?",
        has_active_edu_subscription? ? "Yes" : "No",
        "Does this user have an active Copilot Student (EDU SKU) subscription?",
        label_scheme: has_active_edu_subscription? ? :success : :danger
      ) %>
    <% end %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Has Complimentary Copilot Access?",
      complimentary_access_status,
      "Does this user access Copilot for free? (They must qualify AND claim the complimentary subscription.)",
      label_scheme: complimentary_access_label_scheme
    ) %>
  <% end %>
  <% if free_user.present? || has_active_edu_subscription? || any_edu_subscription_items? || coupon_type == "Student" %>
    <% if any_edu_subscription_items? %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Subscription Item",
          subscription_item_status,
          "The billing subscription item for this user.",
          label_scheme: subscription_item_label_scheme,
        ) %>
      <% end %>
    <% end %>
    <% if show_complimentary_access_type_dropdown? %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Complimentary Access Type",
          display_name_for_type(effective_free_user_type),
          "How they qualified for complimentary Copilot access."
          )  do |detail| %>
          <% detail.with_body do %>
            <%= render(Primer::Alpha::ActionMenu.new) do |menu| %>
              <% menu.with_show_button { |button|
                button.with_trailing_action_icon(icon: :"triangle-down")
                display_name_for_type(effective_free_user_type)
                } %>
                <% Copilot::FreeUser.eligible_types_for(copilot_user).each do |type| %>
                  <% next if type.name == effective_free_user_type %>
                  <% menu.with_item(
                    label: display_name_for_type(type.name),
                    href: stafftools_user_copilot_update_complimentary_user_type_path(copilot_user.user_object),
                    form_arguments: {
                      method: :post,
                      name: "free_user_type",
                      value: type.name
                    },
                    content_arguments: {
                      data: { confirm: "Are you sure you want to set type to '#{display_name_for_type(type.name)}' for this user?" }
                    }
                  ) %>
                <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <% unless free_user&.subscribed? || has_active_edu_subscription? %>
      <% if copilot_user.free_user_blocked? %>
        <% component.with_row do %>
          <%= render Stafftools::Copilot::DetailComponent.new(
            "Is this user blocked from complimentary access?",
            "Yes",
            "A staff member has blocked this user from qualifying for complimentary access via the copilot_free_user_blocked feature flag.",
            label_scheme: :danger,
          ) %>
        <% end %>
      <% else %>
        <% component.with_row do %>
          <%= render Stafftools::Copilot::DetailComponent.new(
            "Would this user qualify if they tried?",
            would_have_free_access? ? "Yes, #{would_have_free_access_reason}" : "No",
            "If this user went to /free_signup would they get complimentary access?",
            label_scheme: would_have_free_access? ? :success : :danger,
          ) %>
        <% end %>
      <% end %>
    <% end %>
    <% if (free_user&.subscribed? && free_user.user.coupon_redemptions.any?) || any_edu_subscription_items? %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Coupon",
          coupon.present? ? coupon.code : "Unknown",
          "What is the code for the coupon that qualified them?",
          label_scheme: :success,
        ) %>
      <% end %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Coupon Redemption Expiration",
          coupon.present? ? coupon_expiration_date.to_s : "Unknown",
          "When does the user's redemption of this coupon expire?",
          label_scheme: coupon.present? ? (coupon.expires_at.to_date > Date.today + 1.week ? :success : :warning) : :danger,
        ) %>
      <% end %>
    <% elsif free_user.present? && free_user.type == Copilot::FreeUser::ENGAGED_OSS %>
      <% if engaged_oss_user.present? %>
        <% component.with_row do %>
          <%= render Stafftools::Copilot::DetailComponent.new(
            "Engaged OSS Repository",
            engaged_oss_user.engaged_oss_repository.present? ? engaged_oss_user.engaged_oss_repository.repository.nwo : "None",
            "User has the '#{engaged_oss_user.role}' role in this repository"
          ) %>
        <% end %>
      <% else %>
        <% component.with_row(scheme: :warning, align_items: :center, font_weight: :emphasized) do %>
          NOTE: This user's Engaged OSS role has been removed or the repository has lost access.
        <% end %>
      <% end %>
    <% end %>
    <% if free_user.present? %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Next Complimentary Qualification Check",
          free_user.next_check_at.to_s,
          "When will this user's complimentary access be rechecked?",
          label_scheme: free_user.next_check_at > Date.today + 1.week ? :success : :warning,
        ) %>
      <% end %>
    <% end %>
    <% if (free_user && !free_user.subscribed?) || (!free_user && !has_active_edu_subscription?) %>
      <% component.with_row do %>
        <%= render(Primer::Alpha::Banner.new) do %>
          <p class="text-bold">Note:</p>
          <p>This user needs to visit <%= link_to copilot_free_signup_path, GitHub.url + copilot_free_signup_path, class: "Link--inTextBlock" %> and sign up.</p>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <% if copilot_user.free_user_blocked? %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Would this user qualify if they tried?",
          "No",
          "A staff member has blocked this user from qualifying for complimentary access. They need to be removed from the feature flag to regain access.",
          label_scheme: :danger,
        ) %>
      <% end %>
    <% else %>
      <% component.with_row do %>
        <%= render Stafftools::Copilot::DetailComponent.new(
          "Would this user qualify if they tried?",
          would_have_free_access? ? "Yes, #{would_have_free_access_reason}" : "No",
          "If this user went to /free_signup would they get complimentary access?",
          label_scheme: would_have_free_access? ? :success : :danger,
        ) %>
      <% end %>
    <% end %>
  <% end %>
  <% if show_create_campus_expert_button? %>
    <% component.with_row do %>
      <%= form_tag stafftools_user_copilot_create_campus_expert_path(copilot_user.user_object), method: :post do %>
        <%= render(Primer::Beta::Button.new(
          scheme: :primary,
          type: :submit,
          test_selector: "create_campus_expert_button",
        )) { "Create Campus Expert Complimentary Subscription" } %>
      <% end %>
    <% end %>
  <% end %>
  <% if show_subscribe_to_edu_sku_button? %>
    <% component.with_row do %>
      <%= form_tag stafftools_user_copilot_subscribe_to_edu_sku_path(copilot_user.user_object), method: :post do %>
        <%= render(Primer::Beta::Button.new(
          scheme: :primary,
          type: :submit,
          test_selector: "subscribe_to_edu_sku_button",
        )) { "Subscribe to Copilot Student" } %>
      <% end %>
      <% if free_user.present? %>
        <br>
        <%= render(Primer::Beta::Text.new(color: :muted)) do %>
          Note: This user already has or is eligible for complimentary access for the following reason: <em class="text-bold"><%= free_user.free_user_type %></em>
        <br>
        <% end %>
        <%= render(Primer::Beta::Text.new(color: :muted)) do %>
          Creating a Copilot Student subscription will have no effect and they will retain their current level of complimentary access.
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% if has_active_edu_subscription? %>
    <% component.with_row do %>
      <%= form_tag stafftools_user_copilot_deactivate_edu_sku_path(copilot_user.user_object), method: :post do %>
        <%= render(Primer::Beta::Button.new(
          scheme: :danger,
          type: :submit,
          test_selector: "deactivate_edu_sku_button",
        )) { "Deactivate Copilot Student Subscription" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
