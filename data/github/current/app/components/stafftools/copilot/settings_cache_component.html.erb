<%= render(Primer::Beta::BorderBox.new(padding: :condensed, mt: 4)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Settings Cache
    <% end %>
  <% end %>
  <% component.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2">
        <div class="d-flex flex-items-start flex-items-center">
          <%= form_tag stafftools_user_copilot_refresh_organization_cache_path(copilot_organization.organization_object.display_login), :method => :post do %>
            <%= render(Primer::Beta::ButtonGroup.new) do |component| %>
              <% component.with_button(type: :submit, id: "copilot-refresh-button", test_selector: "copilot-refresh-button") do |button| %>
                <% button.with_leading_visual_icon(icon: :sync) %>
                Refresh all organization members settings cache
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
