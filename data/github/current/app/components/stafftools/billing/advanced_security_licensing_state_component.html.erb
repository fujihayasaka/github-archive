<div class="ml-4 mb-4">
  <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
    <% component.with_header do %>
      <h2 class="Box-title" <%= test_selector("advanced-security-billing-status") %>>Advanced Security Licensing State</h2>
    <% end %>
    <% component.with_row do %>
      <div>
        <strong>
        <%= case @entity.advanced_security_enabled_type_for_entity
          when Configurable::AdvancedSecurityBillingConfig::ADVANCED_SECURITY_OFF
            "Disabled"
          when Configurable::AdvancedSecurityBillingConfig::GHAS_VOLUME
            "Bundled Volume"
          when Configurable::AdvancedSecurityBillingConfig::GHAS_METERED
            "Bundled Metered"
          when Configurable::AdvancedSecurityBillingConfig::SPLIT_METERED
            "Unbundled Metered"
          when Configurable::AdvancedSecurityBillingConfig::SPLIT_VOLUME, Configurable::AdvancedSecurityBillingConfig::SECRET_PROTECTION_VOLUME, Configurable::AdvancedSecurityBillingConfig::CODE_SECURITY_VOLUME
            "Unbundled Volume"
          else
            "Unknown"
          end %>
        </strong>
        <% if @entity.advanced_security_enabled_type_for_entity == Configurable::AdvancedSecurityBillingConfig::SPLIT_VOLUME %>
          with both SKUs
        <% elsif @entity.advanced_security_enabled_type_for_entity == Configurable::AdvancedSecurityBillingConfig::SECRET_PROTECTION_VOLUME %>
          with Secret Protection only
        <% elsif @entity.advanced_security_enabled_type_for_entity == Configurable::AdvancedSecurityBillingConfig::CODE_SECURITY_VOLUME %>
          with Code Security only
        <% end %>
        <%= render(Primer::Beta::Label.new(scheme: :accent, classes: "ml-1 mb-2")) { "Trial Active" } if any_trial? %>
      </div>
      <% if any_trial? %>
        <ul class="ml-4">
          <%# Self serve and manual Trials %>
          <% if self_serve_trial? %>
            <li>as <strong>self-serve Advanced Security trial</strong> until <%= @entity.advanced_security_subscription_item&.free_trial_ends_on %></li>
          <% end %>
          <% if manual_advanced_security_trial? %>
            <li>as <strong>manual Advanced Security trial</strong> with unlimited seats</li>
          <% end %>
          <% if manual_secret_protection_trial? %>
            <li>as <strong>manual Secret Protection trial</strong> with unlimited seats</li>
          <% end %>
          <% if manual_code_security_trial? %>
            <li>as <strong>manual Code Security trial</strong> with unlimited seats</li>
          <% end %>

          <%# Sales API Trials %>
          <% if secret_protection_trial&.enabled? %>
            <li>with <strong>Secret Protection Trial</strong> until <%= secret_protection_trial.expires_at %> &lpar;started on <%= secret_protection_trial.started_at %>&rpar;</li>
          <% end %>
          <% if code_security_trial&.enabled? %>
            <li>with <strong>Code Security Trial</strong> until <%= code_security_trial.expires_at %> &lpar;started on <%= code_security_trial.started_at %>&rpar;</li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>
</div>
