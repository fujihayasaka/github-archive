<li class="Box-row">
  <h2 <%= test_selector "#{contact_type}-information-title" %>>
    <%= contact_title %>
  </h2>
  <% if customer.nil? %>
    <p>No customer record exists for this account.</p>
  <% elsif authorized_staffer? %>
    <% if !show_info %>
      <p>
        <% if allowed_to_view_contact_info? %>
          View <%= contact_type %> information for this account.
        <% else %>
          <%= description %>
        <% end %>
      </p>
    <% end %>
    <% if render_info? %>
      <div <%= test_selector data_test_selector %>>
        <% if user_owned? %>
          <p class="mt-2" <%= test_selector "first_name" %>>
            <strong>First name:</strong> <%= first_name %>
          </p>

          <p <%= test_selector "last_name" %>>
            <strong>Last name:</strong> <%= last_name %>
          </p>
        <% else %>
          <p class="mt-2" <%= test_selector "entity_name" %>>
            <strong>Entity name:</strong> <%= entity_name %>
          </p>
        <% end %>
        <p <%= test_selector "address1" %>>
          <strong>Address1:</strong> <%= address1 %>
        </p>
        <% if address2.present? %>
          <p <%= test_selector "address2" %>>
            <strong>Address2:</strong> <%= address2 %>
          </p>
        <% end %>
        <p <%= test_selector "city" %>>
          <strong>City:</strong> <%= city %>
        </p>
        <% if region.present? %>
          <p <%= test_selector "region" %>>
            <strong>Region:</strong> <%= region %>
          </p>
        <% end %>
        <p <%= test_selector "country" %>>
          <strong>Country:</strong> <%= country_code %>
        </p>
        <% if postal_code.present? %>
          <p <%= test_selector "postal_code" %>>
            <strong>Postal code:</strong> <%= postal_code %>
          </p>
        <% end %>
        <% if updated_at.present? %>
          <p>
            <strong>Updated at:</strong> <%= updated_at %>
          </p>
        <% end %>
      </div>
    <% end %>
    <% if allowed_to_view_contact_info? %>
      <%= form_tag controller_path, method: :post do %>
        <%= hidden_field_tag show_param_name, (!show_info).to_s %>
        <% SHOW_PARAM_NAMES.each do |type, param_name| %>
          <% next if param_name == show_param_name %>
          <% if params[param_name] == "true" %>
            <%= hidden_field_tag param_name, "true" %>
          <% end %>
        <% end %>
        <%= render Primer::Beta::Button.new(
          type: :submit,
          scheme: :danger,
        ).with_content(button_text) %>
      <% end %>
    <% end %>

  <% else %>
    <p <%= test_selector "billing-information-unauthorized" %>><%= stafftools_not_authorized_html %></p>
  <% end %>
</li>
