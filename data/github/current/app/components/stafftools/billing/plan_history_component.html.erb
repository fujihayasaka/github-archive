<tr>
  <% if action_type == ActionType::SwitchedTo %>
    <td class="p-2 border-bottom text-bold" aria-label="<%= action %>">
      Period change
    </td>
    <td class="p-2 border-bottom color-bg-default"><%= period_change_direction %></td>
  <% elsif action_type == ActionType::Seats %>
    <td class="p-2 border-bottom text-bold" aria-label="<%= action %>">
      <%= humanized_action %>
    </td>
    <td class="p-2 border-bottom color-bg-default">
      <%= old_seats %> &rarr;
      <%= current_seats %>
    </td>
  <% elsif action_type == ActionType::AssetPacks %>
    <td class="p-2 border-bottom text-bold color-bg-default" aria-label="<%= action %>">
      <%= humanized_action %>
    </td>
    <td class="p-2 border-bottom color-bg-default">
      <%= old_data_packs %> &rarr;
      <%= asset_packs_total %>
    </td>
  <% elsif [ActionType::RecurringCharge, ActionType::ProrateCharge, ActionType::Refunded, ActionType::FirstTimePaidUpgrade].include?(action_type) %>
    <td class="p-2 border-bottom text-bold color-bg-default"><%= humanized_action %></td>
    <td class="p-2 border-bottom color-bg-default">
      <%= charge_details %>
    </td>
  <% elsif action_type == ActionType::PlanChange %>
    <td class="p-2 border-bottom text-bold color-bg-default" aria-label="<%= action %>">
      <%= humanized_action %>
    </td>
    <td class="p-2 border-bottom color-bg-default">
      <% unless current_seats.to_i.zero? %>
        <% if old_seats && old_seats != current_seats %>
          <%= old_seats %> &rarr;
        <% end %>
        <%= current_seats %>X
      <% end %>

      <%= current_plan %>

      <% if old_plan && old_plan != current_plan %>
        <%= old_plan %> &rarr;
      <% end %>
      <%= current_plan %>
    </td>
  <% else %>
    <td class="p-2 border-bottom text-bold color-bg-default"><%= humanized_action %></td>
    <td class="p-2 border-bottom color-bg-default">
      <% if old_plan_name %>
        <%= old_plan_name.to_s.humanize %> &rarr;
      <% end %>
      <%= current_plan_name.to_s.humanize %>
    </td>
  <% end %>
  <td class="p-2 border-bottom color-fg-muted text-right color-bg-default"><%= formatted_date %></td>
</tr>
