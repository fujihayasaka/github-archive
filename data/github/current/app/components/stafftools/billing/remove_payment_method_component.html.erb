<%= render(Primer::Experimental::Dialog.new(
  dialog_id: "remove-payment-method-modal",
  header_variant: :large,
  width: :xlarge,
  title: "Confirm remove all payment methods",
  form_url: stafftools_billing_payment_methods_url,
  form_method: :delete,
  test_selector: "remove-payment-method-modal"
)) do |c| %>
  <% c.with_show_button(**show_button_attributes) do %>
    <%= action_text %>
  <% end %>
  <% c.with_body do %>
    <%= hidden_field_tag :target_type, account.class.name %>
    <%= hidden_field_tag :target_id, account.id %>

    <%= render(Primer::Alpha::Banner.new(scheme: :warning)) { "Woah there!" } %>
    <p>
      This will <strong>remove all credit cards and PayPal accounts</strong>
      from this customer’s account. Are you sure you want to do this?
    </p>
  <% end %>
  <% c.with_button(
    data: { "close-dialog-id": "remove-payment-method-modal" }
  ) { "Cancel" } %>
  <% c.with_button(
    type: :submit,
    scheme: :danger,
    data: { "disable-with": "" }
  ) { "Remove all payment methods" } %>
<% end %>
