<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-4")) do |component| %>
  <% component.with_header do |h| %>
    <div class="d-flex text-bold flex-justify-between">
      <div class="mt-1" id="billing-platform-customer-information">Billing Platform Customer Information</div>
      <%= form_tag sync_path, method: :post do %>
        <%= render Primer::Beta::Button.new(type: :submit) do %>Sync customer<% end %>
      <% end %>
    </div>
  <% end %>
  <% component.with_body do %>
    <div class="Box-row clearfix">
      <% if !customer_response.is_a?(::Billing::Platform::Api::Error) %>
        <div class="mb-2">
          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Azure Subscription ID: </span>
            <span class="d-block col-8"><%= azure_subscription_id %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Zuora Account Number: </span>
            <span class="d-block col-8"><%= zuora_account_number %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Has Zuora Subscription: </span>
            <span class="d-block col-8"><%= has_zuora_subscription? %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Plan Name: </span>
            <span class="d-block col-8"><%= discount_plan_name %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Billing Target: </span>
            <span class="d-block col-8"><%= billing_target %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Billing Effective Date: </span>
            <span class="d-block col-8"><%= billing_platform_effective_date %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Billing Locked: </span>
            <span class="d-block col-8"><%= billing_locked? %></span>
          </div>

        <% if show_policy_toggles %>
          <% if enable_policy_copilot_premium_request_path.present? %>
            <div class="d-flex flex-justify-start mb-2">
              <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, mb: 2)) do %>
                <label for="toggle_copilot_premium_request" class="d-block col-4 text-bold">
                  Copilot Premium Request Overages:
                </label>
                <%= form_with url: (overage_policies_copilot_premium_requests == "Enabled" ? disable_policy_copilot_premium_request_path : enable_policy_copilot_premium_request_path), class: "d-block col-8", method: :put, local: true do |f| %>
                  <%= render(
                    Primer::Alpha::ToggleSwitch.new(
                      size: :small,
                      status_label_position: :start,
                      csrf_token: "",
                      id: "toggle_copilot_premium_request",
                      checked: overage_policies_copilot_premium_requests == "Enabled",
                      aria: { label: "Copilot Premium Request Overages:" },
                      data: {
                        action: "click:copilot-business-settings-toggle#toggleSetting",
                        target: "copilot-business-settings-toggle.settingCheckbox",
                        checked: overage_policies_copilot_premium_requests == "Enabled"
                      }
                    )
                  ) %>
                <% end %>
              <% end %>
            </div>
          <% end %>



          <% if enable_policy_spark_request_path.present? %>
            <div class="d-flex flex-justify-start mb-2">
              <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, mb: 2)) do %>
                <label for="toggle_spark_premium_request" class="d-block col-4 text-bold">
                  Spark Overages:
                </label>
                <%= form_with url: (overage_policies_spark == "Enabled" ? disable_policy_spark_request_path : enable_policy_spark_request_path), class: "d-block col-8", method: :put, local: true do |f| %>
                  <%= render(
                    Primer::Alpha::ToggleSwitch.new(
                      size: :small,
                      status_label_position: :start,
                      csrf_token: "",
                      id: "toggle_spark_premium_request",
                      checked: overage_policies_spark == "Enabled",
                      aria: { label: "Spark Overages:" },
                      data: {
                        action: "click:copilot-business-settings-toggle#toggleSetting",
                        target: "copilot-business-settings-toggle.settingCheckbox",
                        checked: overage_policies_spark == "Enabled"
                      }
                    )
                  ) %>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% if enable_policy_coding_agent_request_path.present? %>
            <div class="d-flex flex-justify-start mb-2">
              <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, mb: 2)) do %>
                <label for="toggle_coding_agent_premium_request" class="d-block col-4 text-bold">
                  Coding Agent Overages:
                </label>
                <%= form_with url: (overage_policies_coding_agent == "Enabled" ? disable_policy_coding_agent_request_path : enable_policy_coding_agent_request_path), class: "d-block col-8", method: :put, local: true do |f| %>
                  <%= render(
                    Primer::Alpha::ToggleSwitch.new(
                      size: :small,
                      status_label_position: :start,
                      csrf_token: "",
                      id: "toggle_coding_agent_premium_request",
                      checked: overage_policies_coding_agent == "Enabled",
                      aria: { label: "Coding Agent Overages:" },
                      data: {
                        action: "click:copilot-business-settings-toggle#toggleSetting",
                        target: "copilot-business-settings-toggle.settingCheckbox",
                        checked: overage_policies_coding_agent == "Enabled"
                      }
                    )
                  ) %>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% if enable_policy_code_review_request_path.present? %>
            <div class="d-flex flex-justify-start mb-2">
              <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, mb: 2)) do %>
                <label for="toggle_code_review_premium_request" class="d-block col-4 text-bold">
                  Code Review Overages:
                </label>
                <%= form_with url: (overage_policies_code_review == "Enabled" ? disable_policy_code_review_request_path : enable_policy_code_review_request_path), class: "d-block col-8", method: :put, local: true do |f| %>
                  <%= render(
                    Primer::Alpha::ToggleSwitch.new(
                      size: :small,
                      status_label_position: :start,
                      csrf_token: "",
                      id: "toggle_code_review_overages",
                      checked: overage_policies_code_review == "Enabled",
                      aria: { label: "Code Review Overages:" },
                      data: {
                        action: "click:copilot-business-settings-toggle#toggleSetting",
                        target: "copilot-business-settings-toggle.settingCheckbox",
                        checked: overage_policies_code_review == "Enabled"
                      }
                    )
                  ) %>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% if enable_policy_copilot_ai_unit_path.present? %>
            <div class="d-flex flex-justify-start mb-2">
              <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, mb: 2)) do %>
                <label for="toggle_copilot_ai_unit" class="d-block col-4 text-bold">
                  Copilot AI Unit Overages:
                </label>
                <%= form_with url: (overage_policies_copilot_ai_unit == "Enabled" ? disable_policy_copilot_ai_unit_path : enable_policy_copilot_ai_unit_path), class: "d-block col-8", method: :put, local: true do |f| %>
                  <%= render(
                    Primer::Alpha::ToggleSwitch.new(
                      size: :small,
                      status_label_position: :start,
                      csrf_token: "",
                      id: "toggle_copilot_ai_unit",
                      checked: overage_policies_copilot_ai_unit == "Enabled",
                      aria: { label: "Copilot AI Unit Overages:" },
                      data: {
                        action: "click:copilot-business-settings-toggle#toggleSetting",
                        target: "copilot-business-settings-toggle.settingCheckbox",
                        checked: overage_policies_copilot_ai_unit == "Enabled"
                      }
                    )
                  ) %>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% if enable_policy_coding_agent_ai_unit_path.present? %>
            <div class="d-flex flex-justify-start mb-2">
              <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, mb: 2)) do %>
                <label for="toggle_coding_agent_ai_unit" class="d-block col-4 text-bold">
                  Coding Agent AI Unit Overages:
                </label>
                <%= form_with url: (overage_policies_coding_agent_ai_unit == "Enabled" ? disable_policy_coding_agent_ai_unit_path : enable_policy_coding_agent_ai_unit_path), class: "d-block col-8", method: :put, local: true do |f| %>
                  <%= render(
                    Primer::Alpha::ToggleSwitch.new(
                      size: :small,
                      status_label_position: :start,
                      csrf_token: "",
                      id: "toggle_coding_agent_ai_unit",
                      checked: overage_policies_coding_agent_ai_unit == "Enabled",
                      aria: { label: "Coding Agent AI Unit Overages:" },
                      data: {
                        action: "click:copilot-business-settings-toggle#toggleSetting",
                        target: "copilot-business-settings-toggle.settingCheckbox",
                        checked: overage_policies_coding_agent_ai_unit == "Enabled"
                      }
                    )
                  ) %>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% if enable_policy_spark_ai_unit_path.present? %>
            <div class="d-flex flex-justify-start mb-2">
              <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, flex: 1, direction: :row, align_items: :center, mb: 2)) do %>
                <label for="toggle_spark_ai_unit" class="d-block col-4 text-bold">
                  Spark AI Unit Overages:
                </label>
                <%= form_with url: (overage_policies_spark_ai_unit == "Enabled" ? disable_policy_spark_ai_unit_path : enable_policy_spark_ai_unit_path), class: "d-block col-8", method: :put, local: true do |f| %>
                  <%= render(
                    Primer::Alpha::ToggleSwitch.new(
                      size: :small,
                      status_label_position: :start,
                      csrf_token: "",
                      id: "toggle_spark_ai_unit",
                      checked: overage_policies_spark_ai_unit == "Enabled",
                      aria: { label: "Spark AI Unit Overages:" },
                      data: {
                        action: "click:copilot-business-settings-toggle#toggleSetting",
                        target: "copilot-business-settings-toggle.settingCheckbox",
                        checked: overage_policies_spark_ai_unit == "Enabled"
                      }
                    )
                  ) %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Copilot Premium Request Overages: </span>
            <span class="d-block col-8"><%= overage_policies_copilot_premium_requests %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Spark Overages: </span>
            <span class="d-block col-8"><%= overage_policies_spark %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Coding Agent Overages: </span>
            <span class="d-block col-8"><%= overage_policies_coding_agent %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Code Review Overages: </span>
            <span class="d-block col-8"><%= overage_policies_code_review %></span>
          </div>

          <% if @billable_entity.feature_flag_enabled?(:copilot_token_based_billing, default: false) %>
            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">Copilot AI Unit Overages: </span>
              <span class="d-block col-8"><%= overage_policies_copilot_ai_unit %></span>
            </div>
          <% end %>

          <% if @billable_entity.feature_flag_enabled?(:copilot_token_based_billing, default: false) %>
            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">Coding Agent AI Unit Overages: </span>
              <span class="d-block col-8"><%= overage_policies_coding_agent_ai_unit %></span>
            </div>
          <% end %>

          <% if @billable_entity.feature_flag_enabled?(:copilot_token_based_billing, default: false) %>
            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">Spark AI Unit Overages: </span>
              <span class="d-block col-8"><%= overage_policies_spark_ai_unit %></span>
            </div>
          <% end %>
        <% end %>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Bill for Public Repo Usage: </span>
            <span class="d-block col-8"><%= bill_for_public_repo_usage? %></span>
          </div>

          <div class="d-flex flex-justify-start mb-2">
            <span class="d-block col-4 text-bold">Migrated to Billing Platform At: </span>
            <span class="d-block col-8"><%= migrated_to_billing_platform %></span>
          </div>
        </div>
      <% else %>
        <%= customer_response.message %>
      <% end %>
    </div>
  <% end %>
<% end %>
