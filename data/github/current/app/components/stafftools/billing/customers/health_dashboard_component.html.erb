<%= render(Primer::Alpha::Banner.new(
  scheme: overall_healthy? ? :success : :warning,
  icon: overall_healthy? ? "check-circle" : "alert",
  full: true, classes: "tmp-mb-3"
)) do %>
  <strong><%= overall_healthy? ? "All systems nominal! ✨" : "Attention needed ⚠️" %></strong>
  — Customer #<%= customer.id %> health check
<% end %>

<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
  <% box.with_header do %>
    <h3 class="Box-title">
      <%= render(Primer::Beta::Octicon.new(icon: "pulse", classes: "tmp-mr-2")) %>
      Customer Health Dashboard
    </h3>
  <% end %>
  <% health_checks.each do |check| %>
    <% box.with_row do %>
      <div class="d-flex flex-items-center flex-justify-between">
        <div class="d-flex flex-items-center">
          <%= render(Primer::Beta::Octicon.new(
            icon: check[:icon],
            color: check[:ok] ? :success : :danger, classes: "tmp-mr-2"
          )) %>
          <strong class="tmp-mr-2"><%= check[:label] %></strong>
          <%= render(Primer::Beta::Label.new(
            scheme: check[:ok] ? :success : :danger,
            size: :large,
          )) do %>
            <%= check[:ok] ? "✓ OK" : "✗ Issue" %>
          <% end %>
        </div>
        <span class="color-fg-muted text-small"><%= check[:detail] %></span>
      </div>
    <% end %>
  <% end %>
<% end %>
