<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
  <% box.with_header do %>
    <h3 class="Box-title">
      <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", classes: "tmp-mr-2")) %>
      Billing Contact
      <%= render(Primer::Beta::Label.new(scheme: :attention, classes: "tmp-ml-1")) do %>
        Trade Compliance
      <% end %>
    </h3>
  <% end %>

  <% box.with_row do %>
    <div class="d-flex flex-justify-start">
      <span class="d-block col-4 text-bold">Contact Name</span>
      <span class="d-block col-8"><%= contact_name %></span>
    </div>
  <% end %>

  <% if billing_contact.entity_name.present? %>
    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Entity Name</span>
        <span class="d-block col-8"><%= billing_contact.entity_name %></span>
      </div>
    <% end %>
  <% end %>

  <% box.with_row do %>
    <div class="d-flex flex-justify-start">
      <span class="d-block col-4 text-bold">Address</span>
      <span class="d-block col-8"><%= full_address %></span>
    </div>
  <% end %>

  <% if vat_code.present? %>
    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">VAT Code</span>
        <span class="d-block col-8"><code><%= vat_code %></code></span>
      </div>
    <% end %>
  <% end %>

  <% box.with_row do %>
    <div class="d-flex flex-justify-start">
      <span class="d-block col-4 text-bold">Trade Screening</span>
      <span class="d-block col-8">
        <%= render(Primer::Beta::Label.new(
          scheme: trade_screening_status == "passed" ? :success : :attention,
          size: :medium,
        )) do %>
          <%= trade_screening_status %>
        <% end %>
      </span>
    </div>
  <% end %>

  <% if address_validated_at.present? %>
    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Address Validated</span>
        <span class="d-block col-8 color-fg-muted"><%= address_validated_at %></span>
      </div>
    <% end %>
  <% end %>

  <% box.with_row do %>
    <div class="d-flex flex-justify-center tmp-pt-2">
      <%= render(Primer::Alpha::Dialog.new(
        title: "Full Billing Contact — Customer ##{customer.id}",
        id: "billing-contact-dialog",
        size: :xlarge,
        position: :right,
        position_narrow: :right,
      )) do |dialog| %>
        <% dialog.with_show_button(size: :small, scheme: :invisible) do %>
          <%= render(Primer::Beta::Octicon.new(icon: "shield-lock", classes: "tmp-mr-1")) %>
          View Full Contact Details
        <% end %>
        <% dialog.with_body do %>
          <table class="stafftools-table width-full">
            <% if billing_contact.first_name.present? %>
              <tr>
                <th class="text-bold tmp-p-2">First Name</th>
                <td class="tmp-p-2"><%= billing_contact.first_name %></td>
              </tr>
            <% end %>
            <% if billing_contact.last_name.present? %>
              <tr>
                <th class="text-bold tmp-p-2">Last Name</th>
                <td class="tmp-p-2"><%= billing_contact.last_name %></td>
              </tr>
            <% end %>
            <% if billing_contact.entity_name.present? %>
              <tr>
                <th class="text-bold tmp-p-2">Entity Name</th>
                <td class="tmp-p-2"><%= billing_contact.entity_name %></td>
              </tr>
            <% end %>
            <tr>
              <th class="text-bold tmp-p-2">Address Line 1</th>
              <td class="tmp-p-2"><%= billing_contact.address1 || "—" %></td>
            </tr>
            <tr>
              <th class="text-bold tmp-p-2">Address Line 2</th>
              <td class="tmp-p-2"><%= billing_contact.address2 || "—" %></td>
            </tr>
            <tr>
              <th class="text-bold tmp-p-2">City</th>
              <td class="tmp-p-2"><%= billing_contact.city || "—" %></td>
            </tr>
            <tr>
              <th class="text-bold tmp-p-2">Region</th>
              <td class="tmp-p-2"><%= billing_contact.region || "—" %></td>
            </tr>
            <tr>
              <th class="text-bold tmp-p-2">Postal Code</th>
              <td class="tmp-p-2"><%= billing_contact.postal_code || "—" %></td>
            </tr>
            <tr>
              <th class="text-bold tmp-p-2">Country</th>
              <td class="tmp-p-2"><%= billing_contact.country_code || "—" %></td>
            </tr>
            <% if vat_code.present? %>
              <tr>
                <th class="text-bold tmp-p-2">VAT Code</th>
                <td class="tmp-p-2"><code><%= vat_code %></code></td>
              </tr>
            <% end %>
            <tr>
              <th class="text-bold tmp-p-2">Trade Screening</th>
              <td class="tmp-p-2"><%= trade_screening_status %></td>
            </tr>
            <% if address_validated_at.present? %>
              <tr>
                <th class="text-bold tmp-p-2">Address Validated At</th>
                <td class="tmp-p-2"><%= address_validated_at %></td>
              </tr>
            <% end %>
          </table>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
