<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
  <% box.with_header do %>
    <h3 class="Box-title">
      <%= render(Primer::Beta::Octicon.new(icon: "people", classes: "tmp-mr-2")) %>
      Billable Entities
      <%= render(Primer::Beta::Counter.new(
        count: customer_accounts.size + (business.present? ? 1 : 0),
        scheme: :primary, classes: "tmp-ml-1"
      )) %>
    </h3>
  <% end %>

  <% box.with_body(classes: "tmp-p-3") do %>
    <%# Hub: Customer badge in center %>
    <div class="d-flex flex-justify-center tmp-mb-3">
      <%= render(Primer::Beta::Label.new(scheme: :accent, size: :large)) do %>
        <%= render(Primer::Beta::Octicon.new(icon: "database", classes: "tmp-mr-1")) %>
        Customer #<%= customer.id %>
        <% if customer.purpose.present? %>
          · <%= customer.purpose.to_s.capitalize %>
        <% end %>
      <% end %>
    </div>

    <%# Connecting line %>
    <div class="d-flex flex-justify-center tmp-mb-3">
      <div style="width: 2px; height: 24px; background: var(--borderColor-default, #d0d7de);"></div>
    </div>

    <%# Entity cards in a flex row %>
    <div class="d-flex flex-wrap gap-3 flex-justify-center">
      <%# Business card (if present) %>
      <% if business.present? %>
        <div style="min-width: 280px; max-width: 400px; flex: 1;">
          <%= render(Primer::Beta::BorderBox.new) do |entity_box| %>
            <% entity_box.with_header(bg: :accent) do %>
              <div class="d-flex flex-items-center flex-justify-between">
                <div class="d-flex flex-items-center">
                  <%= render(Primer::Beta::Octicon.new(icon: "briefcase", color: :accent, classes: "tmp-mr-2")) %>
                  <strong>Enterprise</strong>
                </div>
                <%= render(Primer::Beta::Label.new(scheme: :accent)) { "Business" } %>
              </div>
            <% end %>
            <% entity_box.with_body(classes: "tmp-p-3") do %>
              <div class="tmp-mb-2">
                <span class="text-bold"><%= business.name %></span>
                <span class="color-fg-muted d-block text-small">Slug: <%= business.slug %></span>
              </div>
              <div class="d-flex flex-items-center gap-2">
                <%= render(Primer::Beta::Button.new(
                  tag: :a,
                  href: stafftools_enterprise_path(business),
                  size: :small,
                  scheme: :invisible,
                )) do %>
                  <%= render(Primer::Beta::Octicon.new(icon: "link-external", classes: "tmp-mr-1")) %>
                  View in Stafftools
                <% end %>
              </div>

              <%# Delegated child organizations %>
              <% orgs = delegated_organizations %>
              <% if orgs.any? %>
                <div class="tmp-mt-3 tmp-pt-3" style="border-top: 1px solid var(--borderColor-default, #d0d7de);">
                  <div class="d-flex flex-items-center gap-2 tmp-mb-2">
                    <%= render(Primer::Beta::Octicon.new(icon: "arrow-switch", color: :attention, size: :small)) %>
                    <span class="text-small text-bold color-fg-muted">Delegated Billing</span>
                    <%= render(Primer::Beta::Counter.new(count: orgs.size, scheme: :primary)) %>
                  </div>
                  <div class="d-flex flex-column gap-2">
                    <% orgs.each do |org| %>
                      <div class="d-flex flex-items-center flex-justify-between tmp-p-2 rounded-2" style="background: var(--bgColor-muted, #f6f8fa);">
                        <div class="d-flex flex-items-center gap-2">
                          <%= render(Primer::Beta::Octicon.new(icon: "organization", color: :muted, size: :small)) %>
                          <span class="text-bold text-small"><%= org.login %></span>
                          <%= render(Primer::Beta::Label.new(scheme: :attention, size: :medium)) { "Delegated" } %>
                        </div>
                        <%= render(Primer::Beta::Button.new(
                          tag: :a,
                          href: stafftools_user_path(org),
                          size: :small,
                          scheme: :invisible,
                        )) do %>
                          <%= render(Primer::Beta::Octicon.new(icon: "link-external", classes: "tmp-mr-1")) %>
                          <span class="sr-only">View <%= org.login %> in Stafftools</span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%# Customer account cards %>
      <% customer_accounts.each do |account| %>
        <% next unless account.user %>
        <div style="min-width: 240px; max-width: 320px; flex: 1;">
          <%= render(Primer::Beta::BorderBox.new) do |entity_box| %>
            <% entity_box.with_header do %>
              <div class="d-flex flex-items-center flex-justify-between">
                <div class="d-flex flex-items-center">
                  <%= render(Primer::Beta::Octicon.new(icon: entity_icon(account), classes: "tmp-mr-2")) %>
                  <strong><%= entity_type_label(account) %></strong>
                </div>
                <%= render(Primer::Beta::Label.new(scheme: verification_scheme(account))) do %>
                  <%= verification_text(account) %>
                <% end %>
              </div>
            <% end %>
            <% entity_box.with_body(classes: "tmp-p-3") do %>
              <div class="tmp-mb-2">
                <span class="text-bold"><%= account.user.login %></span>
                <span class="color-fg-muted d-block text-small">ID: <%= account.user.id %></span>
              </div>
              <div class="d-flex flex-items-center flex-justify-between">
                <%= render(Primer::Beta::Button.new(
                  tag: :a,
                  href: stafftools_user_path(account.user),
                  size: :small,
                  scheme: :invisible,
                )) do %>
                  <%= render(Primer::Beta::Octicon.new(icon: "link-external", classes: "tmp-mr-1")) %>
                  View in Stafftools
                <% end %>

                <%# Dialog for full customer account details %>
                <%= render(Primer::Alpha::Dialog.new(
                  title: "Customer Account Details — #{account.user.login}",
                  id: "entity-detail-#{account.id}",
                  size: :xlarge,
                  position: :right,
                  position_narrow: :right,
                )) do |dialog| %>
                  <% dialog.with_show_button(size: :small, scheme: :invisible) do %>
                    <%= render(Primer::Beta::Octicon.new(icon: "info", classes: "tmp-mr-1")) %>
                    Details
                  <% end %>
                  <% dialog.with_body do %>
                    <table class="stafftools-table width-full">
                      <tr>
                        <th class="text-bold tmp-p-2">Account ID</th>
                        <td class="tmp-p-2"><%= account.id %></td>
                      </tr>
                      <tr>
                        <th class="text-bold tmp-p-2">State</th>
                        <td class="tmp-p-2">
                          <%= render(Primer::Beta::Label.new(scheme: account.verified? ? :success : :attention)) do %>
                            <%= account.verified? ? "Verified" : "Unverified" %>
                          <% end %>
                        </td>
                      </tr>
                      <tr>
                        <th class="text-bold tmp-p-2">Purpose</th>
                        <td class="tmp-p-2"><%= account.purpose %></td>
                      </tr>
                      <% if account.verified? && account.verified_by.present? %>
                        <tr>
                          <th class="text-bold tmp-p-2">Verified By</th>
                          <td class="tmp-p-2"><%= account.verified_by.login %></td>
                        </tr>
                      <% end %>
                      <tr>
                        <th class="text-bold tmp-p-2">Created</th>
                        <td class="tmp-p-2"><%= account.created_at %></td>
                      </tr>
                      <tr>
                        <th class="text-bold tmp-p-2">Updated</th>
                        <td class="tmp-p-2"><%= account.updated_at %></td>
                      </tr>
                    </table>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%# Empty state %>
      <% if customer_accounts.empty? && business.blank? %>
        <div class="blankslate">
          <%= render(Primer::Beta::Octicon.new(icon: "people", size: :medium, classes: "tmp-mb-2")) %>
          <h3 class="blankslate-heading">No billable entities</h3>
          <p>This customer has no linked organizations, users, or businesses.</p>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
