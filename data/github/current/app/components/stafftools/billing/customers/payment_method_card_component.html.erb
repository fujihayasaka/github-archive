<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
  <% box.with_header do %>
    <div class="d-flex flex-items-center flex-justify-between">
      <h3 class="Box-title">
        <%= render(Primer::Beta::Octicon.new(icon: "credit-card", classes: "tmp-mr-2")) %>
        Payment Method
      </h3>
      <% if has_payment_method? %>
        <% if has_valid_token? && !is_blocklisted? %>
          <%= render(Primer::Beta::Label.new(scheme: :success)) do %>
            <%= render(Primer::Beta::Octicon.new(icon: "check-circle", classes: "tmp-mr-1")) %>
            Valid
          <% end %>
        <% else %>
          <%= render(Primer::Beta::Label.new(scheme: :danger)) do %>
            <%= render(Primer::Beta::Octicon.new(icon: "alert", classes: "tmp-mr-1")) %>
            <%= is_blocklisted? ? "Blocklisted" : "Invalid" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if has_payment_method? %>
    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Processor</span>
        <span class="d-block col-8">
          <%= render(Primer::Beta::Label.new(scheme: :accent)) { processor_type } %>
        </span>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Valid Token</span>
        <span class="d-block col-8">
          <% if has_valid_token? %>
            <%= render(Primer::Beta::Octicon.new(icon: "check", color: :success)) %>
            Yes
          <% else %>
            <%= render(Primer::Beta::Octicon.new(icon: "x", color: :danger)) %>
            No
          <% end %>
        </span>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Country</span>
        <span class="d-block col-8"><%= card_country %></span>
      </div>
    <% end %>

    <% if is_blocklisted? %>
      <% box.with_row do %>
        <div class="d-flex flex-justify-start">
          <span class="d-block col-4 text-bold color-fg-danger">Blocklisted</span>
          <span class="d-block col-8">
            <%= render(Primer::Beta::Label.new(scheme: :danger)) do %>
              <%= render(Primer::Beta::Octicon.new(icon: "shield-x", classes: "tmp-mr-1")) %>
              Card is blocklisted
            <% end %>
          </span>
        </div>
      <% end %>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-center tmp-pt-2">
        <%= render(Primer::Alpha::Dialog.new(
          title: "Payment Method Details",
          id: "payment-method-detail-dialog",
          size: :xlarge,
          position: :right,
          position_narrow: :right,
        )) do |dialog| %>
          <% dialog.with_show_button(size: :small, scheme: :invisible) do %>
            <%= render(Primer::Beta::Octicon.new(icon: "eye", classes: "tmp-mr-1")) %>
            View Full Details
          <% end %>
          <% dialog.with_body do %>
            <table class="stafftools-table width-full">
              <tr>
                <th class="text-bold tmp-p-2">Payment Processor</th>
                <td class="tmp-p-2"><%= processor_type %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Processor Customer ID</th>
                <td class="tmp-p-2"><code><%= processor_customer_id || "N/A" %></code></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Valid Token</th>
                <td class="tmp-p-2"><%= has_valid_token? ? "Yes" : "No" %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Card Fingerprint</th>
                <td class="tmp-p-2"><code><%= card_fingerprint || "N/A" %></code></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Country</th>
                <td class="tmp-p-2"><%= card_country %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Region</th>
                <td class="tmp-p-2"><%= payment_method&.region || "N/A" %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Postal Code</th>
                <td class="tmp-p-2"><%= payment_method&.postal_code || "N/A" %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Blocklisted</th>
                <td class="tmp-p-2">
                  <% if is_blocklisted? %>
                    <%= render(Primer::Beta::Label.new(scheme: :danger)) { "Yes" } %>
                  <% else %>
                    No
                  <% end %>
                </td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Created</th>
                <td class="tmp-p-2"><%= payment_method.created_at %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Updated</th>
                <td class="tmp-p-2"><%= payment_method.updated_at %></td>
              </tr>
            </table>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <% box.with_body(classes: "tmp-p-3") do %>
      <div class="blankslate">
        <%= render(Primer::Beta::Octicon.new(icon: "credit-card", size: :medium, color: :muted, classes: "tmp-mb-2")) %>
        <h3 class="blankslate-heading">No Payment Method</h3>
        <p>This customer has no payment method on file.</p>
        <% if customer.billing_type == "invoice" %>
          <p class="color-fg-muted text-small">This is expected — customer is invoiced (sales serve).</p>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
