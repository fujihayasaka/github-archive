<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
  <% box.with_header do %>
    <div class="d-flex flex-items-center flex-justify-between">
      <h3 class="Box-title">
        <%= render(Primer::Beta::Octicon.new(icon: "sync", classes: "tmp-mr-2")) %>
        Zuora References
      </h3>
      <% if has_zuora_account? %>
        <%= render(Primer::Beta::Label.new(scheme: :success)) do %>
          <%= render(Primer::Beta::Octicon.new(icon: "check-circle", classes: "tmp-mr-1")) %>
          Linked
        <% end %>
      <% else %>
        <%= render(Primer::Beta::Label.new(scheme: :danger)) do %>
          <%= render(Primer::Beta::Octicon.new(icon: "x-circle", classes: "tmp-mr-1")) %>
          Not Linked
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if has_zuora_account? %>
    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Account ID</span>
        <span class="d-block col-8">
          <a href="<%= zuora_account_url_for_customer(customer) %>">
            <%= zuora_account_id %>
          </a>
        </span>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Account Number</span>
        <span class="d-block col-8"><%= zuora_account_number %></span>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Billing Type</span>
        <span class="d-block col-8"><%= billing_type_label %></span>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Auto Pay</span>
        <span class="d-block col-8">
          <% if auto_pay? %>
            <%= render(Primer::Beta::Label.new(scheme: :success)) { "Enabled" } %>
          <% else %>
            <%= render(Primer::Beta::Label.new(scheme: :attention)) { "Disabled" } %>
          <% end %>
        </span>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-start">
        <span class="d-block col-4 text-bold">Bill Cycle Day</span>
        <span class="d-block col-8"><%= bill_cycle_day %></span>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-center tmp-pt-2">
        <%= render(Primer::Alpha::Dialog.new(
          title: "Zuora Account Details — Customer ##{customer.id}",
          id: "zuora-inspect-dialog",
          size: :xlarge,
          position: :right,
          position_narrow: :right,
        )) do |dialog| %>
          <% dialog.with_show_button(size: :small, scheme: :invisible) do %>
            <%= render(Primer::Beta::Octicon.new(icon: "telescope", classes: "tmp-mr-1")) %>
            Inspect Full Zuora Account
          <% end %>
          <% dialog.with_body do %>
            <table class="stafftools-table width-full">
              <tr>
                <th class="text-bold tmp-p-2">Zuora Account ID</th>
                <td class="tmp-p-2"><code><%= zuora_account_id %></code></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Zuora Account Number</th>
                <td class="tmp-p-2"><code><%= zuora_account_number %></code></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Billing Type</th>
                <td class="tmp-p-2"><%= billing_type_label %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Auto Pay</th>
                <td class="tmp-p-2"><%= auto_pay? %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Bill Cycle Day</th>
                <td class="tmp-p-2"><%= bill_cycle_day %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">Purpose</th>
                <td class="tmp-p-2"><%= customer.purpose %></td>
              </tr>
              <tr>
                <th class="text-bold tmp-p-2">External UUID</th>
                <td class="tmp-p-2"><code><%= customer.external_uuid %></code></td>
              </tr>
            </table>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <% box.with_body(classes: "tmp-p-3") do %>
      <div class="blankslate">
        <%= render(Primer::Beta::Octicon.new(icon: "sync", size: :medium, color: :muted, classes: "tmp-mb-2")) %>
        <h3 class="blankslate-heading">No Zuora Account</h3>
        <p>This customer is not linked to a Zuora account.</p>
      </div>
    <% end %>
  <% end %>
<% end %>
