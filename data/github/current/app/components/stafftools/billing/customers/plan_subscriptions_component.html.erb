<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
  <% box.with_header do %>
    <div class="d-flex flex-items-center flex-justify-between">
      <h3 class="Box-title">
        <%= render(Primer::Beta::Octicon.new(icon: "package", classes: "tmp-mr-2")) %>
        Plan Subscriptions
        <%= render(Primer::Beta::Counter.new(count: plan_subscriptions.size, scheme: :primary, classes: "tmp-ml-1")) %>
      </h3>
    </div>
  <% end %>

  <% if has_subscriptions? %>
    <% plan_subscriptions.each do |subscription| %>
      <% box.with_row do %>
        <div>
          <div class="d-flex flex-items-center flex-justify-between tmp-mb-2">
            <div class="d-flex flex-items-center gap-2">
              <%= render(Primer::Beta::Octicon.new(icon: "package", classes: "tmp-mr-1")) %>
              <strong>Subscription #<%= subscription.id %></strong>
              <%= render(Primer::Beta::Label.new(scheme: :accent)) do %>
                <%= subscription_type_label(subscription) %>
              <% end %>
              <% if subscription.purpose.present? %>
                <%= render(Primer::Beta::Label.new(scheme: :secondary)) do %>
                  <%= subscription.purpose %>
                <% end %>
              <% end %>
            </div>
            <% if subscription.zuora_subscription_number.present? %>
              <span class="color-fg-muted text-small">
                Zuora: <code><%= subscription.zuora_subscription_number %></code>
              </span>
            <% end %>
          </div>

          <%# Expandable subscription items %>
          <% items = subscription.subscription_items %>
          <% if items.any? %>
            <%= render(Primer::Beta::Details.new) do |details| %>
              <% details.with_summary(role: "button") do %>
                <%= render(Primer::Beta::Octicon.new(icon: "chevron-right", classes: "tmp-mr-1")) %>
                <%= items.size %> subscription item(s)
              <% end %>
              <% details.with_body do %>
                <table class="stafftools-table width-full tmp-mt-2">
                  <thead>
                    <tr>
                      <th class="tmp-p-2">ID</th>
                      <th class="tmp-p-2">Subscribable</th>
                      <th class="tmp-p-2">Quantity</th>
                      <th class="tmp-p-2">Created</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% items.each do |item| %>
                      <tr>
                        <td class="tmp-p-2"><%= item.id %></td>
                        <td class="tmp-p-2">
                          <% if item.subscribable.present? %>
                            <%= item.subscribable_type %>
                            <span class="color-fg-muted">#<%= item.subscribable_id %></span>
                          <% else %>
                            <span class="color-fg-muted">—</span>
                          <% end %>
                        </td>
                        <td class="tmp-p-2"><%= item.quantity %></td>
                        <td class="tmp-p-2 color-fg-muted text-small"><%= item.created_at&.to_fs(:short) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              <% end %>
            <% end %>
          <% else %>
            <span class="color-fg-muted text-small">No subscription items</span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <% box.with_body(classes: "tmp-p-3") do %>
      <div class="blankslate">
        <%= render(Primer::Beta::Octicon.new(icon: "package", size: :medium, color: :muted, classes: "tmp-mb-2")) %>
        <h3 class="blankslate-heading">No Plan Subscriptions</h3>
        <p>This customer has no active plan subscriptions.</p>
      </div>
    <% end %>
  <% end %>
<% end %>
