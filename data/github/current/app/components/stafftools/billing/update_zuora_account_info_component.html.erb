<%= render(Primer::Experimental::Dialog.new(
  dialog_id: "update-zuora-account-info-dialog-#{customer_id}",
  header_variant: :large,
  width: :large,
  title: "Update Zuora Information",
  form_url: stafftools_billing_zuora_account_info_url,
  form_method: :put
)) do |c| %>
  <% button_options = {
    test_selector: "update-zuora-account-info-dialog-button",
    scheme: button_scheme
  } %>
  <% button_options[:float] = button_float if button_float %>
  <% c.with_show_button(**button_options) do |s| %>
    <%= button_text %>
  <% end %>
  <% c.with_body do %>
    <%= hidden_field_tag :customer_id, customer_id %>

    <%= render(Primer::Alpha::Banner.new(scheme: :warning, dismissible: false)) { "Take caution when updating Zuora information. Ensure that the information exists in Zuora before making any updates." } %>
    <p>
      This will update the Zuora account and subscription information for <strong><%= entity_name %></strong>.
    </p>
    <div class="form-group">
      <div class="form-group-header">
        <label for="zuora_account_id">Account ID</label>
      </div>
      <div class="form-group-body">
        <input
          id="zuora_account_id"
          name="zuora_account_id"
          type="text"
          class="form-control"
          value="<%= zuora_account_id %>"
          placeholder="<%= account_id_placeholder %>">
      </div>
    </div>
    <div class="form-group">
      <div class="form-group-header">
        <label for="zuora_account_number">Account Number</label>
      </div>
      <div class="form-group-body">
        <input
          id="zuora_account_number"
          name="zuora_account_number"
          type="text"
          class="form-control"
          value="<%= zuora_account_number %>"
          placeholder="<%= account_number_placeholder %>">
      </div>
    </div>
    <div class="form-group">
      <div class="form-group-header">
        <label for="zuora_subscription_id">Subscription ID</label>
      </div>
      <div class="form-group-body">
        <input
          id="zuora_subscription_id"
          name="zuora_subscription_id"
          type="text"
          class="form-control"
          value="<%= zuora_subscription_id %>"
          placeholder="<%= subscription_id_placeholder %>"
          <%= 'disabled="disabled" aria-disabled="true"' if !subscription_editable? %>>
      </div>
    </div>
    <div class="form-group">
      <div class="form-group-header">
        <label for="zuora_subscription_number">Subscription Number</label>
      </div>
      <div class="form-group-body">
        <input
          id="zuora_subscription_number"
          name="zuora_subscription_number"
          type="text"
          class="form-control"
          value="<%= zuora_subscription_number %>"
          placeholder="<%= subscription_number_placeholder %>"
          <%= 'disabled="disabled" aria-disabled="true"' if !subscription_editable? %>>
      </div>
    </div>
  <% end %>
  <% c.with_button(
    data: { "close-dialog-id": "update-zuora-account-info-dialog-#{customer_id}" }
  ) { "Cancel" } %>
  <% c.with_button(
    type: :submit,
    scheme: :primary,
    data: { "disable-with": "" }
  ) { "Update" } %>
<% end %>
