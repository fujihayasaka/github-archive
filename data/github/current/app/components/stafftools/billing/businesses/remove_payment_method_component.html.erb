<%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
  <% component.with_header(test_selector: "remove-payment-method-header") do %>
    Remove payment method
  <% end %>
  <% component.with_body do %>
    <p>
      This action allows you to remove all credit cards and PayPal accounts from this enterprise account.
    </p>

    <% if business.has_commercial_interaction_restriction? %>
      <p <%= test_selector "billing-payment-changes-disabled-text" %>>
        Removing payment methods is not available for commercially restricted enterprises.
      </p>
    <% else %>
      <p>
        The enterprise currently has payment methods on file. You can remove them by clicking the button below.
      </p>

      <%= render Stafftools::Billing::RemovePaymentMethodComponent.new(
        account: business,
        action_text: "Remove all payment methods")
      %>
    <% end %>
  <% end %>
<% end %>
