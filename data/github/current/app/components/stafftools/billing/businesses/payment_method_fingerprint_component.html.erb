<%= render(Primer::Beta::BorderBox.new(mb: 4, test_selector: "lookup-card-fingerprint")) do |component| %>
  <% component.with_header do %>
    Lookup card fingerprint
  <% end %>
  <% component.with_body do %>
    <p>
      This action allows you to lookup the card fingerprint for this enterprise account.
    </p>

    <%= form_tag lookup_stafftools_reused_card_fingerprints_path, method: :get do %>
      <%= hidden_field_tag "card_fingerprint", payment_method_fingerprint %>

      <%= render Primer::Beta::Button.new(type: :submit) do %>
        Lookup card fingerprint
      <% end %>
    <% end %>
  <% end %>
<% end %>
