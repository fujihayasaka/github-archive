<%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
  <% component.with_header(test_selector: "reset-billing-attempts-header") do %>
    Billing attempts
  <% end %>
  <% component.with_body do %>
    <div class="pb-2">
      <p> We have attempted to bill this account at least once. To remove their failed charge notifications, reset their
      billing attempts. (Note: This does not unlock the account)</p>
    </div>
    <%= render(Primer::Alpha::Dialog.new(
      id: "reset-billing-attempts-dialog",
      width: :large,
      title: "Reset attempts",
    )) do |dialog| %>
      <% dialog.with_show_button(
        test_selector: "reset-billing-attempts-button"
      ) { "Reset billing attempts" } %>
      <%= form_tag stafftools_enterprise_billing_reset_attempts_path(business), method: :patch do %>
        <%= render(Primer::Alpha::Dialog::Body.new) do %>
          <input type="hidden" name="operation" value="reset">
          <p>This enterprise currently has <strong><%= business.billing_attempts %></strong> attempts.</p>
          <p>Are you sure you want to reset billing attempts for <%= business.name %>?</p>
        <% end %>
        <%= render(Primer::Alpha::Dialog::Footer.new) do %>
          <%= render(Primer::Beta::Button.new(
            test_selector: "reset-billing-attempts-cancel-button"
          )) { "Cancel" } %>
          <%= render(Primer::Beta::Button.new(
            scheme: :danger,
            type: :submit,
            data: { "disable-with": "" }
          )) { "Reset billing attempts to 0" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
