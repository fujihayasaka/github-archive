<%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
<% component.with_header do |h| %>
    <div class="d-flex text-bold flex-justify-between">
      <div class="mt-1" id="billing-platform-customer-information">Billing Platform Customer Information</div>
    </div>
  <% end %>
  <% component.with_body do %>
    <%= render Primer::Alpha::Banner.new(scheme: :warning) do %>
       <% if is_azure_billed? %>
          This customer has their billing target set to Azure, so in order to be billable they need a Azure Subscription ID
        <% else%>
          This customer has their billing target set to Zuora, so in order to be billable they need to have a Zuora Account Number, Zuora Subscription and
          needs a payment method on file (if they are invoiced then that counts as a payment method).
        <%end %>
    <% end %>
    <div class="Box-row clearfix">
      <% if !@billing_platform_customer.is_a?(::Billing::Platform::Api::Error) %>
        <% if @customer.billed_via_billing_platform? %>
          <div class="mb-2">
            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">Billing Target: </span>
              <span class="d-block col-8"><%= billing_target %></span>
            </div>
            <% if is_azure_billed? %>
              <div class="d-flex flex-justify-start mb-2">
                <span class="d-block col-4 text-bold">Azure Subscription ID: </span>
                <span class="d-block col-8"><%= azure_subscription_id %></span>
              </div>
            <% else %>
              <div class="d-flex flex-justify-start mb-2">
                <span class="d-block col-4 text-bold">Zuora Account Number: </span>
                <span class="d-block col-8"><%= zuora_account_number %></span>
              </div>
              <div class="d-flex flex-justify-start mb-2">
                <span class="d-block col-4 text-bold">Has Zuora Subscription?: </span>
                <span class="d-block col-8"><%= has_zuora_subscription? %></span>
              </div>
              <div class="d-flex flex-justify-start mb-2">
                <span class="d-block col-4 text-bold">Has Payment Method?: </span>
                <span class="d-block col-8"><%= has_payment_method? %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <%= @billing_platform_customer.message %>
      <% end %>
    </div>
  <% end %>
<% end %>
