<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%= render(Primer::Beta::BorderBox.new) do |component| %>
  <% component.with_header do %>
    <h3 class="Box-title" <%= test_selector("committers_form_title") %>> <%= @sku.title %> Licenses</h3>
  <% end %>
  <% component.with_row do %>
    <div class="d-flex flex-justify-between">
      <span>Number of <%= @sku.title %> licenses being used:</span>
      <span class="no-wrap">
        <strong <%= test_selector("ghas-active-committers") %>><%= active_committers %></strong>
        <%= link_to download_active_committers_stafftools_user_advanced_security_path(this_user.login, sku: @sku.to_param),
          class: "btn-octicon ml-2 no-wrap" do %>
          <%= render(Primer::Beta::Octicon.new(icon: "download")) %> Download CSV
        <% end %>
      </span>
    </div>
    <div class="d-flex flex-justify-between">
      <span>Number of <%= @sku.title %> licenses that would be consumed by enabling for all repositories:</span>
      <span class="no-wrap">
        <strong <%= test_selector("ghas-maximum-committers") %>><%= maximum_committers %></strong>
        <%= link_to download_maximum_committers_stafftools_user_advanced_security_path(this_user.login, sku: @sku.to_param),
          class: "btn-octicon ml-2 no-wrap" do %>
          <%= render(Primer::Beta::Octicon.new(icon: "download")) %> Download CSV
        <% end %>
      </span>
    </div>
  <% end %>
  <% component.with_row do %>
    <h4 class="Box-title">Calculate Additional <%= @sku.title %> Licenses:</h4>
    <%= form_tag(request.path, :method => 'post') do %>
      <div class="my-4">
        <p>Enter or paste a list of repository names, one per line.</p>
      </div>

      <label for="ghas-entities" class="d-block clearfix">Repositories:</label>
      <div class="form-group <% if error.present? %>errored<% end %>">
        <textarea class="col-12 form-control" aria-describedby="ghas-entities-validation" style="min-height: 160px" id="ghas-entities" name="[entities][<%= @sku.to_param %>]"><%= params.fetch(:entities, {})[@sku.to_param] %></textarea>
        <% if error.present? %>
        <p class="note error" id="ghas-entities-validation" <%= test_selector("ghas-error") %>><%= error %></p>
        <% end %>
      </div>
      <p class="mb-2"><%= render Primer::ButtonComponent.new(type: :submit) do %>Recalculate<% end %></p>
      <% if additional_committers %>
      <div class="d-flex flex-justify-between">
        <span>Number of additional licenses required if <%= @sku.title %> was enabled for the above Organizations and Repositories:</span>
        <span class="no-wrap">
          <strong <%= test_selector("ghas-additional-committers") %>><%= additional_committers %></strong>
          <%= link_to "data:text/csv;base64,#{Base64.encode64(additional_committers_csv)}",
            download: "ghas_additional_committers_#{this_user.login}_#{Time.now.strftime("%F%H%M")}.csv",
            class: "btn-octicon ml-2 no-wrap" do %>
            <%= render(Primer::Beta::Octicon.new(icon: "download")) %> Download CSV
          <% end %>
        </span>
      </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
