<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%= form_tag stafftools_advanced_security_metered_services_locks_path, method: form_method do %>
  <div class="Box-row d-flex <%= "p-0" if disable_padding %>">
    <div class="d-flex flex-column col-10">
      <div class="mb-2">
        <%= primer_octicon(:"credit-card", mr: 1) %>
        <span><strong>Licensing state:</strong>
          <%= is_bundled ? "Bundled Advanced Security" : "Unbundled Code Security/Secret Protection" %>
        </span>
      </div>
      <% if is_locked %>
        <div>
          <%= primer_octicon(:x, color: :danger, mr: 1) %>
          <span>Metered services disabled</span>
        </div>
      <% else %>
        <div>
          <%= primer_octicon(:check, color: :success, mr: 1) %>
          <span>Metered services enabled</span>
        </div>
      <% end %>
    </div>

    <input type="hidden" value="<%= is_bundled %>" name="is_bundled">
    <input type="hidden" value="<%= entity.class.name %>" name="entity_type">
    <input type="hidden" value="<%= entity.id %>" name="entity_id">

    <div class="flex-items-center mt-2">
      <%= render Primer::ButtonComponent.new(type: :submit, scheme: :danger) do %><%= button_text %><% end %>
    </div>
  </div>
<% end %>
