<%# erblint:counter DeprecatedComponentsCounter 1 %>
<div class="Box-row d-flex flex-column <%= "p-0" if disable_padding %>">
  <div class="mb-2">
    <%= primer_octicon(:"credit-card", mr: 1) %>
    <span><strong>Licensing state:</strong>
      <%= is_bundled ? "Bundled Advanced Security" : "Unbundled Code Security/Secret Protection" %>
    </span>
  </div>

  <% sku_entries.each do |entry| %>
    <%= form_tag stafftools_advanced_security_metered_services_locks_path, method: entry[:locked] ? :delete : :post do %>
      <div class="d-flex flex-items-center py-1">
        <div class="col-10">
          <% if entry[:locked] %>
            <%= primer_octicon(:x, color: :danger, mr: 1) %>
            <span><%= entry[:label] %> metered services disabled</span>
            <% if entry[:reason] %>
              <%= render(Primer::Beta::Label.new(scheme: :danger, classes: "ml-1")) { reason_label(entry[:reason]) } %>
            <% end %>
          <% else %>
            <%= primer_octicon(:check, color: :success, mr: 1) %>
            <span><%= entry[:label] %> metered services enabled</span>
          <% end %>
        </div>

        <% entry[:hidden_fields].each do |name, value| %>
          <input type="hidden" name="<%= name %>" value="<%= value %>">
        <% end %>
        <input type="hidden" name="entity_type" value="<%= entity.class.name %>">
        <input type="hidden" name="entity_id" value="<%= entity.id %>">

        <div class="flex-items-center">
          <%= render Primer::ButtonComponent.new(type: :submit, scheme: :danger, size: :small) do %>
            <%= entry[:locked] ? "Unlock" : "Lock" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
