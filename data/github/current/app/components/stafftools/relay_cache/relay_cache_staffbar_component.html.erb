<relay-cache-staffbar data-catalyst-inline>
  <%= render(Primer::Beta::Button.new(
    type: :button,
    scheme: :link,
    id: "relay-cache-staffbar-indicator",
    hidden: true,
    color: :on_emphasis,
    "aria-label": "Relay cache status",
    data: { target: "relay-cache-staffbar.indicator" }
  )) do |button| %>
    <% button.with_tooltip(text: "This navigation used cached data", direction: :s) %>
    <span class="color-fg-subtle">•</span>
    <%= render(Primer::Beta::Octicon.new(
        icon: :cache,
        size: :small,
        color: :on_emphasis
      )) %>
    <span class="color-fg-subtle">•</span>
  <% end %>
</relay-cache-staffbar>
