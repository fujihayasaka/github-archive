<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading do %>
    <%= link_to "Safeguard limits", safeguard_limits_url, class: "Link--inTextBlock" %>
    / Enterprise limits
  <% end %>
<% end %>

<%= render Primer::Alpha::Banner.new(scheme: :danger) do %>
  <% if GitHub.single_business_environment? %>
    These limits are in place to prevent overloading system resources. Please contact support if you'd like to update these values.
  <% else %>
    This is for engineering use only. Please contact
    <a href="https://github-grid.enterprise.slack.com/archives/CFC9WQ53Q" class="Link--inTextBlock" target="_blank">#enterprise-primitives</a>
    if you'd like to update these values.
  <% end %>
<% end %>

<%= render(Primer::Beta::Heading.new(tag: :h3)) { "Default global limits" } %>
<p>
  The default global enterprise limits are listed below for reference.
</p>

<div>
  <div>
    <strong>Organizations per enterprise limit</strong>:
    <%= number_with_delimiter(GitHub.default_organizations_per_business_limit) %>
  </div>

  <div>
    <strong>Organizations per enterprise soft limit</strong>:
    <%= number_with_delimiter(GitHub.default_organizations_per_business_soft_limit) %>
  </div>
</div>

<div>
  <div>
    <strong>Members per enterprise limit</strong>:
    <%= number_with_delimiter(GitHub.default_members_per_business_limit) %>
  </div>

  <div>
    <strong>Members per enterprise soft limit</strong>:
    <%= number_with_delimiter(GitHub.default_members_per_business_soft_limit) %>
  </div>
</div>

<% if global_target? %>
  <%= render(Primer::Beta::Heading.new(tag: :h3, classes: "tmp-mt-4")) { "Configured global limits" } %>
  <p>
    You can set the global limits below. Global limits may also be overridden
    at the individual enterprise level.
  </p>
<% else %>
  <%= render(Primer::Beta::Heading.new(tag: :h3, classes: "tmp-mt-4")) { "Configured enterprise limits" } %>
  <p>
    You can set the limits for this enterprise below. The limits set for this enterprise override the
    <%= link_to \
      "global enterprise limits",
      stafftools_enterprise_limits_path,
      class: "Link--inTextBlock" %>.
  </p>
<% end %>

<%= form_with(
  url: form_url,
  method: "patch",
  data: { test_selector: "business-limits-form" }
) do |form| %>

  <%= render(Primer::Beta::Heading.new(tag: :h4, mb: 2, classes: "tmp-mt-4")) { "Organizations per enterprise" } %>

  <% unless global_target? %>
    <% if limits_target.organizations_limit_reached? %>
      <%= render(Primer::Alpha::Banner.new(
        icon: :stop,
        scheme: :danger,
        test_selector: "organizations-current-state",
        classes: "tmp-mb-3")) { organizations_current_state } %>
    <% elsif limits_target.organizations_soft_limit_reached? %>
      <%= render(Primer::Alpha::Banner.new(
        icon: :alert,
        scheme: :warning,
        test_selector: "organizations-current-state",
        classes: "tmp-mb-3")) { organizations_current_state } %>
    <% else %>
      <%= render(Primer::Alpha::Banner.new(
        icon: :info,
        scheme: :default,
        test_selector: "organizations-current-state",
        classes: "tmp-mb-3")) { organizations_current_state } %>
    <% end %>
  <% end %>

  <dl class="form-group">
    <dt>
      <%= form.label "Hard limit", for: "organizations_per_business_limit" %>
    </dt>
    <dd>
      <%= form.text_field \
        :organizations_per_business_limit,
        id: :organizations_per_business_limit,
        class: "form-control",
        value: organizations_per_business_limit %>
    </dd>
  </dl>

  <dl class="form-group">
    <dt>
      <%= form.label "Soft limit", for: "organizations_per_business_soft_limit" %>
    </dt>
    <dd>
      <%= form.text_field \
        :organizations_per_business_soft_limit,
        id: :organizations_per_business_soft_limit,
        class: "form-control",
        value: organizations_per_business_soft_limit %>
    </dd>
  </dl>

  <%= render(Primer::Beta::Heading.new(tag: :h4, mb: 2, classes: "tmp-mt-4")) { "Members per enterprise" } %>

  <% unless global_target? %>
    <% if limits_target.members_limit_reached? %>
      <%= render(Primer::Alpha::Banner.new(
        icon: :stop,
        scheme: :danger,
        test_selector: "members-current-state",
        classes: "tmp-mb-3")) { members_current_state } %>
    <% elsif limits_target.members_soft_limit_reached? %>
      <%= render(Primer::Alpha::Banner.new(
        icon: :alert,
        scheme: :warning,
        test_selector: "members-current-state",
        classes: "tmp-mb-3")) { members_current_state } %>
    <% else %>
      <%= render(Primer::Alpha::Banner.new(
        icon: :info,
        scheme: :default,
        test_selector: "members-current-state",
        classes: "tmp-mb-3")) { members_current_state } %>
    <% end %>
  <% end %>

  <dl class="form-group">
    <dt>
      <%= form.label "Hard limit", for: "members_per_business_limit" %>
    </dt>
    <dd>
      <%= form.text_field \
        :members_per_business_limit,
        id: :members_per_business_limit,
        class: "form-control",
        value: members_per_business_limit %>
    </dd>
  </dl>

  <dl class="form-group">
    <dt>
      <%= form.label "Soft limit", for: "members_per_business_soft_limit" %>
    </dt>
    <dd>
      <%= form.text_field \
        :members_per_business_soft_limit,
        id: :members_per_business_soft_limit,
        class: "form-control",
        value: members_per_business_soft_limit %>
    </dd>
  </dl>

  <%= render(Primer::Beta::Button.new(
    type: :submit,
    data: { disable_with: "" }
  )) { "Update" } %>
<% end %>

<% unless global_target? %>
  <div>
    <%= render(Primer::Alpha::Dialog.new(
      id: "reset-limits",
      title: "Confirm reset to global enterprise limits"
    )) do |c| %>
      <% c.with_show_button(
        scheme: :danger,
        mt: 3
      ) do |c| %>
        Reset to global enterprise limits
      <% end %>
      <% c.with_header(show_divider: true) do %>
          Confirm reset to global enterprise limits
      <% end %>
      <% c.with_body do %>
        <p>
          This will reset all the currently configured limit values shown above to the global enterprise limit values.
        </p>
      <% end %>
      <% c.with_footer(show_divider: true) do %>
        <%= render(Primer::Beta::Button.new(
          data: { "close-dialog-id": "reset-limits" }
        )) { "Cancel" } %>

        <%= form_with(
          url: form_url,
          method: "delete",
          data: { test_selector: "business-limits-reset-form" }
        ) do |form| %>
          <%= render(Primer::Beta::Button.new(
            scheme: :danger,
            type: :submit,
            data: { disable_with: "" }
          )) { "Reset to global enterprise limits" } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
