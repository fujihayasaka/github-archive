<%= form_with(model: multiplier, url: form_url, method: form_method) do |f| %>
  <div class="form-group">
    <div class="form-group-header">
      <label class="f4" for="kind">Models slug (required)</label>
    </div>
    <div class="form-group-body" <%= test_selector("models-slug") %>>
      <%=
        f.select(
          :models_slug,
          existing_models_slugs,
          {},
          class: "form-select",
          required: true,
          id: "slug",
          aria: { label: "Select a Model slug to #{action.downcase} the multiplier pricing for" },
        )
      %>
    </div>
  </div>
  <div class="form-group">
    <div class="form-group-header">
      <label class="f4" for="kind">Input multiplier (required)</label>
    </div>
    <div class="form-group-body" <%= test_selector("input-multiplier") %>>
      <%=
        f.number_field(
          :input,
          class: "form-control",
          required: true,
          id: "input-multiplier",
          min: 0.0001,
          step: 0.00001,
          max: 99999.99999,
          aria: { label: "Enter a multiplier for input tokens" },
        )
      %>
    </div>
  </div>
  <div class="form-group">
    <div class="form-group-header">
      <label class="f4" for="kind">Cached input multiplier</label>
    </div>
    <div class="form-group-body" <%= test_selector("cached-input-multiplier") %>>
      <%=
        f.number_field(
          :cached_input,
          class: "form-control",
          required: false,
          id: "cached-input-multiplier",
          min: 0.0001,
          step: 0.00001,
          max: 99999.99999,
          aria: { label: "Enter a multiplier for cached input tokens" },
        )
      %>
    </div>
  </div>
  <div class="form-group">
    <div class="form-group-header">
      <label class="f4" for="kind">Output token multiplier (required)</label>
    </div>
    <div class="form-group-body" <%= test_selector("output-multiplier") %>>
      <%=
        f.number_field(
          :output,
          class: "form-control",
          required: true,
          id: "output-multiplier",
          min: 0.0001,
          step: 0.00001,
          max: 99999.99999,
          aria: { label: "Enter a multiplier for output tokens" },
        )
      %>
    </div>
  </div>
  <div class="form-actions d-flex">
    <%= render Primer::Beta::Button.new(
      type: :submit,
      scheme: :primary,
      ).with_content("#{action} multiplier pricing") %>
    <% if multiplier.persisted? %>
      <%= button_to stafftools_models_multiplier_path(multiplier), method: :delete, data: { confirm: "Are you sure you want to delete this multiplier? If a model has no multiplier it defaults to free tier rules." }, class: "btn btn-danger ml-3" do %>
        Delete
      <% end %>
    <% end %>
  </div>
<% end %>
