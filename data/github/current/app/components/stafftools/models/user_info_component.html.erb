<div class="site-admin-box">
  <h4>
    <%= primer_octicon(:"ai-model") %>
    <%= link_to "GitHub Models", stafftools_user_models_path(user) %>
  </h4>
  <ul class="site-admin-detail-list">
    <li>
      <% if organization %>
        <% if models_enabled? %>
          <%= render(Primer::Beta::Octicon.new(:check)) %>
          Models is enabled
        <% else %>
          <%= render(Primer::Beta::Octicon.new(icon: "x")) %>
          Models is not enabled
        <% end %>
      <% else %>
        <% if has_models_access? %>
          <%= primer_octicon(:check) %>
          Has access to Models
        <% else %>
          <%= primer_octicon(:"circle-slash", color: :danger) %>
          Has been blocked from Models: <%= access_reason %>
        <% end %>
      <% end %>
    </li>
    <li>
      <% if models_billing_enabled? %>
        <%= render(Primer::Beta::Octicon.new(:check)) %>
        Billing is enabled
      <% else %>
        <%= render(Primer::Beta::Octicon.new(icon: "x")) %>
        Billing is not enabled
      <% end %>
    </li>
    <li <%= test_selector("custom-models-count") %>>
      <%= total_custom_models %> custom <%= "model".pluralize(total_custom_models) %>
    </li>
  </ul>
</div>
