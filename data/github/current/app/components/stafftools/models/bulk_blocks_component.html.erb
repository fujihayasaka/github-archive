<%= render(Primer::Alpha::Dialog.new(
  title: "Block users in bulk",
  id: "listing-approval",
  size: :large,
  test_selector: "models-bulk-block-form",
)) do |d| %>
  <% d.with_header(show_divider: true, font_weight: :bold) { "Block users in bulk" } %>
  <% d.with_show_button(scheme: :primary) { "Block users in bulk" } %>
  <% d.with_body do %>
    <%= form_tag stafftools_models_bulk_block_path, method: "post" do %>
      <div class="form-group">

        <div class="form-group required">
          <div class="form-group-header">
            <%= label_tag "reason", "Block reason" %>
          </div>
          <div class="form-group-body" <%= test_selector("reason-select") %>>
            <%= select_tag(
              :reason,
              options_for_select(block_reasons),
              required: true,
              include_blank: true,
              class: "color-bg-subtle p-2 border rounded-2 input-block"
            ) %>
          </div>
        </div>

        <div class="form-group full-width">
          <div class="form-group-header">
            <%= label_tag "additional_information", "Extra context for the block" %>
          </div>
          <div class="form-group-body" <%= test_selector("additional-information-text") %>>
            <%= text_field_tag(
              :additional_information,
              '',
              required: false,
              class: "color-bg-subtle p-2 border rounded-2 input-block",
              placeholder: "Link to an issue or ICM, or add other supporting information."
            ) %>
          </div>
        </div>

        <div class="form-group required">
          <div class="form-group-header">
            <%= label_tag "logins", "User logins to block (separated by spaces or commas, quotes optional)" %>
          </div>
          <div class="form-group-body" <%= test_selector("logins-text") %>>
            <%= text_area_tag :logins, '', required: true, class: "color-bg-subtle p-2 border rounded-2 input-block" %>
          </div>
        </div>

      </div>
      <%= submit_tag "Block users from Models", class: "btn btn-danger" %>
    <% end %>
  <% end %>
<% end %>
