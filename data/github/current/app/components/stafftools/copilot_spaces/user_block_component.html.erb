<% if user.present? %>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "tmp-mt-3")) do |border_box| %>
    <% border_box.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Copilot Spaces Access Control
      <% end %>
    <% end %>

    <% border_box.with_row do %>
      <div class="js-details-container Details">
        <%= render Primer::Beta::Button.new(
          href: "#",
          scheme: spaces_blocked? ? :primary : :danger,
          classes: "js-details-target",
          "aria-expanded": "false",
          title: "Please note that the UI may need to be refreshed to display your changes",
          "aria-label": "#{spaces_blocked? ? 'Unblock' : 'Block'} Spaces Access - Please refresh the page after action"
        ) do %>
          <%= spaces_blocked? ? "Unblock" : "Block" %> Spaces Access
        <% end %>

        <div class="mt-1">
          <span class="text-small color-fg-muted d-flex flex-items-center gap-1">
            <%= primer_octicon("info", size: :small) %>
            Refresh page after <%= spaces_blocked? ? 'unblocking' : 'blocking' %> to see updated status
          </span>
        </div>

        <div class="Details-content--hidden tmp-mt-3">
          <h4><%= spaces_blocked? ? "Unblock" : "Block" %> Copilot Spaces Access</h4>

          <% if spaces_blocked? %>
            <p class="color-fg-danger mb-2">
              <strong>User is currently blocked from Copilot Spaces</strong>
            </p>

            <%= form_with url: stafftools_user_copilot_spaces_user_block_path(user), method: :delete, local: true do |form| %>
              <%= form.label :reason, "Unblock Reason:" %>
              <%= form.text_area :reason, placeholder: "Enter reason for unblocking...", required: true, rows: 3, class: "form-control width-full mb-2" %>
              <%= form.submit "Unblock User from Copilot Spaces", class: "btn btn-primary" %>
            <% end %>
          <% else %>
            <p class="tmp-mb-3">
              This will block the user from accessing Copilot Spaces specifically, while allowing access to other Copilot features.
            </p>

            <%= form_with url: stafftools_user_copilot_spaces_user_block_path(user), method: :post, local: true do |form| %>
              <%= form.label :reason, "Block Reason:" %>
              <%= form.text_area :reason, placeholder: "Enter reason for blocking...", required: true, rows: 3, class: "form-control width-full mb-2" %>
              <%= form.submit "Block User from Copilot Spaces", class: "btn btn-danger" %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
