<div class="site-admin-box">
  <h4>
    <%= primer_octicon(:space) %>
    <%= link_to "Copilot Spaces", stafftools_user_copilot_spaces_path(user) %>
  </h4>
  <ul class="site-admin-detail-list">
    <li>
      <% if organization %>
        <%= primer_octicon(:info) %>
        Organization spaces
      <% else %>
        <% if has_copilot_access? %>
          <%= primer_octicon(:check, color: :success) %>
          Has Copilot access
        <% else %>
          <%= primer_octicon(:"circle-slash", color: :danger) %>
          No Copilot access
        <% end %>
      <% end %>
    </li>
    <% unless organization %>
      <li>
        <% if has_copilot_spaces_access? %>
          <%= primer_octicon(:check, color: :success) %>
          Has Copilot Spaces access
        <% else %>
          <%= primer_octicon(:"circle-slash", color: :danger) %>
          Blocked from Copilot Spaces
        <% end %>
      </li>
    <% end %>
    <% unless total_copilot_spaces.zero? && spaces_count_error? %>
      <li <%= test_selector("copilot-spaces-count") %>>
        <%= total_copilot_spaces %> total <%= "space".pluralize(total_copilot_spaces) %>
      </li>
    <% end %>
    <% if total_copilot_spaces > 0 %>
      <li>
        <%= primer_octicon(:eye) %>
        <% if organization %>
          <%= total_public_spaces %> org public
        <% else %>
          <%= total_public_spaces %> public
        <% end %>
        <% if total_private_spaces > 0 %>
          , <%= total_private_spaces %> private
        <% end %>
        <% if total_shared_private_spaces > 0 %>
          , <%= total_shared_private_spaces %> shared with collaborators
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if spaces_count_error? %>
    <%= render Primer::Alpha::Banner.new(
      scheme: :danger,
    ) do %>
      Could not load spaces count
    <% end %>
  <% end %>
</div>
