<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading do %>
    <%= link_to "Safeguard limits", safeguard_limits_url, class: "Link--inTextBlock" %> /
    Organization team limits
  <% end %>
<% end %>

<%= render Primer::Alpha::Banner.new(scheme: :danger) do %>
  <% if GitHub.single_business_environment? %>
    These limits are in place to prevent overloading system resources. Please contact support if you'd like to update these values.
  <% else %>
    This is for engineering use only. Please contact
    <a href="https://github-grid.enterprise.slack.com/archives/CFC9WQ53Q" class="Link--inTextBlock" target="_blank">#enterprise-primitives</a>
    if you'd like to update these values.
  <% end %>
<% end %>

<%= render(Primer::Beta::Heading.new(tag: :h3)) { "Default global limits" } %>
<p>
  The default global organization team limits are listed below for reference.
</p>

<div>
  <div>
    <strong>Members per organization team limit</strong>:
    <%= number_with_delimiter(GitHub.default_members_per_org_team_limit) %>
  </div>

  <div>
    <strong>Members per organization team soft limit</strong>:
    <%= number_with_delimiter(GitHub.default_members_per_org_team_soft_limit) %>
  </div>
</div>

<% if global_target? %>
  <%= render(Primer::Beta::Heading.new(tag: :h3, classes: "tmp-mt-4")) { "Configured global limits" } %>
  <p>
    You can set the global limits below. Global limits may also be overridden
    at the individual organization level.
  </p>
<% else %>
  <%= render(Primer::Beta::Heading.new(tag: :h3, classes: "tmp-mt-4")) { "Configured organization limits" } %>
  <p>
    You can set the limits for this organization below. The limits set for this organization override the
    <%= link_to \
      "global organization team limits",
      stafftools_organization_team_limits_path,
      class: "Link--inTextBlock" %>.
  </p>
<% end %>

<%= form_with(
  url: form_url,
  method: "patch",
  data: { test_selector: "organization-team-limits-form" }
) do |form| %>

  <%= render(Primer::Beta::Heading.new(tag: :h4, mb: 2, classes: "tmp-mt-4")) { "Members per organization team" } %>

  <dl class="form-group">
    <dt>
      <%= form.label "Hard limit", for: "members_per_org_team_limit" %>
    </dt>
    <dd>
      <%= form.text_field \
        :members_per_org_team_limit,
        id: :members_per_org_team_limit,
        class: "form-control",
        value: members_per_org_team_limit %>
    </dd>
  </dl>

  <dl class="form-group">
    <dt>
      <%= form.label "Soft limit", for: "members_per_org_team_soft_limit" %>
    </dt>
    <dd>
      <%= form.text_field \
        :members_per_org_team_soft_limit,
        id: :members_per_org_team_soft_limit,
        class: "form-control",
        value: members_per_org_team_soft_limit %>
    </dd>
  </dl>

  <%= render(Primer::Beta::Button.new(
    type: :submit,
    data: { disable_with: "" }
  )) { "Update" } %>
<% end %>

<% unless global_target? %>
  <div>
    <%= render(Primer::Alpha::Dialog.new(
      id: "reset-limits",
      title: "Confirm reset to global organization team limits"
    )) do |c| %>
      <% c.with_show_button(
        scheme: :danger,
        mt: 3
      ) do |c| %>
        Reset to global organization team limits
      <% end %>
      <% c.with_header(show_divider: true) do %>
          Confirm reset to global organization team limits
      <% end %>
      <% c.with_body do %>
        <p>
          This will reset all the currently configured limit values shown above to the global organization team
          limit values.
        </p>
      <% end %>
      <% c.with_footer(show_divider: true) do %>
        <%= render(Primer::Beta::Button.new(
          data: { "close-dialog-id": "reset-limits" }
        )) { "Cancel" } %>

        <%= form_with(
          url: form_url,
          method: "delete",
          data: { test_selector: "organization-team-limits-reset-form" }
        ) do |form| %>
          <%= render(Primer::Beta::Button.new(
            scheme: :danger,
            type: :submit,
            data: { disable_with: "" }
          )) { "Reset to global organization team limits" } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
