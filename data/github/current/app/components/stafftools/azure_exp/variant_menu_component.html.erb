<%= render(Primer::Alpha::ActionMenu.new(size: :small, test_selector: "variant-action-menu")) do |menu| %>
  <% menu.with_show_button(test_selector: "variant-override-button") do |button| %>
    <% button.with_trailing_action_icon(icon: :"triangle-down") %>
    <span class="text-light mr-1">Override: </span>
    <%= render(Primer::Beta::Truncate.new(test_selector: "assigned-variant-override" )) { value } %>
  <% end %>
  <% menu.with_item(**menu_item_arguments) { "None" } %>
  <% experiment.variants.each do |variant| %>
    <%= menu.with_item(**menu_item_arguments(variant:)) { variant.name } %>
  <% end %>
<% end %>
