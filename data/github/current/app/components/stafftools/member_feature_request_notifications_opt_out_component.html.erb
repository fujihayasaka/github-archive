<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h2) { "Member feature requests" } %>
<% end %>

<%= form_tag form_path, method: :patch do %>
  <div class="form-checkbox" <%= test_selector "opt_out_of_member_feature_request_notifications" %>>
    <input type="checkbox"
      id="opt_out_of_member_feature_request_notifications_checkbox"
      name="opt_out_of_member_feature_request_notifications"
      <%= "checked" if entity.opted_out_of_member_feature_request_notifications? %>>
    <label for="opt_out_of_member_feature_request_notifications_checkbox">
      Opt the <%= entity_description %> out of member feature request notifications
    </label>
    <p class="note color-fg-muted">
      If this is checked, the <%= entity_description %> will not receive member feature request notifications.
    </p>
  </div>
  <%= render(Primer::Beta::Button.new(type: :submit, mb: 6)) { "Save" } %>
<% end %>
