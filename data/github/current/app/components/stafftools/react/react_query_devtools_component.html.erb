<react-query-devtools data-catalyst-inline>
  <%= render(Primer::Beta::Button.new(
    id: "react-query-devtools-toggle",
    size: :small,
    scheme: :link,
    color: :on_emphasis,
    "data-target": "react-query-devtools.toggleDevtoolsVisibilityButton",
    "data-action": "click:react-query-devtools#toggleDevtoolsVisibility",
    "aria-label": "Open react query devtools panel",
  )) do |c| %>
    <% c.with_tooltip(text: "Open react query devtools panel") %>
    <%= render(Primer::Beta::Octicon.new(icon: :tools, size: :small, style: {"pointer-events": 'none'})) %>
  <% end %>
  <div  data-target="react-query-devtools.panelRootElement"></div>
</react-query-devtools>
