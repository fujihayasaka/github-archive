<react-query-devtools data-catalyst-inline>
  <%= render(Primer::Beta::Button.new(
    id: "react-query-devtools-toggle",
    size: :small,
    scheme: :link,
    color: :on_emphasis,
    data: hydro_click_tracking_attributes("staff_bar.toggle_react_query_devtools.click", {}).merge(
      target: "react-query-devtools.toggleDevtoolsVisibilityButton",
      action: "click:react-query-devtools#toggleDevtoolsVisibility",
    ),
    "aria-label": "Open react query devtools panel",
    "aria-controls": "_gh_react-query-devtools-panel",
    "aria-expanded": "false",
  )) do |c| %>
    <% c.with_tooltip(text: "Open react query devtools panel") %>
    <%= render(Primer::Beta::Octicon.new(icon: :tools, size: :small, style: {"pointer-events": 'none'})) %>
  <% end %>
  <div id="_gh_react-query-devtools-panel" aria-label="Developer Tools Panel" role="region" data-target="react-query-devtools.panelRootElement"></div>
</react-query-devtools>
