<react-staffbar data-catalyst-inline hidden>
  <%= render(Primer::Alpha::Dialog.new(title: "React Dev Tools", color: :default)) do |dialog| %>
    <% dialog.with_show_button(scheme: :link, color: :on_emphasis, classes: ["Link--inTextBlock"], "aria-label": "React payload size", data: { hydro_click: hydro_click_tracking_attributes("staff_bar.view_payload.click", {}), target: "react-staffbar.viewPayloadButton" }) do |button| %>
      <% button.with_tooltip(text: "View React payload size", direction: :s) %>
        <span id="react-staffbar-icon" class="cursor-pointer" role="button">⚛️</span>
        <span data-target="react-staffbar.payloadSize"></span>
    <% end %>
    <% dialog.with_body(classes: 'ws-normal') do %>
      <p data-target="react-staffbar.payloadText">Calculating the size of the payload.</p>
      <p><%= render(Primer::Beta::Button.new(scheme: :link, classes: ["Link--inTextBlock"], data: hydro_click_tracking_attributes("staff_bar.log_payload.click", {}).merge(target: "react-staffbar.logPayloadButton"))) { "Console.log the payload" } %></p>
      <p><%= render(Primer::Beta::Button.new(scheme: :link, classes: ["Link--inTextBlock"], data: hydro_click_tracking_attributes("staff_bar.log_router_data.click", {}).merge(target: "react-staffbar.logRouterDataButton"), hidden: true)) { "Console.log router state" } %></p>
      <%# target for this link is generated in client code %>
      <p><%= render(Primer::Beta::Link.new(href: "#", classes: ["Link--inTextBlock"], data: hydro_click_tracking_attributes("staff_bar.vernier_link.click", {}).merge(target: "react-staffbar.vernierLink"))) { "Vernier profile. Open in https://vernier.prof." } %></p>
      <p><%= render(Primer::Beta::Button.new(scheme: :link, classes: ["Link--inTextBlock"], data: hydro_click_tracking_attributes("staff_bar.enable_react_scan.click", {}).merge(target: "react-staffbar.enableReactScanButton"))) { "Enable React Scan" } %></p>
      <p>
        <%= render(Primer::Beta::Button.new(
          scheme: :link,
          classes: ["Link--inTextBlock"],
          data: { hydro_click: hydro_click_tracking_attributes("staff_bar.highlight_packages.click", {}), target: "react-staffbar.highlightPackagesButton", action: "click:react-staffbar#toggleHighlightPackages" }
        )) do %>
          <span data-target="react-staffbar.highlightPackagesButtonText">Highlight React packages</span>
        <% end %>
      </p>
      <p>
        <%= render(Primer::Beta::Button.new(
          scheme: :link,
          classes: ["Link--inTextBlock"],
          data: { target: "react-staffbar.analyticsLoggingButton", action: "click:react-staffbar#toggleAnalyticsLogging" }
        )) do %>
          <span data-target="react-staffbar.analyticsLoggingButtonText">Enable analytics logging</span>
        <% end %>
      </p>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::Link.new(color: :on_emphasis, href: "https://github.com/github/alloy", target: "_blank", rel: "noopener noreferrer", id: "staffbar_ssr_success", ml: 1, data: hydro_click_tracking_attributes("staff_bar.ssr_alloy_success.click", {}).merge(target: "react-staffbar.ssrLink"))) do |component| %>
    <% component.with_tooltip(text: "This react app has been rendered by Alloy. Click to show more details.") %>
    <%= render(Primer::Beta::Octicon.new(icon: :check, size: :small, "aria-label": "SSR Successful")) %>
    SSR
  <% end %>
  <%= render(Primer::Beta::Link.new(href: "https://github.com/github/alloy", target: "_blank", rel: "noopener noreferrer", id: "staffbar_ssr_error", ml: 1, data: hydro_click_tracking_attributes("staff_bar.ssr_alloy_error.click", {}).merge(target: "react-staffbar.ssrError"), color: :on_emphasis)) do |component| %>
    <% component.with_tooltip(text: "There was an error server-side rendering this app in Alloy. Check the console for the error message.") %>
    🚨<s>SSR</s>🚨
  <% end %>
  <%= render(Primer::Beta::Link.new(color: :on_emphasis, href: "https://thehub.github.com/epd/engineering/dev-practicals/frontend/react/data-router/", target: "_blank", rel: "noopener noreferrer", id: "staffbar_dr_success", ml: 1, data: hydro_click_tracking_attributes("staff_bar.data_router_success.click", {}).merge(target: "react-staffbar.dataRouterLink"))) do |component| %>
    <% component.with_tooltip(text: "This react app has been rendered using Data Router. Click to show more details.") %>
    <%= render(Primer::Beta::Octicon.new(icon: :check, size: :small, "aria-label": "DR Successful")) %>
    DR
  <% end %>
</react-staffbar>
