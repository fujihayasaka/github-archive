<%= render Primer::Beta::BorderBox.new(padding: :condensed, mb: 5) do |component| %>
  <% component.with_header do %>
    <h3 class="h5">Lost stars and watchers recovery</h3>
  <% end %>
  <% component.with_body(
    display: :flex,
    align_items: :flex_start,
    direction: :row,
    justify_content: :space_between,
    classes: "lh-default mt-1",
  ) do %>
      <div>
        <h4>Recover lost social data</h4>
        <p>Recover star and watcher data lost due to repository visibility changes within the last 90 days.</p>
        <% if recovery_status_message %>
          <p <%= test_selector "recovery-status-message" %>>
            <%= recovery_status_message %>
            <% if recovery_in_progress? %>
              <relative-time class="text-bold" format="elapsed" datetime="<%= recovery_in_progress_elapsed_time %>"><%= recovery_in_progress_elapsed_time %></relative-time>
            <% end %>
          </p>
        <% end %>
      </div>
      <div>
        <%= form_with url: stafftools_repository_restorable_recoveries_path(@repository.owner, @repository), method: :post do %>
          <%= render Primer::Beta::Button.new(
            type: :submit,
            mb: 2,
            disabled: !recovery_data_available? || (recovery_data_available? && @repository.private?),
            test_selector: "restorable-recovery-button",
          ) do %>
              Recover
          <% end %>
        <% end %>
        <% if recovery_in_progress? %></p>
          <%= form_with url: stafftools_repository_restorable_recoveries_path(@repository.owner, @repository), method: :delete do %>
            <%= render Primer::Beta::Button.new(
              type: :submit,
              test_selector: "cancel-restorable-recovery-button",
            ) do %>
                Cancel
            <% end %>
          <% end %>
        <% end %>
      </div>
  <% end %>
<% end %>
