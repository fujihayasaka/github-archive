<li class="Box-row">
  <h4>SDN Suspension</h4>
  <% if !authorized_staffer? %>
    <p <%= test_selector "trade-restriction-unauthorized" %>><%= helpers.stafftools_not_authorized_html %></p>
  <% else %>
    <% if sales_managed_enterprise?(target:) %>
      <p <%= test_selector "trade-restriction-sales-managed" %>><%= ::TradeControls::Notices.stafftools_trade_screening_sales_managed %></p>
    <% end %>
    <%= render(Primer::Alpha::Dialog.new(title: title, size: :medium_portrait)) do |dialog| %>
      <% dialog.with_show_button(scheme: :danger, float: :right, :"aria-label" => title) do %>
        <%= title %>
      <% end %>
      <% dialog.with_body(classes: 'ws-normal') do %>
        <%= form_for(target, url: form_path, method: form_method, html: { "data-test-selector": "sdn-#{prefix}suspension-form" }) do |f| %>
          <label for="reason">
            Reason:
            <input name="reason" type="text" class="form-control input-block mt-1 mb-2" required>
          </label>
          <div class="Box-body">
            Are you sure you want to perform SDN <%= prefix %>suspension for <%= target.name %>?
            <input type="hidden" name="id" value="<%= target.name %>">
            <div class="mt-2">
              <p class="mb-1">This account is a <strong><%= target.paid_plan? ? "paying" : "free" %></strong> account.</p>
              <p>This account:</p>
              <ul class="ml-3 mb-2">
                <%= repository_count %>
                <%= member_count %>
                <%= organization_count %>
              </ul>
              <div>
                SDN <%= prefix %>suspending the account will <%= prefix %>suspend their account.
              </div>
            </div>
          </div>
          <div class="Box-footer">
            <%= render Primer::Beta::Button.new(type: :submit, block: true, scheme: :danger,) do %>
              <%= title %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <div <%= test_selector "trade-restriction-sdn-#{prefix}suspension" %>>
      <%= suspension_warning %>
      <p>This account is currently <strong><%= target.trade_screening_status %></strong></p>
    </div>
  <% end %>
</li>
