<li class="Box-row">
  <h4>
    Billing Information
  </h4>
  <% if authorized_staffer? %>
    <div class="d-flex flex-justify-between flex-items-center">
      <p>
        <% if edit_mode %>
          Edit billing information for this account.
        <% else %>
          View billing information for this account.
        <% end %>
        <br>
        <%= description %>
      </p>
      <div class="d-flex gap-2">
        <% if allowed_to_view_billing_info? && !edit_mode %>
          <%= form_tag controller_path, method: action do %>
            <%= hidden_field_tag :mode, "show" %>
            <%= render Primer::Beta::Button.new(
              type: :submit,
              scheme: :danger,
            ).with_content(button_text) %>
          <% end %>
          <% if authorized_staffer_to_edit? %>
            <%= form_tag controller_path, method: action do %>
              <%= hidden_field_tag :mode, "edit" %>
              <%= render Primer::Beta::Button.new(
                type: :submit,
                scheme: :danger,
              ).with_content("Edit Billing Information") %>
            <% end %>
          <% end %>
        <% end %>
        <% if edit_mode %>
          <%= link_to "Cancel Edit",
                      "#{controller_path}?show_billing_info=true",
                      class: "btn btn-outline" %>
        <% end %>
      </div>
    </div>
    <% if render_info? %>
      <div <%= test_selector "billing-information-data" %>>
        <% if user_owned? %>
          <p class="mt-2" <%= test_selector "first_name" %>>
            <strong>First name:</strong> <%= first_name %>
          </p>

          <p <%= test_selector "last_name" %>>
            <strong>Last name:</strong> <%= last_name %>
          </p>
        <% else %>
          <p class="mt-2" <%= test_selector "entity_name" %>>
            <strong>Entity name:</strong> <%= entity_name %>
          </p>
        <% end %>
        <p <%= test_selector "address1" %>>
          <strong>Address1:</strong> <%= address1 %>
        </p>
        <p <%= test_selector "address2" %>>
          <strong>Address2:</strong> <%= address2 %>
        </p>
        <p <%= test_selector "city" %>>
          <strong>City:</strong> <%= city %>
        </p>
        <p <%= test_selector "region" %>>
          <strong>Region:</strong> <%= region %>
        </p>
        <p <%= test_selector "country" %>>
          <strong>Country:</strong> <%= country %>
        </p>
        <p <%= test_selector "postal_code" %>>
          <strong>Postal code:</strong> <%= postal_code %>
        </p>
        <p>
          <strong>Updated at:</strong> <%= updated_at %>
        </p>
      </div>
    <% end %>
    <% if render_edit_form? %>
      <%= render(Primer::Alpha::Banner.new(scheme: :warning, dismiss_scheme: :remove, classes: "tmp-mt-3")) { "Updating this information may trigger a re-screen, which can lead to friction if an alert is generated" } %>
      <div class="tmp-mt-3" <%= test_selector "billing-information-edit-form" %>>
        <%= primer_form_with(
          model: billing_contact,
          url: stafftools_edit_form_path,
          method: :put,
          html: { id: "stafftools-billing-edit-form" },
          data: { turbo: true }
        ) do |form| %>
          <div class="js-name-address-collection tmp-pb-3">
            <%= render Billing::Settings::NameAddressInputsForm.new(
              form,
              contact: billing_contact,
              target: target,
              actor: current_user,
              include_buttons: true,
              cancellable: false,
              show_billing_email: false
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if organization_with_a_linked_record? %>
      <div <%= test_selector "linked-record-data" %>>
        <p>
          This organization uses an <%= link_to "admin's billing information", linked_admin_path, class: "Link--inTextBlock" %>.
        </p>
      </div>
    <% end %>
  <% else %>
    <p <%= test_selector "trade-restriction-unauthorized" %>><%= stafftools_not_authorized_html %></p>
  <% end %>
</li>
