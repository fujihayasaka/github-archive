<span>
  <%= render(Primer::Alpha::Dialog.new(
    button_text: "Restore organization",
    button_class: "btn btn-sm mr-1",
    details_class: "float-right",
    dialog_class: "overflow-visible",
    title: "Restore organization?",
    test_selector: "restore-org-dialog-#{organization.id}"
  )) do |dialog| %>
    <% dialog.with_show_button(
      scheme: :default,
      disabled: disabled?,
      test_selector: "restore-org-button-#{organization.id}"
      ) do |btn| %>
        <% btn.with_tooltip(text: helpers.stafftools_not_authorized_text) if disabled? %>
        Restore
    <% end %>
    <%= render(Primer::Alpha::Dialog::Body.new) do %>
        Are you sure that you want to restore organization <b><%= organization.login %></b>
        <% if business.present? %>
          from <b><%= business.name %></b>?
        <% else %>
          ?
        <% end %>
    <% end %>
    <%= render(Primer::Alpha::Dialog::Body.new) do %>
      <% legal_hold = LegalHold.where(user_id: organization.id).any? %>
      <%= form_tag stafftools_user_restorations_path do %>
        <input type="hidden" name="was_org" value="true">
        <input type="hidden" name="email" value="<%= organization.billing_email %>">
        <input type="hidden" name="id" value="<%= organization.id %>">
        <input type="hidden" name="login" value="<%= organization.login %>">
        <input type="hidden" name="plan" value="<%= organization.plan&.name %>">
        <input type="hidden" name="return_to" value="<%= return_to %>">
        <%= render Primer::Beta::Button.new(type: :submit, scheme: :default) do %>Restore<% end %>
      <% end %>
    <% end %>
  <% end %>
</span>
