<div class="d-flex flex-items-center" <%= test_selector "li-deleted-org-#{organization.id}" %>>
  <%= helpers.avatar_for organization, 20, class: :avatar %>
  <div class="flex-auto ml-2">
    <% if organization.profile_name.present? %>
      <span class="text-semibold"><%= organization.profile_name %></span> &ndash;
    <% end %>
    <span class="text-mono"><%= organization.login %></span>
    <% if organization.legal_hold %>
      <%= render(Primer::Beta::Label.new(
        scheme: :danger,
        ml: 1
      )) { "Legal hold" } %>
    <% end %>
  </div>
  <%= render(Stafftools::Organizations::RestoreOrganizationDialogComponent.new(
    organization: organization,
    business: business,
    return_to: return_to,
  )) %>
  <%= render(Stafftools::Organizations::PurgeOrganizationDialogComponent.new(
    organization: organization,
    with_show_button: true
  )) %>
</div>
<div class="flex-auto mt-1">
  <span>Deleted <%= time_ago_in_words_js organization.soft_deleted_organization.created_at %></span>
  <span>
    &middot;
    <%= render(Primer::Beta::Link.new(
      href: stafftools_audit_log_path(
        query: helpers.driftwood_ade_query?(current_user) ? organization.audit_log_kql_query : organization.audit_log_query
      ),
      test_selector: "deleted-org-#{organization.id}-audit-log-link"
    )) { "Search audit logs" } %>
  </span>
  <% if GitHub.billing_enabled? %>
    <span>
      &middot;
      <%= render(Primer::Beta::Link.new(
        href: stafftools_deleted_account_transactions_path(deleted_user_id: organization.id, deleted_handle: organization.login),
        test_selector: "deleted-org-#{organization.id}-payment-history-link"
      )) { "Payment history" } %>
    </span>
  <% end %>
</div>
