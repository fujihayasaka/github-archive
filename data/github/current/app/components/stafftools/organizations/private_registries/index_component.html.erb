<%= render(Primer::Beta::Subhead.new) do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Private registries
  <% end %>
<% end %>

<% if !GitHub.enterprise? %>
  <% if !can_use_org_secrets? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :warning, dismiss_scheme: :none, test_selector: "private-registries-org-secrets-disabled-banner", classes: "tmp-my-3")) do %>
      Organizations on the legacy plan cannot use organization secrets.
    <% end %>
  <% end %>

  <% if can_use_org_secrets? && !can_use_secrets_for_private_repos? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :default, dismiss_scheme: :none, test_selector: "private-registries-secrets-for-private-repos-disabled-banner", classes: "tmp-mb-3")) do %>
      Secrets cannot be used by <%= enterprise? ? "private and internal" : "private" %> repositories under this organization's plan.
    <% end %>
  <% end %>
<% end %>

<% if configuration_rows.any? %>
  <% configuration_rows.each do |row| %>
    <%= render(Primer::Beta::BorderBox.new(padding: :condensed, test_selector: "private-registries-config-#{row[:configuration_id]}")) do |box| %>
      <% box.with_row(display: :flex, align_items: :baseline) do %>
        <span class="flex-auto text-mono" <%= test_selector "secret-name" %>>
          <%= row[:secret_name] %>
        </span>
        <% if row[:missing_secret] %>
          <%= render(Primer::Beta::Label.new(scheme: :danger, test_selector: "missing-secret-label")) { "Missing Kredz secret" } %>
        <% end %>
      <% end %>
      <% box.with_row do %>
        <div class="summary clearfix">
          <dl>
            <dt>Registry type</dt>
            <dd <%= test_selector "registry-type" %>>
              <%= row[:registry_type] %>
            </dd>
          </dl>
          <dl>
            <dt>Auth type</dt>
            <dd <%= test_selector "auth-type" %>>
              <%= row[:auth_type] %>
            </dd>
          </dl>
          <dl>
            <dt>URL</dt>
            <dd <%= test_selector "url" %>>
              <%= row[:url] %>
            </dd>
          </dl>
          <% if row[:username].present? %>
            <dl>
              <dt>Username</dt>
              <dd <%= test_selector "username" %>>
                <%= row[:username] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:tenant_id].present? %>
            <dl>
              <dt>Tenant ID</dt>
              <dd <%= test_selector "tenant-id" %>>
                <%= row[:tenant_id] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:client_id].present? %>
            <dl>
              <dt>Client ID</dt>
              <dd <%= test_selector "client-id" %>>
                <%= row[:client_id] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:aws_region].present? %>
            <dl>
              <dt>AWS Region</dt>
              <dd <%= test_selector "aws-region" %>>
                <%= row[:aws_region] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:account_id].present? %>
            <dl>
              <dt>Account ID</dt>
              <dd <%= test_selector "account-id" %>>
                <%= row[:account_id] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:role_name].present? %>
            <dl>
              <dt>Role name</dt>
              <dd <%= test_selector "role-name" %>>
                <%= row[:role_name] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:domain].present? %>
            <dl>
              <dt>Domain</dt>
              <dd <%= test_selector "domain" %>>
                <%= row[:domain] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:domain_owner].present? %>
            <dl>
              <dt>Domain owner</dt>
              <dd <%= test_selector "domain-owner" %>>
                <%= row[:domain_owner] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:jfrog_oidc_provider_name].present? %>
            <dl>
              <dt>JFrog OIDC provider name</dt>
              <dd <%= test_selector "jfrog-oidc-provider-name" %>>
                <%= row[:jfrog_oidc_provider_name] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:audience].present? %>
            <dl>
              <dt>Audience</dt>
              <dd <%= test_selector "audience" %>>
                <%= row[:audience] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:identity_mapping_name].present? %>
            <dl>
              <dt>JFrog identity mapping name</dt>
              <dd <%= test_selector "identity-mapping-name" %>>
                <%= row[:identity_mapping_name] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:namespace].present? %>
            <dl>
              <dt>Cloudsmith namespace</dt>
              <dd <%= test_selector "namespace" %>>
                <%= row[:namespace] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:service_slug].present? %>
            <dl>
              <dt>Cloudsmith service slug</dt>
              <dd <%= test_selector "service-slug" %>>
                <%= row[:service_slug] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:api_host].present? %>
            <dl>
              <dt>Cloudsmith API host</dt>
              <dd <%= test_selector "api-host" %>>
                <%= row[:api_host] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:workload_identity_provider].present? %>
            <dl>
              <dt>GCP workload identity provider</dt>
              <dd <%= test_selector "workload-identity-provider" %>>
                <%= row[:workload_identity_provider] %>
              </dd>
            </dl>
          <% end %>
          <% if row[:service_account].present? %>
            <dl>
              <dt>GCP service account</dt>
              <dd <%= test_selector "service-account" %>>
                <%= row[:service_account] %>
              </dd>
            </dl>
          <% end %>
          <dl>
            <dt>Created at</dt>
            <dd <%= test_selector "created-at" %>>
              <%= timestamp(row[:created_at]) %>
            </dd>
          </dl>
          <dl>
            <dt>Updated at</dt>
            <dd <%= test_selector "updated-at" %>>
              <%= timestamp(row[:updated_at]) %>
            </dd>
          </dl>
          <dl>
            <dt>Secret visibility</dt>
            <dd <%= test_selector "secret-visibility" %>>
              <%= row[:secret_visibility] %>
            </dd>
          </dl>
          <dl>
            <dt>Secret created_at</dt>
            <dd <%= test_selector "secret-created-at" %>>
              <%= timestamp(row[:secret_created_at]) if row[:secret_created_at] %>
            </dd>
          </dl>
          <dl>
            <dt>Secret updated at</dt>
            <dd <%= test_selector "secret-updated-at" %>>
              <%= timestamp(row[:secret_updated_at]) if row[:secret_updated_at] %>
            </dd>
          </dl>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::Blankslate.new(border: true)) do |c| %>
    <% c.with_heading(tag: :h3) do %>
      This organization does not have any private registry configurations.
    <% end %>
  <% end %>
<% end %>

<% if orphaned_secret_rows.any? %>
  <h3 class="tmp-mt-5 tmp-mb-3">Orphaned secrets</h3>
  <%= render(Primer::Alpha::Banner.new(scheme: :warning, dismiss_scheme: :none, test_selector: "private-registries-orphaned-secrets-banner", classes: "tmp-my-3")) do %>
    This organization has secrets that are missing a corresponding private registry configuration.
  <% end %>

  <% orphaned_secret_rows.each do |row| %>
    <%= render(Primer::Beta::BorderBox.new(padding: :condensed, test_selector: "private-registries-orphaned-secret-#{row[:name]}")) do |box| %>
      <% box.with_row(display: :flex, align_items: :baseline) do %>
        <span class="flex-auto text-mono" <%= test_selector "secret-name" %>>
          <%= row[:name] %>
        </span>
        <%= render(Primer::Beta::Label.new(scheme: :danger, test_selector: "orphaned-secret-label")) { "Orphaned Kredz secret" } %>
      <% end %>
      <% box.with_row do %>
        <div class="summary clearfix">
          <dl>
            <dt>Secret visibility</dt>
            <dd <%= test_selector "visibility" %>>
              <%= row[:visibility] %>
            </dd>
          </dl>
          <dl>
            <dt>Secret created_at</dt>
            <dd <%= test_selector "created-at" %>>
              <%= timestamp(row[:created_at]) %>
            </dd>
          </dl>
          <dl>
            <dt>Secret updated at</dt>
            <dd <%= test_selector "updated-at" %>>
              <%= timestamp(row[:updated_at]) %>
            </dd>
          </dl>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
