<h3 class="h4 mb-2">Overview</h3>

<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |component| %>
  <% rows.each do |row| %>
    <% component.with_row(test_selector: row[:test_selector]) do %>
      <%= link_to row[:href], class: "d-flex flex-justify-between flex-items-center color-fg-default no-underline" do %>
        <div class="tmp-pr-3">
          <strong class="d-block"><%= row[:title] %></strong>
          <span class="color-fg-muted f6"><%= row[:description] %></span>
        </div>
        <div class="d-flex flex-items-center color-fg-muted flex-shrink-0">
          <span class="tmp-mr-2"><%= pluralize(row[:count], row[:unit]) %></span>
          <%= primer_octicon(:"chevron-right") %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
