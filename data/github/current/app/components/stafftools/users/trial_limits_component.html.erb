<div <%= test_selector "trial_limits_component" %>>
  <%= form_tag stafftools_user_trial_limits_path(@user) do %>
    <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
      <% component.with_header do |h| %>
        <% h.with_title(tag: :h4) do %>
          Enterprise Trial Limits
        <% end %>
      <% end %>

      <% component.with_row do %>
        <%= render(Primer::Box.new(classes: "form-checkbox", pl: 5, my: 0)) do %>
          <label class="ml-1 d-block">
            <input type="radio" name="limit_type" value="custom" class="form-checkbox-details-trigger" <% if has_custom_limit? %>checked<% end %>>
            Limit trials
            <%= render(Primer::Box.new(classes: "note")) do %>
              <%= render(Primer::Beta::Text.new(mb: 1)) { "Set a specific number of enterprise trials this user can create" } %>
              <%= render(Primer::Box.new(classes: "form-checkbox-details")) do %>
                <%= render(Primer::Box.new(mt: 3, pt: 1, mb: 2, position: :relative)) do %>
                  <input class="form-control col-4" type="number" name="limit" min="0" placeholder="<%= default_limit %>" aria-label="Trial limit" value="<%= has_custom_limit? ? current_limit : '' %>" <%= test_selector "custom-trial-limit" %>>
                  <%= render(Primer::Beta::Button.new(scheme: :primary, ml: 1, type: :submit)) { "Update limit" } %>
                <% end %>
              <% end %>
            <% end %>
          </label>
        <% end %>
      <% end %>

      <% component.with_row do %>
        <%= render(Primer::Box.new(classes: "form-checkbox", pl: 5, my: 0)) do %>
          <label class="ml-1 d-block">
            <input type="radio" name="limit_type" value="default" class="form-checkbox-details-trigger" <% unless has_custom_limit? %>checked<% end %>>
            Default limit (<%= pluralize(default_limit, "trial") %>)
            <%= render(Primer::Box.new(classes: "note")) do %>
              <%= render(Primer::Beta::Text.new(mb: 1)) { "Use the system default of #{pluralize(default_limit, "enterprise trial")} per user" } %>
              <%= render(Primer::Box.new(classes: "form-checkbox-details")) do %>
                <%= render(Primer::Beta::Button.new(scheme: :primary, mt: 2, type: :submit)) { "Reset to default" } %>
              <% end %>
            <% end %>
          </label>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
