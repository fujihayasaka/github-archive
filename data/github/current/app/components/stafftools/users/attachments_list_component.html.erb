<div class="site-admin-unboxed">
  <div class="site-admin-subhead <%= "ruleless" if attachments&.empty? %>">
    <% unless attachments&.empty? %>
      <%= render Primer::Alpha::ActionMenu.new(float: :right, scheme: :danger, test_selector: "delete-attachments-action-menu") do |menu| %>
        <% menu.with_show_button(scheme: :danger, icon: :trash, "aria-label": "Delete #{attachments_type_pretty} menu") %>
        <% menu.with_item(scheme: :danger, label: "Delete all (#{attachments_type_pretty})", content_arguments: { "data-show-dialog-id": dialog_id(:all) } ) %>
        <% menu.with_item(scheme: :danger, label: "Delete selected ids", content_arguments: { "data-show-dialog-id": dialog_id(:selected) } ) %>
      <% end %>
    <% end %>

    <h2 class="site-admin-subhead-heading">
      Attachments for <%= target_user.login %>
    </h2>
 </div>

  <%= render Stafftools::Users::AttachmentsTableComponent.new(
    form_id: form_id(:selected),
    attachments: attachments,
    actor: actor,
    target_user: target_user,
    attachments_type: attachments_type,
  ) %>

  <% unless attachments&.empty? %>
    <%= render Stafftools::Users::AttachmentsBatchDeleteDialogComponent.new(
      dialog_id: dialog_id(:all),
      form_id: form_id(:all),
      deletion_type: :all,
      target_user: target_user,
      attachments_type: attachments_type,
    ) %>
    <%= render Stafftools::Users::AttachmentsBatchDeleteDialogComponent.new(
      dialog_id: dialog_id(:selected),
      form_id: form_id(:selected),
      deletion_type: :selected,
      target_user: target_user,
      attachments_type: attachments_type,
    ) %>
  <% end %>
</div>
