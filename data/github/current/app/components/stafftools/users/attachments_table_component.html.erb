<%= render(Primer::Alpha::TabNav.new(label: "attachments-list-filter-type", style: "display: flex; justify-content: flex-end;")) do |component| %>
  <% component.with_tab(**tab_attributes(:user_assets)) { "Media (User Assets)" } %>
  <% component.with_tab(**tab_attributes(:repository_files)) { "Non-Media (Repository Files)" } %>
<% end %>
<% if attachments&.any? %>
  <table class="stafftools-table js-check-all-container">
    <thead>
      <th>
        <label aria-label="Check all items"><input type="checkbox" data-check-all></label>
      </th>
      <th>
        Database ID
      </th>
      <% if is_selected_user_assets? %>
        <th>
          GUID
        </th>
      <% end %>
      <th>
        Filename
      </th>
      <th>
        Content-Type
      </th>
      <th>
        Size
      </th>
      <th>
        Repository Association
      </th>
      <th>
        Created At
      </th>
      <th>
        Link
      </th>
    </thead>
    <tbody>
      <% attachments.each do |attachment| %>
        <tr <%= test_selector "stafftools-user-attachments-list" %>>
          <td>
            <label aria-label="Check <%= attachment.id %>">
              <input form="<%= form_id %>" type="checkbox" name="ids[]" value="<%= attachment.id %>" data-check-all-item>
            </label>
          </td>
          <td>
            <%= attachment.id %>
          </td>
          <% if is_selected_user_assets? %>
            <td>
              <%= render(Primer::Beta::Truncate.new) do |component| %>
                <% component.with_item(expandable: true, max_width: 100) do  %>
                  <%= attachment.guid %>
                <% end %>
              <% end %>
            </td>
          <% end %>
          <td>
            <%= render(Primer::Beta::Truncate.new) do |component| %>
              <% component.with_item(expandable: true, max_width: 100) do  %>
                <%= attachment.name %>
              <% end %>
            <% end %>
          </td>
          <td>
            <%= attachment.content_type %>
          </td>
          <td>
            <%= number_to_human_size attachment.size %>
          </td>
            <td>
              <%= render(Primer::Beta::Truncate.new) do |component| %>
                <% component.with_item(expandable: true, max_width: 100) do  %>
                  <%= table_cell_repository_association attachment %>
                <% end %>
              <% end %>
            </td>
          <td>
            <%= time_ago_in_words attachment.created_at %> ago
          </td>
          <td>
            <%= table_cell_download_link attachment %>
          </td>
      </tr>
      <% end %>
    </tbody>
  </table>

  <div class="paginate-container">
    <%= helpers.will_paginate attachments %>
  </div>
<% else %>
  <p class="site-admin-blankstate">
    No attachments found for this attachment type.
  </p>
<% end %>
