<%= render Primer::Beta::Subhead.new(border_bottom: 0, test_selector: "staff-credentials-danger-zone", classes: "tmp-mt-4") do |subhead| %>
  <% subhead.with_heading(tag: :h2, mt: 4, mb: 0) do %>
    Danger zone
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(border_color: :danger)) do |box| %>
  <% box.with_row(test_selector: "staff-revoke-credential-authorizations") do %>
    <div class="d-flex flex-items-center">
      <div class="flex-auto width-full">
        <span class="text-bold color-fg-default">
          Deauthorize all credentials
        </span>
        <div class="color-fg-default mt-1 f5" <%= test_selector "staff-revoke-credential-authorizations-description" %>>
          Deauthorize all credentials owned or authorized by <%= user.display_login %>.
        </div>
      </div>
      <%= render(Primer::Beta::Button.new(
        scheme: :danger,
        "data-show-dialog-id": "staff-revoke-credential-authorizations-dialog",
      )) { "Deauthorize" } %>
    </div>
  <% end %>

  <% if emu_user? %>
    <% box.with_row(test_selector: "staff-revoke-credentials-and-authorizations") do %>
      <div class="d-flex flex-items-center">
        <div class="flex-auto width-full">
          <span class="text-bold color-fg-default">
            Revoke all credentials
          </span>
          <div class="color-fg-default mt-1 f5" <%= test_selector "staff-revoke-credentials-and-authorizations-description" %>>
            Revoke all credentials and their authorizations owned or authorized by <%= user.display_login %>, including those that are not SSO-authorized.
          </div>
        </div>
        <%= render(Primer::Beta::Button.new(
          scheme: :danger,
          "data-show-dialog-id": "staff-revoke-credentials-and-authorizations-dialog",
        )) { "Revoke" } %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if emu_user? %>
  <%= render(Primer::Alpha::Dialog.new(
    size: :medium_portrait,
    id: "staff-revoke-credential-authorizations-dialog",
    title: "Deauthorize #{user.display_login}\u2019s credentials",
    test_selector: "staff-revoke-credential-authorizations-dialog",
  )) do |dialog| %>
    <% dialog.with_header(show_divider: true) %>
    <%= form_tag stafftools_user_credentials_path(user, revocation_type: "authorizations"), method: :delete do %>
      <%= render(Primer::Alpha::Dialog::Body.new) do %>
        <p>
          You are about to <strong>deauthorize all credentials</strong> owned or authorized by <%= user.display_login %>.
        </p>
        <p>
          All SSO-authorized credentials (Personal Access Tokens, SSH keys, OAuth tokens) will lose their authorization. This includes:
        </p>
        <div class="markdown-body f5 mb-2">
          <ul>
            <li><%= pluralize(fine_grained_personal_access_tokens_count, "fine-grained personal access token") %></li>
            <li><%= pluralize(classic_personal_access_tokens_count, "personal access token (classic)") %></li>
            <li><%= pluralize(app_access_tokens_count, "GitHub App and OAuth app access token") %></li>
            <li><%= pluralize(ssh_keys_count, "SSH key") %></li>
          </ul>
        </div>

        <dl class="form-group">
          <dt><label for="staff-revoke-credential-authorizations-verify">Enter "<%= confirmation_text %>" to confirm</label></dt>
          <dd>
            <input class="form-control input-block"
              type="text"
              id="staff-revoke-credential-authorizations-verify"
              name="verify"
              pattern="<%= helpers.case_insensitive_pattern(confirmation_text) %>"
              required>
          </dd>
        </dl>
      <% end %>

      <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: true)) do %>
        <%= render(Primer::Beta::Button.new(
          type: :button,
          data: { "close-dialog-id": "staff-revoke-credential-authorizations-dialog" }
        )) { "Cancel" } %>

        <%= render(Primer::Beta::Button.new(
          type: :submit,
          scheme: :danger,
          "data-disable-invalid": "",
          "data-disable-with": ""
        )) { "Deauthorize user\u2019s credentials" } %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <credential-revocation-dialog data-slug="<%= user.display_login %>">
    <%= render(Primer::Alpha::Dialog.new(
      size: :medium_portrait,
      id: "staff-revoke-credential-authorizations-dialog",
      title: "Deauthorize #{user.display_login}\u2019s credentials",
      test_selector: "staff-revoke-credential-authorizations-dialog",
    )) do |dialog| %>
      <% dialog.with_header(show_divider: true) %>
      <%= form_tag stafftools_user_credentials_path(user, revocation_type: "authorizations"), method: :delete, id: "staff-revoke-credential-authorizations-form", data: { action: "submit:credential-revocation-dialog#validate" } do %>
        <input type="hidden" name="enterprise_id" id="staff-revoke-credential-authorizations-enterprise-id" value="" data-target="credential-revocation-dialog.hiddenInput">
        <%= render(Primer::Alpha::Dialog::Body.new) do %>
          <p>
            Select an enterprise whose credentials you would like to deauthorize for <%= user.display_login %>.
          </p>

          <dl class="form-group required" <%= test_selector "staff-revoke-credential-authorizations-enterprise-select" %>>
            <dt><label>Enterprise</label></dt>
            <dd>
              <%= render(Primer::Alpha::SelectPanel.new(
                id: "staff-revoke-credential-authorizations-enterprise-select-panel",
                title: "Select an enterprise",
                select_variant: :single,
                fetch_strategy: :local,
                dynamic_label: true,
                no_results_label: "No matching enterprises.",
                classes: "d-block",
              )) do |panel| %>
                <% panel.with_show_button(scheme: :default, data: { target: "credential-revocation-dialog.triggerButton" }) do |button| %>
                  <% button.with_trailing_action_icon(icon: :"triangle-down") %>
                  Select an enterprise
                <% end %>
                <% enterprises.each do |business| %>
                  <% panel.with_item(
                    label: business.name,
                    size: :medium,
                    content_arguments: { data: { value: business.id } }
                  ) do |item| %>
                    <% item.with_leading_visual_raw_content do %>
                      <%= render(Primer::Beta::Avatar.new(src: business.primary_avatar_url, alt: "", size: 20, shape: :square)) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
              <p class="color-fg-danger f6 mt-1" id="staff-revoke-credential-authorizations-select-error" hidden data-target="credential-revocation-dialog.selectError">
                <%= render(Primer::Beta::Octicon.new(icon: :alert, size: :small, mr: 1)) %>Please select an enterprise
              </p>
            </dd>
          </dl>

          <div id="staff-revoke-credential-authorizations-details-section" hidden data-target="credential-revocation-dialog.detailsSection">
            <p>
              You are about to <strong>deauthorize all credentials</strong> owned or authorized by <%= user.display_login %> in
              <strong><span class="js-selected-display-name"></span></strong>. This includes:
            </p>
            <div class="markdown-body f5 mb-2">
              <ul>
                <li><%= pluralize(fine_grained_personal_access_tokens_count, "fine-grained personal access token") %></li>
                <li><%= pluralize(classic_personal_access_tokens_count, "personal access token (classic)") %></li>
                <li><%= pluralize(app_access_tokens_count, "GitHub App and OAuth app access token") %></li>
                <li><%= pluralize(ssh_keys_count, "SSH key") %></li>
              </ul>
            </div>

            <dl class="form-group required">
              <dt><label for="staff-revoke-credential-authorizations-verify">Enter &ldquo;<%= confirmation_text %>&rdquo; to confirm</label></dt>
              <dd>
                <input class="form-control input-block"
                  type="text"
                  id="staff-revoke-credential-authorizations-verify"
                  name="verify"
                  data-target="credential-revocation-dialog.verifyInput">
                <p class="color-fg-danger f6 mt-1" id="staff-revoke-credential-authorizations-verify-error" hidden data-target="credential-revocation-dialog.verifyError">
                  <%= render(Primer::Beta::Octicon.new(icon: :alert, size: :small, mr: 1)) %>Please enter the correct text to continue.
                </p>
              </dd>
            </dl>
          </div>
        <% end %>

        <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: true)) do %>
          <%= render(Primer::Beta::Button.new(
            type: :button,
            data: { "close-dialog-id": "staff-revoke-credential-authorizations-dialog" }
          )) { "Cancel" } %>

          <%= render(Primer::Beta::Button.new(
            type: :submit,
            scheme: :danger,
            id: "staff-revoke-credential-authorizations-submit",
          )) { "Deauthorize user\u2019s credentials" } %>
        <% end %>
      <% end %>
    <% end %>
  </credential-revocation-dialog>
<% end %>

<% if emu_user? %>
<%= render(Primer::Alpha::Dialog.new(
  size: :medium_portrait,
  id: "staff-revoke-credentials-and-authorizations-dialog",
  title: "Revoke #{user.display_login}\u2019s credentials",
  test_selector: "staff-revoke-credentials-and-authorizations-dialog",
)) do |dialog| %>
  <% dialog.with_header(show_divider: true) %>
  <%= form_tag stafftools_user_credentials_path(user, revocation_type: "credentials_and_authorizations"), method: :delete do %>
    <%= render(Primer::Alpha::Dialog::Body.new) do %>
      <p>
        You are about to <strong>revoke all credentials and their authorizations</strong> owned or authorized by <%= user.display_login %>.
      </p>
      <p>
        <strong>All credentials will be permanently deleted</strong> (Personal Access Tokens, SSH keys, OAuth tokens). This includes:
      </p>
      <div class="markdown-body f5 mb-2">
        <ul>
          <li><%= pluralize(fine_grained_personal_access_tokens_count, "fine-grained personal access token") %></li>
          <li><%= pluralize(classic_personal_access_tokens_count, "personal access token (classic)") %></li>
          <li><%= pluralize(app_access_tokens_count, "GitHub App and OAuth app access token") %></li>
          <li><%= pluralize(ssh_keys_count, "SSH key") %></li>
        </ul>
      </div>

      <dl class="form-group">
        <dt><label for="staff-revoke-credentials-and-authorizations-verify">Enter "<%= confirmation_text %>" to confirm</label></dt>
        <dd>
          <input class="form-control input-block"
            type="text"
            id="staff-revoke-credentials-and-authorizations-verify"
            name="verify"
            pattern="<%= helpers.case_insensitive_pattern(confirmation_text) %>"
            required>
        </dd>
      </dl>
    <% end %>

    <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: true)) do %>
      <%= render(Primer::Beta::Button.new(
        type: :button,
        data: { "close-dialog-id": "staff-revoke-credentials-and-authorizations-dialog" }
      )) { "Cancel" } %>

      <%= render(Primer::Beta::Button.new(
        type: :submit,
        scheme: :danger,
        "data-disable-invalid": "",
        "data-disable-with": ""
      )) { "Revoke user\u2019s credentials" } %>
    <% end %>
  <% end %>
<% end %>
<% end %>
