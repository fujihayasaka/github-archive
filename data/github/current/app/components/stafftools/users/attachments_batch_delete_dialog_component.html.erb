<%= render(Primer::Alpha::Dialog.new(id: dialog_id, title: title)) do |d| %>
  <%= form_tag(
      batch_destroy_stafftools_user_attachments_path(target_user, attachments_type: attachments_type),
      :method => :delete,
      id: form_id
    ) do %>
    <%= render(Primer::Alpha::Dialog::Body.new) do %>
      Are you sure you want to <strong>hard delete(not reversible)</strong> <%= deletion_type %> <%= attachments_type_pretty %> attachments for this user?
    <% end %>
    <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: false)) do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": dialog_id })) { "Cancel" } %>
      <%= render(Primer::Beta::Button.new(scheme: :danger, type: :submit, "data-disable-with": "Deleting...")) { "Yes, delete #{deletion_type}" } %>
    <% end %>
  <% end %>
<% end %>
