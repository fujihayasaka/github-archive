<p class="flex">
  <% unless GitHub.enterprise? %>
    <%= render(Primer::Beta::Link.new(
      href: helpers.splunk_orchestration_url(orchestration),
      test_selector: "splunk-link"
    )) do %>
      View in Splunk
    <% end %>
  <% end %>

  <% if render_retry? %>
    <%= render(Primer::Alpha::Dialog.new(
      id: "retry-orchestration-#{orchestration.id}",
      title: "Retry failed orchestration"
    )) do |c| %>
      <% c.with_show_button(
        ml: 2,
        size: :small,
        test_selector: "retry-orchestration-#{orchestration.id}"
      ) do |c| %>
        Retry
      <% end %>
      <% c.with_body do %>
        <p>
          Are you sure you want to retry this orchestration?
          This orchestration failed, but may be successful if retried.
        </p>
      <% end %>
      <% c.with_footer(show_divider: true) do %>
        <%= render(Primer::Beta::Button.new(
          data: { "close-dialog-id": "retry-orchestration-#{orchestration.id}" }
        )) { "Cancel" } %>
        <%= form_with(url: retry_path, method: :post) do |form| %>
          <%= render(Primer::Beta::Button.new(
            type: :submit,
            scheme: :danger,
            "data-disable-invalid": "",
            "data-disable-with": ""
          )) { "Retry" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</p>

<%= render Primer::Beta::BorderBox.new(padding: :condensed) do |box| %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Orchestration ID</div>
      <div class="col-10" <%= test_selector "orchestration-id" %>>
        <%= orchestration.id %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold"><%= entity_id_name %></div>
      <div class="col-10">
        <%= entity_id_value %>
      </div>
    </div>
  <% end %>
  <% if render_additional_business_id? %>
    <% box.with_row(clearfix: true) do %>
      <div class="d-flex">
        <div class="col-3 text-bold">Enterprise ID</div>
        <div class="col-10">
          <%= orchestration.business_id %>
        </div>
      </div>
    <% end %>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Type</div>
      <div class="col-10">
        <%= orchestration.type %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Parent ID</div>
      <div class="col-10">
        <%= orchestration.parent_id %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">State</div>
      <div class="col-10">
        <% case (orchestration.state) %>
        <% when "succeeded" %>
          <%= primer_octicon(:"check-circle", classes: "open") %>
        <% when "failed" %>
          <%= primer_octicon(:"x-circle", classes: "closed") %>
        <% when "created" %>
          <%= primer_octicon(:"circle", classes: "draft") %>
        <% else %>
          <%= primer_octicon(:"circle", classes: "merged", style: "color: rgb(219, 171, 10)") %>
        <% end %>
        <%= orchestration.state %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Created</div>
      <div class="col-10">
        <%= orchestration.created_at %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Updated</div>
      <div class="col-10">
        <%= orchestration.updated_at %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Duration</div>
      <div class="col-10">
        <%= "#{(orchestration.updated_at - orchestration.created_at).round(2)} sec" %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Error message</div>
      <div class="col-10">
        <%= orchestration.error_message %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Attempts</div>
      <div class="col-10">
        <%= orchestration.attempts %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Step name</div>
      <div class="col-10">
        <%= orchestration.step_name %>
      </div>
    </div>
  <% end %>
<% end %>

<% if list_organization_ids? %>
  <%= render Primer::Beta::Subhead.new(hide_border: true, spacious: true) do |component| %>
    <% component.with_heading(tag: :h2) do %>
      Organization IDs
    <% end %>
  <% end %>

  <% if orchestration.organization_ids.present? %>
    <%= render Primer::Beta::BorderBox.new(padding: :condensed) do |box| %>
      <% box.with_row(clearfix: true) do %>
        <div class="d-flex">
          <%= orchestration.organization_ids.join(", ") %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <p>No organization IDs</p>
  <% end %>
<% end %>

