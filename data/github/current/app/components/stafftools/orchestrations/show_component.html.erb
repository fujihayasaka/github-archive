<%= render Primer::Beta::Subhead.new(hide_border: true, spacious: true) do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Data
  <% end %>
<% end %>

<% if orchestration.data.any? %>
  <%= render Primer::Beta::BorderBox.new(padding: :condensed) do |box| %>
    <% orchestration.data.each do |key, value| %>
      <% box.with_row(clearfix: true) do %>
        <div class="d-flex">
          <div class="col-3 text-bold">
            <%= key %>
          </div>
          <div class="col-10">
            <%= value %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <p>No data available</p>
<% end %>
