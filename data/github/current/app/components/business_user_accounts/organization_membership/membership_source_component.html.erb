<% if direct? %>
  <div <%= test_selector "direct-membership" %> data-justify="start" data-gap="1" data-direction="horizontal" data-align="center" data-wrap="wrap" data-padding="none" class="Stack gap-1 width-fit color-fg-default color-bg-subtle border color-border-muted rounded-sm-2 px-1 text-bold" style="padding-top: 2px; padding-bottom: 2px">
  direct assignment</div>
<% else %>
  <div <%= test_selector "indirect-membership-via-business-team" %> data-justify="start" data-gap="1" data-direction="horizontal" data-align="center" data-wrap="wrap" data-padding="none" class="Stack gap-1 width-fit color-bg-subtle border color-border-muted rounded-sm-2 px-1" style="padding-top: 2px; padding-bottom: 2px">
    <%= helpers.avatar_for(business_team, 16, class: "avatar avatar-small") %>
    <%= link_to(business_team.name, business_team_link_path, class: "ml-1  Link--primary no-underline text-bold") %>
  </div>
<% end %>
