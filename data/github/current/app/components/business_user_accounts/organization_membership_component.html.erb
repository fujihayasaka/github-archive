 <div data-justify="start" data-gap="1" data-direction="horizontal" data-align="center" data-wrap="nowrap" data-padding="none" class="Stack gap-3 width-fit">
  <div>
    <%= link_to user_path(organization) do %>
      <%= helpers.avatar_for(organization, 32, class: "avatar") %>
    <% end %>
  </div>

  <div <%= test_selector "org-membership-#{organization.id}" %>>
    <%= link_to user_path(organization), class: "f5 d-block width-fit Link--primary no-underline text-bold" do %>
      <%= organization.safe_profile_name %>
    <% end %>
    <% if business&.erp_feature_enabled?(:enterprise_teams_org_assignment) %>
      <%= render(BusinessUserAccounts::OrganizationMembership::MembershipSourcesComponent.new(
        user:,
        organization: organization
      )) %>
    <% end %>
  </div>
</div>

<div class="color-fg-muted f6 text-right mr-1">
  <%= organization.adminable_by?(user) ? "Owner" : "Member" %>
</div>
