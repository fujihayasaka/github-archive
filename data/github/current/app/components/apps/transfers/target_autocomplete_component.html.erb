<% if suggestions.any? %>
  <% suggestions.each do |suggestion| %>
    <div class="js-transfer-target-autocomplete-item" data-value="<%= suggestion.display_login %>">
      <%= render Primer::Beta::AutoComplete::Item.new(
        value: suggestion.display_login,
        label: suggestion.display_login,
        description_variant: :inline,
        m: 2,
        test_selector: "target-suggestion-#{suggestion_type(suggestion)}-#{suggestion.id}"
      ) do |item| %>
        <% item.with_description { "#{suggestion_type(suggestion).capitalize}" } %>
        <%= helpers.avatar_for(suggestion, 24, :class => "avatar") %>
        <strong class="ml-2"><%= suggestion.display_login %></strong>
      <% end %>

      <div class="js-transfer-selection-badge" hidden>
        <div class="d-flex flex-items-center p-2 rounded-2 color-fg-accent color-bg-accent border color-border-accent">
          <div class="col-1 mr-2 text-center">
            <%= helpers.avatar_for(suggestion, 28, class: "avatar") %>
          </div>
          <div class="col-10">
            <%= render(Primer::Beta::Text.new(
              font_weight: :bold,
              classes: "css-truncate css-truncate-overflow",
              "data-transfer-to": params_transfer_to(suggestion),
            )) { suggestion.display_login } %>
            <span class="color-fg-muted ml-1"><%= suggestion_type(suggestion).capitalize %></span>
          </div>
          <%= render Primer::Beta::Button.new(scheme: :link, mr: 2, classes: "js-cancel-transfer", "aria-label": "Cancel transfer selection") do %>
            <%= primer_octicon(:x) %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <%= render Primer::Beta::AutoComplete::Item.new(
    value: "no-results",
    label: "no-results",
    m: 2,
    disabled: true,
    test_selector: "empty-autocomplete-suggestion"
  ) do %>
    <p class="color-fg-muted m-0">
       Could not find any matching results.
    </p>
  <% end %>
<% end %>
