<%= render Primer::Alpha::Dialog.new(title: "Delete GitHub App?") do |dialog| %>
  <% dialog.with_show_button(scheme: :danger, classes: "float-right") { "Delete GitHub App" } %>
  <% dialog.with_body do %>
    <%= render(Primer::Alpha::Banner.new(scheme: :warning, my: 3)) do %>
      Unexpected bad things will happen if you don’t read this!
    <% end %>

    <div class="mb-3">
      <p>
        This action <strong>CANNOT</strong> be undone. This will permanently delete the
        <span class="branch-name text-bold ws-pre-wrap" <%= test_selector("integration-name") %>><%= integration.name %></span>
        GitHub App.
      </p>

      <% if integration.installations.any? %>
        <p>
          This will also uninstall the GitHub App from
          <strong><%= pluralize(number_with_delimiter(integration.installations.count), "account") %></strong>.
        </p>
      <% end %>
    </div>

    <%= form_with(url: gh_settings_app_path(integration), method: :delete) do %>
      <label for="confirm-delete-app" class="FormControl-label">
        Please type in the name of the GitHub App to confirm
      </label>
      <input
        id="confirm-delete-app"
        class="FormControl-input FormControl-medium"
        type="text"
        pattern="<%= helpers.case_insensitive_pattern integration.name %>"
        name="verify"
        autofocus
        required
      >

      <%= render Primer::Beta::Button.new(
        type: :submit,
        scheme: :danger,
        block: true,
        mt: 3,
        data: { disable_invalid: "" },
      ) do %>
        I understand the consequences, delete this GitHub App
      <% end %>
    <% end %>
  <% end %>
<% end %>
