<%= render Primer::Alpha::Dialog.new(
  title: title_text,
  size: :large,
  id: dialog_id,
) do |d| %>
  <% d.with_header(show_divider: true, p: 2, mb: 2, font_size: 4, font_weight: :bold) do %>
    <%= title_text %>
  <% end %>
  <% d.with_body do %>
  <div class="p-2">
    <div class="mb-3">
      Showing <%= pluralize(root_ancestors.length, 'path') %>. Export SBOM to view all paths.
      <a
        class="Link--inTextBlock"
        href="<%= GitHub.help_url %>/code-security/supply-chain-security/understanding-your-software-supply-chain/exporting-a-software-bill-of-materials-for-your-repository"
        target="_blank"
      >
      Learn more about SBOMS.
      </a>
    </div>
    <% if is_direct_and_transitive? %>
      <ul class="list-style-none mb-3">
        <h2 class="f4 text-bold">Direct</h2>
        <li>
          <%= package_name %> <%= requirements %>
        </li>
      </ul>
    <% end %>
    <ul class="list-style-none">
      <h2 class="f4 text-bold">Transitive</h2>
      <% root_ancestors.each do |root_ancestor| %>
        <li>
          <%= root_ancestor.package_name %> <%= root_ancestor.requirements %>
          <%= render(Primer::Beta::Octicon.new(icon: "triangle-right", size: :small)) %>
          <% if root_ancestor.relationship == :ANCESTOR %>
            <span>
              ...
              <%= render(Primer::Beta::Octicon.new(icon: "triangle-right", size: :small)) %>
            </span>
          <% end %>
          <%= package_name %> <%= requirements %>
        </li>
      <% end %>
    </ul>
  </div>
  <% end %>
<% end %>
