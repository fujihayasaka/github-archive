<% if pending? %>
  <%= status_pip %>Dependency file check in progress<%= commit_suffix %>…
<% elsif degraded_or_errored? %>
  <%= status_pip %>Dependency file checks have <%= link_to error_count_text, workflow_url, class: "Link--inTextBlock" %>. <%= refresh_message %>
<% else %>
  <%= status_pip %>Dependency files checked <%= time_ago_in_words_js(checked_at) %><%= commit_suffix %>
<% end %>
