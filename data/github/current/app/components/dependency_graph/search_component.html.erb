<% if is_repo_insights_enabled? %>
  <%= render(Primer::Experimental::QueryBuilder.new(
    id: "dependencies-search",
    input_name: "q",
    label_text: "Search all dependencies",
    visually_hide_label: true,
    placeholder: "Search all dependencies",
    form_action_url: "",
    value: helpers.search_input_value_for(@query),
    mt: 1,
    test_selector: "dependencies-search",
    "data-suggestable-ecosystems": search_ecosystem_suggestions,
  )) do |component| %>
    <% component.with_input(data: { hotkey: helpers.local_search_hotkey }) %>
    <% component.with_leading_visual_icon(icon: :search) %>
  <% end %>
<% else %>
  <%= form_tag "", method: :get do %>
    <%= render(
      Primer::Alpha::TextField.new(
        name: :q,
        placeholder: "Search all dependencies",
        label: "Search all dependencies",
        visually_hide_label: true,
        leading_visual: {
          icon: :search
        },
        value: @query
      )
    ) %>
  <% end %>
<% end %>

<% content_for :scripts do %><%# erblint:disable NoContentForScripts %>
  <%= javascript_bundle "insights" %>
<% end %>
