<% workflow_runs.each do |workflow_run| %>
  <%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
    <% box.with_header do %>
      <%= link_to run_title(workflow_run), run_url(workflow_run), class: "Link--primary text-bold" %>
    <% end %>
    <% box.with_body do %>
      <% if run_summary_blank?(workflow_run) %>
        <p class="color-fg-muted">No summary available for this workflow run.</p>
      <% else %>
        <div class="markdown-body">
          <%= run_summary_html(workflow_run) %>
        </div>
      <% end %>
      <div class="tmp-mt-3 f6">
        <%= link_to "View workflow run", run_url(workflow_run), class: "Link--muted" %>
        <% if run_job_url(workflow_run) %>
          <span class="tmp-mx-2 color-fg-muted">&middot;</span>
          <%= link_to "View logs", run_job_url(workflow_run), class: "Link--muted" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
<% if overflow? %>
  <%= render(Primer::Alpha::Banner.new(scheme: :warning, classes: "tmp-mb-3")) do %>
    There were <%= overflow_count %> more problems, please check the <%= link_to "Dependency Graph workflow logs", workflow_page_url, class: "Link--inTextBlock" %>.
  <% end %>
<% end %>
