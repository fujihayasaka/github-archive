<div>
  <%= render Primer::Alpha::SelectPanel.new(
    use_experimental_non_local_form: user_feature_enabled?(:primer_select_panel_use_experimental_non_local_form),
    id: "dependency-search-ecosystem-filter",
    fetch_strategy: :local,
    select_variant: :single,
    title: "Filter by ecosystem",
    no_results_label: "No ecosystems found.",
    anchor_align: :end,
  ) do |panel| %>
    <% panel.with_show_button(scheme: :invisible, "aria-label": "Filter ecosystems") do |button| %>
      <% button.with_trailing_action_icon(icon: :"triangle-down") %>
      Ecosystem
    <% end %>
    <% (@package_managers || []).each do |package_manager| %>
      <% panel.with_item(
        label: DependencyGraph::Ecosystems.label(package_manager),
        href: render_item_hrefs(package_manager),
        active: is_active?(package_manager),
      ) %>
    <% end %>
  <% end %>
</div>
