<%= tag.div(**html_attributes.merge(class: "authentication #{classes}")) do %>
  <% if header? %>
    <div class="authentication-header <%= header_classes %>">
      <%= header %>
    </div>
  <% end %>

  <% if body? %>
    <div class="authentication-body <%= body_classes %>">
      <%= body %>
    </div>
  <% end %>

  <% if footer? %>
    <div class="authentication-footer <%= footer_classes %>">
      <%= footer %>
    </div>
  <% end %>
<% end %>
