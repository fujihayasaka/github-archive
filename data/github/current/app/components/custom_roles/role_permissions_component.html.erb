<%= render(Primer::Alpha::Stack.new(direction: { narrow: :vertical, regular: :vertical, wide: :vertical }, gap: :normal, test_selector: "role-permissions", classes: "tmp-pl-6 tmp-pr-3 tmp-pb-3")) do %>
  <% if empty? %>
    <%= render(Primer::Box.new(bg: :subtle, flex: 1, border_radius: 2, text_align: :center, test_selector: "empty-state", classes: "tmp-p-3")) do %>
      <%= render(Primer::Beta::Text.new(color: :subtle)) { "No permissions added." } %>
    <% end %>
  <% else %>
    <%= render(CustomRoles::RolePermissionsListComponent.new(
      title: "Enterprise",
      icon: :globe,
      permissions_by_category: enterprise_permissions_by_category,
      bg: :subtle,
      test_selector: "enterprise-role-permissions-list",
      classes: "tmp-p-3 tmp-pb-4")) %>
    <%= render(Primer::Alpha::Stack.new(direction: { narrow: :vertical, regular: :vertical, wide: :horizontal }, gap: :normal)) do %>
      <%= render(CustomRoles::RolePermissionsListComponent.new(
        title: "Organization",
        icon: :organization,
        permissions_by_category: organization_permissions_by_category,
        bg: :subtle,
        test_selector: "organization-role-permissions-list",
        classes: "tmp-p-3 tmp-pb-4")) %>
      <%= render(CustomRoles::RolePermissionsListComponent.new(
        title: "Repository",
        icon: :repo,
        permissions_by_category: additional_repository_permissions_by_category,
        base_role_permissions_by_category: base_repository_permissions_by_category,
        base_role_name: base_repository_role_name,
        bg: :subtle,
        test_selector: "repository-role-permissions-list",
        classes: "tmp-p-3 tmp-pb-4")) %>
    <% end %>
  <% end %>
<% end %>
