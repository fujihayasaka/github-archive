<%= render(Primer::Box.new(test_selector: "expandable-role-row-component", **system_arguments)) do %>
  <expandable-role-row>
    <%= render(Primer::Box.new(display: :flex, align_items: :center, py: 2, classes: "tmp-px-3")) do %>
      <%= render(Primer::Beta::Octicon.new(icon: role.octicon, align_self: :start, mt: 2, mr: 1, color: :muted, "aria-label": "#{role.display_name} icon")) %>
      <div class="d-flex flex-column flex-1 ml-2 tmp-mr-3 my-1 gap-1 min-width-0">
        <%= render(Primer::Beta::Text.new(font_weight: :bold, font_size: 5, test_selector: "expandable-role-row-display-name")) { role.display_name } %>
        <div class="f6 color-fg-muted">
          <% if description_prefix? %>
            <span <%= test_selector("expandable-role-row-description-prefix") %>><%= description_prefix %></span>
            <span class="mx-1 v-align-middle">•</span>
          <% end %>
          <span class="v-align-middle" <%= test_selector("expandable-role-row-description") %>><%= role.description %></span>
        </div>
      </div>
      <%= action %>
      <span data-target="expandable-role-row.showDetailsButton">
        <%= render(Primer::Beta::IconButton.new(
          icon: :unfold,
          scheme: :invisible,
          ml: 2,
          aria: { label: "Show role permissions" },
          data: { action: "click:expandable-role-row#showDetails", target: "expandable-role-row.showDetailsIcon" },
        )) %>
      </span>
      <span hidden data-target="expandable-role-row.hideDetailsButton">
        <%= render(Primer::Beta::IconButton.new(
          icon: :fold,
          scheme: :invisible,
          ml: 2,
          aria: { label: "Hide role permissions" },
          data: { action: "click:expandable-role-row#hideDetails", target: "expandable-role-row.hideDetailsIcon" },
        )) %>
      </span>
    <% end %>

    <div data-target="expandable-role-row.permissionDetails" hidden>
      <%= render(CustomRoles::RolePermissionsComponent.new(role: role)) %>
    </div>
  </expandable-role-row>
<% end %>
