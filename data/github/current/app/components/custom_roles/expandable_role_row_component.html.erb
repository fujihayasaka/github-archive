<%= render(Primer::Box.new(test_selector: "expandable-role-row-component", **system_arguments)) do %>
  <expandable-role-row>
    <%= render(Primer::Box.new(display: :flex, align_items: :center, px: 3)) do %>
      <%= render(Primer::Beta::Octicon.new(icon: role.octicon, "aria-label": "#{role.name} icon", color: :muted)) %>
      <div class="d-flex flex-column flex-1 m-3">
        <%= render(Primer::Beta::Text.new(font_weight: :bold, font_size: 5)) { role.display_name } %>
        <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) { role.description } %>
      </div>
      <%= action %>
      <span data-target="expandable-role-row.showDetailsButton">
        <%= render(Primer::Beta::IconButton.new(
          icon: :unfold,
          scheme: :invisible,
          ml: 2,
          aria: { label: "Show role permissions" },
          data: { action: "click:expandable-role-row#showDetails" },
        )) %> 
      </span>
      <span hidden data-target="expandable-role-row.hideDetailsButton">
        <%= render(Primer::Beta::IconButton.new(
          icon: :fold,
          scheme: :invisible,
          ml: 2,
          aria: { label: "Hide role permissions" },
          data: { action: "click:expandable-role-row#hideDetails" },
        )) %>
      </span>
    <% end %>

    <div data-target="expandable-role-row.permissionDetails" hidden>
      <%= render(permissions_component_class.new(role: role)) %>
    </div>
  </expandable-role-row>
<% end %>
