<%= render(Primer::Box.new(display: :flex, pl: 7, pr: 3, pb: 3, style: "gap: 24px", test_selector: "enterprise-role-permissions")) do %>
  <% if enterprise_fgp_metadata.empty? %>
    <%= render(Primer::Box.new(bg: :subtle, p: 3, border_radius: 2, flex: 1, text_align: :center, test_selector: "empty-state")) do %>
      <%= render(Primer::Beta::Text.new(color: :subtle)) { "No permissions added." } %>
    <% end %>
  <% else %>
    <%= render(Primer::Box.new(bg: :subtle, p: 3, border_radius: 2, flex: 1, test_selector: "enterprise-fgp-metadata")) do %>
      <%= render(Primer::Box.new(display: :flex, align_items: :center)) do %>
        <%= render(Primer::Beta::Octicon.new(icon: :globe, "aria-label": "Enterprise icon", mr: 2)) %>
        <%= render(Primer::Beta::Text.new(font_weight: :bold, font_size: 5)) { "Enterprise" } %>
      <% end %>
      <%= render(Primer::Box.new(ml: 4)) do %>
        <% enterprise_fgp_metadata.each do |category, permissions| %>
          <%= render(Primer::Box.new(mt: 2)) do %>
            <%= render(Primer::Beta::Text.new(font_size: 5)) { category } %>
            <ul class="list-style-none">
              <% permissions.each do |description| %>
                <li>
                  <%= render(Primer::Beta::Text.new(color: :muted, ml: 3, font_size: 5)) { "• #{description}" } %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
