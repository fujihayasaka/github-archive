<%= render(Primer::Alpha::Banner.new(**system_arguments, scheme: scheme, dismiss_scheme: :remove, test_selector: "custom-role-banner")) do |component| %>
  <%= message %>

  <% if assign_role_path.present? %>
    <% component.with_action_content do %>
      <%= render(Primer::Beta::Button.new(
        scheme: :default,
        tag: :a,
        href: assign_role_path,
      )) { "Assign role" }
      %>
    <% end %>
  <% end %>
<% end %>
