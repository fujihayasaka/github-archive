<%= render(Primer::Box.new(flex: 1, border_radius: 2, **system_arguments)) do %>
  <%= render(Primer::Box.new(display: :flex, align_items: :center)) do %>
    <%= render(Primer::Beta::Octicon.new(icon:, color: :muted, "aria-label": "#{title} icon", mr: 2, test_selector: "icon")) %>
    <%= render(Primer::Beta::Text.new(font_weight: :bold, font_size: 5, test_selector: "title")) { title } %>
    <% if base_role_name %>
      <%= render(Primer::Box.new(flex: 1)) %>
      <%= render(Primer::Beta::Text.new(color: :muted, mr: 1, font_size: 6)) { "Base repository role:" } %>
      <%= render(Primer::Beta::Label.new(scheme: :accent, inline: true, test_selector: "base-role-name")) { base_role_name } %>
    <% end %>
  <% end %>
  <% if base_role_name && has_permissions? %>
    <%= render(Primer::Beta::Text.new(
      color: :muted,
      ml: 4,
      font_size: 6,
      font_weight: :emphasized,
      test_selector: "base-role-rollup",
    )) do %>
      All <%= base_role_name.humanize(capitalize: false) %> permissions plus…
    <% end %>
  <% end %>
  <%= render(Primer::Box.new(ml: 4)) do %>
    <% permissions_by_category_for_display.each do |category, permissions| %>
      <%= render(Primer::Box.new(mt: 3, test_selector: "category")) do %>
        <%= render(Primer::Beta::Text.new(font_size: 5, test_selector: "category-title")) { category } %>
        <ul class="list-style-none" <%= test_selector("category-permissions-list") %>>
          <% permissions.each do |permission| %>
            <li <%= test_selector("permission") %>>
              <%= render(Primer::Beta::Text.new(color: :muted, ml: 0, font_size: 6)) { "• #{permission}" } %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>
<% end %>
