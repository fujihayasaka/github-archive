<%= render(Primer::Alpha::Dialog.new(
  id: SecurityCampaigns::CampaignTemplates::DIALOG,
  classes: "ws-normal",
  title: "Select a template for your campaign",
  subtitle: "Start a new security campaign to help teams remediate code scanning alerts with the help of Copilot Autofix.",
  position: :center,
  size: :large,
)) do |dialog| %>
  <% if show_button %>
    <% dialog.with_show_button(
      scheme: :link,
      classes: "Link--inTextBlock",
      font_weight: :normal,
      font_size: 6,
      test_selector: "create-campaign-from-template",
      aria: {label: "Create campaign from template" }
    ) do |show_button| %>
      Start a new security campaign
    <% end %>
  <% end %>

  <% dialog.with_header(font_size: 4, show_divider: true) %>

  <% dialog.with_body do %>
    <%= render(Primer::Alpha::ActionList.new) do |list| %>
      <% SecurityCampaigns::CampaignTemplates::ALL_TEMPLATES.each do |template| %>
        <% list.with_item(href: code_scanning_path(template: template.first), label: template.second.name) do |list_item| %>
          <% list_item.with_description.with_content(template.second.description)%>
          <% list_item.with_trailing_visual_icon(icon: 'arrow-right') %>
        <% end %>
      <% end %>

      <% list.with_item(href: code_scanning_path, label: "Or create your own filters") do |list_item| %>
          <% list_item.with_leading_visual_icon(icon: :filter) %>
          <% list_item.with_description.with_content("Create a new campaign based on custom filters")%>
          <% list_item.with_trailing_visual_icon(icon: 'arrow-right') %>
        <% end %>
    <% end %>
  <% end %>
<% end %>
