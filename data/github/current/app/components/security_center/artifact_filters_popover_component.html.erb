<%= render Primer::Beta::Popover.new(
  position: :absolute,
  classes: "js-notice left-0 right-0",
  test_selector: "artifact-filters-popover",
  style: "z-index: 100; top: 44px;",
  data: {
    **analytics_visible_attributes(
      category: ANALYTICS_CATEGORY,
      label: analytics_label,
      event: "impression",
    ),
  },
) do |component| %>
  <% component.with_body(caret: :top, style: "width: 240px;") do %>
    <%= render Primer::Beta::Heading.new(tag: :h3, classes: "f5 tmp-mb-3") do %>
      Filter by artifact metadata
    <% end %>
    <%= render Primer::Beta::Text.new(tag: :p, color: :muted, classes: "tmp-mb-3") do %>
      You can now prioritize alerts based on having detected deployments or runtime risks.
    <% end %>
    <%= form_tag dismiss_notice_path(@notice_name), class: "js-notice-dismiss", method: :post do %>
      <%= render Primer::Beta::Button.new(
        type: :submit,
        size: :medium,
        "aria-label": "Dismiss artifact metadata filters notification",
        data: analytics_click_attributes(
          category: ANALYTICS_CATEGORY,
          action: "Dismiss",
          label: analytics_label,
        ),
      ) do %>
        OK, got it
      <% end %>
    <% end %>
  <% end %>
<% end %>