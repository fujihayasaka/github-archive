<%
  button_attrs = {
    role: role,
    type: @type,
  }
  button_classes = "SelectMenu-item"
  button_classes += " flex-items-start" if @description
  button_attrs[:class] = button_classes
  button_attrs[:"aria-checked"] = checked if checkable?
  button_attrs[:disabled] = "disabled" if @disabled
  button_attrs[:name] = @name if @name.present?
  button_attrs[:value] = @value if @value.present?
  if @data
    @data.each { |key, value| button_attrs[:"data-#{key.to_s.dasherize}"] = value }
  end
%>
<%= content_tag(:button, button_attrs) do %>

  <% if checkable? %>
    <%= render Primer::Beta::Octicon.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
  <% end %>
  <div>
    <div class="<% if @description %>f5 text-bold<% end %>">
      <%= text %>
    </div>
    <div class="color-fg-muted">
      <%= @description %>
    </div>
  </div>

  <% if replace_text %>
    <span hidden data-filter-item-text data-menu-button-text>
      <%= replace_text %>
    </span>
  <% end %>
<% end %>
