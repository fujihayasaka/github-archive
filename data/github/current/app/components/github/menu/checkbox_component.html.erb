<%
  label_attrs = {
    role: "menuitemcheckbox",
    "aria-checked": checked,
    class: "SelectMenu-item text-normal js-structured-issue-multi-select-option",
    tabindex: "0",
  }
  label_attrs[:"data-required"] = "true" if required?
%>
<%= content_tag(:label, label_attrs) do %>
  <%
    input_attrs = {
      type: "checkbox",
      name: @name,
      value: @value,
      autocomplete: "off",
      hidden: "hidden",
      class: @input_classes,
    }
    input_attrs[:id] = @id if @id
    input_attrs[:checked] = "checked" if checked
    input_attrs[:disabled] = "disabled" if @disabled
    if @data
      @data.each { |key, value| input_attrs[:"data-#{key.to_s.dasherize}"] = value }
    end
    input_attrs[:required] = "required" if required?
  %>
  <%= tag(:input, input_attrs) %>
  <%= render(
    Primer::Beta::Octicon.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check"),
  ) %>
  <div>
    <div class="<%= "text-bold" if @description %>">
      <%= text %>
    </div>
    <div class="color-fg-muted">
      <%= @description %>
    </div>
  </div>
<% end %>
