<%
  label_attrs = {
    role: "menuitemradio",
    "aria-checked": checked,
    class: "SelectMenu-item text-normal",
    tabindex: "0",
  }
%>
<%= content_tag(:label, label_attrs) do %>
  <%
    input_attrs = {
      type: "radio",
      name: @name,
      value: @value,
      autocomplete: "off",
      hidden: "hidden",
      class: @input_classes,
    }
    input_attrs[:id] = @id if @id
    input_attrs[:checked] = "checked" if checked
    input_attrs[:disabled] = "disabled" if @disabled
    if @data
      @data.each { |key, value| input_attrs[:"data-#{key.to_s.dasherize}"] = value }
    end
    input_attrs[:required] = "required" if required?
  %>
  <%= tag(:input, input_attrs) %>
  <%= render Primer::Beta::Octicon.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
  <div>
    <div class="<%= "text-bold" if @description %>">
      <% if should_render_avatar? %>
        <%= render @avatar %>
      <% end %>

      <% if should_render_octicon? %>
        <%= render(Primer::Beta::Octicon.new(@octicon, classes: "SelectMenu-icon")) %>
      <% end %>

      <%= text %> <% if should_render_label? %> <%= render(Primer::Beta::Label.new(vertical_align: :middle, ml: 1)) { label } %> <% end %>
    </div>
    <div class="color-fg-muted">
      <%= @description %>
    </div>
  </div>

  <% if replace_text %>
    <span hidden data-filter-item-text data-menu-button-text>
      <%= replace_text %>
    </span>
  <% end %>
<% end %>
