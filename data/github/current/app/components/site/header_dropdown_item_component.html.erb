<li>
  <%= link_to @url,
    class: a_classes,
    target: ("_blank" if @external),
    style: "outline-offset: -4px; outline-color: var(--color-accent-emphasis); padding: 8px 16px;",
    data: @data do %>
    <% if @description %>
      <%= render(Primer::Beta::Octicon.new(@icon, size: :medium, color: :subtle, classes: "tmp-mr-3")) if @icon %>
      <div>
        <div class="color-fg-default h4">
          <%= @text %>

          <% if @label %>
            <span class="HeaderMenu-label">
              <%= @label %>
            </span>
          <% end %>
        </div>

        <%= @description %>
      </div>
    <% else %>
      <%= @text %>
    <% end %>

    <%= render(Primer::Beta::Octicon.new(:"link-external", color: :subtle, classes: "HeaderMenu-external-icon")) if @external %>
  <% end %>
</li>
