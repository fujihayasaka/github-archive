<%= render Primer::Beta::Popover.new(
  test_selector: "navigation-popover",
  visibility: :hidden,
  position: :absolute,
  classes: "js-notice js-navigation-popover",
  left: 0,
  right: 0,
  data: helpers.analytics_visible_attributes(
    context: 'secret-scanning-popover',
    category: 'secret-scanning-popover',
    location: 'repo_navbar_security',
    tag: 'popover'
  )
) do |p| %>
  <% p.with_heading(tag: :h3, font_size: 4) { @heading } %>
  <% p.with_body(caret: :top, style: "width: 281px") do %>
    <%= form_tag(
      @dismiss_notice_href,
      class: "js-notice-dismiss position-absolute top-0 right-0"
    ) do %>
      <%= render Primer::Beta::CloseButton.new(type: :submit, mt: 4, mr: 4) %>
    <% end %>
    <p><%= @body_text %></p>
    <% if @cta.present? %>
      <%= render Primer::Beta::Button.new(
        test_selector: "cta",
        tag: :a,
        href: @cta[:href],
        data: helpers.analytics_click_attributes(
          location: "repo_navbar_security",
          tag: "button",
          action: "get_started",
          context: "secret-scanning-popover",
          category: "secret-scanning-popover"
        )
      ) do %>
        <%= @cta[:text] %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
