<% track_render_partial(tracking_name("global_side_panel"), tracking_tags) do %>
  <react-partial-anchor <%= test_selector("global-nav-menu") %>>
    <%= render Primer::Beta::Button.new(
      scheme: :default,
      data: {
        target: "react-partial-anchor.anchor"
      },
      p: 0,
      aria: { label: "Open menu" },
      classes: "AppHeader-button",
      color: :muted,
      show_tooltip: false,
      test_selector: "global-side-panel-trigger"
    ) do %>
      <%= render Primer::Beta::Octicon.new(icon: "three-bars") %>
    <% end %>
    <template data-target="react-partial-anchor.template">
      <%= render_react_partial(
        name: "global-nav-menu",
        props: nav_menu_props,
        disable_ssr: true
      ) %>
    </template>
  </react-partial-anchor>
<% end %>
