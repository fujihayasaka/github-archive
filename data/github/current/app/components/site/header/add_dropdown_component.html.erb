<react-partial-anchor>
  <%= render Primer::Beta::Button.new(
    id: "global-create-menu-anchor",
    classes: "AppHeader-button AppHeader-button--dropdown global-create-button cursor-wait",
    w: :auto,
    color: :muted,
    aria: { label: "Create something new" },
    disabled: true,
    test_selector: "header-add-dropdown",
    data: {
      target: "react-partial-anchor.anchor"
    }
  ) do |button|
    button.with_leading_visual_icon(icon: :plus)
    button.with_tooltip(text: "Create new…")
    primer_octicon(:"triangle-down")
  end %>
  <template data-target="react-partial-anchor.template">
    <%= render_react_partial(
      name: "global-create-menu",
      props: props,
      disable_ssr: true
    ) %>
  </template>
</react-partial-anchor>
