<react-partial-anchor>
  <%= render Primer::Beta::Button.new(
    id: global_agents_button_id,
    classes: "AppHeader-button AppHeader-buttonRight AppHeader-button--dropdown",
    aria: {
      label: "Open agents panel",
    },
    data: {
      target: "react-partial-anchor.anchor",
    },
    "aria-expanded": "false",
  ) do |button|
    button.with_leading_visual_icon(icon: :agent)
    button.with_tooltip(text: "Open agents panel")
    primer_octicon(:"triangle-down")
  end %>
  <template data-target="react-partial-anchor.template">
    <%= render_react_partial(
      name: "global-agents-menu",
      disable_ssr: true,
      props: agents_panel_payload
    ) %>
  </template>
</react-partial-anchor>
