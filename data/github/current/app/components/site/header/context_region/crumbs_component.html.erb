<ul role="list" class="list-style-none" <%= test_selector("crumbs-list") %>>
  <% context_crumbs.each_with_index do |crumb, index| %>
    <li>
      <%= render Primer::BaseComponent.new(**crumb_attributes(crumb)) do %>
        <span class="AppHeader-context-item-label <%= "Truncate-text" if compact? %> <%= crumb.label_classes %>">
          <% if user_or_global_feature_enabled?(:enterprise_breadcrumbs) %>
            <% if !compact? && index.zero? && context_crumbs.length > 2 && crumb.always_show_prefix_octicon? %>
              <%= primer_octicon crumb.prefix_octicon, size: :small, aria: { label: crumb.label }, color: :muted %>
            <% else %>
              <% if crumb.always_show_prefix_octicon? %>
                <%= primer_octicon crumb.prefix_octicon, size: :small, mr: 1, color: index == context_crumbs.length - 1 ? nil : :muted %>
              <% elsif compact? %>
                <%= primer_octicon crumb.prefix_octicon, size: :small, mr: 1, color: index == context_crumbs.length - 1 ? nil : :muted %>
              <% end %>

              <%= crumb.label %>
            <% end %>
          <% else %>
            <% if compact? %>
              <%= primer_octicon crumb.prefix_octicon, size: :xsmall, mr: 1 %>
            <% end %>

            <%= crumb.label %>
          <% end %>
        </span>

        <% if crumb.octicon.present? %>
          <%= primer_octicon(crumb.octicon, size: :xsmall, ml: 1) %>
        <% end %>
      <% end %>

      <% if !compact? && !is_last?(crumb) %>
        <span class="AppHeader-context-item-separator">
          <span class='sr-only'>/</span>
          <svg width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M10.956 1.27994L6.06418 14.7201L5 14.7201L9.89181 1.27994L10.956 1.27994Z" fill="currentcolor"/>
          </svg>
        </span>
      <% end %>
    </li>
  <% end %>
</ul>
