<%= render(Primer::Alpha::ActionMenu.new(data: { target: "context-region-controller.overflowActionMenu" }, test_selector: "overflow-menu")) do |menu| %>
  <% menu.with_show_button(icon: "kebab-horizontal", aria: { label: "Show more breadcrumb items" }) %>

  <% context_items.each do |item| %>
    <% menu.with_item(
      label: item.label,
      href: item_href(item),
      data: {
        "crumb-id": item.dom_id,
        targets: "context-region.overflowCrumbs",
        **analytics_click_attributes(
          category: "SiteHeaderComponent",
          action: "context_region_overflow_menu_crumb",
          label: "global-navigation"
        )
      },
      hidden: true,
    ) %>
  <% end %>
<% end %>

<% if include_divider? %>
  <%= render Site::Header::ContextRegion::CrumbDividerComponent.new %>
<% end %>
