<%#
  Make sure to update @github-ui/context-region-element/context-region-crumb-element.ts with any relevant markup changes
%>

<context-region role="list" <%= test_selector("dynamic-crumbs-list") %> data-action="context-region-changed:context-region-controller#crumbsChanged">
  <% context_crumbs.each_with_index do |crumb, index| %>
    <context-region-crumb
      data-targets="context-region.crumbs"
      data-label="<%= crumb.label %>"
      data-href="<%= crumb_attributes(crumb)[:href] %>"
      data-pre-rendered
      role="listitem"
      <%= "data-is-compact" if compact? %>
    >
      <%= render Primer::BaseComponent.new(**crumb_attributes(crumb)) do %>
        <span data-target="context-region-crumb.labelElement" class="AppHeader-context-item-label <%= "Truncate-text" if compact? %> <%= crumb.label_classes %>">
          <% if compact? %>
            <%= primer_octicon crumb.prefix_octicon, size: :xsmall, mr: 1, data: { target: "context-region-crumb.prefixIcon" } %>
          <% end %>

          <%= crumb.label %>
        </span>

        <% if crumb.octicon.present? %>
          <%= primer_octicon(crumb.octicon, size: :xsmall, ml: 1, data: { target: "context-region-crumb.trailingIcon" }) %>
        <% end %>
      <% end %>

      <% if !compact? %>
        <%= render Site::Header::ContextRegion::CrumbDividerComponent.new %>
      <% end %>
    </context-region-crumb>
  <% end %>
</context-region>
