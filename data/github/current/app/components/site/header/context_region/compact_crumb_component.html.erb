<strong class="AppHeader-context-compact-mainItem d-flex flex-items-center Truncate" <%= test_selector("compact-crumb") %>>
  <%= primer_octicon(crumb.prefix_octicon, size: :small, mr: 1) if crumb.prefix_octicon.present? && crumb.always_show_prefix_octicon? %>

  <span class="Truncate-text <%= crumb.label_classes %>"><%= crumb.label %></span>

  <% if crumb.octicon.present? %>
    <%= primer_octicon(crumb.octicon, size: :xsmall, ml: 1) %>
  <% end %>
</strong>
