<%#
  Make sure to update @github-ui/context-region-element/context-region-crumb-element.ts with any relevant markup changes
%>

<context-region data-target="context-region-controller.contextRegion" role="list" <%= test_selector("dynamic-crumbs-list") %> data-action="context-region-changed:context-region-controller#crumbsChanged" data-is-responsive>
  <% context_crumbs.each_with_index do |crumb, index| %>
    <context-region-crumb
      data-crumb-id="<%= crumb.dom_id %>"
      data-targets="context-region.crumbs"
      data-label="<%= crumb.label %>"
      data-href="<%= crumb_attributes(crumb)[:href] %>"
      data-pre-rendered
      data-is-responsive
      role="listitem"
      <%= "hidden" unless visible_crumbs.include?(crumb) %>
    >
      <%= render Primer::BaseComponent.new(**crumb_attributes(crumb), id: "#{crumb.dom_id}-link") do %>
        <span data-target="context-region-crumb.labelElement" class="AppHeader-context-item-label <%= crumb.label_classes %>">
          <%= crumb.label %>
        </span>

        <% if crumb.octicon.present? %>
          <%= primer_octicon(crumb.octicon, size: :xsmall, ml: 1, data: { target: "context-region-crumb.trailingIcon" }) %>
        <% end %>
      <% end %>

      <%= render Site::Header::ContextRegion::CrumbDividerComponent.new %>
    </context-region-crumb>

    <% if index == 0 %>
      <%# position the responsive overflow menu after the first crumb %>
      <li data-target="context-region-controller.overflowMenuContainer context-region.overflowMenuContainer" role="listitem" <%= "hidden" unless overflow_crumbs.any? %>>
        <%= render Site::Header::ContextRegion::ResponsiveOverflowMenuComponent.new(context_crumbs) %>
      </li>
    <% end %>
  <% end %>
</context-region>
