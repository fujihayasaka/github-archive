<div class="AppHeader-CopilotChat hide-sm hide-md">
  <react-partial-anchor>
    <% immersive_button_enabled = feature_enabled_globally_or_for_user?(feature_name: :copilot_header_button_to_immersive) %>
    <% if feature_enabled_globally_or_for_user?(feature_name: :copilot_f2p) && immersive_button_enabled %>
      <%= render Primer::Beta::Button.new(
        tag: :a,
        href: "/copilot",
        id: "copilot-chat-header-button",
        classes: "AppHeader-button AppHeader-buttonLeft cursor-wait copilotHeaderButton",
        data: { target: "react-partial-anchor.anchor" },
      ) do |component| %>
        <% component.with_leading_visual_icon(icon: :copilot, classes: "mr-1") %>
        <% component.with_tooltip(text: "Chat with Copilot") %>
        Copilot
      <% end %>
    <% else %>
      <%= render Primer::Beta::IconButton.new(
        icon: :copilot,
        "aria-label": "Chat with Copilot",
        tag: :a,
        href: "/copilot",
        classes: "AppHeader-button AppHeader-buttonLeft cursor-wait",
        data: {
          target: "react-partial-anchor.anchor",
        },
        id: "copilot-chat-header-button",
        **(immersive_button_enabled ? {} : {
          "aria-expanded": "false",
          "aria-controls": "copilot-chat-panel"
        })
      ) %>
    <% end %>
    <template data-target="react-partial-anchor.template">
      <%# TODO: temporary fix to get js to bundle correctly and HMR %>
      <%= javascript_bundle "copilot-chat" %>
      <%= stylesheet_bundle "copilot-markdown-rendering" %>
      <%= render Primer::Alpha::IncludeFragment.new(src: "#{ copilot_chat_path }?skip_anchor=true#{ params[:scroll_copilot_to_top].present? ? "&scroll_copilot_to_top=true" : "" }") %>
    </template>
  </react-partial-anchor>
  <react-partial-anchor>
    <%= render Primer::Beta::IconButton.new(
      icon: :"triangle-down",
      id: "global-copilot-menu-button",
      "aria-label": "Open Copilot…",
      classes: "AppHeader-button AppHeader-buttonRight",
      data: {
        target: "react-partial-anchor.anchor",
      },
      "aria-expanded": "false",
    ) %>
    <template data-target="react-partial-anchor.template">
      <%= render_react_partial(
        name: "global-copilot-menu",
        disable_ssr: true,
      ) %>
    </template>
  </react-partial-anchor>
</div>
