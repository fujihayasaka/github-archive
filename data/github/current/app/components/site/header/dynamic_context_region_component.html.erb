<context-region-controller
  class="AppHeader-context <%= "responsive-context-region" if responsive_enabled? %>"
  <%= "data-is-responsive" if responsive_enabled? %>
  <%= "data-max-items=#{MAX_CONTEXT_ITEMS}" if responsive_enabled? %>
  <%= test_selector("context-region") %>
>
  <% unless responsive_enabled? %>
    <div class="AppHeader-context-compact" data-target="context-region-controller.compactContainer">
      <%= render Site::Header::CompactContextRegionComponent.new(context_items, current_path) %>
    </div>
  <% end %>

  <div class="AppHeader-context-full">
    <nav role="navigation" aria-label="GitHub Breadcrumb">
      <% if responsive_enabled? %>
        <%= render Site::Header::ContextRegion::ResponsiveCrumbsComponent.new(
          context_items,
          current_path,
          max_context_items: MAX_CONTEXT_ITEMS
        ) %>
      <% else %>
        <%= render Site::Header::ContextRegion::DynamicCrumbsComponent.new(context_items, current_path) %>
      <% end %>
    </nav>
  </div>
</context-region-controller>
