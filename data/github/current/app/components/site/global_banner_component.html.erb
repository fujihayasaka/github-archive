<%= content_tag(:"global-banner",
  role: "alert",
  "aria-label": "Announcement",
  class: container_classes,
  id: @uid,
  data: @data.merge(
    analytics_visible_attributes(category: "global_banner", text: @uid),
    helpers.mktg_color_theme_data(mode: @mode),
  ),
  **@options
) do %>

  <% if @custom_design == "universe_26" %>
    <%= content_tag(:"a",
      data: @analytics,
      href: @link,
      class: "global-banner--universe_26-logolink no-underline lh-0 v-align-middle",
    ) do %>
      <%= image_tag(image_path("modules/site/global-banner/universe_26-logo.svg"),
        class: "global-banner--universe_26-logo",
        width: 145,
        height: 16,
        alt: "",
      ) %>
      <span class="sr-only">GitHub Universe 2026</span>
    <% end %>

    <hr class="global-banner--universe_26-divider">

    <div class="global-banner--universe_26-info">
      <%= content_tag(:span, @title, class: "global-banner--universe_26-title") if @title.present? %>

      <hr class="global-banner--universe_26-divider">

      <%= content_tag(:"a",
        data: @analytics,
        href: @link,
        class: "global-banner--link Link--inTextBlock Link--outlineOffset Link--underline no-wrap",
        style: "color: currentColor",
      ) do %>
        <%= @link_label %>
      <% end %>
    </div>

    <%= image_tag(image_path("modules/site/global-banner/universe_26-visual-desktop.webp"),
      class: "global-banner--universe_26-visual-desktop",
      width: 1140,
      height: 126,
      alt: "",
    ) %>

    <%= image_tag(image_path("modules/site/global-banner/universe_26-visual-mobile.webp"),
      class: "global-banner--universe_26-visual-mobile",
      width: 1140,
      height: 252,
      alt: "",
    ) %>

    <div class="global-banner--close position-absolute d-flex flex-items-center top-0 right-0">
      <%= render(Primer::Beta::CloseButton.new(
        data: analytics_click_attributes(
          category: "global_banner",
          action: "Dismiss global_banner_#{@uid}",
        ).merge({
          action: "click:global-banner#close"
        }),
      )) %>
    </div>

  <% else %>
    <% if @icon.present? %>
      <% if  @icon.is_a?(Symbol) %>
        <%= render(Primer::Beta::Octicon.new(@icon, size: :small, classes: "mr-1" )) %>
      <% else %>
        <%= render Site::ImageComponent.new(
          src: icon_src,
          width: 32,
          height: 32,
          max_width: 16,
          classes: "d-inline-block width-auto v-align-middle mr-1",
          style: "margin-top: -3px",
          alt: "",
          sizes: "16px",
          "aria-hidden": "true"
        ) %>
      <% end %>
    <% end %>

    <%= content_tag(:span, @title, class: "global-banner--title  mr-1") if @title.present? %>

    <%= content_tag(:"a",
      data: @analytics,
      href: @link,
      class: "global-banner--link Link--inTextBlock Link--outlineOffset Link--underline",
      style: "color: currentColor",
    ) do %>
      <%= @link_label %>
    <% end %>

    <div class="global-banner--close position-absolute height-full d-flex flex-items-center top-0 right-2 right-md-3 right-lg-7">
      <%= render(Primer::Beta::CloseButton.new(
        color: :on_emphasis,
        data: analytics_click_attributes(
          category: "global_banner",
          action: "Dismiss global_banner_#{@uid}",
        ).merge({
          action: "click:global-banner#close"
        }),
      )) %>
    </div>
  <% end %>
<% end %>
