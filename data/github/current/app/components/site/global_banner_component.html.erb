
<%= content_tag(:"global-banner",
  role: "alert",
  "aria-label": "Announcement",
  class: container_classes,
  id: @uid,
  data: @data.merge(
    analytics_visible_attributes(category: "global_banner", text: @uid),
    helpers.mktg_color_theme_data(mode: @mode),
  ),
  "data-countdown-target": @countdown_target,
  **@options
) do %>

  <% if @custom_design == "universe_25_1" %>
    <%= content_tag(:"a",
      data: @analytics,
      href: @link,
      class: "global-banner--universe_25_1-logolink no-underline lh-0 v-align-middle",
    ) do %>
      <%= render Site::ImageComponent.new(
        src: image_path("modules/site/global-banner/universe_25_1-logo.svg"),
        width: 140,
        height: 16,
        max_width: 140,
        classes: "global-banner--universe_25_1-logo",
        alt: "",
        sizes: "140px",
        optimize: false,
      ) %>
      <span class="sr-only">GitHub Universe 2025</span>
    <% end %>

    <hr class="global-banner--universe_25_1-divider">


    <%# Countdown %>
    <span aria-hidden="true" class="global-banner--universe_25_1-countdown js-global-banner-countdown">
      <%= content_tag(:span, "Last chance:", class: "global-banner--universe_25_1-title") %>
      <span class="global-banner--universe_25_1-countdown-dot">•</span>
      <span class="global-banner--universe_25_1-countdown-number js-global-banner-countdown-number">00:00:00:00</span>
      <span class="global-banner--universe_25_1-countdown-dot">•</span>
    </span>

    <%= content_tag(:span, @title, class: "global-banner--universe_25_1-title") if @title.present? %>

    <%= content_tag(:"a",
      data: @analytics,
      href: @link,
      class: "global-banner--link Link--inTextBlock Link--outlineOffset Link--underline no-wrap",
      style: "color: currentColor",
    ) do %>
      <%= @link_label %>
    <% end %>

    <div class="global-banner--universe_25_1-visuals" aria-hidden="true">
      <%= render Site::ImageComponent.new(
        class: "global-banner--universe_25_1-cloud-1",
        src: image_path("modules/site/global-banner/universe_25_1-cloud-1.webp"),
        width: 138,
        height: 78,
        max_width: 138,
        alt: "",
        sizes: "138px",
        optimize: false,
      ) %>

      <%= render Site::ImageComponent.new(
        class: "global-banner--universe_25_1-cloud-2",
        src: image_path("modules/site/global-banner/universe_25_1-cloud-2.webp"),
        width: 212,
        height: 80,
        max_width: 212,
        alt: "",
        sizes: "212px",
        optimize: false,
      ) %>

      <div class="global-banner--universe_25_1-butterfly">
        <%= render Site::ImageComponent.new(
          class: "global-banner--universe_25_1-butterfly-wing",
          src: image_path("modules/site/global-banner/universe_25_1-butterfly.svg"),
          width: 26,
          height: 16,
          max_width: 26,
          alt: "",
          sizes: "26px",
          optimize: false,
        ) %>

        <%= render Site::ImageComponent.new(
          class: "global-banner--universe_25_1-butterfly-wing",
          src: image_path("modules/site/global-banner/universe_25_1-butterfly.svg"),
          width: 26,
          height: 16,
          max_width: 26,
          alt: "",
          sizes: "26px",
          optimize: false,
        ) %>
      </div>
    </div>

    <div class="global-banner--close position-absolute height-full d-flex flex-items-center top-0 right-0">
      <%= render(Primer::Beta::CloseButton.new(
        data: analytics_click_attributes(
          category: "global_banner",
          action: "Dismiss global_banner_#{@uid}",
        ).merge({
          action: "click:global-banner#close"
        }),
      )) %>
    </div>

  <% elsif @custom_design == "universe_25_2" %>
    <%= content_tag(:"a",
      data: @analytics,
      href: @link,
      class: "global-banner--universe_25_1-logolink no-underline lh-0 v-align-middle",
    ) do %>
      <%= render Site::ImageComponent.new(
        src: image_path("modules/site/global-banner/universe_25_1-logo.svg"),
        width: 140,
        height: 16,
        max_width: 140,
        classes: "global-banner--universe_25_1-logo",
        alt: "",
        sizes: "140px",
        optimize: false,
      ) %>
      <span class="sr-only">GitHub Universe 2025</span>
    <% end %>

    <hr class="global-banner--universe_25_1-divider">

    <%= content_tag(:span, @title, class: "global-banner--universe_25_1-title") if @title.present? %>

    <%= content_tag(:"a",
      data: @analytics,
      href: @link,
      class: "global-banner--link Link--inTextBlock Link--outlineOffset Link--underline no-wrap",
      style: "color: currentColor",
    ) do %>
      <%= @link_label %>
    <% end %>

    <div class="global-banner--universe_25_1-visuals" aria-hidden="true">
      <%= render Site::ImageComponent.new(
        class: "global-banner--universe_25_1-cloud-1",
        src: image_path("modules/site/global-banner/universe_25_1-cloud-1.webp"),
        width: 138,
        height: 78,
        max_width: 138,
        alt: "",
        sizes: "138px",
        optimize: false,
      ) %>

      <%= render Site::ImageComponent.new(
        class: "global-banner--universe_25_1-cloud-2",
        src: image_path("modules/site/global-banner/universe_25_1-cloud-2.webp"),
        width: 212,
        height: 80,
        max_width: 212,
        alt: "",
        sizes: "212px",
        optimize: false,
      ) %>

      <div class="global-banner--universe_25_1-butterfly">
        <%= render Site::ImageComponent.new(
          class: "global-banner--universe_25_1-butterfly-wing",
          src: image_path("modules/site/global-banner/universe_25_1-butterfly.svg"),
          width: 26,
          height: 16,
          max_width: 26,
          alt: "",
          sizes: "26px",
          optimize: false,
        ) %>

        <%= render Site::ImageComponent.new(
          class: "global-banner--universe_25_1-butterfly-wing",
          src: image_path("modules/site/global-banner/universe_25_1-butterfly.svg"),
          width: 26,
          height: 16,
          max_width: 26,
          alt: "",
          sizes: "26px",
          optimize: false,
        ) %>
      </div>
    </div>

    <div class="global-banner--close position-absolute height-full d-flex flex-items-center top-0 right-0">
      <%= render(Primer::Beta::CloseButton.new(
        data: analytics_click_attributes(
          category: "global_banner",
          action: "Dismiss global_banner_#{@uid}",
        ).merge({
          action: "click:global-banner#close"
        }),
      )) %>
    </div>

  <% elsif @custom_design == "universe_25_3_clouds" || @custom_design == "universe_25_3_copilot" || @custom_design == "universe_25_3_duck" %>

  <div class="global-banner--universe_25_3-logolink-container">
    <%= content_tag(:"a",
      data: @analytics,
      href: @link,
      class: "global-banner--universe_25_3-logolink no-underline lh-0 v-align-middle",
    ) do %>
      <%= render Site::ImageComponent.new(
        src: image_path("modules/site/global-banner/universe_25_1-logo.svg"),
        width: 140,
        height: 16,
        max_width: 140,
        classes: "global-banner--universe_25_3-logo",
        alt: "",
        sizes: "140px",
        optimize: false,
      ) %>
      <span class="sr-only">GitHub Universe 2025</span>
    <% end %>
   </div>

    <hr class="global-banner--universe_25_3-divider" aria-hidden="true">

    <div class="global-banner--universe_25_3-title-container">
      <% if @custom_design == "universe_25_3_copilot" %>
        <div class="global-banner--universe_25_3-live"></div>
      <% end %>

      <%= content_tag(:span, @title, class: "global-banner--universe_25_3-title") if @title.present? %>

      <%# Countdown %>
      <span aria-hidden="true" class="global-banner--universe_25_3-countdown js-global-banner-countdown">
        <span class="global-banner--universe_25_3-countdown-dot">•</span>
        <span class="global-banner--universe_25_3-countdown-number js-global-banner-countdown-number">00 : 00 : 00 : 00</span>
      </span>
    </div>

    <hr class="global-banner--universe_25_3-divider" aria-hidden="true">

    <%= content_tag(:"a",
      data: @analytics,
      href: @link,
      class: "global-banner--link Link--inTextBlock Link--outlineOffset Link--underline no-wrap",
      style: "color: currentColor",
    ) do %>
      <%= @link_label %>
    <% end %>

    <div class="global-banner--universe_25_3-visuals-container">
      <div class="global-banner--universe_25_3-visuals" aria-hidden="true">
        <% if @custom_design == "universe_25_3_clouds" %>
          <%= render Site::ImageComponent.new(
            class: "global-banner--universe_25_3-cloud-1",
            src: image_path("modules/site/global-banner/universe_25_1-cloud-1.webp"),
            width: 138,
            height: 78,
            max_width: 138,
            alt: "",
            sizes: "138px",
            optimize: false,
          ) %>

          <%= render Site::ImageComponent.new(
            class: "global-banner--universe_25_3-cloud-2",
            src: image_path("modules/site/global-banner/universe_25_1-cloud-2.webp"),
            width: 212,
            height: 80,
            max_width: 212,
            alt: "",
            sizes: "212px",
            optimize: false,
          ) %>

          <div class="global-banner--universe_25_3-butterfly">
            <%= render Site::ImageComponent.new(
              class: "global-banner--universe_25_3-butterfly-wing-first",
              src: image_path("modules/site/global-banner/universe_25_1-butterfly.svg"),
              width: 26,
              height: 16,
              max_width: 26,
              alt: "",
              sizes: "26px",
              optimize: false,
            ) %>

            <%= render Site::ImageComponent.new(
              class: "global-banner--universe_25_3-butterfly-wing-second",
              src: image_path("modules/site/global-banner/universe_25_1-butterfly.svg"),
              width: 26,
              height: 16,
              max_width: 26,
              alt: "",
              sizes: "26px",
              optimize: false,
            ) %>
          </div>
        <% end %>

        <% if @custom_design == "universe_25_3_copilot" %>
          <%= render Site::ImageComponent.new(
            class: "global-banner--universe_25_3-copilot",
            src: image_path("modules/site/global-banner/universe_25_1-copilot.webp"),
            width: 381,
            height: 244,
            max_width: 381,
            alt: "",
            sizes: "381px",
            optimize: false,
          ) %>
        <% end %>

        <% if @custom_design == "universe_25_3_duck" %>
          <%= render Site::ImageComponent.new(
            class: "global-banner--universe_25_3-duck",
            src: image_path("modules/site/global-banner/universe_25_1-duck.webp"),
            width: 381,
            height: 244,
            max_width: 381,
            alt: "",
            sizes: "381px",
            optimize: false,
          ) %>
        <% end %>
      </div>

      <div class="global-banner--close position-absolute height-full d-flex flex-items-center top-0 right-0">
        <%= render(Primer::Beta::CloseButton.new(
          data: analytics_click_attributes(
            category: "global_banner",
            action: "Dismiss global_banner_#{@uid}",
          ).merge({
            action: "click:global-banner#close"
          }),
        )) %>
      </div>
    </div>

  <% else %>
    <% if @icon.present? %>
      <% if  @icon.is_a?(Symbol) %>
        <%= render(Primer::Beta::Octicon.new(@icon, size: :small, classes: "mr-1" )) %>
      <% else %>
        <%= render Site::ImageComponent.new(
          src: icon_src,
          width: 32,
          height: 32,
          max_width: 16,
          classes: "d-inline-block width-auto v-align-middle mr-1",
          style: "margin-top: -3px",
          alt: "",
          sizes: "16px",
          "aria-hidden": "true"
        ) %>
      <% end %>
    <% end %>

    <%= content_tag(:span, @title, class: "global-banner--title  mr-1") if @title.present? %>

    <%= content_tag(:"a",
      data: @analytics,
      href: @link,
      class: "global-banner--link Link--inTextBlock Link--outlineOffset Link--underline",
      style: "color: currentColor",
    ) do %>
      <%= @link_label %>
    <% end %>

    <div class="global-banner--close position-absolute height-full d-flex flex-items-center top-0 right-2 right-md-3 right-lg-7">
      <%= render(Primer::Beta::CloseButton.new(
        color: :on_emphasis,
        data: analytics_click_attributes(
          category: "global_banner",
          action: "Dismiss global_banner_#{@uid}",
        ).merge({
          action: "click:global-banner#close"
        }),
      )) %>
    </div>
  <% end %>
<% end %>
