<div class="GlobalSidebar" role="navigation" aria-label="Global navigation">
  <div class="GlobalSidebar-logo">
    <%= link_to "/", class: "GlobalSidebar-logoLink", "aria-label" => "Homepage" do %>
      <%= primer_octicon :"mark-github", height: 32 %>
    <% end %>
  </div>

  <nav class="GlobalSidebar-nav" aria-label="Global site navigation">
    <ul class="GlobalSidebar-navList">
      <% nav_items.each do |item| %>
          <li class="GlobalSidebar-navItem <%= 'GlobalSidebar-navItem--active' if active_item?(item) %>" <%= test_selector("sidebar-nav-item") %>>
            <%= render(Primer::Beta::Button.new(
              tag: :a,
              href: item.href,
              scheme: :invisible,
              size: :small,
              classes: 'GlobalSidebar-button',
              "aria-label" => item.label,
              "aria-current" => active_item?(item) ? "page" : nil
            )) do |component| %>
              <% component.with_leading_visual_icon(icon: item.icon) %>
              <%= item.label %>
            <% end %>
          </li>
      <% end %>
      <li class="GlobalSidebar-navItem">
        <%= render(Primer::Alpha::ActionMenu.new(
          menu_id: "global-more-menu",
          anchor_side: :outside_right,
          anchor_align: :center
        )) do |menu| %>
          <% menu.with_show_button(scheme: :invisible, size: :small, classes: 'GlobalSidebar-button') do |button| %>
            <% button.with_leading_visual_icon(icon: :"kebab-horizontal") %>
            More
          <% end %>
          <% menu_items.each do |item| %>
            <% menu.with_divider if item.divider_before %>
            <% menu.with_item(label: item.label, href: item.href) do |menu_item| %>
              <% menu_item.with_leading_visual_icon(icon: item.icon) %>
              <% menu_item.with_description.with_content(item.description) %>
            <% end %>
          <% end %>
        <% end %>
      </li>
    </ul>
  </nav>

  <div class="GlobalSidebar-feedback">
    <div class="GlobalSidebar-navItem">
      <%= render(Primer::Beta::Button.new(
        tag: :a,
        href: "https://gh.io/global-nav-survey",
        scheme: :invisible,
        size: :small,
        classes: "GlobalSidebar-button"
      )) do |component| %>
        <% component.with_leading_visual_icon(icon: :"link-external") %>
        Feedback
      <% end %>
    </div>
    <%= render(Primer::Beta::Label.new(
        scheme: :secondary
      )) do %>
      Private
    <% end %>
  </div>

</div>
