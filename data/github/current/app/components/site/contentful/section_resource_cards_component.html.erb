<div class="color-bg-subtle tmp-py-5 tmp-py-md-6 tmp-mt-6 tmp-mt-md-12" <%= test_selector("contentful-section-resource-cards-component") %>>
  <div class="container-xl mx-auto p-responsive text-left tmp-mt-5">
    <div class="d-md-flex flex-wrap flex-justify-center gutter tmp-my-5 tmp-my-md-6">
      <% @items.each do |item| %>
        <%= render Site::Contentful::ResourceCardComponent.new(title: item.title, text: item.text, link: item.link) %>
      <% end %>
    </div>
  </div>
</div>
