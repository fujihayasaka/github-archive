<li class="HeaderMenu-item position-relative flex-wrap flex-justify-between flex-items-center d-block d-lg-flex flex-lg-nowrap flex-lg-items-center js-details-container js-header-menu-item">
  <% if @columns.present? %>
    <% cache columns_cache_key do %>
      <button type="button" class="HeaderMenu-link border-0 width-full width-lg-auto px-0 px-lg-2 py-lg-2 no-wrap d-flex flex-items-center flex-justify-between js-details-target" aria-expanded="false">
        <%= @text %>
        <%= render(Primer::Beta::Octicon.new(:"chevron-down", ml: 1, opacity: 0.5, classes: "HeaderMenu-icon")) %>
      </button>

      <div class="<%= dropdown_classes %>">
        <% @columns.each_with_index do |column, index| %>
          <% border_classes = (
            user_or_global_feature_enabled?(:site_msbuild_launch) ?
              column_border_classes(column == @columns.last, index == @columns.length - 2) :
              column_border_classes(column == @columns.last)
          ) %>
          <div class="<%= border_classes %>">
            <% column[:groups].each do |group| %>
             <%# Skipping lint check for this line. Check incorrectly flagging column variable as deprecated Primer class name %>
             <%# erblint:counter DeprecatedInPrimerCounter 1 %>
              <div class="<%= group_border_classes(group == column[:groups].last, column == @columns.last && !@trailing_link.present?) %>">
                <% if group[:title].present? %>
                  <% group_id = "#{@text}-#{group[:title]}-heading".parameterize %>
                  <% if group[:url].present? %>
                    <%= link_to group[:url], class: "d-block h4 color-fg-default my-1 Link--primary no-underline", id: group_id do %>
                      <%= group[:title] %>
                    <% end %>
                  <% else %>
                    <%= tag.span(group[:title], class: "d-block h4 color-fg-default my-1", id: group_id) %>
                  <% end %>
                <% end %>

                <ul class="list-style-none f5" <% if group[:title].present? %>aria-labelledby="<%= group_id %>"<% end %>>
                  <% group[:items].each do |item| %>
                    <%= render Site::HeaderDropdownItemComponent.new(
                      analytics: {
                        context: @text.gsub(" ", "_"),
                        location: "navbar",
                        tag: "link"
                      },
                      item_last: item == group[:items].last,
                      **item
                    ) %>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @trailing_link.present? %>
         <div class="HeaderMenu-trailing-link rounded-bottom-2 flex-shrink-0 mt-lg-4 px-lg-4 py-4 py-lg-3 f5 text-semibold">
            <%= link_to @trailing_link[:url], data: @trailing_link[:data] do %>
              <%= @trailing_link[:text] %>
              <%= render(Primer::Beta::Octicon.new(:"chevron-right", classes: "HeaderMenu-trailing-link-icon")) %>
            <% end %>
         </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%= link_to @text, @url, class: "HeaderMenu-link no-underline px-0 px-lg-2 py-3 py-lg-2 d-block d-lg-inline-block", data: @data %>
  <% end %>
</li>
