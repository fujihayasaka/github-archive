<div class="tmp-mb-3 dashboard-changelog color-bg-default border color-border-muted tmp-p-3 rounded-3" <%= test_selector("dashboard_changelog_component") %>>
  <h2 class="f5 text-bold tmp-mb-3 width-full dashboard-changelog__title">Latest from our changelog</h2>

  <ul class="list-style-none">
    <% items.each_with_index do |item, index| %>
      <li class="TimelineItem TimelineItem--condensed ml-1 pt-0 <%= index == items.size - 1 ? "pb-0" : "tmp-pb-3" %>">
        <div class="TimelineItem-badge mt-0 color-bg-transparent">
          <%= render Primer::Beta::Octicon.new(icon: :"dot-fill", mb: 2) %>
        </div>
        <div class="TimelineItem-body mt-n1">
          <div class="text-small color-fg-muted dashboard-changelog-timestamp"><%= time_ago_in_words_js(item[:date]) %></div>
          <%= render(Primer::Beta::Link.new(
            href: item[:url],
            classes: "Link--primary line-clamp-2",
            data: changelog_item_hydro_attributes,
            test_selector: :dashboard_changelog_component_link,
          )) { item[:title] } %>
        </div>
      </li>
    <% end %>
  </ul>

  <div class="width-full ml-1 pt-2 tmp-pl-4 border-left color-border-muted">
    <%= link_to "View changelog →", CHANGELOG_URL, class: "text-small mt-2 Link--muted" %>
  </div>
</div>
