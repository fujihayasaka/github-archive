<div class="d-flex flex-items-center gap-2">
  <% if helpers.dashboard_universe_enabled? %>
    <%= render(GitHub::AvatarComponent.new(actor: current_context, size: 32)) %>
  <div class="d-flex flex-items-center flex-justify-between width-full">
    <div class="d-flex flex-column">
    <span class="text-bold"><%= current_context.display_login %></span>
    <% if current_context.user? && current_context == current_user %>
      <span class="d-block color-fg-muted mb-1 mb-md-0 text-small">Your personal account</span>
    <% end %>
    </div>
    <%= render(Primer::Alpha::SelectPanel.new(
        id: id,
        title: "Go to organization dashboard",
        src: dashboard_ajax_context_list_path(current_context: current_context, id: id),
        preload: preload?,
        dynamic_label: true,
        size: :small,
        fetch_strategy: :eventually_local,
        show_filter: filterable?
      )) do |menu| %>
        <% menu.with_show_button(icon: :"arrow-switch", scheme: :invisible, "data-test-selector": "account-context", "aria-label": "Switch dashboard: #{current_context.display_login}") %>
        <% menu.with_footer(classes: "tmp-pt-3") do |footer| %>
          <%= render(Primer::Beta::Button.new(
            href: settings_organizations_path,
            tag: :a,
            block: true,
          )) do |button| %>
            <% button.with_leading_visual_icon(icon: :organization) %>
            Manage organizations
          <% end %>
          <% if user_can_create_orgs? %>
            <%= render(Primer::Beta::Button.new(
              data: test_selector_hash("context-create-org"),
              href: new_organization_path,
              tag: :a,
              block: true,
            )) do |button| %>
              <% button.with_leading_visual_icon(icon: :plus) %>
              Create organization
            <% end %>
          <% end %>
        <% end %>
      <% end %>
  </div>
  <% else %>
    <%= render(GitHub::AvatarComponent.new(actor: current_context)) %>
    <%= render(Primer::Alpha::SelectPanel.new(
      id: id,
      title: "Go to organization dashboard",
      src: dashboard_ajax_context_list_path(current_context: current_context, id: id),
      preload: preload?,
      dynamic_label: true,
      size: :small,
      fetch_strategy: :eventually_local,
      show_filter: filterable?
    )) do |menu| %>
      <% menu.with_show_button(scheme: :invisible, "data-test-selector": "account-context", "aria-label": "Go to #{current_context.display_login} dashboard") do |button| %>
        <% button.with_trailing_action_icon(icon: :"triangle-down") %>
        <%= current_context.display_login %>
      <% end %>
      <% menu.with_footer(classes: "tmp-pt-3") do |footer| %>
        <%= render(Primer::Beta::Button.new(
          href: settings_organizations_path,
          tag: :a,
          block: true,
        )) do |button| %>
          <% button.with_leading_visual_icon(icon: :organization) %>
          Manage organizations
        <% end %>
        <% if user_can_create_orgs? %>
          <%= render(Primer::Beta::Button.new(
            data: test_selector_hash("context-create-org"),
            href: new_organization_path,
            tag: :a,
            block: true,
          )) do |button| %>
            <% button.with_leading_visual_icon(icon: :plus) %>
            Create organization
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
