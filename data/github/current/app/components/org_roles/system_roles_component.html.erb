<%= render(Primer::Box.new(
  display: :flex,
  direction: :column,
  border: true,
  border_radius: 2,
  test_selector: "system-roles-component",
  **system_arguments,
)) do %>
  <% roles.each_with_index do |role, idx| %>
    <div class="<%= "border-top" unless idx == 0 %>">
      <% if role.name == "all_repo_read" %>
        <%= render(Primer::Box.new(display: :flex, align_items: :center, px: 3, py: 2)) do %>
          <%= render(Primer::Beta::Octicon.new(icon: role.octicon, align_self: :start, mt: 2, mr: 1, "aria-label": "#{role.name} icon", color: :muted)) %>
          <div class="d-flex flex-column flex-1 ml-2 mr-3 my-1 gap-1 min-width-0">
            <%= render(Primer::Beta::Text.new(font_weight: :bold, font_size: 5)) { role.display_name } %>
            <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6)) { role.description } %>
          </div>
        <% end %>
      <% else %>
        <%= render(CustomRoles::ExpandableRoleRowComponent.new(role: role)) %>
      <% end %>
    </div>
  <% end %>
<% end %>
