<%# erblint:counter ButtonComponentMigrationCounter 2 %>
<div role="region" aria-label="Annotations" class="js-updatable-content js-socket-channel " <%= test_selector("job-annotations-component") %> <% unless ux_refresh %>style="min-width: 750px;"<% end %>>
  <job-annotations>
    <div class="color-bg-default color-shadow-small pt-3 pb-1 <% if ux_refresh %> border rounded <% end %>">
      <div class="d-flex flex-items-center">
        <div class="mt-1 mb-3 px-3 d-flex flex-self-stretch">
          <div class="pt-2 pr-1">
            <%= render Primer::Beta::Button.new(scheme: :link, color: :muted, "data-target": "job-annotations.closeButton", "data-action": "click:job-annotations#close", tabindex: 0, hidden: true, "aria-label": "Close job annotations" ) do %>
              <%= render Primer::Beta::Octicon.new(icon: "chevron-down") %>
            <% end %>
            <%= render Primer::Beta::Button.new(scheme: :link, color: :muted, "data-target": "job-annotations.openButton", "data-action": "click:job-annotations#open", tabindex: 0, "aria-label": "Open job annotations") do %>
              <%= render Primer::Beta::Octicon.new(icon: "chevron-right") %>
            <% end %>
          </div>
          <div class="mx-0 mx-md-1">
            <h2 class="text-bold h4">Annotations</h2>
            <div class="color-fg-muted text-small"><%= subtitle %></div>
          </div>
        </div>
        <div class="d-flex flex-1"></div>
      </div>
      <div data-target="job-annotations.bodyContainer" hidden>
        <table class="width-full mt-n1 actions-workflow-table table-fixed">
            <% annotations.each_with_index do |annotation, index| %>
              <tr role="row">
                <td class="compact pr-3 col-7 col-lg-9 color-border-muted<% unless index == num_annotations - 1 %> border-bottom<% end %>">
                  <annotation-message class="d-flex">
                    <% step_name_for_annotation = step_name_for_annotation(annotation.step_number) %>
                    <div><%= octicon_for(annotation) %></div>
                    <div class="ml-1 overflow-hidden">
                      <a <%= test_selector("job-annotations-link") %> class="d-block no-underline Link--secondary color-fg-default" href="<%= link_to_line(annotation) %>">
                        <% if step_name_for_annotation.present? %>
                          <strong><%= step_name_for_annotation %><% unless annotation.system_path? %>: <% end %></strong>
                        <% end %>
                        <% unless annotation.system_path? %><%= annotation.parsed_file_name %>#L<%= annotation.start_line %><% end %>
                      </a>
                      <div class="color-fg-muted">
                        <div data-target="annotation-message.annotationContainer" class="text-small text-mono annotation--contracted">
                          <%= message(annotation) %>
                        </div>
                        <button data-action="click:annotation-message#toggleExpansion" data-target="annotation-message.showMoreButton" class="btn-link text-normal" type="button">Show more</button>
                        <button data-action="click:annotation-message#toggleExpansion" data-target="annotation-message.showLessButton" class="btn-link text-normal" hidden type="button">Show less</button>
                      </div>
                    </div>
                  </annotation-message>
                </td>
              </tr>
            <% end %>
        </table>
      </div>
    </div>
  </job-annotations>
  <% if ux_refresh %>
    <div class="color-bg-default pb-3"></div>
  <% else %>
    <div class="actions-fullwidth-module color-bg-default border-top"></div>
  <% end %>
</div>
