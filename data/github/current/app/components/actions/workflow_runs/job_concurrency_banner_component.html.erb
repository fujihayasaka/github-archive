<% track_render_partial("actions/job_blocking_resources") do %>
  <%
    div_options = {}
    if @should_update
      div_options[:class] = "js-updatable-content js-socket-channel"
      div_options[:data] = {
        channel: data_channels,
        url: workflow_run_job_concurrency_banner_partial_path(
          workflow_run_id: @check_suite.workflow_run.id,
          job_id: @check_run.workflow_job_run.id,
          repository: current_repository,
          user_id: current_repository.owner.display_login
        )
      }
    end
  %>
  <%= content_tag(:div, **div_options) do %>
    <% if display? %>
      <div class="Blocked-Check-Warning d-flex flex-row flex-items-center tmp-mt-4 tmp-pl-3">
        <span>
          <span class="Blocked-Check-Text text-mono text-small mr-1 ">Waiting:</span>
          <span class="Content-Text text-mono text-small">
            <%= blocked_subject_text %> is waiting on
            <% if blocking_resources_count == 1 %>
              <a class="no-underline" href="<%= blocking_resources.first[:url] %>"><%= item_display_name(blocking_resources.first) %></a>
              <% if show_workflow_name?(blocking_resources.first) %>
                (<a class="no-underline" href="<%= blocking_resources.first[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.first) %></a>)
              <% end %>
            <% elsif blocking_resources_count == 2 %>
              <a class="no-underline" href="<%= blocking_resources.first[:url] %>"><%= item_display_name(blocking_resources.first) %></a>
              <% if show_workflow_name?(blocking_resources.first) %>
                (<a class="no-underline" href="<%= blocking_resources.first[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.first) %></a>)
              <% end %> and
              <a class="no-underline" href="<%= blocking_resources.second[:url] %>"><%= item_display_name(blocking_resources.second) %></a>
              <% if show_workflow_name?(blocking_resources.second) %>
                (<a class="no-underline" href="<%= blocking_resources.second[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.second) %></a>)
              <% end %>
            <% elsif blocking_resources_count > 2 %>
              <a class="no-underline" href="<%= blocking_resources.first[:url] %>"><%= item_display_name(blocking_resources.first) %></a><% if show_workflow_name?(blocking_resources.first) %>
              (<a class="no-underline" href="<%= blocking_resources.first[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.first) %></a>)<% end -%>,
              <a class="no-underline" href="<%= blocking_resources.second[:url] %>"><%= item_display_name(blocking_resources.second) %></a><% if show_workflow_name?(blocking_resources.second) %>
              (<a class="no-underline" href="<%= blocking_resources.second[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.second) %></a>)<% end -%>,
              and <%= pluralize(blocking_resources_count - 2, "other") %>
            <% end %>
            to complete before running.
          </span>
        </span>
      </div>
    <% end %>
  <% end %>
<% end %>
