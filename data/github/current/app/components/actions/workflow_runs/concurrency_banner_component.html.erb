<% track_render_partial("actions/blocking_resources") do %>
  <%
    div_options = {}
    if @should_update
      div_options[:class] = "js-updatable-content js-socket-channel"
      div_options[:data] = {
        channel: data_channels,
        url: workflow_run_concurrency_banner_partial_path(workflow_run_id: @check_suite.workflow_run.id, repository: current_repository, user_id: current_repository.owner.display_login)
      }
    end
  %>
  <%= content_tag(:div, **div_options) do %>
      <% if @check_suite&.status == "pending" && !blocking_resources.empty? && @should_update %>
        <%= render(Primer::Alpha::Banner.new(scheme: :warning, icon: "rocket", test_selector: "serialization-info", classes: "tmp-py-3 tmp-my-3")) do |component| %>
          <%= blocked_at_level_verbiage %> waiting for

          <% if blocking_resources_count == 1 %>
            <%= render Actions::WorkflowRuns::WorkflowJobNameLinkComponent.new(name: item_display_name(blocking_resources.first), url: blocking_resources.first[:url]) %>
            <% if show_workflow_name?(blocking_resources.first) %>
              (<a class="Link--inTextBlock" href="<%= blocking_resources.first[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.first) %></a>)
            <% end %>
          <% elsif blocking_resources_count == 2 %>
            <%= render Actions::WorkflowRuns::WorkflowJobNameLinkComponent.new(name: item_display_name(blocking_resources.first), url: blocking_resources.first[:url]) %>
            <% if show_workflow_name?(blocking_resources.first) %>
              (<a class="Link--inTextBlock" href="<%= blocking_resources.first[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.first) %></a>)
            <% end %> and
            <%= render Actions::WorkflowRuns::WorkflowJobNameLinkComponent.new(name: item_display_name(blocking_resources.second), url: blocking_resources.second[:url]) %>
            <% if show_workflow_name?(blocking_resources.second) %>
              (<a class="Link--inTextBlock" href="<%= blocking_resources.second[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.second) %></a>)
            <% end %>
          <% elsif blocking_resources_count > 2 %>
            <a class="no-underline" href="<%= blocking_resources.first[:url] %>"><%= item_display_name(blocking_resources.first) %></a><% if show_workflow_name?(blocking_resources.first) %>
            (<a class="Link--inTextBlock" href="<%= blocking_resources.first[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.first) %></a>)<% end -%>,
            <a class="no-underline" href="<%= blocking_resources.second[:url] %>"><%= item_display_name(blocking_resources.second) %></a><% if show_workflow_name?(blocking_resources.second) %>
            (<a class="Link--inTextBlock" href="<%= blocking_resources.second[:workflow_run_url] %>"><%= workflow_display_name(blocking_resources.second) %></a>)<% end -%>,
            and <%= pluralize(blocking_resources_count - 2, "other") %>
          <% end %>
          to complete before running.
          <a class="Link--inTextBlock" href="<%= GitHub.help_url %>/actions/reference/workflow-syntax-for-github-actions#concurrency">Learn more about concurrency</a>.
        <% end %>
      <% end %>
  <% end %>
<% end %>
