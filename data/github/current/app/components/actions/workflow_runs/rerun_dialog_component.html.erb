<%= render(Primer::Alpha::Dialog.new(
  title: title,
  size: :large,
  id: @dialog_id,
  color: :default,
)) do |d| %>
  <% d.with_header do %>
      <div class="text-semibold">
        <%= title %>
      </div>
      <div class="color-fg-muted my-2">
        <%= subtitle %>
      </div>
  <% end %>
  <% d.with_body do %>
    <div class="border rounded py-2 tmp-px-3">
      <%= render Primer::Alpha::IncludeFragment.new(loading: "lazy", src: job_list_src) do %>
        <%= render(Primer::Beta::Spinner.new(mx: :auto, display: :block, classes: "tmp-my-3")) %>
      <% end %>
    </div>
    <%= form_tag workflow_run_rerequest_check_suite_path(workflow_run_id: @workflow_run.id, user_id: @current_repository.owner, repository: @current_repository, pr: params[:pr]), method: "put", id: "rerun-form-#{@dialog_id}" do %>
      <% if @variant == :failed_jobs %>
        <input type="hidden" name="only_failed_check_runs" value="true">
      <% elsif @variant == :single_job %>
        <input type="hidden" name="check_run_id" value="<%= @job.check_run.id %>">
      <% end %>
      <div class="d-flex flex-column tmp-mt-3">
        <div class="form-checkbox m-0">
          <label class="text-normal">
            <input type="checkbox" name="enable_debug_logging" value="true">Enable <a class="color-fg-accent Link--inTextBlock" href="<%= GitHub.help_url %>/actions/monitoring-and-troubleshooting-workflows/enabling-debug-logging">debug logging</a>
          </label>
        </div>
        <% if show_enable_debugger_checkbox? %>
          <div class="form-checkbox m-0">
            <label class="text-normal d-inline<%= " color-fg-muted" unless debugger_eligible? %>">
              <input type="checkbox" name="enable_debugger" value="true"<%= " disabled" unless debugger_eligible? %>>Enable debugger
            </label>
            <%= render(Primer::Beta::Label.new(scheme: :accent, ml: 1)) { "New" } %>
            <% unless debugger_eligible? %>
              <div class="color-fg-muted text-small"><%= debugger_ineligibility_message %></div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <% d.with_footer(show_divider: true) do %>
    <div class="d-flex flex-justify-end width-full">
      <%= render Primer::Beta::Button.new(type: :button, data: { "close-dialog-id": @dialog_id }) do %>
        Cancel
      <% end %>
      <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary, ml: 2, data: { disable_with: "Re-running..."}, form: "rerun-form-#{@dialog_id}") do %>
        Re-run jobs
      <% end %>
    </div>
  <% end %>
<% end %>
