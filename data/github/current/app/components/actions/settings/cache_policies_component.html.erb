<div class="my-6" <%= test_selector("actions-cache-policies-component") %>>
  <h2 class="mb-2" <%= test_selector("cache-policies-title") %>>Cache</h2>
  <p class="mb-2">
    <span <%= test_selector("cache-policies-description") %>><%= description %></span>
  </p>
  <div class="pt-2 pb-2">
    <%= render Actions::Settings::CacheRetentionComponent.new(
      entity: @entity,
      relevant_entities: @relevant_entities
    ) %>
  </div>
  <div class="pt-2">
    <div>
      <%= render Actions::Settings::CacheSizeLimitComponent.new(
        entity: @entity,
        relevant_entities: @relevant_entities
      ) %>
    </div>
  </div>
</div>
