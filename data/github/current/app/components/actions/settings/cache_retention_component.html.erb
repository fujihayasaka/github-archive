<div <%= test_selector("cache-retention-component") %>>
  <span <%= test_selector("cache-retention-title") %>><strong>Cache Retention</strong></span>
  <retention-form <%= test_selector("retention-form") %>>
    <%= form_tag update_cache_retention_size_path, method: :put do %>
      <div class="form-group" data-target="retention-form.group">
        <div class="d-flex">
          <input
            class="form-control"
            type="number"
            id="cache-retention-limit"
            aria-label="Cache retention limit"
            value=<%= value %>
            name="limit"
            style="width: 105px; padding-right: 45px;"
            data-target="retention-form.input"
            data-action="
              input:retention-form#validate
              blur:retention-form#validate"
            data-min=<%= ActionsPolicyHelper::CACHE_RETENTION_DAYS_MINIMUM %>
            data-max=<%= upper_limit %>
            <%= test_selector("cache-retention-input") %>
            >
           <span style="line-height: 32px; margin-left: -46px; padding-right: 10px; vertical-align: middle">days</span>
          <%= render Primer::Beta::Button.new(ml: 2, type: :submit, "data-target": "retention-form.button", "aria-label": "Save default cache retention.", "data-test-selector": "save-button") do %>Save<% end %>
        </div>
        <p class="note error" data-target="retention-form.note" <%= test_selector("validation-messages") %>>
          <span data-target="retention-form.maxMessage" <%= test_selector("max-validation-message") %>>Retention period must be less than or equal to <%= upper_limit %> days.</span>
          <span data-target="retention-form.minMessage" <%= test_selector("min-validation-message") %>>Retention period must be <%= ActionsPolicyHelper::CACHE_RETENTION_DAYS_MINIMUM %> days or more.</span>
        </p>
      </div>
    <% end %>
  </retention-form>
  <p class="color-fg-subtle mt-n2 mb-n1 f6" <%= test_selector("limit-description") %>>
    <span>
      <% if entity_imposing_limit %>
        <% if entity_imposing_limit[:entity].is_a?(Business) %>
          Your enterprise has set a maximum limit of <strong <%= test_selector("upper-limit-retention") %>><%= upper_limit %></strong> days.
        <% else %>
          Your organization has set a maximum limit of <strong <%= test_selector("upper-limit-retention") %>><%= upper_limit %></strong> days.
        <% end %>
      <% else %>
        Retention can be set up to <strong <%= test_selector("upper-limit-retention") %>><%= upper_limit %></strong> days.
      <% end %>
    </span>
  </p>
</div>
