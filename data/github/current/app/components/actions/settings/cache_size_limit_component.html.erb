<div <%= test_selector("cache-size-limit-component") %>>
  <span id="cache_size_limit_header" <%= test_selector("cache-size-limit-title") %>><strong> <%= cache_size_limit_header %> </strong></span>
  <retention-form <%= test_selector("size-limit-form") %>>
    <%= form_tag update_maximum_cache_size_path, method: :put do %>
      <div class="form-group" data-target="retention-form.group">
        <div class="d-flex">
          <input
            class="form-control"
            type="number"
            id="cache-size-limit"
            aria-labelledby="cache_size_limit_header"
            value=<%= value %>
            name="limit"
            style="width: 105px; padding-right: 45px;"
            data-target="retention-form.input"
            data-action="
              input:retention-form#validate
              blur:retention-form#validate"
            data-min="<%= ActionsPolicyHelper::REPO_CACHE_SIZE_MINIMUM_GB %>"
            data-max="<%= upper_limit %>"
            <%= test_selector("cache-size-limit-input") %>>
          <span style="line-height: 32px; margin-left: -36px; padding-right: 10px; vertical-align: middle">GB</span>
          <%= render Primer::Beta::Button.new(ml: 2, type: :submit, "data-target": "retention-form.button", "aria-label": "Save default cache size limit", "data-test-selector": "save-size-limit-button") do %>Save<% end %>
        </div>
        <p class="note error" data-target="retention-form.note" <%= test_selector("size-limit-validation-messages") %>>
          <span data-target="retention-form.maxMessage" <%= test_selector("size-limit-max-validation-message") %>>Cache size must be less than or equal to <%= upper_limit %> GB.</span>
          <span data-target="retention-form.minMessage" <%= test_selector("size-limit-min-validation-message") %>>Cache size must be <%= ActionsPolicyHelper::REPO_CACHE_SIZE_MINIMUM_GB %> GB or more.</span>
        </p>
      </div>
    <% end %>
  </retention-form>
  <p class="color-fg-subtle mt-n2 mb-n1 f6" <%= test_selector("size-limit-description") %>>
  <span><%= cache_size_limit_description %></span>
    <span>
      <% if entity_imposing_limit %>
        <% if entity_imposing_limit[:entity].is_a?(Business) %>
          Your enterprise has set a maximum limit of <strong <%= test_selector("upper-limit-cache-size") %>><%= upper_limit %></strong> GB.
        <% else %>
          Your organization has set a maximum limit of <strong <%= test_selector("upper-limit-cache-size") %>><%= upper_limit %></strong> GB.
        <% end %>
      <% else %>
        Total cache size can be set up to <strong <%= test_selector("upper-limit-cache-size") %>><%= upper_limit %></strong> GB.
      <% end %>
    </span>
    <%= render(Primer::Beta::Link.new(href: "#{GitHub.help_url}/actions/learn-github-actions/usage-limits-billing-and-administration#disabling-or-limiting-github-actions-for-your-repository-or-organization", classes: "Link--inTextBlock")) { " Learn more." } %>
  </p>
</div>
