<%= render Primer::Beta::BorderBox.new(padding: :condensed, mb: 5) do |component| %>
  <% component.with_header do %>
    Actions Invocation
  <% end %>

  <% component.with_body(
    display: :flex,
    align_items: :center,
    direction: :row,
    justify_content: :space_between,
  ) do %>
    <span>Action invocation is <strong><%= blocked_state %></strong>.</span>
    <%= form_tag path, method: form_method do %>
      <%= render Primer::Beta::Button.new(
        type: :submit,
        test_selector:,
      ) do %>
        <%= form_action %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
