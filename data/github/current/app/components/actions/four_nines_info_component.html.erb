<% unless GitHub.enterprise? %>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
    <% component.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Actions Four Nines
      <% end %>
    <% end %>
    <% component.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="pr-2">
          <label for="is_four_nines_enabled">
            Global Id:
          </label>
        </div>
        <div class="d-flex flex-justify-end position-relative">
          <%= global_id %>
        </div>
      </div>
    <% end %>
    <% component.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="pr-2">
          <label for="is_four_nines_enabled">
            Billing Owner ID Dashboard
          </label>
          <div class="note">
            Automatic for dotcom only at the moment, proxima can be done manually by swapping Kusto cluster after click-through.
          </div>
        </div>
        <div class="d-flex flex-justify-end position-relative">
          <a href="https://app.powerbi.com/groups/4c927c1b-b1ba-457e-9f6c-802a4e04eb22/kustodashboards/c10ecaa4-be25-451b-9b03-850335151a02?ctid=398a6654-997b-47e9-b12b-9515b896b4de&experience=power-bi&v-_startTime=6hours&v-_endTime=now&v-_billingOwnerId=v-<%= global_id %>&v-_target=v-dotcom&page=e5af7c1d-e613-4464-854b-8d51d125f327&extensionScenario=openArtifact">BillingOwnerId Dashboard Link</a>
        </div>
      </div>
    <% end %>
    <% component.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="pr-2">
          <label for="is_four_nines_enabled">
            Is Four Nines enabled?
          </label>
          <div class="note">
            If enabled, workflow jobs will run on the new Four Nines architecture.
          </div>
        </div>
        <div class="d-flex flex-justify-end position-relative">
          <%= render enabled_icon %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
