<%= render Primer::Alpha::Dialog.new(
  title: "Create status badge",
  size: :medium_portrait,
  id: dialog_id,
) do |d| %>
  <% d.with_body do %>
    <%= render Primer::Alpha::IncludeFragment.new(loading: "lazy", src: src_path) do %>
      <%= render(Primer::Beta::Spinner.new(mx: :auto, display: :block, classes: "tmp-my-3")) %>
    <% end %>
  <% end %>
<% end %>
