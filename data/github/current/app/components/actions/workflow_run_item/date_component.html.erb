<span class="lh-condensed color-fg-muted my-1 pr-2 d-flex" <%= test_selector("date-component") %>>
  <%
     # This is used to format the year in the <relative-time> component.
     # If the year is the current year, we don't show it; otherwise we render it as 'numeric'.
     user_tz = current_user&.time_zone || Time.zone
     is_current_year = workflow_run.created_at.in_time_zone(user_tz).year == Time.current.in_time_zone(user_tz).year
     is_today = workflow_run.created_at.in_time_zone(user_tz).to_date == Time.current.in_time_zone(user_tz).to_date
  %>
  <div class="mr-1">
    <%= render Primer::Beta::Octicon.new(icon: "calendar") %>
  </div>

  <%# Cases handled:
    1. viewing a run within the same hour
    2. viewing a run within the same day, but not the same hour
    3. viewing a run, but on a different day
  %>
  <relative-time
    datetime="<%= workflow_run.created_at.iso8601 %>"
    threshold="PT1H"
    hour="numeric"
    minute="numeric"
    <% if is_today %>
      day=""
      month=""
      prefix="Today at "
    <% else %>
      day="numeric"
      month="short"
      prefix=""
      time-zone-name="short"
      <% if !is_current_year %>year="numeric"<% end %>
    <% end %>
  ></relative-time>
</span>
