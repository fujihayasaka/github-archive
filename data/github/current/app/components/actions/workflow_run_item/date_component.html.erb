<% exact_date_time = FeatureFlag.vexi.enabled?(:actions_exact_datetime, current_user, default: false) %>

<span class="lh-condensed color-fg-muted my-1 pr-2 <%= exact_date_time ? 'd-flex' : 'd-inline d-md-block' %>" <%= test_selector("date-component") %>>
  <%
     # This is used to format the year in the <relative-time> component.
     # If the year is the current year, we don't show it; otherwise we render it as 'numeric'.
     is_current_year = workflow_run.created_at.year == Time.current.year
  %>
  <% if exact_date_time %>
    <div class="mr-1">
      <%= render Primer::Beta::Octicon.new(icon: "calendar") %>
    </div>
  <% else %>
    <%= render Primer::Beta::Octicon.new(icon: "calendar") %>
  <% end %>

  <%# Renders within the actions_exact_datetime feature flag %>
  <% if exact_date_time %>
    <relative-time
      datetime="<%= workflow_run.created_at.iso8601 %>"
      threshold="PT1H"
      hour="numeric"
      minute="numeric"
      <% if !is_current_year %>year="numeric"<% end %>
      time-zone-name="short"
      prefix=""
    ></relative-time>
  <% else %>
    <%# Default render component if feature flag is disabled %>
    <%= render Primer::Beta::RelativeTime.new(datetime: workflow_run.created_at, tense: :past) %>
  <% end %>
</span>
