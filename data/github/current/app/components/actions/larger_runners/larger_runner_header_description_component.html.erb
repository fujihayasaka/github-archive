            <%= render(Primer::Beta::Label.new(scheme: :success)) { "Preview" } %>
          <% end %>
        </span>
      </div>
      <div>
        <span class="color-fg-muted">
            Image name:
        </span>
        <span>
          <% if runner_image_source_is_custom  %>
            <a href="<%= runner_custom_image_path %>"><%= runner_image_name %></a>
          <% else %>
            <%= runner_image_name %>
          <% end %>
        </span>
      </div>
      <% if show_image_gen_enabled? %>
        <div <%= test_selector "image-gen-enabled-block" %>>
          <span class="color-fg-muted">
              Custom image generation:
          </span>
          <span>
              Enabled
              <% if is_custom_images_public_preview_enabled_for_user_or_owner?(user: current_user, owner: @owner) %>
                <%= render(Primer::Beta::Label.new(scheme: :success)) { "Preview" } %>
              <% end %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
