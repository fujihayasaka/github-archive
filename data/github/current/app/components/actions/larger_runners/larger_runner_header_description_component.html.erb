<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% if should_show_error_banner? %>
    <% if FeatureFlag.vexi.enabled?(:banner_migration, current_user, default: false) %>
      <%= render Primer::Alpha::Banner.new(scheme: :warning, icon: :alert, display: :flex, justify_content: :space_between, align_items: :flex_start, dismiss_scheme: :remove, classes: "tmp-mb-4") do %>
        <% if runner_in_shutdown_billing? %>
          Runners are shut down due to spending limit caps being reached. Please try raising your Actions spending limit to continue using these runners.
          See <a class="Link--inTextBlock" href="<%= billing_details_link %>" target="_blank" rel="noopener noreferrer">billing page</a> for more details.
          If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% elsif runner_in_shutdown_network? %>
          Runners are shut down because the runner's private network was disabled for Actions usage.
          Please <a class="Link--inTextBlock" href="https://github.co/actions-azure-vnet" target="_blank" rel="noopener noreferrer">update the private network</a> or move the runner to a different runner group.
          If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% elsif runner_error_is_agent_cannot_transition_online_custom_image_issue? %>
          Runners failed to come online. This can be caused by a problem with the custom runner image.
          Please review the required network access in <a class="Link--inTextBlock" href="https://docs.github.com/en/actions/reference/runners/self-hosted-runners#accessible-domains-by-function" target="_blank" rel="noopener noreferrer">Accessible domains by function</a>.
          If you're still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% elsif runner_error_is_network_connectivity_issue? || runner_error_is_agent_cannot_transition_online_ambiguous_issue? %>
          <div class="d-flex flex-items-center flex-justify-between flex-auto">
            <div class="flex-auto">
              <% if runner_error_is_network_connectivity_issue? %>
                Runners are unable to connect to all the GitHub endpoints necessary to start processing workflows.
                Please check your private network's firewall or routing configuration against <a class="Link--inTextBlock" href="<%= helpers.docs_url "actions/vnet-prerequisites" %>" target="_blank" rel="noopener noreferrer">the requirements</a>.
                If you're still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
              <% else %>
                Runners failed to come online. This can be caused by either network connectivity issues or a custom runner image configuration.
                Please check your network configuration against <a class="Link--inTextBlock" href="<%= helpers.docs_url "actions/vnet-prerequisites" %>" target="_blank" rel="noopener noreferrer">the requirements</a> and ensure your custom runner image is configured correctly to access the domains listed in <a class="Link--inTextBlock" href="https://docs.github.com/en/actions/reference/runners/self-hosted-runners#accessible-domains-by-function" target="_blank" rel="noopener noreferrer">Accessible domains by function</a>.
                If you're still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
              <% end %>
            </div>
            <% if FeatureFlag.vexi.enabled?(:actions_large_runners_network_diagnostics, @owner, default: false) %>
              <div class="tmp-ml-3">
                <%= render Primer::Alpha::Dialog.new(
                  title: "Network Error Details",
                  id: "network-error-details-dialog",
                  size: :large
                ) do |d| %>
                  <% d.with_show_button(scheme: :secondary, size: :medium, classes: "text-nowrap tmp-px-3") do %>
                    View Details
                  <% end %>
                  <% d.with_body do %>
                    <% error_details = parsed_error_details %>
                    <% if error_details.present? %>
                      <% domains = error_details.dig("NetworkCheck", "FailedDomains") %>
                      <% if domains.present? %>
                        <% domains.each do |domain| %>
                          <%= render Primer::Beta::Details.new(classes: "tmp-mb-3") do |details| %>
                            <% details.with_summary(classes: "btn-block text-left") do %>
                              <div class="d-flex flex-justify-between flex-items-center">
                                <strong><%= domain["Domain"] %></strong>
                                <span class="color-fg-danger text-small">
                                  <%= domain["FailCount"] %>/<%= domain["TotalCount"] %> failed
                                </span>
                              </div>
                            <% end %>
                            <% details.with_body(classes: "border-top mt-2 tmp-pt-3") do %>
                              <div class="tmp-p-3">
                                <div class="tmp-mb-3">
                                  <div class="d-flex flex-justify-between mb-2">
                                    <strong>Total Attempts:</strong>
                                    <span><%= domain["TotalCount"] %></span>
                                  </div>
                                  <div class="d-flex flex-justify-between mb-2">
                                    <strong>Failed Attempts:</strong>
                                    <span class="<%= domain["FailCount"] > 0 ? 'color-fg-danger' : 'color-fg-success' %>">
                                      <%= domain["FailCount"] %>
                                    </span>
                                  </div>
                                  <div class="d-flex flex-justify-between mb-2">
                                    <strong>Failure %:</strong>
                                    <span class="<%= domain["FailCount"] > 0 ? 'color-fg-danger' : 'color-fg-success' %>">
                                      <%= domain["TotalCount"] > 0 ? ((domain["FailCount"].to_f / domain["TotalCount"]) * 100).round(1) : 0 %>%
                                    </span>
                                  </div>
                                  <div class="d-flex flex-justify-between tmp-mb-3">
                                    <strong>Error Type:</strong>
                                    <code class="color-fg-danger"><%= domain["CurlError"] || "N/A" %></code>
                                  </div>
                                </div>
                                <div class="border-top tmp-pt-3">
                                  <h5 class="mb-2">Network Configuration</h5>
                                  <div class="d-flex flex-justify-between mb-1 text-small">
                                    <strong>HTTP Proxy:</strong>
                                    <span><%= error_details.dig("NetworkCheck", "HttpProxyConfigured") ? "Configured" : "Not configured" %></span>
                                  </div>
                                  <div class="d-flex flex-justify-between mb-1 text-small">
                                    <strong>HTTPS Proxy:</strong>
                                    <span><%= error_details.dig("NetworkCheck", "HttpsProxyConfigured") ? "Configured" : "Not configured" %></span>
                                  </div>
                                  <div class="d-flex flex-justify-between text-small">
                                    <strong>Check Time:</strong>
                                    <span>
                                      <% begin %>
                                        <%= Time.parse(error_details["Timestamp"]).strftime("%Y-%m-%d %H:%M:%S UTC") %>
                                      <% rescue ArgumentError %>
                                        <%= error_details["Timestamp"] %>
                                      <% end %>
                                    </span>
                                  </div>
                                </div>
                              </div>
                            <% end %>
                          <% end %>
                        <% end %>
                      <% else %>
                        <p>No domain failure data available in error details.</p>
                      <% end %>
                    <% else %>
                      <p>No network error details available.</p>
                    <% end %>
                  <% end %>
                  <% d.with_footer do %>
                    <%= render Primer::Beta::Button.new(
                      data: { "close-dialog-id": "network-error-details-dialog" }
                    ) do %>
                      Close
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% elsif runner_error_is_vnet_deployment_blocked_by_policy? %>
          Runners cannot be started due to an Azure policy blocking deployment of network interface controllers in your private network.
          Please check your Azure subscription or resource group to update required policies and try again.
          If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% elsif runner_error_is_vnet_deployment_scope_locked? %>
          Runners cannot be deployed and/or removed due to the presence of a <a class="Link--inTextBlock" href="https://learn.microsoft.com/en-us/azure/azure-resource-manager/management/lock-resources" target="_blank" rel="noopener noreferrer">resource lock</a> in your private network's Azure subscription or resource group.
          Please check your Azure subscription or resource group to update required policies and try again.
          If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% elsif runner_error_is_subscription_not_found? %>
          Runners cannot be deployed because your private network's Azure subscription could not be found.
          Please check your private network settings and confirm the Azure subscription in use is valid or update the subscription and try again.
        <% elsif runner_error_is_vnet_subnet_full? %>
          Runners cannot be deployed in your private network's because there are no more IP addresses available in its subnet.
          Please ensure your private network's capacity is less than this runner's maximum concurrency and that there are no other unexpected resources using the network.
          If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% elsif runner_error_is_vnet_capacity_incompatible? %>
          Runners cannot be deployed based on the chosen platform and the private network region.
          Supported regions for each runner type can be found in "<a class="Link--inTextBlock" href="https://github.co/actions-azure-vnet" target="_blank" rel="noopener noreferrer">About network communication</a>". Please ensure your private network’s region is supported for the runner type.
          If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% elsif runner_error_is_image_larger_than_disk? %>
          Runners cannot be created because the image specified is larger than OS disk of the chosen runner size.
          Please check the image size against the <a class="Link--inTextBlock" href="<%= helpers.docs_url "actions/larger-runners-machine-specs"  %>" target="_blank" rel="noopener noreferrer">disk size documented</a> for the runner's size.
          If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% elsif ubuntu_20_deprecation? %>
          The ubuntu-20.04 runner image will be end of life on 2025-04-01. Jobs using the ubuntu-20.04 image should be updated to ubuntu-22.04 or ubuntu-24.04. For more details, see the <a class="Link--inTextBlock" href="https://github.com/actions/runner-images/issues/11101" target="_blank" rel="noopener noreferrer">announcement</a>.
        <% elsif runner_error_is_custom_image_version_not_found? %>
          Runners cannot be created because the custom image version specified was not found.
          Please check that the image version exists and is available on the <a class="Link--inTextBlock" href="<%= runner_custom_image_path %>" target="_blank" rel="noopener noreferrer">custom images page</a>.
          If you're still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% elsif runner_error_is_custom_image_definition_not_found? %>
          Runners cannot be created because the custom image definition specified was not found.
          Please check that the image definition exists and is available on the <a class="Link--inTextBlock" href="<%= runner_custom_image_definition_path %>" target="_blank" rel="noopener noreferrer">custom images page</a>.
          If you're still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
        <% end %>
      <% end %>
    <% else %>
      <%= render Primer::Beta::Flash.new(scheme: :warning, icon: :alert, display: :flex, justify_content: :space_between, align_items: :flex_start, classes: "tmp-mb-4") do %>
        <div class="col-11 tmp-pr-5">
          <% if runner_in_shutdown_billing? %>
            Runners are shut down due to spending limit caps being reached. Please try raising your Actions spending limit to continue using these runners.
            See <a class="Link--inTextBlock" href="<%= billing_details_link %>" target="_blank" rel="noopener noreferrer">billing page</a> for more details.
            If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
          <% elsif runner_in_shutdown_network? %>
            Runners are shut down because the runner's private network was disabled for Actions usage.
            Please <a class="Link--inTextBlock" href="https://github.co/actions-azure-vnet" target="_blank" rel="noopener noreferrer">update the private network</a> or move the runner to a different runner group.
            If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
          <% elsif runner_error_is_agent_cannot_transition_online_custom_image_issue? %>
            Runners failed to come online. This can be caused by a problem with the custom runner image.
            Please review the required network access in <a class="Link--inTextBlock" href="https://docs.github.com/en/actions/reference/runners/self-hosted-runners#accessible-domains-by-function" target="_blank" rel="noopener noreferrer">Accessible domains by function</a>.
            If you're still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
          <% elsif runner_error_is_network_connectivity_issue? || runner_error_is_agent_cannot_transition_online_ambiguous_issue? %>
            <div class="d-flex flex-items-center flex-justify-between flex-auto">
              <div class="flex-auto">
                <% if runner_error_is_network_connectivity_issue? %>
                  Runners are unable to connect to all the GitHub endpoints necessary to start processing workflows.
                  Please check your private network's firewall or routing configuration against <a class="Link--inTextBlock" href="<%= helpers.docs_url "actions/vnet-prerequisites" %>" target="_blank" rel="noopener noreferrer">the requirements</a>.
                  If you're still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
                <% else %>
                  Runners failed to come online. This can be caused by either network connectivity issues or a custom runner image configuration.
                  Please check your network configuration against <a class="Link--inTextBlock" href="<%= helpers.docs_url "actions/vnet-prerequisites" %>" target="_blank" rel="noopener noreferrer">the requirements</a> and ensure your custom runner image is configured correctly to access the domains listed in <a class="Link--inTextBlock" href="https://docs.github.com/en/actions/reference/runners/self-hosted-runners#accessible-domains-by-function" target="_blank" rel="noopener noreferrer">Accessible domains by function</a>.
                  If you're still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
                <% end %>
              </div>
              <% if FeatureFlag.vexi.enabled?(:actions_large_runners_network_diagnostics, @owner, default: false) %>
                <div class="tmp-ml-3">
                  <%= render Primer::Alpha::Dialog.new(
                    title: "Network Error Details",
                    id: "network-error-details-dialog",
                    size: :large
                  ) do |d| %>
                    <% d.with_show_button(scheme: :secondary, size: :medium, classes: "text-nowrap tmp-px-3") do %>
                      View Details
                    <% end %>
                    <% d.with_body do %>
                      <% error_details = parsed_error_details %>
                      <% if error_details.present? %>
                        <% domains = error_details.dig("NetworkCheck", "FailedDomains") %>
                        <% if domains.present? %>
                          <% domains.each do |domain| %>
                            <%= render Primer::Beta::Details.new(classes: "tmp-mb-3") do |details| %>
                              <% details.with_summary(classes: "btn-block text-left") do %>
                                <div class="d-flex flex-justify-between flex-items-center">
                                  <strong><%= domain["Domain"] %></strong>
                                  <span class="color-fg-danger text-small">
                                    <%= domain["FailCount"] %>/<%= domain["TotalCount"] %> failed
                                  </span>
                                </div>
                              <% end %>
                              <% details.with_body(classes: "border-top mt-2 tmp-pt-3") do %>
                                <div class="tmp-p-3">
                                  <div class="tmp-mb-3">
                                    <div class="d-flex flex-justify-between mb-2">
                                      <strong>Total Attempts:</strong>
                                      <span><%= domain["TotalCount"] %></span>
                                    </div>
                                    <div class="d-flex flex-justify-between mb-2">
                                      <strong>Failed Attempts:</strong>
                                      <span class="<%= domain["FailCount"] > 0 ? 'color-fg-danger' : 'color-fg-success' %>">
                                        <%= domain["FailCount"] %>
                                      </span>
                                    </div>
                                    <div class="d-flex flex-justify-between mb-2">
                                      <strong>Failure %:</strong>
                                      <span class="<%= domain["FailCount"] > 0 ? 'color-fg-danger' : 'color-fg-success' %>">
                                        <%= domain["TotalCount"] > 0 ? ((domain["FailCount"].to_f / domain["TotalCount"]) * 100).round(1) : 0 %>%
                                      </span>
                                    </div>
                                    <div class="d-flex flex-justify-between tmp-mb-3">
                                      <strong>Error Type:</strong>
                                      <code class="color-fg-danger"><%= domain["CurlError"] || "N/A" %></code>
                                    </div>
                                  </div>
                                  <div class="border-top tmp-pt-3">
                                    <h5 class="mb-2">Network Configuration</h5>
                                    <div class="d-flex flex-justify-between mb-1 text-small">
                                      <strong>HTTP Proxy:</strong>
                                      <span><%= error_details.dig("NetworkCheck", "HttpProxyConfigured") ? "Configured" : "Not configured" %></span>
                                    </div>
                                    <div class="d-flex flex-justify-between mb-1 text-small">
                                      <strong>HTTPS Proxy:</strong>
                                      <span><%= error_details.dig("NetworkCheck", "HttpsProxyConfigured") ? "Configured" : "Not configured" %></span>
                                    </div>
                                    <div class="d-flex flex-justify-between text-small">
                                      <strong>Check Time:</strong>
                                      <span>
                                        <% begin %>
                                          <%= Time.parse(error_details["Timestamp"]).strftime("%Y-%m-%d %H:%M:%S UTC") %>
                                        <% rescue ArgumentError %>
                                          <%= error_details["Timestamp"] %>
                                        <% end %>
                                      </span>
                                    </div>
                                  </div>
                                </div>
                              <% end %>
                            <% end %>
                          <% end %>
                        <% else %>
                          <p>No domain failure data available in error details.</p>
                        <% end %>
                      <% else %>
                        <p>No network error details available.</p>
                      <% end %>
                    <% end %>
                    <% d.with_footer do %>
                      <%= render Primer::Beta::Button.new(
                        data: { "close-dialog-id": "network-error-details-dialog" }
                      ) do %>
                        Close
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% elsif runner_error_is_vnet_deployment_blocked_by_policy? %>
            Runners cannot be started due to an Azure policy blocking deployment of network interface controllers in your private network.
            Please check your Azure subscription or resource group to update required policies and try again.
            If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
          <% elsif runner_error_is_vnet_deployment_scope_locked? %>
            Runners cannot be deployed and/or removed due to the presence of a <a class="Link--inTextBlock" href="https://learn.microsoft.com/en-us/azure/azure-resource-manager/management/lock-resources" target="_blank" rel="noopener noreferrer">resource lock</a> in your private network's Azure subscription or resource group.
            Please check your Azure subscription or resource group to update required policies and try again.
            If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
          <% elsif runner_error_is_subscription_not_found? %>
            Runners cannot be deployed because your private network's Azure subscription could not be found.
            Please check your private network settings and confirm the Azure subscription in use is valid or update the subscription and try again.
          <% elsif runner_error_is_vnet_subnet_full? %>
            Runners cannot be deployed in your private network's because there are no more IP addresses available in its subnet.
            Please ensure your private network's capacity is less than this runner's maximum concurrency and that there are no other unexpected resources using the network.
            If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
          <% elsif runner_error_is_vnet_capacity_incompatible? %>
            Runners cannot be deployed based on the chosen platform and the private network region.
            Supported regions for each runner type can be found in "<a class="Link--inTextBlock" href="https://github.co/actions-azure-vnet" target="_blank" rel="noopener noreferrer">About network communication</a>". Please ensure your private network’s region is supported for the runner type.
            If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
          <% elsif runner_error_is_image_larger_than_disk? %>
            Runners cannot be created because the image specified is larger than OS disk of the chosen runner size.
            Please check the image size against the <a class="Link--inTextBlock" href="<%= helpers.docs_url "actions/larger-runners-machine-specs"  %>" target="_blank" rel="noopener noreferrer">disk size documented</a> for the runner's size.
            If you’re still experiencing problems, please reach out to <a class="Link--inTextBlock" href="<%= GitHub.contact_support_url %>" target="_blank" rel="noopener noreferrer">our support</a>.
          <% elsif ubuntu_20_deprecation? %>
