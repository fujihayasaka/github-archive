<div id="access-token-<%= id %>" class="Box-row js-revoke-item <%= newly_created? ? "new-token" : "" %>" data-id="<%= id %>" data-type="token">

    <div class="d-flex width-full">
      <%= render GitHub::AvatarComponent.new(actor: actor, size: 20, mr: 2, title: resource_owner_message) %>
      <div class="d-flex flex-column ml-1 width-full">
        <div class="d-flex flex-wrap">
          <h3 class="mr-1 my-0 h5 no-wrap"><a href="<%= settings_user_access_token_path(access) %>" data-pjax><%= name %></a></h3>
          <%= render(Primer::Beta::Label.new(scheme: :attention, title: "Associated request is pending approval")) { "Pending" } if has_requested_grant? %>
          <%= render(Primer::Beta::Label.new(scheme: :attention, title: "All requests using this PAT will be blocked until your organization opts in or fine-grained PATs return to general availability.")) { "Temporarily Disabled" } if current_user&.feature_enabled?(:require_onboarding_for_pat_activation) && restrict_not_onboarded_org_pat? %>
        </div>
        <div class="d-flex flex-wrap">
            <span class="text-small color-fg-muted mr-1">
              <%= last_access_description(access) %> •
            </span>
            <span class="text-small color-fg-muted">
              <include-fragment src="<%= settings_user_access_token_expiration_path(access, page: page) %>">
                <span class="color-fg-muted" data-hide-on-error>Loading expiration ...</span>
                <span class="color-fg-danger" data-show-on-error hidden>Sorry, something went wrong.</span>
              </include-fragment>
            </span>
        </div>
      </div>
      <%= render partial: "personal_access_tokens/delete_token_dialog", locals: { token: access } %>

  </div>

  <% if newly_created? %>
    <div class="width-full mt-3">
      <% if successfully_created? %>
        <%= render(Primer::Alpha::Banner.new(scheme: :success, icon: :bell)) do %>
          Make sure to copy your personal access token now as you will not be able to see this again.
          <div class="input-group mt-2">
            <input class="form-control color-bg-inset text-mono text-small" id="new-access-token" type="text" placeholder="Access token" aria-label="Access token" disabled value="<%= unhashed_token %>">
            <span class="input-group-button">
              <%= render Primer::Beta::ClipboardCopy.new(for: "new-access-token", "aria-label": "Copy token", tabindex: "0", role: "button", classes: "btn", "data-copy-feedback": "Copied!", test_selector: "token-copy-link") %>
            </span>
          </div>
        <% end %>
      <% else %>
        <%= render(Primer::Alpha::Banner.new(scheme: :warning)) { "We failed to generate the API credential, please try again." } %>
      <% end %>
    </div>
  <% end %>
</div>
