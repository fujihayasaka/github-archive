<% if !expiration_time_set? %>
    <%= render(Primer::Beta::Octicon.new(icon: "alert", color: :attention)) %>
    <%= render(Primer::Beta::Link.new(**link_component_attributes)) do |c| %>
      <% c.with_tooltip(text: "To set a new expiration date, you must regenerate the token.", direction: :e) if render_tooltip? %>
      This token has no expiration date
    <% end %>
<% elsif expired? %>
    <%= render(Primer::Beta::Octicon.new(icon: "alert", color: :attention)) %>
    <%= render(Primer::Beta::Link.new(**link_component_attributes)) do |c| %>
      <% c.with_tooltip(text: "To set a new expiration date, you must regenerate the token.", direction: :n) if render_tooltip? %>
      This token has expired
    <% end %>
<% elsif expiring_soon? %>
    <%= render(Primer::Beta::Octicon.new(icon: "alert", color: :attention)) %>
    <%= render(Primer::Beta::Link.new(**link_component_attributes)) do |c| %>
      <% c.with_tooltip(text: "To set a new expiration date, you must regenerate the token.", direction: :s) if render_tooltip? %>
      Expires <%= human_expiration_date(expiration_time) %>
    <% end %>
<% else %>
  Expires <%= human_expiration_date(expiration_time) %>
<% end %>
