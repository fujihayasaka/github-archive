<%
nudge_id = 'secret_scanning_first_scan_nudge'
nudge_category = 'secret_scanning_first_scan_nudge_1'
nudge_group = :engage
%>
<%= render(Primer::Box.new(
  classes: "security-secret-leaks-promo-banner scan-secret-leaks dismissable js-notice mb-4",
  data: {
    test_selector: "scan-secret-leaks-banner",
    **helpers.analytics_visible_attributes(
      context: 'secret-scanning-promobanner',
      category: nudge_category,
      location: 'org_overview',
      tag: 'promobanner',
    ),
  }
)) do %>
  <span class="d-none" <%= test_selector(nudge_category) %>></span>
  <% current_user.track_nudge_impression(id: nudge_id, group: nudge_group) %>

  <div class="security-secret-leaks-promo-banner-content">
    <%= render(Primer::Beta::Label.new(mb: 3)) { "New" } %>

    <h2 class="h2 my-1">Scan for secret leaks with GitHub</h2>

    <p class="color-fg-muted mb-0" style="max-width: 400px;">
      Run a free secret risk assessment to determine if you have any exposed secrets in your organization's repositories.
    </p>

    <div class="security-secret-leaks-promo-banner-actions">
      <%= render(Primer::Beta::Button.new(
        scheme: :primary,
        tag: :a,
        href: scan_now_path,
        mb: 0,
        data: helpers.analytics_click_attributes(
          category: nudge_category,
          action: "click",
          location: "scan_secret_leaks_banner",
          tag: "button",
        )
      )) { "Scan now" } %>

      <%# Temporarily hide until implemented %>
      <%= form_tag(
        remind_me_later_path,
        class: "js-notice-dismiss d-none"
      ) do %>
        <%= render(Primer::Beta::Button.new(
          type: :submit,
          data: helpers.analytics_click_attributes(
            category: nudge_category,
            action: "remind_later",
            location: "scan_secret_leaks_banner",
            tag: "button",
          ),
          scheme: :invisible,
        )) do %>
          <%= render Primer::Beta::Octicon.new(:bell, classes: "security-secret-leaks-promo-banner-remind-icon") %>
          <span class="security-secret-leaks-promo-banner-remind-label">Remind me later</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="security-secret-leaks-promo-banner-image-container">
    <div class="security-secret-leaks-promo-banner-image" alt="Secret scanning dashboard preview"></div>
  </div>

  <%= form_tag(
    dismiss_path,
    class: "security-secret-leaks-promo-banner-dismiss js-notice-dismiss"
  ) do %>
    <%= render Primer::Beta::CloseButton.new(
      type: :submit,
      data: helpers.analytics_click_attributes(
        category: nudge_category,
        action: "dismiss",
        location: "scan_secret_leaks_banner",
        tag: "button",
      )
    ) %>
  <% end %>
<% end %>
