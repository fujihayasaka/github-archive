<%= render Primer::Beta::Details.new(open: open_assets, test_selector: "assets-container") do |c| %>
  <% c.with_summary(button: false) do %>
    <span class="d-inline-flex flex-items-center">
      <%= render Primer::Beta::Text.new(font_size: 3, font_weight: :bold, ml: 2, mr: 2) do "Assets".pluralize(total_asset_count) end %>
      <%= render Primer::Beta::Counter.new(count: total_asset_count) %>
    </span>
  <% end %>
  <% c.with_body do %>
    <% if truncate_assets %>
      <%= render Primer::Alpha::IncludeFragment.new(classes: "js-truncated-assets-fragment", "data-deferred-src": expand_assets_url) do %>
        <%= render Releases::AssetListComponent.new(@release, @current_repository, truncate: true) %>
      <% end %>
    <% else %>
      <%# This will lazy render an Releases::AssetListComponent when expanded %>
      <%= render Primer::Alpha::IncludeFragment.new(
        src: expand_assets_url,
        test_selector: "lazy-asset-list-fragment",
        loading: "lazy",
      ) do %>
        <%= render(Primer::Beta::Spinner.new) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
