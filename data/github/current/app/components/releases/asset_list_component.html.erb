<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%= render(Primer::Beta::BorderBox.new(padding: :condensed, mt: 3)) do |box| %>
  <% assets_to_display.each do |asset| %>
    <% box.with_row(display: :flex, direction: [:column, nil, :row], test_selector: 'asset-row') do %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :flex_start, col: [12, nil, nil, 6], test_selector: asset.test_selector)) do %>
        <%= primer_octicon asset.icon, color: :muted %>
        <%= render(Primer::Beta::Truncate.new(tag: :a, href: asset.href, rel: :nofollow, "data-turbo": :false)) do |component| %>
          <% component.with_item(tag: :span, font_weight: :bold) { asset.title } %>
          <% component.with_item { asset.extension } %>
        <% end %>
      <% end %>
      <%= render(Primer::Box.new(
        display: :flex,
        flex: :auto,
        justify_content: :flex_end,
        align_items: :center,
        col: [nil, nil, 4],
        ml: [3, nil, 0],
        mt: [1, nil, 0],
        pl: [1, nil, 0]
      )) do %>
        <% if asset.digest.present? %>
          <%= render(Primer::Beta::Text.new(
            tag: :span,
            color: :muted,
            style: "white-space: nowrap; max-width: 250px; min-width: 150px",
            classes: "css-truncate css-truncate-target text-mono text-small",
            text_align: [nil, :left],
            flex: :auto,
            ml: [nil, nil, 3],
            mr: 1,
            flex_grow: 0,
            test_selector: "asset-digest-label"
          )) do %>
            <%= asset.digest %>
          <% end %>
          <%= render Primer::Beta::ClipboardCopy.new(value: asset.digest, "aria-label": "copy to clipboard digest for #{asset.title}", classes: "CopyBlock", "data-copy-feedback": "Copied!", "data-tooltip-direction": "ne", role: "button", flex: :auto) do %>
            <%= render Primer::Beta::Octicon.new(icon: "copy", size: :small, style: "display: inline;") %>
          <% end %>
        <% end %>
        <% if asset.size.present? %>
          <%= render(Primer::Beta::Text.new(
            tag: :span,
            color: :muted,
            style: "white-space: nowrap; min-width: 75px",
            text_align: :right,
            flex_shrink: 0,
            flex_grow: 0,
            ml: 4,
            test_selector: "asset-size-label"
          )) { number_to_human_size(asset.size) } %>
        <% end %>
        <% if asset.creation_timestamp.present? %>
          <%= render(Primer::Beta::Text.new(
            tag: :span,
            color: :muted,
            style: "white-space: nowrap; min-width: 100px",
            text_align: :right,
            flex_shrink: 0,
            flex_grow: 0,
            ml: 4,
            test_selector: "asset-date-label"
          )) { content_tag("relative-time", asset.creation_timestamp, datetime: asset.creation_timestamp, class: "no-wrap", prefix: "") } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% if truncate %>
    <% box.with_row(display: :flex, direction: [:column, nil, :row]) do %>
      <%= render(Primer::Box.new) do %>
        <%= render(Primer::ButtonComponent.new(scheme: :link, classes: "js-release-asset-untruncate-btn")) { "Show all #{total_asset_count} assets" } %>
        <%= render(Primer::Beta::Spinner.new(hidden: true, size: :small, classes: "js-truncate-assets-spinner")) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
