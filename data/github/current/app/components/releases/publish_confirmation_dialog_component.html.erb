<%= render(Primer::Alpha::Dialog.new(
  id: dialog_id,
  title: "Confirm to publish",
  header_variant: :small,
  size: :small,
  test_selector: "publish-confirmation-dialog",
)) do |c| %>
  <% c.with_show_button(scheme: :primary) { "Publish release" } %>
  <% c.with_header(show_divider: true) %>
  <% c.with_body do %>
    <p>
      As an immutable release, you will only be able to edit the release title and notes after publishing.
      You can save a draft of this release if you're not ready to publish.
    </p>
  <% end %>
  <% c.with_footer(show_divider: true) do %>
    <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": dialog_id }).with_content("Cancel")) %>
    <%= render(Primer::Beta::Button.new(
      scheme: :primary,
      type: :submit,
      "data-disable-with": "Publishing…",
      "publish-release": "true"
    )) do %>
      Publish release
    <% end %>
  <% end %>
<% end %>
