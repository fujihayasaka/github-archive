<div <%= test_selector(@test_selector) if @test_selector %>>
  <%= render Primer::Alpha::Dialog.new(title: @title, id: dialog_id) do |dialog| %>
    <% dialog.with_show_button(scheme: @scheme, ml: 2, disabled: @disabled, test_selector: "dialog-open-button",
        aria: { label: @button_aria_label }.merge(@disabled ? { disabled: @disabled } : {})) do %>
      <%= @summary_button_text %>
    <% end %>
    <% dialog.with_header(show_divider: true) %>
    <% dialog.with_body(p: 0) do %>
      <% if @warning_text %>
        <%= render Primer::Alpha::Banner.new(scheme: :warning, full: true, icon: :alert) do %>
          <%=  @warning_text %>
        <% end %>
      <% end %>
      <%= render Primer::Box.new(p: 3) do %>
        <%= render Primer::Beta::Text.new(tag: :p) do %>
            <%= @dialog_text %>
          <% end %>
        <% if include_checkbox? %>
            <%= render partial: "settings/organization/security_analysis_enable_checkbox", locals: {
              name: @checkbox_name,
              id: @checkbox_id,
              checked_condition: @checkbox_condition,
              label_text: @checkbox_label,
              description_text: @checkbox_description
            } %>
          <% end %>
      <% end %>
    <% end %>
    <% dialog.with_footer(show_divider: true) do %>
      <%= render Primer::Alpha::TextField.new( name: @input_name, hidden: true, label: @input_name, value: @input_value) %>
      <%= render Primer::Beta::Button.new(
        scheme: @scheme,
        block: true,
        type: :submit,
        test_selector: "dialog-form-submit-button",
        **button_data_attr) do %>
        <%= @confirm_button_text %>
      <% end %>
    <% end %>
  <% end%>
</div>
