 <div <%= test_selector(@test_selector) if @test_selector %>>
  <% if use_primer_dialog? %>
    <%= render Primer::Alpha::Dialog.new(title: @title, id: dialog_id) do |dialog| %>
      <% dialog.with_show_button(scheme: scheme, ml: 2, disabled: @disabled, test_selector: "dialog-open-button",
          aria: { label: @button_aria_label, disabled: @disabled }) do %>
        <%= @summary_button_text %>
      <% end %>
      <% dialog.with_header(show_divider: true) %>
      <% dialog.with_body(p: 0) do %>
        <% if @warning_text %>
          <%= render Primer::Alpha::Banner.new(scheme: :warning, full: true, icon: :alert) do %>
            <%=  @warning_text %>
          <% end %>
        <% end %>
        <%= render Primer::Box.new(p: 3) do %>
          <%= render Primer::Beta::Text.new(tag: :p) do %>
              <%= @dialog_text %>
            <% end %>
          <% if include_checkbox? %>
              <%= render partial: "settings/organization/security_analysis_enable_checkbox", locals: {
                name: @checkbox_name,
                id: @checkbox_id,
                checked_condition: @checkbox_condition,
                label_text: @checkbox_label,
                description_text: @checkbox_description
              } %>
            <% end %>
        <% end %>
      <% end %>
      <% dialog.with_footer(show_divider: true) do %>
        <%= render Primer::Alpha::TextField.new( name: @input_name, hidden: true, label: @input_name, value: @input_value) %>
        <%= render Primer::Beta::Button.new(
          scheme: scheme,
          block: true,
          type: :submit,
          test_selector: "dialog-form-submit-button",
          **button_data_attr) do %>
          <%= @confirm_button_text %>
        <% end %>
      <% end %>
    <% end%>
  <% else %>
    <% if @disabled %>
      <button type="button" class="<%= @button_class %>" aria-disabled="true" aria-label="<%= @button_aria_label %>" title="<%= @title %>"><%# erblint:disable GitHub::Accessibility::NoTitleAttribute %>
        <%= @summary_button_text %>
      </button>
    <% else %>
      <%= render GitHub::DialogComponent.new(title: @title) do |c| %><%# erblint:disable A11yDetailsDialogMigration %>
        <% if @warning_text %>
          <% c.with_alert do %>
            <%= @warning_text %>
          <% end %>
        <% end %>

        <% c.with_summary do %>
          <summary class="<%= @button_class %>" aria-label="<%= @button_aria_label %>" <%= test_selector("dialog-open-button")%>>
            <%= @summary_button_text %>
          </summary>
        <% end %>

        <% c.with_body do %>
          <p class="ws-normal" tabindex="0"><%= @dialog_text %></p>
          <% if include_checkbox? %>
            <%= render partial: "settings/organization/security_analysis_enable_checkbox", locals: {
              name: @checkbox_name,
              id: @checkbox_id,
              checked_condition: @checkbox_condition,
              label_text: @checkbox_label,
              description_text: @checkbox_description
            } %>
          <% end %>
        <% end %>

        <% c.with_footer do %>
          <input type="hidden" name="<%= @input_name %>" value="<%= @input_value %>">
          <button
            type="submit"
            <% if @data_octo_click %>data-octo-click="<%= @data_octo_click %>"<% end %>
            <% if @data_octo_dimensions %>data-octo-dimensions="enabled:<%= @data_octo_dimensions %>,location:settings"<% end %>
            class="btn-block <%= @button_class %>"
            data-close-dialog
            <%= test_selector("dialog-form-submit-button")%>
            >
            <%= @confirm_button_text %>
          </button>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
