<%= render Primer::Box.new(**system_arguments) do %>
  <% if title %>
    <%= render Primer::Box.new(pb: 3, mb: 3, border: :bottom) do %>
      <%= title %>
      <%= subtitle %>
    <% end %>
  <% end %>
  <% line_items.each do |line_item| %>
    <%= line_item %>
  <% end %>
  <%= sales_tax %>
  <% totals.each do |total| %>
    <%= total %>
  <% end %>
<% end %>
