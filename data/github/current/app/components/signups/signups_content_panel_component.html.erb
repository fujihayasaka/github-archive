<div class="width-md-1/2 signups-rebrand__container-marketing" <%= test_selector("signups-content-panel-component") %>>
  <% if custom_content_enabled? %>
    <div <%= test_selector("custom-signup-content") %>>
      <%= render_react_partial(
        name: "custom-signup-content",
        props: {
          contentfulContent: contentful_custom_content_entry
        }
      ) %>
    </div>
  <% else %>
    <div class="signups-rebrand__container-content" <%= test_selector("default-signup-content") %>>
      <%= render(Primer::Beta::Heading.new(
        tag: :h1,
        color: :on_emphasis,
        classes: "signups-rebrand__container-h1",
        width: :medium
      )) { "Create your free account" } %>
      <%= render(Primer::Beta::Text.new(
        color: :on_emphasis,
        mt: 2
      )) { "Explore GitHub's core features for individuals and organizations." } %>

        <details class="signups-rebrand__details color-fg-on-emphasis py-3">
        <summary class="signups-rebrand__details-summary text-semibold">
          See what's included
          <span class="signups-rebrand__details-icon">
            <%= render(Primer::Beta::Octicon.new(:"chevron-down")) %>
          </span>
        </summary>
        <div class="signups-rebrand__details-content">
          <%= render Signups::BenefitsComponent.new %>
        </div>
      </details>
    </div>
  <% end %>
  <picture>
    <source srcset="<%= image_path "signup/tres-amigos@2x.webp" %>" media="(min-width: 1280px)">
    <img
      src="<%= image_path "signup/dos-amigos@2x.webp" %>"
      alt="GitHub Mascots: Mona, Copilot, and a rubber duck floating on top of an astral background of stars."
      class="signups-rebrand__container-mascots"
    >
  </picture>
</div>

