<%= render(Primer::BaseComponent.new(
  tag: "signups-marketing-consent-fields",
  test_selector: "marketing-consent-component",
  classes: "js-octocaptcha-hide",
  data: { actor_country_code: actor_country_code },
)) do %>
  <div id="country-dropdown-container">
    <div>
      <label for="country-dropdown" class="text-semibold" id="country-dropdown-label">
        Your Country/Region<sup aria-hidden="true">*</sup><span class="sr-only">, required</span>
      </label>
    </div>
    <div class="mt-1 mb-3 select-panel-wrapper signup-form-fields__validate">
      <%= render(Primer::Alpha::SelectPanel.new(
        use_experimental_non_local_form: user_feature_enabled?(:primer_select_panel_use_experimental_non_local_form),
        form_arguments: { builder: user_signup_form_builder, name: "country" },
        data: {
          interaction_subject: "select-panel",
          target: "signups-marketing-consent-fields.panel",
        },
        dynamic_label: true,
        fetch_strategy: :local,
        title: "Select Country/Region",
        "aria-describedby": "country-helper",
        classes: "signup-form-fields__select",
        test_selector: "country-dropdown-selector",
      )) do |panel| %>
        <% panel.with_show_button(
          align_content: :start,
          bg: :default,
          block: true,
          classes: "country-select-button",
          font_weight: :normal,
          size: :large,
          "aria-labelledby": "country-dropdown-label",
        ) do |button| %>
          <% button.with_trailing_action_icon(icon: :'chevron-down') %> Select Country/Region
        <% end %>
        <% countries.each do |name, alpha| %>
          <% panel.with_item(
            label: name,
            content_arguments: { "data-value": alpha },
            item_id: alpha,
          ) %>
        <% end %>
      <% end %>
      <%# Div to keep the markup structure for country the same as other inputs %>
      <%# This is important when adding/removing validation messages %>
      <div></div>
      <div id="country-helper" class="text-small mt-1 signup-form-fields__helper-text">
        For compliance reasons, we&#39;re required to collect country information to send you occasional updates and announcements.
      </div>
    </div>
  </div>
  <div data-target="signups-marketing-consent-fields.marketingOptInContainer" <%= test_selector("marketing-opt-in") %>>
    <fieldset>
      <legend class="text-semibold"> Email preferences </legend>
      <div class="mt-1 mb-3">
        <%= render(Primer::Alpha::CheckBox.new(
          name: "user_signup[marketing_consent]",
          label: "Receive occasional product updates and announcements",
          label_arguments: { class: "text-normal" },
          data: { target: "signups-marketing-consent-fields.marketingConsentCheckbox" },
        )) %>
      </div>
    </fieldset>
  </div>
<% end %>

