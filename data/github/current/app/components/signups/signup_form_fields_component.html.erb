<%= hidden_field_tag :return_to, params[:return_to] %>
<%= hidden_field_tag :invitation_token, params[:invitation_token] %>
<%= hidden_field_tag :repo_invitation_token, params[:repo_invitation_token] %>

<div class="js-octocaptcha-hide mb-2">
  <%= render(Primer::Beta::Text.new(font_size: 3, font_weight: :bold).with_content("Sign up to GitHub")) %>
</div>

<div id="email-container" class="js-octocaptcha-hide" <%= test_selector("signup-form-fields-component")%>>
  <label for="email">
    Email<sup aria-hidden="true">*</sup>
  </label>
  <div class="mb-2">
    <auto-check src="<%= email_validity_checks_path %>" required>
      <%= form.email_field(
            :email,
            id: "email",
            class: "width-full js-octocaptcha-data-field",
            required: true,
            autofocus: true,
            autocomplete: "email",
            "data-target": "text-suggester.input",
            "data-octocaptcha-field-name": "email_address",
            "aria-describedby": "email-err"
          ) %>
      <%= csrf_hidden_input_for email_validity_checks_path %>
    </auto-check>
  </div>
  <div data-hint-for="email"></div>
</div>

<div id="password-container" class="js-octocaptcha-hide">
  <label for="password">
    Password<sup aria-hidden="true">*</sup>
  </label>
  <div class="mb-2">
    <div>
      <visible-password>
        <auto-check src="<%= password_validity_checks_path %>" required>
          <%= form.password_field(
                :password,
                id: "password",
                value: GitHub.default_password,
                class: "width-full",
                required: true,
                passwordrules: User::PASSWORD_RULES,
                autocomplete: "new-password",
                "data-target": "visible-password.input",
                "aria-describedby": "password-err"
              ) %>
          <%= csrf_hidden_input_for password_validity_checks_path %>
        </auto-check>
      </visible-password>
    </div>
  </div>
  <div data-hint-for="password"></div>
</div>

<div id="username-container" class="js-octocaptcha-hide">
  <div>
    <label for="login">
      Username<sup aria-hidden="true">*</sup>
    </label>
  </div>
  <div>
    <div>
      <auto-check src="<%= username_check_get_path(suggest_usernames: true) %>" http-method="GET" class="width-full mr-2" required>
        <%= form.text_field(
              :login,
              id: "login",
              class: "width-full js-octocaptcha-data-field",
              required: true,
              autocomplete: "username",
              "data-octocaptcha-field-name": "login",
              "aria-describedby": "login-err"
            ) %>
      </auto-check>
    </div>
  </div>
  <div data-hint-for="login"></div>
</div>

<div class="js-octocaptcha-hide">
  <%= render Signups::TermsOfServiceComponent.new %>
</div>

<div class="js-octocaptcha-hide">
  <%= render(
    Primer::Beta::Button.new(
      "data-continue-to-nux": "captcha-and-submit-container-nux",
      type: :button,
      scheme: :primary,
      block: true,
      mt: 3,
      classes: "js-octocaptcha-load-captcha",
      style: "background-color: var(--bgColor-black)"
    ).with_content("Continue")
  ) %>
</div>
