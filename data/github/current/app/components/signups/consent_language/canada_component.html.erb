<%= render(Primer::Alpha::Dialog.new(
  title: dialog_title,
  size: :medium_portrait,
  test_selector: "signups-consent-language-canada-component"
  )) do |d| %>
  <% d.with_show_button(mb: 3) { dialog_title } %>
  <% d.with_header(font_weight: :bold, show_divider: true) { dialog_header } %>
  <% d.with_body do %>
    <%= dialog_introduction %>
    <%= render(Primer::Alpha::RadioButtonGroup.new(name: :canada_choices)) do |component| %>
      <% component.radio_button(
        label: "Yes, please, I'd like to hear from GitHub and its family of companies via email for personalized
        communications, targeted advertising, and campaign effectiveness.
        To withdraw consent or manage your contact preferences,
        visit the Promotional Communications Manager and GitHub Privacy Statement.",
        value: "explicit_marketing_consent_granted") %>
      <% component.radio_button(
        label: "No, I don't want to receive promotional communications.",
        value: "explicit_marketing_consent_denied") %>
    <% end %>
    <%= render(Primer::Beta::Button.new(
      type: :button,
      scheme: :primary,
      block: true,
      classes: "signup-form-fields__button",
      test_selector: "signups-consent-language-component-submit-button"
      )) { "Continue" } %>
  <% end %>
<% end %>
