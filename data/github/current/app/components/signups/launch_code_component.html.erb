<%
  helpers.page_info(
    title: "Launch code",
    class: "header-overlay",
    full_height: true,
  )
%>

<%= render_react_partial(
  # All of these render_react_partial props should be considered public.
  props: {
    showLaunchCode: show_launch_code?,
    email: email.email,
    # The verificationToken is only exposed in the development environment for debugging or testing purposes.
    # It is omitted in other environments to prevent exposure of sensitive data.
    verificationToken: Rails.env.development? ? email.verification_token : nil,
    isDevEnv: Rails.env.development?,
    launchCodeLength: launch_code_length,
    error: error.present?,
    hiddenFieldsParams: hidden_fields_params,
    resendVerificationPath: resend_verification_path,
    updateEmailPath: update_email_path,
  },
  name: "launch-code"
) %>

