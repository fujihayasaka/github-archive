<%= form_with(
  model: user,
  url: nux_signup_index_path(return_to: params[:return_to]),
  class: class_names({ "position-relative js-octocaptcha-parent": show_captcha })
) do |form| %>
  <%= render Signups::SignupFormFieldsComponent.new(form: form) %>

  <div id="captcha-and-submit-container-nux" class="js-continue-step-container captcha-container" <%= test_selector("signup-component") %>>
    <% if show_captcha %>
      <%= render(Primer::Beta::Text.new(font_size: 3, font_weight: :bold).with_content("Verify your account")) %>
      <div class="js-continue-focus-target-nux" tabindex="-1" style="outline: none;">
        <%= render partial: "shared/octocaptcha", locals: {
              origin_page: "github_signup_redesign",
              octocaptcha_timeout: octocaptcha_timeout,
              include_header: false,
              version: 2,
              captcha_demo: captcha_demo,
              dynamically_load_captcha: dynamically_load_captcha,
            } %>
      </div>
    <% end %>

    <%= helpers.spamurai_form_signals %>

    <div class="px-sm-0 px-4 ">
      <%= form.button(
        "Create account",
        type: :submit,
        class: class_names([
          "form-control", "signup-submit-button",
          {
            "js-continue-focus-target-nux": !show_captcha,
            "js-octocaptcha-form-submit": show_captcha,
          },
        ]),
        data: { disable_invalid: true },
        disabled: show_captcha,
        hidden: show_captcha
      ) %>
    </div>
  </div>
<% end %>
