<% BENEFITS.each do |benefit| %>
  <%= render(Primer::Box.new(
    display: :flex,
    pb: 1,
    test_selector: "signups-benefit-component"
  )) do %>
    <%= render(Primer::Beta::Octicon.new(icon: :check, size: :small)) %>
    <%= render(Primer::Box.new) do %>
      <%= render(Primer::Beta::Text.new(
        color: :on_emphasis,
        font_weight: :bold,
        display: :block
      ).with_content(benefit[:title])) %>
      <%= render(Primer::Beta::Text.new(color: :on_emphasis).with_content(benefit[:description])) %>
    <% end %>
  <% end %>
<% end %>
