<%= render_react_partial(
  name: "ref-selector-partial",
  props: {
    className: "js-release-ref-selector",
    ariaLabel: aria_label,
    buttonText: button_text,
    persistButtonText: persist_button_text,
    buttonPrefix: prefix,
    showIcon: show_icon,
    hideShowAll: true,
    actionListHeadingText: "Select tag",
    cacheKey: ref_list_cache_key,
    canCreate: can_create_tag?,
    closeOnSelect: true,
    dispatchEvent: true,
    formData: selector? ? {
      id: "#{input_object_name}_#{input_field_name}",
      name: "#{input_object_name}[#{input_field_name}]",
      autosubmit: false
    } : nil,
    initialRef: tag_name,
    ownerLogin: @repository.owner_display_login,
    repoName: @repository.name,
    types: ["tag"],
    canCreateTag: can_create_tag?,
    size: size,
    allowResizing: true,
    idEnding: id_ending,
    urlTemplate: selector? ? nil : tag_url_template
  }
) %>
