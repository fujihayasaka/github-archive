<% stats_timer do %>
  <%= render Feed::ItemNextComponent.new(
    actor:,
    action:,
    timestamp: item.created_at,
    item:,
    repository:,
    heading_icon:,
  ) do |c| %>
    <% if item.related_item? %>
      <% c.with_border do %>
        <hr class="mb-3 mt-2">
      <% end %>
    <% end %>

    <% if item.rollup? %>
      <% c.with_heading_subject do %>
        <%= item.rollup_item_count %> <%= "contribution".downcase.pluralize(item.rollup_item_count) %>
      <% end %>
    <% else %>
      <% c.with_heading_subject do %>
        a branch in <%= helpers.link_to_feed_repo(
          repository,
          item,
          include_owner: true,
          test_selector: :push_heading_repo_link,
        ) %>
      <% end %>
    <% end %>
    <% c.with_body(
      mt: 2,
      bg: :subtle,
      mb: 0,
      p: 3,
      border_radius: 1,
      aria: { label: "Create branch" },
    ) do |body| %>
      <div class="d-flex flex-items-baseline">
        <span class="mr-2">
          <%= helpers.feed_user_avatar(repository.owner, item) %>
        </span>
        <span>
          <% if item.rollup? || item.related_item? %>
            created branch
          <% end %>
          <%= helpers.link_to_feed_branch(
            branch_name: branch_name,
            repo: repository,
            feed_item: item,
            test_selector: :push_branch_link,
          ) %>
          in <%= helpers.link_to_feed_repo(
            repository,
            item,
            include_owner: true,
            test_selector: :push_body_repo_link,
          ) %>
        </span>
      </div>
    <% end %>

    <% if item.rollup? %>
      <% c.with_related_items_preview do %>
        <%= render Feed::Cards::CreatePushComponent.new(item: item.related_items.slice(0)) %>
      <% end %>

      <% c.with_related_items do %>
        <% item.related_items.slice(1..).each do |related_item| %>
          <% component = related_card_component(related_item:) %>
          <%= render component.new(item: related_item) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
