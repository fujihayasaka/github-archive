<%= render(Primer::Box.new(
  align_self: :center,
  **system_arguments,
)) do %>
  <%= render(Primer::Alpha::ActionMenu.new(
    position: :relative,
    display: :flex,
    align_items: :flex_end,
    anchor_align: :end,
    test_selector: "feed-item-heading-menu",
  )) do |menu| %>
    <% menu.with_show_button(
      icon: :"kebab-horizontal",
      scheme: :invisible,
      m: nil,
      ml: nil,
      mr: 1,
      classes: "feed-item-heading-menu-button",
      aria: { label: "Feed item options" },
      test_selector: "feed-item-kebab",
    ) %>

    <% if show_reason? %>
      <% menu.with_item(
        tag: :div,
        content_arguments: {
          tag: :div,
          p: 3,
          bg: :default,
          style: "cursor: default;",
        },
        label_arguments: {
          color: :muted,
          font_size: 6,
          style: "cursor: text;",
        },
        test_selector: "feed-item-heading-menu-reason"
      ) do %>
        <%= reason_message %>
      <% end %>

      <% if show_disinterest_option? %>
        <% menu.with_divider %>
      <% end %>
    <% end %>

    <% if show_disinterest_option? %>
      <% menu.with_item(
        tag: :button,
        label: "Show less activity like this",
        content_arguments: {
          py: 3,
          data: disinterest_dialog_item_data,
        },
        test_selector: "feed-item-heading-menu-disinterest-button",
      ) %>
    <% end %>

    <% if show_unfollowable_actor_option? %>
      <% menu.with_item(
        label: "Unfollow this user",
        href: unfollow_user_path(target: actor),
        content_arguments: {
          py: 3,
          classes: "js-hide-heading-menu-button js-follow-unfollow-submit",
        },
        form_arguments: { method: :post },
        test_selector: "feed-item-heading-menu-unfollow-user-button",
      ) %>
    <% end %>

    <% if show_unstarrable_option? %>
      <% menu.with_item(
        label: "Unstar this repository",
        href: unstar_repository_path(item.repository.owner.display_login, item.repository),
        form_arguments: {
          method: :post,
          name: "context",
          value: "for_you_feed",
        },
        content_arguments: {
          py: 3,
          classes: "js-hide-heading-menu-button js-follow-unfollow-submit",
        },
        test_selector: "feed-item-heading-menu-unstar-repository-button",
      ) %>
    <% end %>

    <% if show_dismiss_announcement_option? %>
      <% menu.with_item(
        label: "Dismiss announcement",
        href: conduit_register_disinterest_path,
        form_arguments: {
          method: :post,
          inputs: dismiss_announcement_inputs,
        },
        content_arguments: {
          py: 3,
          classes: "js-feed-disinterest-submit",
        },
      ) %>
    <% end %>
  <% end %>

  <%# Dialog bodies %>

  <% if show_disinterest_option? %>
    <%= render(Conduit::RegisterDisinterestModalComponent.new(
      item: item,
      dialog_id: disinterest_dialog_id,
    )) %>
  <% end %>
<% end %>
