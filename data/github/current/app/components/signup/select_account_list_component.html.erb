<%= form_with url: query_path,
  method: :get,
  data: { turbo: true, turbo_frame: frame_id, test_selector: "query-form" },
  class: "tmp-mb-3 tmp-mt-3" do %>
  <% if @benefit.present? %>
    <%= hidden_field_tag "with", @benefit, "data-test-selector": "with-param"%>
  <% end %>
  <div class="auto-search-group">
    <input class="form-control width-full input-contrast auto-search-input"
      type="text"
      name="query"
      value="<%= params[:query] %>"
      placeholder="Search or filter <%= search_text %>"
      aria-label="Search or filter <%= search_text %>"
      autocomplete="off"
      data-throttled-autosubmit>
    <%= render Primer::Beta::Octicon.new(icon: "search") %>
    <%= render(Primer::Beta::Spinner.new(size: :small, classes: "spinner")) %>
  </div>
<% end %>

<turbo-frame id="<%= frame_id %>" class="tmp-mt-3" <%= test_selector("select-#{@account_type}-list")%> >
  <% if @accounts.any? %>
    <%= render(Primer::Box.new(border: true, border_radius: 2)) do %>
      <% @accounts.each do |account| %>
        <%= render Signup::SelectAccountListItemComponent.new(account: account, benefit: @benefit) %>
      <% end %>
    <% end %>

    <% if @accounts.respond_to?(:total_pages) %>
      <div class="paginate-container">
        <%= helpers.will_paginate(@accounts,
            renderer: TurboPaginationCollectionFrameReplaceLinkRenderer,
              params: { query: params[:query], with: @benefit },
              html: { "data-turbo-frame": frame_id }) %>
      </div>
    <% end %>
  <% else %>
    You don't currently have any <%= search_text %>.
    <%= render(Primer::Beta::Link.new(href: new_account_path, underline: true)) do %>
      Create one for free
    <% end %>.
  <% end %>
</turbo-frame>
