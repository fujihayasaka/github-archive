<%= render(Primer::Box.new(
  border: :bottom,
  display: :flex,
  align_items: :center,
  justify_content: :space_between,
  direction: :row,
  p: 2)) do %>
    <% benefit_label = @benefit.present? ? "benefit:#{@benefit};" : "" %>
    <% if @account.is_a?(Business) %>
      <div class="d-flex flex-items-center">
        <%= form_with(url: button_path, method: :post) do |form| %>
          <button type="submit" style="background: none; border: none; padding: 0; cursor: pointer;">
            <%= render GitHub::AvatarComponent.new actor: account, size: 48, mr: 2 %>
          </button>
        <% end %>
        <%= form_with(url: button_path, method: :post) do |form| %>
          <%= render Primer::Beta::Button.new(
            type: :submit,
            font_size: 4,
            font_weight: :bold,
            scheme: :link,
            text_align: :center,
            test_selector: "account-link",
            data: analytics_click_attributes(
              category: "Get started",
              action: "click #{account_type} get started",
              label: "#{benefit_label}ref_cta:#{account_type};ref_loc:account_choose;#{h(account.display_login)}"
            )
          ) do %>
            <%= account.safe_profile_name %>
          <% end %>
        <% end %>
        <% if eligible_for_trial_flow?(account, benefit) %>
          <%= render Primer::Beta::Label.new(ml: 2, scheme: :done) do %>
            Eligible for trial
          <% end %>
        <% end %>
      </div>
      <%= form_with(url: button_path, method: :post) do |form| %>
        <%= render Primer::Beta::Button.new(
          type: :submit,
          test_selector: "button-link",
          data: analytics_click_attributes(
            category: "Get started",
            action: "click #{account_type} get started",
            label: "#{benefit_label}ref_cta:#{account_type};ref_loc:account_choose;#{h(account.display_login)}"
          )
        ) do %>
          Continue
        <% end %>
      <% end %>
    <% else %>
      <div>
        <%= link_to h(button_path), data: analytics_click_attributes(
          category: "Get started",
          action: "click #{account_type} get started",
          label: "#{benefit_label}ref_cta:#{account_type};ref_loc:account_choose;#{h(account.display_login)}"
        ) do %>
          <%= render GitHub::AvatarComponent.new actor: account, size: 48, mr: 2 %>
        <% end %>
        <%= render(Primer::Beta::Link.new(
          href: h(button_path),
          font_size: 4,
          font_weight: :bold,
          test_selector: "account-link",
          data: analytics_click_attributes(
            category: "Get started",
            action: "click #{account_type} get started",
            label: "#{benefit_label}ref_cta:#{account_type};ref_loc:account_choose;#{h(account.display_login)}"
          )
        )) do %>
          <%= account.safe_profile_name %>
        <% end %>
      </div>
      <%= render Primer::Beta::Button.new(
        tag: :a,
        href: button_path,
        test_selector: "button-link",
        data: analytics_click_attributes(
          category: "Get started",
          action: "click #{account_type} get started",
          label: "#{benefit_label}ref_cta:#{account_type};ref_loc:account_choose;#{h(account.display_login)}"
        )
      ) do %>
        Continue
      <% end %>
    <% end %>
<% end %>
