<%= render(Primer::Box.new(
          border: :bottom,
          display: :flex,
          align_items: :center,
          justify_content: :space_between,
          direction: :row,
          p: 2))  do %>
        <div>
          <%= link_to h(button_path) do %>
            <%= render GitHub::AvatarComponent.new actor: account, size: 48, mr: 2 %>
          <% end %>
          <%= render(Primer::Beta::Link.new(href: h(button_path), font_size: 4, font_weight: :bold, test_selector: "account-link")) do %>
            <%= account.safe_profile_name %>
          <% end %>
        </div>
        <%= render Primer::Beta::Button.new(
          tag: :a,
          pr: 2,
          href: button_path,
          test_selector: "button-link",
          data: analytics_click_attributes(
                category: "Get started",
                action: "click #{account_type} get started",
                label: "ref_cta:#{account_type};ref_loc:account_choose;#{h(account.display_login)}"
              )
        ) do %>
          Continue
        <% end %>
      <% end %>
