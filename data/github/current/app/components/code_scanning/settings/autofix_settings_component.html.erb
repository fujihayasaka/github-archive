<div class="border rounded px-3 mb-3" <%= test_selector("code-scanning-autofix-settings") %>>
  <% if autofix_codeql_settings_configurable? %>
    <div class="py-3 <% if autofix_third_party_tools_settings_configurable? %> border-bottom<% end %>" <%= test_selector("code-scanning-autofix-codeql-settings") %>>
      <div class="d-flex flex-md-row flex-column gap-2">
        <div class="mb-md-0 mb-2 flex-auto">
          <h5>
            Copilot Autofix
          </h5>

          <p class="text-small color-fg-muted m-0">
            Suggest fixes for CodeQL alerts using AI. CodeQL default or advanced setup must be enabled for this feature to work.
            Learn more about the <%= render(Primer::Beta::Link.new(href: autofix_codeql_limitations_documentation_url, target: "_blank", classes: "Link--inTextBlock")) { "limitations of autofix code suggestions" } %>.
          </p>
        </div>

        <div>
          <%= render(Primer::Alpha::ToggleSwitch.new(
            size: :small,
            checked: CodeScanningRepositoryConfig.new(repository).code_scanning_autofix_settings_enabled?,
            "aria-label": "Copilot Autofix enablement",
            src: autofix_codeql_toggle_form_src,
            csrf_token: autofix_codeql_toggle_form_csrf_token,
          )) %>
        </div>
      </div>
    </div>
  <% end %>
  <% if autofix_third_party_tools_settings_configurable? %>
    <div class="py-3"  <%= test_selector("code-scanning-autofix-third-party-tools-settings") %>>
      <div class="d-flex flex-md-row flex-column gap-2">
        <div class="mb-md-0 mb-2 flex-auto">
          <h5>
            Copilot Autofix for third-party tools
            <%= render(GitHub::BetaFlagComponent.new(ml: 1)) %>
          </h5>

          <p class="text-small color-fg-muted m-0">
            Suggest fixes for third-party alerts using AI. Ensure that these tools are properly configured or that an analysis is uploaded for this feature to work.
            Learn more about the <%= render(Primer::Beta::Link.new(href: autofix_third_party_tools_limitations_documentation_url, target: "_blank", classes: "Link--inTextBlock")) { "limitations of autofix code suggestions for third party tools" } %>.
          </p>
        </div>

        <div>
          <%= render(Primer::Alpha::ToggleSwitch.new(
            size: :small,
            checked: CodeScanningRepositoryConfig.new(repository).code_scanning_autofix_third_party_tools_settings_enabled?,
            "aria-label": "Copilot Autofix for third party tools enablement",
            src: autofix_third_party_tools_toggle_form_src,
            csrf_token: autofix_third_party_tools_toggle_form_csrf_token,
          )) %>
        </div>
      </div>
    </div>
  <% end %>
</div>
