<div class="border rounded tmp-px-3 tmp-mb-3" <%= test_selector("code-scanning-settings-toggle-section") %>>
  <% if autofix_codeql_settings_configurable? %>
    <div class="tmp-py-3" <%= test_selector("code-scanning-autofix-codeql-settings") %>>
      <div class="d-flex flex-md-row flex-column gap-2">
        <div class="mb-md-0 mb-2 flex-auto">
          <h5>
            Copilot Autofix
          </h5>

          <p class="text-small color-fg-muted m-0">
            Suggest fixes for CodeQL alerts using AI. CodeQL default or advanced setup must be enabled for this feature to work.
            Learn more about the <%= render(Primer::Beta::Link.new(href: autofix_codeql_limitations_documentation_url, target: "_blank", classes: "Link--inTextBlock")) { "limitations of autofix code suggestions" } %>
          </p>
        </div>

        <div>
          <%= render(Primer::Alpha::ToggleSwitch.new(
            size: :small,
            checked: CodeScanningRepositoryConfig.new(repository).code_scanning_autofix_settings_enabled?,
            "aria-label": "Copilot Autofix enablement",
            src: autofix_codeql_toggle_form_src,
            csrf_token: autofix_codeql_toggle_form_csrf_token,
          )) %>
        </div>
      </div>
    </div>
  <% end %>

  <% if ai_findings_configurable? %>
    <div class="tmp-py-3 <% if autofix_configurable? %> border-top<% end %>" <%= test_selector("code-scanning-ai-findings-settings") %>>
      <div class="d-flex flex-md-row flex-column gap-2">
        <div class="mb-md-0 mb-2 flex-auto">
          <h5>
            AI findings
            <%= render(Primer::Beta::Label.new(scheme: :success, ml: 1)) { "Preview" } %>
          </h5>

          <p class="text-small color-fg-muted m-0">
            Generate security findings for non-CodeQL languages using AI. CodeQL default setup must be enabled for this feature to work.
            Learn more about the <%= render(Primer::Beta::Link.new(href: autofix_codeql_limitations_documentation_url, target: "_blank", classes: "Link--inTextBlock")) { "limitations of autofix code suggestions" } %>
          </p>
        </div>

        <div>
          <%= render(Primer::Alpha::ToggleSwitch.new(
            size: :small,
            checked: CodeScanningRepositoryConfig.new(repository).code_scanning_ai_findings_settings_enabled?,
            "aria-label": "AI Findings enablement",
            src: ai_findings_toggle_form_src,
            csrf_token: ai_findings_toggle_form_csrf_token,
          )) %>
        </div>
      </div>
    </div>
  <% end %>

  <% if delegated_alert_dismissal_configurable? %>
    <div class="tmp-py-3 <% if autofix_configurable? || ai_findings_configurable? %> border-top<% end %>"  <%= test_selector("code-scanning-settings-delegated-alert-dismissal") %>>
      <div class="d-flex flex-md-row flex-column gap-2">
        <div class="mb-md-0 mb-2 flex-auto">
          <h5>
            Prevent direct alert dismissals
          </h5>

          <p class="text-small color-fg-muted m-0">
            Actors must submit requests to dismiss an alert. This can impact pull requests requiring code scanning dismissal to merge.
          </p>
        </div>

        <div>
          <% if delegated_alert_dismissal_restricted? %>
            <div class="d-flex flex-items-center" <%= test_selector("code-scanning-settings-delegated-alert-dismissal-enforced") %>>
              <%= render Primer::Beta::Octicon.new(icon: "shield-lock") %>
              <span class="ml-1 color-fg-default f5">
                <%= delegated_alert_dismissal_enabled? ? "Enabled" : "Disabled" %>
              </span>
            </div>
          <% else %>
            <%= render(Primer::Alpha::ToggleSwitch.new(
              size: :small,
              test_selector: "code-scanning-settings-delegated-alert-dismissal-toggle",
              checked: delegated_alert_dismissal_enabled?,
              "aria-label": "Protected direct alert dismissal enablement",
              src: delegated_alert_dismissal_toggle_form_src,
              csrf_token: delegated_alert_dismissal_toggle_form_csrf_token,
            )) %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
