<turbo-frame id="runner-info-frame">
  <% if auto_codeql_runner_label_error? %>
    <p class="f5 color-fg-default text-bold m-0 mb-1">
      <%= primer_octicon(:"alert") %> Runner information is not available. Please try again later.
    </p>
  <% elsif autocodeql_runner_label.nil? %>
    <p class="f5 color-fg-default text-bold m-0 mb-1">  <%= primer_octicon(:"mark-github") %> Standard GitHub runner</p>
  <% else %>
    <p class="f5 color-fg-default text-bold m-0 mb-1">
      Labeled runner
      <%= render Primer::Beta::Label.new(mr: 1, scheme: :secondary, classes: "css-truncate css-truncate-target", style: "max-width:250px", title: "Label: #{autocodeql_runner_label}") do %>
        <%= autocodeql_runner_label %>
      <% end %>
    </p>
  <% end %>
</turbo-frame>
