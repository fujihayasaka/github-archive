<%= render(
  Primer::Beta::Blankslate.new(
    spacious: true,
    test_selector: "security-center-code-scanning-no-alerts-enable-on-all-repos-enterprise"
  )
) do |component| %>
  <% component.with_visual_icon(icon: :codescan, height: 32) %>
  <% component.with_heading(tag: :h3).with_content("No code scanning alerts found") %>
  <% component.with_description do %>
    No vulnerabilities found in protected repositories, but some of your repositories are still at risk. As an enterprise admin, you can make sure all of your enterprise's code is protected by applying a security configuration with code scanning to all repositories.
  <% end %>
  <% target_url = settings_security_analysis_enterprise_path(@business) %>
  <% component.with_secondary_action(
    href: target_url,
    underline: true,
    data: hydro_click_tracking_attributes("security_center.blankslate.click", {
      label: "Visit settings to enable code scanning",
      target_url: target_url,
      view: "/enterprises/#{@business.slug}/security/alerts/code-scanning"
    })
  ).with_content("Visit settings to enable code scanning") %>
<% end %>
