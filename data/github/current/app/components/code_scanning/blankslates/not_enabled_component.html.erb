<% target_url = settings_org_security_products_path(@organization) %>
<%= render(Primer::Beta::Blankslate.new(
  spacious: true,
  test_selector: "security-center-alert-centric-views-code-scanning-alerts-blankslate-not-enabled",
)) do |component| %>
  <% component.with_visual_icon(icon: :codescan, height: 32) %>
  <% component.with_heading(tag: :h2).with_content("Code scanning is not enabled in any repositories") %>
  <% component.with_description do %>
    Code scanning is a security feature that helps you find and fix vulnerabilities and coding errors. Enable it in a repository to get started or apply a configuration with code scanning to turn it on organization-wide.
  <% end %>
  <% component.with_secondary_action(
    href: target_url,
    underline: true,
    data: hydro_click_tracking_attributes("security_center.blankslate.click", {
      label: "Enable code scanning in settings",
      target_url: target_url,
      view: "/orgs/#{@organization.display_login}/security/alerts/code-scanning"
    })
  ).with_content("Enable code scanning in settings") %>
<% end %>
