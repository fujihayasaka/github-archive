<%= render(Primer::Beta::Blankslate.new(
  spacious: true,
  test_selector: "security-center-alert-centric-views-code-scanning-alerts-blankslate-no-repos-enterprise",
)) do |component| %>
  <% component.with_visual_icon(icon: :codescan, height: 32) %>
  <% component.with_heading(tag: :h2).with_content("Add a repository to see code scanning alerts") %>
  <% component.with_description do %>
    Code scanning is a security feature that helps you find and fix vulnerabilities and coding errors. To put it to work, create a repository in a select organization and add code to it.
  <% end %>
<% end %>
<div class="d-flex flex-justify-center tmp-mt-n7 tmp-mt-lg-n8 tmp-mb-6">
  <%= render(Primer::Alpha::ActionMenu.new) do |menu| %>
    <% menu.with_show_button(scheme: :primary) do |button| %>
      <% button.with_trailing_action_icon(icon: "triangle-down") %>
      Create repository
    <% end %>
    <% menu.with_group do |group| %>
      <% group.with_heading(title: "Select organization") %>
      <% @organizations.first(10).each do |org| %>
        <% target_url = new_organization_repository_path(org, intent: "code-scanning-alerts") %>
        <% group.with_avatar_item(
          href: target_url,
          src: org.primary_avatar_url,
          username: org.display_login,
          full_name: org.safe_profile_name,
          full_name_scheme: :inline,
          data: hydro_click_tracking_attributes("security_center.blankslate.click", {
            label: "Create repository",
            target_url: target_url,
            view: "/enterprises/#{@business.slug}/security/alerts/code-scanning"
          })
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
