<% target_url = new_organization_repository_path(@organization, intent: "code-scanning-alerts") %>
<%= render(Primer::Beta::Blankslate.new(
  spacious: true,
  test_selector: "security-center-alert-centric-views-code-scanning-alerts-blankslate-no-repos",
)) do |component| %>
  <% component.with_visual_icon(icon: :codescan, height: 32) %>
  <% component.with_heading(tag: :h2).with_content("Add a repository with code to see code scanning alerts") %>
  <% component.with_description do %>Code scanning is a security feature that helps you find and fix vulnerabilities and coding errors in your organization's repositories. To put it to work, you'll need to add a repository, and include code within it.
  <% end %>
  <% component.with_primary_action(
    href: target_url,
    data: hydro_click_tracking_attributes("security_center.blankslate.click", {
      label: "Add a repository",
      target_url: target_url,
      view: "/orgs/#{@organization.display_login}/security/alerts/code-scanning"
    })
  ).with_content("Add a repository") %>
<% end %>
