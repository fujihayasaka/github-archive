<%= render(Primer::Beta::Blankslate.new(
  spacious: true,
  test_selector: "security-center-alert-centric-views-code-scanning-alerts-blankslate-no-organizations",
)) do |component| %>
  <% component.with_visual_icon(icon: :codescan, height: 32) %>
  <% component.with_heading(tag: :h2).with_content("Add a repository with code to see code scanning alerts") %>
  <% component.with_description do %>
    Code scanning is a security feature that helps you find and fix vulnerabilities and coding errors. To put it to work, you'll first need to create an organization, add a repository, and include code within it.
  <% end %>
  <% new_enterprise_organization_path = new_enterprise_organization_path(@business, intent: "code-scanning-alerts") %>
  <% component.with_primary_action(
    href: new_enterprise_organization_path,
    data: hydro_click_tracking_attributes("security_center.blankslate.click", {
      label: "Create an organization",
      target_url: new_enterprise_organization_path,
      view: "/enterprises/#{@business.slug}/security/alerts/code-scanning"
    })
  ).with_content("Create an organization") %>
  <% new_enterprise_organization_invitation_path = new_enterprise_organization_invitation_path(@business, intent: "code-scanning-alerts") %>
  <% component.with_secondary_action(
    href: new_enterprise_organization_invitation_path,
    data: hydro_click_tracking_attributes("security_center.blankslate.click", {
      label: "Invite an organization",
      target_url: new_enterprise_organization_invitation_path,
      view: "/enterprises/#{@business.slug}/security/alerts/code-scanning"
    })
  ).with_content("Invite an organization") %>
<% end %>
