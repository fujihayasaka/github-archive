<%= render(Primer::Beta::Blankslate.new(
  spacious: true,
  test_selector: "security-center-alert-centric-views-code-scanning-alerts-blankslate-not-enabled-enterprise",
)) do |component| %>
  <% component.with_visual_icon(icon: :codescan, height: 32) %>
  <% component.with_heading(tag: :h2).with_content("Code scanning is not enabled in any repositories") %>
  <% component.with_description do %>
    Code scanning is a security feature that helps you find and fix vulnerabilities and coding errors. Enable it in a repository to get started or apply a security configuration with code scanning to turn it on enterprise-wide.
  <% end %>
  <% target_url = settings_security_analysis_enterprise_path(@business) %>
  <% component.with_secondary_action(
    href: target_url,
    underline: true,
    data: hydro_click_tracking_attributes("security_center.blankslate.click", {
      label: "Enable code scanning with security configurations",
      target_url: target_url,
      view: "/enterprises/#{@business.slug}/security/alerts/code-scanning"
    })
  ).with_content("Enable code scanning with security configurations") %>
<% end %>
