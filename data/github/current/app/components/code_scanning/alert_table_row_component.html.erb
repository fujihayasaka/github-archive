<li class="Box-row Box-row--focus-gray d-flex flex-justify-between flex-row mt-0 js-navigation-item" <%= test_selector("code-scanning-alert") %>>
  <div class="d-flex">
    <% if show_checkbox %>
      <%= render Primer::Alpha::CheckBox.new(
        name: "number[]",
        value: alert_number.to_s,
        label: "Select alert ##{alert_number}",
        visually_hide_label: true,
        "aria-labelledby": "alert-#{alert_number}",
        data: {
          check_all_item: "",
          test_selector: "code-scanning-alert-checkbox",
        },
        classes: "flex-shrink-0 mr-2 mt-1 js-scanning-alert-check"
      ) %>
    <% end %>

    <%= render(Primer::Box.new(display: :flex, mr: 2, mt: 1)) do %>
      <%= render(SecurityCenter::StateComponent.new(icon: alert_state_icon)) %>
    <% end %>

    <div class="d-flex flex-column flex-auto min-width-0 lh-default mr-2" <%= test_selector("result-number") %> id="alert-<%= alert_number %>">
      <div class="flex-items-start d-flex wb-break-word">
        <%= render Primer::Beta::Link.new(
          href: repository_result_path,
          scheme: :primary,
          underline: false,
          mr: 2,
          font_size: 4,
          font_weight: :bold,
          test_selector: "result-title"
        ) do %>
          <%= alert_title %>
        <% end %>

        <div class="mt-1 d-flex flex-wrap gap-1 flex-items-start flex-justify-end flex-lg-justify-start">
          <%= render CodeScanning::AlertSeverityComponent.new(
            severity: alert_rule_severity,
            security_severity: alert_security_severity,
            filter_url: severity_link,
            large_label: false,
            additional_classes: "flex-shrink-0",
          ) %>

          <% if alert_classifications.present? %>
            <% alert_classifications.each do |classification| %>
              <%= render Primer::Beta::Label.new(scheme: :secondary, tag: :a) do %>
                <%= classification %>
              <% end %>
            <% end %>
          <% end %>

          <% if show_experimental_label? %>
            <%= render Primer::Beta::Label.new(scheme: :secondary, tag: :a, href: experimental_tag_path) do %>
              Experimental
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="text-small color-fg-muted mt-1">
        <% if show_alert_number %>
          <span <%= test_selector("alert-row-number") %>>#<%= alert_number %></span>
        <% end %>

        <%= alert_state_label %>

        <% if alert_closed? %>
          as <% if filtered_by_resolution_url.present? %>
            <%= render Primer::Beta::Link.new(
              font_size: 6,
              font_weight: :bold,
              href: filtered_by_resolution_url,
              scheme: :secondary,
              test_selector: "closed-alert"
            ).with_content(alert_closed_reason) %>
          <% else %>
            <span class="text-bold" <%= test_selector("closed-alert") %>>
              <%= alert_closed_reason %>
            </span>
          <% end %>
        <% end %>
        <% if alert_state_timestamp.present? %>
          <%= time_ago_in_words_js(timestamp_to_time(alert_state_timestamp)) %>
        <% end %>

        &bull;

        <%= render Primer::Beta::Link.new(
          font_size: 6,
          href: filtered_by_tool_url,
          scheme: :secondary,
          test_selector: "tool-name"
        ) do %>
          Detected by
          <b><%= alert_tool %></b>
        <% end %>
        in <span <%= test_selector("file-path") %>>
          <% truncated_file_path = reverse_truncate_path(alert_file_path, 24) %>
          <% truncated_file_path = truncated_file_path.empty? ? "(no path)" : truncated_file_path %>
          <%= render Primer::Beta::Link.new(
            id: "file-path-#{repository.id}-#{alert_number}",
            font_size: 6,
            font_weight: :bold,
            href: filtered_by_path_url,
            scheme: :secondary,
            test_selector: "file-path"
          ).with_content(truncated_file_path) %><% unless @repository.feature_flag_enabled?(:code_scanning_instances_experiment, default: false) %> :<%= alert_file_start_line %><% end %>
          <% if truncated_file_path != alert_file_path %>
            <%= render(Primer::Alpha::Tooltip.new(for_id: "file-path-#{repository.id}-#{alert_number}", type: :description, text: alert_file_path, direction: :ne)) %>
          <% end %>
        </span>
      </div>
    </div>
  </div>

  <div class="no-wrap mt-1 ml-auto d-flex flex-items-center" <%= test_selector("alert-links") %>>
    <% if show_alert_links? %>
      <% alert_links_icon, alert_links_color = alert_links_button_icon_and_color %>
      <% if single_linked_pull_request? %>
        <% pull_request = linked_pull_requests.first %>
        <%= render(Primer::Beta::Button.new(
          tag: :a,
          href: pull_request_path(pull_request),
          scheme: :invisible,
          size: :small,
          data: hovercard_data_attributes_for_issue_or_pr(pull_request),
          test_selector: "alert-link-pull-request",
        )) do |button| %>
          <% button.with_leading_visual_icon(icon: alert_links_icon, color: alert_links_color, mr: 1) %>
          <%= alert_links_count %>
        <% end %>
      <% elsif single_linked_branch? %>
        <% branch = linked_branches.first %>
        <%= render(Primer::Beta::Button.new(
          tag: :a,
          href: linked_branch_path(branch),
          scheme: :invisible,
          size: :small,
          test_selector: "alert-link-branch",
        )) do |button| %>
          <% button.with_leading_visual_icon(icon: :"git-branch", color: :muted, mr: 1) %>
          <%= alert_links_count %>
        <% end %>
      <% else %>
        <%= render Primer::Alpha::ActionMenu.new(test_selector: "alert-links-dropdown") do |menu| %>
          <% menu.with_show_button(size: :small, scheme: :invisible) do |button| %>
            <%= render(Primer::Beta::Octicon.new(alert_links_icon, color: alert_links_color, mr: 1)) %> <%= alert_links_count %>
          <% end %>

          <% linked_pull_requests.each do |pull_request| %>
            <% pull_request_icon, pull_request_color = linked_pull_request_icon_and_color(pull_request) %>
            <% menu.with_item(
              label: pull_request.title,
              href: pull_request_path(pull_request),
              test_selector: "alert-link-pull-request-item"
            ) do |item| %>
              <% item.with_leading_visual_icon(icon: pull_request_icon, color: pull_request_color) %>
              <% item.with_description { linked_pull_request_description(pull_request) } %>
            <% end %>
          <% end %>

          <% linked_branches.each do |branch| %>
            <% menu.with_item(
              label: branch.name_for_display,
              href: linked_branch_path(branch),
              test_selector: "alert-link-branch-item"
            ) do |item| %>
              <% item.with_leading_visual_icon(icon: :"git-branch", color: :muted) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="no-wrap mt-1 ml-2 d-flex flex-items-center" <%= test_selector("tracking-issues") %>>
    <% if show_tracking_links? %>
      <% tracking_links_with_issue = @tracking_links.filter { |link| link[:issue].present? } %>
      <% if tracking_links_with_issue.length == 1 %>
        <% link = tracking_links_with_issue.first %>
        <% issue = link[:issue] %>
        <%= render(Primer::Beta::Button.new(
          tag: :a,
          href: issue.url,
          scheme: :invisible,
          size: :small,
          data: {
            "hovercard-type": "issue",
            "hovercard-url": issue_path(issue.repository.owner_display_login, issue.repository.name, issue.number) + "/hovercard"
          },
          test_selector: "tracking-issue-link",
        )) do |button| %>
          <% button.with_leading_visual_icon(icon: :"issue-opened", color: :muted, mr: 1) %>
          1
        <% end %>
      <% else %>
        <%= render Primer::Alpha::ActionMenu.new(test_selector: "tracking-issues-dropdown") do |menu| %>
          <% menu.with_show_button(size: :small, scheme: :invisible) do |button| %>
            <%= render(Primer::Beta::Octicon.new(:"issue-opened", color: :muted, mr: 1)) %> <%= tracking_links_with_issue.length %>
          <% end %>

          <% tracking_links_with_issue.each do |link| %>
            <% if link[:issue].nil? %>
              <% next %>
            <% end %>
            <% issue = link[:issue] %>
            <% issue_icon, issue_color = tracking_issue_icon_and_color(issue) %>
            <% issue_description = tracking_issue_description(issue) %>
            <% menu.with_item(
              label: tracking_issue_label(issue),
              href: issue.url,
              content_arguments: {
                data: {
                  "hovercard-type": "issue",
                  "hovercard-url": issue_path(issue.repository.owner_display_login, issue.repository.name, issue.number) + "/hovercard"
                }
              },
              test_selector: "tracking-issue-item"
            ) do |item| %>
              <% item.with_leading_visual_icon(icon: issue_icon, color: issue_color) %>
              <% item.with_description { issue_description } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="no-wrap mt-1 ml-2 d-flex flex-items-center">
    <% if show_repository %>
      <%= render(Primer::Box.new) do %>
        <%= render(SecurityCenter::RepositoryLinkComponent.new(
          mr: 1,
          alert_number: alert_number,
          href: repository_results_path,
          repository: repository,
          show_owner: show_organization
        )) %>
      <% end %>
    <% else %>
      <span class="branch-name"
        <%= test_selector("branch-name") %>><%= alert_file_branch_ref_name&.dup.force_encoding(Encoding::UTF_8).scrub! %></span>
    <% end %>
  </div>

  <% if show_assignees? %>
    <div class="no-wrap mt-1 ml-2 d-flex flex-items-center">
      <%= render Primer::Beta::AvatarStack.new(align: :right, ml: 2, body_arguments: { test_selector: "assignees" }) do |c| %>
        <% @assignees.each do |assignee| %>
          <% c.with_avatar(src: assignee.primary_avatar_url(64), alt: "@#{assignee.display_login}", "aria-label": "#{assignee.display_login} (assignee)", data: assignee.is_a?(Bot) ? hovercard_data_attributes_for_bot(assignee) : hovercard_data_attributes_for_user(assignee)) %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</li>
