<%= content_tag(:div, alive_attrs) do %>
  <%= annotation_wrapper do %>
    <% component_test_selector = code_quality? ? "code-quality-review-comment-component" : "code-scanning-review-comment-component" %>
    <div <%= test_selector component_test_selector %> class="js-comment">
      <%= render CodeScanning::AnnotationComponent.new(
        code_scanning_annotation_result: annotation_result,
        inline: true,
        annotation_id: alert_details.id,
        fallback_warning_level:,
        fallback_tool_name:,
        fallback_alert_title:,
        fallback_alert_message:,
        alert_number: alert_number,
        pull_request_review_thread: thread,
        skip_interactive_elements: skip_interactive_elements,
        repository: repository,
        refs: annotation_result.present? ? pull_request_refs : nil,
        pull_request: pull_request,
        has_pending_dismissal_request: pending_dismissal_request?,
        has_rejected_request: rejected_request?,
        pending_dismissal_requester: pending_dismissal_requester,
        pending_dismissal_resolution: pending_dismissal_resolution,
        pending_dismissal_requested_at: pending_dismissal_requested_at,
        code_quality_finding: code_quality_finding,
      ) do |component| %>
        <% component.with_disclaimer do %>
          <% if pending_dismissal_request? %>
            <p class="text-small mb-0" <%= test_selector("pending-dismissal-request") %>>
              <span class="text-bold"><%= pending_dismissal_requester%></span><span> requested to dismiss as <%= pending_dismissal_resolution%> <%= time_ago_in_words_js(timestamp_to_time(pending_dismissal_requested_at)) %></span>
            </p>
          <% elsif rejected_request? %>
            <p class="text-small mb-0" <%= test_selector("rejected-request") %>>
              <span class="text-bold"><%= request_rejector%></span><span> denied request to dismiss <%= time_ago_in_words_js(timestamp_to_time(rejected_at)) %></span>
            </p>
          <% elsif suggested_fix_rule_unsupported? %>
            <p class="text-small mb-0" <%= test_selector("cs-not-supported-text") %>>
              <%= render(Primer::Beta::Octicon.new(icon: :report, size: :small)) %>
              <%= suggested_fix_not_supported %> is not supported by
              <%= render Primer::Beta::Link.new(
                classes: "Link--inTextBlock",
                muted: false,
                scheme: :default,
                href: suggested_fix_autofix_docs_url,
                font_size: :small,
                mr: 2
              ).with_content("autofix")%>
            </p>
          <% elsif invalid_suggested_fix? %>
            <p class="text-small mb-0" <%= test_selector("ai-suggested-fix-invalid") %>>
              <%= render(Primer::Beta::Octicon.new(icon: :report, size: :small)) %>
              Copilot Autofix cannot generate an appropriate fix for this alert at this time
            </p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% suggested_fix_comment_header = capture do %>
    <%= render Primer::Box.new(display: :flex, justify_content: :space_between) do %>
      <%= render Primer::Box.new(ml: -2, m: 1, display: :flex, justify_items: :start, "data-morpheus-enabled": false) do %>
        <%= render Primer::Box.new(
          m: 1,
          display: :flex,
          justify_items: :center,
          justify_content: :center,
          bg: :subtle,
          border: true,
          classes: "circle",
          "data-morpheus-enabled": false,
          style: "max-height: max-content",
        ) do %>
          <%= render Primer::Beta::Octicon.new(:copilot, color: :muted, m: 1) %>
        <% end %>
        <h3 class="h5 d-flex flex-items-center ml-1 mb-1">Copilot Autofix</h3>
        <%= render Primer::Beta::Text.new(tag: :p, m: 1, flex: 1) do %>
          <%= render(Primer::Beta::Label.new(scheme: :secondary)) { "AI" } %>
          <span class="color-fg-muted">
            <% if state_updated_at %>
              <%= time_ago_in_words(state_updated_at) %> ago
            <% end %>
          </span>
        <% end %>
      <% end %>
      <% if show_thirdparty_beta_badge? %>
        <%= render Primer::Box.new(m: 1, display: :block, justify_items: :end, test_selector: "thirdparty-suggested-fix-beta") do %>
        <%= render(GitHub::BetaFlagComponent.new(ml: 1)) %>
        <%= render Primer::Beta::Link.new(
          muted: false,
          scheme: :default,
          href: thirdparty_autofix_docs_url,
          font_size: :small,
          mr: 2
        ).with_content("Copilot Autofix for " + tool_name)%>
      <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if autofix_enabled? %>
    <% if show_suggested_fix? %>
      <%= render Primer::Beta::Details.new(
        border: :top,
        classes: "Details-element",
        reset: true, # This hiddes the default marker
        open: !collapse_suggested_fix?,
      ) do |component|%>
        <% component.with_summary(
          hidden: hide_suggested_fix_summary?,
          button: false,
          py: 3,
          px: 3,
        ) do %>
          <div class="d-flex flex-items-center" <%= test_selector("ai-suggested-fix-collapsed-summary") %>>
            <span class="flex-auto mr-3 d-flex flex-items-center">
              <div class="d-lg-inline d-block px-md-0 px-3 pb-md-0 pb-3">
                <i><%= collapsed_suggested_fix_message %></i>
              </div>
            </span>

            <span class="btn-link color-fg-muted f6 Details-content--closed"><%= primer_octicon(icon: :unfold, mr: 1) %>Show autofix suggestion</span>
            <span class="btn-link color-fg-muted f6 Details-content--open"><%= primer_octicon(icon: :fold, mr: 1) %>Hide autofix suggestion</span>
          </div>
        <% end %>
        <% component.with_body do %>
          <div class="review-comment pt-2 js-code-scanning-apply-autofix-container" <%= test_selector("ai-suggested-fix") %>>
            <%= suggested_fix_comment_header %>

            <div class="ml-5">
              <div class="comment-body markdown-body soft-wrap css-overflow-wrap-anywhere user-select-contain d-block" <%= test_selector("ai-suggested-fix-description") %>>
                <%= suggested_fix_description %>
              </div>
            </div>

            <div class="ml-5 mt-4">
              <div class="soft-wrap<% unless show_suggested_fix_actions? %> rounded overflow-hidden<% end %>">
                <%= render Suggestions::MultiFileDiffComponent.new(
                  diff_entries: suggested_fix_diff_entries,
                  file_highlighting: suggested_fix_file_highlighting,
                  current_path: pull_request_review_comment.path,
                  header_type: autofix_header_type,
                  hydro_click_tracking_payload: diff_component_hydro_click_tracking_payload,
                  skip_view_patch_menu_item:,
                ) %>
              </div>

              <%= render CodeScanning::SuggestedFixDependencyMetadataComponent.new(dependency_metadata: suggested_fix_dependency_metadata) %>

              <%= render Primer::Box.new(display: :flex, classes: "flex-lg-row flex-column gap-2") do %>
                <div class="d-flex flex-auto f6 color-fg-muted flex-column flex-justify-center soft-wrap css-overflow-wrap-anywhere user-select-contain" <%= test_selector("ai-suggested-fix-footnote") %>>
                  Copilot is powered by AI and may make mistakes. Always verify output.
                </div>
                <% if show_suggested_fix_actions? %>
                  <div class="d-flex flex-sm-row flex-column flex-shrink-0 <% if show_workspace_editor? %>flex-md-column flex-lg-row<% else %>flex-md-row<% end %> flex-md-justify-end flex-justify-between gap-1" <%= test_selector("ai-suggested-fix-actions") %>>
                    <% if show_workspace_editor? %>
                      <%= render Primer::Beta::Button.new(
                        tag: :a,
                        size: :small,
                        classes: "flex-auto",
                        href: repository_code_scanning_autofix_open_workspace_editor_path(
                          number: alert_number,
                          path: pull_request_review_comment.path,
                          pull_request_review_comment_id: pull_request_review_comment.id)
                        ) do |component| %>
                        <% component.with_leading_visual_icon(icon: :copilot) %>
                        Open in Workspace
                      <% end %>
                    <% end %>
                    <% if suggested_fix_diff_entries.length == 1 %>
                      <%= render Primer::Beta::Button.new(tag: :a, size: :small, test_selector: "ai-suggested-fix-edit-button-changeset", href: suggested_fix_file_edit_path) do |component| %>
                        <% component.with_leading_visual_icon(icon: :pencil) %>
                        Edit
                      <% end %>
                    <% end %>
                    <details class="details-reset details-overlay position-relative flex-auto" id="<%= commit_suggestion_modal_id %>">
                      <%= render Primer::Beta::Button.new(tag: :summary, scheme: :secondary, size: :small, w: :full) do |component| %>
                        <% component.with_trailing_action_icon(icon: "triangle-down") %>
                        Commit suggestion
                      <% end %>
                      <div class="pt-1 SelectMenu right-0">
                        <div class="SelectMenu-modal" style="max-width: calc(100vw - 32px); width: 420px; height: auto;">
                          <header class="SelectMenu-header p-2">
                            <span class="SelectMenu-title">Commit suggestion</span>

                            <%= render Primer::Beta::IconButton.new(
                              icon: :x,
                              type: :button,
                              scheme: :invisible,
                              classes: "SelectMenu-closeButton",
                              "aria-label": "Close commit suggestion dialog",
                              show_tooltip: false,
                              data: {
                                toggle_for: commit_suggestion_modal_id
                              }
                            ) %>
                          </header>
                          <% if code_quality? %>
                            <% apply_autofix_path = pull_request_code_quality_autofix_path(repository.owner, repository, pull_request) %>
                          <% else %>
                            <% apply_autofix_path = pull_request_code_scanning_autofix_path(repository.owner, repository, pull_request) %>
                          <% end %>
                          <%= form_tag(apply_autofix_path, method: :post, class: "js-code-scanning-apply-autofix-form p-2") do %>
                            <input type="hidden" name="alert_number" value="<%= alert_number %>">
                            <input type="hidden" name="comment_id" value="<%= pull_request_review_comment.id %>">
                            <input type="hidden" name="current_oid" value="<%= current_head_oid %>">

                            <input type="text" name="commit_title" class="form-control input-block input-contrast mb-2" aria-label="Commit title" value="<%= autofix_suggestion_commit_title %>" placeholder="Commit title">

                            <textarea rows="2" aria-label="Commit message" autocomplete="off" class="js-suggestion-commit-message js-quick-submit form-control input-block mb-2" type="text" name="commit_message" placeholder="Add an optional extended description…" style="resize: vertical"></textarea>

                            <%= render Repositories::DcoLabelComponent.new(repo: repository) %>

                            <div class="form-actions">
                              <%= render Primer::Beta::Button.new(type: :submit, size: :small, classes: "js-code-scanning-apply-autofix-submit", data: { disable_invalid: true, disable_with: "Applying commit..." }).with_content("Commit changes") %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </details>
                  </div>
                <% end %>
              <% end %>

              <% if applied_suggested_fix? %>
                <% if state_updated_by.present? && state_updated_at.present? %>
                  <div class="f6 color-fg-muted mt-3 text-semibold" <%= test_selector("ai-suggested-fix-applied") %>>
                    <%= render GitHub::AvatarComponent.new(actor: state_updated_by, display: [:inline_block], size: 24) %>

                    <strong>
                      <%= render Comments::CommentActorComponent.new(actor: state_updated_by, show_full_name: false) %>
                    </strong>

                    committed this autofix suggestion <%= time_ago_in_words(state_updated_at) %> ago.
                  </div>
                <% elsif state_updated_at.present? %>
                  <div class="f6 color-fg-muted mt-2 text-semibold" <%= test_selector("ai-suggested-fix-applied") %>>
                    This autofix suggestion was applied <%= time_ago_in_words(state_updated_at) %> ago.
                  </div>
                <% else %>
                  <div class="f6 color-fg-muted mt-2 text-semibold" <%= test_selector("ai-suggested-fix-applied") %>>
                    This autofix suggestion was applied.
                  </div>
                <% end %>
              <% elsif outdated_suggested_fix? %>
                <div class="f6 color-fg-muted mt-2 text-semibold" <%= test_selector("ai-suggested-fix-outdated-note") %>>
                  Unable to commit as this autofix suggestion is now outdated
                </div>
              <% end %>

              <% if show_copilot_feedback_actions? %>
                <div class="mt-2" <%= test_selector("copilot-feedback-actions") %>>
                  <%= render PullRequests::Copilot::FeedbackComponent.new(
                    comment_id: pull_request_review_comment.id,
                    feedback_options: copilot_feedback_options,
                    feedback_path:
                  ) %>
                </div>
              <% end %>

              <div class="form-group flex-auto warn m-0 mt-2 color-fg-attention js-error-message-placeholder" hidden>
                <div class="position-relative warning m-0" style="max-width: inherit;">
                  <span class="js-error-message"></span>
                  <span class="text-bold btn-link js-refresh-after-suggestion">Refresh and try again.</span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% elsif suggested_fix_alert_pending? %>
      <%= pending_suggested_fix_with_timeout_wrapper do %>
        <%= suggested_fix_comment_header %>

        <div class="ml-5 f4">
          <p class="my-1 f6 color-fg-muted">
            Generating an autofix suggestion, this might take a while&hellip;
          </p>

          <div class="Skeleton Skeleton--text" style="width:100%">&nbsp;</div>
          <div class="Skeleton Skeleton--text" style="width:93%">&nbsp;</div>
          <div class="Skeleton Skeleton--text" style="width:89%">&nbsp;</div>
        </div>
      <% end %>
    <% elsif suggested_fix_alert_error? %>
      <div class="review-comment border-top" <%= test_selector("ai-suggested-fix-error") %>>
        <%= suggested_fix_comment_header %>

        <div class="mx-5 mt-5 f4 d-flex flex-column flex-items-center">
          <%= render(Primer::Beta::Octicon.new(:alert, size: :medium, color: :muted)) %>
          <p class="my-1 f6">
            <strong>Copilot could not generate an autofix suggestion</strong>
          </p>
          <p class="my-1 f6 text-center color-fg-muted">
            Copilot could not generate an autofix suggestion for this alert. Try pushing a new commit or if the problem persists
            <%= render Primer::Beta::Link.new(
              classes: "Link--inTextBlock",
              muted: false,
              scheme: :default,
              href: GitHub.support_url,
            ).with_content("contact support") %>.
          </p>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
