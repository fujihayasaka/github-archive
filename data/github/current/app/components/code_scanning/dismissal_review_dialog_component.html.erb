<%= render Primer::Alpha::Dialog.new(
  size: :medium_portrait,
  title: "Review request",
  aria_described_by: "review-request-description",
) do |dialog| %>
  <% dialog.with_show_button(
      scheme: :primary,
      tag: :summary,
      size: :small,
      test_selector: "review-request-button",
      aria: { label: "Review request" },
    ) do %>Review request<% end %>

  <% dialog.with_body do %>
    <p class="f5" id="review-request-description">
      Please provide feedback for your review decision.
    </p>

    <%= form_with url: dismissal_request_review_path, local: true, method: :put, id: "review-form" do |form| %>
      <%= form.hidden_field :request_id, value: timeline_event.request_id %>

      <div class="form-group">
        <label>
          Comment
        </label>
        <%= form.text_area :comment,
            placeholder: "Feedback to go with your review...",
            class: "form-control width-full",
            "aria-label": "Review comment",
            rows: 3 %>
      </div>

      <fieldset>
        <legend class="sr-only">Review decision</legend>
        <div class="form-group">
          <div>
            <%= form.radio_button :action_type, "reject", id: "action-deny", required: true %>
            <label for="action-deny">
              <span class="text-bold">Deny request</span>
            </label>
          </div>
          <div>
            <span class="color-fg-muted f6">Submit feedback on why alert cannot be dismissed</span>
          </div>
        </div>
        <div class="form-group">
          <div>
            <%= form.radio_button :action_type, "approve", id: "action-approve", required: true %>
            <label for="action-approve">
              <span class="text-bold">Approve request</span>
            </label>
          </div>
          <div>
            <span class="color-fg-muted f6">Submit feedback and alert will be automatically dismissed</span>
          </div>
        </div>
      </fieldset>
    <% end %>
  <% end %>

  <% dialog.with_footer do %>
    <div class="float-right">
      <%= render Primer::Beta::Button.new(type: :button, "data-close-dialog": true, "aria-label": "Close dialog") do %>
        Cancel
      <% end %>
      <%= render Primer::Beta::Button.new(
        scheme: :primary,
        type: :submit,
        form: "review-form",
        ml: 1,
      ) do %>Submit review<% end %>
    </div>
  <% end %>
<% end %>
