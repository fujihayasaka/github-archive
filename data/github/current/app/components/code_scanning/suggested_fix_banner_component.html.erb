<%= render Primer::Box.new(
  p: 2,
  mb: 3,
  block: true,
  border: true,
  border_color: attention? ? :attention : nil,
  border_radius: 2,
  display: :flex,
  align_items: [:flex_start, nil, :center],
  bg: attention? ? :attention : :subtle,
  classes: "gap-1",
  **@system_arguments
) do %>
  <div
    class="<%= class_names(
      "position-relative d-flex flex-items-center flex-justify-center flex-shrink-0 py-1",
      "color-fg-accent" => loading?,
      "color-fg-default" => !loading?,
    ) %>"
    style="width: 32px; height: 32px;"
  >
    <div class="<%= class_names("position-absolute", "d-flex" => loading?, "d-none" => !loading?) %>" style="width: 32px; height: 32px;">
      <%= render(Primer::Beta::Spinner.new(
        size: :medium,
        color: :accent,
        style: "height: 32px; width: 32px;"
      )) %>
    </div>

    <% if attention? %>
      <%= render(Primer::Beta::Octicon.new(:alert, color: :attention, size: :small)) %>
    <% else %>
      <%= render(Primer::Beta::Octicon.new(icon: :copilot, color: loading? ? :accent : :muted, size: :small)) %>
    <% end %>
  </div>

  <div class="py-1 flex-1"><%= content %></div>
  <%= action %>
<% end %>
