<%= form_tag(form_path, method: :put, test_selector: "post-as-admin-modal-form") do %>
  <% if helpers.posted_as_admin?(discussion_or_comment) %>
    <p>This will reveal the original author of the <%= discussion_or_comment.is_a?(Discussion) ? "discussion" : "comment" %> to all users.</p>
    <p>Do you wish to continue?</p>
  <% else %>
    <p>This will mark the <%= discussion_or_comment.is_a?(Discussion) ? "discussion" : "comment" %> as posted as an admin and change the author to Admin.</p>
    <p>Repository admins will be able to see the original author, but all other users will see Admin.</p>
    <p>Do you wish to continue?</p>
  <% end %>
  <%= hidden_field_tag parameter_name, (!discussion_or_comment.post_as_admin?).to_s %>
  <%= hidden_field_tag "comment[body]", (discussion_or_comment.body).to_s  if discussion_or_comment.is_a?(DiscussionComment) %>
  <div class="d-flex flex-justify-end mt-3">
    <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "dialog-update-comment-id-#{discussion_or_comment.id}" })) { "Cancel" } %>
    <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary, ml: 2)) { "Continue" } %>
  </div>
<% end %>
