<div class="<%= class_names(
    "d-flex flex-justify-between",
    "js-socket-channel js-updatable-content" => !inline_comment?,
) %>"
  <%= test_selector "discussion-form-actions" %>
  <% unless inline_comment? %>
    id="partial-discussion-form-actions"
    data-channel="<%= live_update_view_channel(timeline.discussion.websocket_channel) %>"
    data-gid="<%= timeline.discussion_graphql_id %>"
    data-url="<%= discussion_form_actions_path(
      timeline.repo_owner_login,
      timeline.repo_name,
      timeline.discussion
    ) %>"
  <% end %>
>
  <div class="d-flex flex-items-start">
    <% if helpers.can_post_as_admin? %>
      <%= render(GitHub::AvatarComponent.new(actor: current_user, size: 32, id: "js-role-avatar")) %>
      <%= render(
        Primer::Alpha::ActionMenu.new(
          id: "discussion-{{ id }}-comment",
          menu_id: "discussion-{{ id }}-comment-menu",
          select_variant: :single,
          size: :auto,
          dynamic_label: true,
          classes: "role-menu",
          name: "post_as_admin"
        )
      ) do |menu| %>
        <% menu.with_show_button(scheme: :invisible) do |button| %>
          <%= current_user.name %>
          <% button.with_trailing_action_icon(icon: :"triangle-down") %>
        <% end %>

        <% menu.with_group do |group| %>
          <% group.with_heading(title: "#{submit_button_text} as")%>

          <% group.with_avatar_item(
            id: "user_role",
            src: current_user.primary_avatar_url(20),
            username: current_user.name,
            label: current_user.name,
            data: { value: "false" },
            active: true,
            classes: "role-select-button text-semibold js-selected-avatar",
          ) %>

          <% group.with_avatar_item(
            id: "admin_role",
            src: User::AvatarList.default_image_url("gravatar-user-420"),
            username: "Admin",
            label: "Admin",
            active: false,
            data: { value: "true" },
            classes: "role-select-button text-semibold js-selected-avatar",
          ) %>
        <% end %>
      <% end %>
      <div class="mt-1" id="js-role-user-selected">
        <span class="color-fg-muted"><%= post_as_admin_action_text %></span><%= current_user.display_login %>
      </div>
      <div class="mt-1" id="js-role-admin-selected" hidden>
        <span class="color-fg-muted"><%= post_as_admin_action_text %></span>Admin
      </div>
      <input type="hidden" name="comment[post_as_admin]" id="js-post-as-admin-input" value="false">
    <% end %>
  </div>
  <div class="ml-1 d-flex flex-items-center">
    <% if inline_comment? %>
      <%= render Primer::Beta::Button.new(
        type: :reset,
        classes: "js-hide-inline-comment-form",
        data: { confirm_cancel_text: "Are you sure you want to discard your unsaved changes?" },
      ) do %>
        Cancel
      <% end %>
    <% end %>

    <% if show_close_button? %>
      <%= render Closables::Buttons::CloseComponent.new(closable: discussion) %>
    <% end %>

    <% if show_reopen_button? %>
      <%= render Closables::Buttons::ReopenComponent.new(closable: discussion) %>
    <% end %>

    <%= render Primer::Beta::Button.new(
      type: :submit,
      scheme: :primary,
      data: { disable_with: "", disable_invalid: "" },
      ml: 1,
    ) do %>
      <%= submit_button_text %>
    <% end %>
  </div>
</div>
