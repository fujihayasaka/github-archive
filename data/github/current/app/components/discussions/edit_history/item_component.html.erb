<%= render Primer::Experimental::ActionMenu::Item.new(**item_arguments) do %>
<% if helpers.can_view_original_author?(edit.user_content) %>
  <%= render GitHub::AvatarComponent.new(
    actor: editor,
    size: 20,
    classes: "avatar-small",
    vertical_align: :middle,
    aria: { hidden: true },
    mr: 1,
  ) %>
<% else %>
  <%= render Primer::Beta::Avatar.new(
    src: edit.user_content.repository.owner.primary_avatar_url(20),
    alt: "#{edit.user_content.repository.owner.safe_profile_name} Admin",
    classes: "avatar-small",
    size: 20,
    shape: :circle,
    vertical_align: :middle,
    aria: { hidden: true },
    mr: 1,
  ) %>
<% end %>
  <span class="v-align-middle text-bold">
    <%= author_display_text %>
  </span>
  <%= bot_identifier(editor) %>

  <span class="v-align-middle">
    <%= action %> <%= time_ago_in_words_js edit.edited_at %> <%= suffix %>
  </span>
<% end %>
