<%= primer_form_with(model: discussion, url: discussion_path(discussion), method: :patch, data: { turbo_stream: true }) do |f| %>
  <%= f.hidden_field :state, value: "draft" %>
  <%= f.hidden_field :publish_at, value: nil %>
  <h2 class="mb-3">
    Save this discussion as a draft?
  </h2>
  <p class="color-fg-muted mb-4">
    The discussion will be hidden from everyone except you with
    permission to edit it. You can publish or schedule it later.
  </p>
  <div class="d-flex flex-justify-end gap-2">
    <%= render(Primer::Beta::Button.new( data: { "close-dialog-id": dialog_dom_id })) { "Cancel" } %>
    <%= f.submit "Save as draft", class: "btn btn-primary", data: { disable_with: "Saving..." } %>
  </div>
<% end %>
