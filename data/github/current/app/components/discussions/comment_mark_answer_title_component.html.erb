<div class="<%= class_names(
  "mt-2 ml-3 mb-2 mb-md-0",
  "color-fg-accent" => verified_answer?,
  "color-fg-success" => timeline.show_as_answer?(comment) && !verified_answer?
) %>"
  <%= test_selector("comment-mark-answer-#{comment.id}") %>>
  <% if user_who_marked_answer %>
    <% if timeline.show_as_verified_answer?(comment) %>
      <span>Answer verified by</span>
    <% else %>
      <span>Answer selected by</span>
    <% end %>
    <% if helpers.can_view_original_author?(comment) %>
      <% if timeline.show_as_verified_answer?(comment) %>
        <span class="d-inline-block color-fg-inherit text-bold"><%= profile_link_user %></span>
      <% else %>
        <%= helpers.profile_link(user_who_marked_answer,
          data: helpers.discussion_view_click_attrs(comment, target: :USER_PROFILE_LINK),
          class: "d-inline-block color-fg-inherit text-bold",
        ) %>
      <% end %>
    <% else %>
      <span class="d-inline-block color-fg-inherit text-bold">Admin</span>
    <% end %>
    <% if should_show_timestamp? %>
      <a href="<%= comment.permalink %>" class="Link--secondary js-timestamp d-inline-block ml-2">
        <%= time_ago_in_words_js comment.discussion.verified_at %>
      </a>
    <% end %>
  <% end %>
</div>
