<%# frozen_string_literal: true %>

<comment-actions-container>
  <template data-target="comment-actions-container.dialogTemplate">
    <%= render Primer::Alpha::Dialog.new(
      title:   "{{title}}",
      id:      "{{dialogId}}",
      classes: "Overlay--size-auto"
    ) do |dialog| %>
      <% dialog.with_body do %>
        <%= render Primer::Alpha::IncludeFragment.new(src: "{{src}}") do %>
          <div class="text-center" data-hide-on-error>
            <%= render Primer::Beta::Spinner.new(aria: {label: "Loading"}) %>
          </div>
          <div class="text-center" data-show-on-error hidden>
            Something went wrong.
          </div>
        <% end %>
      <% end %>
    <% end %>
  </template>

  <div data-target="comment-actions-container.dialogContainer"></div>

  <%= render Primer::Alpha::ActionMenu.new(
      menu_id:       "discussion-row-actions-menu-#{discussion.id}",
      anchor_align:  :end,
      test_selector: "discussion-row-actions-#{discussion.id}"
    ) do |menu| %>
    <% menu.with_show_button icon: :"kebab-horizontal", scheme: :invisible, "aria-label": "Discussion options" %>
    <% if discussion.publishable? %>
      <% menu.with_item label: "Post now",
        tag:   :button,
        classes: "publish-now-menu-item",
        test_selector: "discussion-row-publish-now",
        data: {
          dialog_id: "dialog-publish-discussion-#{discussion.id}",
          title:     "Publish discussion",
          src:       discussion_publish_modal_path(repo.owner_display_login, repo.name, discussion),
          action:    "click:comment-actions-container#displayDialog",
          size:      "small"
        } %>
    <% end %>
    <% if discussion.scheduled? %>
      <% menu.with_item label: "Convert to draft",
        tag: :button,
        test_selector: "discussion-row-save-draft",
        data: {
          dialog_id: "dialog-save-draft-discussion-#{discussion.id}",
          title:     "Convert to draft",
          src:       discussion_save_as_draft_modal_path(repo.owner_display_login, repo.name, discussion),
          action:    "click:comment-actions-container#displayDialog",
          size:      "small"
        } %>
    <% end %>
    <%= menu.with_divider %>
    <% if discussion.publishable? %>
      <% menu.with_item label: "Edit discussion",
                        tag: :link,
                        href:  edit_discussion_path(repo.owner_display_login, repo.name, number: discussion.number),
                        test_selector: "discussion-row-edit" %>
    <% end %>
  <% end %>
</comment-actions-container>
