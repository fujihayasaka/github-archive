<%= primer_form_with(model: discussion, url: discussion_path(discussion), method: :patch, data: { turbo_stream: true }) do |f| %>
  <%= f.hidden_field :state, value: "open" %>

  <h2 class="mb-3">
    Publish this discussion now?
  </h2>

  <p class="color-fg-muted mb-4">
    The discussion will become immediately visible and subscribers will be
    notified. This action can't be undone.
  </p>

  <div class="d-flex flex-justify-end gap-2">
    <%= render(Primer::Beta::Button.new( data: { "close-dialog-id": dialog_dom_id })) { "Cancel" } %>
    <%= f.submit "Publish", class: "btn btn-primary", data: { disable_with: "Publishing..." } %>
  </div>
<% end %>
