<p class="mb-0">To authenticate with the model you will need to generate a personal access token (PAT) in your GitHub settings or set up an Azure production key.</p>

<div class="d-flex ml-3 mt-3">
  <%= render Primer::Beta::Avatar.new(
    src: "/images/modules/marketplace/models/logo-github.svg",
    alt: "",
    size: 24,
    shape: :square,
    test_selector: "github-avatar"
  ) %>
  <div class="ml-2">
    <h3 class="f5 mt-1 mb-2">
      GitHub
      <%= render Primer::Beta::Label.new(
        tag: :span,
        size: :medium,
        inline: true,
        ml: 1,
      ).with_content("Free") %>        </h3>
    <p class="mb-0 f6 fgColor-muted">
      Access AI inference with your GitHub PAT.
      <a href="<%= helpers.docs_url("github-models/rate-limits") %>" class="Link--inTextBlock">Learn more about limits based on your plan.</a>
    </p>
  </div>
  <div class="ml-4">
    <%= render Primer::Beta::Button.new(tag: :a, href: settings_user_tokens_path, size: :medium, classes: "no-underline") do
      "Get developer key"
    end %>
  </div>
</div>

<div class="d-flex ml-3 my-3">
  <%= render Primer::Beta::Avatar.new(
    src: "/images/modules/marketplace/models/logo-azure.svg",
    alt: "",
    size: 24,
    shape: :square,
    test_selector: "azure-avatar"
  ) %>
  <div class="ml-2">
    <h3 class="f5 mt-1 mb-2">
      Azure AI
      <span class="d-inline text-light fgColor-muted">by Azure</span>
      <%= render Primer::Beta::Label.new(
        tag: :span,
        size: :medium,
        inline: true,
        ml: 1,
        classes: "fgColor-default",
      ).with_content("Pay as you go") %>
    </h3>
    <p class="mb-0 f6 fgColor-muted">Access pay-as-you-go inference and more AI services on Azure.</p>
  </div>
  <div class="ml-4">
    <%= render Primer::Beta::Button.new(tag: :a, href: azure_link, size: :medium, classes: "no-underline") do %>
      Get production key
      <%= render Primer::Beta::Octicon.new(icon: "link-external", ml: 1, valign: "sub") %>
    <% end %>
  </div>
</div>
