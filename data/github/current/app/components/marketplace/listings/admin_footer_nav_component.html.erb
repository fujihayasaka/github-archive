<div class="border-top clearfix mt-3 pt-3 d-flex flex-items-center">
  <div class="col-8 float-left d-inline-flex flex-items-center">
    <nav class="paginate-container float-left d-inline my-0 mr-3 v-align-middle" aria-label="Pagination">
      <div class="pagination d-block">
        <% if current_step_idx == 0 %>
        <span class="disabled">Previous</span>
        <% else %>
        <a href="<%= previous_step[:path] %>" aria-label="Previous Page" <%= test_selector('admin-footer-nav-prev-btn') %>>Previous</a>
        <% end %>
        <a href="<%= next_step[:path] %>" aria-label="Next Page">Next</a>
      </div>
    </nav>
    <span class="text-small color-fg-muted"><strong>Next:</strong> <%= next_step[:next_text] || next_step[:title] %></span>
  </div>
  <div class="col-4 float-left text-right" <%= test_selector('admin-footer-nav-progress-container') %>>
    <a id="admin-footer-nav__progress-anchor" href="<%= edit_marketplace_listing_path(listing.slug) %>" class="Link--muted issue-meta-section task-progress ml-2"><%= primer_octicon(:checklist) %>
      <span class="task-progress-counts"><%= "#{current_step_idx + 1 } of #{num_steps}" %></span>
      <span class="progress-bar v-align-middle"><%# erblint:disable DeprecatedCustomCss %>
        <span class="progress" style="width: <%= progress %>%"></span>
      </span>
    </a>
  </div>
</div>
