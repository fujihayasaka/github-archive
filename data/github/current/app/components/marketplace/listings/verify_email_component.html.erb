<div class="Box-row color-bg-subtle d-flex flex-items-center">
  <% if organization.profile_email.present? %>
    <% if email_verified? %>
      <div class="Box-btn-octicon btn-octicon float-left">
        <%= helpers.marketplace_onboarding_status_icon(true) %>
      </div>
      <span class="color-fg-muted ml-3">Public email verified</span>
    <% elsif email_verification_pending? %>
      <div class="Box-btn-octicon btn-octicon float-left">
        <%= primer_octicon(:clock) %>
      </div>
      <span class="flex-auto color-fg-muted ml-3">Pending public email verification</span>
      <%= form_tag resend_verification_path, class: "d-inline-block ml-1", "aria-label": "Resend verification link" do %>
        <%= render(Primer::Beta::Button.new(type: :submit)) { "Resend Verification Link" } %>
      <% end %>
    <% else %>
      <div class="Box-btn-octicon btn-octicon float-left">
        <%= helpers.marketplace_onboarding_status_icon(false) %>
      </div>
      <span class="flex-auto ml-3">Public email has not been verified</span>
      <%= form_tag verify_email_path, class: "d-inline-block ml-1", "aria-label": "Verify email" do %>
        <%= render(Primer::Beta::Button.new(type: :submit)) { "Verify Email" } %>
      <% end %>
    <% end %>
  <% else %>
    <div class="Box-btn-octicon btn-octicon float-left">
      <%= helpers.marketplace_onboarding_status_icon(false) %>
    </div>
    <span class="flex-auto ml-3">Public email not set</span>
    <%= link_to "Set Public Email", set_public_email_path, class: "mt-1 btn", target: "_blank" %>
  <% end %>
</div>
