<%# erblint:counter ButtonComponentMigrationCounter 2 %>

<p class="mb-4">
  Some of this information will be displayed on your marketplace listing once it's published. See
  <a class="Link--inTextBlock" href="https://docs.github.com/en/site-policy/github-terms/github-marketplace-developer-agreement" target="_blank" rel="noopener noreferrer">
    development documentation for more details.
  </a>
</p>

<marketplace-security-compliance-trader-self-certification>
  <%= form_for listing, url: marketplace_listing_security_compliance_update_path(listing.slug), method: :put,
        html: { class: "d-flex flex-column gap-3" } do |form| %>
    <% if render_ai_act_section? %>
      <div>
        <%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 4, border: :bottom, pb: 1)) { "AI Compliance" } %>
        <p class="fgColor-muted text-small mt-2">
          All of the following information will be publicly displayed on your app’s marketplace listing page.
        </p>

        <%= render(Primer::Box.new(display: :flex, direction: :column, classes: "gap-3")) do %>
          <div>
            <div class="FormControl-label">
              Is your AI system classified as "high-risk" under the EU AI Act? *
            </div>
            <div class="FormControl-caption">
              High-risk AI systems are used in sectors like healthcare, education, law enforcement, and critical
              infrastructure. These face stricter requirements due to their potential impact on safety, rights, and
              livelihoods. For more details, refer to the
              <a class="Link--inTextBlock" href="https://artificialintelligenceact.eu/high-level-summary/"
                target="_blank" rel="noopener noreferrer">EU AI Act summary</a>
              and Article 6 of the
              <a class="Link--inTextBlock" href="https://artificialintelligenceact.eu/wp-content/uploads/2021/08/The-AI-Act.pdf"
                target="_blank" rel="noopener noreferrer">EU AI Act (PDF)</a>.
            </div>
            <%= render Primer::Alpha::RadioButtonGroup.new(
              name: "marketplace_listing[ai_risk_level]",
              ) do |component| %>
              <% component.radio_button(label: "Yes, my Copilot Extension classifies as high-risk.", value: "high", checked: listing.ai_risk_level_high?) %>
              <% component.radio_button(label: "No, my Copilot Extension does not classify as high-risk", value: "not_high", checked: listing.ai_risk_level_not_high?) %>
            <% end %>
          </div>

          <%= render(Primer::Box.new(display: :flex)) do %>
            <%= render Primer::Alpha::TextField.new(
              name: "marketplace_listing[llms_in_use]",
              label: "List all large language models (LLMs) that your extension uses *",
              autocomplete: "off",
              value: listing.llms_in_use,
              full_width: false,
              caption: "e.g. GitHub Copilot API, OpenAI GPT-4o, Meta Llama 3, etc.",
            ) %>
          <% end %>

          <div>
            <%= render(Primer::Beta::Text.new(tag: :div, font_weight: :semibold, mb: 2)) { "Attestation of EU AI Act Compliance *" } %>
            <%= render Primer::Alpha::CheckBox.new(
              name: "marketplace_listing[is_eu_ai_act_compliant]",
              label: "I agree to comply with the EU AI Act in operating my AI system",
              checked: listing.is_eu_ai_act_compliant?,
            ) %>
            <p class="fgColor-muted text-small mt-2">
              This certification applies to AI systems offered through your GitHub Marketplace listing. For guidance on compliance, refer to Articles 6 and 8-17 of
              <a class="Link--inTextBlock" href="https://artificialintelligenceact.eu/wp-content/uploads/2021/08/The-AI-Act.pdf"
                target="_blank" rel="noopener noreferrer">the EU AI Act (PDF)</a>.
            </p>
          </div>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 4, border: :bottom, pb: 1, mb: 2)) do %>
        EU Digital Services Act Compliance
      <% end %>

      <% if listing.published_paid_plans? && !listing.dsa_compliant? %>
        <%= render Primer::Alpha::Banner.new(scheme: :warning, description: "Paid apps without DSA compliance info provided by February 17th, 2025 will be de-listed until requirements are met.") %>
      <% end %>

      <p class="fgColor-muted text-small mt-2">
        Under the EU Digital Services Act, GitHub must collect and display information for paid app publishers classified as
        traders. If you don’t process payments on GitHub Marketplace, this doesn't apply. For traders, business ID, address,
        domain, and country will be publicly displayed on your listing. Learn more about
        <a class="Link--inTextBlock" target="_blank" rel="noopener noreferrer"
          href="https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=OJ:L:2022:277:FULL&from=EN">DSA compliance</a>.
      </p>
      <div class="mb-3">
        <div class="FormControl-label">
          Trader Self-Certification *
        </div>
        <div class="FormControl-caption">
          Declare your status under EU Digital Services Act. European Commission (EC)
          <a class="Link--inTextBlock" href="https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:52021XC1229(05)"
            target="_blank" rel="noopener noreferrer">notice</a>
          on what constitutes a trader. See Section 2.2. "Concept of Trader".
        </div>
        <%= render Primer::Alpha::RadioButtonGroup.new(
          name: "marketplace_listing[trader_self_certification]",
          data: {
            action: "change:marketplace-security-compliance-trader-self-certification#renderTraderInputs",
          },
          ) do |component| %>
          <% component.radio_button(label: "I do operate as a trader under EU regulations", value: "trader", checked: listing.trader?) %>
          <% component.radio_button(label: "I do not operate as a trader under EU regulations", value: "non_trader", checked: listing.non_trader?) %>
        <% end %>
      </div>

        <div data-target="marketplace-security-compliance-trader-self-certification.traderInputs" style="<%= trader_inputs_style %>">
          <%= render(Primer::Box.new(display: :flex, mb: 3)) do %>
            <%= render Primer::Alpha::TextField.new(
              name: "marketplace_listing[trader_address]",
              label: "Business Address *",
              caption: "Company address and country. Individual traders can use a P.O. Box.",
              autocomplete: "off",
              value: listing.trader_address,
              full_width: false,
            ) %>
          <% end %>

          <%= render(Primer::Box.new(display: :flex, align_items: :flex_end, classes: "gap-2", mb: 3)) do %>
            <%= render Primer::Alpha::Select.new(
                name: "marketplace_listing[trader_id_type]",
                label: "Business ID *",
                value: id_type_value,
                data: {
                  target: "marketplace-security-compliance-trader-self-certification.traderIdType",
                  action: "change:marketplace-security-compliance-trader-self-certification#renderTraderIdInput",
                },
                full_width: false,
            ) do |c| %>
              <% c.option(label: "ID type", value: "") %>
              <% standard_id_types.each do |type| %>
                <% c.option(label: "#{type.upcase} Number", value: type, selected: id_type_value == type) %>
              <% end %>
              <% c.option(label: "Other unique identifier (specify)", value: "other", selected: id_type_value == "other") %>
            <% end %>

            <%= render Primer::Alpha::TextField.new(
              name: "marketplace_listing[trader_id_type_other]",
              label: "Business ID Type",
              placeholder: "Specify unique identifier",
              autocomplete: "off",
              value: other_id_type_value,
              full_width: false,
              visually_hide_label: true,
              data: {
                target: "marketplace-security-compliance-trader-self-certification.traderIdOtherInput"
              },
              style: "#{other_id_type_style}",
            ) %>

            <%= render Primer::Alpha::TextField.new(
              name: "marketplace_listing[trader_id]",
              label: "Business ID",
              autocomplete: "off",
              value: listing.trader_id,
              full_width: false,
              visually_hide_label: true,
            ) %>
          <% end %>

          <div>
            <%= render(Primer::Beta::Text.new(tag: :div, font_weight: :semibold, mb: 2)) { "Attestation of EU Law Compliance *" } %>
            <%= render Primer::Alpha::CheckBox.new(
              name: "marketplace_listing[has_eu_compliance_attestation]",
              label: "I agree to comply with applicable EU regulations in operating my app",
              checked: listing.has_eu_compliance_attestation?,
            ) %>
            <p class="fgColor-muted text-small mt-2">
              This certification applies to products and services offered through your GitHub Marketplace listing.
              For guidance on DSA compliance, consult Article 30 and 31 of the EU
              <a class="Link--inTextBlock" href="https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=OJ:L:2022:277:FULL&from=EN" target="_blank" rel="noopener noreferrer">
                Digital Services Act
              </a>.
            </p>
          </div>
        </div>
    </div>

    <div>
      <%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 4, border: :bottom, pb: 1, mb: 2)) { "Security" } %>

      <%= render(Primer::Box.new(display: :flex, direction: :column, classes: "gap-3")) do %>
        <div>
          <%= render Primer::Alpha::TextField.new(
            name: "marketplace_listing[privacy_policy_url]",
            label: "Privacy Policy URL *",
            caption: "Describe your app’s data practices.",
            autocomplete: "off",
            value: listing.privacy_policy_url,
            full_width: false,
          ) %>
        </div>

        <div>
          <%= render Primer::Alpha::TextField.new(
            name: "marketplace_listing[tos_url]",
            label: "Terms of Service URL#{" *" if listing.listable_is_copilot_configured?}",
            caption: "Provide information on your app’s content moderation policies, intended uses and limitations.",
            autocomplete: "off",
            value: listing.tos_url,
            full_width: false,
          ) %>
        </div>

        <%= render(Primer::Box.new(display: :flex)) do %>
          <%= render Primer::Alpha::TextField.new(
            name: "marketplace_listing[third_party_services]",
            label: "Third-party services required *",
            caption: "List third-party dependencies that your app uses and shares data with, or “None” if there are no dependencies.",
            autocomplete: "off",
            value: listing.third_party_services,
            full_width: false,
          ) %>
        <% end %>

        <%= render Primer::Alpha::RadioButtonGroup.new(
          name: "marketplace_listing[repository_visibility]",
          label: "Repository visibility",
          caption: "Specify whether or not the source code for your listing is public (open-source) or private",
          data: {
            action: "change:marketplace-security-compliance-trader-self-certification#renderRepoUrlInputs",
          },
        ) do |component| %>
          <% component.radio_button(label: "Public", value: "public", checked: listing.repository_public?, data: { target: "marketplace-security-compliance-trader-self-certification.repoPublicInput" }) %>
          <% component.radio_button(label: "Private", value: "private", checked: listing.repository_private?) %>
        <% end %>

        <%= render Primer::Box.new(
          style: "#{repo_url_style}",
          data: { target: "marketplace-security-compliance-trader-self-certification.repoUrlInput" },
        ) do %>
          <%= render Primer::Box.new(display: :flex) do %>
            <%= render Primer::Alpha::TextField.new(
              name: "marketplace_listing[repository_url]",
              label: "Public repository URL",
              caption: "Optional link to the public repository for your app’s codebase.",
              autocomplete: "off",
              value: listing.repository_url,
              full_width: false,
            ) %>
          <% end %>
        <% end %>

        <div>
          <label for="marketplace_listing_transparency_disclosure">
            Transparency disclosures
            <% if listing.ai_risk_level_high? %>
              *
            <% end %>
          </label>
          <p class="color-fg-muted text-small" id="help-text-for-transparency_disclosure">
            Provide an overview of your app’s security and safety mechanisms. Extensions classified as high-risk or
            those requiring elevated permissions must provide more detailed information on risk management, data
            governance, and compliance in order to be approved for publishing. For more info, see the
            <a class="Link--inTextBlock" href="https://docs.github.com/en/site-policy/github-terms/github-marketplace-developer-agreement"
                target="_blank" rel="noopener noreferrer">GitHub Marketplace Developer Agreement</a>
             and Articles 6 and 8-17 of the
             <a class="Link--inTextBlock" href="https://artificialintelligenceact.eu/wp-content/uploads/2021/08/The-AI-Act.pdf"
                target="_blank" rel="noopener noreferrer">EU AI Act (PDF)</a>.
            Please specify all types of
            compliance offered and links to reports for verification.
          </p>
          <div class="js-previewable-comment-form previewable-comment-form write-selected border rounded-2 pb-2 color-border-default js-listing-characters-remaining-container" data-preview-url="<%= marketplace_preview_path %>">
            <%= csrf_hidden_input_for marketplace_preview_path, class: "js-data-preview-url-csrf" %>
            <div class="comment-form-head tabnav d-flex">
              <nav aria-labelledby="transparency_disclosure_tabs" class="tabnav-tabs overflow-visible" role="tablist">
                <div id="transparency_disclosure_tabs">
                  <button type="button" class="btn-link tabnav-tab write-tab js-write-tab selected" role="tab" aria-selected="true">Write</button>
                  <button type="button" class="btn-link tabnav-tab preview-tab js-preview-tab" role="tab">Preview</button>
                </div>
              </nav>
              <%= render Comments::MarkdownToolbarComponent.new(textarea_id: "marketplace_listing_transparency_disclosure") %>
            </div>
            <%= render partial: "comments/stale_content_error" %>
            <div class="write-content js-write-bucket mb-0">
              <text-expander keys=":" data-emoji-url="<%= emoji_suggestions_path %>">
                <textarea name="marketplace_listing[transparency_disclosure]"
                  class="form-control comment-form-textarea js-comment-field js-task-list-field js-quick-submit js-size-to-fit size-to-fit js-listing-characters-remaining-field"
                  id="marketplace_listing_transparency_disclosure" aria-describedby="help-text-for-transparency_disclosure"
                  placeholder="<%= TRANSPARENCY_DISCLOSURE_PLACEHOLDER %>"
                  data-character-limit="<%= Marketplace::Listing::TRANSPARENCY_DISCLOSURE_MAX_LENGTH %>"
                ><%= listing.transparency_disclosure&.force_encoding("utf-8")&.scrub! %></textarea>
              </text-expander>
            </div>
            <div class="preview-content">
              <%= render partial: "marketplace_listings/preview_text" %>
            </div>
            <div class="clearfix">
              <div class="float-left">
                <span class="tabnav-extra pt-0">
                  <a class="color-fg-muted" href="<%= GitHub.markdown_docs_url %>" target="_blank" rel="noopener noreferrer">
                    <%= primer_octicon(:markdown, vertical_align: :bottom) %>
                    Styling with Markdown is supported.
                  </a>
                  Limit <%= Marketplace::Listing::TRANSPARENCY_DISCLOSURE_MAX_LENGTH %> characters.
                  <span class="js-listing-characters-remaining" data-suffix="remaining.">
                    <%= Marketplace::Listing::TRANSPARENCY_DISCLOSURE_MAX_LENGTH - (listing.transparency_disclosure || "").length %> remaining.
                  </span>
                </span>
              </div>
            </div>
          </div>
          <%= render(Primer::Box.new(display: :flex, mt: 2, classes: "color-fg-muted text-small")) do %>
            <%= render(Primer::Beta::Octicon.new(icon: :info, mr: 1)) %>
            All listing information must comply with the&nbsp;
            <a class="Link--inTextBlock" href="https://docs.github.com/en/site-policy/github-terms/github-marketplace-developer-agreement"
               target="_blank" rel="noopener noreferrer">GitHub Marketplace Developer Agreement</a>.
          <% end %>
        </div>
      <% end %>
    </div>

    <div>
      <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary) do %>
        Save listing details
      <% end %>
    </div>
  <% end %>
</marketplace-security-compliance-trader-self-certification>
