<% if inline_author_names %>
  <% author_actors.each_with_index do |author, i| %>
    <%= render Commits::ContributorLinkComponent.new(git_actor: author) %>
    <%= " and " if i != last_author_index %>
  <% end %>
<% else %>
  <span class="text-bold"> <%# Possible TODO: Bring back `title=attribution` later as a dialog or summary%>
    <%= commit.author_actors.count %> <%= authors_word %>
  </span>
<% end %>
<% if committed_via_web? %>
  <%= authored_word %>
<% elsif committed_by_non_author? %>
  <%= authored_word %> and
  <%= render Commits::ContributorLinkComponent.new(git_actor: commit.committer_actor) %>
  <%= committed_word %>
<% else %>
  <%= committed_word %>
<% end %>
<% if show_push_attribution? && pusher_is_committer? && push_date_is_close_to_commit_date? %>
  and pushed
<% end %>
<% if include_verbs %>
  <%= commit_date %>
<% end %>
<% if show_push_attribution? && pusher_is_committer? && !push_date_is_close_to_commit_date? %>
  and pushed <%= pushed_at %>
<% end %>
<% if show_push_attribution? && !pusher_is_committer? %>
  &bull;
  <div class="d-inline-block">
    <div class="float-left"><%= render Commits::PusherAvatarComponent.new(pusher: pusher) %></div>
    <%= render Commits::ContributorLinkComponent.new(git_actor: pusher) %> pushed
    <%= pushed_at %>
  </div>
<% end %>
