<private-registry-form>
  <%= form_with url: create_form? ? settings_org_secrets_create_secret_path : settings_org_secrets_update_secret_path(name: secret&.name || configuration&.secret_name),
    class: "d-flex flex-column#{configuration&.oidc? ? '' : ' js-encrypt-submit'}",
    html: {"data-public-key": public_key[1], "data-test-selector": "edit-private-registry"},
    method: create_form? ? :post : :put do |form| %>
    <div class="form-group">
      <div class="form-group-header">
        <label for="url">URL</label>
      </div>

      <div class="form-group-body">
        <%= form.text_field(
          :url,
          required: true,
          placeholder: "URL",
          class: "form-control",
          value: registry_url,
          data: { "test-selector": "private-registry-url" })
        %>
      </div>
    </div>

    <div class="form-group">
      <div class="form-group-header">
        <label for="type">Type</label>
      </div>

      <div class="form-group-body">
        <%= render(Primer::Alpha::ActionMenu.new(
          select_variant: :single,
          dynamic_label: true,
          form_arguments: { builder: form, name: "registry_type", value: "maven_repository"},
          test_selector: "private-registry-action-menu"
        )) do |menu| %>
          <% menu.with_show_button do |button|
            button.with_trailing_action_icon(icon: :"triangle-down")
            "Select registry type"
          end %>

          <% PrivateRegistry::Configuration.human_readable_registry_types(view.current_organization).each do |type, readable_type| %>
            <% menu.with_item(
              label: readable_type,
              data: { value: type,
                action: "click:private-registry-form#showSecretFields",
              },
              active: registry_type == type.to_s,
            ) %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if updating_oidc? %>
      <div class="form-group">
        <div class="form-group-body">
          <%= render partial: "settings/organization/secrets/private_registry/oidc_description" %>
        </div>
        <div class="form-group-header">
          <label for="oidc_provider">OIDC Provider</label>
        </div>
        <div class="form-group-body">
          <select name="oidc_provider" id="oidc_provider" class="form-select" disabled>
            <option value="azure"<%= " selected" if configuration.auth_type == "oidc_azure" %>>Azure</option>
            <option value="aws"<%= " selected" if configuration.auth_type == "oidc_aws" %>>AWS CodeArtifact</option>
            <option value="jfrog"<%= " selected" if configuration.auth_type == "oidc_jfrog" %>>JFrog</option>
            <option value="cloudsmith"<%= " selected" if configuration.auth_type == "oidc_cloudsmith" %>>Cloudsmith</option>
            <option value="gcp"<%= " selected" if configuration.auth_type == "oidc_gcp" %>>Google Cloud Artifact Registry</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <span data-target="private-registry-form.secretField">
          <% if configuration.auth_type == "oidc_azure" %>
            <%= render partial: "settings/organization/secrets/private_registry/oidc_azure_fields", locals: { configuration: configuration } %>
          <% elsif configuration.auth_type == "oidc_aws" %>
            <%= render partial: "settings/organization/secrets/private_registry/oidc_aws_fields", locals: { configuration: configuration } %>
          <% elsif configuration.auth_type == "oidc_jfrog" %>
            <%= render partial: "settings/organization/secrets/private_registry/oidc_jfrog_fields", locals: { configuration: configuration } %>
          <% elsif configuration.auth_type == "oidc_cloudsmith" %>
            <%= render partial: "settings/organization/secrets/private_registry/oidc_cloudsmith_fields", locals: { configuration: configuration } %>
          <% elsif configuration.auth_type == "oidc_gcp" %>
            <%= render partial: "settings/organization/secrets/private_registry/oidc_gcp_fields", locals: { configuration: configuration } %>
          <% end %>
        </span>
      </div>
    <% else %>
    <span data-target="private-registry-form.SecretFields" hidden>
      <div class="form-group">

        <div class="form-checkbox">
          <%= radio_button_tag :form_type, "", !updating_username_and_password?, id: 'token',
            data: {
              value: "token",
              action: "click:private-registry-form#changeSecretFields",
            }
          %>
          <%= label_tag :token, "Token" %>
        </div>

        <div class="form-checkbox">
          <%= radio_button_tag :form_type, "", updating_username_and_password?, id: 'username_and_password',
              data: {
                value: "username_and_password",
                action: "click:private-registry-form#changeSecretFields",
              }
          %>
          <%= label_tag :username_and_password, "Username and password" %>
        </div>
        <div class="form-checkbox">
          <%= radio_button_tag :form_type, "", false, id: 'oidc',
              data: { value: "oidc", action: "click:private-registry-form#changeSecretFields" } %>
          <%= label_tag :oidc, "OIDC (OpenID Connect)" %>
        </div>
      </div>

      <div data-target="private-registry-form.oidcProviderSelect" hidden>
        <div class="form-group">
          <div class="form-group-body">
            <%= render partial: "settings/organization/secrets/private_registry/oidc_description" %>
          </div>
          <div class="form-group-header">
            <label for="oidc_provider">OIDC Provider</label>
          </div>
          <div class="form-group-body">
            <select name="oidc_provider" id="oidc_provider" class="form-select" data-action="change:private-registry-form#changeOidcProvider">
              <option value="azure">Azure</option>
              <option value="aws">AWS CodeArtifact</option>
              <option value="jfrog">JFrog</option>
              <option value="cloudsmith">Cloudsmith</option>
              <option value="gcp">Google Cloud Artifact Registry</option>
            </select>
          </div>
        </div>
      </div>

      <div class="form-group">
        <span data-target="private-registry-form.secretField">
          <% if updating_username_and_password?%>
            <%= render partial: "settings/organization/secrets/private_registry/username_and_password_fields", locals: {
              registry_username: registry_username,
              public_key: public_key,
              }
            %>
          <% else %>
            <%= render partial: "settings/organization/secrets/private_registry/token_field", locals: {
              public_key: public_key,
              }
            %>
          <% end %>
        </span>
      </div>
    </span>
    <span data-target="private-registry-form.updateSecretMsg">
      <% if update_form? %>
        <div class="form-group-body" >
          <p class="color-fg-muted mb-0">Secret values are encrypted and cannot be displayed, but you can
          <%= render Primer::Beta::Button.new(scheme: :link, data: {
            action: "click:private-registry-form#showSecretFields",
          }) do %>enter a new value.<% end %></p>
        </div>
      <% end %>
    </span>
    <% end %>

    <%= hidden_field_tag :auth_type, auth_type || "token" %>

    <span data-target="private-registry-form.repositoryAccessSelect">
      <%= render partial: "settings/organization/secrets/repository_access_select", locals: {
        visibilities: visibilities,
        default_visibility: secret&.visibility || default_visibility,
        total_count: total_count,
        selected_repositories: selected_repository_global_ids,
        repositories: selected_repositories,
        repository_items_data_url: view.repository_items_data_url(secret_name: secret&.name),
        repository_items_aria_id_prefix: view.repository_items_aria_id_prefix,
        }
      %>
    </span>

    <div class="form-checkbox tmp-mt-3">
      <%= hidden_field_tag :replaces_base, "0" %>
      <%= check_box_tag :replaces_base, "1", replaces_base, id: "replaces_base" %>
      <%= label_tag :replaces_base, "Replaces base" %>
    </div>

    <div class="form-group">
      <% if create_form? %>
        <%= render Primer::Beta::Button.new(
          type: :submit,
          scheme: :primary,
          "data-disable-with": "Adding…",
          "data-test-selector": "private-registry-new-submit-button"
        ).with_content("Add Registry") %>
      <% elsif update_form? %>
        <%= render Primer::Beta::Button.new(
          "data-disable-with": "Updating…",
          "data-sudo-required": true,
          "data-test-selector": "private-registry-edit-submit-button",
          type: :submit,
          scheme: :primary
        ).with_content("Save changes") %>
      <% end %>
    </div>
  <% end %>
  <template data-target="private-registry-form.secretTemplate">
    <%= render partial: "settings/organization/secrets/private_registry/token_field", locals: {
      public_key: public_key,
      }
    %>
  </template>

  <template data-target="private-registry-form.passwordTemplate">
    <%= render partial: "settings/organization/secrets/private_registry/username_and_password_fields", locals: {
      registry_username: registry_username,
      public_key: public_key,
      }
    %>
  </template>
  <template data-target="private-registry-form.oidcAzureTemplate">
    <%= render partial: "settings/organization/secrets/private_registry/oidc_azure_fields", locals: { configuration: configuration } %>
  </template>
  <template data-target="private-registry-form.oidcAwsTemplate">
    <%= render partial: "settings/organization/secrets/private_registry/oidc_aws_fields", locals: { configuration: configuration } %>
  </template>
  <template data-target="private-registry-form.oidcJfrogTemplate">
    <%= render partial: "settings/organization/secrets/private_registry/oidc_jfrog_fields", locals: { configuration: configuration } %>
  </template>
  <template data-target="private-registry-form.oidcCloudsmithTemplate">
    <%= render partial: "settings/organization/secrets/private_registry/oidc_cloudsmith_fields", locals: { configuration: configuration } %>
  </template>
  <template data-target="private-registry-form.oidcGcpTemplate">
    <%= render partial: "settings/organization/secrets/private_registry/oidc_gcp_fields", locals: { configuration: configuration } %>
  </template>
</private-registry-form>
