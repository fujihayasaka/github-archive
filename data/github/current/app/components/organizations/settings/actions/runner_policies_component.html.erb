<h2 class="text-normal mb-2">Runners</h2>

<%# Only include this heading if the custom images section is shown below %>
<% if show_custom_images_policies? %>
  <h4 class="h5 my-2">Repository self-hosted runners</h4>
<% end %>

<%= render Organizations::Settings::Actions::RepoSelfHostedRunnerComponent.new(
    entity: @organization,
    action: settings_org_actions_update_repo_self_hosted_runners_path(@organization),
) %>

<% if show_custom_images_policies? %>
  <% if show_custom_images_retention_policy? %>
    <h2 class="text-normal my-2">Custom images</h2>
    <%= render Organizations::Settings::Actions::CustomImageVersionLimitComponent.new(
      entity: @organization,
      action: settings_org_actions_update_custom_images_retention_policy_path(@organization),
    ) %>
  <% end %>

<% end %>



<% if show_standard_hosted_runners_toggle? %>
  <div class="tmp-my-4"></div>

  <div class="tmp-pt-3">
  <h4 class="h5 mb-2">Standard hosted runners</h4>
  <p class="color-fg-muted tmp-mb-3">Choose if repositories are allowed to use standard hosted runner labels. If disabled, hosted runners can only be accessed via a runner group.</p>

  <% if @organization.business.present? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :warning, icon: "alert", test_selector: "standard-hosted-runners-enterprise-managed")) do %>
      Standard hosted runners can only be toggled at the parent enterprise
      <%= link_to @organization.business.name, settings_actions_enterprise_path(@organization.business), class: "Link--inTextBlock" %>.
    <% end %>
  <% else %>
    <%= form_with(
      local: true,
      method: :put,
      url: settings_org_actions_update_standard_hosted_runners_path(@organization),
      class: "mb-0"
    ) do |f| %>
      <div class="form-checkbox mb-0">
        <label for="disable_standard_hosted_runners_for_org">
          <%= f.check_box :disable_standard_hosted_runners_for_org, { id: "disable_standard_hosted_runners_for_org", checked: standard_hosted_runners_disabled? } %>
          Disable for all repositories
        </label>
        <p class="note mt-2 color-fg-muted">
          <strong>Note:</strong> Once disabled you will lose any concurrency settings you have set up.
          <%= link_to "For more information on concurrency see our documentation.", "#", class: "Link--inTextBlock" %>
        </p>
      </div>

      <div class="tmp-mt-3">
        <%= render(Primer::Beta::Button.new(type: :submit)) { "Save" } %>
      </div>
    <% end %>
  <% end %>
  </div>

<% end %>
