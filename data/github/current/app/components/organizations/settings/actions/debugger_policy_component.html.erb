<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Job debugger<% end %>
<% end %>
<%= primer_form_with(url: @action, method: :put, data: { test_selector: "debugger_policy_form" }) do |f| %>
  <p class="mb-2">
  Choose which repositories are allowed to use the job debugger. Repositories must individually opt in to use it.
  </p>
  <% config = Actions::DebuggerPolicyConfig.new(@organization) %>
  <% if config.disabled_by_owner? %>
    <p class="color-fg-subtle f6" <%= test_selector("disabled-by-enterprise-message") %> >
    <%= render(Primer::Beta::Octicon.new(:"shield-lock")) %>
    <span>
      This setting has been <%= render(Primer::Beta::Link.new(href: GitHub.business_accounts_help_url, target: "_blank", rel: "noopener", classes: "Link--inTextBlock" )) { "set by enterprise administrators" } %>.
    </span>
    </p>
  <% else %>
    <%= render GitHub::MenuComponent.new(items: debugger_policy_values) do |menu| %><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
      <% menu.with_summary do %>
        <%= render Primer::Beta::Button.new(tag: :summary, test_selector: "policy-selection") do |c| %>
          <% c.with_trailing_action_icon(icon: "triangle-down") %>
          <span data-menu-button><%= menu.default_selection_text %></span>
        <% end %>
      <% end %>
    <% end %>

    <% if config.enabled_for_selected_entities? %>
      <div class="ml-2 d-inline js-policy-repos-container" <%= test_selector("selected-repos-section") %>>
        <%= form_tag settings_org_actions_update_actions_debugger_repos_path(@organization),
          class: "d-inline overflow-hidden js-policy-repos-form",
          id: "actions-debugger-policy-repos-form",
          method: :put do %>
          <%= render_react_partial(
            name: "actions-repos-picker",
            props: repos_picker_props,
            class_name: "d-inline-block"
          ) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
