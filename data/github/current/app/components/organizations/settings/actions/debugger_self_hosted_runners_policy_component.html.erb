<%= primer_form_with(url: @action, method: :put, class: "tmp-mt-3", data: { test_selector: "debugger_self_hosted_runners_policy_form" }) do |f| %>
  <% config = Actions::DebuggerSelfHostedRunnersPolicyConfig.new(@organization) %>
  <p class="mb-2">
    Allow live debugging on self-hosted runners. Repositories must individually opt in.
  </p>
  <% if config.disallowed_by_owner? %>
    <p class="color-fg-subtle f6" <%= test_selector("disallowed-by-enterprise-message") %> >
    <%= render(Primer::Beta::Octicon.new(:"shield-lock")) %>
    <span>
      This setting has been <%= render(Primer::Beta::Link.new(href: GitHub.business_accounts_help_url, target: "_blank", rel: "noopener", classes: "Link--inTextBlock" )) { "restricted by enterprise administrators" } %>.
    </span>
    </p>
  <% else %>
    <%= render GitHub::MenuComponent.new(items: policy_values) do |menu| %><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
      <% menu.with_summary do %>
        <%= render Primer::Beta::Button.new(tag: :summary, test_selector: "self-hosted-policy-selection") do |c| %>
          <% c.with_trailing_action_icon(icon: "triangle-down") %>
          <span data-menu-button><%= menu.default_selection_text %></span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

