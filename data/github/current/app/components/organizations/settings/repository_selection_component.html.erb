<div class="js-repository-selection-component d-flex flex-column overflow-hidden" <% if @discard_changes_on_close %>data-discard-changes-on-close <% end %>data-action="repository-items-loaded:selected-item-list#updateCount" <%= test_selector("repository-selection-component") %>>
  <%# Modal <dialog> implicitly marks everything outside it as inert, which
      makes the page-level #js-global-screen-reader-notice live region invisible
      to VoiceOver while this dialog is open. To get filter-result announcements
      ("No repositories found." or "Found N out of M items"), we host a live
      region INSIDE the dialog and point the global filter-input behavior
      (github-ui app/assets/modules/github/behaviors/filter-input.ts) at it via
      data-aria-live-element. WCAG 4.1.3 Status Messages -- package-security#3835. %>
  <span id="<%= @aria_id_prefix %>-live" class="sr-only" aria-live="polite" aria-atomic="true"></span>
  <filter-input class="flex-1 mb-2" aria-owns="<%= @aria_id_prefix %>-list" data-filter-empty-message="No repositories found." data-aria-live-element="<%= @aria_id_prefix %>-live">
    <input type="search" aria-label="Filter repositories" class="form-control width-full js-repository-items-filter-input" placeholder="Filter repositories">
  </filter-input>
  <div id="<%= @aria_id_prefix %>-list" class="d-flex flex-column overflow-auto">
    <ul data-filter-list class="list-style-none position-relative">
        <%= render Organizations::Settings::RepositoryItemsComponent.new(
          organization: @organization,
          repositories: @repositories,
          selected_repositories: @selected_repositories || [],
          current_page: 0,
          total_count: @total_count,
          data_url: @data_url,
          aria_id_prefix: @aria_id_prefix,
          repository_identifier_key: @repository_identifier_key
        ) %>
    </ul>
    <div class="color-fg-muted m-1" data-filter-empty-state hidden>
      No repositories found.
    </div>
  </div>
</div>
