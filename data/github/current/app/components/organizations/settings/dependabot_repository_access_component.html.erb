<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%= render Primer::Beta::Subhead.new(spacious: true, id: "dependabot-repository-access") do |component| %>
  <% component.with_heading(tag: :h2) do %>Grant Dependabot access to repositories<% end %>
<% end %>

<p>
  To update dependencies, Dependabot accesses all public and selected
  <%= "internal and" if internal_repositories_enabled? %> private repositories. The
  contents of these repositories become visible to all users in your organization
  through Dependabot updates. Consider using private registries if you don't want to share these
  repositories with everyone in your organization.
</p>

<% if repo_access_service_unavailable? %>
  <%= render Primer::Beta::Flash.new(scheme: :danger) do %>
    There was a problem loading this setting.
  <% end %>
<% else %>
  <%= render_react_partial name: "dependabot-repository-access-org-settings", props: react_repo_access_props %>
<% end %>
