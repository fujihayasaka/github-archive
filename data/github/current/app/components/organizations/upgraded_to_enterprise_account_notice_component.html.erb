<%= render Growth::ShowDialogOnLoadComponent.new(display: true) do |auto_open_dialog_component| %>
  <% auto_open_dialog_component.with_dialog(title: "Organization upgraded", size: :xlarge, style: "max-width: 640px;") do |dialog| %>
    <% dialog.with_header(hidden: true) %>
    <% dialog.with_body(test_selector: "upgraded-to-enterprise-account-dialog-notice", pl: 0) do %>
      <div class="position-relative d-none d-lg-block">
        <%= dialog_background_image %>
        <div class="pt-9 position-relative width-full">
          <div class="pl-4" style="width: 50%; margin: auto">
            <h3 class="color-fg-default pt-1" style="font-size: 19px;">Updates to your Enterprise plan</h3>
            <p class="color-fg-muted pt-1" style="font-size: 15px;">
              Same price as before with so much more&hellip;
            </p>
            <div class="color-fg-default pt-1" style="font-size: 15px;">
              <div class="pb-1">
                <%= render(Primer::Beta::Octicon.new(icon: "plus-circle", pr: 1)) %> Everything in your current plan, plus...
              </div>
              <div class="text-bold pb-1">
                <%= render(Primer::Beta::Octicon.new(icon: "check-circle-fill", pr: 1)) %> Multiple organizations
              </div>
              <div class="text-bold pb-1">
                <%= render(Primer::Beta::Octicon.new(icon: "check-circle-fill", pr: 1)) %> Internal repositories
              </div>
              <div class="text-bold pb-1">
                <%= render(Primer::Beta::Octicon.new(icon: "check-circle-fill", pr: 1)) %> Audit log streaming
              </div>
              <div class="text-bold pb-1">
                <%= render(Primer::Beta::Octicon.new(icon: "plus-circle", pr: 1)) %> GitHub Advanced Security (Add-on)
              </div>
              <div class="text-bold pb-2">
                <%= render(Primer::Beta::Octicon.new(icon: "plus-circle", pr: 1)) %> Copilot Enterprise (Add-on)
              </div>
              <br>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <% dialog.with_footer(show_divider: false) do %>
      <%= render Primer::Box.new(direction: :row, display: :flex, flex: 1, pt: 1, pl: 0) do %>
        <%= render(Primer::Beta::Text.new(font_size: 4, text_align: :left, font_weight: :bold)) do %>
          Your enterprise plan has been upgraded
        <% end %>
      <% end %>
      <p style="fg-color-muted">
        You are now an owner of the new <strong><%= business.name %></strong> enterprise and have access to features like multiple organizations,
        metered billing, and internal repositories. For more information, <a class="Link--inTextBlock" href="<%= faq_path %>">read the FAQ</a>.
        <br>
        Visit your new enterprise profile to edit your enterprise name, slug, and other settings.
        <br>
        Your pricing, the <strong><%= organization.name %></strong> organization, and its repositories have not been changed.
      </p>
      <%= form_tag growth_notice_dismissals_path, method: :post, class: "js-notice-dismiss" do %>
        <input type="hidden" name="notice" value="<%= notice_name %>">
        <input type="hidden" name="organization_id" value="<%= organization.id %>">
        <input type="hidden" name="per_user" value="<%= notice_per_user? %>">
        <%= render(Primer::Beta::Button.new(
          scheme: :secondary,
          type: :submit,
          test_selector: "dismiss-upgraded-to-enterprise-account-dialog-notice",
          data: analytics_click_attributes(
            category: "organization_upgrades",
            action: "dismiss_upgraded_to_enterprise_account_notice",
            label: "organization_id:#{organization.id};actor_id:#{current_user.id};business:#{business.id}"
          ).merge("action": "click:show-dialog-on-load#hideDialog")
        )) { "Dismiss" } %>
      <% end %>
      <%= form_tag business_settings_path, method: :get do %>
        <%= render(Primer::Beta::Button.new(
          scheme: :primary,
          type: :submit,
          test_selector: "investigate-upgraded-to-enterprise-account-dialog-notice",
          data: analytics_click_attributes(
            category: "organization_upgrades",
            action: "investigate_upgraded_to_enterprise_account_notice",
            label: "organization_id:#{organization.id};actor_id:#{current_user.id};business:#{business.id}",
          )
        )) { "Go to settings" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
