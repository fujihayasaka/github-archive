<div <%= test_selector "team-sidebar" %>>
  <img <%= test_selector "team-avatar" %> class="avatar rounded-2 tmp-mb-3" width="116" height="116"
    src="<%= team_primary_avatar_url %>" alt="@<%= team.combined_slug %>">

  <div class="d-flex tmp-pb-3 border-bottom">
    <%= render Primer::Beta::Heading.new(tag: :h2, style: "overflow-wrap: anywhere;", test_selector: "team-name").with_content(team.name) %>
    <% if show_enterprise_label? %>
      <%= render Primer::Beta::Label.new(
        ml: 2,
        display: :inline_block,
        align_self: :center,
        scheme: :secondary,
        title: "Team managed by an enterprise",
        test_selector: "team-enterprise-badge"
      ).with_content("Enterprise") %>
    <% end %>
    <% if show_enterprise_label_v2? %>
      <%= render Primer::Beta::Label.new(
        ml: 2,
        display: :inline_block,
        align_self: :center,
        scheme: :secondary,
        title: "Team managed by an enterprise",
        test_selector: "team-enterprise-badge"
      ).with_content("Enterprise team") %>
    <% end %>
    <% if team.secret? %>
      <%= render Primer::Beta::Label.new(
        ml: 2,
        display: :inline_block,
        align_self: :center,
        scheme: :secondary,
        title: "Only visible to its members and owners",
        test_selector: "team-secret-badge"
      ).with_content("Secret") %>
    <% end %>
  </div>

  <div class="d-flex tmp-mt-3 tmp-pb-3">
    <%= render Primer::Beta::Heading.new(flex: 1, tag: :h3).with_content("About") %>
  </div>

  <p class="description pb-2" <%= test_selector("team-description") %>>
    <% if team.description.present? %>
      <%= team.description %>
    <% else %>
      This team has no description
    <% end %>
  </p>

  <% if show_enterprise_label_v2? %>
    <p class="tmp-pb-3 tmp-pt-3 border-top color-fg-muted" style="font-size: 12px;"
      <%= test_selector("enterprise-team-description") %>>
      Managed by <%= link_to team.business.name, enterprise_teams_path(team.business), class: "Link--inTextBlock" %>.
      Added to <%= team.organization.safe_profile_name %> by an enterprise administrator.
    </p>
  <% end %>
</div>
