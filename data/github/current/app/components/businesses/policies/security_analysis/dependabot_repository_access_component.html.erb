<%= render Primer::Box.new(test_selector: TEST_SELECTOR, **system_arguments) do %>
  <%= render Primer::Beta::Subhead.new(hide_border: true, mb: 2) do |component| %>
    <% component.with_heading(tag: :h3, mb: 2) do %>
      Grant Dependabot access to repositories
    <% end %>
    <% component.with_description do %>
      To update dependencies, Dependabot accesses all public and selected internal or private repositories. The contents of these repositories become visible to all users in your organization. If needed, use private registries for more restricted access.
    <% end %>
  <% end %>

  <%= render Primer::Alpha::ActionMenu.new(
    select_variant: :single,
    size: :small,
    dynamic_label: true,
    dynamic_label_prefix: "Default access"
    ) do |menu|%>
    <% menu.with_show_button(test_selector: "dependabot_repository_access_selected_option") do |button| %>
      <% button.with_trailing_action_icon(icon: :"triangle-down") %>
      <%= selected_policy_text %>
    <% end %>
    <% policy_options.each do |policy| %>
      <% menu.with_item(
        label: policy.label,
        active: policy.active,
        href: settings_security_analysis_policies_update_dependabot_repository_access_enterprise_path,
        form_arguments: {
          method: :put,
          name: policy_name,
          value: policy.value
        }
      ) do |component| %>
        <% component.with_description.with_content(policy.description) %>
      <% end %>
    <% end %>
  <% end %>
  <div class="tmp-mt-3">
    <%= primer_octicon(:eye, color: :accent) %>
    <%= render(Primer::Alpha::Dialog.new(
      size: :large,
      title: "Dependabot Default Repository Access",
      id: "dependabot-default-repository-access"
    )) do |dialog| %>
      <% dialog.with_show_button(
        scheme: :link,
        font_size: 6,
      ) { "View your organizations’ current configurations" } %>
      <% dialog.with_header(show_divider: true) %>
      <% dialog.with_body do %>
        <%= render Primer::Alpha::IncludeFragment.new(src: enterprise_organizations_setting_path(business, "dependabot_default_repository_access")) do %>
          <%= render(Primer::Beta::Spinner.new(mx: :auto, display: :block, classes: "tmp-my-3")) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
