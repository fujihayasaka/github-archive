<%= render Primer::Box.new(test_selector: TEST_SELECTOR, **system_arguments) do %>
  <%= render Primer::Beta::Subhead.new(hide_border: true, mb: 2) do |component| %>
    <% component.with_heading(tag: :h3, mb: 2) do %>
      AI Findings
      <%= render(Primer::Beta::Label.new(scheme: :success, ml: 1)) { "Preview" } %>
    <% end %>
    <% component.with_description do %>
      By allowing this policy, organization and repository admins can choose to enable or disable AI-powered code scanning to detect vulnerabilities for non-CodeQL languages.
    <% end %>
  <% end %>

  <%= render(Primer::Alpha::ActionMenu.new(select_variant: :single, size: :small, dynamic_label: true, dynamic_label_prefix: "All organizations")) do |menu| %>
    <% menu.with_show_button do |button| %>
      <% button.with_trailing_action_icon(icon: :"triangle-down") %>
    <% end %>
    <% menu.with_item(
      label: "Allowed",
      active: ai_findings_policy_allowed?,
      href: settings_code_scanning_ai_findings_policy_enterprise_path(policy: CodeScanning::AiFindings::POLICY_NAME),
      form_arguments: {
        method: :put,
        name: value_param_name,
        value: "allowed"
      }
    ) do |item| %>
      <% item.with_description.with_content("Organization and repository admins can choose to enable or disable AI findings.") %>
    <% end %>
    <% menu.with_item(
      label: "Not allowed",
      active: !ai_findings_policy_allowed?,
      href: settings_code_scanning_ai_findings_policy_enterprise_path(policy: CodeScanning::AiFindings::POLICY_NAME),
      form_arguments: {
        method: :put,
        name: value_param_name,
        value: "disallowed"
      }
    ) do |item| %>
      <% item.with_description.with_content("Organization and repository admins cannot enable or disable AI findings.") %>
    <% end %>
  <% end %>
<% end %>
