<%= render(Primer::Alpha::Banner.new(full: true, scheme: :warning, icon: :alert)) do |component| %>
  <span class="text-bold">
    We couldn't process your payment for the <%= business.name %> enterprise. Your account has been approved
    for manual payments. You can convert your trial through the
    <%
      pay_url = if business.autopay_disabled_by_india_rbi? &&
          FeatureFlag.vexi.enabled?(:billing_india_rbi_recurring_payments, business, default: false)
        billing_settings_card_setup_enterprise_path(business)
      else
        billing_settings_one_time_payment_enterprise_path(business)
      end
    %>
    <%= link_to("new payment page", pay_url, class: "Link--inTextBlock") %>.
  </span>
<% end %>
