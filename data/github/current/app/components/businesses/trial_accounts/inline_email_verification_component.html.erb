<%#
  Inline email verification component for enterprise trial accounts
  Used in turbo stream responses
%>

<div>
  <div class="d-flex flex-items-center tmp-mb-3">
    <%= render(Primer::Beta::Octicon.new(:mail, size: :medium, color: :success)) %>
    <h1 class="h3 mb-0 ml-2">Verify your admin email</h1>
  </div>
    <p class="color-fg-muted tmp-mb-3">
      We've sent a 6-digit verification code to <strong><%= business.billing_email %></strong>
      for <%= business.name %>. Please enter the code below to activate your trial.
    </p>

    <div class="tmp-mb-4">
      <div class="email-verification-form-container">
        <%= form_with url: verification_form_url, method: :patch, local: true, class: "dfd-trial__form d-flex flex-column", id: "email_verification_form", data: { turbo: true } do |form| %>
          <% if with_param.present? %>
            <%= form.hidden_field :with, value: with_param %>
          <% end %>
          <div class="form-group d-flex flex-column">
            <%= form.label :code, "Verification code", class: "form-label f5 color-fg-default mb-2" %>
            <%= form.text_field :code,
              class: "form-control input-lg color-fg-subtle f5",
              placeholder: "Enter 6-digit code",
              maxlength: 6,
              pattern: "[0-9]{6}",
              required: true,
              autocomplete: "one-time-code",
              autofocus: true %>
            <p class="f6 color-fg-subtle mt-2 mb-0">Your code will expire in 2 hours</p>
          </div>

          <div class="form-actions d-flex tmp-pb-3">
            <%= form.submit "Verify email", class: "btn btn-primary btn-medium" %>
          </div>
        <% end %>
      </div>

      <div class="resend-email-form-container tmp-mt-4">
        <div class="d-flex flex-items-center">
          <p class="f6 color-fg-subtle mb-0 mr-2">
            Didn't receive the code?
          </p>
          <%= form_with url: verification_form_url, method: :post, local: true, class: "d-inline", id: "resend_email_form", data: { turbo: true } do |form| %>
            <% if with_param.present? %>
              <%= form.hidden_field :with, value: with_param %>
            <% end %>
            <%= form.submit "Resend verification email", class: "btn-link color-fg-accent Link--underline" %>
          <% end %>
        </div>
      </div>
    </div>
</div>
