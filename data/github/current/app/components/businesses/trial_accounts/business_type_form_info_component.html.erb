<%= render Primer::Beta::BorderBox.new do |component| %>
  <% component.with_body do %>
    <h1 class="h3 mb-3" <%= test_selector "business-type-form-info-heading" %>>
      <% if business_type == :default_managed %>
        Sign up for Enterprise Cloud
      <% elsif business_type == :enterprise_managed %>
        Enterprise Managed Users
      <% end %>
    </h1>
    <p class="color-fg-muted mb-3">
      <% if business_type == :default_managed %>
        For public, open source and private work, that allows members to access your repositories with their personal
        GitHub accounts.
        <%= render(Primer::Beta::Link.new(
          href: default_managed_docs_url,
          underline: true,
          target: "_blank"
        )) do %>
          Learn more about Enterprise Cloud
        <% end %> <%= render(Primer::Beta::Octicon.new(:"link-external", size: :small, color: :accent)) %>.
      <% elsif business_type == :enterprise_managed %>
        For private, internal work only, with member accounts provisioned from your identity provider.
        <%= render(Primer::Beta::Link.new(
          href: enterprise_managed_docs_url,
          underline: true,
          target: "_blank"
        )) do %>
          Learn more about Enterprise Managed Users
        <% end %> <%= render(Primer::Beta::Octicon.new(:"link-external", size: :small, color: :accent)) %>.
      <% end %>
    </p>
    <p class="color-fg-muted">
      <% if business_type == :default_managed %>
        For only private, internal work and provisioned accounts, we recommend using
        <%= render(Primer::Beta::Link.new(
          href: enterprise_managed_docs_url,
          underline: true,
          target: "_blank"
        )) do %>
          Enterprise with managed users
       <% end %> <%= render(Primer::Beta::Octicon.new(:"link-external", size: :small, color: :accent)) %>.
      <% elsif business_type == :enterprise_managed %>
        To bring your organization along or allow members to use their personal GitHub accounts, we recommend
        <%= render(Primer::Beta::Link.new(
          href: default_managed_docs_url,
          underline: true,
          target: "_blank"
        )) do %>
          Enterprise Cloud
       <% end %> <%= render(Primer::Beta::Octicon.new(:"link-external", size: :small, color: :accent)) %>.
      <% end %>
    </p>
  <% end %>
<% end %>
