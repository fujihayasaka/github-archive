<%= render Primer::Alpha::Dialog.new(
  id: "cancel-trial-#{business.id}",
  size: :large,
  title: "#{cancel_trial_flavor} trial for #{business.name}",
) do |dialog| %>
  <% dialog.with_show_button(
    test_selector: "cancel-button",
    scheme: :danger,
    size: button_size,
    data: {
      **analytics_click_attributes(
        category: "enterprise_trial_account",
        action: "cancel_enterprise_trial",
        label: "enterprise_id:#{business.id};location:enterprise_billing_settings")
    }
  ) do %>
    <%= cancel_trial_flavor %> trial
  <% end %>
  <% dialog.with_header(font_size: 3) do %>
    <%= cancel_trial_flavor %> trial for <%= business.name %>
  <% end %>

  <%= form_tag settings_billing_cancel_trial_enterprise_path(business), method: :put do %>
    <%= dialog.with_body(pt: 2) do %>
      <%= render(Primer::Alpha::Stack.new(gap: :normal)) do %>
        <%= render Primer::Alpha::Banner.new(scheme: :warning, icon: "alert") do %>
          Access to some organizations will be lost if you continue.
        <% end %>

        <span>If you <%= cancel_trial_flavor.downcase %> this trial, the following will happen:</span>

        <%= render(Primer::Alpha::Stack.new(tag: :ul, gap: :condensed, classes: "list-style-none")) do %>
          <%= render(Primer::Alpha::Stack.new(tag: :li, direction: :horizontal, gap: :condensed)) do %>
            <%= primer_octicon(:x, color: :danger, style: "height: 1lh") %>
            <%= render(Primer::Beta::Text.new(font_weight: :semibold)) { "Invited organizations will be reverted to their previous plan." } %>
          <% end %>

          <%= render(Primer::Alpha::Stack.new(tag: :li, direction: :horizontal, gap: :condensed)) do %>
            <%= primer_octicon(:x, color: :danger, style: "height: 1lh") %>
            <%= render(Primer::Beta::Text.new(font_weight: :semibold)) do %>
              You and all administrators will lose access to the
              <%= render(Primer::Beta::Link.new(
                href: enterprise_path(business),
                rel: "noopener noreferrer",
                target: "_blank",
                classes: "Link--inTextBlock"
              )) { business.name } %>
              enterprise.
            <% end %>
          <% end %>

          <%= render(Primer::Alpha::Stack.new(tag: :li, direction: :horizontal, gap: :condensed)) do %>
            <%= primer_octicon(:x, color: :danger, style: "height: 1lh") %>
            <div>
              <%= render(Primer::Beta::Text.new(font_weight: :semibold)) { "You will lose access to organizations created as part of the trial." } %>
              <%= render(Primer::Beta::Text.new(tag: :div, font_size: :small, color: :muted)) do %>
                You can
                <%= render(Primer::Beta::Link.new(
                  href: "#{GitHub.help_url}/repositories/creating-and-managing-repositories/transferring-a-repository",
                  rel: "noopener noreferrer",
                  target: "_blank",
                  classes: "Link--inTextBlock"
                )) { "transfer repositories to other organizations" } %>
                to avoid this.
              <% end %>
            </div>
          <% end %>
        <% end %>

        <div aria-live="polite" <%= test_selector("cancel-trial-confirmation")%>>
          <%= render(Primer::Alpha::CheckBox.new(
            name: "cancel_trial_confirmation",
            label: "I've read and understand the consequences of #{cancelling_trial_flavor} this trial.",
            required: true
          )) %>
        </div>
      <% end %>
    <% end %>

    <%= dialog.with_footer do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "cancel-trial-#{business.id}" })) { "Cancel" } %>
      <%= render(Primer::Beta::Button.new(
        type: :submit,
        scheme: :danger,
        test_selector: "confirm-cancel-button",
        data: {
          **analytics_click_attributes(
            category: "enterprise_trial_account",
            action: "confirm_cancel_enterprise_trial",
            label: "enterprise_id:#{business.id};ref_loc:#{ref_loc}"
          ).merge("disable-with": "")
        }
      )) { "Proceed to #{cancel_trial_flavor.downcase} trial" } %>
    <% end %>
  <% end %>
<% end %>
