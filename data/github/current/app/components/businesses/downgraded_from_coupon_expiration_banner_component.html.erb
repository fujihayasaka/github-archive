<%= render(Primer::Alpha::Banner.new(full: true, scheme: :warning, icon: :alert)) do |component| %>
  <span class="text-bold">
    Your coupon has expired and we don't have a valid payment on file for the <%= business.name %> enterprise. Please
    <%= link_to("update your payment method", enterprise_billing_payment_information_path(business), class: "Link--inTextBlock") %>.
