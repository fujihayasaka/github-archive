<% if next_uncompleted_task %>
  <section class="position-relative d-lg-flex flex-items-stretch flex-justify-between border rounded-2 color-border-muted color-bg-subtle tmp-px-3 tmp-py-4 <%= container_class %>" aria-label="You Completed a Task">
    <div class="flex-auto">
      <div class="border color-border-default position-absolute top-0 left-0 bottom-0 tmp-ml-5"></div>
      <div class="tmp-ml-5 tmp-pl-3">
        <h2 class="h3">You completed a task!</h2>

        <% if defined? completed_task.success_message_html %>
          <p class="color-fg-muted mt-1"><%= completed_task.success_message_html %></p>
        <% end %>

        <article class="position-relative d-flex flex-items-center border rounded-2 color-border-muted tmp-px-3 py-2 tmp-my-3">
          <div class="position-absolute left-0 color-bg-subtle tmp-ml-n6">
            <span class="ml-n1">
              <%= render(Primer::Beta::Octicon.new(icon: :"git-commit", size: :medium, color: :muted)) %>
            </span>
          </div>
          <div class="tmp-mr-3"><%= render(Primer::Beta::Octicon.new(:"check-circle-fill", size: :medium, color: :success)) %></div>

          <div class="h5 color-fg-muted mr-2">
            <%= completed_task.title %>
          </div>
        </article>

        <article class="position-relative">
          <div class="position-absolute left-0 color-bg-subtle mt-2 tmp-ml-n6">
            <span class="ml-n1">
              <%= render(Primer::Beta::Octicon.new(icon: :"git-commit", size: :medium, color: :muted)) %>
            </span>
          </div>
          <a href="<%= next_uncompleted_task.task_link %>" class="d-flex flex-items-center h5 border rounded-2 color-border-muted color-shadow-large color-bg-subtle hover-grow no-underline tmp-px-3 py-2 tmp-my-3">
            <div class="tmp-mr-3"><%= render(Primer::Beta::Octicon.new(:circle, size: :medium, color: :muted, display: :block)) %></div>
            <span class="mr-2"><%= next_uncompleted_task.title %></span>
          </a>
        </article>

        <div class="tmp-mt-4">
          <%= render(Primer::Beta::Button.new(scheme: :invisible, size: :small, tag: :a, href: enterprise_path(business))) { "See all tasks" } %>
        </div>
      </div>
    </div>

    <div class="d-none d-lg-block col-lg-5" style="background: center / contain no-repeat url(/images/modules/dashboard/onboarding/glow-1.png);">
      <img src="/images/modules/dashboard/onboarding/mona_flying.png" alt="Mona" class="d-block col-6 mx-auto" loading="lazy">
    </div>
  </section>
<% else %>
  <section <%= test_selector("all-tasks-completed") %>  class="js-notice border rounded-2 color-border-muted color-bg-subtle tmp-mb-4" aria-label="You Completed a Task">
    <div class="position-relative d-lg-flex flex-items-start flex-justify-between tmp-px-3 tmp-py-4">
      <div class="flex-auto">
        <div class="border color-border-default position-absolute top-0 left-0 bottom-0 tmp-ml-5"></div>
        <div class="tmp-ml-5 tmp-pl-3">
          <h2 class="h3">You've completed all your tasks!</h2>
          <p class="color-fg-muted">Discover more features or buy GitHub Enterprise.</p>

          <ul class="list-style-none">
            <li class="position-relative d-flex flex-items-center h5 tmp-my-3">
              <div class="tmp-ml-n6">
                <div class="ml-n2">
                  <img src="<%= image_path "modules/site/features/launchpad/icons/icon-security.svg" %>" alt="GitHub Security Icon" width="32" class="d-block" >
                </div>
              </div>
              <a href="<%= features_path(anchor: "features-security") %>" class="d-inline-block tmp-ml-3">Security</a>
            </li>
            <li class="position-relative d-flex flex-items-center h5 tmp-my-3">
              <div class="tmp-ml-n6">
                <div class="ml-n2">
                  <img src="<%= image_path "modules/site/features/launchpad/icons/icon-apps.svg" %>" alt="GitHub Apps Icon" width="32" class="d-block" >
                </div>
              </div>
              <a href="<%= features_path(anchor: "features-apps") %>" class="d-inline-block tmp-ml-3">Client apps</a>
            </li>
            <li class="position-relative d-flex flex-items-center h5 tmp-my-3">
              <div class="tmp-ml-n6">
                <div class="ml-n2">
                  <img src="<%= image_path "modules/site/features/launchpad/icons/icon-project-management.svg" %>" alt="GitHub Project management Icon" width="32" class="d-block" >
                </div>
              </div>
              <a href="<%= features_path(anchor: "features-project-management") %>" class="d-inline-block tmp-ml-3">Project management</a>
            </li>
            <li class="position-relative d-flex flex-items-center h5 tmp-my-3">
              <div class="tmp-ml-n6">
                <div class="ml-n2">
                  <img src="<%= image_path "modules/site/features/launchpad/icons/icon-team-admin.png" %>" alt="GitHub Team administration Icon" width="32" class="d-block" >
                </div>
              </div>
              <a href="<%= features_path(anchor: "features-team-administration") %>" class="d-inline-block tmp-ml-3">Team administration</a>
            </li>
            <li class="position-relative d-flex flex-items-center h5 tmp-my-3">
              <div class="tmp-ml-n6">
                <div class="ml-n2">
                  <img src="<%= image_path "modules/site/features/launchpad/icons/icon-community.svg" %>" alt="GitHub community Icon" width="32" class="d-block" >
                </div>
              </div>
              <a href="<%= features_path(anchor: "features-community") %>" class="d-inline-block tmp-ml-3">Community</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="d-none d-lg-block col-lg-5" style="background: center / contain no-repeat url(/images/modules/dashboard/onboarding/glow-1.png);">
        <img src="/images/modules/dashboard/onboarding/mona_flying.png" alt="Mona" class="d-block col-6 mx-auto" loading="lazy">
      </div>
    </div>

    <div class="position-relative d-flex flex-row flex-wrap tmp-p-3">
      <div class="border color-border-default position-absolute top-0 left-0 right-0"></div>

      <div class="d-lg-flex flex-items-center">
        <% unless business.trial_conversion_initiated? %>
          <div class="tmp-mb-3 tmp-mb-lg-0 tmp-mr-lg-3">
            <%= render Primer::Beta::Button.new(
              type: :button,
              scheme: :primary,
              tag: :a,
              size: :small,
              href: '#',
              data: {
                **analytics_click_attributes(
                  category: "enterprise_trial_account",
                  action: "buy_enterprise",
                  label: "enterprise_id:#{business.id};location:completed_guidance;content:#{buy_enterprise_flavor(short: true).parameterize.underscore}")
              },
            ).with_content(buy_enterprise_flavor(short: true)) %>
          </div>
        <% end %>
        <div class="tmp-mb-3 tmp-mb-lg-0">
          <%= render Primer::Beta::Button.new(type: :button, tag: :a, size: :small, href: "#{ent_contact_url}?ref_page=#{request.fullpath}&ref_cta=#{url_encode("Talk to us")}&ref_loc=#{url_encode("onboard tasks")}", classes: "tmp-mr-3") do %>
            Talk to us
          <% end %>
        </div>
        <div class="tmp-mb-3 tmp-mb-lg-0 tmp-mr-lg-3">
          <%= form_tag enterprise_notice_path(business, notice: BusinessesHelper::TRIAL_ONBOARDING_NOTICE_NAME),
            method: :delete,
            class: "js-notice-dismiss", id: "dismiss-onboard" do %>
            <%= render Primer::Beta::Button.new(
              scheme: :link,
              type: :submit,
              classes: "Link--secondary",
              size: :small,
              data: {
                **analytics_click_attributes(
                  category: "enterprise_trial_account",
                  action: "dismiss_guidance_component",
                  label: "enterprise_id:#{business.id};location:completed_guidance")
              }
            ) do %>
              I'll continue the trial on my own
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>
