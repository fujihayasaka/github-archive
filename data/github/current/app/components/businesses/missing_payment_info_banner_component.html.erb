<%= render(Primer::Alpha::Banner.new(full: true, scheme: :warning, icon: :alert)) do |component| %>
  <span class="text-bold">
    Payment information required
  </span>
  <br>
  <span>
    <% if !business.feature_enabled?(:billing_cpwu_account_downgrade) %>
      Please update your payment method to avoid interruption of service.
    <% elsif business_disabled? %>
      Add a payment method to restore services.
    <% else %>
      Update your payment method by <%= disable_target_date.to_formatted_s(:long) %> to avoid interruption of services.
    <% end %>
    <%= link_to 'Learn more about updating your payment information.', helpers.docs_url("billing/managing-your-payment-and-billing-information", ghec: true), class: "Link--inTextBlock" %>
  </span>

  <% component.with_action_content do %>
    <%= render Primer::Beta::Button.new(
      size: :small,
      tag: :a,
      href: settings_billing_tab_enterprise_path(business, tab: :payment_information)
    ) do %>
      Update payment method
    <% end %>
  <% end %>
<% end %>
<% instrument %>
