<div class="tmp-mt-6">
  <%= render(Primer::Beta::Subhead.new(
    mb: 1,
    border: false,
    test_selector: "enterprise-explore-more"
  )) do |subhead| %>
    <% subhead.with_heading(tag: :h2) do %>
      Explore more
    <% end %>
  <% end %>
  <div class="d-flex flex-wrap flex-column flex-md-row">

    <div class="rounded-2 flex-1 tmp-p-3 border color-border-muted tmp-mb-3 tmp-mb-md-0">
      <div class="d-flex flex-items-center flex-justify-center color-bg-subtle circle avatar-5 tmp-mb-3">
        <%= render Primer::Beta::Octicon.new(icon: :telescope, color: :muted) %>
      </div>
      <p class="f5 text-bold color-fg-default mb-1">Enterprise changelog</p>
      <div class="d-block overview-box f6 color-fg-muted" style="min-height: 48px;">
        <% if GitHub.single_business_environment? %>
          View the GitHub Enterprise Server release notes to stay updated on everything we ship.
        <% else %>
          Visit the Enterprise changelog to stay updated on everything we ship.
        <% end %>
      </div>
      <% if GitHub.single_business_environment? %>
        <%= render(Primer::Beta::Link.new(
          href: "#{GitHub.enterprise_admin_help_url}/release-notes",
          classes: "Link--inTextBlock",
          test_selector: "ghes-release-notes-link"
        )) { "View the GitHub Enterprise Server release notes" } %>
      <% else %>
        <%= render(Primer::Beta::Link.new(
          href: "https://github.blog/changelog/label/enterprise/",
          classes: "Link--inTextBlock",
          test_selector: "changelog-link"
        )) { "Visit Enterprise changelog" } %>
      <% end %>
    </div>

    <div class="overview-box rounded-2 flex-1 tmp-p-3 tmp-mx-md-3 border color-border-muted tmp-mb-3 tmp-mb-md-0">
      <div class="d-flex flex-items-center flex-justify-center color-bg-subtle circle avatar-5 tmp-mb-3">
        <%= render Primer::Beta::Octicon.new(icon: :comment, color: :muted) %>
      </div>
      <p class="f5 text-bold color-fg-default mb-1">GitHub Support</p>
      <div class="d-block f6 color-fg-muted" style="min-height: 48px;">
        Visit GitHub Support to browse resources, and contact support.
      </div>
      <%= render(Primer::Beta::Link.new(
        href: GitHub.enterprise_support_link,
        classes: "Link--inTextBlock",
        test_selector: "support-link"
      )) { "Visit GitHub Support" } %>
    </div>

    <div class="overview-box rounded-2 flex-1 tmp-p-3 border color-border-muted tmp-mb-3 tmp-mb-md-0">
      <% if GitHub.single_business_environment? %>
        <div class="d-flex flex-items-center flex-justify-center color-bg-subtle circle avatar-5 tmp-mb-3">
          <%= render(Primer::Beta::Octicon.new(icon: :book, color: :muted)) %>
        </div>
        <p class="f5 text-bold color-fg-default mb-1">Documentation</p>
        <div class="d-block f6 color-fg-muted" style="min-height: 48px;">
          Search and view documentation for your version of GitHub Enterprise Server.
        </div>
        <%= render(Primer::Beta::Link.new(
            href: GitHub.enterprise_help_landing_page,
            classes: "Link--inTextBlock",
            test_selector: "ghes-help-link"
          )) { "Visit documentation" } %>
      <% else %>
        <% if show_onboarding_experience?(business) %>
          <div class="d-flex flex-items-center flex-justify-center color-bg-subtle circle avatar-5 tmp-mb-3">
            <%= render(Primer::Beta::Octicon.new(icon: :"check-circle", color: :muted)) %>
          </div>
          <p class="f5 text-bold color-fg-default mb-1">Getting started</p>
          <div class="d-block f6 color-fg-muted" style="min-height: 48px;">
            Get started with suggested tasks that most successful enterprises complete.
          </div>
          <%= render(Primer::Beta::Link.new(
            href: enterprise_getting_started_path(business),
            classes: "Link--inTextBlock",
            test_selector: "suggested-tasks-link"
          )) { "Get started with suggested tasks" } %>
        <% else %>
          <% if onboarding_experience_dismissed? %>
            <div class="d-flex flex-items-center flex-justify-center color-bg-subtle circle avatar-5 tmp-mb-3">
              <%= render(Primer::Beta::Octicon.new(icon: :"check-circle", color: :muted)) %>
            </div>
            <p class="f5 text-bold color-fg-default mb-1">Getting started</p>
            <div class="d-block f6 color-fg-muted" style="min-height: 48px;">
              Get started with suggested tasks that most successful enterprises complete.
            </div>
            <%= form_tag enterprise_onboarding_tasks_path(business), method: :patch do %>
              <input type="hidden" name="notice_name" value="<%= reset_onboarding_notice_name %>">
              <%= render(Primer::Beta::Button.new(
                scheme: :link,
                type: :submit,
                classes: "Link--inTextBlock",
                test_selector: "reset-suggested-tasks-button",
              )) { "Get started with suggested tasks" } %>
            <% end %>
          <% else %>
            <div class="d-flex flex-items-center flex-justify-center color-bg-subtle circle avatar-5 tmp-mb-3">
              <%= render(Primer::Beta::Octicon.new(icon: :book, color: :muted)) %>
            </div>
            <p class="f5 text-bold color-fg-default mb-1">Documentation</p>
            <div class="d-block f6 color-fg-muted" style="min-height: 48px;">
              Search and view documentation for GitHub Enterprise.
            </div>
            <%= render(Primer::Beta::Link.new(
                href: GitHub.help_url(ghec_exclusive: true),
                classes: "Link--inTextBlock",
                test_selector: "cloud-help-link"
              )) { "Visit documentation" } %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
