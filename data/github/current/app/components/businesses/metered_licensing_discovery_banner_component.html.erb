<%= render Primer::Alpha::Banner.new(
  scheme: :default,
  full: true,
  mb: 4,
  dismiss_scheme: :remove,
  style: "position: relative; height: 110px; background: linear-gradient(to left, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.4) 30%, rgba(255, 255, 255, 1) 75%), url('#{image_path('cropped_banner.jpeg')}'); background-size: cover; background-position: center; background-repeat: no-repeat; color: white; border: 1px solid #D0D7DE; border-radius: 6px; padding: 16px;"
) do |banner| %>
  <style>
    /* Next 5 lines hid bell icon that comes w/ primer */
    .Banner-icon:not(.Banner-dismissButton),
    .Banner .Banner-icon:not(.Banner-dismissButton),
    .octicon-bell,
    .Banner .octicon-bell {
      display: none !important;
    }
  </style>
  <div class="d-flex flex-justify-between flex-items-center">
    <div class="flex-1" style="margin-left: -16px;">
      <% if metered_amount_saved == 0 %>
        <p class="mb-2" style="color: #24292E; font-weight: 600; font-size: 20px;">
          New! Metered billing is here.
        </p>
        <p class="mb-0" style="color: #656D76; font-size: 14px; font-weight: 250;">
          Only pay for the Enterprise licenses you actually use. You could save by switching today.
        </p>
      <% else %>
        <p class="mb-2" style="color: #24292f; font-weight: 500; font-size: 19px;">
          Save an estimated $<%= number_with_delimiter(metered_amount_saved) %> when you switch to metered billing
        </p>
        <p class="mb-0" style="color: #656d76; font-size: 14px; font-weight: 250;">
          Only pay for the Enterprise licenses you actually use, scale at your own pace, and view usage in one place.
        </p>
      <% end %>
    </div>
    <div class="d-flex flex-items-center ml-4">
      <%= render Primer::Beta::Button.new(
        scheme: :default,
        size: :medium,
        classes: !business.metered_plan? ? "mr-2" : "",
        tag: :a,
        href: "https://gh.io/transition-to-metered"
      ) do %>
        Learn more
      <% end %>
      <%= render Primer::Beta::Button.new(
        scheme: :primary,
        size: :medium,
        tag: :a,
        href: edit_multi_checkout_enterprise_path(business, volume_to_metered: true)
      ) do %>
        Get started
      <% end %>
    </div>
  </div>
<% end %>
