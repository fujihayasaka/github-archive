<%= render Primer::Alpha::Banner.new(
  scheme: :default,
  full: true,
  mb: 4,
  data: { test_selector: "metered-licensing-discovery-banner" },
  classes: "metered-banner",
  style: "position: relative; background-size: cover; background-position: center; background-repeat: no-repeat; color: var(--fgColor-onEmphasis, var(--color-fg-on-emphasis)); border: 1px solid var(--borderColor-default, var(--color-border-default)); border-radius: 6px; padding: 16px;"
) do |banner| %>
  <% banner.with_action_content do %>
    <%= form_tag(dismiss_metered_licensing_discovery_banner_enterprise_licensing_path(business), method: :post) do %>
      <%= render(Primer::Beta::CloseButton.new(type: :submit, style: "margin-left: 8px; margin-right: 8px;", aria: { label: "Dismiss metered transition banner" })) %>
    <% end %>
  <% end %>
  <style>
    /* Hide bell icon that comes w/ primer */
    .Banner-icon:not(.Banner-dismissButton),
    .Banner .Banner-icon:not(.Banner-dismissButton),
    .octicon-bell,
    .Banner .octicon-bell {
      display: none !important;
    }

    /* Base banner styling */
    .metered-banner {
      background-color: var(--bgColor-default);
      position: relative;
      overflow: hidden;
      border-radius: 6px;
    }

    /* Background image container with fade overlay */
    .metered-banner-image {
      position: absolute;
      top: -24px;
      left: -40px;
      z-index: 1;
      width: calc(100% + 100px);
      height: calc(100% + 50px);
      border-radius: 6px;
      overflow: hidden;
    }

    .metered-banner-image img,
    .metered-banner-image picture {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      border-radius: 6px;
    }

    /* Ensure banner content appears above background image */
    .metered-banner .d-flex, .flex-1 {
      position: relative;
      z-index: 2;
    }

    /* Ensure dismiss button appears above background image */
    .metered-banner .Banner-dismissButton,
    .metered-banner .Banner-action,
    .metered-banner form,
    .metered-banner .CloseButton {
      position: relative !important;
      z-index: 10 !important;
    }

  </style>



  <div class="d-flex flex-column flex-lg-row flex-justify-between flex-items-center">
    <div class="flex-1" style="margin-left: -16px;">
      <p class="mb-2" style="color: var(--fgColor-default, var(--color-fg-default)); font-weight: 600; font-size: 20px;">
        New! Metered billing is here.
      </p>
      <p class="mb-0" style="color: var(--fgColor-muted, var(--color-fg-muted)); font-size: 14px; font-weight: 250;">
        Only pay for the Enterprise licenses you actually use, scale at your own pace, and view usage in one place.
      </p>
    </div>
    <div class="d-flex flex-items-center ml-4 pt-4 pt-lg-0">
      <%= render Primer::Beta::Button.new(
        scheme: :default,
        size: :medium,
        classes: !business.metered_plan? ? "mr-2" : "",
        tag: :a,
        href: "https://gh.io/transition-to-metered"
      ) do %>
        Learn more
      <% end %>
      <%= render Primer::Beta::Button.new(
        scheme: :primary,
        size: :medium,
        tag: :a,
        href: edit_multi_checkout_enterprise_path(business, volume_to_metered: true)
      ) do %>
        Get started
      <% end %>
    </div>

    <div class="metered-banner-image">
      <%= light_or_dark_picture_tag('cropped_banner.jpg', 'cropped_banner_dark.jpg',
        alt: '',
        class: 'metered-banner-bg'
      ) %>
    </div>

  </div>
<% end %>
