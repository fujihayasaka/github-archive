<li class="d-flex border border-top-0 p-3 js-bulk-actions-item flex-row flex-wrap <%= classes %>" style="min-width: 100%"
  data-bulk-actions-id="<%= bulk_id %>"
  <%= test_selector "business-user-list-card" %>>
  <div class="d-flex flex-items-start flex-1">
    <% if owner_actor && bulk_action_enabled && !bulk_id.blank? && bulk_attribute.present? %>
      <div <%= test_selector "bulk-actions-wrapper" %> class="table-list-cell-checkbox py-3 v-align-middle pr-3">
        <% if bulk_action_prevent_selection %>
          <input type="checkbox" disabled class="js-bulk-actions-toggle" aria-label="<%= accessible_member_label %>">
        <% else %>
          <input type="checkbox" name="<%= bulk_attribute %>[]" value="<%= user || primary_name %>" aria-label="<%= accessible_member_label %>" class="js-bulk-actions-toggle" data-check-all-item>
        <% end %>
      </div>
    <% end %>
    <div class="d-flex flex-items-center flex-wrap">
      <% if user %>
        <% if user_link %>
          <%= link_to user_link, class: "text-bold", data: user_link_data_options do %>
            <%= helpers.business_user_avatar(user, 48, class: "avatar mr-3") %>
          <% end %>
        <% else %>
          <%= helpers.business_user_avatar(user, 48, class: "avatar mr-3") %>
        <% end %>
      <% elsif octicon %>
        <div class="d-flex flex-items-center flex-justify-center mr-3 color-fg-muted border" style="margin-left:29px; width: 48px; height: 48px; border-radius: 50%; background-color: var(--bgColor-muted, var(--color-canvas-subtle));">
          <%= primer_octicon(octicon, height: 24, width: 24, color: :muted) %>
        </div>
      <% end %>

      <div class="d-flex flex-column">
        <div class="d-flex f4 flex-wrap">
          <% if user_link %>
            <%= link_to user_link, class: "text-bold", id: "user-#{display_login}", data: user_link_data_options do %>
              <%= primary_name %>
            <% end %>
          <% else %>
            <span <%= test_selector "primary_text_field" %> class="text-bold"><%= primary_name %></span>
          <% end %>
          <% if secondary_name %>
            <span class="ml-1 color-fg-muted"><%= secondary_name %></span>
          <% end %>
          <% if spammy %>
            <span class="ml-2">
              <%= render "shared/under_review_label" %>
            </span>
          <% end %>
          <% if is_first_emu_owner? %>
            <span class="ml-2">
              <%= render Primer::Beta::Label.new(tag: :span, scheme: :primary, title: "Label: Setup user") do %>
                Setup user
              <% end %>
            </span>
          <% end %>
        </div>

        <% if subtitle %>
          <div class="color-fg-muted">
            <%= subtitle %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= content %>
</li>
