<div class="<%= banner_color %> d-md-flex flex-items-center flex-justify-between py-2 px-5 h6 border-bottom" <%= test_selector("metered-billing-transition-banner") %>>
  <div class="d-flex flex-items-center flex-justify-between flex-md-justify-start">
    <div class="d-block mr-2 <%= text_color %>">
      <span style="<%= font_weight %>">
        <%= render(Primer::Beta::Octicon.new(icon: "info", size: :small, color: text_color_symbol, mr: 2)) %>
        Your account will switch to metered billing on <%= transition_date %>.
      </span>
      <% unless Date.current == transition.transition_date %>
        <span class="ml-2 text-normal">
          You can still <%= render Primer::Alpha::Dialog.new(id: "cancel-transition-dialog", title: "Cancel metered billing transition") do |dialog| %>
            <% dialog.with_show_button(scheme: :link) { "cancel" } %>
            <% dialog.with_body do %>
              Are you sure you want to cancel the transition to metered billing?
            <% end %>
            <% dialog.with_footer do %>
              <%= form_tag cancel_licensing_model_transition_enterprise_licensing_path(@business), method: "put" do %>
                <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary) do %>Cancel transition<% end %>
              <% end %>
            <% end %>
          <% end %> until <%= cancellation_deadline %>.
        </span>
      <% end %>
    </div>
  </div>
  <div class="d-none d-md-flex flex-items-center flex-shrink-0">
    <%= render(Primer::Beta::Link.new(
      href: "https://docs.github.com/en/enterprise-cloud@latest/billing/managing-your-billing/about-usage-based-billing-for-licenses",
      target: "_blank",
      rel: "noopener noreferrer",
      classes: "btn btn-sm btn-secondary ml-2"
    )) { "Learn more" } %>
  </div>
</div>
