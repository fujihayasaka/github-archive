<% if business.feature_enabled?(:digital_front_door_getting_started) && business.trial? %>
  <%= render(Businesses::GettingStarted::TrialGettingStartedComponent.new(business: business)) %>
<% else %>
  <%= render(Businesses::OverviewReadmeComponent.new(
    business: business,
  )) %>

  <%= render(Businesses::EnterpriseExploreMoreComponent.new(
    business: business,
  )) %>
<% end %>
