<% if business.feature_flag_enabled?(:digital_front_door_getting_started, default: false) && business.trial? && business.dfd_trial? %>
  <% if first_emu_owner? %>
    <%= render(Businesses::EmuFirstAdminGettingStartedComponent.new(business: business)) %>
  <% elsif business.owner?(current_user) %>
    <%= render(Businesses::GettingStarted::TrialGettingStartedComponent.new(business: business, user_session: user_session)) %>
  <% else %>
    <% if business.feature_flag_enabled?(:copilot_business_user_assignment, default: false) && Copilot::Business.new(business).has_seat_for?(current_user) %>
      <%= render(Businesses::CopilotGettingStartedComponent.new(
        business: business,
        dfd_trial: true
      )) %>
    <% end %>
    <%= render(Businesses::OverviewReadmeComponent.new(
      business: business,
    )) %>
  <% end %>
<% else %>
  <%= render(Businesses::OverviewReadmeComponent.new(
    business: business,
  )) %>

  <%= render(Businesses::EnterpriseExploreMoreComponent.new(
    business: business,
  )) %>
<% end %>
