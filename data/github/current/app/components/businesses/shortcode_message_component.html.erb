<span <%= test_selector "shortcode-message" %>>
  <%= link_to "What is a username shortcode?", "#{GitHub.help_url}/admin/managing-iam/iam-configuration-reference/username-considerations-for-external-authentication#about-usernames-for-managed-user-accounts" %>
  <% if already_taken? %>
    <strong>'<%= shortcode.presence %>'</strong> is already taken.
  <% elsif error_message.present? %>
    <%= error_message %>
  <% else %>
    Members of this enterprise will be created with login handles like <strong>monalisa_<%= shortcode.presence %></strong>.
  <% end %>
</span>
