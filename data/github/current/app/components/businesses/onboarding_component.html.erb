<div <%= test_selector("enterprise-business-onboarding-component") %> >
  <% if display_header? %>
    <% if show_digital_front_door_header? %>
      <div <%= test_selector("business-onboarding-welcome-header-dfd") %> data-hpc>
        <h1>Welcome to your free 30 day trial!</h1>

        <p class="f5 color-fg-muted">
          Your trial includes access to GitHub Copilot, Enterprise, and Advanced Security. Your
          enterprise account allows you to centrally manage multiple organizations, licenses, and
          the security for your entire company. GitHub is here to help you get set up, onboard your
          developers, and start putting your ideas into production.
        </p>

        <h2 class="my-2">
          <%= render Primer::Beta::Octicon.new(:calendar) %>
          Your trial is active until <%= business.trial_expires_at.strftime("%b %e, %Y") %>
        </h2>

        <p class="f5 color-fg-muted">
          While your trial is still active for 30 days, you can end your trial at any time and
          convert to a paid account. You’ll be able to choose to continue with Copilot and Advanced
          Security when activating your Enterprise.
        </p>
        <div class="d-flex flex-row flex-wrap mb-5">
          <div class="d-lg-flex flex-items-center">
            <% unless business.trial_conversion_initiated? %>
              <div class="mb-3 mb-lg-0 mr-lg-3">
                <%= render Primer::Beta::Button.new(
                  type: :button,
                  scheme: :primary,
                  tag: :a,
                  href: "#{billing_upgrade_enterprise_path(business)}",
                  test_selector: "activate-paid-enterprise-button",
                  data: {
                    **analytics_click_attributes(
                      category: "enterprise_trial_account",
                      action: "buy_enterprise",
                      label: "enterprise_id:#{business.id};location:getting_started_page;content:#{buy_enterprise_flavor(short: true).parameterize.underscore}")
                  }
                ).with_content(buy_enterprise_flavor(short: true)) %>
              </div>
            <% end %>
            <div class="mb-3 mb-lg-0 mr-lg-3">
              <% environment = GitHub.multi_tenant_enterprise? ? "proxima" : "dotcom" %>
              <%= render Primer::Beta::Link.new(
                font_weight: :bold,
                underline: :true,
                href: "https://github.com/enterprise/contact?utm_source=github&utm_medium=site&utm_campaign=enterprise_cloud_trial_banner_cta",
                data: {
                  **analytics_click_attributes(
                    category: "enterprise_trial_account",
                    action: "talk_to_us",
                    label: "enterprise_id:#{business.id};enterprise_slug:#{business.slug};location:getting_started_page;environment:#{environment}")
                }
              ).with_content("Talk to us") %>
            </div>
          </div>
        </div>
        <h2 class="mb-5">Next steps</h2>

        <h3 class="h5 lh-condensed mb-2">Get started with Copilot</h3>
        <div class="mb-4">
          <% if business.authenticated_through_digital_front_door? %>
            <%= render Primer::Alpha::Banner.new(
              icon: :info,
              mb: 2,
              test_selector: "verified-identity-banner",
              dismiss_scheme: :remove
            ) do %>
              Your identity has been successfully verified. You may see a temporary authorization
              charge on your payment method, but will not be charged for this trial.
            <% end %>
            <p class="f5 color-fg-muted">
              Review the
              <%= link_to "Copilot documentation", "#{GitHub.help_url}/copilot", target: :_blank, class: "Link--inTextBlock" %>
              to learn how to use Copilot to write code, commit changes, and more. When you're ready,
              <% if business.organizations.any? %>
                choose which organizations and teams have access to start using
              <% else %>
                <%= link_to "create your first organization", new_enterprise_organization_path(business), class: "Link--inTextBlock" %>
                and begin assigning them access to
              <% end %>
              Copilot by modifying your enterprise's
              <%= link_to "access management policies", settings_copilot_enterprise_path(business), class: "Link--inTextBlock" %>.
            </p>
          <% else %>
            <% if business.digital_front_door_authorization_sent? %>
              <p class="f5 color-fg-muted">
                Access to Copilot benefits is in-progress, pending identity verification via payment
                method. You will not be charged during or at the end of your trial, but may see a
                temporary authorization charge.
              </p>
              <h3 class="h5 lh-condensed">
                <%= render Primer::Beta::Octicon.new(:clock) %> Authorization pending
              </h3>
            <% else %>
              <p class="f5 color-fg-muted">
                You can activate Copilot Business for free during your trial by verifying your identity with a payment method. Your payment method will not be automatically charged at the end of the trial.
              </p>
              <div class="d-flex flex-row flex-wrap mb-5">
                <div class="d-lg-flex flex-items-center">
                  <div class="mb-3 mb-lg-0 mr-lg-3">
                    <%= render Primer::Beta::Button.new(
                      type: :button,
                      scheme: :secondary,
                      tag: :a,
                      href: enterprise_trial_activations_path(business),
                      test_selector: "verify-your-identity-button"
                    ).with_content("Verify your identity") %>
                  </div>
                  <div class="mb-3 mb-lg-0 mr-lg-3">
                    <%= render Primer::Beta::Link.new(
                      font_weight: :bold,
                      underline: :true,
                      href: ent_contact_url
                    ).with_content("Contact sales") %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
        <h3 class="h5 lh-condensed mb-2">Get started with Advanced security</h3>
        <p class="f5 color-fg-muted">
          Explore the
          <%= link_to "Advanced Security documentation", helpers.docs_url("get-started/about-github-advanced-security"), target: :_blank, class: "Link--inTextBlock" %>
          to understand how to leverage Advanced Security for identifying and resolving security
          vulnerabilities in your code. Once you're ready, configure which organizations can
          utilize Advanced Security by updating your enterprise's
          <%= link_to "code security policies", settings_security_analysis_policies_enterprise_path(business), class: "Link--inTextBlock" %>.
        </p>
      </div>
    <% else %>
      <div class="d-lg-flex flex-items-start" <%= test_selector("business-onboarding-welcome-header") %> data-hpc>
        <div>
          <h1 class="mb-2">Welcome to your enterprise account</h1>

          <p class="f5 color-fg-muted">
            GitHub Enterprise's administrative tools keep your account secure, compliant, and meet your company where you are.
            Your enterprise account allows you to centrally manage multiple organizations, licenses, and the security for your entire company.
            GitHub is here to help you get set up, onboard your developers, and start putting your ideas into production.
          </p>
        </div>
      </div>
    <% end %>
  <% end %>
  <% if emu_first_admin? %>
    <%= render Businesses::EmuFirstAdminGettingStartedComponent.new(business: business), layout: false %>
  <% elsif business.seats_plan_basic? %>
    <%= render Businesses::CopilotGettingStartedComponent.new(business: business), layout: false %>
  <% elsif business.trial? %>
    <%= render partial: "businesses/onboarding_tasks/tasks", locals: {
      this_business: business,
      show_digital_front_door_header: show_digital_front_door_header?
    } %>
  <% elsif business.upgraded_from_organization? %>
    <%= render partial: "businesses/onboarding_tasks/org_upgrade_tasks", locals: { this_business: business } %>
  <% end %>
</div>
