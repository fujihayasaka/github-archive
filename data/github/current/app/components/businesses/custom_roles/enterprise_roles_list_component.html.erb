<%= render(Primer::BaseComponent.new(tag: :div, test_selector: "enterprise-roles-list-component", **system_arguments)) do %>
  <div class="border rounded-2 d-flex flex-column">
    <div class="color-bg-subtle p-3 rounded-top-2 border-bottom">
      <%= render(Primer::Beta::Text.new(font_size: :normal, font_weight: :bold)) { pluralize(custom_roles.size, "custom role") } %>
    </div>
    <% if custom_role_limit_reached? %>
      <%= render(Primer::Alpha::Banner.new(scheme: :default, icon: :info, mv: 2, full: true, test_selector: "limit-banner")) do %>
        Reached max of <%= custom_role_limit %> custom <%= "role".pluralize(custom_role_limit) %>
      <% end %>
    <% end %>
    <% if custom_roles.any? %>
      <div <%= test_selector "enterprise-roles-list" %>>
        <% custom_roles.each_with_index do |custom_role, idx| %>
          <div class="<%= "border-top" unless idx == 0 %>">
            <%= render(CustomRoles::ExpandableRoleRowComponent.new(role: custom_role)) do |row| %>
              <% if viewer_permissions[:write] %>
                <% row.with_action do %>
                  <%= render(CustomRoles::ActionMenuComponent.new(
                    role_id: custom_role.id,
                    role_name: custom_role.name,
                    role_user_count: role_user_count(custom_role),
                    role_team_count: role_team_count(custom_role),
                    delete_path: enterprise_role_path(business, custom_role),
                    edit_path: edit_enterprise_role_path(business, custom_role),
                    viewer_permissions: viewer_permissions,
                    test_selector: "enterprise-role-action-menu",
                  )) %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render(Primer::Box.new(p: 5, display: :flex, direction: :column, align_items: :center, test_selector: "enterprise-roles-empty-state")) do %>
        <%= render(Primer::Beta::Octicon.new(icon: :note, size: :medium, color: :muted, mb: 3)) %>
        <%= render(Primer::Beta::Text.new(font_size: 3, font_weight: :bold)) { "You do not have any custom roles yet" } %>
      <% end %>
    <% end %>
  </div>
<% end %>
