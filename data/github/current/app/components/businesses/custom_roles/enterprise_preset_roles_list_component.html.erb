<%= render(Primer::BaseComponent.new(tag: :div, test_selector: "enterprise-preset-roles-list-component", **system_arguments)) do %>
  <div class="d-flex flex-column border rounded-2" <%= test_selector "enterprise-preset-roles-list" %>>
    <% preset_roles.each_with_index do |role, index| %>
      <div class="<%= "border-top" unless index == 0 %>">
        <%= render CustomRoles::ExpandableRoleRowComponent.new(role:) %>
      </div>
    <% end %>
  </div>
<% end %>
