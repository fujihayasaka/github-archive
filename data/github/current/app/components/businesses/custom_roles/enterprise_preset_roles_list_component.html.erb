<%= render(Primer::BaseComponent.new(tag: :div, test_selector: "enterprise-preset-roles-list-component", **system_arguments)) do %>
  <div class="d-flex flex-column border rounded-2" <%= test_selector "enterprise-preset-roles-list" %>>
    <% preset_roles.each_with_index do |role, index| %>
      <div class="<%= "border-top" unless index == 0 %>">
        <%= render(CustomRoles::ExpandableRoleRowComponent.new(role:)) do |component| %>
          <% if role.enterprise_security_manager? %>
            <% component.with_description_prefix do %>
              <div class="d-flex gap-1">
                <%= render(CustomRoles::RoleAvatarSpreadComponent.new) do |component| %>
                  <% organizations_representing_all.each do |organization| %>
                    <% component.with_avatar(actor: organization) %>
                  <% end %>
                <% end %>
                <%= render(Primer::Beta::Text.new(color: :default, classes: "no-wrap")) { "Grants access to all organizations" } %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
