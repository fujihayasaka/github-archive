<billing-cycle <%= test_selector "business-billing-cycle" %>>
  <div class="Box mt-4">
    <div class="Box-row d-flex flex-items-stretch border-top-0">
      <div class="flex-auto">
        <h2 class="mb-1">Billing Cycle</h2>
        <div class="text-normal color-fg-muted mt-2">
          This enterprise is <b>billed <%= plan_type %></b>.
          <br>
          The next billing date is <%= next_bill_date %>
        </div>
      </div>
      <div>
        <% if yearly? %>
          <%= render Primer::Beta::Button.new(
            size: :medium,
            href: change_duration_path,
            tag: :a,
          ) do %>
            Switch to monthly billing
          <% end %>
        <% else %>
          <%= render Primer::Beta::Label.new(
            scheme: :accent,
            mr: 1
          ).with_content("Get 1 month free") %>
          <%= render Primer::Beta::Button.new(
            size: :medium,
            href: change_duration_path,
            tag: :a,
          ) do %>
            Switch to yearly billing
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</billing-cycle>
