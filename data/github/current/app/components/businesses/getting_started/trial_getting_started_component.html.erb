<div <%= test_selector("dfd-getting-started") %>>
  <h1>Welcome to your free 30 day trial!</h1>

  <p class="f5 color-fg-muted">
    You’ve unlocked GitHub Enterprise, explore the top features like Copilot and Advanced Security.
  </p>

  <div class="mb-3" <%= test_selector("dfd-getting-started-tasks") %>>
    <% if add_members_tasks.any? %>
      <div <%= test_selector("business-getting-started-add-members") %>>
        <h2 class="mb-2 color-fg-muted">Add members</h2>
        <% add_members_tasks.each do |task| %>
          <%= render Businesses::GettingStarted::TaskComponent.new(business: business, task: task) %>
        <% end %>
      </div>
    <% end %>

    <% if copilot_tasks.any? %>
      <div <%= test_selector("business-getting-started-copilot") %>>
        <h2 class="mb-2 color-fg-muted">Copilot</h2>
        <% copilot_tasks.each do |task| %>
          <%= render Businesses::GettingStarted::TaskComponent.new(business: business, task: task) %>
        <% end %>
      </div>
    <% end %>

    <% if security_tasks.any? %>
      <div <%= test_selector("business-getting-started-security") %>>
        <h2 class="mb-2 color-fg-muted">Security</h2>
        <% security_tasks.each do |task| %>
          <%= render Businesses::GettingStarted::TaskComponent.new(business: business, task: task) %>
        <% end %>
      </div>
    <% end %>

    <% if further_setup_tasks.any? || !business.trial_with_readme? %>
      <div <%= test_selector("business-getting-started-further-setup") %>>
        <h2 class="mb-2 color-fg-muted">Further Enterprise setup</h2>
        <% further_setup_tasks.each do |task| %>
          <%= render Businesses::GettingStarted::TaskComponent.new(business: business, task: task) %>
        <% end %>

        <% unless business.trial_with_readme? %>
          <div class="d-flex border rounded-2 p-3 mb-3 js-readme-task-button cursor-pointer" <%= test_selector("create-readme-task") %>>
            <div class="d-flex flex-items-center mr-2">
              <div class="d-flex dfd-circle-icon icon-green" <%= test_selector("green-icon-color") %>>
                <%= render Primer::Beta::Octicon.new(:book, classes: "fgColor-open") %>
              </div>
            </div>
            <div>
              <h3 class="h3 fgColor-default">Write a README</h3>
              <p class="f5 fgColor-default">
                Help your team get started with your Enterprise setup. Share key guidelines, and best practices, all in one place.
              </p>
            </div>
          </div>
        <% end %>

        <div class="comment-form-wrapper js-readme-form" hidden>
          <%= form_tag(
            enterprise_long_description_path(business),
            method: :patch,
            class: "previewable-comment-form js-comment-update",
            data: {
              "body-version" => "1",
              "turbo" => "false"
            }
          ) do %>
            <div <%= test_selector "editable-readme" %>>
              <%= render(Comments::PreviewableCommentFormComponent.new(
                body: business.long_description,
                textarea_id: "long_description_input_value",
                field_name: "business[long_description]",
                placeholder: "Let everyone know what this enterprise is about, how to use it, and link to important resources.",
                allow_attachments: false,
                hide_saved_replies: true,
                hide_mentions: true,
                hide_cross_references: true,
                subject: business,
                required: false
              )) %>
            </div>
            <div class="mt-3 mb-8">
              <%= render(Primer::Beta::Button.new(
                scheme: :primary,
                float: [:none, nil, :right],
                ml: 2,
                type: :submit,
                "data-disable-with": "Saving…",
                "aria-label": "Save"
              )) { "Save" } %>
              <%= render(Primer::Beta::Button.new(
                scheme: :danger,
                float: [:none, nil, :right],
                classes: "js-comment-cancel-button",
                data: {
                  "confirm-text": "Are you sure you want to discard your unsaved changes?"
                },
                type: :button
              )) { "Cancel" } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Completed Tasks %>
    <% if completed_tasks.any? || business.trial_with_readme? %>
      <div class="getting-started-completed-tasks" <%= test_selector("business-getting-started-completed-tasks") %>>
        <h2 class="mb-2 color-fg-muted">Completed tasks</h2>
        <% completed_tasks.each do |task| %>
          <%= render Businesses::GettingStarted::TaskComponent.new(business: business, task: task) %>
        <% end %>

        <% if business.trial_with_readme? %>
          <div class="js-comment" <%= test_selector "readme-container" %>>
            <div class="comment-body p-0">
              <%= render(Primer::Beta::BorderBox.new) do |box| %>
                <% box.with_row(display: :flex, justify_content: :space_between, align_items: :center) do %>
                  <div class="text-semibold">
                    <%= render Primer::Beta::Octicon.new(icon: :book, mr: 2) %>
                    README
                  </div>
                  <div>
                    <% if business.owner?(current_user) %>
                      <%= render(Primer::Beta::Button.new(
                        classes: "js-comment-edit-button",
                        test_selector: "edit-readme-button"
                      )) { "Edit" } %>
                    <% end %>
                  </div>
                <% end %>
                <% box.with_row(classes: "markdown-body") do %>
                  <%= business.long_description_html %>
                <% end %>
              <% end %>
            </div>
            <div class="comment-form-wrapper js-readme-form" hidden>
              <%= form_tag(
                enterprise_long_description_path(business),
                method: :patch,
                class: "previewable-comment-form js-comment-update",
                data: {
                  "body-version" => "1",
                  "turbo" => "false"
                }
              ) do %>
                <div <%= test_selector "editable-readme" %>>
                  <%= render(Comments::PreviewableCommentFormComponent.new(
                    body: business.long_description,
                    textarea_id: "long_description_input_value",
                    field_name: "business[long_description]",
                    placeholder: "Let everyone know what this enterprise is about, how to use it, and link to important resources.",
                    allow_attachments: false,
                    hide_saved_replies: true,
                    hide_mentions: true,
                    hide_cross_references: true,
                    subject: business,
                    required: false
                  )) %>
                </div>
                <div class="mt-3">
                  <%= render(Primer::Beta::Button.new(
                    scheme: :primary,
                    float: [:none, nil, :right],
                    ml: 2,
                    type: :submit,
                    "data-disable-with": "Saving…",
                    "aria-label": "Save"
                  )) { "Save" } %>
                  <%= render(Primer::Beta::Button.new(
                    scheme: :danger,
                    float: [:none, nil, :right],
                    classes: "js-comment-cancel-button",
                    data: {
                      "confirm-text": "Are you sure you want to discard your unsaved changes?"
                    },
                    type: :button
                  )) { "Cancel" } %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
