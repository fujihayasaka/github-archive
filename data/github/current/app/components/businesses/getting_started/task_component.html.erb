<% content = capture do %>
  <div class="d-flex border rounded-2 p-3 mb-3" <%= test_selector("#{task[:id]}-task") %>>
    <div class="d-flex flex-items-center mr-3">
      <div class="d-flex dfd-circle-icon icon-<%= task[:icon_color] %>" <%= test_selector("#{task[:icon_color]}-icon-color") %>>
        <%= render Primer::Beta::Octicon.new(task[:icon], classes: task[:icon_text_color_class]) %>
      </div>
    </div>
    <div>
      <h2 class="<%= task[:text_color_class] %>"><%= task[:title] %></h2>
      <p class="mb-0 f5 <%= task[:description_text_color_class] %>">
        <%= task[:description] %>
      </p>
    </div>
  </div>
<% end %>

<% if task[:link].present? %>
  <%= render Primer::Beta::Link.new(href: task[:link] || "#",
    data: analytics_click_attributes(
    category: "enterprise_trial_account",
    action: "getting_started_trial",
    label: "enterprise_id:#{business.id};user_id:#{current_user.id};location:getting_started_overview;content:#{task[:title]}",),
    classes: "Link--muted") do %>
    <%= content %>
  <% end %>
<% else %>
  <%= content %>
<% end %>
