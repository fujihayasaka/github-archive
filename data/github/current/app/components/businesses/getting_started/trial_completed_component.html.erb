<h1><%= header_text %></h1>

<p class="f5 color-fg-muted mt-2">
  Activate your paid Enterprise to continue using the <%= business.trial_expired? ? "Enterprise services." : "services without interruption." %>
</p>

<%= render Primer::Beta::Link.new(href: billing_upgrade_enterprise_path(business), classes: "Link--muted") do %>
  <div class="d-flex border rounded-2 p-3 mb-3 mt-4" <%= test_selector("activate-enterprise-task") %>>
    <div class="d-flex flex-items-center mr-2">
      <div class="d-flex dfd-circle-icon icon-<%= icon_color %>" <%= test_selector("#{icon_color}-icon-color") %>>
        <%= render Primer::Beta::Octicon.new(:organization, classes: "fgColor-#{org_icon_color}") %>
      </div>
    </div>
    <div>
      <h2 class="h3 fgColor-default">Activate paid Enterprise</h2>
      <p class="f5 color-fg-muted"><%= activation_description %>.</p>
    </div>
  </div>
<% end %>

<%= render Businesses::GettingStarted::ReadmeComponent.new(business: business, current_user: current_user) %>

<div class="d-flex flex-items-center mt-3 gap-3">
  <div class="flex-1 d-flex border rounded-2 p-3 mb-3">
    <div>
      <div class="d-flex dfd-circle-icon icon-yellow mb-1">
        <%= render Primer::Beta::Octicon.new(:"person-add", classes: "fgColor-attention") %>
      </div>
      <h2 class="h3 fgColor-default"><%= business.members.count %> members</h2>
      <p class="f5 color-fg-muted">Added to your Enterprise.</p>
    </div>
  </div>

  <% unless business.trial_expired? %>
    <div class="flex-1 d-flex border rounded-2 p-3 mb-3" <%= test_selector("copilot-suggestions-box") %>>
      <div>
        <div class="d-flex dfd-circle-icon icon-purple mb-1">
          <%= render Primer::Beta::Octicon.new(:copilot, classes: "fgColor-done") %>
        </div>
        <h2 class="h3 fgColor-default"><%= pluralize(copilot_suggestions_count, 'Copilot code suggestion') %></h2>
        <p class="f5 color-fg-muted">That were accepted by members.</p>
      </div>
    </div>
  <% end %>

  <div class="flex-1 d-flex border rounded-2 p-3 mb-3">
    <div>
      <div class="d-flex dfd-circle-icon icon-blue mb-1">
        <%= render Primer::Beta::Octicon.new(:shield, classes: "fgColor-accent") %>
      </div>
      <h2 class="h3 fgColor-default"><%= pluralize(secrets_found_count, 'secret') %> found</h2>
      <p class="f5 color-fg-muted">Preventing a security leak.</p>
    </div>
  </div>
</div>
