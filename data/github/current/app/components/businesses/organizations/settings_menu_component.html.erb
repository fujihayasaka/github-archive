<% menu_list = Primer::Alpha::ActionMenu::List.new \
  menu_id: "enterprise-org-#{@organization.id}-settings-menu",
  test_selector: "enterprise-org-#{@organization.id}-settings-menu" %>

<% if option_available?(:become_owner) %>
  <% menu_list.with_item(
    label: current_user_member_of_organization? ? "Change role to organization owner" : "Join organization as an owner",
    tag: :button,
    content_arguments: { "data-show-dialog-id": "org-#{@organization.id}-become-owner-dialog" },
    value: "",
    test_selector: "change-role-owner",
  ) %>

  <%= render(Primer::Alpha::Dialog.new(
    id: "org-#{@organization.id}-become-owner-dialog",
    title: current_user_member_of_organization? ? "Change role to organization owner" : "Join organization as an owner",
    size: show_scim_warning? ? :medium : :small,
  )) do |d| %>
    <% if !current_user_can_join_org? %>
      <%= render(Primer::Alpha::Dialog::Body.new) do %>
        <p <%= test_selector("user-cannot-join-org") %>>
          SAML is enforced for this organization. You must first join the organization as an
          organization member before using this feature. For more information on how to join the
          organization, see
          <a class="Link--inTextBlock" href="<%="#{GitHub.help_url}/organizations/managing-saml-single-sign-on-for-your-organization/about-identity-and-access-management-with-saml-single-sign-on#adding-members-to-an-organization-using-saml-sso" %>">
          this article</a>.
        </p>
      <% end %>
    <% else %>
      <%= form_tag business_owner_change_role_path(@organization), method: :patch do %>
        <input type="hidden" name="role" value="owner">
        <%= render(Primer::Alpha::Dialog::Body.new) do %>
          <p>
            Are you sure you want to
            <% if current_user_member_of_organization? %>
              change your role to organization owner in the <strong><%= @organization.safe_profile_name %></strong> organization?
            <% else %>
              join <strong><%= @organization.safe_profile_name %></strong> as an organization owner?
            <% end %>
          </p>
          <% if show_scim_warning? %>
            <%= render Primer::Alpha::Banner.new(scheme: :warning, test_selector: "scim-warning") do %>
              If SCIM provisioning is setup for an organization, any changes to a user's organization
              membership should be triggered from the Identity Provider side. If a user is invited
              manually to the organization and not by an existing SCIM integration, their user account
              may not get properly linked to their SCIM identity. This can prevent the user account
              from being deprovisioned via SCIM in the future.
            <% end %>
          <% end %>
        <% end %>

        <%= render(Primer::Alpha::Dialog::Footer.new) do %>
          <%= render(Primer::Beta::Button.new(
            data: { "close-dialog-id": "org-#{@organization.id}-become-owner-dialog" }
          )) { "Cancel" } %>
          <%= render Primer::Beta::Button.new(
            type: :submit,
            scheme: :primary,
            "data-disable-invalid": "",
            "data-disable-with": "",
            test_selector: "change-role-owner-button"
            ) do %>
            <% if current_user_member_of_organization? %>
              Change role
            <% else %>
              Join organization
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if option_available?(:become_member) %>
  <% menu_list.with_item(
    label: current_user_owner_of_organization? ? "Change organization role to member" : "Join organization as a member",
    tag: :button,
    content_arguments: { "data-show-dialog-id": "org-#{@organization.id}-become-member-dialog" },
    value: "",
    test_selector: "change-role-member",
  ) %>

  <%= render(Primer::Alpha::Dialog.new(
    id: "org-#{@organization.id}-become-member-dialog",
    title: current_user_owner_of_organization? ? "Change role to member" : "Join organization as a member",
    size: show_scim_warning? ? :medium : :small,
  )) do |d| %>
    <% if !current_user_can_join_org? %>
      <%= render(Primer::Alpha::Dialog::Body.new) do %>
        <p <%= test_selector("user-cannot-join-org") %>>
          SAML is enforced for this organization. You must first join the organization as an
          organization member before using this feature. For more information on how to join the
          organization, see
          <a class="Link--inTextBlock" href="<%="#{GitHub.help_url}/organizations/managing-saml-single-sign-on-for-your-organization/about-identity-and-access-management-with-saml-single-sign-on#adding-members-to-an-organization-using-saml-sso" %>">
          this article</a>.
        </p>
      <% end %>
    <% else %>
      <%= form_tag business_owner_change_role_path(@organization), method: :patch do %>
        <input type="hidden" name="role" value="direct_member">
        <%= render(Primer::Alpha::Dialog::Body.new) do %>
          <p>
            Are you sure you want to
            <% if current_user_owner_of_organization? %>
              change your role to a member in the <strong><%= @organization.safe_profile_name %></strong> organization?
            <% else %>
              join <strong><%= @organization.safe_profile_name %></strong> as a member?
            <% end %>
          </p>
          <% if show_scim_warning? %>
            <%= render Primer::Alpha::Banner.new(scheme: :warning, test_selector: "scim-warning") do %>
              If SCIM provisioning is setup for an organization, any changes to a user's organization
              membership should be triggered from the Identity Provider side. If a user is invited
              manually to the organization and not by an existing SCIM integration, their user account
              may not get properly linked to their SCIM identity. This can prevent the user account
              from being deprovisioned via SCIM in the future.
            <% end %>
          <% end %>
        <% end %>
        <%= render(Primer::Alpha::Dialog::Footer.new) do %>
          <%= render(Primer::Beta::Button.new(
            data: { "close-dialog-id": "org-#{@organization.id}-become-member-dialog" }
          )) { "Cancel" } %>
          <%= render Primer::Beta::Button.new(
            type: :submit,
            scheme: :primary,
            "data-disable-invalid": "",
            "data-disable-with": "",
            test_selector: "change-role-member-button"
            ) do %>
            <% if current_user_owner_of_organization? %>
              Change role
            <% else %>
              Join organization
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if option_available?(:leave_organization) %>
  <% menu_list.with_item(
    label: "Leave organization",
    tag: :button,
    content_arguments: { "data-show-dialog-id": "org-#{@organization.id}-leave-dialog" },
    value: "",
    test_selector: "change-role-leave",
  ) %>

  <%= render(Primer::Alpha::Dialog.new(
    id: "org-#{@organization.id}-leave-dialog",
    title: "Leave organization",
  )) do |d| %>
    <%= form_tag business_owner_change_role_path(@organization), method: :patch do %>
      <input type="hidden" name="role" value="unaffiliated">
      <%= render(Primer::Alpha::Dialog::Body.new) do %>
        <p>
          Are you sure that you want to leave the
          <strong><%= @organization.safe_profile_name %></strong> organization?
        </p>
      <% end %>
      <%= render(Primer::Alpha::Dialog::Footer.new) do %>
        <%= render(Primer::Beta::Button.new(
          data: { "close-dialog-id": "org-#{@organization.id}-leave-dialog" }
        )) { "Cancel" } %>
        <%= render Primer::Beta::Button.new(
          type: :submit,
          scheme: :danger,
          "data-disable-invalid": "",
          "data-disable-with": ""
        ) do %>
          Leave organization
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if option_available?(:organization_settings) %>
  <% menu_list.with_item(
    label: "Organization settings",
    tag: :a,
    content_arguments: {
      href: settings_org_profile_path(@organization),
      data: org_click_hydro_attributes,
      test_selector: "enterprise-org-settings-option",
    }
  ) %>
<% end %>

<% if option_available?(:transfer_organization) %>
  <% if transfer_in_progress? %>
    <% menu_list.with_item(
      label: "Transfer in progress...",
      disabled: true,
      test_selector: "enterprise-transfer-org-option"
    ) %>
  <% else %>
    <% if org_cannot_be_transferred? %>
      <% menu_list.with_item(
        label: "Transfer organization",
        tag: :button,
        content_arguments: { "data-show-dialog-id": "org-#{@organization.id}-cannot-transfer-dialog" },
        value: ""
      ) %>
    <% else %>
      <% menu_list.with_item(
        label: "Transfer organization",
        href: new_enterprise_organization_transfer_path(
          @business, organization_id: @organization.id
        ),
        test_selector: "enterprise-transfer-org-option"
      ) %>
    <% end %>
  <% end %>

  <% if org_cannot_be_transferred? %>
    <%= render(Primer::Alpha::Dialog.new(
      id: "org-#{@organization.id}-cannot-transfer-dialog",
      title: "Transfer organization",
      size: :medium,
      position: :center,
      data: { test_selector: "failed-enterprise-org-transfer" }
    )) do |d| %>
      <% d.with_body do %>
        <p>
          Cannot transfer <strong><%= @organization.safe_profile_name %></strong> because
          it has active marketplace subscriptions.
        </p>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if option_available?(:remove_organization) %>
  <% menu_list.with_item(
    label: "Remove organization",
    scheme: :danger,
    tag: :button,
    content_arguments: { "data-show-dialog-id": "remove-org-#{@organization.id}-dialog" },
    value: "",
    test_selector: "org-#{@organization.id}-enterprise-remove-org-option"
  ) %>

  <%= render(Primer::Alpha::Dialog.new(
    id: "remove-org-#{@organization.id}-dialog",
    title: "Remove organization",
    size: :large
  )) do |d| %>
      <% d.with_header(show_divider: true) %>

      <%= d.with_body do %>
        <%= form_tag enterprise_organization_path(@business, @organization), id: "remove-org-form", class: "js-remove-org-form", method: :delete do %>
          <%= render(Primer::Alpha::Banner.new(
            icon: :alert,
            scheme: :warning,
            mb: 3
          )) do %>
            Removing this organization will have the following consequences.
          <% end %>

          <ul class="ml-3 mb-2" style="list-style: disc">
            <li>
              The <strong><%= @organization.safe_profile_name %></strong> organization will be returned to
              <%= @business.trial? ? "the free" : "its previous" %> plan.
            </li>
            <li>
              Policies, like billing and 2FA, will be managed by the organization itself.
            </li>
            <li>
              Marketplace purchases will be cancelled and will need to be repurchased.
            </li>
            <% if ghas_available? || copilot_available? %>
              <li <%= test_selector "copilot-business-ghas-access-warning" %>>
                Copilot Business and Advanced Security access will be deactivated.
              </li>
            <% end %>
            <% if has_internal_repositories? %>
              <li>
                Any internal repositories within the organization will be converted to private repositories.
              </li>
            <% end %>
            <% if @business.remove_user_accounts_when_removing_last_org_membership_setting_enabled? %>
              <li <%= test_selector "copilot-business-unaffiliated-users-remove-warning" %>>
                Members who only belong to this organization will be removed from the enterprise.
              </li>
            <% elsif @business.supports_unaffiliated_user_accounts? %>
              <li <%= test_selector "copilot-business-unaffiliated-users-warning" %>>
                Members who only belong to this organization will stay in the enterprise as unaffiliated users until explicitly removed.
              </li>
            <% end %>
          </ul>

          <% if @business.remove_user_accounts_when_removing_last_org_membership_setting_enabled? %>
            <input type="hidden" name="remove_unaffiliated_users" value="true">
          <% else %>
            <%= render Primer::Alpha::CheckBox.new(
              name: "remove_unaffiliated_users",
              label: "(Optional) Remove unaffiliated users who no longer have a license, role, or team association within the enterprise.",
              caption: "Unique members of this organization will remain in the enterprise as unaffiliated users unless specified otherwise.",
              required: false,
              checked: false) %>
          <% end %>

          <%= render Primer::Alpha::CheckBox.new(
            name: "i_agree",
            classes: "js-confirm-remove-org-checkbox mt-2",
            label: "I've read and understand the consequences of removing this organization. *",
            label_arguments: { class: "mt-2" },
            required: true,
            checked: false) %>

          <div class="FormControl-inlineValidation mt-1 js-confirm-removal-error" hidden>
            <span class="FormControl-inlineValidation--visual">
              <%= render(Primer::Beta::Octicon.new(icon: :"alert-fill", size: :xsmall, aria: { hidden: true })) %>
            </span>
            <span>
              You must select this checkbox before continuing.
            </span>
          </div>
        <% end %>
      <% end %>

      <%= d.with_footer(show_divider: true) do %>
        <%= render(Primer::Beta::Button.new(
          type: :button,
          data: { "close-dialog-id": "remove-org-#{@organization.id}-dialog" }
        )) { "Cancel" } %>

        <%= render(Primer::Beta::Button.new(
          type: :submit,
          scheme: :danger,
          form: "remove-org-form"
        )) { "Remove organization" } %>
      <% end %>
  <% end %>
<% end %>

<% if option_available?(:organization_external_identity) %>
  <% menu_list.with_item(
    label: "Linked identity",
    tag: :a,
    content_arguments: {
      href: sso_enterprise_organization_url(@business, @organization),
      test_selector: "enterprise-org-linked-identity",
    }
  ) %>
<% end %>

<%= render menu_list %>
