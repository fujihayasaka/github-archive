<h2 class="mb-2">Runners</h2>

<%# Only include this heading if the custom images section is shown below %>
<% if show_custom_images_policies? %>
  <h4 class="h5 my-2">Repository self-hosted runners</h4>
<% end %>

<div class="tmp-mb-3">
  <%= render Businesses::Actions::Policies::RepoSelfHostedRunnerComponent.new(
    entity: @entity,
    action: settings_actions_update_repo_self_hosted_runners_enterprise_path(@entity),
  ) %>
</div>

<% if show_standard_hosted_runners_toggle? %>
  <div class="tmp-my-4"></div>

  <div class="tmp-pt-3">
    <h4 class="h5 mb-2">Standard hosted runners</h4>
    <p class="color-fg-muted tmp-mb-3">Choose if organizations are allowed to use standard hosted runner labels. If disabled, hosted runners can only be accessed via a runner group.</p>

    <%= form_with(
      local: true,
      method: :put,
      url: settings_actions_update_standard_hosted_runners_enterprise_path(@entity),
      class: "mb-0"
    ) do |f| %>
      <div class="form-checkbox mb-0">
        <label for="disable_standard_hosted_runners_for_business">
          <%= f.check_box :disable_standard_hosted_runners_for_business, { id: "disable_standard_hosted_runners_for_business", checked: standard_hosted_runners_disabled? } %>
          Disable for all organizations
        </label>
        <p class="note mt-2 color-fg-muted">
          <strong>Note:</strong> Once disabled you will lose any concurrency settings you have set up.
          <%= link_to "For more information on concurrency see our documentation.", "#", class: "Link--inTextBlock" %>
        </p>
      </div>

      <div class="tmp-mt-3">
        <%= render(Primer::Beta::Button.new(type: :submit)) { "Save" } %>
      </div>
    <% end %>
  </div>
<% end %>


<% if show_custom_images_policies? %>
  <h2 class="my-2">Custom images</h2>
  <%= render Businesses::Actions::Policies::CustomImagesPolicyComponent.new(
    entity: @entity,
    action: settings_actions_update_custom_images_policy_enterprise_path(@entity),
    bulk_org_action: settings_actions_update_bulk_allow_custom_images_enterprise_path(@entity),
  ) %>

  <% if show_custom_images_retention_policy? %>
  <h4 class="h5 my-2">Custom images retention</h4>
  <%= render Businesses::Actions::Policies::CustomImageVersionLimitComponent.new(
    entity: @entity,
    action: settings_actions_update_custom_images_retention_enterprise_path(@entity),
  ) %>
  <% end %>

<% end %>
