<h3 class="text-normal mb-2">Runners</h3>

<%# Only include this heading if the custom images section is shown below %>
<% if show_custom_images_policies? %>
  <h4 class="h5 my-2">Repository self-hosted runners</h4>
<% end %>

<div class="mb-3">
  <%= render Businesses::Actions::Policies::RepoSelfHostedRunnerComponent.new(
    entity: @entity,
    action: settings_actions_update_repo_self_hosted_runners_enterprise_path(@entity),
  ) %>
</div>

<% if show_custom_images_policies? %>
  <h4 class="h5 my-2">Custom images</h4>
  <%= render Businesses::Actions::Policies::CustomImagesPolicyComponent.new(
    entity: @entity,
    action: settings_actions_update_custom_images_policy_enterprise_path(@entity),
  ) %>
<% end %>
