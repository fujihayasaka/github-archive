<section aria-label="<%= "#{permission_type}-permissions" %>" <%= data_attribute %> <%= "hidden" if hidden %> class="js-permissions-selector ">
  <%= render ProgrammaticAccess::CollapsibleBoxComponent.new(header_bg: :transparent, mb: 0) do |component| %>
    <% component.with_header do %>
      <%= render(Primer::Beta::Subhead.new(hide_border: true, p: 0)) do |subhead| %>
        <% subhead.with_heading(tag: :h3, font_size: 4, font_weight: :bold, flex_grow: 0) { heading } %>
        <% subhead.with_description(flex: :auto, ml: 1) do %>
          <% if permission_type == 'business' %>
            <%= render(Primer::Experimental::BetaLabel.new(ml: 1)) %>
          <% end %>
          <%= render(Primer::Beta::Label.new(label: "#{permission_type} permission count", title: "Label: #{permission_type} permission count", ml: 1, scheme: :success, hidden: true, classes: "js-permission-list-selected-label")) do %>
            <span <%= "data-token-summary=#{permission_type}-selected-permission-count" %>>0</span>
            <span> selected</span>
          <% end %>
          <%= render(Primer::Beta::Label.new(label: "#{permission_type} mandatory permission count", title: "Label: #{permission_type} mandatory permission count", ml: 1, scheme: :attention, hidden: true, classes: "js-permission-list-mandatory-label")) do %>
            <span <%= "data-token-summary=#{permission_type}-mandatory-permission-count" %>>0</span>
            <span> mandatory</span>
          <% end %>
        <% end %>
      <% end %>

      <%= description %>
    <% end %>
    <% component.with_body do |body| %>
      <% resources.each do |resource| %>
        <% body.with_row(align_items: :center, justify_content: :space_between, classes: "js-list-group-item", display: :flex, ml: 2, mr: 1) do %>
          <%= render(ProgrammaticAccess::ResourceSelectionListItemComponent.new(resource, @view)) %>
        <% end %>

        <% if resource == "single_file" %>
          <% args = { classes: "js-dropdown-container", data: { resource: resource } } %>

          <% unless granted?(resource) %>
            <% args[:animation] = :fade_in %>
            <% args[:display] = :none %>
          <% end %>
          <% body.with_row(**args) do %>
            <%= render partial: "integrations/settings/single_file_field", locals: { view: @view } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
