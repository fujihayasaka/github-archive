<%
  hide_mandatory_label = !mandatory?
  hide_selected_label = !selected? || mandatory?
%>

<div class="flex-1">
  <div class="d-flex flex-items-center">
    <strong><%= title %></strong>
    <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2, hidden: hide_selected_label, classes: "js-selected-label", title: "Label: selected")) { "Selected" } %>
    <%= render(Primer::Beta::Label.new(scheme: :attention, ml: 2, hidden: hide_mandatory_label, classes: "js-mandatory-label", title: "Label: mandatory")) { "Mandatory" } %>
  </div>

  <div class="text-small mr-2">
    <span class="color-fg-subtle"><%= description %></span>

    <%= render(Primer::Beta::Link.new(href: docs_url, target: "_blank", rel: "noopener noreferrer", classes: "Link--inTextBlock", aria: { label: "Info" })) do %>
      Learn more.
    <% end %>
  </div>
</div>

<%= render(ProgrammaticAccess::ActionSelectionListComponent.new(@resource, @view)) %>
