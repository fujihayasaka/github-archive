<%= render(Primer::Alpha::ActionMenu.new(
  id: "action-selection-list-menu",
  select_variant: :single,
  dynamic_label: true,
  dynamic_label_prefix: "Access",
  anchor_align: :end,
  display: :flex,
  form_arguments: { builder:, name: action_menu_form_name },
  flex_shrink: 0,
  aria: {
    disabled: show_mandatory_label?,
  }
)) do |menu| %>
  <% menu.with_show_button(
    classes: "js-action-selection-list-menu-button",
    size: :small,
    aria: {
      disabled: show_mandatory_label?,
    }
  ) do |button| %>
    <% if enable_tooltip? %>
      <% button.with_tooltip(text: 'This is a mandatory permission and cannot be changed') %>
    <% end %>
    <% button.with_trailing_action_icon(icon: :"triangle-down")  %>
  <% end %>
  <% items.each do |item| %>
    <% menu.with_item(
      id: item.id,
      label: item.label_text,
      content_arguments: { data: { **item.data_attributes } },
      data: { value: item.action },
      active: item.checked?,
      disabled: item.disabled?,
    ) %>
  <% end %>
<% end %>
