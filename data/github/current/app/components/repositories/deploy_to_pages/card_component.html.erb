<%= render(Primer::Box.new(**system_arguments)) do %>
  <%= render Primer::BaseComponent.new(tag: :div, display: :flex, align_items: :center) do %>
    <%= render Primer::BaseComponent.new(
      tag: :div,
      classes: "CircleBadge CircleBadge--tiny",
      color: :accent,
      bg: :default,
      "aria-hidden": true
    ) do %>
      <%= primer_octicon("rocket", size: :small) %>
    <% end %>
    <%= render Primer::BaseComponent.new(tag: :div, display: :flex, direction: :column) do %>
      <%= render(Primer::Beta::Text.new(font_size: 5, font_weight: :bold, ml: 2)) { "Deploy to Pages" } %>
    <% end %>
    <%= render(Primer::Beta::Button.new(
      tag: :a,
      size: :small,
      ml: :auto,
      href: deploy_path,
      style: "min-width: 80px",
      data: configure_button_analytics,
      aria: { describedby: "deploy-to-pages-description" },
    )) do %>
      Set up
    <% end %>
  <% end %>
  <%= render(Primer::Beta::Text.new(
    id: "deploy-to-pages-description",
    display: :flex,
    color: :muted,
    font_size: 6,
    mt: 1,
    pl: 2,
    classes: "tmp-ml-5")) { description } %>
<% end %>
