<% case variant %>
<% when "copilot-org-admin" %>
  <%= render(Repositories::EmptyRepo::PromptComponent.new(
    title: title,
    description: description,
    icon: icon,
  )) do |c| %>
    <% c.with_action_button(
      scheme: :default,
      size: :small,
      test_selector: test_selector,
      tag: :a,
      href: href,
      data: analytics_data,
    ) { button_label } %>
  <% end %>
<% when "copilot-org-member" %>
  <%= render(Repositories::EmptyRepo::PromptComponent.new(
    title: title,
    description: description,
    icon: icon,
  )) do |c| %>
    <% c.with_action_raf(
      requester: member_request_requester,
      organization: member_request_organization,
      feature: member_request_feature,
    ) do |raf| %>
      <% raf.with_request_cta(
        test_selector: test_selector,
        scheme: :default,
        size: :small,
        data: member_request_analytics,
      ) { button_label } %>
      <% raf.with_remove_request_cta(scheme: :link) { "Remove request" } %>
      <% raf.with_requested_message do %>
        <div class="d-inline color-fg-muted">
          You've successfully submitted a request to your organization's admins for access to GitHub Copilot.
        </div>
      <% end %>
    <% end %>
  <% end %>
<% when "copilot-individual", "codespaces" %>
  <%= render(Repositories::EmptyRepo::PromptComponent.new(
    title: title,
    description: description,
    icon: icon,
  )) do |c| %>
    <% c.with_action_button(
      scheme: :default,
      size: :small,
      test_selector: test_selector,
      tag: :a,
      href: href,
      data: analytics_data,
    ) { button_label } %>
  <% end %>
<% end %>
