<div
  id="repo-delete-warning-container"
  <%= test_selector("repo-delete-warning-stage-#{stage}") %>
>
  <% if stage < 3 || !can_request_bypass %>
    <div class="text-center">
      <%= primer_octicon("repo-locked", size: :medium, color: :muted, mt: 2) %>

      <%= render Primer::Beta::Text.new(
        tag: :p,
        font_weight: :bold,
        font_size: 3,
        mt: 2,
      ).with_content(repository.name_with_display_owner) %>

      <div class="mt-2">
        <%= primer_octicon(:star, size: :small, color: :muted, mr: 1) %>
        <%= helpers.social_count(repository.stargazer_count) %>
        <%= "star".pluralize(repository.stargazer_count) %>

        <%= primer_octicon(:eye, size: :small, color: :muted, ml: 2, mr: 1) %>
        <%= helpers.social_count(repository.watchers_count) %>
        <%= "watcher".pluralize(repository.watchers_count) %>
      </div>
    </div>
  <% end %>
  <%= warning_message %>
  <% if last_stage? && can_request_bypass %>
    <div class="mt-2">
      <%= render Primer::Alpha::TextField.new(
        name: :verification_field,
        label: verification_label,
        invalid: true,
        mb: 2,
        full_width: true,
        data: { repo_nwo:, test_selector: "repo-delete-proceed-confirmation" },
        classes: "js-repo-delete-proceed-confirmation",
      ) %>
      <input type="hidden" name="verify" value="<%= repo_nwo %>">
    </div>
    <div>
      <%= render Primer::Alpha::TextArea.new(
        name: :bypass_request_message,
        label: bypass_request_message_label,
        rows: 4,
        full_width: true,
        data: { repo_nwo:, test_selector: "repo-delete-bypass-message" },
        caption: bypass_message_caption
      ) %>
    <div>
    </div>
  <% end %>
</div>
