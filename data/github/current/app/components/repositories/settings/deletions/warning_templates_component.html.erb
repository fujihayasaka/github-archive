<% 1.upto(3) do |stage| %>
  <template
    id="delete-repository-step-<%= stage %>"
    <%= test_selector("delete-repository-step-#{stage}") %>
  >
    <%= render Repositories::Settings::Deletions::WarningComponent.new(repository:, stage:) %>
  </template>

  <template
    id="proceed-button-delete-step-<%= stage %>"
    <%= test_selector("proceed-button-delete-step-#{stage}") %>
  >
    <%= render Repositories::Settings::Deletions::ProceedButtonComponent.new(repository:, stage:) %>
  </template>
<% end %>

<template
  id="bypass-button-delete"
  <%= test_selector("bypass-button-delete") %>
>
  <%= render Repositories::Settings::Deletions::BypassButtonComponent.new(repository:) %>
</template>
