<div class="flex-md-order-1 flex-order-2">
  <% if !prevented_by_ruleset? || can_request_bypass? %>
    <% if disable_button? %>
      <%= render Primer::Beta::Button.new(
        disabled: true,
        scheme: :danger,
        test_selector: "repository-delete-button",
      ) do %>Delete this repository<% end %>
    <% else %>
      <%= form_tag(
        form_path,
        method: form_method,
      ) do %>
        <%= render Primer::Alpha::Dialog.new(
          title: dialog_title,
          subtitle: dialog_subtitle,
          size: :medium_portrait,
          id: "repo-delete-menu-dialog",
        ) do |dialog| %>
          <% dialog.with_header(show_divider: true) %>
          <% dialog.with_show_button(
            scheme: show_button_theme,
            float: [:none, :right],
            classes: "js-repo-delete-button",
            test_selector: "repository-delete-button",
          ) do |button| %>
            <% if can_request_bypass? %>
              <% button.with_leading_visual_icon(icon: :"shield-lock") %>
            <% end %>
            <%= show_button_text %>
          <% end %>
          <% dialog.with_body(
            role: "region",
            tabindex: "-1",
            "aria-label": "Effects of deleting this repository",
          ) do %>
            <%= render Repositories::Settings::Deletions::WarningComponent.new(repository:, stage: 1, can_request_bypass: can_request_bypass?) %>
          <% end %>

          <% dialog.with_footer(show_divider: true) do %>
            <%= render Repositories::Settings::Deletions::ProceedButtonComponent.new(
              repository:,
              stage: initial_stage,
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="d-flex flex-justify-between flex-1 flex-items-center">
  <div class="flex-auto">
    <strong <%= test_selector("delete-repository-headline") %>>
      Delete this repository
    </strong>
    <p class="mb-0" <%= test_selector("delete-repository-description") %>>
      <%= description %>
    </p>
  </div>
  <% if prevented_by_ruleset? && !repo_policy_bypass_enabled? %>
    <%= render Repositories::Settings::RestrictedByRulesComponent.new(
      rules_provider: name_of_ruleset_source_blocking_delete,
      test_selector: "delete-restricted-iconbutton",
    ) %>
  <% end %>
</div>

<%= render Repositories::Settings::Deletions::WarningTemplatesComponent.new(repository:, can_request_bypass: can_request_bypass?) %>
