<div class="flex-md-order-1 flex-order-2">
  <% if disable_button? %>
    <%= render Primer::Beta::Button.new(
      disabled: true,
      ml: [0, nil, 3],
      px: 3,
      scheme: :danger,
      test_selector: "change-repository-visibility-button",
    ).with_content("Change visibility") %>
  <% elsif can_change_visibility? %>
    <% if can_request_bypass? %>
      <%= form_with(
        url: bypass_form_path,
        method: :post,
      ) do |form| %>
        <%= render Primer::Alpha::Dialog.new(
          title: "Submit a request to make #{repository.name_with_display_owner}",
          subtitle: "Repository visibility is managed. Submit a request to change the visibility of this repository.",
          size: :medium_portrait,
          id: "visibility-menu-dialog-request",
          data: {
            name_with_display_owner: repository.name_with_display_owner,
          }
        ) do |dialog| %>
          <% dialog.with_header(show_divider: true) %>
          <% dialog.with_body(
            role: "region",
            tabindex: "-1",
            "aria-label": "Request a change in visibility for this repository.",
            classes: "d-flex flex-column gap-3"
          ) do %>
            <%= form.hidden_field "new_visibility" %>
            <%= render Primer::Alpha::TextArea.new(
              name: :bypass_request_message,
              label: "Add a comment",
              rows: 4,
              full_width: true,
              data: { test_selector: "repo-change-visibility-bypass-message" },
              caption: "Add a comment to explain why you're submitting this request.",
              required: true,
            ) %>
          <% end %>

          <% dialog.with_footer(show_divider: true) do %>
            <%= render Primer::Beta::Button.new(
              type: :submit,
              scheme: :primary,
              block: true,
              id: "repo-visibility-proceed-button",
              classes: "js-repo-visibility-proceed-button",
              data: {
                test_selector: "repo-visibility-proceed-button",
              }.compact,
            ) do %>
              Submit Request
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= render Primer::Alpha::ActionMenu.new(
      menu_id: "visibility_menu",
      anchor_align: :end,
    ) do |menu| %>
      <% menu.with_show_button(scheme: :danger) do %>Change visibility<% end %>

      <% available_visibilities.excluding(current_visibility).map do |new_visibility| %>
        <% is_locked_by_rules = !can_change_visibility_with_rules?(new_visibility) %>
        <% rules_source = name_of_ruleset_source_blocking_visibility(new_visibility.to_sym) if is_locked_by_rules %>
        <% show_dialog_id = "visibility-menu-dialog-#{is_locked_by_rules ? 'request' : new_visibility}" %>
        <% dialog_title = "Submit a request to make #{repository.name_with_display_owner} #{new_visibility}" if is_locked_by_rules %>
        <% dialog_subtitle = "Repository visibility is managed by #{rules_source}. Submit a request to change the visibility of this repository." if rules_source %>
        <% menu.with_item(tag: :button,
          type: "button",
          classes: "js-repo-change-visibility-button",
          test_selector: "dropdown-item-#{new_visibility}",
          content_arguments: { "data-show-dialog-id": show_dialog_id },
          data: {
            show_dialog_id:,
            dialog_title:,
            dialog_subtitle:,
            new_visibility:,
            target: "modal-dialog.show-button",
          },
        ) do |item| %>
          <% if is_locked_by_rules %>
            <% item.with_trailing_visual_icon(icon: :"shield-lock") %>
          <% end %>
          <% "Change to #{new_visibility}" %>
        <% end %>
      <% end %>
    <% end %>

    <% available_visibilities.excluding(current_visibility).map do |new_visibility| %>
      <%= form_tag settings_set_visibility_path(
        repository: repository.name,
        user_id: repository.owner_display_login,
      ) do %>
        <%= render Primer::Alpha::Dialog.new(
          title: "Make #{repository.name_with_display_owner} #{new_visibility}",
          size: :medium_portrait,
          id: "visibility-menu-dialog-#{new_visibility}",
          data: { new_visibility: },
        ) do |dialog| %>
          <% dialog.with_header(show_divider: true) %>

          <% dialog.with_body(
            role: "region",
            tabindex: "-1",
            "aria-label": "Effects of making this repository #{new_visibility}",
            ) do %>
            <div class="text-center">
              <%= primer_octicon("repo-locked", size: :medium, color: :muted, mt: 2) %>

              <%= render Primer::Beta::Text.new(
                tag: :p,
                font_weight: :bold,
                font_size: 3,
                mt: 2,
              ) do %>
                <%= repository.name_with_display_owner %>
              <% end %>

              <div class="mt-2">
                <%= primer_octicon(:star, size: :small, color: :muted, mr: 1) %>
                <%= helpers.social_count(repository.stargazer_count) %>
                <%= "star".pluralize(repository.stargazer_count) %>

                <%= primer_octicon(:eye, size: :small, color: :muted, ml: 2, mr: 1) %>
                <%= helpers.social_count(repository.watchers_count) %>
                <%= "watcher".pluralize(repository.watchers_count) %>
              </div>
            </div>

            <%= render Repositories::Settings::Visibilities::WarningComponent.new(
              repository:,
              new_visibility:,
              stage: 1,
            ) %>
          <% end %>

          <% dialog.with_footer(show_divider: true) do %>
            <%= render Repositories::Settings::Visibilities::ProceedButtonComponent.new(
              repository:,
              new_visibility:,
              stage: 1,
            ) %>
          <% end %>
        <% end %>
      <% end %>

      <%= render Repositories::Settings::Visibilities::WarningTemplatesComponent.new(
        repository:,
        new_visibility:,
      ) %>
    <% end %>
  <% end %>
</div>

<div class="flex-auto mb-md-0 mb-2">
  <strong <%= test_selector("change-repository-visibility-headline") %>>
    Change repository visibility
  </strong>
  <div class="mb-0" <%= test_selector("change-repository-visibility-description") %>>
    <%= description %>
  </div>
</div>
