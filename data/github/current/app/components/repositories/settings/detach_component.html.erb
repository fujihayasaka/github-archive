<div class="flex-md-order-1 flex-order-2">
  <% if enable_button? %>
    <%= form_tag(
      settings_detach_path(repository: repository.name, user_id: repository.owner_display_login),
    ) do %>
      <%= render Primer::Alpha::Dialog.new(
        title: "Leave fork network",
        size: :medium_portrait,
        id: "repo-detach-menu-dialog",
      ) do |dialog| %>
        <% dialog.with_header(show_divider: true) %>
        <% dialog.with_show_button(
          scheme: :danger,
          float: [:none, :right],
          classes: "js-repo-detach-button",
        ).with_content("Leave fork network") %>
        <% dialog.with_body(
          role: "region",
          tabindex: "-1",
          "aria-label": "Effects of detaching this repository",
        ) do %>
          <div class="text-center">
            <%= primer_octicon("repo-locked", size: :medium, color: :muted, mt: 2) %>

            <%= render Primer::Beta::Text.new(
              tag: :p,
              font_weight: :bold,
              font_size: 3,
              mt: 2,
            ).with_content(repository.name_with_display_owner) %>

            <div class="mt-2">
              <%= "Forked from #{repository.parent&.name_with_display_owner}" %>
            </div>

            <div class="mt-2">
              <%= primer_octicon(:star, size: :small, color: :muted, mr: 1) %>
              <%= helpers.social_count(repository.stargazer_count) %>
              <%= "star".pluralize(repository.stargazer_count) %>

              <%= primer_octicon(:eye, size: :small, color: :muted, ml: 2, mr: 1) %>
              <%= helpers.social_count(repository.watchers_count) %>
              <%= "watcher".pluralize(repository.watchers_count) %>
            </div>

          </div>

          <%= render Repositories::Settings::Detaches::WarningComponent.new(repository:, stage: initial_stage) %>
        <% end %>

        <% dialog.with_footer(show_divider: true) do %>
          <%= render Repositories::Settings::Detaches::ProceedButtonComponent.new(
            repository:,
            stage: initial_stage,
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render Primer::Beta::Button.new(
      disabled: true,
      scheme: :danger,
      test_selector: "repository-detach-button",
    ) do %>Leave fork network<% end %>
  <% end %>
</div>

<div class="d-flex flex-justify-between width-full flex-1">
  <div class="flex-auto">
    <strong <%= test_selector("detach-repository-headline") %>>
      Leave fork network
    </strong>
    <p class="mb-0" <%= test_selector("detach-repository-description") %>>
      <%= description %>
    </p>
  </div>
</div>

<%= render Repositories::Settings::Detaches::WarningTemplatesComponent.new(repository:) %>
