<% 1.upto(3) do |stage| %>
  <template
    id="detach-repository-step-<%= stage %>"
    <%= test_selector("detach-repository-step-#{stage}") %>
  >
    <%= render Repositories::Settings::Detaches::WarningComponent.new(repository:, stage:) %>
  </template>

  <template
    id="proceed-button-detach-step-<%= stage %>"
    <%= test_selector("proceed-button-detach-step-#{stage}") %>
  >
    <%= render Repositories::Settings::Detaches::ProceedButtonComponent.new(repository:, stage:) %>
  </template>
<% end %>
