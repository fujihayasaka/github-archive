<style>
  /*
    This is kind of gross but let me explain.
    The triangle-down icon in the user lists menu component needs to be larger on small screens
    but Primer doesn't accept a responsive value for size.
    So instead we use CSS to override the size on small screens only, to match the ⭐ button beside it.
    The selector is written this way to avoid affecting other buttons inside the lists dropdown.
  */
  @media (max-width: 767px) {
    .icon-button-group .BtnGroup-parent > * > button:first-child {
      height: var(--control-medium-size);
      width: var(--control-medium-size);
      min-width: var(--control-medium-size);
    }
  }

  /* No idea what this is though. It was like this when I got here. */
  @media (min-width: 544px) {
    .icon-button-group .SelectMenu {
      right: auto !important;
      left: 0 !important;
    }
  }
</style>
<% if logged_in? %>
  <%= render Primer::BaseComponent.new(
    tag: :div,
    classes: class_names(
      "js-toggler-container starring-container",
      "on": is_starred?,
    ),
    test_selector: "star-toggle-container",
  ) do %>
    <%= render Primer::BaseComponent.new(
      tag: :div,
      flex: 1,
      ml: 0,
      classes: class_names(
        "starred",
        "BtnGroup icon-button-group": list_menu?,
      ),
      test_selector: "starred-container"
    ) do %>
      <%= form_tag(gh_unstar_path(@repository), {class: class_names("js-social-form", "BtnGroup-parent": list_menu?, "width-full": !list_menu?)}) do %>
        <input type="hidden" name="context" value="<%= @context %>">
        <%= render(Primer::Beta::IconButton.new(
          icon: :"star-fill",
          type: :submit,
          data: unstar_button_data_attributes(@repository, helpers.controller_action_slug),
          aria: { label:  "Unstar this #{@repository.human_name}" },
          classes: class_names(
            "js-toggler-target starred-button-icon BtnGroup-item",
            "rounded-left-2": list_menu?,
          ),
          test_selector: "star-button-do-unstar"
        )) %>
      <% end %>
      <% if list_menu? %>
        <%= render(list_menu) %>
      <% end %>
    <% end %>

    <%= render Primer::BaseComponent.new(
      tag: :div,
      flex: 1,
      ml: 0,
      classes: class_names(
        "unstarred",
        "BtnGroup icon-button-group": list_menu?,
      ),
      test_selector: "unstarred-container"
    ) do %>
      <%= form_tag(gh_star_path(@repository), {class: class_names("js-social-form", "BtnGroup-parent": list_menu?, "width-full": !list_menu?)}) do %>
        <input type="hidden" name="context" value="<%= @context %>">
        <%= render(Primer::Beta::IconButton.new(
          icon: :star,
          type: :submit,
          data: star_button_data_attributes(@repository, helpers.controller_action_slug),
          aria: { label: "Star this #{@repository.human_name}" },
          classes: class_names(
            "js-toggler-target BtnGroup-item",
            "rounded-left-2": list_menu?,
          ),
          test_selector: "star-button-do-star"
        )) %>
      <% end %>
      <% if list_menu? %>
        <%= render(list_menu) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::IconButton.new(
    icon: :star,
    tag: :a,
    href: login_path(return_to: polymorphic_path(@repository)),
    rel: "nofollow",
    data: sign_in_link_data_attributes(location_in_page: "star button", repository_id: @repository&.id),
    aria: { label: "You must be signed in to star a repository" },
    test_selector: "star-button-sign-in"
  )) %>
<% end %>
