<%= render(Primer::Box.new(display: :flex, border: true, border_bottom: 0, p: 3, align_items: :center, **system_arguments)) do %>
  <%= render(Primer::Beta::Avatar.new(src: actor.primary_avatar_url, alt: actor.name, shape: :square, size: 32)) %>
  <%= render(Primer::Box.new(display: :flex, direction: :column, flex: 1, ml: 3)) do %>
    <div class="d-flex gap-2">
      <%= render(Primer::Beta::Link.new(href: actor_profile_path, font_weight: :emphasized, color: :accent)) { actor.name } %>
      <%= render(Primer::Beta::Label.new(title: BusinessTeam::LABEL_NAME).with_content(BusinessTeam::LABEL_NAME)) %>
    </div>
    <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6, test_selector: "team-#{actor.id}-desc")) { description } %>
  <% end %>
  <%= render(Primer::Alpha::Dialog.new(
    title: role.display_name,
    size: :large,
    id: "fgp-details-dialog-#{actor.id}-#{role.id}",
  )) do |dialog| %>
    <% dialog.with_show_button(scheme: :invisible) { role.display_name } %>
    <% dialog.with_header(show_divider: true) do |header|%>
      <div class="d-flex gap-2">
        <%= render(Primer::Beta::Text.new(font_weight: :emphasized)) { role.display_name } %>
        <%= render(Primer::Experimental::BetaLabel.new) if show_role_in_preview? %>
      </div>
      <%= render(Primer::Beta::Text.new(font_size: :small, color: :muted)) do %>
        <%= role.description %>
      <% end %>
    <% end %>
    <% dialog.with_body do %>
      <%= render(CustomRoles::RolePermissionsListComponent.new(
        title: "Repository",
        icon: :repo,
        permissions_by_category: role_permissions,
        base_role_name: base_repo_role&.display_name,
        test_selector: "repository-role-permissions-list",
      )) %>
    <% end %>
    <% dialog.with_footer(show_divider: true) do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "fgp-details-dialog-#{actor.id}-#{role.id}" })) { "Close" } %>
    <% end %>
  <% end %>
<% end %>
