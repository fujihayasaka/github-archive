<div class="form-checkbox js-real-time-alert-input">
  <%= form.check_box :subscribed_to_events?, class: "form-checkbox-details-trigger" %>
  <label class="FormControl-label" for="personal_reminder_subscribed_to_events">
    Enable real-time alerts
    <p class="FormControl-caption">Receive immediate Slack messages when certain events happen.</p>
  </label>

  <div class="form-group form-checkbox-details text-normal" style="padding-left: 20px">
    <input
      type="hidden"
      value=""
      name="personal_reminder[reminder_event_subscriptions][]">
    <% event_types_filtered.each do |event_type, text| %>
      <div class="pt-1 js-reminders-checkbox-container">
        <label for="personal_reminder_event_types_<%= event_type %>" class="FormControl-label text-normal">
          <input
            type="checkbox"
            class="js-reminders-checkbox-trigger"
            value="<%= event_type %>"
            name="personal_reminder[reminder_event_subscriptions][][event_type]"
            <%= selected_event_types.include?(event_type.to_s) ? "checked" : "" %>
            id="personal_reminder_event_types_<%= event_type %>">
          <%= text %>
        </label>

        <% if event_type_permits_option?(event_type.to_s) %>
          <div class="<%= class_names(
            "mt-1 js-reminders-checkbox-details",
            "has-removed-contents" => !real_time_selected?(event_type.to_s),
          ) %>">
            <%= render Primer::Alpha::TextField.new(
              name: "personal_reminder[reminder_event_subscriptions][][options]",
              id: "event_subscriptions_#{event_type}_options",
              label: real_time_options_label(event_type),
              caption: real_time_options_caption(event_type),
              value: real_time_options(event_type),
              placeholder: real_time_options_placeholder(event_type),
              required: true,
            ) %>
          </div>
        <% end -%>
      </div>
    <% end -%>
  </div>
</div>

<hr>
