<%= content_tag(:span, class: "note") do %>
  <% if preset_rule? %>
    <% if low_impact_rule? %>
      <%= description %>
      <%= render(Primer::Beta::Link.new(href: "#{GitHub.help_url}/code-security/dependabot/dependabot-alerts/using-alert-rules-to-prioritize-dependabot-alerts")) { "Learn more about this methodology." } %>
    <% elsif malware_package_rule? %>
      Matches
      <% conditions.each do |key, value| %>
        <%= key %>:<span class="color-fg-accent color-bg-accent"><%= value %></span>
      <% end %>
      <br>
      This rule auto-dismisses alerts for
      <%= render(Primer::Beta::Link.new(href: "https://gh.io/dependabot-malware", classes: "Link--inTextBlock")) { "false positives from private packages" } %>
      as well as public packages where all versions are flagged as malicious.
    <% end %>
  <% else %>
    <%= description %>
    <% conditions.each do |key, value| %>
      <%= key %>:<span class="color-fg-accent color-bg-accent"><%= value %></span>
    <% end %>
  <% end %>
<% end %>
