<% state = readiness_state %>
<% if state.nil? %>
<% elsif state[:status] == :pending %>
  Dependency file check in progress<% if state[:sha] && state[:commit_url] %> for commit <%= link_to state[:sha][0, 7], state[:commit_url], class: "Link--inTextBlock" %><% end %>…
<% elsif state[:status] == :ready && state[:time] %>
  Dependency files checked <%= time_ago_in_words_js(state[:time]) %><% if state[:sha] && state[:commit_url] %> for commit <%= link_to state[:sha][0, 7], state[:commit_url], class: "Link--inTextBlock" %><% end %>
<% elsif state[:status] == :partial && state[:time] %>
  Dependency files checked <%= time_ago_in_words_js(state[:time]) %><% if state[:sha] && state[:commit_url] %> for commit <%= link_to state[:sha][0, 7], state[:commit_url], class: "Link--inTextBlock" %><% end %>
  <%= render Primer::Alpha::Banner.new(scheme: :danger, mt: 2) do %>
    Not all dependency manifest files were successfully processed. Check the <%= link_to "Dependency Graph workflow runs", state[:workflow_url], class: "Link--inTextBlock" %> for details.
  <% end %>
<% elsif state[:status] == :fallback && state[:time] %>
  Dependency files checked <%= time_ago_in_words_js(state[:time]) %>
<% end %>
