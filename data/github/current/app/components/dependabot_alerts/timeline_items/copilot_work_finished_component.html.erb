<div class="tmp-ml-5">
  <%= render(Primer::Beta::TimelineItem.new(pb: padding, test_selector: "alert-timeline-event-copilot-work-finished")) do |component| %>
    <% component.with_badge(icon: "repo-push") %>
    <% component.with_body do %>
      <strong>Copilot</strong> finished work on behalf of
      <%= render DependabotAlerts::TimelineItems::ActorComponent.new(actor: actor) %>
      <%= render Primer::Beta::RelativeTime.new(datetime: event_at, tense: :past) %>
    <% end %>
  <% end %>
</div>
