<div class="js-timeline-item Box flex-shrink-0 pb-0">
  <div class="width-full d-flex">
    <div class="TimelineItem">
      <div class="TimelineItem-badge">
        <%= render Primer::Beta::Octicon.new(
          icon: "person",
          size: :small
        ) %>
      </div>
      <div class="TimelineItem-body">
        <strong class="d-flex flex-items-center">
          <span><%= @actor %></span>
          <span class="color-fg-muted ml-2">requested dismissal</span>
        </strong>

        <div class="d-flex flex-items-center flex-wrap mt-1">
          <span class="color-fg-muted">
            Dismiss as: <strong><%= @timeline_event.resolution.humanize %></strong>
          </span>
          <span class="mx-2 color-fg-muted">•</span>
          <relative-time datetime="<%= @timeline_event.timestamp.iso8601 %>" class="color-fg-muted">
            <%= @timeline_event.timestamp.strftime("%b %-d, %Y") %>
          </relative-time>
        </div>

        <% if @timeline_event.show_dismissal_actions %>
          <div class="mt-3">
            <%= render DependabotAlerts::DismissalReviewDialogComponent.new(
              timeline_event: @timeline_event,
              dismissal_request_review_path: @dismissal_request_review_path,
              alert: @alert
            ) %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
