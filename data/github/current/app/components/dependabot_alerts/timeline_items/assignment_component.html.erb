<div class="tmp-ml-5">
  <%= render(Primer::Beta::TimelineItem.new(pb: padding, test_selector: test_selector)) do |component| %>
    <% component.with_badge(icon: :person) %>
    <% component.with_body do %>
      <%= render DependabotAlerts::TimelineItems::ActorComponent.new(actor: actor) %> <%= action_text %> <%= render DependabotAlerts::TimelineItems::ActorComponent.new(actor: assignee) unless self_assignment? %> <%= render Primer::Beta::RelativeTime.new(datetime: event_at, tense: :past) %>
    <% end %>
  <% end %>
</div>
