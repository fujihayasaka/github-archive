<div class="tmp-ml-5">
  <%= render(Primer::Beta::TimelineItem.new(pb: padding, test_selector: "alert-timeline-event-copilot-work-started")) do |component| %>
    <% component.with_badge(icon: "git-branch") %>
    <% component.with_body do %>
      <strong>Copilot</strong> started work on behalf of
      <%= render DependabotAlerts::TimelineItems::ActorComponent.new(actor: actor) %>
      <%= render Primer::Beta::RelativeTime.new(datetime: event_at, tense: :past) %>
      <% if session_url.present? %>
        <%= render Primer::Beta::Button.new(tag: :a, size: :small, href: session_url, float: :right, "aria-label": "View session") do %>
          View session
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
