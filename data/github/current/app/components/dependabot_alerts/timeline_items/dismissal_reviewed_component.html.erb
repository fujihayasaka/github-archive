<div class="js-timeline-item Box flex-shrink-0 pb-0">
  <div class="width-full d-flex">
    <div class="TimelineItem">
      <div class="TimelineItem-badge">
        <%= render Primer::Beta::Octicon.new(
          icon: "check-circle",
          size: :small
        ) %>
      </div>
      <div class="TimelineItem-body">
        <strong class="d-flex flex-items-center">
          <span><%= @actor %></span>
          <span class="color-fg-muted ml-2">
            <% if @timeline_event.status == "approved" %>
              approved dismissal request
            <% else %>
              denied dismissal request
            <% end %>
          </span>
        </strong>

        <div class="d-flex flex-items-center flex-wrap mt-1">
          <relative-time datetime="<%= @timeline_event.timestamp.iso8601 %>" class="color-fg-muted">
            <%= @timeline_event.timestamp.strftime("%b %-d, %Y") %>
          </relative-time>
        </div>

        <% if @timeline_event.message.present? %>
          <div class="mt-2 p-2 border rounded-2 color-bg-subtle">
            <div class="f6 color-fg-muted mb-1">Review comment:</div>
            <div class="markdown-body">
              <%= simple_format(@timeline_event.message) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
