<%= render(Primer::Alpha::Dialog.new(**system_arguments, id: close_id, title: "Select a reason to dismiss")) do |d| %>
  <% d.with_show_button(
       **button_system_arguments,
       size: :small,
       ml: 3,
       data: {
         target: "dependabot-alert-table-header.alertsBulkActionContainer",
         test_selector: "alert-dismissal-button",
       }
     ) do |b| %>
    <% b.with_trailing_visual_icon("triangle-down") %>
    <%= summary %>
  <% end %>
  <%= form_tag dismissal_path, method: :put do %>
    <%= render Primer::Alpha::RadioButtonGroup.new(
                 name: "Select a reason to dismiss",
                 px: 3,
                 py: 2,
               ) do |component| %>
      <% dismiss_reasons.values.each_with_index do |label, index| %>
        <% component.radio_button(
             value: label,
             name: "reason",
             label: label,
             checked: index.zero?,
             mt: 1,
             mb: 0,
             py: 0,
             data: { test_selector: "alert-dismissal-reason" },
           ) %>
      <% end %>
    <% end %>

    <%= render(Primer::Box.new(hidden: true, **bulk_items_system_arguments)) %>
    <%= render(Primer::Box.new(border: :top, px: 3, py: 2)) do %>
      <%= render(Primer::Alpha::TextArea.new(
            name: "alert-dismissal-comment",
            label: "Dismissal comment",
            caption: "Add a comment",
            label_arguments: { color: :muted },
            data: { test_selector: "alert-dismissal-comment" },
          )) %>
    <% end %>

    <%= render(Primer::Alpha::Dialog::Footer.new) do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": close_id })) { "Cancel" } %>
      <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit, test_selector: "alert-dismissal-submit")) { "Dismiss Alerts" } %>
    <% end %>
  <% end %>
<% end %>
