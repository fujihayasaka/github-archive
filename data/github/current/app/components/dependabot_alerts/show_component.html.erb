<%# erblint:counter DeprecatedComponentsCounter 4 %>
<%= render Repos::Security::SecurityShowPageComponent.new do |show_page_component| %>
  <% if show_dismiss_button? %>
    <% show_page_component.with_alert_actions do %>
      <div class="d-md-block">
        <% if user_can_directly_dismiss? %>
          <%= render DependabotAlerts::AlertDismissalModalComponent.new(
            dismissal_path: dismissal_path,
            size: :medium_portrait,
            px: [0, 1, 2, 3, nil],
          ) do |c| %>
            <% c.with_summary { "Dismiss alert" } %>
          <% end %>
        <% else %>
          <%= render DependabotAlerts::AlertDismissalRequestModalComponent.new(
            dismissal_path: repository_dependabot_dismissal_request_create_path(
              user_id: repository.owner,
              repository: repository
            ),
            alert_number: alert.number,
            size: :medium_portrait,
            px: [0, 1, 2, 3, nil],
          ) do |c| %>
            <% c.with_summary { "Dismiss alert" } %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% elsif show_cancel_dismissal_request_button? %>
    <% show_page_component.with_alert_actions do %>
      <%= form_tag repository_dependabot_dismissal_request_cancel_path(
            user_id: repository.owner,
            repository: repository,
            alert_number: alert.number
          ), method: :put, data: { turbo: true, turbo_action: "replace" } do %>
        <%= hidden_field_tag :request_id, existing_dismissal_request.id %>
        <%= render Primer::ButtonComponent.new(type: :submit, test_selector: "cancel-dismissal-request-button") do %>
          Cancel dismissal request
        <% end %>
      <% end %>
    <% end %>
  <% elsif show_request_pending_button? %>
    <% show_page_component.with_alert_actions do %>
      <%= render Primer::ButtonComponent.new(disabled: true, test_selector: "request-pending-button") do %>
        Request pending
      <% end %>
    <% end %>
  <% elsif show_reopen_button? %>
    <% show_page_component.with_alert_actions do %>
      <%= form_tag reopen_path, method: :put, data: { turbo: true, turbo_action: "replace" } do %>
        <%= render Primer::ButtonComponent.new(type: :submit, test_selector: "reopen-button") do %>
          Reopen alert
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% show_page_component.with_react_header do %>
    <%= render_react_partial name: "dependabot-alert-show-header", props: {
      alertTitle: alert_title,
      alertNumber: alert_number,
      alertOpenedAt: alert_opened_at,
      backButtonPath: back_button_path,
      backButtonText: back_button_label,
      packageName: package_name,
      ecosystem: ecosystem,
      manifestPath: manifest_path,
      manifestBlobPath: manifest_blob_path,
      state: alert.state,
      showDismissMetadata: !!show_dismiss_metadata?,
      alertDismisser: alert_dismisser ? {
        url: user_path(alert_dismisser),
        name: alert_dismisser&.display_login,
        label: dismisser_type(alert_dismisser)
      } : nil,
      alertDismissedAt: alert_dismissed_at,
      showAutoDismissMetadata: !!show_auto_dismiss_metadata?,
      alertLastStateChangeAt: alert_last_state_change_at,
      showFixedMetadata: !!show_fixed_metadata?,
      alertFixedAt: alert_fixed_at,
    } %>
  <% end %>

  <% show_page_component.with_main do %>
    <%= render DependabotAlerts::DependencyUpdateSummaryComponent.new(alert: alert) %>
    <% if existing_dismissal_request %>
      <%= render(Primer::Beta::Flash.new(scheme: :default, test_selector: "dismissal-request-status", classes: "tmp-mb-3 tmp-mt-3")) do %>
        <%= render(Primer::Beta::Octicon.new(icon: "hourglass")) %>
        <% if existing_dismissal_request.status == "pending" || existing_dismissal_request.compute_status == Exemptions::ExemptionEvaluator::EvaluationResult::Pending %>
          A request to dismiss this alert is pending review.
          <% if existing_dismissal_request.requester %>
            Requested by <%= profile_link existing_dismissal_request.requester, { class: "text-bold" } %>
            <%= render Primer::Beta::RelativeTime.new(datetime: existing_dismissal_request.created_at, tense: :past) %>.
          <% end %>
        <% elsif existing_dismissal_request.status == "cancelled" %>
          The dismissal request for this alert was cancelled.
        <% end %>
      <% end %>
    <% end %>
    <%= render DependabotAlerts::TransitivePathsLoaderComponent.new(alert: alert) %>
    <%= render Primer::Beta::BorderBox.new(style: (malware? && malware_frontend_enabled? ? "border-bottom-left-radius: 0; border-bottom-right-radius: 0;" : nil)) do |border_box| %>
      <% border_box.with_header(display: :flex, direction: :column, px: 5) do %>
        <div class="d-none d-sm-block"><%# Default display w/ 3 columns and labels above values: %>
          <div class="d-flex gutter text-small color-fg-muted mb-1">
            <div class="col-5">Package</div>
            <div class="col-4">Affected versions</div>
            <div class="col-3">Patched version</div>
          </div>

          <div class="d-flex flex-items-start gutter">
            <div class="col-5 d-flex flex-items-center Truncate">
              <%= render Primer::Beta::Octicon.new(icon: "package", color: :muted, mr: 1) %>
              <div class="text-bold Truncate-text" <%= test_selector "package-name" %>><%= package_name %></div>
              <div class="color-fg-muted ml-1">(<span <%= test_selector "ecosystem" %>><%= ecosystem %></span>)</div>
            </div>

            <div class="col-4 d-flex flex-items-center">
              <div class="text-mono text-emphasized wb-break-word" <%= test_selector "affected-versions" %>><%= affected_versions %></div>
            </div>

            <% if patched_version %>
              <div class="col-3 d-flex flex-items-center Truncate">
                <div class="text-mono text-emphasized Truncate-text" <%= test_selector "patched-version" %>><%= patched_version %></div>
                <%=
                  render Primer::Beta::ClipboardCopy.new(
                    color: :muted,
                    classes: "Link--onHover",
                    value: patched_version,
                    "aria-label": "Copy the patched version",
                    "data-copy-feedback": "Copied!",
                    "data-tooltip-direction": "n",
                    display: :inline_block,
                    ml: 2,
                  )
                %>
              </div>
            <% else %>
              <div class="col-3 color-fg-subtle" <%= test_selector "no-patched-version" %>>None</div>
            <% end %>
          </div>
        </div>
        <div class="d-sm-none"><%# Responsive display w/ stacked values: %>
          <div class="mb-2">
            <div class="text-small color-fg-muted mb-1">Package</div>

            <div class="d-flex flex-items-center Truncate">
              <%= render Primer::Beta::Octicon.new(icon: "package", color: :muted, mr: 1) %>
              <div class="text-bold Truncate-text" <%= test_selector "package-name" %>><%= package_name %></div>
              <div class="color-fg-muted ml-1">(<span <%= test_selector "ecosystem" %>><%= ecosystem %></span>)</div>
            </div>
          </div>

          <div class="mb-2">
            <div class="text-small color-fg-muted mb-1">Affected versions</div>

            <div class="text-mono text-emphasized wb-break-word" <%= test_selector "affected-versions" %>><%= affected_versions %></div>
          </div>

          <div>
            <div class="text-small color-fg-muted mb-1">Patched version</div>

            <% if patched_version %>
              <div class="Truncate">
                <div class="text-mono text-emphasized Truncate-text" <%= test_selector "patched-version" %>><%= patched_version %></div>
                <%=
                  render Primer::Beta::ClipboardCopy.new(
                    color: :muted,
                    classes: "Link--onHover",
                    value: patched_version,
                    "aria-label": "Copy the patched version",
                    "data-copy-feedback": "Copied!",
                    "data-tooltip-direction": "n",
                    display: :inline_block,
                    ml: 2,
                  )
                %>
              </div>
            <% else %>
              <div class="col-3 color-fg-subtle" <%= test_selector "no-patched-version" %>>None</div>
            <% end %>
          </div>
        </div>
      <% end %>
      <% border_box.with_body(px: 5, pt: 3, pb: 5, test_selector: "description", style: (malware? && malware_frontend_enabled? ? "border-radius: 0;" : nil)) do %>
        <%= render Primer::Beta::Markdown.new do %>
          <%= vulnerability_markdown %>
        <% end %>
      <% end %>
    <% end %>
    <% if malware? && malware_frontend_enabled? %>
    <%= render Primer::Beta::BorderBox.new(mt: 0, style: "border-top-left-radius: 0; border-top-right-radius: 0; border-top: 0;") do |remediation_step_box| %>
      <% remediation_step_box.with_body(px: 5, pt: 3, pb: 5, test_selector: "additional-details") do %>
        <h5 class="mb-2">Remediation steps</h5>
        <p class="color-fg-muted tmp-mb-3">Follow the steps below before you close this alert.</p>
        <ol class="pl-0 list-style-none">
          <li class="d-flex flex-items-start mb-2">
            <span class="circle color-fg-muted color-bg-subtle text-small text-bold text-center flex-shrink-0 mr-2" style="width: 24px; height: 24px; line-height: 24px;">1</span>
            <span><%= "Downgrade or " if vulnerable_version_range.malware_subtype.to_s == "Version" %>Remove package from your repository</span>
          </li>
          <li class="d-flex flex-items-start mb-2">
            <span class="circle color-fg-muted color-bg-subtle text-small text-bold text-center flex-shrink-0 mr-2" style="width: 24px; height: 24px; line-height: 24px;">2</span>
            <span>Replace any deployments that include affected versions of this package</span>
          </li>
        </ol>
      <% end %>
    <% end %>
    <% end %>


    <%= render DependabotAlerts::TimelineComponent.new(alert: alert, current_user: current_user) %>
  <% end %>

  <% unless malware? && malware_frontend_enabled? %>
    <% if cvss_v4_vector %>
      <% show_page_component.with_severity_dependabot_next(
          cvss_vector: cvss_v4_vector,
          severity: alert_severity
        )%>
    <% else %>
      <% show_page_component.with_severity_dependabot(
          cvss_vector: cvss_v3_vector,
          severity: alert_severity
        )%>
    <% end %>

    <% if ghas_available? %>
      <% show_page_component.with_assignees_picker(
          type: :dependabot,
          repository: repository,
          alert_number: alert_number,
          current_user: current_user_assignee,
          assignees: assignees,
          readonly: !viewer_can_manage_alerts?,
          assignable_to_copilot: false, # Copilot support coming soon
        )%>
    <% else %>
      <% show_page_component.with_assignees_ghas_upsell(
          alert_type_label: "Dependabot alerts",
          learn_more_url: "https://gh.io/dependabot-alert-assignees",
        ) %>
    <% end %>

    <% if show_epss_score? %>
      <%= show_page_component.with_epss_score(
        vulnerability,
        vulnerability.cve_epss
      )%>
    <% end %>

    <% sidebar_tags.each do |tag_kwargs| %>
      <% show_page_component.with_tag(**tag_kwargs) %>
    <% end %>

    <% if runtime_risks.present? %>
      <% show_page_component.with_runtime_risks(risks: runtime_risks) %>
    <% end %>

    <% if related_fixable_alerts.any? %>
      <% show_page_component.with_sidebar_section(title: "Related alerts", test_selector: "related-alerts") do %>
        <% related_fixable_alerts.each do |alert| %>
          <div class="Truncate mb-1">
            <%= render Primer::Beta::Link.new(**related_alert_link_attributes(alert)) do %>
              <%= render Primer::Beta::Octicon.new(icon: "shield") %>
              <%= alert.title %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if malware? && malware_frontend_enabled? %>
    <% show_page_component.with_pre_cwe_sidebar_section(title: "Malware type") do %>
      <%= render(Primer::Beta::Label.new(scheme: :secondary, test_selector: "malware-type")) { vulnerable_version_range.malware_subtype.to_s } %>
    <% end %>
  <% end %>

  <% show_page_component.with_cwe_section(cwe_numbers: cwes.map(&:number), show_no_cwes_message: true, scheme: :label) %>
  <% unless malware? && malware_frontend_enabled? %>
    <% show_page_component.with_sidebar_section(title: "CVE ID") do %>
      <% if cve_id %>
        <%= render Primer::Box.new(test_selector: "cve-id").with_content(cve_id) %>
      <% else %>
        <%= render Primer::Box.new(color: :subtle).with_content("No CVE") %>
      <% end %>
    <% end %>
  <% end %>

  <% show_page_component.with_sidebar_section(title: "GHSA ID") do %>
    <%= render Primer::Box.new(test_selector: "ghsa-id").with_content(ghsa_id) %>
  <% end %>

  <% if malware? && malware_frontend_enabled? %>
    <% show_page_component.with_sidebar_section(title: "Source code") do %>
      <% if vulnerability.source_code_location.present? %>
        <%= render Primer::Beta::Link.new(href: vulnerability.source_code_location, scheme: :primary, test_selector: "source-code") do %>
          <%= vulnerability.source_code_location %>
        <% end %>
      <% else %>
        <%= render Primer::Box.new(color: :subtle, test_selector: "source-code").with_content("No known source code") %>
      <% end %>
    <% end %>
  <% end %>

  <% if innersource? %>
    <% show_page_component.with_sidebar_section(title: "External ID") do %>
      <% if vulnerability.external_id.present? %>
        <%= render Primer::Box.new(test_selector: "external-id").with_content(vulnerability.external_id) %>
      <% else %>
        <%= render Primer::Box.new(color: :subtle).with_content("No External ID") %>
      <% end %>
    <% end %>
  <% else %>
    <% show_page_component.with_sidebar_section do %>
      <%= render Primer::Beta::Link.new(display: :flex, align_items: :center, href: global_advisory_path(ghsa_id), scheme: :primary, font_weight: :bold, underline: false, test_selector: "advisory-link", classes: "tmp-mb-3") do %>
        <%= render Primer::Beta::Octicon.new(icon: "shield-lock", mr: 1) %>
        See advisory in GitHub Advisory Database
      <% end %>

      <%= render Primer::Beta::Link.new(display: :flex, align_items: :center, href: global_advisory_dependabot_alerts_path(ghsa_id), scheme: :primary, font_weight: :bold, underline: false, test_selector: "affected-repositories-link", classes: "tmp-mb-3") do %>
        <%= render Primer::Beta::Octicon.new(icon: "repo", mr: 1) %>
        See all of your affected repositories
      <% end %>

      <div class="color-fg-muted">
        See something to contribute?

        <%= render Primer::Beta::Link.new(display: :flex, align_items: :center, href: contribute_url(ghsa_id), test_selector: "advisory-link-improvement", data: contribute_analytic_attributes, classes: "tmp-mb-3") do %>
          Suggest improvements for this advisory on the GitHub Advisory Database.
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
