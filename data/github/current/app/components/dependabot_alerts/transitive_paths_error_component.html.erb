<%= render Primer::Beta::BorderBox.new(mb: 3, test_selector: "transitive-paths-error") do |component| %>
    <% component.with_body(display: [:block, :flex], align_items: :flex_start) do %>
      <%= render(Primer::Beta::Octicon.new(:alert, size: :medium, color: :muted)) %>
      <%= render(Primer::Box.new(flex: :auto, ml: [0, 2])) do %>
        <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4, font_weight: :semibold, mb: 2) do %>
          Transitive paths cannot be loaded
        <% end %>
        <p>
          <%= message %>
        </p>
      <% end %>
    <% end %>
  <% end %>
