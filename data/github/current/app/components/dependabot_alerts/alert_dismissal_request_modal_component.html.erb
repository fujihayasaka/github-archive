<%= render(Primer::Alpha::Dialog.new(**system_arguments, id: "dismissal-request-dialog", title: "Request to dismiss alert")) do |d| %>
  <% d.with_show_button(
       **button_system_arguments,
       size: :small,
       ml: 3
     ) do |b| %>
    <%= summary %>
  <% end %>
  <%= form_tag request_path, method: :put do %>
    <% if alert_number %>
      <%= hidden_field_tag "alert_number", alert_number %>
    <% end %>
    <%= render Primer::Alpha::RadioButtonGroup.new(
                 name: "Select a reason to dismiss",
                 py: 2
               ) do |component| %>
      <% dismissal_reasons.each_with_index do |(key, label), index| %>
        <% component.radio_button(
             value: key,
             name: "reason",
             label: label,
             checked: index.zero?,
             mt: 1,
             mb: 0,
             py: 0,
             data: { test_selector: "alert-dismissal-request-reason" },
           ) %>
      <% end %>
    <% end %>

    <%= render(Primer::Box.new(hidden: true, **bulk_items_system_arguments)) %>
    <%= render(Primer::Box.new(border: :top, px: 3, py: 2)) do %>
      <%= render(Primer::Alpha::TextArea.new(
            name: "comment",
            label: "Request comment",
            caption: "Explain why this alert should be dismissed",
            label_arguments: { color: :muted },
            data: { test_selector: "alert-dismissal-request-comment" },
            maxLength: 2048,
          )) %>
    <% end %>

    <%= render(Primer::Alpha::Dialog::Footer.new) do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "dismissal-request-dialog" })) { "Cancel" } %>
      <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit, test_selector: "alert-dismissal-request-submit")) { "Submit request" } %>
    <% end %>
  <% end %>
<% end %>
