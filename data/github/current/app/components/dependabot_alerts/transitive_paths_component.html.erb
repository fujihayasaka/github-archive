<%= render Primer::Beta::BorderBox.new(mb: 3, px: 3, test_selector: "transitive-paths") do |component| %>
  <% component.with_body(display: [:block, :flex], align_items: :flex_start) do %>
    <%= render(Primer::Box.new(flex: :auto, ml: [0, 2])) do %>
      <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4, font_weight: :normal, mb: 2) do %>
        Transitive dependency <strong><%= package_name %> <%= requirements %></strong> is introduced via
      <% end %>
      <div>
        <ul class="list-style-none border-left pl-2">
          <% transitive_paths.each do |dependency| %>
            <li>
              <%= dependency.package_name %> <%= format_requirements(dependency.requirement) %>
              <%= render(Primer::Beta::Octicon.new(icon: "triangle-right", size: :small)) %>
              <% if dependency.relationship == :ANCESTOR %>
                <span>
                  ...
                  <%= render(Primer::Beta::Octicon.new(icon: "triangle-right", size: :small)) %>
                </span>
              <% end %>
              <%= package_name %> <%= requirements %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
<% end %>
