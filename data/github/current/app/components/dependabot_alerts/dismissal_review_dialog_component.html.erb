<%= render Primer::Alpha::Dialog.new(
  id: "dependabot-dismissal-review-dialog-#{timeline_event.request_id}",
  size: :medium_portrait,
  title: "Review dismissal request",
  aria_described_by: "review-request-description",
) do |dialog| %>
  <% dialog.with_show_button(
      scheme: :primary,
      tag: :summary,
      size: :small,
      test_selector: "review-dismissal-request-button",
      aria: { label: "Review dismissal request" },
    ) do %>Review request<% end %>

  <% dialog.with_body do %>
    <p class="f5" id="review-request-description">
      Please provide feedback for your review decision.
    </p>

    <%= form_with url: dismissal_request_review_path, local: true, method: :put, id: "review-form-#{timeline_event.request_id}", data: { turbo: false } do |form| %>
      <%= form.hidden_field :request_id, value: timeline_event.request_id %>
      <%= form.hidden_field :alert_number, value: alert.number %>

      <div class="form-group">
        <label>
          Comment
        </label>
        <%= form.text_area :message,
            placeholder: "Feedback to go with your review...",
            class: "form-control width-full",
            "aria-label": "Review comment",
            rows: 3 %>
      </div>

      <fieldset>
        <legend class="sr-only">Review decision</legend>
        <div class="form-group">
          <div class="form-checkbox">
            <%= form.radio_button :status, "deny", id: "action-deny-#{timeline_event.request_id}", required: true, class: "form-control-radio" %>
            <label for="action-deny-<%= timeline_event.request_id %>" class="form-control-label">
              <span class="text-bold">Deny request</span>
              <div class="color-fg-muted f6">Submit feedback on why alert cannot be dismissed</div>
            </label>
          </div>
        </div>
        <div class="form-group">
          <div class="form-checkbox">
            <%= form.radio_button :status, "approve", id: "action-approve-#{timeline_event.request_id}", required: true, class: "form-control-radio" %>
            <label for="action-approve-<%= timeline_event.request_id %>" class="form-control-label">
              <span class="text-bold">Approve request</span>
              <div class="color-fg-muted f6">Allow alert to be dismissed</div>
            </label>
          </div>
        </div>
      </fieldset>
    <% end %>
  <% end %>

  <% dialog.with_footer do %>
    <%= render Primer::Beta::Button.new(
        scheme: :secondary,
        data_dismiss_dialog: ""
      ) do %>
      Cancel
    <% end %>
    <%= render Primer::Beta::Button.new(
        scheme: :primary,
        type: :submit,
        form: "review-form-#{timeline_event.request_id}"
      ) do %>
      Submit review
    <% end %>
  <% end %>
<% end %>
