<% list_padding = { p: 2 } %>

<% if selected_items.size > 1 %>
  <% list_padding = { p: 0, px: 2, pb: 2 } %>
  <%= render Primer::Beta::Link.new(
        classes: "btn-link tmp-mt-2 tmp-ml-3",
        href: dependabot_alerts_path(q: query_string_without(filter_type.to_sym)),
        role: "button",
        test_selector: "alerts-#{filter_type}-clear-filter"
      ) do |c| %>
    <% c.with_leading_visual_icon(icon: :"x-circle-fill", aria: { label: "Clear filters" }) %>
    Clear all selections
  <% end %>
<% end %>

<%= render(Primer::Alpha::SelectPanel::ItemList.new(
      select_variant: :multiple,
      aria_selection_variant: :selected,
      aria: { label: "alerts-#{filter_type}-label" },
      test_selector: "alerts-#{filter_type}-filter-component",
      **list_padding
    )) do |list| %>
  <% if selected_items.size > 1 %>
    <% list.with_divider %>
  <% end %>
  <% @item_list.each do |result| %>
    <% list.with_item(
         label: result[:label],
         href: dependabot_alerts_path(q: filter_query(result[:slug])),
         active: selected_items.include?(result[:slug]),
         test_selector: "alerts-#{filter_type}-filter",
       ) do |item| %>
      <% item.with_trailing_visual_counter(count: result[:count].to_i, hide_if_zero: true, test_selector: "alerts-#{filter_type}-item-count") %>
    <% end %>
  <% end %>
<% end %>

<% if @has_more_items %>
  <%= render(Primer::Alpha::Overlay::Footer.new(align_content: :center, show_divider: true)) do %>
    <%= render Primer::Beta::Text.new(tag: :span, font_size: :small, color: :muted, font_weight: :normal) do %>
      Showing top results. Search for more options.
    <% end %>
  <% end %>
<% end %>
