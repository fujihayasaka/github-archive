<%= render(Primer::Beta::BorderBox.new(test_selector: "models-user-billing-enablement-component")) do |component| %>
  <% component.with_body do %>
    <h3 class="mb-2">Additional Models usage</h3>
    <div class="d-flex flex-justify-between mb-3">
      <p class="col-10 color-fg-muted mb-0" <%= test_selector("models-billing-summary") %>>
        If enabled, usage beyond the free tier will be billed per token based on model pricing from your Models budget.
      </p>
      <div>
      <%= render Primer::Alpha::ActionMenu.new(
          select_variant: :single,
          anchor_align: :end,
          id: "show_models_user_billing_menu",
          test_selector: "models-user-billing-enablement-menu",
          dynamic_label: true,
        ) do |menu| %>
            <% menu.with_show_button(test_selector: "models-user-billing-selection") do |button|
              button.with_trailing_action_icon(icon: :"triangle-down")
              show_billing_text
            end %>
          <% menu.with_item(
            label: "Enabled",
            data: { value: "enabled" },
            active: billing_enabled?,
            href: billing_enablement_path,
            form_arguments: {
              method: :post,
              inputs: [{
                name: "enable_billing",
              }],
            },
          ) do |item| %>
            <% item.with_description.with_content("Allow additional paid models usage") %>
          <% end %>
          <% menu.with_divider %>
          <% menu.with_item(
            label: "Disabled",
            data: { value: "disabled" },
            active: !billing_enabled?,
            href: delete_billing_enablement_path,
            form_arguments: {
              method: :delete,
              inputs: [{
                name: "disable_billing",
              }],
            },
          ) do |item| %>
            <% item.with_description.with_content("Use models with rate limits") %>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class='pt-2'>
      <%= render(Primer::Beta::Link.new(href: "#", classes: 'pr-3')) { "View billing details" } %>
      <%= render(Primer::Beta::Link.new(href: "https://gh.io/github-models-pricing")) { "Models pricing" } %>
    </div>
    <% component.with_footer(bg: :subtle) do %>
      <%= render GitHubModels::Users::BillingUsageFooterComponent.new(billing_enabled: billing_enabled?) %>
    <% end %>
  <% end %>
<% end %>
