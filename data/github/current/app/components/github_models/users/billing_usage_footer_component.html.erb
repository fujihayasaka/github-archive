
<%= render Primer::Box.new(color: box_color, id: "github-models-user-billing-usage-footer") do %>
  <% if billing_enabled %>
    <%= render(Primer::Beta::Octicon.new(:alert, size: :small)) %>
    A budget greater than $0 is required to enable additional tokens.
    <%= render(Primer::Beta::Link.new(href: "#", color: box_color, underline: true)) { "Adjust Models budget" } %>.
  <% else %>
    You currently have
    <%= render Primer::Beta::Link.new(href: helpers.docs_url("github-models/rate-limits"), color: box_color, underline: true).with_content("free rate limits") %>.
    Enable paid usage to avoid interruption and add tokens.
  <% end %>
<% end %>
