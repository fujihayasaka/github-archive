
<%= render Primer::Box.new(color: :muted, test_selector: "github-models-user-billing-usage-footer") do %>
  <% if billing_enabled %>
    A budget greater than $0 is required for Models paid usage.
    <%= render(Primer::Beta::Link.new(href: settings_billing_budgets_url, underline: true)) { "Adjust Models budget" } %>.
    <div class="mt-2">
      If a budget is already set, no action is needed.
    </div>
  <% else %>
    <% if is_enterprise_managed_user %>
      <%= in_stafftools? ? "The" : "Your" %> enterprise has
    <% else %>
      <%= in_stafftools? ? "The user" : "You" %> currently <%= in_stafftools? ? "has" : "have" %>
    <% end %>
    <%= render Primer::Beta::Link.new(href: helpers.docs_url("github-models/rate-limits"), underline: true).with_content("free rate limits") %>.
    <% unless in_stafftools? %>
      <% if is_enterprise_managed_user %>
        Request your enterprise to turn on billing to avoid interruptions and enable paid usage.
      <% else %>
        Enable paid usage to avoid interruption and add tokens.
      <% end %>
    <% end %>
  <% end %>
<% end %>
