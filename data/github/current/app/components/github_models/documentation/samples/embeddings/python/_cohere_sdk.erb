import os
from cohere import Client

token = os.environ["GITHUB_TOKEN"]
endpoint = "<%= GitHub.models_gateway_url %>/inference"
model_name = "<%= model %>"

client = Client(
    base_url=endpoint,
    api_key=token,
)

response = client.embed(
    texts=["first phrase", "second phrase", "third phrase"],
    input_type="search_document",
    model=model_name,
)

for ix, item in enumerate(response.embeddings):
    length = len(item)
    print(
        f"data[{ix}]: length={length}, "
        f"[{item[0]}, {item[1]}, "
        f"..., {item[length-2]}, {item[length-1]}]"
    )
if response.meta:
    print(response.meta.billed_units)
