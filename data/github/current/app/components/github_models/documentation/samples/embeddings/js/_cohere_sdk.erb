import { CohereClient } from "cohere-ai";

const token = process.env["GITHUB_TOKEN"];
const endpoint = "<%= GitHub.models_gateway_url %>/inference";
const modelName = "<%= model %>";

export async function main() {

  const client = new CohereClient({
    environment: endpoint,
    token: token,
  });

  const response = await client.embed({
    model: modelName,
    input_type: "search_document",
    texts: ["first phrase", "second phrase", "third phrase"]
  });

  let index = 0;
  for (const item of response.embeddings) {
    let length = item.length;
    console.log(
       `data[${index}]: length=${length}, ` +
       `[${item[0]}, ${item[1]}, ` +
       `..., ${item[length - 2]}, ${item[length -1]}]`);
    index++;
  }
  if (response.meta){
    console.log(response.meta.billedUnits);
  }
}

main().catch((err) => {
  console.error("The sample encountered an error:", err);
});
