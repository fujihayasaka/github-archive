import os
from azure.ai.inference import ChatCompletionsClient
from azure.ai.inference.models import SystemMessage, UserMessage
from azure.core.credentials import AzureKeyCredential

endpoint = "<%= GitHub.models_gateway_url %>/inference"
model = "<%= model %>"
token = os.environ["GITHUB_TOKEN"]

client = ChatCompletionsClient(
    endpoint=endpoint,
    credential=AzureKeyCredential(token),
    <%- if exception_use_openai_preview_sdk -%>
    api_version="2024-12-01-preview",
    <%- end -%>
)

response = client.complete(
    messages=[
        <%- if supports_system_prompt && assistant_role == "developer" -%>
        {
            "role": "developer",
            "content": "<%= system_message_value %>",
        },
        <%- elsif supports_system_prompt -%>
        SystemMessage("<%= system_message_value %>"),
        <%- end -%>
        UserMessage("What is the capital of France?"),
    ],
    <%- if supports_temperature -%>
    temperature=<%= temperature_value %>,
    <%- end -%>
    <%- if supports_top_p -%>
    top_p=<%= top_p_value %>,
    <%- end -%>
    <%- if supports_max_tokens -%>
    max_tokens=<%= max_tokens_value %>,
    <%- end -%>
    model=model
)

print(response.choices[0].message.content)
