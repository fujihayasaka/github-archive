using Azure;
using Azure.AI.Inference;


var endpoint = new Uri("https://models.inference.ai.azure.com");
var credential = new AzureKeyCredential(System.Environment.GetEnvironmentVariable("GITHUB_TOKEN"));
var model = "<%= model_name %>";

var client = new ChatCompletionsClient(
    endpoint,
    credential,
    new AzureAIInferenceClientOptions());

var requestOptions = new ChatCompletionsOptions()
{
    Messages =
    {
        <%- if supports_system_prompt && assistant_role != "developer" -%>
        new ChatRequestSystemMessage("You are a helpful assistant."),
        <%- end -%>
        new ChatRequestUserMessage("What is the capital of France?"),
    },
    <%- if supports_temperature-%>
    Temperature = 1.0f,
    <%- end -%>
    <%- if supports_top_p-%>
    NucleusSamplingFactor = 1.0f,
    <%- end -%>
    <%- if supports_max_tokens-%>
    MaxTokens = 1000,
    <%- end -%>
    Model = model
};

Response<ChatCompletions> response = client.Complete(requestOptions);
System.Console.WriteLine(response.Value.Content);
