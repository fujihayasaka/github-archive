using OpenAI;
using OpenAI.Chat;

var endpoint = new Uri("https://models.inference.ai.azure.com");
var credential = System.Environment.GetEnvironmentVariable("GITHUB_TOKEN");
var model = "<%= model_name %>";

var openAIOptions = new OpenAIClientOptions()
{
    Endpoint=endpoint
};

var client = new ChatClient(model, credential, openAIOptions);

List<ChatMessage> messages = new List<ChatMessage>()
{
    <%- if supports_system_prompt && assistant_role != "developer" -%>
    new SystemChatMessage("You are a helpful assistant."),
    <%- end -%>
    new UserChatMessage("What is the capital of France?"),
};

var requestOptions = new ChatCompletionOptions()
{
    <%- if supports_temperature-%>
    Temperature = 1.0f,
    <%- end -%>
    <%- if supports_top_p-%>
    TopP = 1.0f,
    <%- end -%>
    <%- if supports_max_tokens-%>
    MaxTokens = 1000
    <%- end -%>
};

var response = client.CompleteChat(messages, requestOptions);
System.Console.WriteLine(response.Value.Content[0].Text);
