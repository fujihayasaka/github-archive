<p class="mb-0">To use GitHub Models in your codebase, you first need to choose a provider and configure the authentication method. Select a provider below to continue:</p>

<div class="d-flex p-3 my-3 border rounded-2">
  <%= render Primer::Beta::Avatar.new(
    src: "/images/modules/marketplace/models/logo-github.svg",
    alt: "",
    size: 24,
    shape: :square,
    test_selector: "github-avatar"
  ) %>
  <div class="d-flex flex-column flex-lg-row gap-2">
    <div class="ml-2">
      <h3 class="f5 mt-0 mb-2">
        GitHub
        <%= render Primer::Beta::Label.new(
          tag: :span,
          size: :medium,
          inline: true,
          ml: 1,
        ).with_content("Get started for free") %></h3>
      <p class="mb-0 f6 fgColor-muted">
        Free access with <a href="<%= helpers.docs_url("github-models/rate-limits") %>" class="Link--inTextBlock">simple rate limits</a>. Enable billing for higher limits with paid models usage.
      </p>
    </div>
    <div>
      <%= render Primer::Beta::Button.new(tag: :a, href: token_link, size: :medium, classes: "no-underline", scheme: :primary) do
        "Create Personal Access Token"
      end %>
    </div>
  </div>
</div>

<div class="border rounded-2 mb-3">
  <div class="d-flex flex-justify-between p-3">
    <div class="d-flex flex-items-center">
      <%= render(Primer::Beta::Octicon.new(:key, size: :medium, classes: "border rounded-2 p-1")) %>
      <div class="ml-2">
        <p class="mb-0 f6 fgColor-muted">Your organization can also <a class="Link--inTextBlock" href="https://docs.github.com/github-models/github-models-at-scale/using-your-own-api-keys-in-github-models">set up external models providers by adding API keys</a>.</p>
      </div>
    </div>
  </div>
  <div class="d-flex flex-justify-between flex-1 color-bg-subtle p-3 border-top">
    <div class="d-flex">
      <%= render Primer::Beta::Avatar.new(
        src: "/images/modules/marketplace/models/logo-azure-aistudio.svg",
        alt: "",
        size: 24,
        shape: :square,
        test_selector: "azure-avatar"
      ) %>
      <div class="ml-2">
        <h3 class="f5 mt-0 mb-2">
          Azure AI
          <%= render Primer::Beta::Label.new(
            tag: :span,
            size: :medium,
            inline: true,
            ml: 1,
            classes: "fgColor-default",
          ).with_content("Pay as you go") %>
        </h3>
        <p class="mb-0 f6 fgColor-muted">Connect your Azure subscription to access models. <a class="Link--inTextBlock" href="<%= azure_link %>">Get Azure AI key</a>.</p>
      </div>
    </div>
  </div>
</div>
