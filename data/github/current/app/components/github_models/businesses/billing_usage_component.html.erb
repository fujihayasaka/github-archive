<div class="mt-4">
  <h2 class="mb-2">Billing</h2>

  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% component.with_body do %>
      <h3 class="mb-2">Models paid usage</h3>
      <div class="d-flex flex-justify-between">
        <p class="col-10 color-fg-muted mb-0" <%= test_selector("models-billing-summary") %>>
          If enabled, models usage will be billed per token based on model pricing from your Model's budget.
        </p>
        <div>
          <% if business.can_enable_models_billing? %>
            <%= render(Primer::Alpha::ActionMenu.new(
              select_variant: :single,
              dynamic_label: true,
              overlay_arguments: { size: :small },
              test_selector: "models-billing-enablement-action-menu")
            ) do |menu| %>
              <% menu.with_show_button do |button| %>
                <% button.with_trailing_action_icon(icon: :"triangle-down") %>
                <%= business.models_billing_enabled? ? "Enabled" : "Disabled" %>
              <% end %>
              <% menu.with_item(
                label: "Enabled",
                active: business.models_billing_enabled?,
                href: href,
                form_arguments: {
                  method: :post,
                  name: "enable_models_billing",
                  value: "on"
                }
              ) %>
              <% menu.with_item(
                label: "Disabled",
                active: !business.models_billing_enabled?,
                href: href,
                form_arguments: {
                  method: :post,
                  name: "enable_models_billing",
                  value: "off"
                }
              ) %>
            <% end %>
          <% else %>
            <div class="color-fg-muted mb-2">
              <%= primer_octicon(:"shield-lock") %>
              Disabled
            </div>
          <% end %>
        </div>
      </div>
      <div class="d-flex gap-2">
        <%= render Primer::Beta::Link.new(
          href: enterprise_billing_usage_path(slug: business, query: "product:models"),
          underline: true,
        ).with_content("View billing details") %>
        <%= render(Primer::Beta::Link.new(href: "https://gh.io/github-models-pricing", underline: true)) { "Models pricing" } %>
      </div>
      <% if !business.models_billing_disabled_by_non_payment_method_reason? && business.payment_method_required? %>
        <div class="mt-3">
          <%= render(Primer::Beta::Octicon.new(:alert, size: :small, color: :attention)) %>
          <%= render(Primer::Beta::Text.new(tag: :span, color: :attention)) { "To enable Models paid usage, a payment method is needed." } %>
          <% if business.invoiced? %>
            <%= render(Primer::Beta::Link.new(href: "#{GitHub.enterprise_web_url}/contact", color: :attention, underline: true)) { "Contact sales to add payment method." } %>
          <% else %>
            <%= render(Primer::Beta::Link.new(href: settings_billing_tab_enterprise_path(business, tab: :payment_information), color: :attention, underline: true)) { "Add payment method." } %>
          <% end %>
        </div>
      <% end %>
      <% component.with_footer(bg: :subtle) do %>
        <%= render partial: 'github_models/businesses/billing_usage_footer', locals: { billing_enabled:, business: } %>
      <% end %>
    <% end %>
  <% end %>
</div>
