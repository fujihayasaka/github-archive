<div class="mt-4">
  <h2 class="mb-2">Custom models</h2>

  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% component.with_body do %>
      <h3 class="mb-2">Enable custom models</h3>
      <div class="d-flex flex-justify-between">
        <p class="col-10 color-fg-muted mb-0" <%= test_selector("custom-models-summary") %>>
          Enable to allow your organizations to configure and use custom models via API key. When using custom models, GitHub is allowed to share your data with third-party services, including Azure and OpenAI, using your provided key. <%= render(Primer::Beta::Link.new(
            href: "https://docs.github.com/enterprise-cloud@latest/copilot/managing-copilot/managing-github-copilot-in-your-organization/customizing-copilot-for-your-organization/creating-a-custom-model-for-github-copilot",
            underline: true
          )) { "Learn more about custom models" } %>.
        </p>
        <div>
          <%= render(Primer::Alpha::ActionMenu.new(
            select_variant: :single,
            dynamic_label: true,
            overlay_arguments: { size: :small }
          )) do |menu| %>
            <% menu.with_show_button do |button| %>
              <% button.with_trailing_action_icon(icon: :"triangle-down") %>
              <%= business.custom_models_enabled? ? "Enabled" : "Disabled" %>
            <% end %>
            <% menu.with_item(
              label: "Enabled",
              active: business.custom_models_enabled?,
              href: settings_models_update_custom_models_enterprise_path(business),
              form_arguments: {
                method: :put,
                name: "enable_custom_models",
                value: "on"
              }
            ) %>
            <% menu.with_item(
              label: "Disabled",
              active: !business.custom_models_enabled?,
              href: settings_models_update_custom_models_enterprise_path(business),
              form_arguments: {
                method: :put,
                name: "enable_custom_models",
                value: "off"
              }
            ) %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
