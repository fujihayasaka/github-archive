<%
  label_attrs = {
    role: "menuitemradio",
    "aria-checked": checked,
    class: "SelectMenu-item pages-build-type-selector-item text-normal",
    tabindex: "0",
  }
  label_attrs[:"aria-disabled"] = "true" if disabled?
%>
<%= content_tag(:label, label_attrs) do %>
  <%
    input_attrs = {
      type: "radio",
      name: "build_type",
      value: build_type.to_s,
      autocomplete: "off",
      hidden: "hidden",
    }
    input_attrs[:disabled] = "disabled" if disabled?
    input_attrs[:checked] = "checked" if checked
    if @data
      @data.each { |key, value| input_attrs[:"data-#{key.to_s.dasherize}"] = value }
    end
  %>
  <%= tag(:input, input_attrs) %>
  <%= render Primer::Beta::Octicon.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
  <div>
    <div class="f5 text-bold">
      <%= name %>
    </div>
    <div class="color-fg-muted mt-1">
      <%= description %>
    </div>
    <% if disabled? %>
      <div class="color-fg-attention">
        Disabled for this repo
      </div>
    <% end %>
  </div>

  <span hidden data-filter-item-text data-menu-button-text>
    <%= name %>
  </span>
<% end %>
