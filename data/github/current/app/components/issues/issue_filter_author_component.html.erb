
<a class="SelectMenu-item" aria-checked="<%= @selected %>" role="menuitemradio" href="<%= @url %>">
  <%= primer_octicon(:check, classes: "SelectMenu-icon SelectMenu-icon--check") %>
  <%= avatar_for @user, 20, class: "avatar flex-shrink-0 mr-2", loading: :lazy %>
  <% if @user.display_login_legacy == Apps::Privileged::CopilotSWEAgent::SLUG %>
    <strong class="mr-2">Copilot<%= " " if bot_identifier(@user).present? %><%= bot_identifier(@user) %></strong>
  <% else %>
    <strong class="mr-2"><%= @user.display_login_legacy %><%= " " if bot_identifier(@user).present? %><%= bot_identifier(@user) %></strong>
  <% end %>
  <span class="color-fg-muted css-truncate css-truncate-overflow"><%= @user.profile_name %></span>
</a>
