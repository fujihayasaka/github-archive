<li>
  <react-partial-anchor>
    <%= render(Primer::Beta::Button.new(
      id: "issue-metadata-suggestion-staffbar-component",
      size: :small,
      scheme: :link,
      color: :on_emphasis,
      "data-target": "react-partial-anchor.anchor",
      "aria-label": "Issue Metadata Suggestion Staffbar Component",
    )) do |c| %>
      <% c.with_tooltip(text: "Get metadata suggestions from copilot for issue ") %>
      <%= render(Primer::Beta::Octicon.new(icon: :copilot, size: :small)) %>
    <% end %>
    <template data-target="react-partial-anchor.template">
      <%= render_react_partial(
        name: "metadata-suggestion-staffbar-component",
        props: create_props,
        disable_ssr: true
      ) %>
    </template>
  </react-partial-anchor>
</li>
