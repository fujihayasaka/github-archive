<%= render_nothing_on_error do %>
  <section aria-label="Private Issue Types Deprecation Banner">
    <%= render Primer::Alpha::Banner.new(
      scheme: :warning,
      icon: :alert,
      full: true,
      mb: 2,
      name: "private_issue_types_deprecation_banner",
      test_selector: "private-issue-types-deprecation-banner",
      classes: "js-notice"
    ) do |banner| %>
      <% banner.with_action_content(display: :flex, align_items: :center) do %>
        <%= form_tag dismiss_notice_path(DEPRECATION_NOTICE), class: "js-notice-dismiss" do %>
          <%= render Primer::Beta::IconButton.new(
            type: :submit,
            ml: 1,
            scheme: :invisible,
            icon: :x,
            aria: { label: "Hide this notice" }
          ) %>
        <% end %>
      <% end %>
      <%= banner_message %>
      <%= link_to learn_more_link_text, learn_more_link, class: "Link--inTextBlock", target: "_blank" %>
    <% end %>
  </section>
<% end %>
