<% if pull.repository&.copilot_show_swe_agent_card_react_component?(current_user) %>
  <%= render_react_partial name: "copilot-coding-agent-status", props: react_payload %>
<% else %>
  <%= stylesheet_link_tag 'components/copilot-swe-agent-component' %>

  <%= link_to session_path, class: "fgColor-default rounded-2 no-underline mb-3 border d-flex flex-items-stretch copilot-card", aria: { label: "View SWE Agent details" } do %>
    <!-- Left: Icon -->
    <div class="mr-2 fgColor-muted d-flex flex-column flex-content-start flex-items-start">
      <%= copilot_icon %>
    </div>

    <!-- Middle: Text block -->
    <div class="flex-1">
      <p class="mb-0 fgColor-default text-semibold"><%= session_status_text %></p>
      <p class="mb-0 fgColor-muted text-small">
        <% if relative_time? %>
          started <relative-time format="elapsed" datetime="<%= created_at_iso8601 %>"></relative-time> ago
        <% else %>
          <%= time_description %>
        <% end %>
      </p>
    </div>

    <!-- Right: Action link -->
    <div class="ml-3 d-flex flex-column flex-justify-start">
      <div class="flex-self-start">
        <%= render(Primer::Beta::Octicon.new(
          :"arrow-both",
          classes: "fgColor-muted",
          style: "transform: rotate(315deg);"
        )) %>
      </div>
    </div>
  <% end %>
<% end %>
