<%= render Primer::Box.new(mb: @show_incomplete_data_warning ? 1 : 3, display: :flex, justify_content: :space_between, style: "gap: 1em;") do %>
  <% if @show_plaid_ui_filters %>
    <% content_for :filter_box do %>
      <details class="details-reset details-overlay flex-shrink-0" id="filters-select-menu">
        <%= render Primer::Beta::Button.new(tag: :summary, classes: "color-border-emphasis border-right-0 rounded-right-0") do |c| %>
          Filters
          <% c.with_trailing_action_icon(icon: "triangle-down") %>
        <% end %>
        <details-menu class="SelectMenu" role="menu"><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
          <div class="SelectMenu-modal">
            <div class="SelectMenu-header">
              <h3 class="SelectMenu-title">Filter alerts</h3>
              <button class="SelectMenu-closeButton" type="button" data-toggle-for="filters-select-menu">
                <%= render Primer::Beta::Octicon.new(icon: "x", aria: { label: "Close menu", hidden: false }) %>
              </button>
            </div>
            <div class="SelectMenu-list" data-pjax="#repo-content-pjax-container" data-turbo-frame="repo-content-turbo-frame">
              <a
                class="SelectMenu-item"
                role="menuitemradio"
                <% bypassed_query = "is:open #{results_category_query} bypassed:true" %>
                href="?<%= { query: bypassed_query }.to_query %>"
                aria-checked="<%= bypassed_query == params[:query] %>"
              >
                <%= render Primer::Beta::Octicon.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
                Bypassed push protection
              </a>
              <a
                class="SelectMenu-item"
                role="menuitemradio"
                <% active_query = "is:open #{results_category_query} validity:active" %>
                href="?<%= { query: active_query }.to_query %>"
                aria-checked="<%= active_query == params[:query] %>"
              >
                <%= render Primer::Beta::Octicon.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
                Active secrets
              </a>
              <a
                class="SelectMenu-item"
                role="menuitemradio"
                <% public_leak_query = "is:open #{results_category_query} is:publicly-leaked" %>
                href="?<%= { query: public_leak_query }.to_query %>"
                aria-checked="<%= public_leak_query == params[:query] %>"
              >
                <%= render Primer::Beta::Octicon.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
                Publicly leaked secrets
              </a>
              <a
                class="SelectMenu-item"
                role="menuitemradio"
                <% multi_repository_query = "is:open #{results_category_query} is:multi-repository" %>
                href="?<%= { query: multi_repository_query }.to_query %>"
                aria-checked="<%= multi_repository_query == params[:query] %>"
              >
                <%= render Primer::Beta::Octicon.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
                Multi-repository secrets
              </a>
              <a
                class="SelectMenu-item"
                role="menuitemradio"
                <% password_query = "is:open secret-type:password" %>
                href="?<%= { query: password_query }.to_query %>"
                aria-checked="<%= password_query == params[:query] %>"
              >
                <%= render Primer::Beta::Octicon.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
                Passwords with Copilot secret scanning
              </a>
              <a class="SelectMenu-item" role="menuitemradio" href="<%= GitHub.help_url %>/code-security/secret-scanning/managing-alerts-from-secret-scanning/viewing-alerts#filtering-alerts" target="_blank" rel="noopener noreferrer">
                <%= render Primer::Beta::Octicon.new(icon: "link-external", mr: 2) %>
                <strong>View advanced search syntax</strong>
              </a>
            </div>
          </div>
        </details-menu>
      </details>
    <% end %>
  <% end %>

  <%= render Primer::Box.new(flex: 1, display: :flex) do %>
    <%= render(
      SecretScanning::AlertCentricView::SearchComponent.new(
        user: @user,
        scope: @scope,
        placeholder: "Filter secret scanning alerts",
        pjax: true,
        query: @query,
        show_org_level_suggestions: @show_org_level_suggestions,
        show_business_level_suggestions: @show_business_level_suggestions,
        show_user_repo_suggestions: @show_user_repo_suggestions,
        filter_suggestions_path: @filter_suggestions_path,
        custom_patterns_available: @custom_patterns_available,
        show_results_category_suggestions: @show_results_selector,
        plaid_ui_filters_enabled: @show_plaid_ui_filters,
        search_context: content_for(:filter_box),
      )
    ) %>
  <% end %>

  <% if @menu_data_list.present? %>
    <%= render Primer::Box.new(display: :flex, align_items: :center, style: "height: 32px;") do %>
      <% @menu_data_list.each do |menu_data| %>
        <%= render SecurityCenter::SelectPanelComponent.new(menu_data) %>
      <% end %>
    <% end %>
  <% end %>

  <% if @show_results_selector && !@show_plaid_ui_filters %>
    <%= render(Primer::Alpha::TabNav.new(label: "Filter by results category", classes: "SegmentedControl border-bottom-0", h: :full, mb: 0)) do |component| %>
      <% component.with_tab(
        href: default_results_href,
        selected: default_results_selected?,
        tag: "button",
        test_selector: "secret-scanning-results-category-selector-default",
        border_radius: 2,
        classes: "Button--invisible Button--medium Button Button--fullWidth Button--invisible-noVisuals"
      ) do |tab| %>
        <% tab.with_text { "Default" } %>
      <% end %>
      <% component.with_tab(
        href: generic_results_href,
        selected: generic_results_selected?,
        tag: "button",
        test_selector: "secret-scanning-results-category-selector-generic",
        border_radius: 2,
        classes: "Button--invisible Button--medium Button Button--fullWidth Button--invisible-noVisuals"
      ) do |tab| %>
          <% tab.with_text { "Generic" } %>
          <% unless generic_results_count.nil? %>
            <% tab.with_counter(count: generic_results_count) %>
          <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @show_incomplete_data_warning %>
  <%= render ::SecurityCenter::LimitedRepoWarningComponent.new(display: :block, mb: 3, test_selector: "secret-scanning-org-repo-limit-exceeded") %>
<% end %>

<%= render(
  SecretScanning::AlertCentricView::TableComponent.new(
    alerts: @alerts,
    blankslate: blankslate,
    closed_alert_count: @closed_alert_count,
    filter_option_paths: @filter_option_paths,
    open_alert_count: @open_alert_count,
    page: @page,
    query: @query,
    scope: @scope,
    custom_patterns_available: @custom_patterns_available,
    show_plaid_ui_filters: @show_plaid_ui_filters,
    locked_repos: @locked_repos,
  )
) %>
