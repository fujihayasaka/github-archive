<%= render(Primer::Beta::Blankslate.new(
  spacious: true,
  test_selector: "security-center-alert-centric-views-secret-scanning-alerts-blankslate-no-repos-with-secret-scanning-enabled",
  data: {hpc: ""}
)) do |component| %>
  <% component.with_visual_icon(icon: :key, height: 32) %>
  <% component.with_heading(tag: :h2).with_content("Secret scanning is not enabled in any repositories") %>
  <% component.with_description do %>
  Secret scanning protects your code by finding and blocking exposed passwords and sensitive data in your repositories. Enable it in a repository to get started or apply a security configuration with secret scanning to turn it on organization-wide.
  <% end %>
  <% target_url = settings_org_security_products_path(@organization) %>
  <% component.with_secondary_action(
    href: target_url,
    underline: true,
    data: hydro_click_tracking_attributes("security_center.blankslate.click", {
      label: "Enable secret scanning with security configurations",
      target_url: target_url,
      view: "/orgs/#{@organization.display_login}/security/alerts/secret-scanning"
    })
  ).with_content("Enable secret scanning with security configurations") %>
<% end %>
