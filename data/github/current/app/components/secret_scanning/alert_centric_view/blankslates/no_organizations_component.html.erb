<%= render(Primer::Beta::Blankslate.new(
  spacious: true,
  test_selector: "security-center-alert-centric-views-secret-scanning-alerts-blankslate-no-organizations",
  data: {hpc: ""}
)) do |component| %>
  <% component.with_visual_icon(icon: :key, height: 32) %>
  <% component.with_heading(tag: :h2).with_content("Add a repository with code to see secret scanning alerts") %>
  <% component.with_description do %>
    Secret scanning protects your code by finding and blocking exposed passwords and sensitive data in your repositories. To put it to work, you'll need to create a repository in an organization and add code to it.
  <% end %>
  <% create_org_path = new_enterprise_organization_path(@business, intent: "secret-scanning-alerts") %>
  <% component.with_primary_action(
    href: create_org_path,
    data: hydro_click_tracking_attributes("security_center.blankslate.click", {
      label: "Create an organization",
      target_url: create_org_path,
      view: "/enterprises/#{@business.slug}/security/alerts/secret-scanning"
    })
  ).with_content("Create an organization") %>
  <% invite_org_path = new_enterprise_organization_invitation_path(@business, intent: "secret-scanning-alerts") %>
  <% component.with_secondary_action(
    href: invite_org_path,
    data: hydro_click_tracking_attributes("security_center.blankslate.click", {
      label: "Invite an organization",
      target_url: invite_org_path,
      view: "/enterprises/#{@business.slug}/security/alerts/secret-scanning"
    })
  ).with_content("Invite an organization") %>
<% end %>
