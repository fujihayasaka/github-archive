<%= render partial: "secret_scanning/alert_centric_view/blankslates/shield_animation_styles" %>

<%= render(
  Primer::Beta::Blankslate.new(
    classes: "blankslate-large",
    spacious: true,
    test_selector: test_selector,
  )
) do |component| %>
  <% component.with_visual_icon(
    icon: blankslate_icon,
    classes: icon_animation_class,
  ) %>
  <% component.with_heading(tag: :h2).with_content(blankslate_title) %>

  <% if QUERY_PARSER.has_duplicate_qualifiers?(@query) %>
    <% component.with_description do %>
      Try removing duplicate search terms, or
      <%= render(
        Primer::Beta::Link
          .new(
            data: { pjax: true },
            href: "?",
            classes: "Link--inTextBlock"
          )
          .with_content("clear filters")
      ) %>
      to view all of this <%= humanized_scope %>'s secret alerts.
    <% end %>
  <% else %>
    <% case @blankslate %>
    <% when SecretScanningControllerHelper::BLANKSLATE_NO_OPEN_SECRETS %>
      <% component.with_description.with_content("Your #{humanized_scope} doesn't have any unresolved secrets.") %>
    <% when SecretScanningControllerHelper::BLANKSLATE_NO_OPEN_OR_CLOSED_SECRETS %>
      <% component.with_description.with_content("As alerts are created, they’ll appear here.") %>
    <% when SecretScanningControllerHelper::BLANKSLATE_NO_GENERIC_MATCHES %>
      <% component.with_description do %>
        Visit your
        <%= render(
          Primer::Beta::Link
            .new(
              data: { pjax: true },
              href: get_security_analysis_settings_url,
              classes: "Link--inTextBlock"
            )
            .with_content("Advanced Security settings")
        ) %>
        to enable additional patterns.
      <% end %>
    <% when SecretScanningControllerHelper::BLANKSLATE_INVALID_QUERY %>
      <% component.with_description do %>
        Try removing invalid search terms, or
      <%= render(
        Primer::Beta::Link
          .new(
            data: { pjax: true },
            href: "?",
            classes: "Link--inTextBlock"
          )
          .with_content("clear filters")
      ) %>
      to view all of this <%= humanized_scope %>'s secret alerts.
      <% end %>
    <% when SecretScanningControllerHelper::BLANKSLATE_NO_MATCHES %>
      <% component.with_description do %>
        Try
        <%= render(
          Primer::Beta::Link
            .new(
              data: { pjax: true },
              href: "?",
              classes: "Link--inTextBlock"
            )
            .with_content("clearing filters")
        ) %>
        to view all of this <%= humanized_scope %>'s secret alerts.
      <% end %>
    <% when SecretScanningControllerHelper::BLANKSLATE_NO_ALERTS_ENABLE_ON_ALL_REPOS %>
      <% component.with_description do %>
        No secret leaks found in protected repositories, but some of your repositories are still at risk. As an <%= humanized_scope %> admin, you can make sure all of your <%= humanized_scope %>'s code is protected by applying a configuration with secret scanning to all repositories.
      <% end %>
      <% component.with_secondary_action(
        href: get_security_configurations_url,
        underline: true,
        data: enable_on_all_repos_hydro_click_data,
      ).with_content(enable_on_all_repos_cta_label) %>
    <% end %>
  <% end %>
<% end %>
