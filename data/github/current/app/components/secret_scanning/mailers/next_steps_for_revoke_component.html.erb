<%= render(Mail::ContainerComponent.new) do %>
  <div class="mt-4" style="border: 1px solid #E1E4E8;"></div>
  <div class="f4 text-left pt-4" style="font-weight: 500;" <%= test_selector("next-steps-for-revoke-heading") %>>Next steps</div>
  <%= render(Mail::RowComponent.new) do %>
    <%= render(Mail::ColumnComponent.new) do %>
      <div class="mt-4 d-flex" <%= test_selector("remediation-step-header") %>>
        <div class="pl-2 f5 text-left" <%= test_selector("remediation-step-message") %>>Ensure that your account security has not been compromised</div>
      </div>
      <%= render(Mail::ContainerComponent.new) do %>
        <%= render(SecretScanning::Mailers::RemediationSubStepComponent.new(
          link_url: "#{GitHub.help_url}/authentication/keeping-your-account-and-data-secure/preventing-unauthorized-access",
          link_text: "Review any unauthorized applications,",
          follow_up_text: "and remove any you don't recognize",
        ))%>
        <div class="mt-3 ml-5 d-flex" <%= test_selector("remediation-sub-step-flexbox") %>>
          <div class="mr-2">&#8226;</div>
          <div class="text-left" <%= test_selector("remediation-sub-step-text") %>>
            Review your security logs
            <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", test_selector: "remediation-sub-step-link", href: "#{GitHub.help_url}/authentication/keeping-your-account-and-data-secure/reviewing-your-security-log")) { "for your personal account" } %>
            and&nbsp;
            <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", test_selector: "remediation-sub-step-link", href: "#{GitHub.help_url}/admin/monitoring-activity-in-your-enterprise/reviewing-audit-logs-for-your-enterprise/identifying-audit-log-events-performed-by-an-access-token")) { "enterprise" } %>
          </div>
        </div>

      <% end %>
    <% end %>
  <% end %>
  <% if @alert_url.present? %>
    <%= render(Mail::ButtonComponent.new(
      text: "See alert details",
      url: @alert_url,
      classes: "btn-primary btn-large mt-4",
    )) %>
  <% end %>
<% end %>
