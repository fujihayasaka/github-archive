<% matching_repositories.each do |repository| %>
  <%= render Primer::Beta::AutoComplete::Item.new(
    value: repository.id,
    font_size: :normal,
    test_selector: "autocomplete-suggestion-dry-run-repo",
    ) do |i| %>
    <% i.with_leading_visual_icon(icon: repository.repo_type_icon, test_selector: "autocomplete-suggestion-dry-run-repo-type-icon", color: :muted) %>
    <% i.with_description(color: :muted).with_content(repository.description.presence || 'no description') %>
    <% if @owner&.is_a?(Business) %>
      <b><%= repository.owner_display_login %></b>/<%= repository.name %>
    <% else %>
      <b><%= repository.name %></b>
    <% end %>
  <% end %>
<% end %>
<% if matching_repositories.empty? %>
  <%= render Primer::Beta::AutoComplete::Item.new(
      font_size: :normal,
      value: "no-repos",
      disabled: true,
      ) do |i| %>
        <p class="color-fg-muted m-0">
          No repositories found.
        </p>
    <% end %>
<% end %>
