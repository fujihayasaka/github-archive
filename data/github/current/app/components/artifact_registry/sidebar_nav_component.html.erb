<%= render(Primer::Beta::NavList.new(selected_item_id: @selected_tab, test_selector: "artifact-registry-sidebar-nav")) do |component|%>
  <% component.with_heading(title: "Packages", classes: "h3 tmp-mb-3 ml-2 pt-2") %>
  <% component.with_item(label: "GitHub Packages", selected_by_ids: :github_packages, href: org_packages_path(org: @org)) %>
  <% component.with_item(label: "Linked artifacts", selected_by_ids: :linked_artifacts, href: org_artifacts_path(org: @org)) %>
<% end %>
