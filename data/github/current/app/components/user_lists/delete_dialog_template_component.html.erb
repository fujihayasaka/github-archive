<%= render(Primer::Alpha::Dialog.new(
  title: "Delete list",
  id: "delete-list-dialog-#{user_list.id}",
  size: :medium_portrait,
)) do |dialog| %>
  <% dialog.with_body do %>
    <p>Are you sure you want to delete this list?</p>
    <% if user_list.item_count.nonzero? %>
      <p>You will still be able to view the <%= pluralize(user_list.item_count, "repository") %> in this list in your
      stars.</p>
    <% end %>
    <div class="d-flex mt-2 pt-2 border-top color-border-muted" style="gap: 8px;">
      <%= form_tag user_list_path(user_list.user_login, user_list), method: :delete, style: "flex: 1;" do %>
        <%= render Primer::Beta::Button.new(
          type: :submit,
          scheme: :danger,
          block: true,
        ).with_content("Delete") %>
      <% end %>
      <%= render Primer::Beta::Button.new(
        type: :button,
        "data-close-dialog-id": "delete-list-dialog-#{user_list.id}",
        block: true,
        style: "flex: 1;",
      ).with_content("Cancel") %>
    </div>
  <% end %>
<% end %>
