<%= render(Primer::Alpha::Dialog.new(
  title: "Create list",
  visually_hide_title: true,
  size: :medium_portrait,
  classes: details_classes,
)) do |dialog| %>
  <% dialog.with_header(show_divider: :true) do %>
    Create list
  <% end %>
  <% if summary %>
    <% dialog.with_show_button(scheme: button_scheme) do %>
      <%= summary %>
    <% end %>
  <% end %>

  <% dialog.with_body do %>
    <%= render(UserLists::CreateDialogFormComponent.new(repository_id: repository_id)) %>
  <% end %>
<% end %>
