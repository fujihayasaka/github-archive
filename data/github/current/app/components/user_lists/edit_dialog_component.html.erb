<%= render delete_dialog_template_component %>

<%= render(Primer::Alpha::Dialog.new(
  title: "Edit list",
  visually_hide_title: true,
  id: "edit-list-dialog-#{user_list.id}",
  classes: "js-edit-user-list-dialog js-follow-list",
  size: :medium_portrait,
)) do |dialog| %>
  <% dialog.with_header(show_divider: true) do %>
    Edit list
  <% end %>
  <% dialog.with_show_button do %>
    Edit list
  <% end %>

  <% dialog.with_body do %>
    <%= render(UserLists::EditDialogFormComponent.new(user_list: user_list)) %>
  <% end %>
<% end %>
