<% if FeatureFlag.vexi.enabled?(:userlist_as_selectpanel, current_user, default: false) %>
  <user-list-menu
    data-controller="user-list-menu"
    data-repository-id="<%= repo_id %>"
    data-update-url="<%= user_list_menu_update_url %>"
  >
    <%=
      render(Primer::Alpha::SelectPanel.new(
        fetch_strategy: :eventually_local,
        select_variant: :multiple,
        title: "Lists",
        anchor_align: :end,
        src: user_list_menu_src,
        classes: "BtnGroup-parent js-user-list-menu",
        id: menu_id,
        test_selector: "user-list-menu-button",
        show_filter: false,
        no_results_label: "You don't have any lists yet.",
        data: data.merge({ target: "user-list-menu.selectPanel" })
      )) do |panel| %>
      <% panel.with_show_button(
          icon: :"triangle-down",
          size: :small,
          group_item: true,
          px: 3,
          classes: "rounded-right-2 rounded-left-0",
          aria: { label: "Add this repository to a list" }
        )
      %>
      <% panel.with_footer do %>
        <%= render(Primer::Beta::Button.new(
          scheme: :primary,
          block: :full,
          disabled: !can_create_lists?,
          classes: "js-user-lists-create-trigger",
          data: {
            repository_id: repo_id
          }
        )) do %>
          <%= octicon("plus", size: :small) %>
          Create list
        <% end %>
      <% end %>
    <% end %>
  </user-list-menu>
  <%= render(UserLists::CreateDialogTemplateComponent.new) %>
<% else %>
  <%# erblint:counter DeprecatedComponentsCounter 1 %>
  <%=
    render(GitHub::MenuComponent.new(
      align: :right,
      src: user_list_menu_src,
      classes: "BtnGroup-parent js-user-list-menu",
      display: :flex,
      id: menu_id,
      test_selector: "user-list-menu-button",
      data: data
    )) do |menu|
  %><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
    <% menu.with_summary do %>
      <%= render(Primer::ButtonComponent.new(
        tag: :summary,
        variant: :small,
        group_item: true,
        px: 2,
        float: :none,
        aria: { label: "Add this repository to a list" },
      )) do %>
        <%= primer_octicon("triangle-down") %>
      <% end %>
    <% end %>
    <% menu.with_header do %>
      <h4 class="SelectMenu-title f5" id="user-lists-menu">Lists</h4>
    <% end %>
  <% end %>
<% end %>
