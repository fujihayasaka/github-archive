<%= render(UserLists::DialogFormComponent.new(user_list: user_list)) do |form| %>
  <% form.with_actions_list do %>
    <%= render(Primer::Alpha::CheckBox.new(
      label: "Private",
      name: "user_list[private]",
      value: "1",
      unchecked_value: "0",
      checked: user_list.private?,
      hidden_input: true,
      caption: "Enabling this makes the list visible only to you."
    )) do |c| %>
    <% end %>
    <div class="d-flex mt-2 pt-2 border-top color-border-muted">
      <%= render(Primer::Beta::Button.new(
        scheme: :danger,
        block: true,
        mr: 2,
        col: 6,
        id: "dialog-show-delete-list-dialog-#{user_list.id}",
        "data-show-dialog-id": "delete-list-dialog-#{user_list.id}",
        "data-close-dialog-id": "edit-list-dialog-#{user_list.id}",
      ).with_content("Delete list")) %>
      <%= render(Primer::Beta::Button.new(
        scheme: :primary,
        type: :submit,
        block: true,
        col: 6,
        disabled: !user_list.valid?,
        "data-disable-invalid": true,
        # We can't use data-disable-with here because the button is re-enabled immediately after the response is received,
        # but before we have a chance to handle it and redirect or swap out the form contents. This results in a
        # disorienting jitter.
        "data-submitting-message": "Saving...",
      ).with_content("Save list")) %>
    </div>
  <% end %>
<% end %>
