<%= render(
  Primer::Alpha::ActionList.new(
    role: "list",
    show_dividers: false,
    aria: {
      label: "Affected Branches"
    })
  ) do |component| %>
  <% affected_branches.each_with_index do |branch, i| %>
    <% component.with_item(
      content_arguments: {
        style: "justify-items:start",
        data: { "show-dialog-id": stale_alerts_dialog_id(index: i), target: "modal-dialog.show-button" }
      },
      ) do |item| %>
      <% item.with_leading_visual_icon(
        icon: icon(affected_branch_info: branch),
        color: color(affected_branch_info: branch)
      ) %>
      <% if num_analysis_origins(affected_branch_info: branch) > 1 %>
        <% item.with_trailing_visual_counter(
          count: num_analysis_origins(
            affected_branch_info: branch
          )
        ) %>
      <% end %>
      <% fix_config = earliest_fix_config(affected_branch_info: branch) %>
      <% introduction_date = first_created_at(affected_branch_info: branch) %>
      <% if fix_config.present? %>
        <% item.with_description(test_selector: "affected_branch_fixed") do %>
          Fixed <%= time_ago_in_words(fix_config[:fixed_at]) %> ago <%= fix_location_text(fix_config[:fixed_at_oid]) %>
        <% end %>
      <% elsif introduction_date.present? %>
        <% item.with_description(test_selector: "affected_branch_introduced") do %>
          First detected <%= time_ago_in_words(introduction_date) %> ago
        <% end %>
      <% end %>
      <div>
        <span class="branch-name f6"><%== branch[:name].dup.force_encoding(Encoding::UTF_8).scrub! %></span>
        <% if branch[:default_branch?] %>
          <%== render(Primer::Beta::Label.new(color: :muted)) { "default" } %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end  %>
