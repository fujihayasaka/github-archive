<div <%= test_selector("runtime-risks-section") %>>
  <div class="d-flex flex-items-center mb-2">
    <h3 class="h6 color-fg-muted mr-1 mb-0">Runtime risks</h3>
    <%= render(Primer::Alpha::Overlay.new(title: "Runtime Risks", anchor_offset: :spacious, anchor_side: :outside_top)) do |overlay| %>
      <% overlay.with_show_button(icon: :info, scheme: :invisible, size: :small, show_tooltip: true, "aria-label": "About runtime risks") %>
      <% overlay.with_header %>
      <% overlay.with_body(p: 3, font_size: 6) do %>
        <p class="mb-2">Active deployment records impacted by this vulnerability have been detected and tagged with runtime risks.</p>
        <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/code-security/dependabot/dependabot-alerts/about-dependabot-alerts")) do %>
          Learn more
        <% end %>
      <% end %>
    <% end %>
  </div>
  <% risks.each do |risk| %>
    <%= render(Primer::Beta::Label.new(scheme: :secondary, test_selector: "runtime-risk-label", mb: 1, mr: 1)) { risk } %>
  <% end %>
</div>
