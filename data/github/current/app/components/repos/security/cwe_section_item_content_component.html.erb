<%= render Primer::Beta::Heading.new(tag: :h4, font_size: :small, test_selector: "cwe_details") do %>
  <%= render(Primer::Beta::Octicon.new(icon: "shield", size: :xsmall, color: :muted)) %>
  <%= render Primer::Beta::Link.new(href: header_link, muted: true, classes: "Link--inTextBlock", test_selector: "header_link") do %>
    <%= cwe.name %>
  <% end %>
<% end %>
<%= render Primer::Beta::Text.new do %>
  <%= cwe.description %>
<% end %>
<% if alternative_header_link.present? %>
  <%= render(Primer::Beta::Link.new(href: mitre_link, muted: true, classes: "Link--inTextBlock", test_selector: "mitre_link"))  { "Learn more on MITRE." } %>
<% end %>
