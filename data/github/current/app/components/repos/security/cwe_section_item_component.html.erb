<%= render Primer::Beta::Details.new(name: :cwe_summary) do |component| %>
  <% component.with_summary(button: false, test_selector: test_selector) do %>
    <span class="sr-only">Weakness</span>
    <%= render Primer::Beta::Text.new(test_selector: "cwe-id") do %><%= summary_text %><% end %>
  <% end %>
  <% component.with_body(px: 2, pb: 2) do %>
    <% if fragment_path.present? %>
      <%= render Primer::Alpha::IncludeFragment.new(loading: "lazy", src: fragment_path) do %>
        <div data-hide-on-error>
          <%= render Primer::Beta::Spinner.new(aria: { label: "Loading CWE" }) %>
        </div>
        <div class="text-italic" data-show-on-error hidden>
          Error fetching details for <%= summary_text %>.
        </div>
      <% end %>
    <% else %>
      <%= render Repos::Security::CWESectionItemContentComponent.new(cwe:, alternative_header_link: )%>
    <% end %>
  <% end %>
<% end %>
