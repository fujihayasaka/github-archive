<%= render(Primer::Alpha::ActionList.new) do |component| %>
  <% @campaigns_with_counts.each do |campaign| %>
    <% component.with_item(
        label: campaign.name_for_display,
        label_arguments: { font_weight: :normal },
        truncate_label: true,
        href: repository_security_campaign_path(repository: @repository, user_id: @repository.owner, number: campaign.number),
        test_selector: "security_campaign_name"
      ) do |item| %>
      <% item.
          with_description(test_selector: "security_campaign_description").
          with_content("#{campaign.closed_percentage.round}% complete, #{days_left_display(campaign)}")
      %>
    <% end %>
  <% end %>
<% end %>
