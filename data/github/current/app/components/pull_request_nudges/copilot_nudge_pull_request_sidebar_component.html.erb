<%
destination_key = "enable-copilot-code-review"

nudge_location = "pull_request"
nudge_id = :pr_show_ccr_primary_nudge
nudge_group = :engage

current_user.track_nudge_impression(id: nudge_id, group: nudge_group)
%>

<%= content_tag(
  :span,
  data: {
    **analytics_visible_attributes(
      category: nudge_category,
      organization: organization.id,
      group: nudge_group,
    ),
  },
  **test_selector_data_hash(nudge_category)
) do %>
<% end %>

<% if render_variant == :treatment_1 || render_variant == :treatment_2 %>
  <div class="copilot_nudge_pull_request_sidebar_container">
    <div class="copilot_nudge_pull_request_sidebar_main">
      <h3 class="copilot_nudge_pull_request_sidebar_title">
        <%=
          case render_variant
          when :treatment_1
            "Catch runtime errors faster with automated code reviews"
          when :treatment_2
            "You're missing out on AI-powered code reviews"
          end
        %>
      </h3>

      <div class="copilot_nudge_pull_request_sidebar_description">
        Enable Copilot code review to spot issues early and speed up reviews.
      </div>

      <%= render Primer::Beta::Button.new(
        size: :medium,
        tag: :a,
        scheme: :primary,
        href: settings_org_copilot_policies_path(organization, feature: "code-review"),
        style: "font-size:var(--text-body-size-small); padding-left:8px; padding-right:8px",
        data: analytics_click_attributes(
          category: nudge_category,
          action: "get_started",
          location: nudge_location,
          organization: organization.id,
        )
      ) do %>
        Enable Copilot code review
      <% end %>
    </div>

    <div class="copilot_nudge_pull_request_sidebar_image_container" >
      <img
        src="<%= image_path("modules/pulls/promos/copilot_nudge-dark.png") %>"
        alt="Preview of GitHub Copilot"
        class="copilot_nudge_pull_request_sidebar_image-dark"
      >
      <img
        src="<%= image_path("modules/pulls/promos/copilot_nudge-light.png") %>"
        alt="Preview of GitHub Copilot"
        class="copilot_nudge_pull_request_sidebar_image-light"
      >
    </div>

    <%= form_tag(
      organization_dismiss_notice_path(
        notice: nudge_id,
        organization_id: organization.id,
        group: nudge_group
      ),
    ) do %>
      <div class="copilot_nudge_pull_request_sidebar_dismiss">
        <%= render(Primer::Beta::IconButton.new(
          type: :submit,
          icon: :x,
          scheme: :invisible,
          aria: { label: "Dismiss" },
          color: :on_emphasis,
          style: "color: #59636E !important",
          data: analytics_click_attributes(
            action: "dismiss",
            category: nudge_category,
            group: nudge_group,
            location: nudge_location,
            organization: organization.id,
          ))) %>
      </div>
    <% end %>

  </div>
  <style type="text/css">
    .copilot_nudge_pull_request_sidebar_container {
      padding: var(--base-size-16);
      background: var(--bgColor-muted);
      border: var(--borderWidth-thin, 1px) solid var(--borderColor-default);
      border-radius: var(--borderRadius-medium);
      overflow: hidden;
      position: relative;
    }

    .copilot_nudge_pull_request_sidebar_image_container {
      position: absolute;
    }

    .copilot_nudge_pull_request_sidebar_dismiss {
      position: absolute;
      top: var(--base-size-8);
      right: var(--base-size-8);
    }

    .copilot_nudge_pull_request_sidebar_description {
      font: var(--text-body-shorthand-small);
      color: var(--fgColor-muted);
      margin-top: var(--base-size-16);
      margin-bottom: var(--base-size-16);
    }

    .copilot_nudge_pull_request_sidebar_title {
      font: var(--text-title-shorthand-small);
    }

    @media (min-width: 1012px) {
      .copilot_nudge_pull_request_sidebar_image_container {
        right: -135px;
        bottom: -35px;
      }

      .copilot_nudge_pull_request_sidebar_description {
        max-width: 172px;
      }

      .copilot_nudge_pull_request_sidebar_title {
        max-width: 200px;
      }
    }

    @media (min-width: 768px) and (max-width: 1011px) {
      .copilot_nudge_pull_request_sidebar_image_container {
        display: none;
      }
    }

    @media (max-width: 767px) {
      .copilot_nudge_pull_request_sidebar_container {
        display: none;
      }
    }

    .copilot_nudge_pull_request_sidebar_image-dark,
    .copilot_nudge_pull_request_sidebar_image-light {
      width: 236px;
      height: 194px;
    }

    @media (prefers-color-scheme: dark) {
      /* GitHub in "Sync" mode, OS in dark mode, User chose a dark theme for dark mode, so hide the light image */
      [data-color-mode='auto'][data-dark-theme="dark"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-dark-theme="dark_high_contrast"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-dark-theme="dark_dimmed"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-dark-theme="dark_dimmed_high_contrast"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-dark-theme="dark_tritanopia"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-dark-theme="dark_tritanopia_high_contrast"] .copilot_nudge_pull_request_sidebar_image-light {
        display: none;
      }

      /* GitHub in "Sync" mode, OS in dark mode, User chose a light theme for dark mode, so hide the dark image */
      [data-color-mode='auto'][data-dark-theme="light"] .copilot_nudge_pull_request_sidebar_image-dark,
      [data-color-mode='auto'][data-dark-theme="light_high_contrast"] .copilot_nudge_pull_request_sidebar_image-dark,
      [data-color-mode='auto'][data-dark-theme="light_tritanopia"] .copilot_nudge_pull_request_sidebar_image-dark,
      [data-color-mode='auto'][data-dark-theme="light_tritanopia_high_contrast"] .copilot_nudge_pull_request_sidebar_image-dark {
        display: none;
      }
    }

    @media (prefers-color-scheme: light) {
      /* GitHub in "Sync" mode, OS in light mode, User chose a light theme for light mode, so hide the dark image */
      [data-color-mode='auto'][data-light-theme="light"] .copilot_nudge_pull_request_sidebar_image-dark,
      [data-color-mode='auto'][data-light-theme="light_high_contrast"] .copilot_nudge_pull_request_sidebar_image-dark,
      [data-color-mode='auto'][data-light-theme="light_tritanopia"] .copilot_nudge_pull_request_sidebar_image-dark,
      [data-color-mode='auto'][data-light-theme="light_tritanopia_high_contrast"] .copilot_nudge_pull_request_sidebar_image-dark {
        display: none;
      }

      /* GitHub in "Sync" mode, OS in light mode, User chose a dark theme for light mode, so hide the light image */
      [data-color-mode='auto'][data-light-theme="dark"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-light-theme="dark_high_contrast"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-light-theme="dark_dimmed"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-light-theme="dark_dimmed_high_contrast"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-light-theme="dark_tritanopia"] .copilot_nudge_pull_request_sidebar_image-light,
      [data-color-mode='auto'][data-light-theme="dark_tritanopia_high_contrast"] .copilot_nudge_pull_request_sidebar_image-light {
        display: none;
      }
    }

    /* GH is in "Single theme" mode, so hide the opposite image */
    [data-color-mode="dark"] .copilot_nudge_pull_request_sidebar_image-light,
    [data-color-mode="light"] .copilot_nudge_pull_request_sidebar_image-dark {
      display: none;
    }
  </style>
<% end %>
