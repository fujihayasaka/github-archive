<% if show_multi_integration_nav? %>
  <% unless enabled_apps.empty? %>
    <%= render(Primer::Beta::NavList::Item.new(label: section_title, **@system_arguments)) do |item| %>
      <% enabled_apps.each do |app_name| %>
        <% item.with_item(label: display_name(app_name), href: secrets_path(app_name), selected_by_ids: highlight(app_name)) do |sub_item| %>
          <% if user_feature_enabled?(:lifecycle_label_name_updates) %>
            <% sub_item.with_trailing_visual_label(scheme: :success, title: "Preview", ml: 1) { "Preview" } if app_name == Secrets::AppsHelper::PRIVATE_REGISTRY_APP_NAME%>
          <% else %>
            <% sub_item.with_trailing_visual_label(scheme: :success, title: "Beta", ml: 1) { "Beta" } if app_name == Secrets::AppsHelper::PRIVATE_REGISTRY_APP_NAME%>
          <% end %>
        <% end %>
      <% end %>
      <% item.with_leading_visual_icon(icon: :"key-asterisk") %>
    <% end %>
  <% end %>
<% elsif GitHub.actions_enabled? %>
  <%# render legacy actions secrets nav %>
  <%= render(Primer::Beta::NavList::Item.new(label: section_title, href: secrets_path("actions"), selected_by_ids: highlight("actions"), **@system_arguments)) do |item| %>
    <% item.with_leading_visual_icon(icon: :"key-asterisk") %>
  <% end %>
<% end %>
