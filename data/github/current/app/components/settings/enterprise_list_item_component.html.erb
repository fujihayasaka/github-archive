<div class="Box-row d-flex flex-items-center flex-justify-between flex-wrap"
  <%= test_selector "enterprise-#{business.id}" %>>
  <div class="py-1">
    <%= render(Primer::Beta::Avatar.new(src: business.primary_avatar_url, size: 20, alt: business.name, shape: :square)) %>
    <strong class="ml-1">
      <%= link_to business.name, enterprise_path(business) %>
    </strong>
    <%= render(Primer::Beta::Label.new(scheme: :secondary, test_selector: "enterprise-role")) { description } %>
  </div>
  <div class="d-flex flex-items-center flex-justify-end py-1" style="gap: 16px;">
    <% if show_trial_information? %>
      <% if trial_days_remaining %>
        <span class="color-fg-muted f6" <%= test_selector "trial-days-#{business.id}" %>>
          <%= pluralize(trial_days_remaining, "day") %> left on trial
        </span>
      <% elsif business.trial_expired? %>
        <span class="color-fg-attention f6" <%= test_selector "trial-expired-#{business.id}" %>>
          <%= render Primer::Beta::Octicon.new(:alert, mr: 1) %> Trial expired
        </span>
      <% end %>
    <% end %>
    <% if show_settings_button? %>
      <%= link_to("Settings", settings_path,
        data: {
          "test-selector": "enterprise-settings-#{business.id}",
          **analytics_click_attributes(
            category: "enterprise_list",
            action: "settings",
            label: "ref_loc:user_settings_enterprise_list;business_id:#{business.id};trial_info:#{trial_info};"
          ),
        },
        class: "btn btn-sm ml-2"
      ) %>
    <% end %>
    <% if show_self_removal_button? %>
      <%= render(Primer::Alpha::Dialog.new(
        id: "enterprise-self-removal-dialog-#{business.id}",
        title: "Leave enterprise",
        size: :medium_portrait
      )) do |d| %>
        <% d.with_show_button(
          size: :small,
          scheme: :danger,
          ml: 2,
          test_selector: "enterprise-self-removal-#{business.id}",
          data: analytics_click_attributes(
            category: "enterprise_list",
            action: "self_removal",
            label: "ref_loc:user_settings_enterprise_list;business_id:#{business.id};"
          )
        ) do %>
          Leave
        <% end %>
        <%= form_tag enterprise_membership_destroy_enterprise_path(business, user), method: :delete do %>
          <%= render(Primer::Alpha::Dialog::Body.new) do %>
            <p>
              Are you sure you want to leave the
              <strong><%= business.name %></strong> enterprise?
            </p>
            <p class="color-fg-muted f6">
              When you leave, you will lose access to all repositories and organizations within the enterprise.
            </p>
          <% end %>
          <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: false)) do %>
            <%= render(Primer::Beta::Button.new(
              data: { "close-dialog-id": "enterprise-self-removal-dialog-#{business.id}" }
            )) { "Cancel" } %>
            <%= render(Primer::Beta::Button.new(
              type: :submit,
              scheme: :danger,
              "data-disable-with": "Removing you from enterprise...",
              test_selector: "enterprise-self-removal-confirm-#{business.id}"
            )) { "I understand, leave this enterprise" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

  </div>
</div>
