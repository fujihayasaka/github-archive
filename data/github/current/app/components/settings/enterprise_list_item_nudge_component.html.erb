<%
nudge_html_element   = "a"
nudge_location       = "settings_enterprises"

nudges_to_render.each do |nudge|
  nudge_type = nudge.nudge_type
  nudge_id = nudge.nudge_id
  nudge_group = nudge.nudge_group
  destination_key = nudge.destination_key
  secondary_cta = nil

  case nudge_type
  when :cb
    nudge_category = "dfd_settings_enterprises_enable_cb_nudge_1"

    title = "Copilot Business is available for your enterprise"
    description = "Copilot Business is available to your enterprise free for 30 days. Activate AI-powered coding for your team by verifying your identity."
    icon_path = image_path("modules/dashboard/promos/general/copilot-menu-no-indicator-1746823169.svg")
    icon_alt = "Copilot logo"
    cta_title = "Activate Copilot Business"
    cta_action = "activate_copilot_business"
  when :org
    nudge_category = "dfd_settings_enterprises_create_org_nudge_1"

    title = "Create its first organization"
    description = "The first step to seeing the benefits of GitHub Enterprise is to add its first organization, which will provide a home for your developers, code, and workflows."
    icon_path = image_path("modules/dashboard/promos/general/org-menu-no-indicator-1749137782.svg")
    icon_alt = "Organization logo"
    cta_title = "Create organization"
    cta_action = "create_org"
  when :repo
    nudge_category = "dfd_settings_enterprises_create_repo_nudge_1"

    title = "Create its first repository"
    description = "Repositories are where you add code, collaborate, and utilize premium features, like GitHub Actions and Advanced Security."
    icon_path = image_path("modules/dashboard/promos/general/repo-menu-no-indicator-1749494944.svg")
    icon_alt = "Repository logo"
    cta_title = "Create repository"
    cta_action = "create_repo"
  when :code
    nudge_category = "dfd_settings_enterprises_add_code_nudge_1"

    title = "Add code to #{oldest_repo.name}"
    description = "Put GitHub Secret scanning, Code scanning, and Actions to work in your enterprise for the first time by adding code to your repo."
    icon_path = image_path("modules/dashboard/promos/general/code-menu-no-indicator-1752091508.svg")
    icon_alt = "Code logo"
    cta_title = "Add code"
    cta_action = "add_code"
  when :ghas
    nudge_category = "dfd_settings_enterprises_enable_ghas_nudge_1"

    title = "Enable Advanced Security for #{oldest_repo.name}"
    description = "Protect your repository's code by enabling GitHub to scan for secrets and security issues."
    icon_path = image_path("modules/dashboard/promos/general/ghas-menu-no-indicator-1758667123.svg")
    icon_alt = "Advanced Security logo"
    cta_title = "Enable Advanced Security"
    cta_action = "enable_ghas"
  when :sparkorcli
    nudge_category = "nudge_enterprise_preview_spark_and_cli_1"

    title = "Copilot and Spark previews available for your enterprise"
    description = "Enable Spark and Copilot CLI to accelerate development across your enterprise."
    icon_path = image_path("modules/dashboard/promos/general/copilot-menu-no-indicator-1746823169.svg")
    icon_alt = "Copilot logo"
    cta_title = "Enable Enterprise Previews"
    cta_action = "enable_enterprise_previews"
  when :loops
    nudge_category = "nudge_enterprise_preview_loops_1"

    title = "Copilot Loops preview available for your enterprise"
    description = "Enable Loops to unlock powerful AI workflow automation across your enterprise."
    icon_path = image_path("modules/dashboard/promos/general/copilot-menu-no-indicator-1746823169.svg")
    icon_alt = "Copilot logo"
    cta_title = "Enable Loops Preview"
    cta_action = "enable_loops_preview"
  when :win_cb_users_back_credit
    nudge_category = "digital_offer_nudge_cb_enterprises_winback_nov_2025"

    title = "You have $200 in Copilot Business credits available"
    expires_display = nudge.formatted_expires_date || "Dec\u202f13, 2025"
    expires_next_day_display = nudge.formatted_expires_next_day || "Dec 14"
    description = "Credits cover Copilot Business seat costs through #{expires_display}. Costs incurred over the credit amount or from #{expires_next_day_display} onward will be billed."
    secondary_cta = link_to("Terms apply", "https://github.com/features/ai/nov-2025-copilot-business-credit-for-enterprises", class: "Link--inTextBlock")
    icon_path = image_path("modules/dashboard/promos/general/copilot-menu-no-indicator-1746823169.svg")
    icon_alt = "Copilot logo"
    cta_title = "Enable Copilot Business"
    cta_action = "activate_copilot_business"

    # Determine CTA and destination based on business copilot state
    business_copilot = Copilot::Business.new(business)
    if business_copilot.copilot_enabled? && (business_copilot.copilot_seat_count == 0 || business_copilot.copilot_accessible_organization_count == 0)
      # State: Copilot enabled for all/some orgs AND (0 seats assigned OR 0 organizations granted access)
      cta_title = "Copilot Licensing"
      cta_action = "copilot_licensing"
      destination_key = :nudge_enterprise_win_cb_users_back_credit_assign_seats
    end
  end

  user.track_nudge_impression(id: nudge_id, group: nudge_group, enterprise_id: business.id) if user
  %>
  <span <%= test_selector(nudge_category) %>></span>

  <div class="ipm-nudge-box settings Box-header">
    <div class="ipm-nudge-icon-wrapper" aria-hidden="true">
      <img class="ipm-nudge-icon" src="<%= icon_path %>" alt="<%= icon_alt %>" width="32" height="32">
    </div>

    <div class="ipm-nudge-content">
      <h3><%= title %></h3>
      <p>
        <%= secondary_cta ? safe_join([description, safe_join([secondary_cta, "."], "")], " ") : description %>
      </p>
    </div>

    <%= link_to(cta_title, "/in-product-messaging/click-and-redirect?destination_key=#{destination_key}&business_id=#{business.id}&notice=#{nudge_id}&group=#{nudge_group}",
      data: {
        "test-selector": "settings-enterprises-#{business.id}-dfd-#{nudge.nudge_type}-nudge",
        **analytics_click_attributes(
          category: nudge_category,
          tag: nudge_html_element,
          action: cta_action,
          enterprise: business.id,
          location: nudge_location,
          group: nudge_group,
        ),
      },
      class: "ipm-nudge-cta btn btn-sm btn-primary"
    ) %>

    <%= form_tag(
      enterprise_dismiss_notice_path(
        notice: nudge_id,
        business_id: business.id,
        group: nudge_group
      ),

      data: analytics_visible_attributes(category: nudge_category, enterprise: business.id, group: nudge_group)
    ) do %>

      <div class="ipm-nudge-dismiss">
        <%= render(Primer::Beta::IconButton.new(
          type: :submit,
          icon: :x,
          scheme: :invisible,
          aria: { label: "Dismiss" },
          color: :on_emphasis,
          data: analytics_click_attributes(
            category: nudge_category,
            tag: nudge_html_element,
            action: "dismiss",
            enterprise: business.id,
            location: nudge_location,
            group: nudge_group,
          ))) %>
      </div>
    <% end %>
  </div>
<% end %>
