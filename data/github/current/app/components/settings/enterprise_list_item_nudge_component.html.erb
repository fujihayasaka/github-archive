<%
nudge_html_element   = "a"
nudge_location       = "settings_enterprises"

case render_nudge_type
when :cb
  nudge_category = "dfd_settings_enterprises_enable_cb_nudge"
  nudge_group = get_dfd_new_tasks_configs(:cb)[:nudge_group]
  nudge_id = get_dfd_new_tasks_configs(:cb)[:nudge_id]
  destination_key = "dfd_new_tasks_cb_activate_cb"
when :org
  nudge_category = "dfd_settings_enterprises_create_org_nudge"
  nudge_group = get_dfd_new_tasks_configs(:org)[:nudge_group]
  nudge_id = get_dfd_new_tasks_configs(:org)[:nudge_id]
  destination_key = "dfd_new_tasks_org_create_org"
end
%>
<% case render_variant %>
<% when :variant_show_no_experience %>
  <% if render_nudge_type %>
    <!--This is for the purposes of an A|B test where B is "no experience" so we are intentionally displaying nothing-->
    <span <%= test_selector("#{nudge_category}_#{variant}") %>></span>
    <%= content_tag(
      :span,
      data: {
        **analytics_visible_attributes(
          category: "#{nudge_category}_#{variant}",
          enterprise: business.id,
          group: "engage"
        )
      }
    ) do %>
    <% end %>
  <% end %>
<% when :variant_show_treatment_1 %>
  <% if render_nudge_type %>
    <span <%= test_selector("#{nudge_category}_#{variant}") %>></span>
    <% current_user.track_nudge_impression(id: nudge_id, group: nudge_group, enterprise_id: business.id) %>
  <% end %>
  <% case render_nudge_type %>
  <% when :cb %>
    <div
      class="dfd-nudge-box Box-header d-flex flex-items-center flex-justify-between flex-wrap"
    >
      <div class="dfd-nudge-icon-wrapper" aria-hidden="true">
        <img class="dfd-nudge-icon flex-justify-start" src="<%= image_path('modules/dashboard/promos/general/copilot-menu-no-indicator-1746823169.svg') %>" alt="Copilot logo" width="32" height="32">
      </div>
      <div class="dfd-nudge-content">
        <h3>Copilot Business is available for your enterprise</h3>
        <p class="color-fg-muted f5">Copilot Business is available to your enterprise free for 30 days. Activate AI-powered coding for your team by verifying your identity.</p>
      </div>
      <%= link_to("Activate Copilot Business", "/in-product-messaging/click-and-redirect?destination_key=#{destination_key}&business_id=#{business.id}&notice=#{nudge_id}&group=#{nudge_group}",
        data: {
          "test-selector": "settings-enterprises-#{business.id}-dfd-#{render_nudge_type}-nudge",
          **analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "activate_copilot_business",
            enterprise: business.id,
            location: nudge_location,
            group: nudge_group,
          ),
        },
        class: "dfd-nudge-btn btn btn-sm btn-primary d-flex flex-items-center flex-justify-end"
      ) %>
      <%= form_tag(
        enterprise_dismiss_notice_path(
          notice: nudge_id,
          business_id: business.id,
          group: nudge_group
        ),

        data: analytics_visible_attributes(category: "#{nudge_category}_#{variant}", enterprise: business.id, group: nudge_group)
      ) do %>

        <div class="dfd-nudge-dismiss">
          <%= render(Primer::Beta::IconButton.new(
            type: :submit,
            icon: :x,
            scheme: :invisible,
            aria: { label: "Dismiss" },
            color: :on_emphasis,
            style: "color: #59636E !important",
            data: analytics_click_attributes(
              category: "#{nudge_category}_#{variant}",
              tag: nudge_html_element,
              action: "dismiss",
              enterprise: business.id,
              location: nudge_location,
              group: nudge_group,
            ))) %>
        </div>
      <% end %>
    </div>
  <% when :org %>
    <div
      class="dfd-nudge-box Box-header d-flex flex-items-center flex-justify-between flex-wrap"
    >
      <div class="dfd-nudge-icon-wrapper" aria-hidden="true">
        <img class="dfd-nudge-icon flex-justify-start" src="<%= image_path('modules/dashboard/promos/general/org-menu-no-indicator-1749137782.svg') %>" alt="Organization logo" width="32" height="32">
      </div>
      <div class="dfd-nudge-content">
        <h3>Create its first organization</h3>
        <p class="color-fg-muted f5">
        The first step to seeing the benefits of GitHub Enterprise is to add its first organization, which will provide a home for your developers, code, and workflows.
          </p>
      </div>
      <%= link_to("Create organization", "/in-product-messaging/click-and-redirect?destination_key=#{destination_key}&business_id=#{business.id}&notice=#{nudge_id}&group=#{nudge_group}",
        data: {
          "test-selector": "settings-enterprises-#{business.id}-dfd-#{render_nudge_type}-nudge",
          **analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "create_org",
            enterprise: business.id,
            location: nudge_location,
            group: nudge_group,
          ),
        },
        class: "dfd-nudge-btn btn btn-sm btn-primary d-flex flex-items-center flex-justify-end"
      ) %>
      <%= form_tag(
        enterprise_dismiss_notice_path(
          notice: nudge_id,
          business_id: business.id,
          group: nudge_group
        ),

        data: analytics_visible_attributes(category: "#{nudge_category}_#{variant}", enterprise: business.id, group: nudge_group)
      ) do %>

        <div class="dfd-nudge-dismiss">
          <%= render(Primer::Beta::IconButton.new(
            type: :submit,
            icon: :x,
            scheme: :invisible,
            aria: { label: "Dismiss" },
            color: :on_emphasis,
            style: "color: #59636E !important",
            data: analytics_click_attributes(
              category: "#{nudge_category}_#{variant}",
              tag: nudge_html_element,
              action: "dismiss",
              enterprise: business.id,
              location: nudge_location,
              group: nudge_group,
            ))) %>
        </div>
      <% end %>
    </div>
  <% when :repo %>
    <%# TODO: Placeholder for repository-level nudge implementation %>
  <% when :code %>
    <%# TODO: Placeholder for code-level nudge implementation %>
  <% when :ghas %>
    <%# TODO: Placeholder for GHAS nudge implementation %>
  <% end %>
<% end %>
