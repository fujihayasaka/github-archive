<div>
  <h3>Dependabot</h3>
  <div class="py-2">
  <%=render(Primer::Beta::BorderBox.new(padding: :condensed))  do |component| %>
    <% if dependabot_rules_enabled? %>
      <% component.with_row(ml: 3, mr: 3, mt: 1, p: 0, pt: 2, pb: 3) do %>
        <%= render(DependabotAlerts::RulesSettingsComponent.new(organization: @owner, content_only: true)) %>
      <% end %>
    <% end %>
    <% if show_grouped_security_updates? %>
      <% component.with_row(ml: 3, mr: 3, p: 0, py: 3) do %>
        <%= render(DependabotSettings::GroupedSecurityUpdatesComponent.new(
          owner: @owner,
          public_repo_count: @public_repo_count,
          repo_count: @repo_count
        )) %>
      <% end %>
    <% end %>
    <% if show_runner_settings? %>
      <% component.with_row(ml: 3, mr: 3, p: 0, pt: 3, pb: 2, mb: 1) do %>
        <%= render(DependabotSettings::RunnerSettingsComponent.new(
          owner: @owner
        )) %>
      <% end %>
    <% end %>
  <% end %>
  </div>
</div>
