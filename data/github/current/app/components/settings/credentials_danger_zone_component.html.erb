<h3 class="h4 tmp-mt-3 mb-2">Danger zone</h3>

<%= render(Primer::Beta::BorderBox.new(test_selector: "credentials-danger-zone")) do |box| %>
  <% box.with_row(test_selector: "revoke-credential-authorizations") do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="tmp-pr-3">
        <strong class="d-block">Revoke all credential authorizations</strong>
        <span class="color-fg-muted f6">
          Permanently revokes SSO authorizations for keys and tokens that are owned or authorized by your account.
          Fine-grained personal access tokens will lose access but can be reassigned.
        </span>
      </div>
      <%= render(Primer::Beta::Button.new(
        scheme: :danger,
        "data-show-dialog-id": "revoke-credentials-dialog",
      )) { "Revoke all" } %>
    </div>
  <% end %>

  <% if emu_user? %>
    <% box.with_row(test_selector: "delete-keys-and-tokens") do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="tmp-pr-3">
          <strong class="d-block">Delete all keys and tokens</strong>
          <span class="color-fg-muted f6">
            Permanently deletes all keys and tokens that are owned or authorized by your account,
            including their authorizations and access granted by fine-grained personal access tokens.
          </span>
        </div>
        <%= render(Primer::Beta::Button.new(
          scheme: :danger,
          "data-show-dialog-id": "delete-keys-and-tokens-dialog",
        )) { "Delete all" } %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if emu_user? %>
  <%= render(Primer::Alpha::Dialog.new(
    size: :medium_portrait,
    id: "revoke-credentials-dialog",
    title: "Revoke authorizations",
    test_selector: "revoke-credentials-dialog",
  )) do |dialog| %>
    <% dialog.with_header(show_divider: true) %>
    <%= form_tag settings_credentials_path, method: :delete do %>
      <%= hidden_field_tag :revocation_type, "authorizations" %>
      <%= render(Primer::Alpha::Dialog::Body.new) do %>
        <p>
          You are about to <strong>revoke all authorizations for tokens and keys</strong>
          that were generated or authorized by your personal account. This includes:
        </p>
        <div class="markdown-body f5 mb-2">
          <ul>
            <li><%= pluralize(fine_grained_personal_access_tokens_count, "fine-grained personal access token") %></li>
            <li><%= pluralize(classic_personal_access_tokens_count, "personal access token (classic)") %></li>
            <li><%= pluralize(app_access_tokens_count, "GitHub App and OAuth app access token") %></li>
            <li><%= pluralize(ssh_keys_count, "SSH key") %></li>
          </ul>
        </div>
        <p>
          Revoking authorizations will remove access for existing SSH keys and tokens. This is
          a permanent action, and you will not be able to reauthorize revoked tokens and keys.
        </p>
        <p>
          For fine-grained personal access tokens, the resource ownership will be removed. You
          can reassign the resource owner to regain access, which may require approval.
        </p>

        <dl class="form-group required">
          <dt><label for="revoke-credentials-verify">Enter &ldquo;<%= confirmation_text %>&rdquo; to confirm</label></dt>
          <dd>
            <input class="form-control input-block"
              type="text"
              id="revoke-credentials-verify"
              name="verify">
          </dd>
        </dl>
      <% end %>

      <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: true)) do %>
        <%= render(Primer::Beta::Button.new(
          type: :button,
          data: { "close-dialog-id": "revoke-credentials-dialog" }
        )) { "Cancel" } %>

        <%= render(Primer::Beta::Button.new(
          type: :submit,
          scheme: :danger,
        )) { "Revoke authorizations" } %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <credential-revocation-dialog data-slug="<%= user.display_login %>">
    <%= render(Primer::Alpha::Dialog.new(
      size: :medium_portrait,
      id: "revoke-credentials-dialog",
      title: "Revoke authorizations",
      test_selector: "revoke-credentials-dialog",
    )) do |dialog| %>
      <% dialog.with_header(show_divider: true) %>
      <%= form_tag settings_credentials_path, method: :delete, id: "revoke-credentials-form", data: { action: "submit:credential-revocation-dialog#validate" } do %>
        <%= hidden_field_tag :revocation_type, "authorizations" %>
        <input type="hidden" name="enterprise_id" id="revoke-credentials-enterprise-id" value="" data-target="credential-revocation-dialog.hiddenInput">
        <%= render(Primer::Alpha::Dialog::Body.new) do %>
          <p>
            Select an enterprise whose credential authorizations you would like to revoke.
          </p>

          <dl class="form-group required" <%= test_selector "revoke-credentials-enterprise-select" %>>
            <dt><label>Enterprise</label></dt>
            <dd>
              <%= render(Primer::Alpha::SelectPanel.new(
                id: "revoke-credentials-enterprise-select-panel",
                title: "Select an enterprise",
                select_variant: :single,
                fetch_strategy: :local,
                dynamic_label: true,
                no_results_label: "No matching enterprises.",
                classes: "d-block",
              )) do |panel| %>
                <% panel.with_show_button(scheme: :default, data: { target: "credential-revocation-dialog.triggerButton" }) do |button| %>
                  <% button.with_trailing_action_icon(icon: :"triangle-down") %>
                  Select an enterprise
                <% end %>
                <% enterprises.each do |business| %>
                  <% panel.with_item(
                    label: business.name,
                    size: :medium,
                    content_arguments: { data: { value: business.id } }
                  ) do |item| %>
                    <% item.with_leading_visual_raw_content do %>
                      <%= render(Primer::Beta::Avatar.new(src: business.primary_avatar_url, alt: "", size: 20, shape: :square)) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
              <p class="color-fg-danger f6 mt-1" id="revoke-credentials-select-error" hidden data-target="credential-revocation-dialog.selectError">
                <%= render(Primer::Beta::Octicon.new(icon: :alert, size: :small, mr: 1)) %>Please select an enterprise
              </p>
            </dd>
          </dl>

          <div id="revoke-credentials-details-section" hidden data-target="credential-revocation-dialog.detailsSection">
            <p>
              You are about to <strong>revoke all of your authorizations for tokens and keys</strong> in
              <strong><span class="js-selected-display-name"></span></strong>. This includes:
            </p>
            <div class="markdown-body f5 mb-2">
              <ul>
                <li><%= pluralize(fine_grained_personal_access_tokens_count, "fine-grained personal access token") %></li>
                <li><%= pluralize(classic_personal_access_tokens_count, "personal access token (classic)") %></li>
                <li><%= pluralize(app_access_tokens_count, "GitHub App and OAuth app access token") %></li>
                <li><%= pluralize(ssh_keys_count, "SSH key") %></li>
              </ul>
            </div>
            <p>
              Revoking authorizations will remove access for existing SSH keys and tokens. This is
              a permanent action, and you will not be able to reauthorize revoked tokens and keys.
            </p>
            <p>
              For fine-grained personal access tokens, the resource ownership will be removed. You
              can reassign the resource owner to regain access, which may require approval.
            </p>

            <dl class="form-group required">
              <dt><label for="revoke-credentials-verify">Enter &ldquo;<%= confirmation_text %>&rdquo; to confirm</label></dt>
              <dd>
                <input class="form-control input-block"
                  type="text"
                  id="revoke-credentials-verify"
                  name="verify"
                  data-target="credential-revocation-dialog.verifyInput">
                <p class="color-fg-danger f6 mt-1" id="revoke-credentials-verify-error" hidden data-target="credential-revocation-dialog.verifyError">
                  <%= render(Primer::Beta::Octicon.new(icon: :alert, size: :small, mr: 1)) %>Please enter the correct text to continue.
                </p>
              </dd>
            </dl>
          </div>
        <% end %>

        <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: true)) do %>
          <%= render(Primer::Beta::Button.new(
            type: :button,
            data: { "close-dialog-id": "revoke-credentials-dialog" }
          )) { "Cancel" } %>

          <%= render(Primer::Beta::Button.new(
            type: :submit,
            scheme: :danger,
            id: "revoke-credentials-submit",
          )) { "Revoke authorizations" } %>
        <% end %>
      <% end %>
    <% end %>
  </credential-revocation-dialog>
<% end %>

<% if emu_user? %>
<%= render(Primer::Alpha::Dialog.new(
  size: :medium_portrait,
  id: "delete-keys-and-tokens-dialog",
  title: "Delete keys and tokens",
  test_selector: "delete-keys-and-tokens-dialog",
)) do |dialog| %>
  <% dialog.with_header(show_divider: true) %>
  <%= form_tag settings_credentials_path, method: :delete do %>
    <%= hidden_field_tag :revocation_type, "credentials_and_authorizations" %>
    <%= render(Primer::Alpha::Dialog::Body.new) do %>
      <p>
        You are about to <strong>delete all keys and tokens, including their associated
        SSO authorizations,</strong> that are owned or authorized by your personal account.
        This includes:
      </p>
      <div class="markdown-body f5 mb-2">
        <ul>
          <li><%= pluralize(fine_grained_personal_access_tokens_count, "fine-grained personal access token") %></li>
          <li><%= pluralize(classic_personal_access_tokens_count, "personal access token (classic)") %></li>
          <li><%= pluralize(app_access_tokens_count, "GitHub App and OAuth app access token") %></li>
          <li><%= pluralize(ssh_keys_count, "SSH key") %></li>
        </ul>
      </div>
      <p>
        This is a permanent action. You will need to generate new tokens, SSH keys,
        SSO authorization, and access granted by fine-grained personal access tokens
        (if needed).
      </p>

      <dl class="form-group required">
        <dt><label for="delete-keys-and-tokens-verify">Enter &ldquo;<%= confirmation_text %>&rdquo; to confirm</label></dt>
        <dd>
          <input class="form-control input-block"
            type="text"
            id="delete-keys-and-tokens-verify"
            name="verify">
        </dd>
      </dl>
    <% end %>

    <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: true)) do %>
      <%= render(Primer::Beta::Button.new(
        type: :button,
        data: { "close-dialog-id": "delete-keys-and-tokens-dialog" }
      )) { "Cancel" } %>

      <%= render(Primer::Beta::Button.new(
        type: :submit,
        scheme: :danger,
      )) { "Delete keys and tokens" } %>
    <% end %>
  <% end %>
<% end %>
<% end %>
