<%= render Primer::Box.new(display: :flex, justify_content: :space_between, align_items: :center, style: "gap:1em", classes: "tmp-mt-6") do %>
  <%= render Primer::Beta::Subhead.new(mt: 0, mb: 0, border_bottom: 0) do |subhead| %>
    <% subhead.with_heading(tag: :h2, mt: 0, mb: 0) do %><%= heading %><% end %>
  <% end %>
<% end %>
<%= render Primer::Box.new(border: true, border_radius: 2, classes: "tmp-mt-3 tmp-p-3") do %>
  <div class="d-flex flex-column flex-lg-row justify-content-between flex-lg-items-center gap-3 tmp-mb-3">
    <div class="flex-auto">
      <p class="mb-1 mt-0"><strong>Promotions</strong></p>
      <p class="mb-0">Get solutions and exclusive offers from GitHub about products, services, and events we think you might find interesting.</p>
    </div>
    <div class="flex-shrink-0 d-flex align-items-center align-self-start" style="white-space: nowrap">
      <%= render(Primer::Alpha::ToggleSwitch.new(
        size: :small,
        status_label_position: :start,
        csrf_token: authenticity_token_for(toggle_path("promotion_subscribed")),
        checked: checked?("promotion_subscribed"),
        src: toggle_path("promotion_subscribed"),
        aria: { label: "Promotions" },
        test_selector: "in-product-messaging-promotions-toggle",
      )) %>
    </div>
  </div>
  <% if show_members_request? %>
    <hr class="color-border-muted mt-0 tmp-mb-3">
    <div class="d-flex flex-column flex-lg-row justify-content-between flex-lg-items-center gap-3 tmp-mb-3">
      <div class="flex-auto">
        <p class="mb-1 mt-0"><strong>Member requests</strong></p>
        <p class="mb-0">Allow members to request access to products, budget, or features in your <%= entity_name %>.</p>
      </div>
      <div class="flex-shrink-0 d-flex align-items-center align-self-start" style="white-space: nowrap">
        <%= render(Primer::Alpha::ToggleSwitch.new(
          size: :small,
          status_label_position: :start,
          csrf_token: authenticity_token_for(toggle_path("members_request_subscribed")),
          checked: checked?("members_request_subscribed"),
          src: toggle_path("members_request_subscribed"),
          aria: { label: "Member requests" },
          test_selector: "in-product-messaging-members-request-toggle",
        )) %>
      </div>
    </div>
  <% end %>
  <hr class="color-border-muted mt-0 tmp-mb-3">
  <div class="d-flex flex-column flex-lg-row justify-content-between flex-lg-items-center gap-3 mb-0">
    <div class="flex-auto">
      <p class="mb-1 mt-0"><strong>Tips</strong></p>
      <p class="mb-0">Get tips for developers working in your repositories about products and features your <%= entity_name %> has enabled.</p>
    </div>
    <div class="flex-shrink-0 d-flex align-items-center align-self-start" style="white-space: nowrap">
      <%= render(Primer::Alpha::ToggleSwitch.new(
        size: :small,
        status_label_position: :start,
        csrf_token: authenticity_token_for(toggle_path("tip_subscribed")),
        checked: checked?("tip_subscribed"),
        src: toggle_path("tip_subscribed"),
        aria: { label: "Tips" },
        test_selector: "in-product-messaging-tips-toggle",
      )) %>
    </div>
  </div>
<% end %>
