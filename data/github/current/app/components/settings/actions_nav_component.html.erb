<%= render(@item) do |item| %>
  <% if available_sections.present? %>
    <% settings = settings_hash %>
    <% available_sections.each do |section_name| %>
      <% item.with_item(
        label: get_display_name(section_name),
        href: get_path(section_name),
        selected_by_ids: get_selected_by_item_ids(section_name),
        sub_item: true,
        content_classes: @system_arguments[:content_classes]
      ) do |sub_item| %>
        <% preview = settings[section_name][:preview_label].present? %>
        <% if preview && FeatureFlag.vexi.enabled?(:actions_custom_images_public_preview_visibility, current_user, current_organization, default: false)%>
          <% sub_item.with_trailing_visual_label(scheme: :success) { "Preview" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% item.with_leading_visual_icon(icon: :play) %>
<% end %>
