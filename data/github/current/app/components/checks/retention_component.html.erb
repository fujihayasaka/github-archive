<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% if FeatureFlag.vexi.enabled?(:banner_migration, current_user, default: false) %>
  <%= render Primer::Alpha::Banner.new(scheme: :warning, icon: :alert, classes: "tmp-my-3 tmp-py-3") do %>
    <%= notice_text %>
    <%= link_to "Learn more about checks retention", docs_link %>
  <% end %>
<% else %>
  <%= render Primer::Beta::Flash.new(scheme: :warning, icon: :alert, classes: "tmp-my-3 tmp-py-3") do %>
    <%= notice_text %>
    <%= link_to "Learn more about checks retention", docs_link %>
  <% end %>
<% end %>
