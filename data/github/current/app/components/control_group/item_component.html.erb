<div class="<%= container_classes %>" style="<%= container_style %>" <%= test_selector(@test_selector) %>>
  <div class="ControlGroup-item-contents">
    <% if leading_icon? || leading_visual? %>
      <div class="ControlGroup-item-leadingVisual">
        <% if leading_visual? %>
          <%= leading_visual %>
        <% elsif leading_icon? %>
          <div class="ControlGroup-item-leadingIcon">
            <%= leading_icon %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @href && !@disabled && title? %>
      <%= link_to @href, class: "ControlGroup-item-title ControlGroup-link-overlay" do %>
        <%= title %>
      <% end %>
    <% elsif title? %>
      <p class="ControlGroup-item-title"><%= title %></p>
    <% end %>

    <% if description? %>
      <p class="ControlGroup-item-description">
        <%= description %>
      </p>
    <% end %>

    <% if control? %>
      <div class="ControlGroup-item-control">
        <%= control %>
      </div>
    <% end %>

    <% if @href && !@disabled && !control? %>
      <div class="ControlGroup-item-trailingVisual">
        <%= render(Primer::Beta::Octicon.new(icon: "chevron-right", size: :small)) %>
      </div>
    <% end %>
  </div>
  <% if footer? %>
    <div class="ControlGroup-item-footer">
      <%= footer %>
    </div>
  <% end %>
</div>

