<% if show_dialog? %>
  <%= render Primer::Alpha::Dialog.new(
    title: "Create a branch",
    size: :medium_portrait,
    "data-action": "close:create-branch#closeDialog cancel:create-branch#closeDialog",
  ) do |d| %>
    <% d.with_show_button(scheme: :link) { label } %>
    <% d.with_body do %>
      <include-fragment loading="lazy" src="<%=src%>">
        <%= render(Primer::Beta::Spinner.new(my: 3, mx: :auto, display: :block)) %>
      </include-fragment>
    <% end %>
  <% end %>
<% end %>
