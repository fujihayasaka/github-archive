<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns:secext="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
           xmlns:xenc="http://www.w3.org/2001/04/xmlenc#"
           xmlns:exc="http://www.w3.org/2001/10/xml-exc-c14n#"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           attributeFormDefault="unqualified"
           elementFormDefault="qualified"
           targetNamespace="http://www.w3.org/2000/09/xmldsig#">

  <xs:import schemaLocation="saml20encrypted_assertion_data_schema.xsd" namespace="http://www.w3.org/2001/04/xmlenc#" />
  <xs:import schemaLocation="saml20encrypted_assertion_security_token_schema.xsd" namespace="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd" />
  <xs:import schemaLocation="inclusive_namespaces_schema.xsd" namespace="http://www.w3.org/2001/10/xml-exc-c14n#" />

  <xs:element name="Signature">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="SignedInfo">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="CanonicalizationMethod">
                <xs:complexType>
                  <xs:attribute name="Algorithm" type="xs:anyURI" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="SignatureMethod">
                <xs:complexType>
                  <xs:attribute name="Algorithm" type="xs:anyURI" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Reference">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Transforms">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element maxOccurs="unbounded" name="Transform">
                            <xs:complexType>
                              <xs:sequence minOccurs="0">
                                <xs:element ref="exc:InclusiveNamespaces" />
                              </xs:sequence>
                              <xs:attribute name="Algorithm" type="xs:anyURI" use="required" />
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element ref="ds:DigestMethod" />
                    <xs:element name="DigestValue" type="xs:base64Binary" />
                  </xs:sequence>
                  <xs:attribute name="URI" type="xs:anyURI" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="SignatureValue" type="xs:base64Binary" />
        <xs:element ref="ds:KeyInfo" minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="X509Data">
    <xs:complexType>
      <xs:sequence maxOccurs="unbounded">
        <xs:choice>
          <xs:element name="X509SubjectName" type="xs:string"/>
          <xs:element name="X509Certificate" type="xs:base64Binary" />
          <xs:element name="X509IssuerSerial">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="X509IssuerName" type="xs:string" />
                <xs:element name="X509SerialNumber" type="xs:string" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="KeyInfo">
    <xs:complexType>
      <xs:choice>
        <xs:element ref="ds:X509Data" />
        <xs:element name="RetrievalMethod">
          <xs:complexType>
            <xs:attribute name="URI" type="xs:anyURI" />
            <xs:attribute name="Type" type="xs:anyURI" />
          </xs:complexType>
        </xs:element>
        <xs:sequence>
          <xs:element minOccurs="0" ref="secext:SecurityTokenReference" />
          <xs:element minOccurs="0" ref="xenc:EncryptedKey" />
        </xs:sequence>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="DigestMethod">
    <xs:complexType>
      <xs:attribute name="Algorithm" type="xs:anyURI" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
