<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://www.w3.org/2001/04/xmlenc#" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.w3.org/2001/04/xmlenc#" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ds="http://www.w3.org/2000/09/xmldsig#">
  <xs:import schemaLocation="xmldsig_schema.xsd" namespace="http://www.w3.org/2000/09/xmldsig#" />

  <xs:element name="EncryptedData">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="EncryptionMethod">
          <xs:complexType>
            <xs:attribute name="Algorithm" type="xs:anyURI" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element ref="ds:KeyInfo" />
        <xs:element name="CipherData">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="CipherValue" type="xs:base64Binary" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="Type" type="xs:anyURI" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="EncryptedKey">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="EncryptionMethod">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="ds:DigestMethod" />
            </xs:sequence>
            <xs:attribute name="Algorithm" type="xs:anyURI" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element ref="ds:KeyInfo" />
        <xs:element name="CipherData">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="CipherValue" type="xs:base64Binary" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
