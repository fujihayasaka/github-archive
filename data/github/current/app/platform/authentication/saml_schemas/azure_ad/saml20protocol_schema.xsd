<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:samlp="urn:oasis:names:tc:SAML:2.0:protocol"
           xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns:q1="urn:oasis:names:tc:SAML:2.0:assertion"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           attributeFormDefault="unqualified"
           elementFormDefault="qualified"
           targetNamespace="urn:oasis:names:tc:SAML:2.0:protocol">

  <xs:import schemaLocation="saml20assertion_schema.xsd"
             namespace="urn:oasis:names:tc:SAML:2.0:assertion" />
  <xs:import schemaLocation="xmldsig_schema.xsd"
             namespace="http://www.w3.org/2000/09/xmldsig#" />

  <xs:element name="Response">
    <xs:complexType>
      <xs:sequence>
        <xs:element xmlns:q1="urn:oasis:names:tc:SAML:2.0:assertion" ref="q1:Issuer" />
        <xs:element ref="ds:Signature" minOccurs="0"/>
        <xs:element ref="samlp:Status"/>
        <xs:element xmlns:q2="urn:oasis:names:tc:SAML:2.0:assertion" ref="q2:Assertion" />
      </xs:sequence>

      <xs:attribute name="ID" type="xs:string" use="required" />
      <xs:attribute name="Version" type="xs:decimal" use="required" />
      <xs:attribute name="IssueInstant" type="xs:dateTime" use="required" />
      <xs:attribute name="Destination" type="xs:string" use="required" />
      <xs:attribute name="InResponseTo" type="xs:string" use="optional" />
    </xs:complexType>
  </xs:element>

  <xs:element name="Status">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="StatusCode">
          <xs:complexType>
            <xs:attribute name="Value" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
