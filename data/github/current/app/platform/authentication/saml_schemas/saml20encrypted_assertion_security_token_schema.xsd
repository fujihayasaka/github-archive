<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           attributeFormDefault="unqualified"
           elementFormDefault="qualified"
           targetNamespace="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">

  <xs:import schemaLocation="xmldsig_schema.xsd" namespace="http://www.w3.org/2000/09/xmldsig#" />

  <xs:element name="SecurityTokenReference">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ds:X509Data" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
