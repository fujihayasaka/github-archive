<% if actions_workflow_filtering_enabled? %>
<actions-workflow-filter-panel data-filter-key="branch" data-included-values="<%= workflow_filter_included(workflow_run_filters, :branch).to_json %>" data-excluded-values="<%= workflow_filter_excluded(workflow_run_filters, :branch).to_json %>" data-base-path="<%= workflow_filter_base_path(filters: workflow_run_filters, exclude_key: :branch, filename: selected_workflow&.filename, lab: selected_workflow&.lab?) %>">
<%= render(Primer::Alpha::SelectPanel.new(
  id: "actions_branch_filter",
  title: "Filter by Branch",
  select_variant: :multiple,
  src: actions_branches_menu_path(selected_filename: selected_workflow&.filename, lab: selected_workflow&.lab?, query: actions_filtered_query(filters: workflow_run_filters)),
  no_results_label: "No matching branches."
)) do |menu| %>
  <% menu.with_show_button(scheme: :invisible, color: :muted, font_weight: :normal) do |button| %>
    <% button.with_trailing_action_icon(icon: :"triangle-down", display: [:none, :block]) %>
    Branch
  <% end %>
  <% menu.with_footer(show_divider: true) do %>
    <span class="color-fg-muted f6"><kbd>⌥</kbd> + <kbd>click/return</kbd> to exclude</span>
  <% end %>
<% end %>
</actions-workflow-filter-panel>
<% else %>
<%= render(Primer::Alpha::SelectPanel.new(
  id: "actions_branch_filter",
  title: "Filter by Branch",
  src: actions_branches_menu_path(selected_filename: selected_workflow&.filename, lab: selected_workflow&.lab?, query: actions_filtered_query(filters: workflow_run_filters)),
  no_results_label: "No matching branches."
)) do |menu| %>
  <% menu.with_show_button(scheme: :invisible, color: :muted, font_weight: :normal) do |button| %>
    <% button.with_trailing_action_icon(icon: :"triangle-down", display: [:none, :block]) %>
    Branch
  <% end %>
<% end %>
<% end %>
