<% if actions_workflow_filtering_enabled? %>
<% included_events = workflow_filter_included(workflow_run_filters, :event) %>
<% excluded_events = workflow_filter_excluded(workflow_run_filters, :event) %>
<% sorted_events = events.sort_by { |e| [included_events.include?(e) ? 0 : excluded_events.include?(e) ? 1 : 2, e] } %>
<%= render(Primer::Alpha::SelectPanel::ItemList.new(
  menu_id: "actions_events_filter",
  aria: { label: "events" },
  data: {
    "filterable-for": "actions_events_filter_input",
    "filterable-type": "fuzzy"
  },
  select_variant: :multiple
)) do |list| %>
  <% sorted_events.each do |event| %>
    <% is_included = included_events.include?(event) %>
    <% is_excluded = excluded_events.include?(event) %>
    <% list.with_item(
        label: event,
        content_arguments: { data: { value: event, excluded: is_excluded || nil } },
        active: is_included) %>
  <% end %>
<% end %>
<% else %>
<%= render(Primer::Alpha::SelectPanel::ItemList.new(
  menu_id: "actions_events_filter",
  aria: { label: "events" },
  data: {
    "filterable-for": "actions_events_filter_input",
    "filterable-type": "fuzzy"
  },
  select_variant: :single
)) do |list| %>
  <% events.each do |event| %>
    <% selected = workflow_run_filters[:event] == event %>
    <% list.with_item(
        href: filtered_runs_by_file_path(filters: workflow_run_filters, replace: { event: !selected ? event : nil }, filename: selected_filename, lab: is_lab),
        label: event,
        data: { value: event },
        active: selected) %>
  <% end %>
<% end %>
<% end %>
