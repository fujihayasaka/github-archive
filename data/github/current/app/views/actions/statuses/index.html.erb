<% if actions_workflow_filtering_enabled? %>
<% included_statuses = workflow_filter_included(workflow_run_filters, :is) %>
<% excluded_statuses = workflow_filter_excluded(workflow_run_filters, :is) %>
<% sorted_statuses = statuses.sort_by { |s| [included_statuses.include?(s) ? 0 : excluded_statuses.include?(s) ? 1 : 2, s] } %>
<%= render(Primer::Alpha::SelectPanel::ItemList.new(
  menu_id: "actions_status_filter",
  select_variant: :multiple,
  aria: { label: "statuses" },
)) do |list| %>
  <% sorted_statuses.each do |status| %>
    <% is_included = included_statuses.include?(status) %>
    <% is_excluded = excluded_statuses.include?(status) %>
    <% list.with_item(
        label: status.humanize(capitalize: false),
        content_arguments: { data: { value: status, excluded: is_excluded || nil } },
        active: is_included) %>
  <% end %>
<% end %>
<% else %>
<%= render(Primer::Alpha::SelectPanel::ItemList.new(
  menu_id: "actions_status_filter",
  select_variant: :single,
  aria: { label: "statuses" },
)) do |list| %>
  <% statuses.each do |status| %>
    <% selected = workflow_run_filters[:is] == status %>
    <% list.with_item(
        href: filtered_runs_by_file_path(filters: workflow_run_filters, replace: { is: !selected ? status : nil }, filename: selected_filename, lab: is_lab),
        label: status.humanize(capitalize: false),
        active: selected) %>
  <% end %>
<% end %>
<% end %>
