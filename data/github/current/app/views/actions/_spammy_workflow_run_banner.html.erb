      This workflow run is marked <strong>spammy</strong>. This workflow run will only show in staff mode.
    <% end %>
  <% else %>
    <%= render Primer::Beta::Flash.new(scheme: :danger, mb: 2, test_selector: "spammy-workflow-run-banner", classes: "tmp-mt-3") do %>
      This workflow run is marked <strong>spammy</strong>. This workflow run will only show in staff mode.
    <% end %>
  <% end %>
</div>
