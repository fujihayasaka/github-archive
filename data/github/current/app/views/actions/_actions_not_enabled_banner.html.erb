<% if current_repository.fork? %>
  <%= render Primer::Alpha::Banner.new(
    icon: :alert,
    scheme: :warning,
    test_selector: "actions-not-enabled-banner",
    classes: "tmp-mb-4") do %>
    <strong>Workflows aren't being run on this forked repository</strong>
    <p class="mt-2 mb-0">
      Because this repository contained workflow files when it was forked, we have disabled them from running on this fork.
      Make sure you understand the configured workflows and their expected usage before enabling Actions on this repository.
      Some GitHub features that depend on Actions may still be able to run.
    </p>
    <p>
      <a href="<%= blob_path(".github/workflows/", current_repository.default_branch) %>">View the workflows directory</a>
    </p>
    <p class="tmp-mt-3">
      <%= button_to "I understand my workflows, go ahead and enable them",
        actions_enable_path(current_repository.owner, current_repository),
        method: "post",
        class: "btn btn-primary"
      %>
    </p>
  <% end %>
<% else %>
  <%= render Primer::Alpha::Banner.new(
    icon: :alert,
    scheme: :warning,
    test_selector: "actions-not-enabled-banner",
    classes: "tmp-mb-4") do %>
    <strong>Workflows aren't being run on this repository</strong>
    <p class="mt-2 mb-0">
      GitHub Actions is not currently enabled on this repository. Some GitHub features that depend on Actions may still be able to run.
    </p>
    <p class="tmp-mt-3">
      <%= button_to "Enable Actions on this repository",
        actions_enable_path(current_repository.owner, current_repository),
        method: "post",
        class: "btn btn-primary"
      %>
    </p>
  <% end %>
<% end %>
