<% page_info title: "Password reset sent!" %>

<%= render Sessions::AuthenticationWrapperComponent.new(
      html_attributes: { "data-test-selector" => "password-reset-standard-view" }
    ) do |component| %>

  <% component.with_header do %>
    <%= render_react_partial name: "sessions-auth-header", props: { variant: user ? "user" : "github",
    title: "Reset your password",
    description: "Check your email for a link to reset your password. If it doesn’t appear within a few minutes, check your spam folder." } %>
  <% end %>

  <% component.with_body do %>
    <%= render "shared/flash" %>
    <%= link_to(
      login_path,
      data: sign_in_link_data_attributes(location_in_page: "password reset sent")
    ) do %>
      Return to sign in
    <% end %>
  <% end %>
<% end %>
