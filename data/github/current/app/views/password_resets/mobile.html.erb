<% page_info title: "Change your password", class: "page-two-factor-auth session-authentication"%>

  <%= render Sessions::AuthenticationWrapperComponent.new(
      id: "login"
    ) do |component| %>
    <% component.with_header do %>
      <%= render_react_partial name: "sessions-auth-header", props: { variant: "github", title: "Mobile two-factor password reset", description: "We sent you a password reset request on your GitHub Mobile app. Enter the digits shown below to verify your identity." } %>
    <% end %>

  <%= render "shared/flash" %>

  <% component.with_body do %>
    <%= render partial: "shared/mobile_auth_prompt_password_reset", locals: {
      challenge: challenge,
      status_path: check_password_reset_mobile_status_path,
      retry_path: edit_password_reset_mobile_path,
      rejected_path: edit_password_reset_path(token),
      auth_template: "password_reset",
      }
    %>
    <div class="two-factor-alternatives">
      <%= render(Primer::Beta::Button.new(
          scheme: :default,
          size: :large,
          classes: "btn-secondary btn btn-block more-options-two-factor",
          block: true,
          "data-disable-with": "More options…"
        )) do |component| %>
          More options
          <%= render(Primer::Beta::Octicon.new(:"triangle-down", size: :small)) %>
      <% end %>
      <ul class="two-factor-alternatives-body" id="two-factor-alternatives-body">
        <%= render partial: "sessions/two_factor_alternatives_item", locals: {
            index: 1,
            href: edit_password_reset_path(auto: "false", from: "mobile_2fa_password_reset"),
            button_text: "Two-factor authentication or recovery code"
          } %>
      </ul>
    </div>
  <% end %>
<% end %>
