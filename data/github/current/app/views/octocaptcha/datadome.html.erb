<%# rubocop:disable Lint/InstanceVariable %>
<html>
<head>
  <meta charset="utf-8">
  <title>OctoCaptcha</title>
  <% if @datadome_js_key.present? %>
    <script type="text/javascript" nonce="<%= @datadome_script_nonce %>">
      window.ddjskey = "<%= j @datadome_js_key %>";
      window.ddoptions = {
        ajaxListenerPath: true
      };
    </script>
    <script type="text/javascript" src="https://js.datadome.co/tags.js" async></script>
  <% end %>
</head>
<body style="margin: 0px">
  <script type="text/javascript" nonce="<%= @datadome_script_nonce %>">
    (function() {
      var targetOrigin = "<%= j @target_origin %>";
      if (!targetOrigin || window.parent === window) return;

      var posted = false;

      function completeDataDomeCaptcha() {
        if (posted) return;
        posted = true;

        window.parent.postMessage({event: 'captcha-suppressed'}, targetOrigin);
        window.parent.postMessage(
          {event: 'captcha-complete', sessionToken: 'datadome-suppressed'},
          targetOrigin
        );
      }

      window.addEventListener('load', completeDataDomeCaptcha, {once: true});
      setTimeout(completeDataDomeCaptcha, 3000);
    })();
  </script>
</body>
</html>
