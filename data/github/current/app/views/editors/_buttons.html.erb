<%# erblint:counter ButtonComponentMigrationCounter 13 %>
<div id="gollum-editor-function-buttons" class="float-md-left d-none overflow-auto no-wrap gollum-editor-function-buttons">

  <div class="BtnGroup">
    <button type="button" id="function-h1" class="btn btn-sm BtnGroup-item function-button" aria-label="Insert h1">
      <b>h1</b>
    </button>
    <button type="button" id="function-h2" class="btn btn-sm BtnGroup-item function-button" aria-label="Insert h2">
      <b>h2</b>
    </button>
    <button type="button" id="function-h3" class="btn btn-sm BtnGroup-item function-button" aria-label="Insert h3">
      <b>h3</b>
    </button>
  </div>

  <div class="BtnGroup">
    <button type="button" id="function-link" class="btn btn-sm BtnGroup-item function-button" aria-label="Add link">
      <%= render(Primer::Beta::Octicon.new(icon: "link")) %>
    </button>
    <button type="button" id="function-image" class="btn btn-sm BtnGroup-item function-button" aria-label="Add image">
      <%= primer_octicon(:image) %>
    </button>
  </div>

  <div class="BtnGroup">
    <button type="button" id="function-bold" class="btn btn-sm BtnGroup-item function-button" aria-label="Add bold text">
      <b>B</b>
    </button>
    <button type="button" id="function-italic" class="btn btn-sm BtnGroup-item function-button" aria-label="Add italic text">
      <em>i</em>
    </button>
    <button type="button" id="function-code" class="btn btn-sm BtnGroup-item function-button" aria-label="Insert code">
      <%= primer_octicon(:code) %>
    </button>
  </div>

  <div class="BtnGroup">
    <button type="button" id="function-ul" class="btn btn-sm BtnGroup-item function-button" aria-label="Add unordered list">
      <%= primer_octicon(:"list-unordered") %>
    </button>
    <button type="button" id="function-ol" class="btn btn-sm BtnGroup-item function-button" aria-label="Add ordered list">
      <%= primer_octicon(:"list-ordered") %>
    </button>
    <button type="button" id="function-blockquote" class="btn btn-sm BtnGroup-item function-button" aria-label="Insert blockquote">
      <%= primer_octicon(:quote) %>
    </button>
    <button type="button" id="function-hr" class="btn btn-sm BtnGroup-item function-button" aria-label="Insert horizontal rule">
      <%= primer_octicon(:"horizontal-rule") %>
    </button>
  </div>

  <button type="button" id="function-help" class="btn btn-sm hide-sm function-button" aria-label="Help">
    <%= primer_octicon(:question) %>
  </button>
</div>
