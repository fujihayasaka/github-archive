<div id="gollum-editor-function-buttons" class="float-md-left d-none overflow-auto no-wrap gollum-editor-function-buttons">

  <%= render(Primer::Beta::ButtonGroup.new(mr: 2)) do |group| %>
    <% group.with_button(id: "function-h1", classes: "function-button", aria: { label: "Insert h1" }) do |b| %>
      <% b.with_tooltip(text: "Insert h1") %>
      <b class="text-small">h1</b>
    <% end %>
    <% group.with_button(id: "function-h2", classes: "function-button", aria: { label: "Insert h2" }) do |b| %>
      <% b.with_tooltip(text: "Insert h2") %>
      <b class="text-small">h2</b>
    <% end %>
    <% group.with_button(id: "function-h3", classes: "function-button", aria: { label: "Insert h3" }) do |b| %>
      <% b.with_tooltip(text: "Insert h3") %>
      <b class="text-small">h3</b>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::ButtonGroup.new(mr: 2)) do |group| %>
    <% group.with_button(id: "function-link", icon: :link, classes: "function-button", aria: { label: "Add link" }) do |b| %>
      <% b.with_tooltip(text: "Add link") %>
    <% end %>
    <% group.with_button(id: "function-image", icon: :image, classes: "function-button", aria: { label: "Add image" }) do |b| %>
      <% b.with_tooltip(text: "Add image") %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::ButtonGroup.new(mr: 2)) do |group| %>
    <% group.with_button(id: "function-bold", classes: "function-button", aria: { label: "Add bold text" }) do |b| %>
      <% b.with_tooltip(text: "Add bold text") %>
      <b>B</b>
    <% end %>
    <% group.with_button(id: "function-italic", classes: "function-button", aria: { label: "Add italic text" }) do |b| %>
      <% b.with_tooltip(text: "Add italic text") %>
      <em>i</em>
    <% end %>
    <% group.with_button(id: "function-code", icon: :code, classes: "function-button", aria: { label: "Insert code" }) do |b| %>
      <% b.with_tooltip(text: "Insert code") %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::ButtonGroup.new(mr: 2)) do |group| %>
    <% group.with_button(id: "function-ul", icon: :"list-unordered", classes: "function-button", aria: { label: "Add unordered list" }) do |b| %>
      <% b.with_tooltip(text: "Add unordered list") %>
    <% end %>
    <% group.with_button(id: "function-ol", icon: :"list-ordered", classes: "function-button", aria: { label: "Add ordered list" }) do |b| %>
      <% b.with_tooltip(text: "Add ordered list") %>
    <% end %>
    <% group.with_button(id: "function-blockquote", icon: :quote, classes: "function-button", aria: { label: "Insert blockquote" }) do |b| %>
      <% b.with_tooltip(text: "Insert blockquote") %>
    <% end %>
    <% group.with_button(id: "function-hr", icon: :"horizontal-rule", classes: "function-button", aria: { label: "Insert horizontal rule" }) do |b| %>
      <% b.with_tooltip(text: "Insert horizontal rule") %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::IconButton.new(
    id: "function-help",
    icon: :question,
    classes: "function-button",
    aria: { label: "Help", expanded: false, controls: "gollum-editor-help" }
  )) do |b| %>
    <% b.with_tooltip(text: "Help") %>
  <% end %>

</div>
