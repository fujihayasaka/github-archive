<%= render layout: "marketplace_listings/admin_layout", locals: { marketplace_listing: marketplace_listing, selected_tab: :security_compliance} do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>Security and compliance<% end %>
  <% end %>
  <%= render Marketplace::Listings::SecurityAndComplianceFormComponent.new(listing: marketplace_listing) %>

  <!-- Prev/next nav -->
