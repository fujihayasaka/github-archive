<% page_info title: "Teams" %>

<%= render layout: "settings/settings" do %>
  <%= render Primer::Beta::Subhead.new(hide_border: true, mb: 1) do |component| %>
    <% component.with_heading(tag: :h2) do %>Teams<% end %>
  <% end %>

  <% if payload[:teams].any? %>
    <%= render(Hydro::TrackViewComponent.new(name: "user_settings_team_list_items")) %>
    <%= render_react_partial name: "teams-settings-page", props: payload %>
  <% end %>
<% end %>
