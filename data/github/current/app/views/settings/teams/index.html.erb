<% page_info title: "Teams" %>

<%= render layout: "settings/settings" do %>
  <%= render Primer::Beta::Subhead.new(hide_border: true, mb: 1) do |component| %>
    <% component.with_heading(tag: :h2) do %>Teams<% end %>
  <% end %>

  <% if teams.any? %>
    <% if params[:react].present? %>
      <%= render_react_partial name: "teams-settings-page", props: { teams: teams_payload } %>
    <% else %>
      <div>
        <%= render(Hydro::TrackViewComponent.new(name: "user_settings_team_list_items")) %>
        <div class="Box">
          <% teams.each do |team| %>
            <div class="Box-row d-flex flex-items-center flex-justify-between flex-wrap" <%= test_selector "team-#{team.id}" %>>
              <div class="py-1">
                <%= render(Primer::Beta::Avatar.new(src: team.primary_avatar_url, size: 20, alt: team.combined_slug, shape: :square)) %>
                <strong class="ml-1" <%= test_selector "team-name-#{team.id}" %>>
                  <%= link_to team.combined_slug, team_path(team) %>
                </strong>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
