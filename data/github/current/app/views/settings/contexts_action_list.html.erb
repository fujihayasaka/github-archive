<%= render(Primer::Alpha::SelectPanel::ItemList.new(
  menu_id: "settings-context-switcher",
  select_variant: :single,
  aria: { label: "contexts" },
  data: { test_selector: "settings-context-dropdown" }
)) do |list| %>
  <% available_contexts.each do |context, context_permission| %>
    <%
    link = switch_context_link(
      current_context: current_context,
      target_context: context,
      permission: context_permission
    )
    display_name = target_context_display_name(context)
    context_type = tracking_target_type(context)
    hydro_attrs = hydro_click_tracking_attributes(
      "settings_context_dropdown.click",
      {
        user_id: current_user.id,
        event_context: current_context.organization? ? :ORG_SETTINGS : :USER_SETTINGS,
        target: context_type,
        target_name: display_name,
        target_id: context.id,
        target_link: link
      }
    )
    test_selector = "settings-context-dropdown-link-#{context_type.upcase}-#{context.id}"
    %>
      <% list.with_avatar_item(
        username: display_name,
        src: context.respond_to?(:primary_avatar_url) ? context.primary_avatar_url : nil,
        href: link,
        active: context.id == current_context.id,
        "data-test-selector": test_selector,
        avatar_arguments: {
          shape: :square,
        },
        data: {
          **hydro_attrs
        },
      ) %>
  <% end %>
<% end %>
