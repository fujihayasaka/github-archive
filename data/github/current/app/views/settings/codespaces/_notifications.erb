<% show_check = defined?(show_check) ? show_check : false %>

<div data-replace-remote-form-target>
  <%= render Primer::Beta::Subhead.new(display: :flex, justify_content: :space_between) do |component| %>
    <% component.with_heading(tag: :h2) do %>Notifications
    <% end %>
  <% end %>

  <p>
    When enabled, you will receive emails when your codespaces are nearing deletion due to inactivity.
  </p>

<%= form_tag settings_user_codespaces_expiry_notification_path, method: :put, **test_selector_data_hash("codespaces-user-settings-form") do %>
    <div class="form-checkbox">
      <label class="d-flex">
        <%= check_box_tag \
            'codespaces_expiry_notification',
            Configurable::CodespacesExpiryNotification::ENABLED,
            current_user.codespaces_expiry_notification_enabled?,
            "data-autosubmit": "",
            "aria-describedby": "codespaces_expiry_notification_note" %>
        <div class="ml-2">Enable</div>
        <% if show_check %>
          <%= render Primer::Box.new(display: :flex, direction: :column, classes: 'hx_anim-fade-out') do %>
            <%= render Primer::Beta::Octicon.new(icon: "check-circle", size: :small, pt: 1, ml: 2, text: :green) %>
          <% end %>
        <% end %>
      </label>
      <p class="note" id="codespaces_expiry_notification_note">

        Warning notifications for codespace deletions will be enabled
      </p>
    </div>
  <% end %>

</div>
