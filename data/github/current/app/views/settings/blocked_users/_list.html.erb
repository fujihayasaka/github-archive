<% current_page = local_assigns[:current_page] || 1 %>
<% per_page = local_assigns[:per_page] || 25 %>
<% ignored_users = (current_organization || current_user).sorted_ignored_paginated(page: current_page, per_page: per_page) %>

<div class="js-user-block-settings-list Box">
  <ul class="js-blocked-list" <% if ignored_users.empty? %>hidden<% end %>>
    <% ignored_users.each do |ignore| %>
      <%= render partial: "settings/blocked_users/user", locals: { user_ignore: ignore } %>
    <% end %>
  </ul>
  <%= render Primer::Beta::Blankslate.new(classes: "js-user-block-blank-slate", hidden: ignored_users.any?) do |c| %>
    <% c.with_heading(tag: :h4, classes: "h2") do %>
      You have not blocked any users.
    <% end %>
  <% end %>
</div>

<% if ignored_users.total_pages > 1 %>
  <div class="paginate-container">
    <%= will_paginate ignored_users, previous_label: "Newer", next_label: "Older" %>
  </div>
<% end %>
