<div class="mt-2 d-flex flex-items-center">
  <div class="mr-2 width-full">
    <%= render Primer::Beta::AutoComplete.new(label_text: "Block a user", input_id: "search-user", input_name: "login", list_id: "block-user-complete-results", full_width: true, src: suggestions_url, classes: "js-add-user-completer") do |component| %>
      <% component.with_leading_visual_icon(icon: :person) %>
      <% component.with_input(
        classes: "js-add-blocked-user-field auto-search-input",
        value: display_login,
        aria: { labelledby: "blocked-user-note" },
      ) %>
    <% end %>
    <p id="blocked-user-note" class="mt-1 color-fg-muted text-small" style="margin-bottom: 2px;">Search by username, full name or email address</p>
  </div>

  <%= render Primer::Beta::Button.new(type: :button, scheme: :danger, classes: "js-block-user-button ml-auto", id: "block-user-button", aria: { disabled: true }, inactive: true) do |component| %>
    Block user
  <% end %>
</div>

<%= render Primer::Alpha::Dialog.new(id: "block-user-confirmation-dialog", title: "Block user", size: :large) do |component| %>
  <%= form_tag form_action, class: "js-add-user-form js-remote-submit", method: :post, role: :search, "aria-label": "Block user" do %>
    <input type="hidden" name="login" id="dialog-login-field" value="">
    <input type="hidden" name="duration" id="dialog-duration-field" value="0">
    <%= render(Primer::Alpha::Dialog::Body.new) do %>
      <div id="blocked-user-list">
        <div class="mb-3">
          <strong class="js-blocked-user-display" data-text-template="You are about to block: @{username}">You are about to block: <%= display_login %></strong>
        </div>

        <% if current_organization %>
          <p class="h5">Blocking a user prevents the following on all your repositories:
            <ul class="list-style-none">
              <li><%= primer_octicon(:x, mr: 2, color: :danger) %> opening or commenting on issues or pull requests</li>
              <li><%= primer_octicon(:x, mr: 2, color: :danger) %> starring, forking, or watching</li>
              <li><%= primer_octicon(:x, mr: 2, color: :danger) %> adding or editing wiki pages</li>
            </ul>
          </p>
        <% else %>
          <p class="h5">Blocking a user prevents the following on all your repositories:
            <ul class="list-style-none">
              <li><%= primer_octicon(:x, mr: 2, color: :danger) %> opening or commenting on issues or pull requests</li>
              <li><%= primer_octicon(:x, mr: 2, color: :danger) %> starring, forking, or watching</li>
              <li><%= primer_octicon(:x, mr: 2, color: :danger) %> adding or editing wiki pages</li>
            </ul>
          </p>
          <p class="h5">Additionally, blocked users are not able to:
            <ul class="list-style-none">
              <li><%= primer_octicon(:x, mr: 2, color: :danger) %> invite you as a collaborator to their repositories</li>
              <li><%= primer_octicon(:x, mr: 2, color: :danger) %> follow your account's public activity</li>
              <li><%= primer_octicon(:x, mr: 2, color: :danger) %> send you notifications by @mentioning your username in public repositories</li>
            </ul>
          </p>
        <% end %>
      </div>

      <% if current_organization %>
        <div class="my-3">
          <%= render Primer::Alpha::ActionMenu.new(
            select_variant: :single,
            dynamic_label: true,
            dynamic_label_prefix: "Block",
            menu_id: "block-duration-menu",
            classes: "js-duration-menu"
          ) do |menu| %>
            <% menu.with_show_button do |button| %>
              <%= button.with_trailing_action_icon(icon: :"triangle-down") %>
              Until I unblock them
            <% end %>

            <% menu.with_item(
              label: "For 1 day",
              classes: "js-duration-option",
              data: { "duration-value": "1" }
            ) %>
            <% menu.with_item(
              label: "For 3 days",
              classes: "js-duration-option",
              data: { "duration-value": "3" }
            ) %>
            <% menu.with_item(
              label: "For 7 days",
              classes: "js-duration-option",
              data: { "duration-value": "7" }
            ) %>
            <% menu.with_item(
              label: "For 30 days",
              classes: "js-duration-option",
              data: { "duration-value": "30" }
            ) %>
            <% menu.with_item(
              label: "Until I unblock them",
              classes: "js-duration-option",
              active: true,
              data: { "duration-value": "0" }
            ) %>
          <% end %>
        </div>

        <%= prerelease_badge :time_limited_block,
            public_name: "time-limited blocking",
            external_feedback_url: "https://github.com/maintainers/early-access-feedback/issues/159",
            internal_feedback_url: "https://github.com/github/ce-community-and-safety/issues/486",
            additional_classes: "float-right"
        %>
      <% end %>
    <% end %>
    <%= render(Primer::Alpha::Dialog::Footer.new(show_divider: false)) do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "block-user-confirmation-dialog" })) { "Cancel" } %>
      <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, classes: "js-add-new-user") do %>Block user<% end %>
    <% end %>
  <% end %>
<% end %>
