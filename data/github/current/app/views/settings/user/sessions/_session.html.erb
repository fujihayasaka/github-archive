<%# erblint:counter ButtonComponentMigrationCounter 1 %>
<div class="Box-row p-3 session-device position-relative color-fg-muted">
  <div class="d-flex flex-items-center">
    <!-- Device type (Desktop/Mobile) -->
    <% device_icon = view.mobile? ? :"device-mobile" : :"device-desktop" %>
    <span class="color-fg-muted mr-3 text-center">
      <%= render(Primer::Beta::Octicon.new(
        icon: device_icon,
        height: 32,
        aria: {
          label: view.device_display_name,
          hidden: false,
        }
      )) %>
    </span>

    <div class="flex-auto">
      <!-- Location -->
      <strong class="d-block">
        <% if view.location.any? %>
          <%= view.location[:city] || view.location[:region_name] || view.location[:country_name] %>
        <% end %>
        <span><%= view.ip_address %></span>
      </strong>

      <!-- Activity indicator -->
      <%= view.session_status_indicator %>
      <small> <%= view.session_status_indicator_text %> </small>

      <!-- Gimme those dates -->
      <small class="color-fg-muted d-block">
        <% if view.current_session? %>
          Your current session
        <% else %>
          <%= view.accessed_text %>
          <time>
            <%= view.accessed_at.in_time_zone(Time.zone).strftime('%b %d, %Y') %>
          </time>
        <% end %>
      </small>

      <!-- Country List -->
      <% if view.location_information? %>
        <small class="color-fg-muted">
          Seen in <%= view.country_history %>
        </small>
      <% end %>
    </div>

    <div class="ml-3">
      <a href="<%= settings_show_session_path(view.session_id) %>" class="btn btn-sm mt-1"
      aria-label="View details of session from <%= view.location[:city] || view.location[:country_name] %> last accessed <%= view.accessed_at.in_time_zone(Time.zone).strftime('%B %d, %Y') %>">
        Details
      </a>
    </div>
  </div>
</div>
