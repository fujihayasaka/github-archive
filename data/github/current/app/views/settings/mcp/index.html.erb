<% page_info title: "MCP Servers" %>

<%= render layout: "settings/settings", locals: { classes: "mcp-settings" } do %>

  <%= render Primer::Beta::Subhead.new(mb: 2) do |component| %>
    <% component.with_heading(tag: :h2, id: "pages_label") do %>
      MCP Servers
    <% end %>
    <% component.with_actions do %>
      <% react_partial_replacement(name: "configure-mcp-server-partial", react_enabled: true) do |feature| %>
        <% feature.react do %>
          <%= render_react_partial name: "configure-mcp-server-partial", props: {} %>
        <% end %>
        <% feature.rails do %>
          <%= render Primer::Beta::Button.new(size: :small, disabled: true) do %>
            New Tool
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <div class="note my-0">
    MCP (Model Context Protocol) servers allow you to integrate third-party tools into Copilot.
  </div>

  <div class="d-flex pb-2 mt-4 flex-justify-between">
    <h3 id="installed_mcps" class="text-normal">Installed</h3>
  </div>
  <%= form_tag(mcp_settings_path, method: :get, class: "mb-3") do %>
    <div class="form-group position-relative">
      <%= render(Primer::Beta::Octicon.new(:search, classes: "subnav-search-icon position-absolute left-2 top-2")) %>
      <%= text_field_tag :server_name, params[:server_name],
        id: "server_name_search",
        "data-clear-btn": "clear-search-btn",
        class: "form-control pl-6 pr-6 input-block",
        placeholder: "Search MCP Servers",
        aria: { label: "Search MCP Servers" },
        autocomplete: "off" %>
      <button
        type="button"
        id="clear-search-btn"
        class="position-absolute"
        style="right: 8px; top: 50%; transform: translateY(-50%);
              background: none; border: none; padding: 0; display: none;"
        aria-label="Clear search"
      >
        <%= render(Primer::Beta::Octicon.new(:"x-circle-fill", size: :small, classes: "color-fg-muted")) %>
      </button>
    </div>

    <% if params[:server_name].present? %>
      <div class="mb-3">
        <a class="issues-reset-query" href="<%= mcp_settings_path %>">
          <%= primer_octicon(:x, classes: "issues-reset-query-icon flex-shrink-0") %>
          Clear current search query
        </a>
      </div>
    <% end %>
  <% end %>

  <% if registered_servers.empty? %>
    <div class="Box" <%= test_selector("no-mcp-servers") %>>
      <div class="Box-row d-flex flex-column flex-items-center py-6">
        <% if params[:server_name].present? %>
          <div class="mb-2">
            <%= render(Primer::Beta::Octicon.new(:alert, size: :medium)) %>
          </div>
          <h3 class="mb-2">No results matched your search</h3>
          <div>
            <a class="issues-reset-query f6 color-fg-accent text-normal" href="<%= mcp_settings_path %>">
              Clear current search query
            </a>
          </div>
        <% else %>
          <div class="mb-2">
            <%= render(Primer::Beta::Octicon.new(:tools, size: :medium)) %>
          </div>
          <h2 class="mb-2 m-0">You don't have any MCP servers</h2>
          <p class="color-fg-muted mb-0">MCP servers connect your models to files, APIs, databases and more.</p>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="Box">
      <div class="Box-header d-flex flex-justify-between color-fg-muted text-small text-bold border-bottom">
        <div class="col-6">MCP server name</div>
        <div class="col-4">Installation date</div>
        <div class="col-2 text-right">
          <span class="sr-only">Actions</span>
        </div>
      </div>

      <% registered_servers.each do |server| %>
        <div class="Box-row d-flex flex-justify-between flex-items-center" <%= test_selector("mcp-servers-connected") %>>
          <div class="col-6"><strong><%= server[:display_name] %></strong></div>
          <div class="col-4"><%= server[:created_at].strftime("%B %d, %Y") %></div>
          <div class="col-2 text-right">
            <%= button_to mcp_servers_destroy_path(server[:id]),
                          method: :delete,
                          data: { confirm: 'Are you sure you want to delete this MCP server?' },
                          style: "background: transparent; border: none; box-shadow: none;",
                          aria: { label: "Delete MCP server" } do %>
              <%= render(Primer::Beta::Octicon.new(:trash)) %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="Box-footer d-flex flex-justify-between flex-items-center">
        <p class="text-small color-fg-muted m-0">
          Page <%= page %> of <%= total_pages %>
        </p>

        <% if total_pages > 1 %>
          <nav class="paginate-container" aria-label="Pagination">
            <% (1..total_pages).each do |p| %>
              <% if p == page %>
                <span class="btn btn-sm selected"><%= p %></span>
              <% else %>
                <%= link_to p, safe_url_for(params.merge(page: p)), class: "btn btn-sm" %>
              <% end %>
            <% end %>
          </nav>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
