<% page_info title: "MCP" %>

<%= render layout: "settings/settings" do %>
  <%= render Primer::Beta::Subhead.new(mb: 4) do |component| %>
    <% component.with_heading(tag: :h2, id: "pages_label") do %>
      Configure MCPs
    <% end %>
  <% end %>

  <div class="Box">
    <div class="Box-header">
      <h3 class="Box-title">Add MCP Connection</h3>
      <p>Configure your remote MCP server here by adding the appropriate URL for the connection.</p>
    </div>
    <div class="Box-body">
      <%= form_with url: mcp_servers_create_path, method: :post do |form| %>
        <div class="form-group">
          <%= form.label :mcp_server_url, "MCP Server URL" %>
          <div class="d-flex">
            <%= form.text_field :mcp_server_url, placeholder: "https://mcp.example.com/sse", style: "flex-grow: 1;", class: "form-control mr-2" %>
            <%= form.submit "Add", class: "btn btn-primary" %>
          </div>
          <small>The URL should point to the OAuth authorization server of the MCP.</small>
        </div>
      <% end %>
    </div>
  </div>

  <div class="Box mt-4">
    <div class="Box-header">
      <h3 class="Box-title">MCP Connections</h3>
      <p>View and manage your MCP connections.</p>
    </div>
    <div class="Box-body">
      <%= render(Primer::Alpha::UnderlineNav.new(tag: :div, label: "MCPs", test_selector: "tabs")) do |component| %>
        <% component.with_tab(label: "Connections", href: "#", selected: true) { "Connections" }%>
        <% component.with_tab(label: "Deleted connections", href: "#") { "Deleted connections" }%>
      <% end %>
      <div id="connections" class="mt-3">
        <% if registered_servers.any? %>
          <ul class="list-style-none">
            <% registered_servers.each do |server| %>
              <li class="Box p-3 mb-3">
                <div class="d-flex flex-items-center flex-justify-between">
                  <div>
                    <strong><%= server.name.presence || URI(server.url).host %></strong>
                    <div class="color-fg-muted mt-1" <%= test_selector "mcp-servers-connected" %>>
                      Connected <%= time_ago_in_words(server.created_at) %> ago
                    </div>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="color-fg-muted" <%= test_selector "no-mcp-servers" %>>No MCP servers connected.</p>
        <% end %>
      </div>

      <div id="deleted-connections" class="mt-3" style="display: none;">
        <p>No deleted connections.</p>
      </div>
    </div>
  </div>
<% end %>
