<%
  page_info title: "GitHub Copilot",
            responsive: false,
            selected_link: :organization_copilot_settings_code_review
%>
<%= render layout: "orgs/settings/layout" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :div) do %>
      <h1 class="d-inline-block h2 text-normal">
        Code review
      </h1>
    <% end %>
  <% end %>

  <p>
    With <%= Copilot::COPILOT_CODE_REVIEW %>, Copilot can review pull requests. Configure whether Copilot can
    approve pull requests or count those approvals toward merge requirements across all repositories,
    selected repositories, or at the repository level.
    <a class="Link--inTextBlock" href="<%= Copilot::CODE_REVIEW_DOCS_URL %>">Learn more in the docs.</a>
  </p>

  <%= render Primer::Box.new(classes: "tmp-mt-4", test_selector: "copilot-code-review-approvals-page") do %>
    <%= render Primer::Box.new(test_selector: "code-review-org-approvals-settings") do %>
      <%= render Primer::Beta::Subhead.new(hide_border: true, test_selector: "code-review-org-approvals-settings-heading") do |component| %>
        <% component.with_heading(tag: :h2, font_size: 4, font_weight: :semibold) do %>
          Approvals
        <% end %>
      <% end %>

      <%= render Primer::Box.new(test_selector: "code-review-org-approvals-settings-list") do %>
        <%= render Primer::Beta::BorderBox.new do |component| %>
          <% component.with_row do %>
            <%= render Primer::Box.new(test_selector: "copilot-code-review-approvals-section") do %>
              <%= render_react_partial(
                name: ::Copilot::CodeReviewSettings::REACT_BUNDLE_NAME,
                props: code_review_settings_props,
              ) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>