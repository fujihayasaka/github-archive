<p class="note mb-2">You need to <a href="https://docs.github.com/en/actions/security-for-github-actions/security-hardening-your-deployments/configuring-openid-connect-in-amazon-web-services" target="_blank" rel="noopener noreferrer" class="Link--inTextBlock">configure an IAM OIDC identity provider in AWS</a> that trusts GitHub's OIDC provider before Dependabot can authenticate.</p>
<div class="form-group">
  <div class="form-group-header"><label for="aws_region">AWS Region</label></div>
  <div class="form-group-body">
    <%= text_field_tag :aws_region, local_assigns[:configuration]&.aws_region, required: true, placeholder: "e.g. us-east-1", class: "form-control", data: { "test-selector": "private-registry-aws-region" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="account_id">Account ID</label></div>
  <div class="form-group-body">
    <%= text_field_tag :account_id, local_assigns[:configuration]&.account_id, required: true, placeholder: "AWS Account ID", class: "form-control", data: { "test-selector": "private-registry-account-id" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="role_name">Role Name</label></div>
  <div class="form-group-body">
    <%= text_field_tag :role_name, local_assigns[:configuration]&.role_name, required: true, placeholder: "IAM Role Name", class: "form-control", data: { "test-selector": "private-registry-role-name" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="domain">Domain</label></div>
  <div class="form-group-body">
    <%= text_field_tag :domain, local_assigns[:configuration]&.domain, required: true, placeholder: "CodeArtifact Domain", class: "form-control", data: { "test-selector": "private-registry-domain" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="domain_owner">Domain Owner</label></div>
  <div class="form-group-body">
    <%= text_field_tag :domain_owner, local_assigns[:configuration]&.domain_owner, required: true, placeholder: "Domain Owner Account ID", class: "form-control", data: { "test-selector": "private-registry-domain-owner" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="audience">Audience (optional)</label></div>
  <div class="form-group-body">
    <%= text_field_tag :audience, local_assigns[:configuration]&.audience, placeholder: "OIDC Audience", class: "form-control", data: { "test-selector": "private-registry-audience" } %>
  </div>
</div>
