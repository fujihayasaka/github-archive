    <div class="form-group">
      <div class="form-group-header">
        <label for="username">Username</label>
      </div>

      <div class="form-group-body">
        <%= text_field_tag(
          :username,
          nil,
          id: :username,
          required: true,
          placeholder: "Username",
          class: "form-control",
          value: registry_username,
          data: { "test-selector": "private-registry-username" })
        %>
      </div>
    </div>

    <div class="form-group-header">
      <label for="secret_value">Password</label>
    </div>

    <div class="form-group-body">
      <%= password_field_tag :secret_value, nil, name: 'secret_value', id: :secret_value, class: "form-control" %>
      <input type="hidden" name="encrypted_value">
      <input type="hidden" name="key_id" value="<%= public_key[0] %>">
    </div>
