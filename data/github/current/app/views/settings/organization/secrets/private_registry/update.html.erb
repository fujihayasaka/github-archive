<%# view: Settings::Organization::PrivateRegistrySecretsView %>
<%
  page_info title: "Edit private registry · #{current_organization.name}",
            responsive: false,
            selected_link: view.selected_link
%>
<%= render layout: "orgs/settings/layout" do %>
  <%= render(Primer::Beta::Breadcrumbs.new) do |component| %>
    <% component.with_item(href: settings_org_secrets_path(current_organization)) { "Private registries" } %>
    <% component.with_item(href: request.path, color: :default) { "Edit private registry" } %>
  <% end %>
  <%= render Primer::Beta::Subhead.new(display: :flex, flex_justify: :between, mb: 0) do |component| %>
    <% component.with_heading(tag: :h2) do %>
      Edit private registry
    <% end %>
  <% end %>
  <%= render Organizations::Settings::PrivateRegistryFormComponent.new(
    secret:,
    configuration:,
    view:,
    form_action: :update,
    visibilities:,
    default_visibility:,
    public_key:,
    total_count:,)
  %>
<% end %>
