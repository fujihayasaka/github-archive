<p class="note mb-2">You need to <a href="https://cloud.google.com/iam/docs/workload-identity-federation-with-deployment-pipelines#github-actions" target="_blank" rel="noopener noreferrer" class="Link--inTextBlock">configure a GCP Workload Identity Pool and Provider</a> that trusts GitHub's OIDC token before Dependabot can authenticate to Google Cloud Artifact Registry.</p>
<div class="form-group">
  <div class="form-group-header"><label for="workload_identity_provider">Workload Identity Provider</label></div>
  <div class="form-group-body">
    <%= text_field_tag :workload_identity_provider, local_assigns[:configuration]&.workload_identity_provider, required: true, placeholder: "projects/123456789/locations/global/workloadIdentityPools/POOL/providers/PROVIDER", class: "form-control", data: { "test-selector": "private-registry-workload-identity-provider" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="service_account">Service Account (optional)</label></div>
  <div class="form-group-body">
    <%= text_field_tag :service_account, local_assigns[:configuration]&.service_account, placeholder: "dependabot@my-project.iam.gserviceaccount.com", class: "form-control", data: { "test-selector": "private-registry-service-account" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="audience">Audience (optional)</label></div>
  <div class="form-group-body">
    <%= text_field_tag :audience, local_assigns[:configuration]&.audience, placeholder: "//iam.googleapis.com/projects/123456789/locations/global/workloadIdentityPools/POOL/providers/PROVIDER", class: "form-control", data: { "test-selector": "private-registry-audience" } %>
  </div>
</div>
