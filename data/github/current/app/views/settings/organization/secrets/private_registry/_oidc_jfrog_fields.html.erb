<p class="note mb-2">You need to <a href="https://docs.github.com/en/code-security/how-tos/secure-your-supply-chain/manage-your-dependency-security/configuring-access-to-private-registries-for-dependabot#using-oidc-for-authentication" target="_blank" rel="noopener noreferrer" class="Link--inTextBlock">configure an OIDC integration in JFrog</a> that trusts GitHub's OIDC provider before Dependabot can authenticate.</p>
<div class="form-group">
  <div class="form-group-header"><label for="jfrog_oidc_provider_name">OIDC Provider Name</label></div>
  <div class="form-group-body">
    <%= text_field_tag :jfrog_oidc_provider_name, local_assigns[:configuration]&.jfrog_oidc_provider_name, required: true, placeholder: "JFrog OIDC Provider Name", class: "form-control", data: { "test-selector": "private-registry-jfrog-oidc-provider-name" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="audience">Audience (optional)</label></div>
  <div class="form-group-body">
    <%= text_field_tag :audience, local_assigns[:configuration]&.audience, placeholder: "OIDC Audience", class: "form-control", data: { "test-selector": "private-registry-audience" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="identity_mapping_name">Identity Mapping Name (optional)</label></div>
  <div class="form-group-body">
    <%= text_field_tag :identity_mapping_name, local_assigns[:configuration]&.identity_mapping_name, placeholder: "Identity Mapping Name", class: "form-control", data: { "test-selector": "private-registry-identity-mapping-name" } %>
  </div>
</div>
