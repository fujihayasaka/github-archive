<p class="note mb-2">You need to <a href="https://help.cloudsmith.io/docs/openid-connect" target="_blank" rel="noopener noreferrer" class="Link--inTextBlock">configure an OIDC service account in Cloudsmith</a> that trusts GitHub's OIDC provider before Dependabot can authenticate.</p>
<div class="form-group">
  <div class="form-group-header"><label for="namespace">Organization Namespace</label></div>
  <div class="form-group-body">
    <%= text_field_tag :namespace, local_assigns[:configuration]&.namespace, required: true, placeholder: "Cloudsmith Organization Namespace", class: "form-control", data: { "test-selector": "private-registry-namespace" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="service_slug">Service Slug</label></div>
  <div class="form-group-body">
    <%= text_field_tag :service_slug, local_assigns[:configuration]&.service_slug, required: true, placeholder: "Cloudsmith Service Account Slug", class: "form-control", data: { "test-selector": "private-registry-service-slug" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="audience">Audience</label></div>
  <div class="form-group-body">
    <%= text_field_tag :audience, local_assigns[:configuration]&.audience, required: true, placeholder: "https://github.com/GITHUB-ORG", class: "form-control", data: { "test-selector": "private-registry-audience" } %>
  </div>
</div>
<div class="form-group">
  <div class="form-group-header"><label for="api_host">API Host (optional)</label></div>
  <div class="form-group-body">
    <%= text_field_tag :api_host, local_assigns[:configuration]&.api_host, placeholder: "api.cloudsmith.io", class: "form-control", data: { "test-selector": "private-registry-api-host" } %>
  </div>
</div>
