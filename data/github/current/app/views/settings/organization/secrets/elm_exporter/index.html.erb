<%
  page_info title: "ELM exporter secrets · #{current_organization.name}",
            responsive: false,
            selected_link: Secrets::AppsHelper.highlight_for(Secrets::AppsHelper::ELM_EXPORTER_APP_NAME, current_user)
%>

<%= render layout: "orgs/settings/layout" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>ELM exporter secrets<% end %>
  <% end %>

  <p>
    Configure the personal access tokens (PATs) the ELM exporter uses to authenticate
    with the source and target. Values are encrypted in your browser before being sent to
    GitHub and are never shown again after they are saved.
  </p>

  <% {
    "SOURCE_PAT" => { label: "Source PAT", help: "Used to authenticate with the migration source." },
    "TARGET_PAT" => { label: "Target PAT", help: "Used to authenticate with the migration target." },
  }.each do |secret_name, meta| %>
    <%= form_tag update_settings_org_elm_exporter_secret_path(current_organization, name: secret_name),
      method: :put,
      class: "d-flex flex-column js-encrypt-submit tmp-mb-4",
      "data-public-key" => public_key do %>

      <div class="form-group tmp-mt-0">
        <div class="form-group-header">
          <label for="secret_value"><%= meta[:label] %></label>
        </div>
        <div class="form-group-body">
          <%= password_field_tag :secret_value, nil,
            id: :secret_value,
            class: "form-control width-full",
            autocomplete: "new-password",
            required: true,
            placeholder: configured_secret_names.include?(secret_name) ? "Enter a new value to replace the existing secret" : "Enter the #{meta[:label].downcase}" %>
          <input type="hidden" name="encrypted_value">
          <input type="hidden" name="key_id" value="<%= public_key_id %>">
          <p class="note"><%= meta[:help] %></p>
        </div>
      </div>

      <div class="form-group">
        <%= render Primer::Beta::Button.new("data-disable-with": "Saving…", type: :submit, scheme: :primary) do %>Save <%= meta[:label] %><% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

