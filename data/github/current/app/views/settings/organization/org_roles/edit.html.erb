<% page_info responsive: false, :title => "Organization roles", selected_link: :org_roles %>

<%= render layout: "orgs/settings/layout" do %>
  <%= render(Primer::Beta::Breadcrumbs.new) do |component| %>
    <% component.with_item(href: settings_org_roles_path) do %>Organization roles<% end %>
    <% component.with_item(href: request.path) do %>Edit role<% end %>
  <% end %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2, mt: 3) do %>Edit role<% end %>
  <% end %>

  <%= render partial: 'settings/organization/org_roles/info', locals: { role_limit: OrganizationRole.custom_role_limit_for_org(organization), org_roles_docs_url: org_roles_docs_url } %>
  <%= render OrgRoles::FormComponent.new(owner: organization, role: role, assignment_counts: assignment_counts) %>
<% end %>
