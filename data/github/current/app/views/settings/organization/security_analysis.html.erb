<% page_info responsive: true, title: "Global Advanced Security settings", selected_link: :security_analysis %>

<%= render layout: "orgs/settings/layout" do %>
  <%= render(Settings::SecurityGlobalSettingsFormComponent.new(owner: current_organization, public_repo_count:, repo_count:, cursor: cursor, custom_patterns_query: custom_patterns_query))%>
  <% if current_organization.advanced_security_license.billable_entity&.advanced_security_products_bundled? %>
    <%= render(Organizations::Settings::GhasRepositoriesComponent.new(sku: GitHub::Turboghas::SKU::Bundled, organization: current_organization, page_param: params[AdvancedSecurityEntitiesLinkRenderer::PAGE_PARAM])) %>
  <% else %>
    <div class="ml-4">
      <%= render(Organizations::Settings::GhasRepositoriesComponent.new(sku: GitHub::Turboghas::SKU::SecretSecurity, organization: current_organization, page_param: params[SecretSecurityEntitiesLinkRenderer::PAGE_PARAM])) %>
      <%= render(Organizations::Settings::GhasRepositoriesComponent.new(sku: GitHub::Turboghas::SKU::CodeSecurity, organization: current_organization, page_param: params[CodeSecurityEntitiesLinkRenderer::PAGE_PARAM])) %>
    </div>
  <% end %>
  <%= render(Organizations::Settings::DependabotRepositoryAccessComponent.new(organization: current_organization, page_param: params[:dependabot_page])) %>
<% end %>

<% content_for :scripts do %><%# erblint:disable NoContentForScripts %>
  <%= javascript_bundle "settings" %>
<% end %>
