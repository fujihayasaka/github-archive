<%
  runner_moniker = "self-hosted"
  page_info \
  title: "Add new #{runner_moniker} runner · #{current_organization.name}",
  responsive: false,
  selected_link: :organization_actions_settings_add_new_runner
%>

<%= render layout: "orgs/settings/layout" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>
      <a href="<%= settings_org_actions_runners_path %>">Runners</a> / <%="Create #{runner_moniker} runner"%>
    <% end %>
  <% end %>
  <p>
    Adding a <%=runner_moniker%> runner requires that you download, configure, and execute the
    GitHub Actions Runner. If you do not already have an existing volume licensing agreement for your GitHub
    purchases, by downloading and configuring the GitHub Actions Runner, you agree to the
    <a class="Link--inTextBlock" href="<%= GitHub.url %>/customer-terms">GitHub Customer Agreement</a>.
  </p>

  <% if downloads.empty? # Waiting on background job to setup Actions tenants %>
    <%= render GitHub::PollIncludeFragmentComponent.new(src: settings_org_actions_add_runner_instructions_path, mb: 3, "aria-label": "Loading...") do %>
      <%= render(Primer::Beta::Spinner.new(size: :large, mx: :auto, display: :block)) %>
    <% end %>
  <% else %>
    <%= render partial: "actions/settings/add_runner_instructions", locals: {
        platform: platform,
        os: os,
        architecture: architecture,
        downloads: downloads,
        platform_options: platform_options,
        token: token,
        selected_download: selected_download,
        registration_url: "#{GitHub.url}/#{current_organization.display_login}"
      }
    %>
  <% end %>
<% end %>
