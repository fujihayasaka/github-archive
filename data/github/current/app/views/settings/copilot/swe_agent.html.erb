<% page_info title: project_display_name %>
<%= render layout: "settings/settings" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2, id: "copilot_label", display: :flex, align_items: :center) do %>
      <%= project_display_name %>

      <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2)) do %>
        Preview
      <% end %>
    <% end %>
  <% end %>

  <% unless access_warning_banner_content.nil? %>
    <%= render Primer::Alpha::Banner.new(mb: 3, scheme: :warning) do %>
      <%= access_warning_banner_content %>
    <% end %>
  <% end %>

  <p>
    With <%= project_display_name %>, you can delegate tasks to Copilot, freeing you to focus
    on the creative, complex, and high-impact work that matters most. Simply assign an issue to Copilot, wait
    for the agent to request your review, then leave feedback on the pull request to iterate.
    <a class="Link--inTextBlock" href="https://gh.io/copilot-coding-agent-docs">Learn more in the docs.</a>
  </p>

  <div class="mt-4">
    <%= render_react_partial name: "copilot-swe-agent-repos-picker", props: {
      projectDisplayName: project_display_name,
      userLogin: copilot_user.display_login,
      selection: selection,
      mode: mode,
      modeChangedCallbackPath: mode_changed_callback_path,
      selectionsChangedCallbackPath: selections_changed_callback_path
    } %>
  </div>

  <div class="mt-4">
    <p class="fgColor-muted">Use of Copilot coding agent is subject to the <a class="Link--inTextBlock" href="https://docs.github.com/en/site-policy/github-terms/github-pre-release-license-terms">pre-release terms</a>.</p>
  </div>
<% end %>
