<% page_info title: "Coding tools", selected_link: :coding_tools %>

<%= render layout: "settings/settings" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>Coding tools<% end %>
  <% end %>
  <p class="tmp-mb-3">Tools enabled here can be used to work on issues.</p>

  <%= render_react_partial(
    name: "coding-tools-settings",
    props: {
      tools: CodingToolsHelper::KNOWN_TOOLS,
      settings: coding_tools_settings,
      updatePath: settings_coding_tools_path,
    },
  ) %>
<% end %>
