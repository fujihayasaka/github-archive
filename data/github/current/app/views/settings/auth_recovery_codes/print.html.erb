<%# rubocop:disable Lint/InstanceVariable %>
<% @page_class = "js-print-popup" %>

<div class="container-sm mx-auto tmp-mt-6">
  <%# overriding colors for print view - https://github.com/github/authentication/issues/4041 %>
  <div class="Box tmp-mb-3 tmp-p-3" style="background-color: white; color: black;">
    <h3 class="Box-row">
      Recovery codes
      <%= primer_octicon(:"mark-github", float: :right, classes: "two-factor-recovery-code-mark") %>
    </h3>
    <div class="Box-row tmp-pl-5 mt-2">
      <ul class="two-factor-recovery-codes">
        <% codes.each do |code| %>
          <li class="two-factor-recovery-code"><%= code %></li>
        <% end %>
      </ul>
    </div>
    <div class="Box-footer Box-row--gray tmp-mt-3" style="background-color: white; color: black;">
      <%= GitHub.flavor %> two-factor authentication account recovery codes.
    </div>
  </div>
</div>
