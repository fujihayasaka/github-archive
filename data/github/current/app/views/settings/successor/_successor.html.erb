<% user = successor_invite.invitee %>
<div class="Box-row d-sm-flex flex-justify-between">
  <div>
    <%= linked_avatar_for(user, 28, img_class: "avatar v-align-middle mr-1") %>
    <%= profile_link(user) %>
  </div>

  <div class="d-sm-flex flex-justify-end flex-items-center">
    <% if successor_invite.accepted? %>
      <div class="mt-2 mt-sm-0">
        <%= form_tag unset_successor_path(login: user.display_login),
                    method: :put,
                    class: "inline-form v-align-middle" do %>
          <%= render Primer::Beta::Button.new(scheme: :danger, size: :small, type: :submit).with_content("Revoke") %>
        <% end %>
      </div>
    <% end%>

    <% if successor_invite.pending? %>
      <div class="text-small color-fg-severe text-bold mt-2 mt-sm-0 mr-3">
        Pending
      </div>

      <div class="d-flex flex-items-center mt-2 mt-sm-0">
        <%= render Primer::Alpha::Dialog.new(title: "Share invitation link") do |dialog| %>
          <% dialog.with_show_button(size: :small, mr: 3) do |button| %>
            <% button.with_leading_visual_icon(icon: :share) %>
            Share invitation link
          <% end %>
          <% dialog.with_body do %>
            <p class="mb-3">
              This link will only work for <strong>@<%= user.display_login %></strong>.
            </p>
            <div class="input-group">
              <input type="text" class="form-control input-monospace input-sm" data-autoselect value="<%= successor_invite.permalink %>" aria-label="Copy and share invite link <%= successor_invite.permalink %>" readonly autofocus>
              <div class="input-group-button">
                <%= render Primer::Beta::ClipboardCopy.new(
                  classes: "btn btn-sm",
                  value: successor_invite.permalink,
                  aria: { label: "Copy to clipboard" },
                ) %>
              </div>
            </div>
          <% end %>
          <% dialog.with_footer do %>
            <%= render Primer::Beta::Button.new(data: { "close-dialog-id": dialog.id }).with_content("Close") %>
          <% end %>
        <% end %>

        <%= form_tag cancel_successor_invitation_path(login: user.display_login),
                    method: :put,
                    class: "inline-form v-align-middle d-inline-flex" do %>
          <%= render Primer::Beta::Button.new(scheme: :danger, size: :small, type: :submit).with_content("Cancel") %>
        <% end %>
      </div>
    <% end %>

    <% if successor_invite.declined? %>
      <div class="text-small color-fg-danger text-bold mt-2 mt-sm-0 mr-3">
          Declined
      </div>
    <% end %>
  </div>
</div>
