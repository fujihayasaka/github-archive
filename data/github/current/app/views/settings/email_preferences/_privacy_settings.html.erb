<% stealth_email = StealthEmail.new(current_user) %>
<% if stealth_email.valid? %>
  <div class="mt-3 p-3 border-sm rounded-2">
    <%= form_tag toggle_visibility_user_emails_path(current_user), :method => :put, "data-autosubmit" => true do %>
      <div class="d-flex flex-justify-between flex-items-start gap-4">
        <div class="d-flex flex-column">
          <p id="toggle_visibility_label" class="text-bold mb-0">
            Keep my email addresses private
          </p>
          <p id="toggle_visibility_note" class="note">
          We’ll remove your public profile email and use <strong><%= stealth_email_display %></strong> when performing web-based Git operations (e.g. edits and merges) and
          sending email on your behalf. If you want command line Git operations to use your private email you must
          <a class="Link--inTextBlock" href="<%= GitHub.help_url %>/articles/setting-your-email-in-git">set your email in Git</a>.
          </p>
          <p class="note">Previously authored commits associated with a public email will remain public.</p>
        </div>
        <%= render Primer::Alpha::ToggleSwitch.new(
          checked: current_user.emails.with_role("primary").private?,
          aria: { labelledby: "toggle_visibility_label", describedby: "toggle_visibility_note" },
          csrf_token: "", # handled by form_tag
          size: :small,
          ) %>
      </div>


      <noscript>
        <p><%= render Primer::Beta::Button.new(size: :small, scheme: :primary, type: :submit) do %>Save changes<% end %></p>
      </noscript>
    <% end %>
  </div>

  <% if current_user.emails.with_role("primary").private? %>
    <div class="mt-2">
      <%= form_tag toggle_email_visibility_warning_user_emails_path(current_user), :method => :put, "data-autosubmit" => true do %>
        <div class="d-flex flex-justify-between flex-items-center">
          <label id="toggle_warning">
            Block command line pushes that expose my email
          </label>
          <%= render Primer::Alpha::ToggleSwitch.new(
            checked: current_user.warn_private_email?,
            aria: { labelledby: "toggle_warning", describedby: "toggle_warning_note" },
            csrf_token: "", # handled by form_tag
            size: :small,
            ) %>
        </div>
        <p id="toggle_warning_note" class="note">
          When you push to GitHub, we’ll check the most recent commit. If the author email on that commit is a private email on your GitHub account, we will block the push and warn you about exposing your private email.
        </p>

        <noscript>
          <p><%= render Primer::Beta::Button.new(size: :small, scheme: :primary, type: :submit) do %>Save changes<% end %></p>
        </noscript>
      <% end %>
    </div>
  <% end %>
<% end %>
