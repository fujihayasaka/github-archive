<% can_manage_subscription = GitHub.email_preference_center_enabled?(current_user) &&
    email.verified?
  subscription_email = current_user.remove_shortcode(email.email) if can_manage_subscription
%>

<%= render(Primer::Alpha::ActionMenu.new(menu_id: "manage-email-#{email.id}")) do |menu| %>
  <% menu.with_show_button(icon: :"kebab-horizontal", scheme: :invisible, "aria-label": "Manage email #{display_email}") %>
  <% if can_manage_subscription %>
    <% menu.with_item(
      label: "Manage email preferences",
      tag: :a,
      href: settings_email_subscriptions_path(email: subscription_email),
      ) %>
  <% end %>
  <% if email.claimed? %>
    <% menu.with_item(
      label: "Unverify",
      tag: :button,
      scheme: :danger,
      href: user_mark_email_as_unclaimed_path(current_user, email),
      form_arguments: { method: :post },
      ) %>
  <% else %>
    <% if email.verification_token.nil? %>
      <% menu.with_item(
        label: "Verify email address",
        tag: :button,
        href: user_request_claim_email_path(current_user, email),
        form_arguments: { method: :post },
        ) %>
    <% end %>
    <% menu.with_item(
      label: "Input verification code",
      tag: :button,
      disabled: email.verification_token.nil?,
      content_arguments: {
        data: { "show-dialog-id": "claim-email-#{email.id}" }
      }) %>
    <% menu.with_item(
      label: "Resend email",
      tag: :button,
      disabled: email.verification_token.nil?,
      href: user_request_claim_email_path(current_user, email),
      form_arguments: { method: :post },
      ) %>
    <% if email.verification_token.present? %>
      <% menu.with_divider %>
      <% menu.with_item(
        label: "Cancel verification",
        tag: :button,
        scheme: :danger,
        href: user_cancel_email_claim_request_path(current_user, email),
        form_arguments: { method: :post },
        ) %>
    <% end %>
  <% end %>
<% end %>

<% unless email.claimed? %>
  <%= render Primer::Alpha::Dialog.new(title: "Verify your email", id: "claim-email-#{email.id}") do |dialog| %>
    <% dialog.with_body do %>
      <%= form_tag user_confirm_claim_email_path(current_user, email) do %>
        <div class="mt-3 d-flex flex-items-end">
          <div class="flex-auto">
            <input type="text" name="token" class="form-control input-contrast width-full rounded-right-0" placeholder="Enter your token" aria-label="Enter your token">
          </div>
          <div>
            <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary, aria: { label: "Verify email for #{current_user.profile_email}" }, classes: "rounded-left-0") do %>
              Verify
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
