  <%= render Primer::Beta::BorderBox.new(border_radius: 2) do |component| %>
    <% component.with_body do %>
      <%= form_tag set_backup_user_email_path(current_user), method: :put, "data-autosubmit" => true, class: "d-flex flex-justify-between", "aria-labelledby": "backup_email_select_label" do %>
        <div style="flex-shrink: 100;">
          <label id="backup_email_select_label" for="backup_email_select">Backup email address</label>
          <p class="mb-0 note">
            Your backup GitHub email address will be used as an additional destination for security-relevant account notifications and can also be used for password resets.
          </p>
        </div>
        <div class="d-flex flex-items-start">
          <% if current_user.change_email_enabled? %>
            <% default = backup_email_default_selection %>
            <%= render Primer::Alpha::Select.new(
              name: "id", # NEEDS TO BE id, as the endpoint is looking for that param name
              id: "backup_email_select",
              label: "Select email to become backup",
              visually_hide_label: true,
              class: "d-flex flex-items-center",
            ) do |selector| %>
              <% backup_email_select_options.each do |email, id| %>
                <% selector.option(class: "backup-option", label: current_user.remove_shortcode(email), value: id, selected: default == id) %>
              <% end %>
            <% end %>

            <noscript>
              <%= render Primer::Beta::Button.new(size: :small, type: :submit) do %>Save changes<% end %>
            </noscript>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= render partial: "settings/email_preferences/privacy_settings", locals: { stealth_email_display: stealth_email_display } %>
