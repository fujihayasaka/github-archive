<% unless current_user.scim_managed_user? %>
  <%= render Primer::Beta::BorderBox.new(border_radius: 2) do |component| %>
    <% component.with_body do %>
      <%= form_tag set_primary_user_email_path(current_user), method: :put, "data-autosubmit" => true, class: "d-flex flex-justify-between", "aria-labelledby": "primary_email_select_label" do %>
        <div style="flex-shrink: 100;">
          <label id="primary_email_select_label" for="primary_email_select">Primary email address</label>
          <p class="mb-0 note">
            Select an email to be used for account-related notifications and can be used for password reset.
          </p>
        </div>
        <div class="d-flex flex-items-start">
          <% if current_user.change_email_enabled? %>
            <% default = primary_email_default_selection %>
            <%= render Primer::Alpha::Select.new(
              name: "id", # NEEDS TO BE id, as the endpoint is looking for that param name
              id: "primary_email_select",
              label: "Select email to become primary",
              visually_hide_label: true,
              class: "d-flex flex-items-center",
            ) do |selector| %>
              <% primary_email_select_options.each do |email, id| %>
                <% selector.option(class: "primary-option", label: current_user.remove_shortcode(email), value: id, selected: default == id) %>
              <% end %>
            <% end %>

            <noscript>
              <%= render Primer::Beta::Button.new(size: :small, type: :submit) do %>Save changes<% end %>
            </noscript>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
