<% page_info :title => "Credentials" %>

<%= render layout: "settings/settings" do %>
  <%= render Primer::Beta::Subhead.new(spacious: true) do |component| %>
    <% component.with_heading(tag: :h2) do %>Credentials<% end %>
  <% end %>

  <p class="tmp-mb-4">
    View and manage all the credentials generated or authorized by your personal account.
  </p>

  <%= render Settings::CredentialsOverviewComponent.new(user: current_user) %>

  <%= render Settings::CredentialsDangerZoneComponent.new(user: current_user) %>
<% end %>
