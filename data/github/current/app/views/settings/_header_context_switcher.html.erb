<%
  locals = ensure_local_vars(local_assigns, {
    required: [:current_context],
    optional: [],
    defaults: {},
    view: "settings/header_context_switcher"
  })
  available_contexts = available_contexts(current_context: locals[:current_context])
  include_filter = available_contexts.size > SettingsHelper::CONTEXT_DROPDOWN_MIN
  account_type = current_context.organization? ? "organization" : "personal"
  hydro_attrs = hydro_click_tracking_attributes(
  "settings_context_dropdown.click",
  {
    user_id: current_user.id,
    event_context: current_context.organization? ? :ORG_SETTINGS : :USER_SETTINGS,
    target: :DROPDOWN,
    target_name: nil,
    target_id: nil,
    target_link: nil
  }
)
%>

<% if available_contexts.any? %>
  <%= render(Primer::Alpha::SelectPanel.new(
    id: "settings-context-switcher-#{locals[:current_context].id}",
    title: "Select settings context",
    src: settings_available_contexts_path(context_type: current_context.organization? ? "org" : "user",
        id: current_context.display_login),
    open_on_load: false,
    show_filter: true,
    data: { **hydro_attrs },
    "data-test-selector": "settings-context-header"
  )) do |panel| %>
    <% panel.with_show_button(
      size: :small,
    ) do |button| %>
      <% button.with_leading_visual_icon(icon: "arrow-switch", color: :muted) %>
      <% button.with_trailing_visual_icon(icon: "triangle-down", color: :muted) %>
      Go to settings page
    <% end %>
  <% end %>
<% end %>
