<%# rubocop:disable Lint/InstanceVariable %>
<% page_info title: "Two-factor authentication", class: "page-two-factor-auth session-authentication" %>

<%= render Sessions::AuthenticationWrapperComponent.new(
      id: "login",
      body_classes: "sessions-two-factor-w-full",
    ) do |component| %>

  <% component.with_header do %>
    <%= render_react_partial name: "sessions-auth-header", props: { variant:  "github", avatarUrl: @user ? image_path(@user.primary_avatar_url(100)) : nil, userName: @user&.name, title: "Two-factor authentication", description: "Enter the code from your two-factor authentication app or browser extension below." } %>
  <% end %>

  <% component.with_body do %>
      <%= render(partial: "sessions/totp/app_prompt", locals: {
      user: @user,
      form_type: "login",
      otp: defined?(otp) && otp,
    }) %>
    <div class="mt-2">
      <%= render(Sessions::TwoFactorAlternativesComponent.new(user: @user, prompt_type: "app", list_label_id: "problems-options")) %>
    </div>
  <% end %>
<% end %>
