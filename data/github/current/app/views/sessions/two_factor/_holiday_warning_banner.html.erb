<%= render Primer::Alpha::Banner.new(tag: :section, full: true, icon: :alert, classes: "js-notice", test_selector: "holiday-warning-banner-flash", role: "region", "aria-labelledby": "holiday-warning-banner") do |b| %>
  <span id="holiday-warning-banner" class="text-bold">Don't get locked out of your account.</span>
  <%= link_to "Download your recovery codes", settings_auth_recovery_codes_path(two_factor_holiday_warning: true), target: "_blank", class: "Link--inTextBlock"%>
  <% if passkeys_enabled %>
    or
    <%= link_to "add a passkey", settings_security_path(two_factor_holiday_warning: true, anchor: "passkeys"), target: "_blank", class: "Link--inTextBlock" %>
  <% end %>
  so you don't lose access when you get a new device.

  <% b.with_action_content(align_items: :flex_end, display: :flex) do %>
    <%= form_tag settings_user_2fa_dismiss_holiday_warning_banner_path, method: :patch, class: "js-notice-dismiss" do %>
      <%= render Primer::Beta::CloseButton.new(type: :submit, mx: 2, "aria-label": "dismiss-holiday-warning-banner") %>
    <% end %>
  <% end %>
<% end %>
