<% page_info title: "Link account", class: "page-two-factor-auth session-authentication" %>
<% display_login = "@#{user.display_login}"%>

<%= render Sessions::AuthenticationWrapperComponent.new do |component| %>
  <% component.with_header do %>
    <%= render_react_partial name: "sessions-auth-header", props: { variant: "github", avatarUrl: user ? image_path(user.primary_avatar_url(100)) : nil, userName: user&.name, title: "Add new sign in method", description: ("<strong>#{email}</strong> is an existing email on <strong>@#{user.display_login}</strong>. Do you want to enable #{provider.downcase.capitalize} sign in for <strong>#{display_login}</strong>?") } %>
    <% end %>
  <% component.with_body do %>
    <%= render "shared/flash" %>

    <div class="authentication-body-buttons">
      <%= form_tag social_confirm_continue_path(provider: provider) do %>
        <%= render(Primer::Beta::Button.new(type: :submit, block: true, scheme: :primary)) { "Link account" } %>
        <%= render(Primer::Beta::Button.new(type: :submit, block: true, scheme: :link, underline: true, name: "cancel", value: "true")) { "Return to sign in" } %>
      <% end %>
    </div>
  <% end %>
  <% component.with_footer do %>
    <% if user.two_factor_authentication_enabled? %>
      <p class="border-top color-bg-default pt-4" <%= test_selector "email-unlink-info" %>>
        If you want to use this email with another account, sign into <strong><%= display_login %></strong> to remove it or use
        <%= link_to "email unlink", docs_url("account-and-profile/unlinking-your-email-address"), class: "Link--inTextBlock" %> if you don't have account access.
      </p>
    <% end %>
  <% end %>
<% end %>


