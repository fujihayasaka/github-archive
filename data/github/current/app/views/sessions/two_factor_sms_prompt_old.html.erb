<%# rubocop:disable Lint/InstanceVariable %>
<% page_info title: "Two-factor authentication", class: "page-two-factor-auth session-authentication" %>

<div id="login" class="auth-form px-3">
  <div class="auth-form-header p-0">
    <h1>Two-factor authentication</h1>
  </div>

  <%= render(partial: "sessions/totp/sms_prompt_old", locals: {
    user: @user,
    form_type: "login",
    otp: defined?(otp) && otp,
  }) %>

  <%= render(Sessions::TwoFactorAlternativesComponent.new(user: @user, prompt_type: "sms", list_label_id: "problems-options")) %>
</div>
