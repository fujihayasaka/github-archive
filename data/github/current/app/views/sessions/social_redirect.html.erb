<%# app/views/sessions/social_meta_redirect.html.erb %>
<% page_info title: "Redirecting to #{provider_name}" %>
<div class="container-lg">
  <%= render Primer::Beta::Blankslate.new(
    icon: "sign-in",
    title: "Redirecting to #{provider_name}",
    mt: 5,
  ) do %>
    <p>
      If you are not redirected automatically,
      please <%= link_to 'click here for a manual redirect', redirect_url, class: "Link--inTextBlock" %>.
    </p>
  <% end %>
</div>
<meta http-equiv="refresh" content="0; url=<%= redirect_url %>">
