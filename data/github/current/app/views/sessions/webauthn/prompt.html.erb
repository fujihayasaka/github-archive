<%# rubocop:disable Lint/InstanceVariable %>
<% page_info title: "Two-factor authentication", class: "page-two-factor-auth session-authentication" %>

<%= render Sessions::AuthenticationWrapperComponent.new(
      id: "login",
    ) do |component| %>

  <% component.with_header do %>
    <%= render_react_partial name: "sessions-auth-header", props: { variant: "github", avatarUrl: @user ? image_path(@user.primary_avatar_url(100)) : nil, userName: @user&.name, title: "Two-factor authentication", description: "Authenticate using your #{ webauthn_user.available_u2f_registrations_description(current_device_id, capitalize_first_word: false)}." } %>
    <% end %>

  <% component.with_body do %>
    <%= render "shared/flash" %>

    <div class="authentication-body-buttons">
      <%= form_tag webauthn_authenticate_path, { :method => "post", :class => "js-webauthn-form" } do %>
        <%= render(partial: "/sessions/webauthn/get", locals: {
          webauthn_user: @user,
          webauthn_reason: :two_factor_sign_in,
          is_primary_auth_option_in_prompt: true,
        }) %>
        <input type="hidden" name="response" class="js-webauthn-response btn">
      <% end %>
      <%= render(Sessions::TwoFactorAlternativesComponent.new(user: @user, prompt_type: "device", current_device_id: current_device_id, list_label_id: "verification-options")) %>
    </div>
  <% end %>
<% end %>
