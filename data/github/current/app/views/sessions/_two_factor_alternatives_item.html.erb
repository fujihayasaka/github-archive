<% button_options = {
  scheme: defined?(scheme) ? scheme : :secondary,
  size: :large,
  classes: "btn-secondary btn-block #{defined?(extra_classes) ? extra_classes : ''}",
  href: href,
  tag: :a
} %>
<% button_options["data-test-selector"] = data_test_selector if defined?(data_test_selector) && data_test_selector %>
<% button_options[:target] = target if defined?(target) && target %>
<li class="two-factor-alternatives-item" style="--i: <%= index %>">
  <%= render Primer::Beta::Button.new(**button_options) do %>
    <span class="two-factor-alternatives-item-text"><%= button_text %></span>
    <% if defined?(external) && external %>
      <%= render(Primer::Beta::Octicon.new(:"link-external", size: :small)) %>
    <% end %>
  <% end %>
</li>
