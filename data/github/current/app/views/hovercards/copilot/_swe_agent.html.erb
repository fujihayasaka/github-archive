<div id="swe_agent_hovercard" class="p-3">
  <div class="d-inline-flex flex-items-center">
    <span class="avatar avatar-3 circle color-fg-muted mr-2 d-flex flex-justify-center flex-items-center">
      <% if is_3p_agent %>
        <img class="<%= avatar_class_names(bot) %>" src="<%= bot.primary_avatar_url(40) %>" width="20" height="20" alt="@<%= bot %>">
      <% else %>
        <%= render Primer::Beta::Octicon.new(icon: "copilot", size: :xsmall ) %>
      <% end %>
    </span>
    <%= profile_link bot, class: "assignee Link--primary css-truncate-target width-fit" do %>
      <span class="css-truncate-target width-fit text-semibold"><%= bot.display_login -%></span>
    <% end %>
  </div>
  <div class="flex-row ml-5 mb-2 mt-1 color-fg-muted text-normal">
    Delegate issues to <%= bot.display_login %>, so you can focus on the creative, complex, and high-impact work that matters most.
  </div>
</div>
