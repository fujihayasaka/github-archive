<div <%= test_selector("projects-hovercard") %>>
  <div class="p-3">
    <div class="mb-2">
      <%= render(Primer::Beta::Text.new(font_size: 6, color: :muted, mb: 2)) do %>
        <%= project.owner.display_login %>#<%= project.number %> updated <%= time_ago_in_words_js project.updated_at %>
      <% end %>
    </div>

    <div class="d-flex">
      <span class="lh-condensed py-1 pr-2">
        <%= render(Primer::Beta::Octicon.new(icon, color: :default, mr: 1)) %>
      </span>
      <div class="lh-condensed mt-1">
        <a class="no-underline Link--primary" class="d-inline-block" href="<%= project.permalink %>">
          <span class="h5"><%= title %></span>
        </a>
        <% if title_sub_text.present? %>
          <div>
            <%= render(Primer::Beta::Text.new(font_size: 6, color: :muted, mb: 2)) do %>
              <%= title_sub_text %>
            <% end %>
          </div>
        <% end %>
        <div class="mt-2" style="word-break: break-word;">
          <%= sanitize_html project.short_description_html %>
        </div>
      </div>
    </div>
  <% if this_status.present? %>
    <div class="border-top mr-n3 ml-n3 mt-3 pt-3">
      <div class="d-flex f6 flex-auto flex-wrap flex-items-center px-3">
        <div class="f6 d-flex mb-2">
          <div class="hovercard-icon mr-2 mb-1">
                <%= avatar_for(this_status.creator, 16, class: "avatar") %>
          </div>
          <span><%= profile_link this_status.creator %></span>
          <span class="color-fg-muted">&nbsp;updated <%= time_ago_in_words(this_status.updated_at) %> ago</span>
        </div>
        <%= render(Memex::ProjectStatusUpdateInfoComponent.new(owner: project.owner, project: project, update_id: this_status.id))%>
        </div>
      </div>
    </div>
  <% end %>
</div>
