<%= render Primer::Beta::Popover.new(
  position: :absolute,
  pt: 1,
  left: true,
  hide: :whenNarrow,
  classes: "js-notice",
  style: "top: 42px; left: -117px",
) do |component| %>
  <% component.with_heading(tag: :h2, font_size: 3) do %>
    View transitive paths
  <% end %>
  <% component.with_body(position: :relative, caret: :top, color: :muted, mt: 0, style: "width: 300px;") do %>
    <p>
      You can view transitive paths for packages within supported ecosystems.
      <%= render(Primer::Beta::Link.new(href: "#{GitHub.help_url}/code-security/supply-chain-security/understanding-your-software-supply-chain/dependency-graph-supported-package-ecosystems", classes: "Link--inTextBlock", underline: true).with_content("Learn more")) %>
    </p>
    <%= form_tag(
      dismiss_notice_path("dependency_graph_view_transitive_paths"),
      class: "js-notice-dismiss",
      ) do %>
      <%= render Primer::Beta::Button.new(type: :submit, scheme: :invisible, right: 0) do %>
        OK, got it
      <% end %>
    <% end %>
  <% end %>
<% end %>
