<% if current_repository.adminable_by?(current_user) %>
  <%= render Primer::Beta::Blankslate.new do |component| %>
    <% component.with_visual_icon(icon: :package) %>
    <% component.with_heading(tag: :h3).with_content("Dependency graph is disabled") %>
    <% component.with_description do %>
      <% if has_enforced_security_configuration_for_dependency_graph? %>
        <p class="mt-3">
          Enabling the dependency graph has been blocked by your organization administrators with a
          <%= render(Primer::Beta::Link.new(
            href: docs_url("code-security/about-security-configurations"),
            target: :blank,
            classes: "Link--inTextBlock")) { "security configuration" }
          %>.
          Contact your organization administrators to enable the dependency graph.
        </p>
      <% else %>
        Track this repository’s
          <%= render(Primer::Beta::Link.new(
            href: "#{GitHub.help_url}/github/visualizing-repository-data-with-graphs/about-the-dependency-graph#supported-package-ecosystems",
            target: :blank,
            classes: "Link--inTextBlock")) { "dependencies and sub-dependencies" }
          %>.
        <%= form_tag update_security_products_settings_path(current_repository.owner, current_repository), method: :put do %>
          <input type="hidden" name="dependency_graph_enabled" value="1">
          <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit, my: 4, mr: :auto, ml: :auto)) { "Enable the dependency graph" } %>
        <% end %>
      <% end %>
      <p class="f5">
        <%= render(Primer::Beta::Link.new(
          href: "#{GitHub.help_url}/site-policy/privacy-policies/github-privacy-statement",
          target: :blank,
          classes: "Link--inTextBlock")) { "Learn more about how we use your data." }
        %>
      </p>
    <% end %>
  <% end %>
<% else %>
  <%= render Primer::Beta::Blankslate.new do |component| %>
    <% component.with_visual_icon(icon: :package) %>
    <% component.with_heading(tag: :h3).with_content("Dependency graph is disabled") %>
    <% component.with_description do %>
      <p class="mt-3">
        <% if current_repository.owner.is_a?(Organization)%>
          Dependency graph has not been enabled by an organization owner or a user with admin permissions for this repository.
        <% else %>
          The owner of this repository has not enabled the dependency graph.
        <% end %>
        Once enabled, you can <%= render(Primer::Beta::Link.new(
          href: "#{GitHub.help_url}/github/visualizing-repository-data-with-graphs/about-the-dependency-graph#supported-package-ecosystems",
          target: :blank,
          classes: "Link--inTextBlock")) { " track this repository’s dependencies" }
          %>.
      </p>
      <p class="f5">
        <%= render(Primer::Beta::Link.new(
          href: "#{GitHub.help_url}/site-policy/privacy-policies/github-privacy-statement",
          target: :blank,
          classes: "Link--inTextBlock")) { "Learn more about how we use your data." }
        %>
      </p>
    <% end %>
  <% end %>
<% end %>
