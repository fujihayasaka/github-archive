<div class="Box color-border-muted">
  <%= render Primer::Beta::Blankslate.new(spacious: true) do |c| %>
    <% c.with_visual_icon(icon: "stop") %>

    <% c.with_heading(tag: :h2) do %>
      Dependency graph workflow details are currently unavailable
