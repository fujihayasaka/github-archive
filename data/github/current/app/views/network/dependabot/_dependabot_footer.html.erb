<div class="protip">
  <p>
    <%= link_to "Dependabot version updates", GitHub.dependabot_version_updates_help_url, class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %>
    automatically keep your application up-to-date by periodically updating dependencies to their latest versions.
    <% if current_repository.automated_security_updates_visible_to?(current_user) %>
      <%= link_to "Dependabot security updates", repository_alerts_path(current_repository.owner, current_repository), class: "Link--inTextBlock" %>
      can also help keep dependencies updated.
    <% end %>
  </p>
</div>
