<%
  page_info(
    title: "Please verify your email address",
    class: "header-overlay",
    hide_flash: true,
    full_height: true,
  )
%>

<% content_for :signups_left_panel do %>
  <%= render(Signups::SignupsContentPanelComponent.new(custom_page_param: custom_page_param)) %>
<% end %>

<%# hide the global notices UI %>
<% content_for :global_notices do %>
  <span hidden></span>
<% end %>

<%= render(Signups::LaunchCodeComponent.new(
  email: user_email,
  resent: params[:resent]&.to_i == 1,
  error: flash[:error],
  invitation_token: params[:invitation_token],
  repo_invitation_token: params[:repo_invitation_token]
)) %>
