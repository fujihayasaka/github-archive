<%
  runner_moniker = "self-hosted"
  title = "Add new #{runner_moniker} runner · #{current_repository.name_with_display_owner}"
  page_info \
  container_xl: true,
  title: title,
  selected_link: :repository_actions_settings_add_new_runner
%>

<%= render layout: "edit_repositories/edit" do %>
  <%= render(Primer::Beta::Breadcrumbs.new(classes: "tmp-mb-3")) do |component| %>
    <% component.with_item(href: repository_actions_settings_runners_path) { "Runners" } %>
    <% component.with_item(href: request.path, selected: true, color: :muted) { title } %>
  <% end %>

  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>
      <%=title%>
    <% end %>
  <% end %>

  <% if current_repository.public? && FeatureFlag.vexi.enabled?(:repositories_self_hosted_runner_visibility_warning, current_user, current_repository, current_repository.owner, current_repository.owner&.business, default: false) %>
    <div <%= test_selector "self-hosted-public-warning" %> aria-hidden="true"></div>
    <%= render Primer::Alpha::Banner.new(scheme: :warning, full: true, classes: "tmp-mb-3") do %>
      <strong>Using self-hosted runners in public repositories is not recommended.</strong> Forks of your public repository can potentially run dangerous code on your self-hosted runner by creating a pull request.
      <a class="Link--inTextBlock" href="<%= GitHub.help_url %>/actions/hosting-your-own-runners/managing-self-hosted-runners/about-self-hosted-runners#self-hosted-runner-security-with-public-repositories">Learn more about security hardening for self-hosted runners</a>.
    <% end %>
  <% end %>

  <p>
    Adding a <%=runner_moniker%> runner requires that you download, configure, and execute the
    GitHub Actions Runner. If you do not already have an existing volume licensing agreement for your GitHub
    purchases, by downloading and configuring the GitHub Actions Runner, you agree to the
    <a class="Link--inTextBlock" href="<%= GitHub.url %>/customer-terms">GitHub Customer Agreement</a>.
  </p>

  <%= render partial: "actions/settings/add_runner_instructions", locals: {
      platform: platform,
      os: os,
      architecture: architecture,
      downloads: downloads,
      platform_options: platform_options,
      token: token,
      selected_download: selected_download,
      registration_url: repository_url(current_repository)
    }
  %>
<% end %>
