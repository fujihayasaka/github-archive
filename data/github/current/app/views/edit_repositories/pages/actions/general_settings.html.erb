<% page_info \
  container_xl: true,
  title: "Actions settings · #{current_repository.name_with_display_owner}",
  selected_link: :repository_actions_settings_general
%>

<%= render layout: "edit_repositories/edit" do %>
  <%if current_repository.owner.organization? && current_repository.owner.eligible_for_legacy_upsell? %>
    <%= render_actions_billing_warning_if_required(owner: current_repository.owner, current_user: current_user) %>
  <% end %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>Actions permissions<% end %>
  <% end %>
  <% if current_repository.actions_disabled_by_owner? %>
    <% owner = current_repository.owner.user? ? "enterprise" : "organization" %>
    <div class="color-fg-muted note pt-2 pb-2">
      <%= primer_octicon(:"shield-lock") %>
      This setting has been disabled by <%= owner %> administrators.
    </div>
  <% end %>

  <actions-policy-form>
    <%= primer_form_with(url: repository_actions_settings_update_allowed_actions_path, method: :put) do |f| %>
      <%= render(Actions::Policy::AllowedActionsForm.new(f, owner: current_repository, current_user: current_user)) %>
    <% end %>
  </actions-policy-form>

  <% if Actions::DebuggerPolicyConfig.new(current_repository).feature_flag_enabled? %>
    <div class="tmp-my-6">
      <% config = Actions::DebuggerPolicyConfig.new(current_repository) %>
      <%= render Primer::Beta::Subhead.new do |component| %>
        <% component.with_heading(tag: :h2) do %>Job debugger<% end %>
      <% end %>
      <% if config.disabled_by_owner? %>
        <% owner_type = current_repository.owner.user? ? "enterprise" : "organization" %>
        <div class="color-fg-muted note pt-2 pb-2">
          <%= primer_octicon(:"shield-lock") %>
          This setting has been disabled by <%= owner_type %> administrators.
        </div>
      <% else %>
        <%= primer_form_with(url: update_repository_actions_debugger_path, method: :put, data: { test_selector: "debugger_policy_form" }) do |f| %>
          <p class="mb-2">Choose whether the job debugger is enabled for this repository.</p>
          <%= render GitHub::MenuComponent.new(items: [
            GitHub::Menu::ButtonComponent.new(
              text: "Enabled",
              description: "The job debugger can be used in this repository",
              replace_text: "Enabled",
              checked: !config.disabled?,
              name: "policy",
              value: Actions::DebuggerPolicyConfig::ALL_ENTITIES,
              type: "submit",
            ),
            GitHub::Menu::ButtonComponent.new(
              text: "Disabled",
              description: "The job debugger is disabled for this repository",
              replace_text: "Disabled",
              checked: config.disabled?,
              name: "policy",
              value: Actions::DebuggerPolicyConfig::NO_ENTITIES,
              type: "submit",
            ),
          ]) do |menu| %><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
            <% menu.with_summary do %>
              <%= render Primer::Beta::Button.new(tag: :summary, test_selector: "policy-selection") do |c| %>
                <% c.with_trailing_action_icon(icon: "triangle-down") %>
                <span data-menu-button><%= menu.default_selection_text %></span>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if Actions::DebuggerSelfHostedRunnersPolicyConfig.new(current_repository).feature_flag_enabled? %>
        <% self_hosted_config = Actions::DebuggerSelfHostedRunnersPolicyConfig.new(current_repository) %>
        <% if self_hosted_config.disallowed_by_owner? %>
          <% owner_type = current_repository.owner.user? ? "enterprise" : "organization" %>
          <div class="color-fg-muted note tmp-mt-3 pt-2 pb-2">
            <%= primer_octicon(:"shield-lock") %>
            Live debugging on self-hosted runners is not allowed by your <%= owner_type %> administrators.
          </div>
        <% else %>
          <%= primer_form_with(url: update_repository_actions_debugger_self_hosted_runners_path, method: :put, class: "tmp-mt-3", data: { test_selector: "debugger_self_hosted_runners_policy_form" }) do |f| %>
            <p class="mb-2">Allow live debugging on self-hosted runners.</p>
            <%= render GitHub::MenuComponent.new(items: [
              GitHub::Menu::ButtonComponent.new(
                text: "Allowed",
                description: "Allow live debugging on self-hosted runners",
                replace_text: "Allowed",
                checked: self_hosted_config.local_allowed?,
                name: "enabled",
                value: "true",
                type: "submit",
              ),
              GitHub::Menu::ButtonComponent.new(
                text: "Not allowed",
                description: "Do not allow live debugging on self-hosted runners",
                replace_text: "Not allowed",
                checked: !self_hosted_config.local_allowed?,
                name: "enabled",
                value: "false",
                type: "submit",
              ),
            ]) do |menu| %><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
              <% menu.with_summary do %>
                <%= render Primer::Beta::Button.new(tag: :summary, test_selector: "self-hosted-policy-selection") do |c| %>
                  <% c.with_trailing_action_icon(icon: "triangle-down") %>
                  <span data-menu-button><%= menu.default_selection_text %></span>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= render Actions::Settings::RetentionComponent.new(
      entity: current_repository,
      update_retention_limit_path: repo_actions_update_retention_path,
    ) %>

    <%= render Actions::Settings::CachePoliciesComponent.new(
        entity: current_repository
      ) %>

  <% if current_repository.public? %>
    <%= render Actions::Policy::ForkPrApprovalsComponent.new(entity: current_repository, action: update_repository_fork_pr_approvals_policy_path) %>
    <% if FeatureFlag.vexi.enabled?(:dotcom_public_fork_pr_workflows_policy, current_repository, default: false) %>
      <%= render Actions::Policy::PublicForkPullRequestComponent.new(
        action: update_repository_public_fork_pr_workflows_policy_path,
        entity: current_repository,
      ) %>
    <% end %>
  <% end %>

  <% if current_repository.private? %>
    <%= render Actions::Policy::ForkPullRequestComponent.new(
      action: update_repository_fork_pr_workflows_policy_path,
      entity: current_repository,
    ) %>
  <% end %>

  <%= render Actions::Policy::DefaultWorkflowPermissionsComponent.new(
    action: update_repository_default_workflow_permissions_path,
    entity: current_repository,
  ) %>

  <%# Enable the access policy UI for both private and internal repositories. %>
  <% if current_repository.private? %>
    <%= render Actions::Policy::RepositoryShareComponent.new(
      action: update_actions_repository_share_policy_path,
      repo: current_repository,
    ) %>
  <% end %>
<% end %>
