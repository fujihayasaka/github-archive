<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% page_info \
  container_xl: true,
  title: "Configure environment #{environment.name} · #{current_repository.name_with_display_owner}",
  selected_link: :repository_environments %>

<%= render layout: "edit_repositories/edit" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>
      <%= link_to "Environments", repository_environments_path %> / Configure
      <span class="css-truncate css-truncate-target" style="max-width:500px;"><%= environment.name %></span>
    <% end %>
  <% end %>

  <% if environment.errors.present? %>
    <% if FeatureFlag.vexi.enabled?(:banner_migration, current_user, default: false) %>
      <%= render(Primer::Alpha::Banner.new(scheme: :danger, classes: "tmp-mb-3")) do %>
        <%= environment.errors.full_messages.to_sentence %>
      <% end %>
    <% else %>
      <%= render(Primer::Beta::Flash.new(scheme: :danger, classes: "tmp-mb-3")) do %>
        <%= environment.errors.full_messages.to_sentence %>
      <% end %>
    <% end %>
  <% end %>

  <% if current_repository.feature_flag_enabled?(:actions_simplified_secrets_vars_pages, default: false) %>
    <%= render(Primer::Alpha::TabPanels.new(label: "Environment configuration tabs")) do |component| %>
      <% component.with_tab(id: "deployment-settings-tab", selected: true) do |tab| %>
        <% tab.with_text { "Deployment protection rules" } %>
        <% tab.with_panel do %>
          <div class="tmp-pt-3 d-flex flex-column gap-4">
            <% if current_repository.can_use_deployment_branch_gates? %>
              <%= render "edit_repositories/pages/environments/protection_rules_form", environment: environment %>
            <% end %>
            <% if show_branch_policies && current_repository.can_use_deployment_protected_branch? %>
              <%= render "edit_repositories/pages/environments/branch_policies", repository: current_repository, environment: environment, params: params %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% component.with_tab(id: "secrets-tab", test_selector: "env-secrets-tab") do |tab| %>
        <% tab.with_text { "Secrets" } %>
        <% tab.with_panel do %>
          <div class="tmp-pt-3">
            <%= render "edit_repositories/pages/environments/secrets",
              environment: environment,
              secrets: secrets,
              edit_secret_urls: edit_secret_urls,
              delete_secret_urls: delete_secret_urls,
              public_key: public_key
            %>
          </div>
        <% end %>
      <% end %>

      <% component.with_tab(id: "variables-tab", test_selector: "env-variables-tab") do |tab| %>
        <% tab.with_text { "Variables" } %>
        <% tab.with_panel do %>
          <div class="tmp-pt-3">
            <%= render "edit_repositories/pages/environments/variables",
              environment: environment,
              variables: variables,
              edit_variable_urls: edit_variable_urls,
              delete_variable_urls: delete_variable_urls
            %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="d-flex flex-column gap-4">
      <% if current_repository.can_use_deployment_branch_gates? %>
        <%= render "edit_repositories/pages/environments/protection_rules_form", environment: environment %>
      <% end %>
      <% if show_branch_policies && current_repository.can_use_deployment_protected_branch? %>
        <%= render "edit_repositories/pages/environments/branch_policies", repository: current_repository, environment: environment, params: params %>
      <% end %>

      <%= render "edit_repositories/pages/environments/secrets",
        environment: environment,
        secrets: secrets,
        edit_secret_urls: edit_secret_urls,
        delete_secret_urls: delete_secret_urls,
        public_key: public_key
      %>

      <%= render "edit_repositories/pages/environments/variables",
        environment: environment,
        variables: variables,
        edit_variable_urls: edit_variable_urls,
        delete_variable_urls: delete_variable_urls
      %>
    </div>
  <% end %>
<% end %>
