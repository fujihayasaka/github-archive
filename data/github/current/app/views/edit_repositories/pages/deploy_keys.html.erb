<%# rubocop:disable Lint/InstanceVariable %>
<% page_info \
  title: "Deploy keys",
  container_xl: true,
  selected_link: :repo_keys_settings %>
<% view = EditRepositories::AdminScreen::DeployKeysView.new(@public_key) %>

<%= render layout: "edit_repositories/edit" do %>
  <% if deploy_keys_disabled %>
    <%= render(Primer::Alpha::Banner.new(icon: "shield-lock", mb: 3, test_selector: "deploy-keys-policy-disabled-banner")) do |component| %>
      Some settings on this page can't be changed because of a <b><%= deploy_keys_disabled_by %></b> policy.
      We recommend using
      <%= link_to "GitHub Apps", docs_url("apps/about-creating-github-apps"), class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %>
      instead for fine grained control over repositories and
      <%= link_to "enhanced security", docs_url("apps/about-github-apps-enhanced-security"), class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %>.
    <% end %>
  <% else %>
    <%= render(Primer::Alpha::Banner.new(icon: :hubot, mb: 3, classes: "hx-rails-banner-upsell", test_selector: "gh-apps-upsell-banner")) do |component| %>
      We recommend using
      <%= link_to "GitHub Apps", docs_url("apps/about-creating-github-apps"), class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %>
      instead for fine grained control over repositories and
      <%= link_to "enhanced security", docs_url("apps/about-github-apps-enhanced-security"), class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %>.
    <% end %>
  <% end %>

  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>Deploy keys<% end %>
    <% component.with_actions do %>
      <% if deploy_keys_disabled %>
        <div class="d-flex flex-items-center color-fg-muted" <%= test_selector("deploy-keys-policy-disabled-by") %>>
          <%= render Primer::Beta::Octicon.new("shield-lock", mr: 1) %>
          Disabled by <%= deploy_keys_disabled_by %>
        </div>
      <% else %>
        <%= render Primer::Beta::Button.new(tag: :a, href: repository_new_key_path, scheme: :primary, size: :small, "data-pjax": "true", test_selector: "add-deploy-key-button") do %>
          Add deploy key
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <p class="Subhead-description mb-4">
    <%= link_to "Deploy keys", docs_url("authentication/managing-deploy-keys-deploy-keys"), class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %>
    use an SSH key to grant readonly or write access to a single repository.
    They are not protected by a passphrase and can be a security risk if your server is compromised.
    If you have a complex project or want more fine-grain control over permissions, consider using
    <%= link_to "GitHub Apps", docs_url("apps/overview"), class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %>
    instead.
  </p>

  <% if keys.any? %>
    <div class="Box">
      <div class="Box border-left-0 border-top-0 border-right-0 rounded-bottom-0 color-bg-subtle px-3 py-2 text-bold text-small" <%= test_selector("total-deploy-keys-count") %>>
        <%= pluralize(total_keys, 'deploy key') %>
      </div>
      <ul>
        <% keys.each do |deploy_key| %>
          <%= render :partial => "edit_repositories/deploy_key", :object => deploy_key, :locals => { :view => view, deploy_key: deploy_key, :selected => deploy_key == view.selected_key, disabled: deploy_keys_disabled } %>
        <% end %>
      </ul>
    </div>

    <%= render Primer::Box.new(classes: "paginate-container") do %>
      <%= will_paginate keys %>
    <% end %>
  <% else %>
    <%= render Primer::Beta::Blankslate.new(border: true) do |c| %>
      <% c.with_heading(tag: :h2) do %>
        There are no deploy keys for this repository
      <% end %>

      <% c.with_description do %>
        Check out our <%= link_to "guide on deploy keys", docs_url("authentication/managing-deploy-keys-deploy-keys"), class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %> to learn more.
      <% end %>
    <% end %>
  <% end %>
<% end %>
