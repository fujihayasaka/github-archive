<% page_info \
  container_xl: true,
  title: "#{page_info[:page_title]} · #{current_repository.name_with_display_owner}",
  selected_link: page_info[:selected_link] %>

<%= render layout: "edit_repositories/edit" do %>
  <%= render partial: "edit_repositories/pages/secrets_and_variables_tabs",
    locals: {
      selected_tab: :variables,
      app_name: app_name,
      can_write_repo_secrets:,
      can_write_repo_variables:,
    } %>

  <h3 class="sr-only">Variables</h3>

  <% if app %>
    <% if current_repository.feature_flag_enabled?(:actions_simplified_secrets_vars_pages, default: false) %>
      <p>
        Environment<% if usage_metadata[:show_org_variables] %> and organization<% end %> variables are managed from their respective pages.
      </p>
      <%= render(Primer::Beta::Button.new(tag: :a, mr: 2, href: repository_environments_path, classes: "tmp-mb-4")) do |button|
        "Manage environments"
      end %>
      <% if usage_metadata[:show_org_variables] %>
        <%= render(Primer::Beta::Button.new(tag: :a, href: organization_variables_path(current_repository.owner, app_name: app_name), classes: "tmp-mb-4")) do |button|
          "Manage organization variables"
        end %>
      <% end %>
    <% end %>

    <%# Environment variables section %>
    <% if usage_metadata[:show_environment_variables] && !current_repository.feature_flag_enabled?(:actions_simplified_secrets_vars_pages, default: false) %>
      <%= render_react_partial name: "actions-secrets-variables-list", props: {
        items: environment_variables[:environment_variables],
        scope: Secrets::Helper::ENV_SCOPE,
        environmentUrls: environment_urls,
        tableActionProps: {
          url: repository_environments_path,
          message: "Manage environment variables"
        },
        mode: Secrets::Helper::VARIABLE_MODE
      } %>
    <% end %>

    <%# Repository variables section %>
    <%= render_react_partial name: "actions-secrets-variables-list", props: {
      items: repository_variables[:repository_variables],
      overrides: organization_variables[:organization_variables],
      scope: Secrets::Helper::REPO_SCOPE,
      crudUrls: {
        editUrls: edit_repo_variables_urls,
        deleteUrls: delete_repo_variables_urls,
      },
      tableActionProps: {
        url: repository_new_variable_path(app_name: app_name),
        message: "New repository variable"
      },
      mode: Secrets::Helper::VARIABLE_MODE
    } %>

    <%# Organization variables section %>
    <% if usage_metadata[:show_org_variables] && !current_repository.feature_flag_enabled?(:actions_simplified_secrets_vars_pages, default: false) %>
      <%= render_react_partial name: "actions-secrets-variables-list", props: {
        items: organization_variables[:organization_variables],
        overrides: repository_variables[:repository_variables],
        scope: Secrets::Helper::ORG_SCOPE,
        tableActionProps: {
          url: usage_metadata[:can_manage_org_variables] ? organization_variables_path(current_repository.owner, app_name: app_name) : nil,
          message: "Manage organization variables"
        },
        mode: Secrets::Helper::VARIABLE_MODE,
        isPrivateRepoInFreeOrg: !usage_metadata[:repo_can_use_org_variables]
      } %>
    <% end %>
  <% else %>
    <%= render Primer::Beta::Blankslate.new(border: true) do |c| %>
      <% c.with_heading(tag: :h2).with_content(page_info[:blank_slate_title]) %>
    <% end %>
  <% end %>
<% end %>
