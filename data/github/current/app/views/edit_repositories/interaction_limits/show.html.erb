<%
  page_info \
    title: "Interaction limits",
    container_xl: true,
    selected_link: :interaction_limits
%>

<%= render layout: "edit_repositories/edit" do %>
  <%= render Primer::Beta::Subhead.new(mb: 2) do |c| %>
    <% c.with_heading(tag: :h1, size: :large) do %>
      Interaction limits
    <% end %>
  <% end %>

  <%= render Primer::Beta::Subhead.new(mb: 2) do |c| %>
    <% c.with_heading(tag: :h2, size: :medium) do %>
      Temporary interaction restrictions
    <% end %>
  <% end %>

  <%= render InteractionLimits::ShowComponent.new(object: current_repository) %>

  <% if FeatureFlag.vexi.enabled?(:pull_request_creation_cap, current_repository, default: false) %>
    <%= render Primer::Beta::Subhead.new(mb: 2, spacious: true) do |c| %>
      <% c.with_heading(tag: :h2, size: :medium) do %>
        Pull request limits
      <% end %>
    <% end %>

    <%= render InteractionLimits::PullRequestCreationCapComponent.new(current_repository) %>
  <% end %>
<% end %>
