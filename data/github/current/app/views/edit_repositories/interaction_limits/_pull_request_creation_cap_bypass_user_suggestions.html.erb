<%= render(Primer::Alpha::SelectPanel::ItemList.new(
  aria: { label: "User suggestions" },
)) do |list| %>
  <% if users.any? %>
    <% users.each do |user| %>
      <% list.with_avatar_item(
        src: avatar_url_for(user),
        username: user.display_login,
        href: repository_pull_request_creation_cap_bypass_add_users_url(repo.owner, repo),
        form_arguments: {
          method: :post,
          inputs: [{ name: "logins[]", value: user.display_login }],
        },
      ) do |item| %>
        <% item.with_description(user.safe_profile_name) if user.display_name.present? %>
      <% end %>
    <% end %>
  <% else %>
    <% list.with_item(disabled: true) do |item| %>
      No users found
    <% end %>
  <% end %>
<% end %>

