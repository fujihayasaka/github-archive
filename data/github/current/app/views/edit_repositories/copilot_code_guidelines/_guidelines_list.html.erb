<% limit_reached = enabled_count >= Copilot::CodingGuideline::MAX_ENABLED_PER_REPO %>

<%= render Primer::Box.new(id: "copilot-coding-guidelines-list") do %>
  <% if limit_reached %>
    <%= render Primer::Alpha::Banner.new(
      scheme: :warning,
      description: "You've reached the enabled guidelines limit on this repo.",
      mb: 3) %>
  <% end %>

  <%= render Primer::Beta::BorderBox.new do |component| %>
    <% guidelines.each do |guideline| %>
      <%= render partial: 'edit_repositories/copilot_code_guidelines/coding_guideline', locals: { guideline:, limit_reached:, border_box: component } %>
    <% end %>
  <% end %>

  <%= render(Primer::Box.new(font_size: :small, color: :muted, mt: 2)) do %>
    <%= enabled_count %> out of <%= Copilot::CodingGuideline::MAX_ENABLED_PER_REPO %> allowed in this repository.
  <% end %>
<% end %>
