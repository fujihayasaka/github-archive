<% limit_reached = enabled_count >= Copilot::CodingGuideline::MAX_ENABLED_PER_REPO %>
<% autofocus_guideline_id = local_assigns.fetch(:autofocus_guideline_id, nil) %>

<%= render Primer::Box.new(id: "copilot-coding-guidelines-list") do %>
  <% if limit_reached %>
    <%= render Primer::Alpha::Banner.new(
      scheme: :warning,
      description: "You've reached the enabled guidelines limit on this repo.",
      mb: 3) %>
  <% end %>

  <%= render Primer::Beta::Subhead.new(hide_border: true, mb: 2, mt: 3) do |component| %>
    <% component.with_heading(tag: :h3, font_size: 4, classes: "mb-n2") do %>
      <%= pluralize(enabled_count, "guideline") %> enabled.
    <% end %>

    <% component.with_description do %>
      <div class="d-flex flex-justify-between flex-items-end">
        <%= render(Primer::Beta::Text.new(tag: :p, classes: "mb-0")) do %>
          Maximum <%= Copilot::CodingGuideline::MAX_ENABLED_PER_REPO %> enabled guidelines allowed in this repository.
        <% end %>
        <%= render Primer::Beta::Button.new(
          id: "create-coding-guideline-button",
          scheme: feature_is_disabled ? :default : :primary,
          tag: :a,
          disabled: limit_reached || feature_is_disabled,
          href: new_copilot_code_guideline_path
        ) do |component| %>
          <% if feature_is_disabled %>
            <%= component.with_tooltip(text: "Creating new coding guidelines has been disabled.", direction: :s) %>
          <% elsif limit_reached %>
            <%= component.with_tooltip(text: "Cannot create more guidelines", direction: :s) %>
          <% end %>
          Create guideline
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if feature_is_disabled %>
    <%= render Primer::Alpha::Banner.new(
      scheme: :default,
      icon: :info,
      mb: 3,
      ) do %>
        Coding guidelines will be disabled on September 1, 2025. <%= render(Primer::Beta::Link.new(href: "https://github.blog/changelog/2025-07-18-upcoming-deprecations-and-changes-to-copilot-code-review", inline: true, classes: 'Link--inTextBlock' )) { "Read our announcement" } %>.
    <% end %>
  <% end %>

  <%= render Primer::Beta::BorderBox.new do |component| %>
    <% guidelines.each do |guideline| %>
      <%= render(
        "edit_repositories/copilot_code_guidelines/coding_guideline",
        autofocus_guideline_id:,
        guideline:,
        limit_reached:,
        border_box: component,
        feature_is_disabled:,
      ) %>
    <% end %>
  <% end %>
<% end %>
