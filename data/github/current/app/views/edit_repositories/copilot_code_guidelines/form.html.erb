<% save_code_guideline_path = if guideline.persisted?
    # Update
    copilot_code_guideline_path(user_id: current_repository.owner, id: guideline.id)
  else
    # Create
    copilot_code_guidelines_path(user_id: current_repository.owner)
  end
%>
<% page_info \
  container_xl: true,
  title: "Coding guidelines · #{current_repository.name_with_display_owner}",
  selected_link: :repo_settings_copilot_coding_guidelines,
  hide_footer: true
%>

<div class="p-3">
  <%= render_react_partial(
    name: "copilot-code-guidelines-playground",
    props: {
      indexPath: repo_repo_settings_copilot_code_review_path(user_id: current_repository.owner),
      playgroundRunsPath: copilot_code_guidelines_playground_runs_path(user_id: current_repository.owner),
      saveCodeGuidelinePath: save_code_guideline_path,
      codingGuideline: {
        id: guideline.id,
        name: guideline.name,
        description: guideline.description,
        exampleCodeViolations: guideline.example_code_violations,
      },
      sampleCodeGenerationsPath: copilot_code_guidelines_sample_code_generation_path(user_id: current_repository.owner),
      promptCharLimit: Copilot::CodingGuideline::PROMPT_CHAR_LIMIT,
      codingGuidelinePaths: paths_attributes,
      showTabBar: (guideline.persisted? && show_tab_bar),
      occurrencesPath: guideline.persisted? ? occurrences_path(user_id: current_repository.owner_display_login, repository: current_repository.name, id: guideline) : "",
      featureIsDisabled: feature_is_disabled,
    },
    disable_ssr: true,
  ) %>
</div>
