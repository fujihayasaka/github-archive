<% page_info \
  container_xl: true,
  title: "Settings · Copilot Code review · #{current_repository.name_with_display_owner}",
  selected_link: :repo_settings_copilot_coding_guidelines %>

<% total_limit_reached = total_count >= Copilot::CodingGuideline::MAX_PER_REPO %>

<%= render layout: "edit_repositories/edit" do %>
  <%= render Primer::Beta::Subhead.new(mb: 2) do |c| %>
    <% c.with_heading(tag: :h1, font_size: 3) do %>
      Copilot Code review
    <% end %>
  <% end %>

  <%= render Primer::Beta::Text.new(tag: :p, classes: "tmp-mb-3") do %>
    With Copilot code review, you can add Copilot as a reviewer to your pull requests, including drafts. You can also select lines in Visual Studio Code and ask Copilot to review and comment on specific sections. <%= render Primer::Beta::Link.new(
      href: "https://docs.github.com/en/copilot/how-tos/use-copilot-agents/request-a-code-review/use-code-review",
      classes: "Link--inTextBlock",
      ).with_content("Learn more about Copilot code reviews.")
    %>
  <% end %>

  <%# Code review repository general settings %>
  <%= render PullRequests::Copilot::RepoGeneralSettingsComponent.new(
    repo: current_repository,
  ) %>

  <%= render "edit_repositories/copilot_code_guidelines/automated_code_reviews_rulesets" %>

  <% if coding_guideline_feature_enabled %>
    <%= render Primer::Box.new(classes: "tmp-mt-4") do %>
      <%= render Primer::Beta::Subhead.new(hide_border: true) do |component| %>
        <% component.with_heading(tag: :h2, font_size: 4, font_weight: :semibold).with_content("Coding guidelines") %>
        <% component.with_description(classes: "d-flex flex-items-end flex-justify-between", style: guidelines.blank? ? "margin-top: -11px;" : nil) do %>
        Describe what patterns you&#39;d like Copilot to find and point out during code review.
          <% if guidelines.blank? %>
            <%= render Primer::Beta::Button.new(
              id: "create-coding-guideline-button",
              scheme: :primary,
              tag: :a,
              href: new_copilot_code_guideline_path
            ) do %>
              Create guideline
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if guidelines.blank? %>
        <%= render Primer::Beta::Blankslate.new(border: true) do |component| %>
          <% component.with_heading(tag: :h2).with_content("No coding guidelines have been added") %>
          <% component.with_description { "Copilot will review pull requests in this repository without custom instructions." } %>
        <% end %>
      <% else %>
        <%= render(
          "edit_repositories/copilot_code_guidelines/guidelines_list",
          guidelines:,
          enabled_count:,
          feature_is_disabled:,
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
