<% page_info \
  container_xl: true,
  title: "Settings · Coding guidelines · #{current_repository.name_with_display_owner}",
  selected_link: :repo_settings_copilot_coding_guidelines %>

<% total_limit_reached = total_count >= Copilot::CodingGuideline::MAX_PER_REPO %>

<%= render layout: "edit_repositories/edit" do %>
  <%= render Primer::Beta::Subhead.new do |c| %>
    <% c.with_heading(tag: :h1, font_size: 3) do %>
      Copilot code review
      <%= render Primer::Beta::Label.new(scheme: :success, flex: 1).with_content("Preview") %>
    <% end %>
  <% end %>

  <% if show_auto_review_hint %>
    <div class="Box rounded border p-3 js-notice d-flex flex-column flex-md-row gap-3" <%= test_selector("automatic-code-review-hint") %>>
      <div class="d-flex flex-row flex-1">
        <div class="circle p-2 fgColor-attention bgColor-attention-muted d-flex flex-items-center" style="height: 32px; width: 32px;">
          <%= render Primer::Beta::Octicon.new(icon: "light-bulb") %>
        </div>
      </div>
      <div class="d-flex gap-3 flex-column flex-md-row">
        <div>
          <h2 class="f5 mb-1">Enable automatic code review</h2>
          <p class="fgColor-muted f6 m-0">
            You can enable Copilot to automatically review pull requests by enabling it inside Repository rules.
            <a href="https://docs.github.com/early-access/copilot/code-review/configuring-coding-guidelines"
              target="_blank"
              class="Link--inTextBlock">
              Learn more about automatic code reviews.
            </a>
          </p>
        </div>
        <div class="d-flex flex-row gap-2 flex-items-center flex-shrink-0">
          <%= render Primer::Beta::Button.new(tag: :a, href: repository_rulesets_path).with_content("Go to repository rules") %>
          <%= form_tag dismiss_notice_path("copilot_coding_guidelines_auto_review_disabled"), data: { remote: true }, class: "js-notice-dismiss" do %>
            <%= render Primer::Beta::IconButton.new(icon: "x", type: :submit, scheme: :invisible, "aria-label": "Dismiss tip", show_tooltip: true) %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render Primer::Beta::Subhead.new(hide_border: true, mb: 2, mt: 3) do |component| %>
    <% component.with_heading(tag: :h2, font_size: 3) do %>
      Coding guidelines
    <% end %>

    <% component.with_description do %>
      Describe what patterns you&#39;d like Copilot to find and point out during code review.
    <% end %>

    <% component.with_actions(pb: 2) do %>
      <%= render Primer::Beta::Button.new(id: "create-coding-guideline-button", scheme: :primary, tag: :a, disabled: total_limit_reached, href: new_copilot_code_guideline_path) do |component| %>
        <% if total_limit_reached %>
          <%= component.with_tooltip(text: "Cannot create more guidelines", direction: :s) %>
        <% end %>
        Create guideline
      <% end %>
    <% end %>
  <% end %>

  <% if guidelines.blank? %>
    <%= render Primer::Beta::Blankslate.new(border: true) do |component| %>
      <% component.with_heading(tag: :h2).with_content("No coding guidelines have been added") %>
      <% component.with_description { "Copilot will review pull requests in this repository without custom instructions." } %>
    <% end %>
  <% else %>
    <%= render partial: 'edit_repositories/copilot_code_guidelines/guidelines_list', locals: { guidelines:, enabled_count: } %>
  <% end %>
<% end %>
