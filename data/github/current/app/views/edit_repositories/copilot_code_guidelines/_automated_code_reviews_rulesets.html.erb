<%# Automated code reviews using rulesets section %>
<%= render Primer::Box.new(test_selector: "automated-code-reviews-rulesets", id: "automated-code-reviews-rulesets", classes: "tmp-mt-4") do %>
  <%= render Primer::Beta::Subhead.new(hide_border: true, mb: 2) do |component| %>
    <% component.with_heading(tag: :h2, font_size: 4, font_weight: :semibold) do %>
      Manage Copilot code review automations
    <% end %>
    <% component.with_description(classes: "d-flex flex-items-start flex-justify-between") do %>
      <div>
        Use rulesets to automatically request reviews and more.
        <%= render Primer::Beta::Link.new(
          href: Copilot::CODE_REVIEW_CONFIGURING_AUTO_DOCS_URL,
          classes: "Link--inTextBlock",
          ).with_content("Learn how to set up rulesets.")
        %>
      </div>

    <% end %>
  <% end %>

  <%
    copilot_rule_types = ["copilot_code_review"]
    all_rule_types = copilot_rule_types + ["pull_request"]

    # Get organization rulesets only if the owner is an organization
    org_rulesets = if current_repository.owner.is_a?(Organization)
      # First get all potential organization rulesets
      potential_org_rulesets = current_repository.owner.rulesets
        .joins(:rule_configurations)
        .where(target: "branch")
        .where(
          repository_rule_configurations: {
            rule_type: all_rule_types
          }
        )
        .where(
          "repository_rule_configurations.rule_type IN (?)",
          copilot_rule_types
        )
        .includes(:rule_configurations, :conditions)

      # Filter to only include rulesets that apply to this repository
      potential_org_rulesets.select do |ruleset|
        ruleset.definition.applies_to_source?(ruleset, current_repository)
      end
    else
      []
    end

    # Get repository rulesets directly from the repository and filter for Copilot code review rules
    repo_rulesets = current_repository.rulesets
      .joins(:rule_configurations)
      .where(target: "branch")
      .where(
        repository_rule_configurations: {
          rule_type: all_rule_types
        }
      )
      .where(
        "repository_rule_configurations.rule_type IN (?)",
        copilot_rule_types
      )
      .includes(:rule_configurations, :conditions)

    total_rulesets = org_rulesets.count + repo_rulesets.count

    # Get target counts for all rulesets (both org and repo) against this specific repository
    # This will tell us how many branches in this repository are targeted by each ruleset
    all_rulesets = org_rulesets + repo_rulesets
    target_counts_by_ruleset = if all_rulesets.any?
      all_ruleset_ids = all_rulesets.map(&:id)
      RulesEngine::RulesetMatcher.rulesets_target_count(current_repository, all_ruleset_ids).index_by { |result| result[:rulesetId] }
    else
      {}
    end
  %>

  <% if total_rulesets > 0 %>
    <% contains_org_managed_rules = current_repository.owner.is_a?(Organization) && org_rulesets.any? %>

    <% if contains_org_managed_rules %>
      <%= render "edit_repositories/copilot_code_guidelines/automated_code_reviews_rulesets_panel", ruleset_type: :organization, rulesets: org_rulesets, target_counts_by_ruleset:, current_repository: %>
    <% end %>

    <% if repo_rulesets.any? %>
      <div class="<%= contains_org_managed_rules ? "tmp-mt-5" : "" %>">
        <%= render "edit_repositories/copilot_code_guidelines/automated_code_reviews_rulesets_panel", ruleset_type: :repository, rulesets: repo_rulesets, target_counts_by_ruleset:, current_repository: %>
      </div>
    <% end %>
  <% else %>
    <%= render Primer::Beta::BorderBox.new do |component| %>
      <% component.with_header(display: :flex) do |h| %>
        <% h.with_title(tag: :h2, flex: 1) do %>
          No rulesets
        <% end %>

        <%= render Primer::Beta::Button.new(
            scheme: :link,
            tag: :a,
            float: :right,
            type: :button,
            id: "view-all-rulesets-button",
            href: repository_rulesets_path(current_repository.owner, current_repository),
        ) do |b| %>
          View all rulesets
          <% b.with_trailing_visual_icon(icon: :'link-external') %>
        <% end %>
      <% end %>
      <% component.with_row(classes: "d-flex flex-column flex-items-center tmp-p-4") do %>
        <%= render Primer::Beta::Heading.new(tag: :h4, test_selector: "empty-rulesets-title", classes: "tmp-mb-3").with_content("Automate Copilot code reviews") %>

        <%= form_with url: repo_create_copilot_ruleset_repo_repo_settings_copilot_code_review_path(current_repository.owner, current_repository), method: :post, local: true do |form| %>
          <%= render Primer::Beta::Button.new(
            scheme: :primary,
            type: :submit,
            data: {
              disable_with: "Creating ruleset for default branch..."
            },
            id: "create-ruleset-button"
          ).with_content("Create ruleset for default branch") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
