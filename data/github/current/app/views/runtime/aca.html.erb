<%
  SecureHeaders::append_content_security_policy_directives(
    request,
    form_action: [URI.parse(postback_uri).host]
  )
 %>

<% page_info title: "GitHub Runtime · Authenticating", footer: false %>

<%= form_tag postback_uri, method: :post, id: "aca-auth-form", class: "js-auto-submit-form", authenticity_token: false do %>
<%# Use the partial 'runtime/hidden_fields' after validated in production %>
  <%= hidden_field_tag "app", app %>
  <%= hidden_field_tag "user", user %>
  <%= hidden_field_tag "payload", payload %>
  <%= hidden_field_tag "proxyPayload", proxyPayload %>
  <%# Delete this conditional with the removal of the flag spark_aca_regions %>
  <% if defined?(region) && region %>
    <%= hidden_field_tag "region", region %>
  <% end %>
<% end %>

<div class="p-4 d-flex flex-column flex-items-center gap-2 text-center">
  <%= render(Primer::Beta::Spinner.new(size: :medium)) %>
  <%= render(Primer::Beta::Heading.new(tag: :h1, font_size: 4)) { "Authenticating…" } %>
  <p class="fgColor-muted f5">Checking to make sure you have access to this spark.</p>
</div>
