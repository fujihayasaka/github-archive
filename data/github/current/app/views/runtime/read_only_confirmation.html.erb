<%
  SecureHeaders::append_content_security_policy_directives(
    request,
    form_action: [URI.parse(postback_uri).host]
  )
 %>

<% page_info title: "GitHub Runtime · Read-Only Confirmation", footer: false %>

<div class="d-flex flex-column flex-items-center justify-content-center min-vh-100">
  <div class="p-6 d-flex flex-column flex-items-center gap-4 text-center rounded-3 shadow-lg border color-border-default mt-4 mb-4" style="max-width: 500px;">
  <%= render Primer::Beta::Octicon.new(icon: :eye, size: :medium, classes: "color-fg-default mb-3") %>
      <%= render Primer::Beta::Heading.new(tag: :h1, size: :large, mb: 3) do %>
        This Spark is in Read-Only Mode
      <% end %>
      <p class="f4 color-fg-muted mb-4">
        The creator of this Spark has made it <strong>read-only</strong>.
      </p>
      <div class="d-flex flex-column gap-4 text-left" style="width: 100%;">
        <div class="w-100" style="max-width: 400px;">
          <%= render Primer::Beta::Octicon.new(icon: :check, size: :small, classes: "color-fg-success mr-2") %>
          <strong>What you can do:</strong>
          <ul class="mt-2" style="list-style: disc; padding-left: 20px;">
            <li>View app content</li>
            <li>Browse all pages and sections</li>
          </ul>
        </div>
        <div class="w-100" style="max-width: 400px;">
          <%= render Primer::Beta::Octicon.new(icon: :info, size: :small, classes: "color-fg-accent mr-2") %>
          <strong>What you can't do:</strong>
          <ul class="mt-2" style="list-style: disc; padding-left: 20px;">
            <li>Edit or modify content</li>
            <li>Delete files or records</li>
            <li>Create new items</li>
          </ul>
        </div>
      </div>
        <%= form_with url: postback_uri, method: :post, html: { class: "d-inline mt-4", style: "width: 100%; max-width: 400px;" } do %>
          <%= render partial: "runtime/hidden_fields", locals: { app: app, user: user, payload: payload, proxyPayload: proxyPayload, region: defined?(region) ? region : nil } %>
          <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary, size: :large) do %>
            Got it! Proceed to view Spark
          <% end %>
        <% end %>
   </div>
</div>
