<% page_info title: "Create coupon", selected_link: :admin_coupons %>

<%= render layout: "biztools/biztools" do %>
  <%= render(Primer::Beta::BorderBox.new) do |box| %>
    <% box.with_header do %>
      <span class="text-bold">Create coupon</span>
    <% end %>

    <% box.with_row do %>
      <%= render(Primer::Alpha::Banner.new(scheme: :default, icon: :info)) do %>
        <strong>Need a coupon for students, education, non-profits, hackathons or conferences?</strong>
        <br>
        Check out the
        <%= render(Primer::Beta::Link.new(href: "https://thehub.github.com/support/billing/coupons/coupons-and-gift-accounts/#applying-a-coupon-to-an-account", classes: "Link--inTextBlock")) { "GitHubber guide" } %>
        or contact the education or community teams.
      <% end %>
    <% end %>

    <% box.with_row do %>
      <%= form_for([:biztools, coupon]) do |f| %>
        <%# Code and Discount - coupon identity %>
        <div class="d-flex flex-column flex-md-row gap-3 tmp-mb-3">
          <div class="col-12 col-md-4 js-coupon-code">
            <%= render(Primer::Alpha::TextField.new(
              name: "coupon[code]",
              label: "Code",
              value: coupon.code,
              caption: "Unique identifier users enter to redeem.",
              validation_message: error_for(coupon, :code),
              invalid: error_for(coupon, :code).present?,
              full_width: true,
              classes: "js-coupon-code"
            )) %>
          </div>

          <div class="col-12 col-md-4">
            <%= render(Primer::Alpha::TextField.new(
              name: "coupon[discount]",
              label: "Discount amount",
              placeholder: "$7 or 25%",
              caption: "Amount to discount each month.",
              value: coupon.try(:human_discount),
              validation_message: error_for(coupon, :discount),
              invalid: error_for(coupon, :discount).present?,
              full_width: true,
              data: { test_selector: "coupon-discount-input" }
            )) %>
          </div>
        </div>

        <%# Duration and Expiration %>
        <div class="d-flex flex-column flex-md-row gap-3 tmp-mb-3">
          <div class="col-12 col-md-4">
            <%= render(Primer::Alpha::Select.new(
              name: "coupon[duration]",
              label: "Duration",
              caption: "How long the discount applies.",
              full_width: true
            )) do |component| %>
              <% coupon.fun_durations.each do |label, value| %>
                <% component.option(label: label, value: value, selected: coupon.duration == value) %>
              <% end %>
            <% end %>
          </div>
          <div class="col-12 col-md-4">
            <label class="FormControl-label" for="coupon_expires_at">Expiration date</label>
            <input
              type="date"
              class="form-control FormControl-input width-full"
              id="coupon_expires_at"
              name="coupon[expires_at]"
              min="<%= Date.tomorrow.to_s %>"
              value="<%= coupon.form_expires_at %>"
            >
            <p class="FormControl-caption">Coupon cannot be redeemed after this date.</p>
          </div>
        </div>

        <%# Redemption limit %>
        <div class="tmp-mb-3 col-12 col-md-4 js-coupon-limit">
          <%= render(Primer::Alpha::TextField.new(
            name: "coupon[limit]",
            label: "Redemption limit",
            value: coupon.limit,
            type: :number,
            caption: "Number of times this code can be redeemed.",
            validation_message: error_for(coupon, :limit),
            invalid: error_for(coupon, :limit).present?,
            full_width: true,
            classes: "js-coupon-limit"
          )) %>
        </div>

        <%# Product target and Group %>
        <div class="d-flex flex-column flex-md-row gap-3 tmp-mb-3">
          <% if coupon.new_record? %>
            <div class="flex-1">
              <%= render(Primer::Alpha::Select.new(
                name: "coupon_product_target",
                label: "Product target",
                caption: "Restrict to specific products.",
                full_width: true
              )) do |component| %>
                <% component.option(label: "All GitHub Plans", value: nil) %>
                <% component.option(label: "GHEC Only", value: Coupon::GHEC_PRODUCT_TARGET.values) %>
                <% couponable_product_targets.each do |product| %>
                  <% component.option(label: product.name, value: [product.product_type, product.product_key]) %>
                <% end %>
              <% end %>
            </div>
          <% end %>
          <div class="flex-1">
            <%= render(Primer::Alpha::Select.new(
              name: "coupon[group]",
              label: "Group",
              caption: "Organize coupons by category.",
              validation_message: error_for(coupon, :group),
              invalid: error_for(coupon, :group).present?,
              full_width: true,
            )) do |component| %>
              <% component.option(label: "No group", value: "") %>
              <% Coupon::GROUP_NAMES.each do |group_name| %>
                <% component.option(label: group_name.humanize, value: group_name, selected: coupon.group == group_name) %>
              <% end %>
            <% end %>
          </div>
        </div>

        <%# Staff-only application %>
        <div class="tmp-mb-3">
          <%= render(Primer::Alpha::CheckBox.new(
            name: "coupon[staff_actor_only]",
            label: "Staff-only application",
            caption: "Only staff can apply this coupon. Users cannot redeem it themselves.",
            value: "1",
            checked: coupon.staff_actor_only?
          )) %>
        </div>

        <%# Notes - required %>
        <div class="tmp-mb-3">
          <%= render(Primer::Alpha::TextArea.new(
            name: "coupon[note]",
            label: "Notes",
            value: coupon.note,
            placeholder: "Link to support ticket or billing-core issue.",
            required: true,
            validation_message: error_for(coupon, :note),
            invalid: error_for(coupon, :note).present?,
            full_width: true,
            rows: 3
          )) %>
        </div>

        <div class="tmp-pt-3 border-top">
          <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { "Create coupon" } %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
