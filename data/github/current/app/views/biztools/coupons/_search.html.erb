<div class="flex-1">
  <%= form_tag search_biztools_coupons_path, method: :post do %>
    <%= render(Primer::Alpha::TextField.new(
      name: "id",
      label: "Coupon code",
      value: params[:id],
      placeholder: "Search by coupon code",
      required: true,
      input_id: "coupon-id",
      full_width: true,
    )) %>
    <%= render(Primer::Beta::Button.new(type: :submit, mt: 2)) { "Search" } %>
  <% end %>
</div>
