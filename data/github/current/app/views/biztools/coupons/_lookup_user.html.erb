<div class="flex-1">
  <%= form_tag "", id: "account-redemption-lookup", method: :get do %>
    <%= render(Primer::Alpha::TextField.new(
      name: "user_id",
      label: "Account redemption history",
      value: params[:user_id],
      placeholder: "Search by account name",
      required: true,
      input_id: "account-search",
      full_width: true,
    )) %>
    <%= render(Primer::Beta::Button.new(type: :submit, mt: 2)) { "Search" } %>
  <% end %>
</div>
<div class="border-left tmp-mx-3"></div>
<div class="flex-1">
  <%= form_tag "", id: "account-opensource-lookup", method: :get do %>
    <%= render(Primer::Alpha::TextField.new(
      name: "user_id",
      label: "Open source eligibility",
      value: params[:user_id],
      placeholder: "Search by account name",
      required: true,
      input_id: "account-opensource-search",
      full_width: true,
    )) %>
    <%= render(Primer::Beta::Button.new(type: :submit, mt: 2)) { "Search" } %>
  <% end %>
</div>
