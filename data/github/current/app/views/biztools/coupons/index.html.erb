<% view = Biztools::Coupon::IndexView.new %>

<% page_info title: "Coupons", selected_link: :admin_coupons %>

<%= render layout: "biztools/biztools" do %>
  <div class="d-flex flex-items-center flex-justify-between tmp-mb-4">
    <div class="d-flex flex-items-center gap-2">
      <%= render(Primer::Beta::Octicon.new(icon: :tag, size: :medium)) %>
      <h2 class="h2">Coupons</h2>
    </div>
    <%= render(Primer::Beta::Button.new(tag: :a, scheme: :primary, href: new_biztools_coupon_path(group: params[:group]))) do %>
      <%= render(Primer::Beta::Octicon.new(icon: :plus, mr: 1)) %>New coupon
    <% end %>
  </div>

  <%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-4")) do |box| %>
    <% box.with_header do %>
      <div class="d-flex flex-items-center gap-2">
        <%= render(Primer::Beta::Octicon.new(icon: :search)) %>
        <span class="text-bold">Search</span>
      </div>
    <% end %>
    <% box.with_row do %>
      <div class="d-flex">
        <%= render "biztools/coupons/search" %>
        <div class="border-left tmp-mx-3"></div>
        <%= render "biztools/coupons/lookup_user" %>
      </div>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
    <% box.with_header do %>
      <span class="text-bold">Groups</span>
    <% end %>
    <% Coupon::GROUP_NAMES.each do |group| %>
      <% box.with_row do %>
        <div class="d-flex flex-items-center flex-justify-between">
          <%= render(Primer::Beta::Link.new(href: biztools_coupon_groups_path(group))) { group } %>
          <span class="color-fg-muted"><%= pluralize(view.group_count(group), "coupon") %></span>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
    <% box.with_header do %>
      <span class="text-bold"><%= GitHub::Plan.business_plus.titleized_display_name %> (only)</span>
    <% end %>
    <% Coupon::BUSINESS_PLUS_ONLY_GROUP_NAMES.each do |group| %>
      <% box.with_row do %>
        <div class="d-flex flex-items-center flex-justify-between">
          <%= render(Primer::Beta::Link.new(href: biztools_coupon_groups_path(group))) { group } %>
          <span class="color-fg-muted"><%= pluralize(view.group_count(group), "coupon") %></span>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
