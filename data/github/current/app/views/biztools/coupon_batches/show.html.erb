<% page_info title: "Coupon Generation Batch ##{batch.id}", selected_link: :admin_coupon_batches %>

<%= render layout: "biztools/biztools" do %>
  <div class="tmp-mb-3 d-flex flex-justify-between flex-items-center">
    <%= link_to '← Back to Generation Batches', biztools_coupon_batches_path, class: 'btn btn-sm' %>
    <% if batch.coupons.any? %>
      <%= link_to download_csv_biztools_coupon_batch_path(batch), class: 'btn btn-sm btn-primary' do %>
        <%= primer_octicon(:download, mr: 1) %>
        Download CSV
      <% end %>
    <% end %>
  </div>

  <%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |box| %>
    <% box.with_header do |header| %>
      <% header.with_title(tag: :h2) do %>
        Batch Details <%= batch.status %>
      <% end %>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="d-flex flex-items-center">
          <%= render(Primer::Beta::Octicon.new(:tag, mr: 2, color: :muted)) %>
          <span class="text-bold">Prefix</span>
        </div>
        <div>
          <% if batch.prefix.present? %>
            <%= batch.prefix %>
          <% else %>
            <span class="color-fg-muted">Batch #<%= batch.id %></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="d-flex flex-items-center">
          <%= render(Primer::Beta::Octicon.new(:number, mr: 2, color: :muted)) %>
          <span class="text-bold">Quantity</span>
        </div>
        <div>
          <%= batch.quantity %>
        </div>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="d-flex flex-items-center">
          <%= render(Primer::Beta::Octicon.new(:"issue-opened", mr: 2, color: :muted)) %>
          <span class="text-bold">Tracking Issue</span>
        </div>
        <div>
          <% if batch.tracking_issue.present? %>
            <% if tracking_issue_url %>
              <%= link_to batch.tracking_issue, tracking_issue_url, target: '_blank', rel: 'noopener', class: 'Link--primary' %>
            <% else %>
              <%= batch.tracking_issue %>
            <% end %>
          <% else %>
            <span class="color-fg-muted">None</span>
          <% end %>
        </div>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="d-flex flex-items-center">
          <%= render(Primer::Beta::Octicon.new(:package, mr: 2, color: :muted)) %>
          <span class="text-bold">Coupons Generated</span>
        </div>
        <div>
          <% progress_pct = (batch.quantity > 0 ? (batch.coupons.count.to_f / batch.quantity * 100).round : 0) %>
          <%= batch.coupons.count %> / <%= batch.quantity %>
          <% if progress_pct < 100 %>
            <%= render(Primer::Beta::Label.new(scheme: :attention, ml: 2)) { "#{progress_pct}%" } %>
          <% else %>
            <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2)) { "Complete" } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="d-flex flex-items-center">
          <%= render(Primer::Beta::Octicon.new(:check, mr: 2, color: :muted)) %>
          <span class="text-bold">Status</span>
        </div>
        <div>
          <%= batch.status.humanize %>
        </div>
      </div>
    <% end %>

    <% if batch.status_message.present? %>
      <% box.with_row do %>
        <div class="d-flex flex-justify-between flex-items-center">
          <div class="d-flex flex-items-center">
            <%= render(Primer::Beta::Octicon.new(:inbox, mr: 2, color: :muted)) %>
            <span class="text-bold">Status message</span>
          </div>
          <div>
            <%= batch.status_message %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="d-flex flex-items-center">
          <%= render(Primer::Beta::Octicon.new(:person, mr: 2, color: :muted)) %>
          <span class="text-bold">Created by</span>
        </div>
        <div class="color-fg-muted">
          <%= batch.actor %>
        </div>
      </div>
    <% end %>

    <% box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="d-flex flex-items-center">
          <%= render(Primer::Beta::Octicon.new(:clock, mr: 2, color: :muted)) %>
          <span class="text-bold">Created</span>
        </div>
        <div class="color-fg-muted">
          <%= time_ago_in_words(batch.created_at) %> ago
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="tmp-mt-3">
    <%= render(Biztools::Coupons::CouponsListComponent.new(
      coupons: coupons,
      title: "Generated Coupons",
      empty_message: "No coupons generated yet.",
    )) %>
  </div>
<% end %>
