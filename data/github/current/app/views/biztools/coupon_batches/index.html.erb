<% page_info title: "Coupon Generation", selected_link: :admin_coupon_batches %>

<%= render layout: "biztools/biztools" do %>
  <div class="Box Box--condensed">
    <div class="Box-header d-flex flex-justify-between flex-items-center">
      <h3 class="Box-title">Coupon Generation Batches</h3>
      <%= link_to 'Bulk generate coupons', new_biztools_coupon_batch_path, class: 'btn btn-sm' %>
    </div>

    <% if batches.any? %>
        <% batches.each do |batch| %>
          <div class="Box-row d-flex flex-items-center">
            <div class="flex-auto my-2">
              <%= link_to biztools_coupon_batch_path(batch), class: "Link--primary" do %>
                <h4 class="mb-1">
                  <% if batch.prefix.present? %>
                    <%= batch.prefix %>
                  <% else %>
                    Batch #<%= batch.id %>
                  <% end %>
                </h4>
              <% end %>
              <div class="text-small color-fg-muted">
                <span class="tmp-mr-3">
                  <%= primer_octicon(:package, mr: 1) %>
                  <strong><%= coupons_counts[batch.id] || 0 %></strong> / <%= batch.quantity %> coupons generated
                </span>
                <span class="tmp-mr-3">
                  <%= primer_octicon(:clock, mr: 1) %>
                  Created <%= time_ago_in_words(batch.created_at) %> ago
                </span>
                <% if batch.tracking_issue.present? %>
                  <span class="tmp-mr-3">
                    <%= primer_octicon(:"issue-opened", mr: 1) %>
                    <% tracking_url = tracking_issue_url_for(batch) %>
                    <% if tracking_url %>
                      <%= link_to batch.tracking_issue, tracking_url, target: '_blank', rel: 'noopener', class: 'Link--primary' %>
                    <% else %>
                      <%= batch.tracking_issue %>
                    <% end %>
                  </span>
                <% end %>
              </div>
            </div>
            <div class="flex-shrink-0 tmp-ml-3">
              <span class="State State--<%= batch.status == 'success' ? 'open' : batch.status == 'failed' ? 'closed' : 'draft' %>">
                <%= batch.status.humanize %>
              </span>
            </div>
          </div>
        <% end %>

        <% if batches.respond_to?(:total_pages) && batches.total_pages > 1 %>
          <div class="Box-row text-center">
            <div class="paginate-container">
              <%= will_paginate batches %>
            </div>
          </div>
        <% end %>
    <% else %>
      <div class="Box-row">
        <div class="blankslate">
          <h3>No coupon generation batches yet</h3>
          <p>Create your first batch to generate multiple coupons at once.</p>
          <%= link_to 'Create Batch', new_biztools_coupon_batch_path, class: 'btn btn-primary' %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
