<%
  previous_state = if listing.verification_pending_from_unverified?
    "unverified"
  elsif listing.verification_pending_from_draft? || listing.unverified_pending?
    "draft"
  end
  screenshots = screenshots(listing)
%>

<% page_info \
  title: "#{listing.name} · Marketplace Listing · Biztools",
  selected_link: :marketplace_listings %>

<%= render layout: "biztools/biztools" do %>
  <div class="mb-4">
    <%= render partial: "biztools/marketplace_listings/listing_navigation", locals: {
      listing: listing,
      selected_link: :listing_approval
    } %>
    <% if user_feature_enabled?(:marketplace_listing_copilot_approval_prompt) %>
      <div>
        <div class="mb-5">
          <%= render Primer::Beta::Subhead.new do |component| %>
            <% component.with_heading(tag: :h2) do %>
              How to verify listing
            <% end %>
          <% end %>

          <p>Use GitHub Copilot chat to verify that this Marketplace Listing meets all mandatory requirements to be listed. Follow the instructions to evaluate this listing:</p>
          <ol style="list-style-position: inside">
            <li>Evaluate screenshots (if they exist) for vulgar, abusive, and irrelevant content.</li>
            <li>Evaluate that links (if they exist) provided by the user lead to valid websites.</li>
            <li>Once screenshots and links have been evaluated, click "Generate prompt".</li>
            <li>Copy the prompt and paste it into Copilot Chat.</li>
            <li>Once Copilot chat has generated a response, review the response and approve, or reject the listing.</li>
          </ol>
        </div>

        <%= render partial: "biztools/marketplace_listings/approval_prompt", locals: {
              listing: listing,
              screenshots: screenshots,
            }
        %>
      </div>
    <% end %>

    <% if render_approve_listing?(listing) %>
      <%= render partial: "biztools/marketplace_listings/approve_listing", locals: {
            listing_id: listing.id,
            listing_slug: listing.slug,
            listing_name: listing.name,
            unverified_pending: listing.unverified_pending?,
          }
      %>
    <% end %>

    <% if render_approve_creator?(listing) %>
      <%= render partial: "biztools/marketplace_listings/approve_creator", locals: {
            listing_id: listing.id,
            listing_slug: listing.slug,
            listing_name: listing.name,
          }
      %>
    <%end%>

    <% if render_reject_listing?(listing) %>
      <%= render partial: "biztools/marketplace_listings/reject_listing", locals: {
            listing_id: listing.id,
            listing_slug: listing.slug,
            listing_name: listing.name,
            previous_state: previous_state,
            listing_owner_login: listing.owner.display_login,
          }
      %>
    <% end %>
  </div>

  <% if user_feature_enabled?(:marketplace_listing_copilot_approval_prompt) %>
    <%= render partial: "biztools/marketplace_listings/approval_prompt_form", locals: {
        listing: listing,
        screenshots: screenshots,
      }
    %>
  <% end %>
<% end %>
