<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h3) do %>
      Generate Prompt
    <% end %>
  <% end %>
  <% component.with_body do %>
    <%= form_tag "", method: :get do %>
      <% if screenshots.any? %>
        <div class="mb-3">
          <div class="FormControl-label">
            Do the provided screenshots follow the
            <a class="Link--inTextBlock"
                href="https://docs.github.com/en/apps/github-marketplace/listing-an-app-on-github-marketplace/writing-a-listing-description-for-your-app#guidelines-for-screenshots"
                target="_blank"
                rel="noopener noreferrer">
              Guidelines for screenshots
            </a>? *
          </div>
          <%= render partial: "biztools/marketplace_listings/screenshots_carousel", locals: {
                screenshots: screenshots,
              }
          %>
          <%= render Primer::Alpha::RadioButtonGroup.new(name: "screenshots") do |component| %>
            <% component.radio_button(label: "Yes", value: "yes", checked: params['screenshots'] == 'yes') %>
            <% component.radio_button(label: "No", value: "no", checked: params['screenshots'] == 'no') %>
          <% end %>
        </div>
      <% end %>

      <% if listing.support_email.present? %>
        <div class="mb-3">
          <div class="FormControl-label">
            Is the support email valid? *
          </div>
          <div class="FormControl-caption">
            <%= listing.support_email %>
          </div>
          <%= render Primer::Alpha::RadioButtonGroup.new(name: "support_email") do |component| %>
            <% component.radio_button(label: "Yes", value: "yes", checked: params['support_email'] == 'yes') %>
            <% component.radio_button(label: "No", value: "no", checked: params['support_email'] == 'no') %>
          <% end %>
        </div>
      <% end %>

      <% prompt_urls(listing).each do |key, value| %>
        <% if value.present? %>
          <div class="mb-3">
            <div class="FormControl-label">
              Is the <%= key.to_s.humanize %> valid? *
            </div>
            <div class="FormControl-caption">
              <a class="Link--inTextBlock" href="<%= value %>" target="_blank" rel="noopener noreferrer">
                <%= value %>
              </a>
            </div>
            <%= render Primer::Alpha::RadioButtonGroup.new(name: key) do |component| %>
              <% component.radio_button(label: "Yes", value: "yes", checked: params[key] == 'yes') %>
              <% component.radio_button(label: "No", value: "no", checked: params[key] == 'no') %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) do %>
        Generate Prompt
      <% end %>
    <% end %>
  <% end %>
<% end %>
