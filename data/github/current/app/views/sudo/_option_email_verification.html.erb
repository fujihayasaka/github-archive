<div data-target="sudo-credential-options.totpEmailContainer" <%="hidden" unless defined?(visible) && visible %>>
  <div id="email-landing-container">
    <%= render(Primer::Beta::BorderBox.new(mt: 3, bg: :subtle)) do |component| %>
      <%= component.with_body(mt: 0) do %>
        <p>
          When you are ready, trigger a mailer to verify your identity.
        </p>
        <%= render Primer::Beta::Button.new(id: "sudo-send-email", "data-action": "click:sudo-credential-options#initiateTotpEmailRequest", scheme: :primary, block: true, mt: 3) do %>Verify via email<% end %>
      <% end %>
    <% end %>
  </div>
  <div id="email-confirm-container" hidden>
    <%= form_tag sudo_action, method: sudo_method, class: form_classes do %>
      <%= hash_to_hidden_fields redirect_params if render_redirect_params %>
      <input type="hidden" name="credential_type" value="email">
      <%= render(Primer::Beta::BorderBox.new(mt: 3, bg: :subtle)) do |component| %>
        <%= component.with_body(mt: 0) do %>
          <%= render Primer::Alpha::Banner.new(classes: "js-sudo-error", scheme: :danger, display: :block, hidden: true) %>
          <p>
            Enter the verification code sent to <%= current_user.masked_primary_and_account_related_emails.first %>.
          </p>
          <%= text_field_tag :sudo_email_otp, nil, class: "input-block mb-2", arial_label: "Enter the 8-digit verification code sent to your email",
            :inputmode => "numeric", :pattern => "([0-9]{8})", :placeholder => "XXXXXXXX" %>
          <%= render Primer::Beta::Button.new(block: true, type: :submit, scheme: :primary, mt: 3) do %>Verify<% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
