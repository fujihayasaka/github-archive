<%= render Primer::Alpha::ActionMenu.new(
    select_variant: :single,
    anchor_align: :end,
    show_dividers: true
  ) do |menu| %>
  <% menu.with_show_button(size: :small) do |button| %>
    <% button.with_trailing_action_icon(icon: :"triangle-down") %>
    <span class="color-fg-muted">Period:</span>
    <span><%= selected_period_title %></span>
  <% end %>

  <% period_menu_options.each do |option| %>
    <% menu.with_item(
      label: option[:title],
      href: data_url_helper.call(period: option[:value]),
      active: selected_period == option[:value]
    ) %>
    <% unless option == period_menu_options.last %>
      <% menu.with_divider %>
    <% end %>
  <% end %>
<% end %>
