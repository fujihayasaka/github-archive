<%= content_for(:content) do %>
  <main>
    <%= render(Primer::Alpha::UnderlineNav.new(label: "Frame navigations")) do |component| %>
      <% component.with_tab(
          href: "/_soft_navigation_tests/7",
          "data-turbo-frame": "soft-nav-tests-frame",
          id: "frame-nav-1"
        ) { "Frame 1" } %>
      <% component.with_tab(
          href: "/_soft_navigation_tests/8",
          "data-turbo-frame": "soft-nav-tests-frame",
          id: "frame-nav-2"
        ) { "Frame 2" } %>
      <% component.with_tab(
          href: "/_soft_navigation_tests/9",
          "data-turbo-frame": "soft-nav-tests-frame",
          id: "frame-nav-3"
        ) { "Frame 3" } %>
      <% component.with_tab(
          href: "/_soft_navigation_tests/404",
          "data-turbo-frame": "soft-nav-tests-frame",
          id: "frame-nav-404"
        ) { "Frame 404" } %>
      <% component.with_tab(
          href: "/_soft_navigation_tests_other",
          "data-turbo-frame": "soft-nav-tests-frame",
          id: "frame-nav-other"
        ) { "Frame to different React app" } %>
    <% end %>

    <turbo-frame id="soft-nav-tests-frame" target="_top" data-turbo-action="advance" class="d-flex flex-auto">
      <%= yield %>
    </turbo-frame>
  </main>
<% end %>

<%= render template: "layouts/application" %>
