<% page_info hide_footer: true %>

<% content_for :site_header do %>
  <span class="d-none">This is a filler to hide the site header</span>
<% end %>

<% content_for :content do %>
  <div class="d-flex flex-auto flex-column overflow-hidden position-relative signups-rebrand__container">
    <main class="d-flex flex-auto flex-column">
      <div class="d-flex flex-auto flex-column flex-lg-row">
        <%# Left half with linear gradient background %>
        <% if content_for?(:signups_left_panel) %>
          <%= yield :signups_left_panel %>
        <% end %>
        <%# Right half where content lives %>
        <div class="signups-rebrand__container-form position-relative">
          <div class="signups-rebrand__container-mobile-head z-2 position-absolute d-lg-none"></div>
          <div class="d-flex flex-justify-center signups-rebrand__container-inner">
            <%= yield %>
          </div>
        </div>
      </div>
    </main>
  </div>
<% end %>

<%= render template: "layouts/application" %>
