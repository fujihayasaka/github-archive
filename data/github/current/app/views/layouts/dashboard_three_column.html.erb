<% content_for :head do %>
  <%= stylesheet_bundle "github" %>
<% end %>

<% content_for :dashboard_sub_layout do %>
  <%
    feed_content_classes, feed_content_styles, main_classes = if FeatureFlag.vexi.enabled?(:productivity_dashboard, current_user, default: false)
      ["pt-4 d-flex feed-content flex-justify-center", "min-height:calc(100dvh - var(--base-size-64));", "flex-1"]
    else
      ["pt-4 border-bottom d-flex feed-content flex-justify-center", "", "flex-auto"]
    end
  %>
  <div class="color-bg-default">
    <% if user_can_switch_contexts? %>
      <aside class="hide-xl hide-lg width-full border-bottom p-3" aria-label="Account context">
        <%= render Dashboard::ContextSwitcherComponent.new(
          current_context: current_context,
          user_can_create_orgs: user_can_create_organizations?,
          id: "switch_dashboard_context_three_column",
        ) %>
      </aside>
    <% end %>

    <%= render(Site::EnterpriseBannersComponent.new) %>

    <div class="d-md-flex feed-background" style="min-height: 100vh;">
      <aside data-turbo="false" class="feed-left-sidebar col-md-4 col-lg-3 color-border-muted border-bottom hide-md hide-sm border-right color-bg-default" aria-label="Account">
        <%= yield :left_column %>
      </aside>

      <div class="flex-auto col-md-8 col-lg-8 px-3 px-sm-3 px-md-0">
        <%= yield :hero %>

        <div class="d-md-flex">
          <div class="<%= feed_content_classes %>" style="<%= feed_content_styles %>">
            <div class="overflow-x-hidden d-flex flex-auto flex-column feed-main">
              <main class="<%= main_classes %>">
                <%= yield %>
              </main>

              <%= render "site/footer", cookie_consent_enabled: @cookie_consent_enabled, no_horizontal_padding: true %>
            </div>
            <% if content_for?(:right_column) %>
              <aside class="feed-right-sidebar mb-5" aria-label="Explore">
                <%= yield :right_column %>
              </aside>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
<%= render template: "layouts/dashboard" %>
