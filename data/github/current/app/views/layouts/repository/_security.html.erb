<%= render layout: "layouts/repository_container", locals: { repository: current_repository } do %>
<h1 class='sr-only'>Security: <%= current_repository.name_with_display_owner %></h1>

<% security_container_classes = responsive? ? "d-md-flex flex-md-items-stretch border-bottom" : "d-flex flex-items-stretch border-bottom pr-4" %>

<div class="<%= security_container_classes %>" style="min-height: 80vh">
  <% unless local_assigns[:hide_sidebar] %>
    <div class="d-flex flex-column business-global-sidebar" style="min-width: 278px">
      <%= render "navigation/repository/security", selected_tab: selected_tab %>
    </div>
  <% end %>

  <div class="<% if responsive? %>width-full<% else %>flex-auto container-xl p-6<% end %> min-width-0">
    <% main = capture do %>
      <% if flash[:plan_upgrade] %>
        <div class="mb-2">
          <%= render "plans/plan_support", repository: current_repository, feature: :insights, feature_name: "all insights" %>
        </div>
      <% end %>

      <%= yield %>
    <% end %>

    <% if responsive? %>
      <div class="pt-4 px-3 px-md-6 pb-6 d-flex flex-justify-center">
        <div class="col-12 col-lg-12 container-xl">
          <%= main %>
        </div>
      </div>
    <% else %>
      <%= main %>
    <% end %>
  </div>
</div>
<% end %>
