<%
  page_data = local_assigns[:page_data]
  selected_tab = page_data&.dig(:selected_tab) || :code_quality
%>

<% page_info(container_xl: true, selected_link: :security) %>

<% content_for :content do %>
  <main>
    <%= render layout: "layouts/repository/security", locals: { selected_tab: selected_tab } do %>
      <%= yield %>
    <% end %>
  </main>
<% end %>

<%= render template: "layouts/application" %>
