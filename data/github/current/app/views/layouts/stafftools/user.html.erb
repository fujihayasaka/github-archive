<%
  page_info container_xl: true
%>

<% content_for :banner do %>
  <% if this_user.deleted? %>
    <% delete_user_job_status = UserDeleteJob.status(this_user.id) %>
    <% if delete_user_job_status.nil? || delete_user_job_status.error? %>
      <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: "alert")) do |banner| %>
        <span <%= test_selector "user-delete-job-failed-message" %>>
          This account was queued for deletion, but the job failed.
        </span>
        <% banner.with_action_content do %>
          <%= render(Primer::Alpha::Dialog.new(
            title: "Mark as not deleted",
            id: "mark-not-deleted",
          )) do |d| %>
            <% d.with_show_button(
              "data-disable-invalid": "",
              "data-disable-with": "Mark as not deleted"
            ) { "Mark as not deleted" } %>
            <% d.with_header(show_divider: true) do %>
                Mark account as not deleted?
            <% end %>
            <% d.with_body do %>
              <p>
                Marking the <strong><%= this_user.display_login %></strong> account as not deleted will
                clear the deleted state so the account is usable again.
              </p>
            <% end %>
            <% d.with_footer(show_divider: true) do %>
              <%= render(Primer::Beta::Button.new(
                data: { "close-dialog-id": "mark-not-deleted" }
              )) { "Cancel" } %>

              <%= form_with(
                url: stafftools_user_undeletes_path(this_user.display_login),
                method: :post) do |form| %>
                <%= render(Primer::Beta::Button.new(
                  type: :submit,
                  scheme: :danger,
                  "data-disable-invalid": "",
                  "data-disable-with": "Marking as not deleted..."
                )) { "Mark account as not deleted" } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: "alert")) do %>
        This account is queued for deletion.
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% content_for :breadcrumbs do %>
  <%= link_to "Site admin", stafftools_path %>
  /
  <strong><%= link_to this_user, stafftools_user_path(this_user) %></strong>
<% end %>

<% content_for :nav_items do %>
  <%= selected_link_to stafftools_user_administrative_tasks_path(this_user), highlight: :account_admin, class: "UnderlineNav-item" do %>
    <%= primer_octicon(:gear, classes: "UnderlineNav-octicon") %>
    Admin
  <% end %>

  <% if GitHub.billing_enabled? %>
    <%= selected_link_to billing_stafftools_user_path(this_user), highlight: :account_billing, class: "UnderlineNav-item" do %>
      <%= primer_octicon(:"credit-card", classes: "UnderlineNav-octicon") %>
      Billing
    <% end %>
  <% end %>

  <%= selected_link_to stafftools_user_security_path(this_user), highlight: [
    :account_security, :apps, :authorized_github_apps, :authorized_github_owned_oauth_apps,
    :authorized_other_oauth_apps, :developers_stafftools_user_apps, :installations,
    :personal_access_tokens, :gpg_keys, :oauth_tokens, :stafftools_user_security, :ssh_keys
  ], class: "UnderlineNav-item" do %>
    <%= primer_octicon(:"shield-lock", classes: "UnderlineNav-octicon") %>
    Security
  <% end %>

  <%= selected_link_to stafftools_user_repositories_path(this_user), highlight: [
    :account_content, :stafftools_user_gists, :stafftools_user_codespaces
  ], class: "UnderlineNav-item" do %>
    <%= primer_octicon(:repo, classes: "UnderlineNav-octicon") %>
    Content
  <% end %>

  <%= selected_link_to stafftools_user_organization_memberships_path(this_user), highlight: [:account_collaboration, :orgs], class: "UnderlineNav-item" do %>
    <%= primer_octicon(:"comment-discussion", classes: "UnderlineNav-octicon") %>
    Collaboration
  <% end %>
<% end %>

<%= render template: "layouts/stafftools" %>
