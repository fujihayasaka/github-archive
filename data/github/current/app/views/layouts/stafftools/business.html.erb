<%
  page_info container_xl: true
%>

<% content_for :breadcrumbs do %>
  <%= link_to "Site admin", stafftools_path %>
  /
  <%= link_to "Enterprises", stafftools_enterprises_path %>
  /
  <strong><%= link_to this_business.name, stafftools_enterprise_path(this_business) %></strong>
<% end %>

<% content_for :nav_sidebar do %>
  <% unless GitHub.single_business_environment? %>
    <% if this_business.staff_owned? %>
      <%= render Primer::Beta::BorderBox.new(padding: :condensed, mb: 2) do |bb| %>
        <% bb.with_row do %>
          <section aria-label="Enterprise staff owned badge" role="note">
            <%= primer_octicon(:"mark-github") %>
            <%= render Primer::Beta::Label.new(ml: 1, text_transform: :uppercase, title: "Label: Staff Owned") do %>
              Staff Owned
            <% end %>
          </section>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <nav class="menu" aria-label="Enterprise account" data-hpc>
    <%= selected_link_to "Overview", stafftools_enterprise_path(this_business), highlight: :business_overview, class: "menu-item" %>
    <%= selected_link_to "Organizations", summary_stafftools_enterprise_organizations_path(this_business), highlight: :business_organizations, class: "menu-item" %>
    <% if this_business.enterprise_teams_enabled? || BusinessTeam.enabled_for_enterprise?(business: this_business) %>
      <%= selected_link_to "Enterprise teams", stafftools_enterprise_teams_path(this_business), highlight: :enterprise_teams, class: "menu-item", "data-test-selector": "enterprise-teams" %>
    <% end %>
    <% if BusinessTeam.enabled_for_enterprise?(business: this_business) %>
      <%= selected_link_to "Enterprise team limits", stafftools_enterprise_enterprise_team_limits_path(this_business), highlight: :enterprise_team_limits, class: "menu-item" %>
    <% end %>
    <% if this_business.custom_enterprise_roles_supported? || this_business.custom_organization_roles_supported? %>
      <%= selected_link_to "Custom roles", custom_roles_summary_stafftools_enterprise_path(this_business), highlight: :custom_roles, class: "menu-item" %>
    <% end %>
    <%= selected_link_to "People", stafftools_enterprise_people_path(this_business), highlight: :business_people, class: "menu-item" %>
    <%= selected_link_to "Policies", stafftools_enterprise_policies_path(this_business), highlight: :business_policies, class: "menu-item" %>
    <%= selected_link_to "Authentication security", stafftools_enterprise_security_path(this_business), highlight: :business_security, class: "menu-item" %>

    <% if this_business.member_privilege_rulesets_enabled? %>
      <%= selected_link_to "Repository policies", repository_policies_stafftools_enterprise_url(this_business), highlight: :enterprise_repository_path, class: "menu-item" %>
    <% end %>
    <%= selected_link_to "Code rules", code_rulesets_stafftools_enterprise_path(this_business), highlight: :enterprise_code_rulesets, class: "menu-item" %>
    <%= selected_link_to "Code rules insights", code_rulesets_insights_stafftools_enterprise_path(this_business), highlight: :enterprise_code_rulesets, class: "menu-item" %>
    <%= selected_link_to "Code rules bypass requests", code_rules_bypass_requests_stafftools_enterprise_path(this_business), highlight: :enterprise_code_rulesets, class: "menu-item" %>

    <% if GitHub.ip_allowlists_available? %>
      <%= selected_link_to "IP allow list", stafftools_enterprise_ip_allowlist_path(this_business), highlight: :business_ip_allowlist, class: "menu-item" %>
    <% end %>
    <% unless GitHub.single_business_environment? %>
      <%= selected_link_to "Webhooks", stafftools_enterprise_hooks_path(this_business), highlight: [:business_webhooks, :hooks], class: "menu-item" %>
      <% unless this_business.customer&.billed_via_billing_platform? %>
        <%= selected_link_to "Enterprise licensing", stafftools_enterprise_licensing_path(this_business), highlight: :business_licenses, class: "menu-item" %>
      <% end %>
      <%= selected_link_to "Enterprise Server installations", stafftools_enterprise_enterprise_installations_path(this_business), highlight: :enterprise_installations, class: "menu-item" %>
    <% end %>

    <%= selected_link_to "Owned GitHub Apps", stafftools_business_apps_path(this_business), highlight: :apps, class: "menu-item" %>
    <%= selected_link_to "GitHub App installations", stafftools_enterprise_integration_installations_path(this_business), highlight: :installations, class: "menu-item" %>
    <%= selected_link_to "Custom properties", stafftools_enterprise_custom_properties_path(this_business), highlight: :custom_properties, class: "menu-item" %>
    <% if Orgs.domain.custom_properties.feature_enabled?(this_business) %>
      <%= selected_link_to "Organization custom properties", stafftools_enterprise_custom_property_definitions_for_organization_index_path(this_business), highlight: :organization_custom_property_definitions, class: "menu-item" %>
    <% end %>

    <% if GitHub.driftwood_streaming_stafftools_enabled? %>
      <%= selected_link_to "Audit log streaming", stafftools_audit_log_stream_path(this_business), highlight: :audit_log_streaming, class: "menu-item" %>
    <% end %>

    <%= selected_link_to "Domains", stafftools_enterprise_domains_path(this_business), highlight: :domains, class: "menu-item" %>

    <% unless GitHub.single_business_environment? %>
      <%= selected_link_to "Actions", stafftools_actions_path(this_business), highlight: [:actions, :actions_hosted_runners], class: "menu-item" %>
      <% if GitHub.actions_custom_images_stafftools_enabled?(current_user) || GitHub.actions_custom_images_stafftools_enabled?(this_business) %>
        <%= selected_link_to "Custom Images", stafftools_enterprise_custom_images_path(this_business), highlight: :custom_images, class: "menu-item" %>
      <% end %>
      <%= selected_link_to "Hosted compute networking", stafftools_hosted_compute_networking_index_path(this_business), highlight: :hosted_compute_networking, class: "menu-item" %>
      <%= selected_link_to "SLA report", stafftools_sla_reports_path(stafftools_sla_report: { entity_kind: "Enterprise", entity_id: this_business }), highlight: :sla_report, class: "menu-item" %>

      <% if this_business.enterprise_managed_user_enabled? %>
        <%= selected_link_to "External groups", external_groups_stafftools_enterprise_path(this_business), highlight: :external_groups, class: "menu-item" %>
      <% end %>
    <% end %>

    <% if GitHub.dotcom_request? # limiting to dotcom so only GitHub staff can see this %>
      <%= selected_link_to(
        "Security center",
        stafftools_enterprise_security_center_path(this_business),
        class: "menu-item",
      ) %>

      <%= selected_link_to(
        "Security configurations",
        security_configurations_stafftools_enterprise_path(this_business),
        class: "menu-item",
      ) %>
    <% end %>

    <% if GitHub.billing_enabled? && stafftools_action_authorized?(
      controller: Stafftools::Businesses::TradeComplianceController,
      action: :show,
    ) %>
      <%= selected_link_to "Trade compliance", stafftools_enterprise_trade_compliance_path(this_business), class: "menu-item" %>
    <% end %>

    <% if !GitHub.enterprise? && !GitHub.multi_tenant_enterprise? %>
      <%= selected_link_to "Models", stafftools_enterprise_models_path(this_business), highlight: :models, class: "menu-item" %>
    <% end %>

    <%= selected_link_to "Orchestrations",
      stafftools_enterprise_orchestrations_path(this_business),
      highlight: :orchestrations,
      class: "menu-item" %>
  </nav>

  <% if GitHub.copilot_enabled? %>
    <% copilot_business = Copilot::Business.new(this_business) %>
    <nav class="menu" aria-labelledby="copilot-heading">
      <div class="menu-heading" id="copilot-heading">
        <%= render(Primer::Beta::Octicon.new("copilot")) %>
        Copilot
      </div>
      <%= selected_link_to "Copilot details", stafftools_copilot_path(this_business), highlight: :copilot, class: "menu-item" %>
      <%= selected_link_to "Copilot seat assignments", standalone_seat_assignments_stafftools_copilot_path(this_business), highlight: :seat_assignments, class: "menu-item" %>
      <%= selected_link_to "Copilot seats", standalone_seats_stafftools_copilot_path(this_business), highlight: :copilot_seats, class: "menu-item" %>
      <%= selected_link_to "Usage metrics", stafftools_copilot_usage_metrics_path(this_business), highlight: :copilot_metrics, class: "menu-item" %>
      <%= selected_link_to "Copilot metrics", stafftools_copilot_metrics_path(this_business), highlight: :copilot_metrics, class: "menu-item" %>
      <%= selected_link_to "Copilot metrics dashboard", stafftools_copilot_insights_usage_path(this_business), highlight: :copilot_insights_usage, class: "menu-item" %>
    </nav>
  <% end %>

  <% if GitHub.billing_enabled? %>
    <nav class="menu" aria-labelledby="new-billing-vnext-heading">
      <div class="menu-heading" id="new-billing-vnext-heading">
        <%= render(Primer::Beta::Octicon.new("credit-card")) %>
        Billing & licensing
      </div>
      <%= selected_link_to "Billing settings", stafftools_enterprise_billing_path(this_business), class: "menu-item" %>
      <%= selected_link_to "Payment history", stafftools_enterprise_billing_payment_history_path(this_business), class: "menu-item" %>
      <%= selected_link_to "Licensing", stafftools_enterprise_licensing_path(this_business), highlight: :business_licenses, class: "menu-item" %>
      <%= selected_link_to "Advanced Security Licensing", stafftools_advanced_security_path(this_business), highlight: :advanced_security, class: "menu-item"  %>
      <% if this_business.self_serve_payment? %>
        <%= selected_link_to "Marketplace usage", stafftools_enterprise_marketplace_path(this_business), highlight: :marketplace, class: "menu-item" %>
      <% end %>
      <%= selected_link_to "Sponsorships", stafftools_enterprise_billing_sponsorships_path(this_business), highlight: :sponsorships, class: "menu-item" %>
      <%= selected_link_to "Education configuration", stafftools_enterprise_billing_education_configuration_path(this_business), highlight: :education_configuration, class: "menu-item" %>
      <%= selected_link_to "Migration", stafftools_enterprise_billing_migrations_path(this_business), class: "menu-item" %>
      <%= selected_link_to "Zuora webhooks", stafftools_enterprise_billing_zuora_webhooks_path(this_business), highlight: :zuora_webhooks, class: "menu-item" %>
      <%= selected_link_to "Plan history", stafftools_enterprise_billing_plan_history_index_path(this_business), class: "menu-item" %>
    </nav>
    <nav class="menu" aria-labelledby="metered-billing-heading">
      <div class="menu-heading" id="metered-billing-heading">
        <%= render(Primer::Beta::Octicon.new("rocket")) %>
        Metered billing
      </div>
      <%= selected_link_to "Overview",  stafftools_enterprise_billing_usage_overview_path(this_business), class: "menu-item" %>
      <%= selected_link_to "Usage", stafftools_enterprise_billing_usage_path(this_business), class: "menu-item" %>
      <% if FeatureFlag.vexi.enabled?(:pru_billing_page, this_business, default: false) || FeatureFlag.vexi.enabled?(:pru_billing_page_org_admins, this_business, default: false) %>
        <%= selected_link_to "Premium request analytics", stafftools_enterprise_billing_premium_requests_usage_index_path(this_business), class: "menu-item" %>
      <% end %>
      <%= selected_link_to "Budgets",  stafftools_enterprise_billing_budgets_path(this_business), class: "menu-item" %>
      <%= selected_link_to "Invoices", stafftools_enterprise_billing_invoices_path(this_business), class: "menu-item" %>
      <%= selected_link_to "Metered billing exports", stafftools_metered_exports_path(this_business), highlight: :metered_exports, class: "menu-item" %>
      <%= selected_link_to "Cost centers",  stafftools_enterprise_billing_cost_centers_path(this_business), class: "menu-item" %>
      <%= selected_link_to "Prepaid metered usage", stafftools_prepaid_metered_usage_refills_path(this_business), highlight: :prepaid_metered_usage_refills, class: "menu-item" %>
      <%= selected_link_to "Trigger Azure emissions",  stafftools_enterprise_billing_trigger_azure_emissions_path(this_business), class: "menu-item" %>
      <%= selected_link_to "Credits", stafftools_enterprise_billing_discounts_path(this_business), class: "menu-item" %>
      <% if FeatureFlag.vexi.enabled?(:azure_emissions_stafftools_page, default: false) %>
        <%= selected_link_to "Azure emissions", stafftools_enterprise_billing_azure_emissions_path(this_business), class: "menu-item" %>
      <% end %>
    </nav>
  <% end %>
<% end %>



<%= render template: "layouts/stafftools" %>
