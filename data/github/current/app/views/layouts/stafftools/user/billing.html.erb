<% page_info :selected_link => :account_billing %>

<% content_for :nav_sidebar do %>
  <nav class="menu" aria-label="Billing admin navigation">
    <%= link_to billing_stafftools_user_path(this_user), class: "menu-heading" do %>
      <%= primer_octicon(:"credit-card") %>
      Billing
    <% end %>
    <%= selected_link_to("Summary", billing_stafftools_user_path(this_user), highlight: :stafftools_user_billing, class: "menu-item") %>
    <%= selected_link_to stafftools_user_billing_history_path(this_user), class: "menu-item" do %>
      Payment history
      <%= render Primer::Beta::Counter.new(
        count: this_user.billing_transactions.count,
        scheme: :secondary,
      ) %>
    <% end %>
    <% if FeatureFlag.vexi.enabled?(:receipts_use_zuora_pdf, current_user, default: false) %>
    <%= selected_link_to stafftools_user_billing_invoices_path(this_user), class: "menu-item" do %>
      Invoices
    <% end %>
    <% end %>
    <%= selected_link_to(stafftools_user_subscription_items_path(this_user), class: "menu-item") do %>
      Subscription items
      <%= render Primer::Beta::Counter.new(
        count: this_user.active_product_uuid_subscription_items.count,
        scheme: :secondary,
      ) %>
    <% end %>
    <%= selected_link_to("Zuora webhooks", stafftools_user_billing_zuora_webhooks_path(this_user), class: "menu-item") %>
  </nav>

  <% if this_user.customer&.billed_via_billing_platform? %>
    <nav class="menu" aria-labelledby="licensing-nav-label">
      <div class="menu-heading" id="licensing-nav-label">
        <%= primer_octicon(:rocket) %>
        Billing and licensing
      </div>
        <%= selected_link_to("Overview", stafftools_user_billing_usage_overview_path(this_user), class: "menu-item") %>
        <%= selected_link_to("Usage", stafftools_user_billing_usage_path(this_user), class: "menu-item") %>
        <% if FeatureFlag.vexi.enabled?(:pru_billing_page, this_user, default: false) %>
          <%= selected_link_to("Premium request analytics", stafftools_user_billing_premium_requests_usage_index_path(this_user), class: "menu-item") %>
        <% end %>
        <%= selected_link_to("Budgets", stafftools_user_billing_budgets_path(this_user), class: "menu-item") %>
        <%= selected_link_to("Invoices", stafftools_user_billing_invoices_path(this_user), class: "menu-item") %>
        <%= selected_link_to("Discounts", stafftools_user_billing_discounts_path(this_user), class: "menu-item") %>
        <%= selected_link_to("Metered usage exports", stafftools_user_metered_exports_path(this_user), class: "menu-item") %>
        <%= selected_link_to("Trial limits", stafftools_user_trial_limits_path(this_user), class: "menu-item") %>
    </nav>
  <% end %>
<% end %>

<%= render template: "layouts/stafftools/user" %>
