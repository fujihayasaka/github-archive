<% unless GitHub.single_or_multi_tenant_enterprise? %>
  <% content_for :site_analytics do %>
    <% if @cookie_consent_enabled && @microsoft_analytics_enabled %>
      <microsoft-analytics>
        <% if content_for?(:microsoft_analytics_addition) %>
          <%= yield :microsoft_analytics_addition %>
        <% end %>
      </microsoft-analytics>
    <% end %>
  <% end %>
<% end %>

<% show_multi_tenant_provisioning_steps ||= false %>

<% content_for :content do %>
<div class="border-bottom border-container">
  <main class="height-full" <%= test_selector("enterprise_digital_front_door_funnel") %>>
    <div class="d-flex flex-auto flex-column position-relative dfd-trial__container height-full">
      <div class="d-flex flex-auto flex-column flex-lg-row">
        <%# Left half with linear gradient background %>
        <div class="width-md-1/2 dfd-trial__container dfd-trial__container-background">
          <div class="dfd-trial__container-marketing">
            <div class="dfd-trial__container-content">
              <%= render(Primer::Beta::Label.new(tag: :span, size: :large, style: "color: #C398FB; border-color: #C398FB", mb: 3)) { "30 day free trial" } %>
              <%= render(Primer::Beta::Heading.new(
                tag: :h1,
                color: :on_emphasis,
                classes: "dfd-trial__container-h1",
                width: :medium
              )) { show_multi_tenant_provisioning_steps ? "We are setting up your Enterprise account" : "Unlock GitHub's Premium Features" } %>

              <% if show_multi_tenant_provisioning_steps %>
                <%= render partial: "businesses/multi_tenant_provisioning_requests/multi_tenant_provisioning_steps" %>
              <% else %>
                <%= render partial: "businesses/trial_accounts/trial_premium_features_description" %>
              <% end %>
            </div>
          </div>
          <picture>
            <source srcset="<%= image_path "dfd-trial/dfd-trial-foreground.png" %>" media="(min-width: 1280px)">
            <img
              src="<%= image_path "dfd-trial/dfd-trial-foreground.png" %>"
              alt="GitHub, Copilot and Advanced Security icons."
              class="dfd-trial__container-icons"
            >
          </picture>
        </div>

        <%# Right half where content lives %>
        <%= yield %>
      </div>
    </div>
  </main>
</div>
<% end %>
<%= render template: "layouts/application" %>
