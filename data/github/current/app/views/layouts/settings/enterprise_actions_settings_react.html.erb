<%# Layout wrapper for Actions enterprise-level settings pages using React apps. %>
<%# Provides the standard business layout and actions navigation tabs. %>
<% content_for :content do %>
  <main>
    <%= render layout: "businesses/layout",
      locals: {
        business: this_business,
        title: "Actions",
      } do %>
      <%= render "businesses/settings/actions/tabs",
        business: this_business,
        should_display_custom_images_tab: should_display_custom_images_tab %>
      <%= yield %>
    <% end %>
  </main>
<% end %>
<%= render template: "layouts/application" %>
