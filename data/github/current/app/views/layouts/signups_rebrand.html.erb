<% page_info hide_footer: true %>

<% content_for :site_header do %>
  <header class="js-warp-hide header-logged-out f4 py-3 z-2" role="banner">
    <div class="d-md-flex flex-justify-end flex-items-center width-full p-responsive">
      <% unless logged_in? %>
        <div class="font-mktg mt-3 mt-md-0">
          <%= render(Primer::Beta::Text.new(mr: 2)) { "Already have an account?" } %>
          <%= render(Primer::Beta::Link.new(
            href: site_nav_login_path,
            underline: true,
            color: :default,
          )) { "Sign in →" } %>
        </div>
      <% end %>
    </div>
  </header>
<% end %>

<% content_for :content do %>
  <div class="js-warp-hide d-flex flex-auto flex-column overflow-hidden position-relative">
    <main class="d-flex flex-auto flex-column">
      <div class="d-flex flex-auto flex-column flex-md-row">
        <%# Left half with linear gradient background %>
        <div class="flex-auto width-full width-md-1/2" style="background: linear-gradient(180deg, #000 0%, #24206f 51%, #512ea1 68%, #cec5e3 100%);">
          <div class="flex-auto p-responsive">
            <%= render(Primer::Beta::Heading.new(
              tag: :h2,
              font_size: 1,
              color: :on_emphasis,
              classes: "font-mktg",
            )) { "Create your free account" } %>
            <%= render(Primer::Beta::Heading.new(
              tag: :h3,
              font_size: 4,
              color: :on_emphasis,
              classes: "font-mktg",
            )) { "Explore GitHub's core features for individuals and organizations." } %>

            <div>
              <%= render Primer::Beta::Details.new(
                color: :on_emphasis
              ) do |component| %>
                <%= component.with_summary(button: false) {
                  "See what's included"
                } %>
                <%= component.with_body {
                  render Signups::BenefitsComponent.new
                } %>
              <% end %>
            </div>
          </div>
        </div>
        <%# Right half where content lives %>
        <div class="flex-auto width-full width-md-1/2">
          <div class="d-flex flex-justify-center pt-12">
            <%= yield %>
          </div>
        </div>
      </div>
    </main>
  </div>
<% end %>

<%= render template: "layouts/application" %>
