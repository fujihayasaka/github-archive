<% page_info hide_footer: true %>

<% content_for :site_header do %>
  <header class="header-logged-out f4 py-3 z-2 signups-rebrand__header" role="banner">
    <div class="d-lg-flex flex-justify-end flex-items-center width-full">
      <% unless logged_in? %>
        <div class="font-mktg mt-3 mt-md-0">
          <%= render(Primer::Beta::Text.new(mr: 2, classes: "signups-rebrand__header-text")) { "Already have an account?" } %>
          <%= render(
            Primer::Beta::Link.new(
              href: site_nav_login_path,
              underline: true,
              font_size: 5,
              classes: "signups-rebrand__header-text"
            )
          ) do %>
            Sign in →
          <% end %>
        </div>
      <% end %>
    </div>
  </header>
<% end %>

<% content_for :content do %>
  <div class="d-flex flex-auto flex-column overflow-hidden position-relative signups-rebrand__container">
    <main class="d-flex flex-auto flex-column">
      <div class="d-flex flex-auto flex-column flex-lg-row">
        <%# Left half with linear gradient background %>
        <div class="width-md-1/2 signups-rebrand__container-marketing">
          <div class="signups-rebrand__container-content">
            <%= render(Primer::Beta::Heading.new(
              tag: :h1,
              color: :on_emphasis,
              classes: "signups-rebrand__container-h1",
              width: :medium
            )) { "Create your free account" } %>
            <%= render(Primer::Beta::Text.new(
              color: :on_emphasis,
              mt: 2
            )) { "Explore GitHub's core features for individuals and organizations." } %>

              <details class="signups-rebrand__details color-fg-on-emphasis py-3">
              <summary class="signups-rebrand__details-summary text-semibold">
                See what's included
                <span class="signups-rebrand__details-icon">
                  <%= render(Primer::Beta::Octicon.new(:"chevron-down")) %>
                </span>
              </summary>
              <div class="signups-rebrand__details-content">
                <%= render Signups::BenefitsComponent.new %>
              </div>
            </details>
          </div>
          <picture>
            <source srcset="<%= image_path "signup/tres-amigos@2x.webp" %>" media="(min-width: 1280px)">
            <img
              src="<%= image_path "signup/dos-amigos@2x.webp" %>"
              alt="GitHub Mascots: Mona, Copilot, and a rubber duck floating on top of an astral background of stars."
              class="signups-rebrand__container-mascots"
            >
          </picture>
        </div>
        <%# Right half where content lives %>
        <div class="signups-rebrand__container-form position-relative" data-color-mode="light" data-light-theme="light" data-dark-theme="dark">
          <div class="signups-rebrand__container-mobile-head z-2 position-absolute d-lg-none"></div>
          <div class="d-flex flex-justify-center signups-rebrand__container-inner">
            <%= yield %>
          </div>
        </div>
      </div>
    </main>
  </div>
<% end %>

<%= render template: "layouts/application" %>
