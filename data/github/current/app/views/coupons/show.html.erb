<%# rubocop:disable Lint/InstanceVariable %>
<% view = Coupons::ShowView.new(
  coupon: @coupon,
  selected_account: @selected_account,
  plan: @plan,
  current_user: current_user,
) %>

<% page_info title: "Redeem Coupon", class: "coupons" %>
<%
  account = view.account
  billing_contact = view.billing_contact
  billing_info_exists_without_errors = account.present? && billing_info_exists_without_errors?(account)
  has_billing_info_validation_error = account.present? && has_billing_info_validation_error?(account)
%>

<div class="tmp-py-6 js-coupons-data-collection-wrapper" data-plan="<%= account&.plan&.display_name %>" data-login="<%= account&.display_login %>">
  <div class="container-lg p-responsive">
    <% if logged_in? %>
      <h1 class="f1 tmp-mb-4">Redeem your coupon</h1>
        <div class="clearfix">
          <div class="col-md-5 tmp-pr-md-5 float-md-left mb-md-0">
            <div class="d-flex flex-items-center">
              <div class="d-flex mr-2">
                <span class="pr-2"> <%= account.is_a?(Business) ? "Enterprise" : "Account" %>:</span>
                <%= render GitHub::AvatarComponent.new(actor: account, size: 24) %>
                <% if view.coupon.user_only? %>
                  <%= render(Primer::Beta::Text.new(font_size: :small, pl: 2)) { account.display_login } %>
                <% end %>
              </div>
              <% unless view.coupon.user_only? %>
                <%= render(Primer::Alpha::ActionMenu.new(select_variant: :single, dynamic_label: true)) do |menu| %>
                  <% menu.with_show_button(classes: "h6", p: 2, aria: {label: "Switch billing account"}) do |button| %>
                    <% button.with_trailing_action_icon(icon: "triangle-down") %>
                    <%= account.display_login %>
                  <% end %>
                  <% view.coupon.eligible_accounts(current_user).each do |acount_item| %>
                    <% menu.with_avatar_item(
                      href: redeem_coupon_path(code: params[:code], id: acount_item.display_login),
                      src: acount_item.primary_avatar_url,
                      label: acount_item.name,
                      username: acount_item.name,
                      active: account == acount_item,
                      test_selector: "switch-billing-account-#{acount_item.display_login}",
                    ) %>
                  <% end %>
                  <% if view.show_create_enterprise_account_from_coupon_button? %>
                    <% menu.with_item(
                      label: "Create new enterprise",
                      test_selector: "create-new-enterprise",
                      select_variant: :none,
                      href: new_enterprise_from_coupon_path(code: @coupon.code),
                    ) do |item| %>
                       <% item.with_leading_visual_icon(icon: "plus", mr: 2) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
          <% unless view.coupon_has_product_target? %>
            <div class="col-md-7 tmp-pl-md-7 float-md-left">
              <%= render(Primer::Beta::Heading.new(tag: :h2, classes: "tmp-mb-3")) { "Coupon summary" } %>
            </div>
          <% end %>
        </div>
        <div class="clearfix">
          <div class="col-md-5 tmp-pr-md-5 float-md-left tmp-mb-4 tmp-mb-md-0">
            <% if view.coupon_has_product_target? %>
              <h2 class="setup-form-title mb-2 tmp-py-3">Your coupon at a glance</h2>
            <% else %>
              <h2 class="setup-form-title tmp-mb-3">Your new subscription</h2>
            <% end %>

            <% if view.coupon_has_product_target? %>
              <%= render Primer::Box.new(border: true, border_radius: 2, classes: "tmp-p-3") do %>
                <div class="d-flex flex-items-center mb-2">
                  <%= render(Primer::Beta::Octicon.new(icon: "gift", color: :success, mr: 2)) %>
                  <strong class="f4"><%= view.coupon.product_target.product_name %></strong>
                </div>

                <ul class="list-style-none mb-0">
                  <li class="d-flex flex-justify-between py-2 border-bottom color-border-muted">
                    <span class="color-fg-muted">Regular price</span>
                    <span class="text-mono"><%= view.product_target_original_price %></span>
                  </li>
                  <li class="d-flex flex-justify-between py-2 border-bottom color-border-muted">
                    <span class="color-fg-success"><%= view.product_target_discount_label %></span>
                    <span class="text-mono color-fg-success">−<%= view.product_target_savings %></span>
                  </li>
                  <li class="d-flex flex-justify-between py-2">
                    <span class="text-bold">You pay</span>
                    <% if view.product_target_fully_discounted? %>
                      <span class="text-mono text-bold color-fg-success">Free!</span>
                    <% else %>
                      <span class="text-mono text-bold"><%= view.product_target_discounted_price %></span>
                    <% end %>
                  </li>
                </ul>

                <p class="color-fg-muted text-small tmp-mt-3 mb-0">
                  <%= render(Primer::Beta::Octicon.new(icon: "clock", size: :small, mr: 1)) %>
                  Valid for <%= view.discount_duration %>
                </p>
              <% end %>

            <% elsif view.coupon.user_only? %>
              <%= render "billing_settings/plan_table",
                account: current_user,
                selected_account: current_user,
                selected_plan: view.plan,
                coupon: view.coupon
              %>
            <% else %>
              <% view.coupon.eligible_accounts(current_user).each do |account| %>
                <%= render "coupons/plan_table",
                  account: account,
                  selected_account: view.selected_account,
                  selected_plan: @selected_plan,
                  coupon: view.coupon,
                  html_options: { visibility: "hidden" }
                %>
              <% end %>
            <% end %>

            <% if view.should_show_redeem_faq? %>
              <div class="setup-info-module tmp-mt-4">
                <%= render :partial => "coupons/redeem_faqs" %>
              </div>
            <% end %>

            <% if account.is_a?(Business) && account.creation_initiated_from_coupon? %>
              <%= form_tag delete_enterprise_from_coupon_path(slug: account.slug), method: :delete do %>
                <%= render Primer::Beta::Button.new(
                  type: :submit,
                  block: true,
                ) do %>
                  Cancel redemption
                <% end %>
              <% end %>
            <% end %>

          </div>
          <div class="col-md-7 tmp-pl-md-7 float-md-left">
            <% unless view.coupon_has_product_target? %>
              <div class="tmp-mb-3 tmp-py-3 d-flex flex-justify-between flex-items-center border color-bg-accent color-border-subtle rounded-2 tmp-p-3">
                <div class="lh-condensed">
                  <h3 class="h4">You're getting</h3>
                  <span class="text-small color-fg-muted d-block">
                    <% if view.coupon.plan.present? %>
                      the <%= view.coupon.plan_display_name %> plan for <%= view.discount_duration %>
                    <% else %>
                      a discount for <%= view.discount_duration %>
                    <% end %>
                  </span>
                </div>
                <h2 class="text-right unstyled-payment-due float-right mb-0 lh-condensed">
                  <%= view.discount_amount %>
                </h2>
              </div>
            <% end %>
            <div class="tmp-py-3">
              <div class="clearfix mb-2 tmp-pb-3">
                <%= render(Primer::Beta::Heading.new(classes: "float-left", tag: (view.coupon_has_product_target? ? :h2 : :h3))) { "Billing information" } %>
                <% if view.show_billing_info_edit_button?(has_billing_info_validation_error) %>
                  <div class="float-right js-edit-user-personal-profile-wrapper">
                    <%= render(
                      Primer::Beta::Button.new(
                        size: :medium,
                        font_size: 6, classes: "js-edit-user-personal-profile"
                      )
                      ) { "Edit" }
                    %>
                  </div>
                <% end %>
              </div>
              <% unless account.org_is_on_standard_tos? %>
                <% if billing_contact.nil? %>
                  <div class="clearfix text-normal tmp-pb-3">
                    Please confirm your billing details to continue. You only need to do this once.
                  </div>
                <% end %>
                <div class="clearfix d-sm-flex">
                  <div class="<%= class_names("col-sm-6 tmp-mb-3", "tmp-mb-sm-0" => billing_contact.present?) %>">
                    <div class="d-flex flex-items-center">
                      <%= render GitHub::AvatarComponent.new(actor: account, size: 48, mr: 2) %>
                      <ul class="list-style-none lh-condensed mb-2" style="min-height: 48px;">
                        <li class="pb-1 text-bold"><%= account.safe_profile_name %></li>
                        <li class="text-small color-fg-muted"><%= view.account_type %> account</li>
                      </ul>
                    </div>
                  </div>
                  <div class="col-sm-6 text-sm-right lh-condensed">
                    <% if billing_info_exists_without_errors %>
                      <%= render Billing::Settings::NameAddressSummaryComponent.new(contact: billing_contact, target: account) %>
                    <% end %>
                  </div>
                </div>
                <div class="js-name-address-collection-wrapper" <%= "hidden" if billing_info_exists_without_errors %>>
                  <%= render Billing::Settings::NameAddressFormComponent.new(
                    target: account,
                    payment_flow_loaded_from: "COUPONS",
                    return_to: account.is_a?(Business) ? request.url : nil,
                  ) %>
                </div>
              <% end %>

              <%= render Billing::Settings::BillingInformationLinkingComponent.new(
                actor: current_user,
                target: account,
                display_title: false,
                form_loaded_from: "COUPONS",
                return_to_path: request.url,
                no_redirect: true,
                autocheck_link_checkbox: view.org_has_no_linked_info_but_user_has_saved_info?
              ) %>

              <% if account.has_saved_billing_information? && account.has_commercial_interaction_restriction? %>
                <div class="border-top tmp-py-3 js-sdn-screening-error-wrapper">
                  <%= render(TradeCompliance::TradeScreeningRestrictionNoticeComponent.new(
                    target: account,
                    title: "You can't proceed at this time",
                    class_name: "container-sm mx-0",
                  )) %>
                </div>
              <% elsif view.show_payment_form?(has_billing_info_validation_error) %>
                <div class="border-top tmp-py-3 js-payment-methods-wrapper mb-1">
                  <h4 class="tmp-mb-3">Payment Method</h4>
                  <%= render Billing::Settings::PaymentMethodFormComponent.new(
                    target: account,
                    new_name_address_design: true,
                    signature_view_context: Billing::Zuora::HostedPaymentsPage::COUPONS_SIGNATURE_VIEW_CONTEXT,
                    return_to: request.url,
                  ) %>
                </div>
              <% end %>
            </div>
            <div class="js-coupons-form-wrapper <%= "border-top tmp-py-3 tmp-mt-3" if view.show_redemption_button?(billing_info_exists_without_errors) %>">
              <%= form_tag redeem_coupon_path, autocomplete: "off" do |f| %>
                <%= hidden_field_tag :id, account.display_login, :class => "js-account", :id => nil %>
                <%= hidden_field_tag :plan, view.default_plan(current_user, view.coupon), :class => "js-plan", :id => nil %>
                <%= hidden_field_tag :code, view.coupon.code %>

                <% if view.show_redemption_button?(billing_info_exists_without_errors) %>
                  <div class="form-actions tmp-mt-3">
                    <%= render(
                      Primer::Beta::Button.new(
                        type: :submit,
                        size: :medium,
                        scheme: :primary,
                        block: true,
                        classes: "btn btn-primary js-redeem-button",
                        data: {
                          disable_with: "Applying coupon…"
                        })
                      ) { "Apply coupon" }
                    %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
    <% else %>
      <div class="setup-wrapper">
        <%= render "coupons/coupon_header", view: view %>

        <div class="setup-main">
          <div class="setup-form-container">
            <div class="setup-form">
              <%= render :partial => "coupons/login_or_create_user" %>

              <div class="setup-info-module tmp-mt-4">
                <%= render :partial => "coupons/redeem_faqs" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
