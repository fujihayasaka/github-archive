<%
  page_path = wiki_page_path(page)
  is_current_page = request.fullpath == page_path
  content = wiki_data(page, "page") if is_current_page
  details_octicon = is_current_page ? details_octicons[:current] : details_octicons[:non_current]
  table_of_contents_id = "#{page.to_param}-table-of-contents"
%>
<div class="js-wiki-sidebar-page-container">
  <div class="d-flex flex-items-start">
    <%= render Primer::Beta::Button.new(
      aria: {
        label: "Structure for #{page.title}",
        expanded: is_current_page,
        controls: table_of_contents_id,
      },
      scheme: :invisible,
      classes: "p-2 mt-n1 mb-n1 ml-n1 btn btn-octicon js-wiki-sidebar-toc-toggle-chevron-button #{'v-hidden' if is_current_page && (content.toc.nil? || content.toc.empty?)}",
    ) do %>
        <%
          # don't recreate details octicons and spinner on every page entry.
          # these are created once in _pages_partial and passed in to reduce render time
        %>
        <%= spinner %>
        <%= details_octicon %>
    <% end %>
    <%= render Primer::Beta::Link.new(href: page_path, classes: "Truncate flex-1 py-1 text-bold") do %>
      <div class="Truncate-text">
        <%= page.title %>
      </div>
    <% end %>
  </div>

  <div id="<%= table_of_contents_id %>" class="<%= "d-none" unless is_current_page %> js-wiki-sidebar-toc-container">
    <% if is_current_page %>
      <%= render partial: "wiki/toc", locals: { page: page, content: content }  %>
    <% else %>
      <%= render Primer::Alpha::IncludeFragment.new(classes: "js-wiki-sidebar-toc-fragment", loading: "lazy", src: wiki_toc_url(current_repository.owner, current_repository, page)) do %>
      <% end %>
    <% end %>
  </div>
</div>
