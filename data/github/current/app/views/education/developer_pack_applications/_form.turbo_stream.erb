<turbo-stream action="update" target="dev-pack-form">
  <template>
    <%= render Billing::Settings::Education::DeveloperPackApplicationFormComponent.new(
      form_errors:,
      form_values:,
      user:,
      suggested_schools:,
    ) %>
  </template>
</turbo-stream>

<% if form_errors.present? %>
  <%
    error_messages = form_errors.values.flatten.compact.uniq.join(", ")
    full_message = "Your application cannot be reviewed until you fix the following: #{error_messages}"
  %>
  <turbo-stream action="update" target="js-global-screen-reader-notice-assertive">
    <template>
      <%= full_message %>
    </template>
  </turbo-stream>
<% end %>
