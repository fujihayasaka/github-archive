<%
  selected_repo_nwo = selected.try(:name_with_display_owner)
  repository_list_params = params.slice(:expand, :range).permit!
  repository_list_src = \
    compare_repository_list_path(
      repository_list_params.merge(
        repository: comparison.repo,
        user_id: comparison.repo.owner,
        type: type,
        selected: selected_repo_nwo,
      )
    )
%>

<details class="select-menu fork-suggester details-reset details-overlay hx_rsm">
  <%= render Primer::Beta::Button.new(tag: :summary, size: :small, classes: "btn select-menu-button") do %>
    <i><%= type %> repository:</i>
    <span class="css-truncate css-truncate-target" data-menu-button><%= selected_repo_nwo %></span>
  <% end %>

  <details-menu class="select-menu-modal position-absolute" style="z-index: 99;" data-pjax src="<%= repository_list_src %>" preload><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
    <%= render Primer::Alpha::IncludeFragment.new do %>
      <div class="select-menu-blankslate select-menu-error" style="text-wrap: balance;">
        Failed to load repositories. Confirm that selected <%= type %> ref is valid, then try again.
      </div>
      <div class="select-menu-loading-overlay" aria-busy="true">
        <%= render(Primer::Beta::Spinner.new(my: 6, mx: :auto, display: :block)) %>
      </div>
    <% end %>
  </details-menu>
</details>
