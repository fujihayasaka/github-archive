<% @settings_profile_url = settings_org_profile_url(@organization)%>
<% content_for :header do %>
  Switch to the GitHub Customer Agreement
<% end %>

<%= render(Mail::HeaderTitleComponent.new(title: "Switch to the GitHub Customer Agreement for your Enterprise account", avatar: @organization)) %>
<%= render(Mail::SpacerComponent.new) %>

<p>
  Hello there!
</p>
<p>
  We notice that <%= @display_login %> is currently under the Standard Terms of Service. As an account using the GitHub Enterprise plan, we kindly ask you to review and accept the GitHub Customer Agreement.
</p>

<p>
  To accept the GitHub Customer Agreement:
</p>

<ol class="ml-6" style="text-align: left" type="1">
  <li>Navigate to your organization's <strong>Settings</strong>. Under <strong>General</strong>, scroll to the "Terms of Service" section.</li>
  <li>Click <strong>Read the GitHub Customer Agreement</strong>.</li>
  <li>After you've read the GitHub Customer Agreement, click <strong>Sign GitHub customer terms</strong>.</li>
  <li>In the text field, enter the name of the company, non-profit, or group that owns the organization account. This is the entity that will enter into an agreement with GitHub.</li>
  <li>To agree to the GitHub Customer Agreement on behalf of your entity, click <strong>Accept terms</strong>.</li>
</ol>

<%= render(Mail::SpacerComponent.new) %>

<p>
  We appreciate your prompt attention to this matter.
</p>

<%= render(Mail::SpacerComponent.new) %>
<%= render(Mail::ButtonComponent.new(text: "Review GitHub customer terms", url: @settings_profile_url, classes: "btn-primary btn-large")) %>
<%= render(Mail::SpacerComponent.new) %>

<p class="email-body-subtext">
  <strong>Note:</strong> If you get a 404 page, make sure you’re signed in as an owner of <%= @display_login %>.
</p>

<% content_for :content_footer do %>
  Button not working? Paste the following link into your browser: <a href="<%= @settings_profile_url %>"><%= @settings_profile_url %></a>
<% end %>

<% content_for :footer_text do %>
  You're receiving this email because you're an owner of the <%= @display_login %> organization on GitHub.
<% end %>
