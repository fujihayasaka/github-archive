<% content_for :header do %>
  Enterprise teams limit reached for the <%= @business.name %> enterprise
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Enterprise teams limit reached", avatar: @business %>

<p>
  The <strong><%= @business.name %></strong> enterprise has
  reached the limit of <%= number_with_delimiter(@business.business_teams_limit) %> enterprise teams.
</p>

<p>
  <strong><%= @business.name %></strong> will not be able to add more enterprise teams while at the limit.
</p>

<p>
  Please delete any unnecessary enterprise teams to keep within the supported limit.
</p>

<p>
  Visit the <a href="https://gh.io/enterprise-limits">enterprise limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you’re an owner of the <strong><%= @business.name %></strong>
  enterprise on GitHub.
<% end %>
