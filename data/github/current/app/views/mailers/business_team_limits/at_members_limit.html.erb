<% content_for :header do %>
  Members limit reached for the <%= @team.name %> enterprise team
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Members limit reached", avatar: @team %>

<p>
  The <strong><%= @team.name %></strong> enterprise team has
  reached the limit of <%= number_with_delimiter(@team.members_limit) %> members.
</p>

<p>
  <strong><%= @team.name %></strong> will not be able to add more members while at the limit.
</p>

<p>
  Please remove any unnecessary members to keep within the supported limit.
</p>

<p>
  Visit the <a href="https://gh.io/enterprise-team-limits">enterprise team limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you can manage members of the <strong><%= @team.name %></strong>
  enterprise team on GitHub.
<% end %>
