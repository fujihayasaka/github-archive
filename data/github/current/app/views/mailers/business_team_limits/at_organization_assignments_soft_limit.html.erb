<% content_for :header do %>
  Organization assignments limit approaching for the <%= @team.name %> enterprise team
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Organization assignments limit approaching", avatar: @team %>

<p>
  The <strong><%= @team.name %></strong> enterprise team is
  approaching the limit of <%= number_with_delimiter(@team.organization_assignments_limit) %>
  organization assignments.
</p>

<p>
  The enterprise team currently has <%= number_with_delimiter(@organization_assignments_count) %>
  organization assignments.
</p>

<p>
  If the limit of <%= number_with_delimiter(@team.organization_assignments_limit) %> organization assignments
  is reached, <strong><%= @team.name %></strong> will not be able to assign more organizations.
</p>

<p>
  Visit the <a href="https://gh.io/enterprise-team-limits">enterprise team limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you can manage the <strong><%= @team.name %></strong>
  enterprise team on GitHub.
<% end %>
