<% content_for :header do %>
  Organization assignments limit reached for the <%= @team.name %> enterprise team
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Organization assignments limit reached", avatar: @team %>

<p>
  The <strong><%= @team.name %></strong> enterprise team has
  reached the limit of <%= number_with_delimiter(@team.organization_assignments_limit) %> organization assignments.
</p>

<p>
  <strong><%= @team.name %></strong> will not be able to assign more organizations while at the limit.
</p>

<p>
  Please remove any unnecessary organization assignments to keep within the supported limit.
</p>

<p>
  Visit the <a href="https://gh.io/enterprise-team-limits">enterprise team limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you can manage the <strong><%= @team.name %></strong>
  enterprise team on GitHub.
<% end %>
