<p class="mb-3">
  You’ve been granted access to <%= Copilot::SPARK_NAME %> (public preview) by an administrator of the <%= link_to @organization_login, user_url(@organization_login) %> organization.
</p>

<%= render(Mail::ButtonComponent.new(
  text: "Get started with #{Copilot::SPARK_NAME} now",
  url: Copilot::SPARK_DASHBOARD_URL,
  classes: "btn-primary btn-large"
)) %>

<%= render(Mail::SpacerComponent.new) %>

<p class="mb-3">
  To find out more about <%= Copilot::SPARK_NAME %>, head to the <%= link_to "GitHub Docs", Copilot::SPARK_DOCS_URL %>.
</p>

<% content_for :footer_text do %>
  <p>
    You are receiving this because you are the owner of the <%= link_to "@#{@user_login}", user_url(@user_login) %> account, and an administrator has granted you access to <%= Copilot::SPARK_NAME %>.
  </p>
<% end %>
