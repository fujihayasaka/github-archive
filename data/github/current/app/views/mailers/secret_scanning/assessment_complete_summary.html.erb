<%= render(SecretScanning::Mailers::LayoutComponent.new(
  title: safe_join([
    @title,
    link_to(@owner_name, GitHub.url + @assessment_path)
  ], " "),
  icon: @icon,
  )) do |layout| %>
  <%= layout.with_header_text do %>
    <%= @header_text %>
  <% end %>

  <% layout.with_main_section do %>
    <%= render(Mail::ContainerComponent.new) do %>
      GitHub has completed a scan for secrets exposed across your organization.
      <%= render(Mail::SpacerComponent.new) %>
      Secrets can be discovered by anyone with read access to your repository, putting your organization at risk. You should remediate any secret exposures immediately and put prevention mechanisms in place, like <%= link_to "push protection", GitHub.help_url + "/code-security/secret-scanning/introduction/about-push-protection" %>, to prevent exposed secrets in the future.
      <%= render(Mail::SpacerComponent.new) %>
      <%= link_to "Learn more about secret scanning", GitHub.help_url + "/code-security/secret-scanning/introduction/about-secret-scanning" %>
      <%= render(Mail::SpacerComponent.new) %>
      <%= render(Mail::ButtonComponent.new(
        text: "View scan results",
        url: GitHub.url + @assessment_path,
        classes: "btn-primary btn-large")) %>
    <% end %>
  <% end %>
  <% layout.with_footer_text do %>
    <p><%= @footer_text %></p>
  <% end %>
<% end %>
