<%= render(SecretScanning::Mailers::LayoutComponent.new(
  title: "Your personal access token has been revoked",
  icon: "token-scanning.png",
  )) do |layout| %>
  <% layout.with_header_text do %>
    Your GitHub personal access token has been revoked
  <% end %>
  <% layout.with_subheader_text do %>
    <p>
      A recent scan found your GitHub Personal Access Token
      <% if @token_name.present? %>
        ("<b><%= @token_name %></b>")
      <% end %>
      <% if @alert_url.present? # @alert_url is present when the recipient of this email has access to the alert %>
      in
      <% else %>
      in a private repository.
      <% end %>
      <% if @url.present? %>
        <a href="<%= @url %>" style="text-decoration: underline;"><%= @url_text %></a>.
      <% end %>
      A developer in that repository has <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", test_selector: "reporting-docs-link", href: "#{GitHub.help_url}/enterprise-cloud@latest/code-security/secret-scanning/managing-alerts-from-secret-scanning/resolving-alerts#reporting-a-leaked-secret")) { "reported this compromised secret" } %> to GitHub from a secret scanning alert. To protect your data from unauthorized access, GitHub has revoked this token. It can no longer be used to authenticate to GitHub.
    </p>
  <% end %>
  <% layout.with_main_section do %>
    <%= render(SecretScanning::Mailers::NextStepsForRevokeComponent.new(alert_url: @alert_url)) %>
  <% end %>
  <% layout.with_footer_text do %>
    <p>You are receiving this email because your GitHub personal access token was found by GitHub and revoked.</p>
  <% end %>
<% end %>
