<p><a href="<%= @message.url_user_with_tracking_params %>" class="user-mention"><%= @message.comment.mention_display_login %></a> pushed <%= @message.commits.size %> <%= "commit".pluralize(@message.commits.size) %>.</p>

<%- if @message.commits.any? -%>
<ul>
<%- @message.commits.each do |commit| %>
  <li><%= link_to commit.abbreviated_oid, @message.url_commit_with_tracking_params(base_url + commit_path(commit.oid, @message.repository)), :class => "commit-link" %>  <%= commit.short_message %></li>
<%- end %>
</ul>
<%- end -%>

<%= @message.footer_html %>
<%= @message.json_ld_html %>
