<%- if alert = @message.dependency_update_alert -%>
  <%- severity = alert.vulnerability.severity.humanize -%>
  <h4>
    This automated pull request fixes a
    <a href="<%= @message.url_open_with_tracking_params(alert.permalink, "pr_security_vulnerability_click") %>">security vulnerability</a> (<%= severity.downcase %> severity).
  </h4>

  <p>
    <a href="<%= @message.url_dependabot_help_with_tracking_params %>" target="_blank">Learn more about Dependabot security updates</a>.
  </p>
  <% unless @comment.body_html.empty? %><hr><% end %>
<%- end -%>
<%= @comment.body_html(context: { for_email: true }) %>

<hr>

<h4>You can view, comment on, or merge this pull request online at:</h4>
<p>&nbsp;&nbsp;<a href='<%= @message.url_open_with_tracking_params(@comment.permalink, "pr_open_click") %>'><%= @comment.permalink %></a></p>

<h4>Commit Summary</h4>
<ul>
<%- @comment.changed_commits.each do |commit| -%>
  <li><a href="<%= @message.url_open_with_tracking_params("#{@comment.permalink}/commits/#{commit.oid}", "pr_commit_click") %>" class="commit-link"><%= commit.abbreviated_oid %></a>  <%= commit.short_message %></li>
<%- end -%>
</ul>

<h4 style="display: inline-block">File Changes </h4> <p style="display: inline-block">(<a href="<%= @message.url_open_with_tracking_params("#{@comment.permalink}/files", "pr_files_click") %>"><%= @comment.historical_comparison.diffs.count %>&nbsp;<%= "file".pluralize(@comment.historical_comparison.diffs.count) %></a>)</p>
<ul>
<%- @comment.historical_comparison.diffs.each do |diff| -%>
  <li>
    <strong><%= diff.status %></strong>
    <a href="<%= @message.url_open_with_tracking_params("#{@comment.permalink}/files##{diff_file_anchor(diff.path)}", "pr_file_click") %>"><%= diff.path %></a>
    (<%= diff.changes %>)
  </li>
<%- end -%>
</ul>

<h4>Patch Links:</h4>
<ul>
  <li><a href='<%= @message.url_open_with_tracking_params("#{@comment.permalink}.patch", "pr_patch_click") %>'><%= @comment.permalink %>.patch</a></li>
  <li><a href='<%= @message.url_open_with_tracking_params("#{@comment.permalink}.diff", "pr_diff_click") %>'><%= @comment.permalink %>.diff</a></li>
</ul>

<%= @message.footer_html %>
<%= @message.json_ld_html %>
