<%- if alert = @message.dependency_update_alert -%>
<%- severity = alert.vulnerability.severity.humanize -%>
This automated pull request fixes a security vulnerability (<%= severity.downcase %> severity):
<%= @message.url_open_with_tracking_params(alert.permalink, "pr_security_vulnerability_click") %>

Learn more about Dependabot security updates:
<%= @message.url_dependabot_help_with_tracking_params %>

--

<%- end -%>
<%= @comment.body -%>

You can view, comment on, or merge this pull request online at:

  <%= @message.url_open_with_tracking_params(@comment.permalink, "pr_open_click") %>

-- Commit Summary --

<%- @comment.changed_commits.each do |commit| -%>
  * <%= commit.short_message %>
<%- end -%>

-- File Changes --

<%- @comment.historical_comparison.diffs.each do |diff| -%>
    <%= diff.status -%> <%= diff.path -%> (<%= diff.changes -%>)
<%- end -%>

-- Patch Links --

<%= @message.url_open_with_tracking_params("#{@comment.permalink}.patch", "pr_patch_click") %>
<%= @message.url_open_with_tracking_params("#{@comment.permalink}.diff", "pr_diff_click") %>

<%= @message.footer %>
