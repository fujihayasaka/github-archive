<%= render(SecretScanning::Mailers::LayoutComponent.new(
  title: safe_join([
    @title,
    link_to(@owner_name, GitHub.url + @assessment_path)
  ], " "),
  icon: @icon,
  )) do |layout| %>
  <%= layout.with_header_text do %>
    <%= @header_text %>
  <% end %>

  <% layout.with_main_section do %>
    <%= render(Mail::ContainerComponent.new) do %>
      GitHub has completed a code security risk assessment for your organization.
      <%= render(Mail::SpacerComponent.new) %>
      <% if @has_vulnerabilities %>
        Vulnerabilities in your code can be exploited by attackers to compromise your systems and data, putting your organization at risk. You should remediate critical and high severity vulnerabilities immediately. View your results to take action.
      <% else %>
        No vulnerabilities were found. Enable <%= link_to "code scanning", GitHub.help_url + "/code-security/code-scanning/introduction-to-code-scanning/about-code-scanning" %> to continuously monitor your code for vulnerabilities in future pull requests.
      <% end %>
      <%= render(Mail::SpacerComponent.new) %>
      <%= link_to "Learn more about code scanning", GitHub.help_url + "/code-security/code-scanning/introduction-to-code-scanning/about-code-scanning" %>
      <%= render(Mail::SpacerComponent.new) %>
      <%= render(Mail::ButtonComponent.new(
        text: @has_vulnerabilities ? "View scan results" : "Enable Code Security",
        url: GitHub.url + @assessment_path,
        classes: "btn-primary btn-large")) %>
    <% end %>
  <% end %>
  <% layout.with_footer_text do %>
    <p><%= @footer_text %></p>
  <% end %>
<% end %>
