<% content_for :header do %>
  Teams limit reached for the <%= @org.safe_profile_name %> organization
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Teams limit reached", avatar: @org %>

<p>
  The <strong><%= @org.safe_profile_name %></strong> organization has
  reached the limit of <%= number_with_delimiter(@org.teams_limit) %> teams.
</p>

<p>
  <strong><%= @org.safe_profile_name %></strong> will not be able to add more teams while at the limit.
</p>

<p>
  Please remove any unnecessary teams to keep within the supported limit.
</p>

<p>
  Visit the <a href="https://gh.io/organization-limits">organization limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you’re an owner of the <strong><%= @org.safe_profile_name %></strong>
  organization on GitHub.
<% end %>
