<% content_for :header do %>
  Members limit approaching for the <%= @org.safe_profile_name %> organization
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Members limit approaching", avatar: @org %>

<p>
  The <strong><%= @org.safe_profile_name %></strong> organization is
  approaching the limit of <%= number_with_delimiter(@org.members_limit) %>
  members in the organization.
</p>

<p>
  The organization currently has <%= number_with_delimiter(@members_count) %>
  members.
</p>

<p>
  If the limit of <%= number_with_delimiter(@org.members_limit) %> members
  is reached, <strong><%= @org.safe_profile_name %></strong> will not be able to add more members.
</p>

<p>
  Visit the <a href="https://gh.io/organization-limits">organization limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you’re an owner of the <strong><%= @org.safe_profile_name %></strong>
  organization on GitHub.
<% end %>
