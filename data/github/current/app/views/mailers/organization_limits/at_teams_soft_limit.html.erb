<% content_for :header do %>
  Teams limit approaching for the <%= @org.safe_profile_name %> organization
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Teams limit approaching", avatar: @org %>

<p>
  The <strong><%= @org.safe_profile_name %></strong> organization is
  approaching the limit of <%= number_with_delimiter(@org.teams_limit) %>
  teams in the organization.
</p>

<p>
  The organization currently has <%= number_with_delimiter(@teams_count) %>
  teams.
</p>

<p>
  If the limit of <%= number_with_delimiter(@org.teams_limit) %> teams
  is reached, <strong><%= @org.safe_profile_name %></strong> will not be able to add more teams.
</p>

<p>
  Visit the <a href="https://gh.io/organization-limits">organization limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you’re an owner of the <strong><%= @org.safe_profile_name %></strong>
  organization on GitHub.
<% end %>
