<% content_for :header do %>
  Here's your GitHub launch code!
<% end %>

<img
  src="<%= mailer_static_asset_path("images/email/signup/launch-rocket.png") %>"
  alt="a rocket"
  width="110"
>

<%= render(Mail::SpacerComponent.new) %>

<span class="sans-serif f4 text-center" style="text-align: center;">
  Continue signing up for GitHub by entering the code below:
</span>

<%= render(Mail::SpacerComponent.new) %>

<span class="f00-light text-gray-dark sans-serif text-semibold"><%= @verification_token %></span>

<%= render(Mail::SpacerComponent.new) %>

<%= render(
  Mail::ButtonComponent.new(
    text: "Open GitHub",
    url: @verification_page_url,
    classes: "btn-primary btn-large"
  )
) %>

<% content_for :content_footer do %>
  <%= render(Mail::RowComponent.new) do %>
    <%= render(Mail::ColumnComponent.new) do %>
      Not able to enter the code? Paste the following link into your browser: <br>
      <a href="<%= @fallback_url.to_s %>" class="wb-break-all"><%= @fallback_url %></a>
    <% end %>
  <% end %>
<% end %>

<% content_for :footer_text do %>
  You’re receiving this email because you recently created a new GitHub account. If this wasn’t you, please ignore this email.
<% end %>
