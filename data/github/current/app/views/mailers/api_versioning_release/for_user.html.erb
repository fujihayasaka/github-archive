<% content_for :header do %>
  A new GitHub REST API version is available: <%= @latest_version %>
<% end %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      Hi <strong><%= @user.display_login %></strong>,
    </p>

    <p>
      A new version of the GitHub REST API, <strong><%= @latest_version %></strong>, is now available.
    </p>

    <p>
    We recommend updating to the latest version by sending the header <strong><code>X-GitHub-Api-Version: <%= @latest_version %></code></strong> with every request. You can learn more and find migration guidance in the <a href="<%= @changelog_url %>">API versioning documentation</a>.
    </p>

    <% if @deprecating_versions.present? %>
      <%= render(Mail::SpacerComponent.new) %>

      <p>
        The previous API versions will be retired on the following dates:
      </p>

      <ul style="margin-top: 0; padding-left: 24px;">
        <% @deprecating_versions.each do |version, deprecation_date| %>
          <li>
            <strong><%= version %></strong> — retires on <%= deprecation_date %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= render(Mail::SpacerComponent.new) %>

    <%= render(Mail::ContainerComponent.new) do %>
      <%= render(
        Mail::ButtonComponent.new(
          text: "Review migration guide",
          url: @changelog_url,
          classes: "btn-primary btn-large"
        )
      ) %>
    <% end %>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      If you've already upgraded to <%= @latest_version %> then please disregard this email.
    </p>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      Thank you,<br>
      The GitHub API Team
    </p>
  <% end %>
<% end %>

<% content_for :content_footer do %>
  Button not working? Paste the following link into your browser: <a href="<%= @changelog_url %>"><%= @changelog_url %></a>
<% end %>

<% content_for :footer_text do %>
  You're receiving this email because you have an account that uses the GitHub REST API.
<% end %>
