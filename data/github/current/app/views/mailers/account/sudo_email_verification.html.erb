<% content_for :header do %>
  Please verify your identity, <strong><%= @user.display_login %></strong>
<% end %>

<%= render(Mail::RowComponent.new) do %>
  <p>Here is your GitHub sudo authentication code:</p>

  <%= render(Mail::ContainerComponent.new) do %>
    <span style="font-size: 24px; font-family: monospace; letter-spacing: 4px; display: inline-block;">
    <%= @otp %>
    </span>
  <% end %>
  <%= render(Mail::SpacerComponent.new) %>

  <p>This code is valid for <strong>15 minutes</strong> and can only be used once.</p>
  <p><strong>Please don't share this code with anyone:</strong> we'll never ask for it on the phone or via email.</p>
  <p>Thanks,<br>
  The GitHub Team
  </p>
<% end %>

<% content_for :content_footer do %>
  <%= render(Mail::RowComponent.new) do %>
    You're receiving this email because a verification code was requested for your GitHub account. If this wasn't you, please ignore this email.
  <% end %>
<% end %>
