<% if @created_at.present? %>
  <% content_for :header do %>
    Social identity recently added
  <% end %>

  <%= render(Mail::RowComponent.new) do %>
    <%= render(Mail::ColumnComponent.new) do %>
      <p>
        Hey <%= @user.display_login %>,
      </p>
      <p>
        A new <strong><%= @provider %></strong> social identity was recently linked to your GitHub account on <strong><%= @created_at.strftime("%B %d, %Y") %></strong> from the email address <strong><%= @email %></strong>.
      </p>
      <p>
        This means you can now sign in to GitHub using the <strong><%= @provider %></strong> account associated with that email address.
      </p>
      <p>
        To see this and other security events for your account, visit <a href="<%= settings_user_audit_log_url %>">your account security audit log</a>.
      </p>
      <p>
        If you did not initiate this action or believe your account has been compromised, it is a good idea to review your active sessions and all passkeys associated with your account or consider enabling two-factor authentication.
      </p>
      <p>
        Thanks,<br>
        The GitHub Team
      </p>
    <% end %>
  <% end %>

  <% content_for :footer_text do %>
    You're receiving this email because a social identity was added to your account.
    If you have already received a notification about this action, please disregard this email.
  <% end %>
<% else %>
  <% content_for :header do %>
    Social identity added
  <% end %>

  <%= render(Mail::RowComponent.new) do %>
    <%= render(Mail::ColumnComponent.new) do %>
      <p>
        Hey <%= @user.display_login %>,
      </p>
      <p>
        A new <strong><%= @provider %></strong> social identity was just linked to your GitHub account from the email address <strong><%= @email %></strong>.
      </p>
      <p>
        This means you can now sign in to GitHub using the <strong><%= @provider %></strong> account associated with that email address.
      </p>
      <p>
        To see this and other security events for your account, visit <a href="<%= settings_user_audit_log_url %>">your account security audit log</a>.
      </p>
      <p>
        If you did not initiate this action or believe your account has been compromised, it is a good idea to review your active sessions and all passkeys associated with your account or consider enabling two-factor authentication.
      </p>
      <p>
        Thanks,<br>
        The GitHub Team
      </p>
    <% end %>
  <% end %>

  <% content_for :footer_text do %>
    You're receiving this email because a social identity was added to your account.
  <% end %>
<% end %>
