<% content_for :header do %>
    <%= @summary %>
<% end %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>Hello <strong>@<%= @sponsor %></strong>,</p>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      This is a friendly reminder that your current sponsorship invoice balance will expire and be reduced to $0.00 USD on <%= @zero_balance_date_formatted %>.
    </p>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      To avoid any disruption, please request a new invoice before <%= @zero_balance_date_formatted %>.
      If your account has insufficient funds, your recurring sponsorships may be canceled.
    </p>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      You can check your current balance in your <%= link_to "GitHub Sponsors dashboard", org_sponsoring_url(@sponsor) %>.
    </p>

    <a href="<%= @new_invoice_url %>">Create a new invoice</a> to refill your balance.

    <%= render(Mail::SpacerComponent.new) %>

    <p>
       Questions or need assistance refilling your balance? Please contact us at <%= link_to "support team", GitHub.support_url %>.
    </p>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      Thank you for supporting the open source community!
    </p>

    <p>
      The GitHub Sponsors Team
    </p>

  <% end %>
<% end %>
