<%= @subject %>

<%= @usage_report_header %>

<%= @usage_description %>

<%= @additional_usage_description%>

<% @metered_export_records.each_with_index do |metered_export_record, index| %>
  <% if @metered_export_records.size == 1 %>
    Download here: <%= metered_export_record.get_url %>
  <% else %>
    Download part <%= index + 1%>: <%= metered_export_record.get_url %>
  <% end %>
<% end %>

<% if @metered_export_records.size > 1 %>
  Your usage report was larger than 2 GB so the download has been split into parts.
<%end%>
