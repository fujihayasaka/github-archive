<% content_for :header do %>
  <%= @subject %>
<% end %>

<%= render Mail::HeaderTitleComponent.new(
  title: @usage_report_header,
  icon: @mail_icon,
  ) %>

<%= render(Mail::SpacerComponent.new) %>

<p>
  <%= @usage_description %>
</p>

<p>
  <%= @additional_usage_description%>
</p>

<%= render(Mail::SpacerComponent.new) %>

<% @metered_export_records.each_with_index do |metered_export_record, index| %>
  <% if @metered_export_records.size == 1 %>
    <%= render(Mail::ContainerComponent.new) do %>
      <%= render(
        Mail::ButtonComponent.new(
          text: "Download report",
          url: metered_export_record.get_url,
          classes: "btn-primary btn-large"
        )
      ) %>
    <% end %>
  <% else %>
    <%= render(Mail::SpacerComponent.new) %>
    <%= render(Mail::ContainerComponent.new) do %>
      <%= render(
        Mail::ButtonComponent.new(
          text: "Download part #{index + 1}",
          url: metered_export_record.get_url,
          classes: "btn-primary btn-large"
        )
      ) %>
    <% end %>
  <% end %>
<% end %>

<%= render(Mail::SpacerComponent.new) %>

<% if @metered_export_records.size > 1 %>
  <p>
    Your usage report was larger than 2 GB so the download has been split into parts.
  </p>
<% end %>

<% content_for :footer_text do %>
  <%= @footer_text %>
<% end %>
