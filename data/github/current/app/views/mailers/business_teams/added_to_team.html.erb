<% content_for :header do %>
  You've been added to the "<%= @team.name %>" team on the "<%= @business.safe_profile_name %>" enterprise
<% end %>

<%= render Mail::HeaderTitleComponent.new \
  title: "You are now a member of \"#{@team.name}\"",
  avatar: @business %>

<p>
  Hi <strong><%= @user.safe_profile_name %></strong>,
</p>

<p>
  This team has <%= pluralize(@members_count, "member") %>.
  It grants access to <%= pluralize(@org_count, "organization") %> and <%= pluralize(@repo_count, "repository") %> in the <%= @business.safe_profile_name %> enterprise.
</p>

<%= render(Mail::SpacerComponent.new) %>
<%= render(Mail::ContainerComponent.new) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "View team",
      url: @team_url,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>
<%= render(Mail::SpacerComponent.new) %>

<hr class="rule">

<p class="email-text-small email-text-gray">
  Button not working? Paste the following link into your browser:<br>
  <%= link_to @team_url, @team_url.to_s %>
</p>

<% content_for :footer_text do %>
  You are receiving this because you were added to an enterprise team on GitHub.
<% end %>
