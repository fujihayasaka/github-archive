<% content_for :header do %>
  The "<%= @team_name %>" team has been removed from <%= @org_count %> organizations
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Organization access removed via enterprise teams" %>

<p>
  Members of the <strong><%= @team_name %></strong> team will no longer have access to
  <strong><%= @org_count %></strong> organizations.
  If you believe this was a mistake, please contact your enterprise administrator.
</p>

<%= render(Mail::SpacerComponent.new) %>

<%= render(Mail::ContainerComponent.new) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "View team",
      url: @team_url,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>

<%= render(Mail::SpacerComponent.new) %>

<hr class="rule">

<p class="email-text-small email-text-gray">
  Button not working? Paste the following link into your browser:<br>
  <%= link_to @team_url, @team_url.to_s %>
</p>

<% content_for :footer_text do %>
  You are receiving this because you are a member of <%= @team_name %> or an owner of one of the affected organizations in the <%= @business.safe_profile_name %> enterprise.
<% end %>
