<% content_for :header do %>
  The "<%= @team_name %>" team has been removed from the "<%= @org_name %>" organization
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Organization access removed via enterprise teams" %>

<p>
  Members of this team will no longer have access to the <strong><%= @org_name %></strong> organization.
  If you believe this was a mistake, please contact your enterprise administrator.
</p>

<%= render(Mail::SpacerComponent.new) %>

<%= render(Mail::ContainerComponent.new) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "View organization",
      url: @org_url,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>

<%= render(Mail::SpacerComponent.new) %>

<hr class="rule">

<p class="email-text-small email-text-gray">
  Button not working? Paste the following link into your browser:<br>
  <%= link_to @org_url, @org_url.to_s %>
</p>

<% content_for :footer_text do %>
  You are receiving this because you are a member of <%= @team_name %> or an owner of <%= @org_name %> in the <%= @business.safe_profile_name %> enterprise.
<% end %>
