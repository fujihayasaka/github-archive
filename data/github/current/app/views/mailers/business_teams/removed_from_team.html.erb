<% content_for :header do %>
  <% if @team_destroyed %>
    The <%= @business.safe_profile_name %> enterprise team <%= @team_name %> has been deleted
  <% else %>
    You've been removed from the <%= @business.safe_profile_name %> enterprise team <%= @team_name %>
  <% end %>
<% end %>

<% if @team_destroyed %>
  The <%= @business.safe_profile_name %> enterprise team <%= @team_name %> has been deleted
  <%= render Mail::HeaderTitleComponent.new \
    title: "Deletion of the #{@business.safe_profile_name} enterprise team #{@team_name}",
    avatar: @business %>
<% else %>
  You've been removed from the <%= @business.safe_profile_name %> enterprise team <%= @team_name %>
  <%= render Mail::HeaderTitleComponent.new \
    title: "Removed from the #{@business.safe_profile_name} enterprise team #{@team_name}",
    avatar: @business %>
<% end %>

<p>
  Hi <strong><%= @user.safe_profile_name %></strong>,
</p>

<p>
  <% if @team_destroyed %>
    The <%= @business.safe_profile_name %> enterprise team <%= @team_name %> in which you were a member
    has been deleted on GitHub.
  <% else %>
    You've been removed from the <%= @business.safe_profile_name %> enterprise team <%= @team_name %>
    on GitHub.
  <% end %>
</p>

<% content_for :footer_text do %>
  You’re receiving this email because
  <% if @team_destroyed %>
    an enterprise team in which you were a member was deleted
  <% else %>
    you were removed from an enterprise team
  <% end %>
  on GitHub.
<% end %>
