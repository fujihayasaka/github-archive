<% content_for :header do %>
  The "<%= @team_name %>" team has been added to the "<%= @org_name %>" organization
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Organization access granted via enterprise teams" %>

<p>
  The <strong><%= @team_name %></strong> enterprise team has been added to the
  <strong><%= @org_name %></strong> organization<% if @actor %> by <strong><%= @actor.safe_profile_name %></strong><% end %>.
  <% if @member_count %>The team currently has <strong><%= @member_count %></strong> <%= "member".pluralize(@member_count) %>.<% end %>
</p>

<%= render(Mail::SpacerComponent.new) %>

<%= render(Mail::ContainerComponent.new) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "View organization",
      url: @org_url,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>

<%= render(Mail::SpacerComponent.new) %>

<hr class="rule">

<p class="email-text-small email-text-gray">
  Button not working? Paste the following link into your browser:<br>
  <%= link_to @org_url, @org_url.to_s %>
</p>

<% content_for :footer_text do %>
  You are receiving this because you are a member of <%= @team_name %> or an owner of <%= @org_name %> in the <%= @business.safe_profile_name %> enterprise.
<% end %>
