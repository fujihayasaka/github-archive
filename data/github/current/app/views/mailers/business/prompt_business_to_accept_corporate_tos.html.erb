<% @settings_url = settings_billing_tab_enterprise_url(@business, tab: :payment_information) %>
<% content_for :header do %>
  Switch to the GitHub Customer Agreement
<% end %>

<%= render(Mail::HeaderTitleComponent.new(title: "Switch to the GitHub Customer Agreement for your Enterprise account", avatar: @organization)) %>
<%= render(Mail::SpacerComponent.new) %>

<p>
  Hello there!
</p>
<p>
  We notice that the <%= @slug %> Enterprise account is currently under the Standard Terms of Service. As an account using the GitHub Enterprise plan, we kindly ask you to review and accept the GitHub Customer Agreement.
</p>

<p>
  To accept the GitHub Customer Agreement:
</p>

<ol class="ml-6" style="text-align: left" type="1">
  <li>Navigate to your Enterprise Account's <strong>Settings</strong>. Under <strong>Billing</strong>, click on the <strong>Payment information</strong> tab, and scroll to the "GitHub Customer Agreement" section.</li>
  <li>Read the GitHub Customer Agreement.</li>
  <li>After you've read the GitHub Customer Agreement, click <strong>Accept terms</strong>.</li>
</ol>

<%= render(Mail::SpacerComponent.new) %>

<p>
  We appreciate your prompt attention to this matter.
</p>

<%= render(Mail::SpacerComponent.new) %>
<%= render(Mail::ButtonComponent.new(text: "Review GitHub customer terms", url: @settings_url, classes: "btn-primary btn-large")) %>
<%= render(Mail::SpacerComponent.new) %>

<p class="email-body-subtext">
  <strong>Note:</strong> If you get a 404 page, make sure you’re signed in as an owner of <%= @slug %>.
</p>

<% content_for :content_footer do %>
  Button not working? Paste the following link into your browser: <a href="<%= @settings_url %>"><%= @settings_url %></a>
<% end %>

<% content_for :footer_text do %>
  You're receiving this email because you're an owner of the <%= @slug %> Enterprise account on GitHub.
<% end %>
