<% content_for :header do %>
    Verify your admin email for <%= @business.name %> trial.
<% end %>

<%= render Mail::HeaderTitleComponent.new \
  title: "Verify your admin email" %>

<p>
  Hi there!
</p>

<p>
  You're setting up a GitHub Enterprise trial for <strong><%= @business.name %></strong>.
  To complete the setup, please verify this admin email address.
</p>

<p style="background-color: #f8f9fa; padding: 20px; border-radius: 6px; text-align: center; font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;">
  <strong style="font-size: 24px; letter-spacing: 4px;"><%= @verification_code %></strong>
</p>

<p>
  Enter this 6-digit code in the verification form to continue with your enterprise trial setup.
</p>

<p>
  <strong>This code will expire in 2 hours.</strong>
</p>

<p>
  If you didn't request this verification, you can safely ignore this email.
</p>

<p>
  Thanks,<br>
  The GitHub Team
</p>
