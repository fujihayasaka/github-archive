<% content_for :header do %>
Your Enterprise trial account <%= @business.safe_profile_name %> will be deleted in <%= pluralize(@days_to_deletion, "day") %>
<% end %>

<%= render Mail::HeaderTitleComponent.new \
  title: "Your GitHub Enterprise trial will be deleted in #{pluralize(@days_to_deletion, "day")}", avatar: @business %>

<p>
  Hi <strong><%= @user.safe_profile_name %></strong>!
</p>


<p>
  Your GitHub Enterprise trial has ended.
</P>

<p>
  GitHub Enterprise trial accounts are automatically deleted <%= @restorable_period %> days after the trial period ends.
</p>

<p>
  On <%= @trial_deleted_at %>, your account, <strong><%= @business.safe_profile_name %></strong> will be deleted.
</p>

<p>
  To continue using GitHub Enterprise, manage your projects, and save all your past work, you will need to upgrade your account.
</p>

<% if @business.organizations.any? %>
  <p>
   Any organization associated with this enterprise trial accounts will also been deleted.
    <ul>
      <% @business.organizations.each do |org| %>
      <ul>
        <%= org.safe_profile_name %>
      </ul>
      <% end %>
    </ul>
  </p>
<% end %>
<br>
<%= render(Mail::ContainerComponent.new) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "Upgrade to GitHub Enterprise",
      url: email_link_with_tracking(url: @trial_billing_url, email_source: "ghec-trial-expired"),
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>
<br>
<p>
  <strong>Note:</strong> If you get a 404 page, make sure you’re signed in as an owner of
  <strong><%= @business.safe_profile_name %></strong>.
</p>

<p>
  Button not working? Paste the following link into your browser:<br>
  <a href="<%= email_link_with_tracking(url: @trial_billing_url, email_source: "ghec-trial-expired") %>"><%= email_link_with_tracking(url: @trial_billing_url, email_source: "ghec-trial-expired") %></a>
</p>

<% content_for :footer_text do %>
 You’re receiving this email because you're the owner of the <%= @business.safe_profile_name %> GitHub Enterprise trial account on GitHub.
<% end %>
