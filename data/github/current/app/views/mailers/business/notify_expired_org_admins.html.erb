<% content_for :header do %>
Your organization account <%= @organization.safe_profile_name %> will be deleted in <%= pluralize(@days_to_deletion, "day") %>
<% end %>

<%= render Mail::HeaderTitleComponent.new \
  title: "Your GitHub organization in GitHub Enterprise trial will be deleted in #{pluralize(@days_to_deletion, "day")}", avatar: @organization %>

<p>
  Hi <strong><%= @user.safe_profile_name %></strong>!
</p>


<p>
  Your GitHub Enterprise trial has ended.
</P>

<p>
  GitHub Enterprise trial accounts and organizations created during the trial are automatically deleted <%= @restorable_period %> days after the trial period ends.
</p>

<p>
  On <%= @trial_deleted_at %>, your account, <strong><%= @organization.safe_profile_name %></strong> will be deleted.
</p>

<p>
  To continue using <%= @organization.safe_profile_name%> upgrade to a paid GitHub Enterprise account or <a href="#{GitHub.help_url}/admin/managing-accounts-and-repositories/managing-organizations-in-your-enterprise/removing-organizations-from-your-enterprise#removing-an-organization-from-your-enterprise">remove your organization outside of the enterprise</a>.
</p>

<br>


<% content_for :footer_text do %>
 You’re receiving this email because you're the owner of the <%= @organization.safe_profile_name %> GitHub organization on GitHub.
<% end %>
