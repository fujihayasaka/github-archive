<% content_for :header do %>
  Your GitHub Enterprise trial <%= @business.slug %> has been deleted
<% end %>

<%= render Mail::HeaderTitleComponent.new \
  title: "Your GitHub Enterprise trial #{@business.slug} has been deleted", avatar: @business %>

<p>
  Hi <strong><%= @user.safe_profile_name %></strong>,
</p>

<p>
  GitHub Enterprise trial accounts are automatically deleted <%= @restorable_period %> days after the trial period ends.
  </p>

  <p>
  Your GitHub Enterprise trial, <%= @business.slug %> has been deleted.
</p>

<% if @business.organizations.any? %>
  <p>
    Any organization associated with this enterprise trial accounts has also been deleted.
    <ul>
      <% @business.organizations.each do |org| %>
      <ul>
        <%= org.safe_profile_name %>
      </ul>
      <% end %>
    </ul>
  </p>
  <br>
<% end %>

<p>
Thanks for trying out GitHub Enterprise. If you'd like to try GitHub Enterprise again, you're welcome to create a new trial at any time.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you're the owner of the <%= @business.slug %> GitHub Enterprise trial account on GitHub.
<% end %>
