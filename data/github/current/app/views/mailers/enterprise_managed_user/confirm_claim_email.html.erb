<% content_for :header do %>
  Verify your email address
<% end %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    To verify your GitHub Enterprise Managed User's account email, we need to verify your email address: <strong><%= @email.email %></strong>.
  <% end %>
<% end %>

<%= render(Mail::SpacerComponent.new) %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    Use the following code in your GitHub email settings page to verify your email: <strong><%= @code %></strong>.
  <% end %>
<% end %>

<% content_for :footer_text do %>
  You’re receiving this email because you have an Enterprise Managed GitHub account. If this wasn’t you, please ignore this email.
<% end %>
