<% content_for :header do %>
  Your <strong><%= @slug %></strong> enterprise account is being set up.
<% end %>

<div class="org-content-header">
  <%= render(Primer::Beta::Octicon.new(:globe, size: :medium)) %>
</div>
<h3>
  <strong>We are setting up your account and will email you when it's ready. </strong>
</h3>

<hr class="rule">

<p style="text-align:center">
  Thank you for signing up for our data residency trial. We're currently setting up your enterprise account with data residency in <%= @data_residence %>.
</p>

<h4>What to expect next:</h4>
<%= render(Mail::SpacerComponent.new) %>

<ol class="ml-6" style="text-align: left" type="1">
  <li>
    <div>
      <strong>Create the setup user</strong><br>
      <p class="color-fg-muted">The setup user is used to configure authentication and provisioning</p>
    </div>
  </li>

  <li>
    <p>
      <strong>Configure authentication</strong><br>
      Configure how your members will authenticate
    </p>
  </li>

  <li>
    <p>
      <strong>Configure provisioning</strong><br>
      Configure how your IdP will create managed user accounts on GitHub
    </p>
  </li>

  <li>
    <p>
      <strong>Enjoy the trial</strong><br>
      Your data residency trial will be ready to use
    </p>
  </li>
</ol>

<p style="text-align:center">
This may take up to a few hours to complete. You can continue to use GitHub in the meantime.
</p>

<%= render(Mail::ContainerComponent.new) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "Learn about GitHub Enterprise",
      url: @docs_link,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>

<% content_for :footer_text do %>
    You're receiving this email because you requested an enterprise account, <strong><%= @slug %></strong>, to be created on GitHub.
<% end %>
