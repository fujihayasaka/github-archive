<% content_for :header do %>
  We couldn’t create your enterprise account trial <strong><%= @slug %></strong>.
<% end %>

<div class="org-content-header">
  <%= render(Primer::Beta::Octicon.new(:alert, size: :medium)) %>
</div>
<h3>
  <strong>Your data residency trial setup did not complete.</strong>
</h3>

<hr class="rule">

<p style="text-align:center">
  We were not able to create your enterprise account with data residency in
  <%= @data_residence %>. Please try again. <%= "The subdomain you chose is already taken." if @subdomain_taken %>
</p>

<h4>What you can do next:</h4>
<%= render(Mail::SpacerComponent.new) %>

<p style="text-align:left">
  Return to the GitHub Enterprise Cloud with data residency trial signup page and try creating your enterprise again<%= ", choosing a different subdomain" if @subdomain_taken %>.
</p>

<%= render(Mail::SpacerComponent.new) %>

<% button_text = "Try again#{ " with a different subdomain" if @subdomain_taken }" %>

<%= render(
  Mail::ButtonComponent.new(
    text: button_text,
    url: @signup_link,
    classes: "btn-primary btn-large"
  )
) %>

<%= render(Mail::SpacerComponent.new) %>

<p style="text-align:center">
  Your tenant has not been created yet. You can safely try the signup  process again at any time. If you continue to see this error after trying again, contact GitHub Support for help completing your trial setup.
</p>

<% content_for :footer_text do %>
  You're receiving this email because you requested an enterprise account,
  <strong><%= @slug %></strong>, to be created on GitHub, but we were unable
  to complete the setup.
<% end %>
