<% if @credentials_deleted %>
<% content_for :header do %>
  All your keys, tokens, and their associated SSO authorizations in <%= @enterprise_name %> have been deleted
<% end %>
<% else %>
<% content_for :header do %>
  All SSO authorizations for your keys and tokens that have access to <%= @enterprise_name %> have been revoked
<% end %>
<% end %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      <strong>
        <% if @credentials_deleted %>
          An administrator has deleted all your user keys, tokens, and their associated SSO authorizations in <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: @enterprise_url)) { @enterprise_name } %>
        <% else %>
          An administrator has revoked all your SSO authorizations for user keys and tokens that have access to <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: @enterprise_url)) { @enterprise_name } %>
        <% end %>
      </strong>
    </p>

    <% if @revoked_counts.values.any? { |v| v > 0 } %>
      <ul>
        <% if @revoked_counts[:classic_pats].to_i > 0 %>
          <li><%= pluralize(@revoked_counts[:classic_pats], "personal access token") %> (classic)</li>
        <% end %>
        <% if @revoked_counts[:fine_grained_pats].to_i > 0 %>
          <li><%= pluralize(@revoked_counts[:fine_grained_pats], "fine-grained personal access token") %></li>
        <% end %>
        <% if @revoked_counts[:oauth_app_tokens].to_i > 0 %>
          <li><%= pluralize(@revoked_counts[:oauth_app_tokens], "GitHub App and OAuth app user access token") %></li>
        <% end %>
        <% if @revoked_counts[:ssh_keys].to_i > 0 %>
          <li><%= pluralize(@revoked_counts[:ssh_keys], "SSH key") %></li>
        <% end %>
      </ul>
    <% end %>

    <% if @credentials_deleted %>
      <p>
        This was a permanent action, and you will need to generate new tokens, SSH keys, SSO authorizations, and organization access granted by fine-grained personal access tokens (if needed).
      </p>
    <% else %>
      <p>
        This affected all user SSH keys and tokens that had access to organization-level resources where SSO was enforced. This was a permanent action, and you will not be able to reauthorize revoked tokens and keys.
      </p>
    <% end %>

    <p>
      To view a list of all your individual user keys and tokens that were affected, you can <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: @security_log_url)) { "review your account security log" } %>.
    </p>

    <%= render(Mail::ButtonComponent.new(
      text: "Review your security log",
      url: @security_log_url,
      classes: "btn-primary btn-large tmp-mt-4",
    )) %>
  <% end %>
<% end %>

<% content_for :footer_text do %>
  You are receiving this because you had user keys and tokens with access to organizations belonging to <%= @enterprise_name %>.
<% end %>
