<% content_for :header do %>
  Action needed: GitHub App installation token was revoked
<% end %>
<%= render(Mail::HeaderTitleComponent.new(
  title: @title,
  icon: "security-alert.png")
) %>
<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      An installation access token for your GitHub App "<%= @app_name %>" was submitted to <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/rest/credentials/revoke#revoke-a-list-of-credentials")) { "GitHub's credential revocation API" } %>.
    </p>
    <p>
      To prevent unauthorized access, we have <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/authentication/keeping-your-account-and-data-secure/token-expiration-and-revocation")) { "revoked this token" } %> to ensure that it can no longer be used to authenticate to GitHub.
    </p>
    <p>
      To encourage reports and ensure that exposed tokens can be quickly and easily revoked, we do not require authentication for submissions. As a result, GitHub is unable to provide further information about the source of the reported token.
    </p>
    <p>
      If you did not submit this token to GitHub's credential revocation API and you believe that your token was exposed, you should review <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/authentication/keeping-your-account-and-data-secure/reviewing-your-authorized-integrations#reviewing-your-authorized-github-apps")) { "any unauthorized applications" } %> and remove any you don't recognize.
      You can also <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/authentication/keeping-your-account-and-data-secure/reviewing-your-security-log")) { "review your security log" } %> to ensure that no malicious activity has occurred.
    </p>
    <p>
      To restore access, you may need to <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/apps/creating-github-apps/authenticating-with-a-github-app/authenticating-as-a-github-app-installation")) { "generate a new installation token" } %>. You can view your GitHub Apps in your <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: @developer_apps_url)) { "developer settings" } %>.
    </p>
    <%= render(Mail::ButtonComponent.new(
      text: "View your GitHub Apps",
      url: @developer_apps_url,
      classes: "btn-primary btn-large tmp-mt-4",
    )) %>
  <% end %>
<% end %>
<% content_for :footer_text do %>
  You're receiving this email because an installation token for a GitHub App you own was revoked by GitHub.
<% end %>
