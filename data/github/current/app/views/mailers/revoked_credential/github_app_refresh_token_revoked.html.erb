<% content_for :header do %>
  Action needed: GitHub App access was revoked
<% end %>
<%= render(Mail::HeaderTitleComponent.new(
  title: @title,
  icon: "security-alert.png")
) %>
<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      A refresh token for the GitHub App "<%= @app_name %>", that is linked to your GitHub account - @<%= @user.display_login %>, was submitted to <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/rest/credentials/revoke#revoke-a-list-of-credentials")) { "GitHub's credential revocation API" } %>.
    </p>
    <p>
      To protect your data from unauthorized access we have <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/authentication/keeping-your-account-and-data-secure/token-expiration-and-revocation")) { "revoked this token" } %> to ensure that it can no longer be used to authenticate to GitHub on your behalf.
    </p>
    <p>
      To encourage reports and ensure that exposed tokens can be quickly and easily revoked, we do not require authentication for submissions. As a result, GitHub is unable to provide further information about the source of the reported token.
    </p>
    <p>
      If you did not submit this token to GitHub's credential revocation API and you believe that your token was exposed, you can <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: settings_user_audit_log_url)) { "review your account security logs" } %> to ensure that unauthorized activity has not occurred using this token.
      To learn more about reviewing your account security logs, visit <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/authentication/keeping-your-account-and-data-secure/reviewing-your-security-log")) { "our help docs" } %>.
    </p>
    <p>
      To restore access to this application, you will need to re-authorize by logging in to the application again. You can view your authorized GitHub Apps in your <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: @authorized_apps_url)) { "GitHub settings" } %>.
    </p>
    <%= render(Mail::ButtonComponent.new(
      text: "View authorized applications",
      url: @authorized_apps_url,
      classes: "btn-primary btn-large tmp-mt-4",
    )) %>
  <% end %>
<% end %>
<% content_for :footer_text do %>
  You're receiving this email because your GitHub App access was revoked by GitHub.
<% end %>
