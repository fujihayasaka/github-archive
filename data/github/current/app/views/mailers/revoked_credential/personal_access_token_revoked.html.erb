<% content_for :header do %>
  Action needed: <%= @pat_type.capitalize %> was revoked
<% end %>

<%= render(Mail::HeaderTitleComponent.new(
  title: @title,
  icon: "security-alert.png")
) %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      A <%= @pat_type %>, "<%= @key_name %>", that is linked to your GitHub account - @<%= @user.display_login %>, was submitted to <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/rest/credentials/revoke#revoke-a-list-of-credentials")) { "GitHub's credential revocation API" } %>.
    </p>

    <p>
      To protect your data from unauthorized access we have <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/authentication/keeping-your-account-and-data-secure/token-expiration-and-revocation")) { "revoked this token" } %> to ensure that it can no longer be used to authenticate to GitHub.
      We recommend that you view our guidance on <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/rest/authentication/keeping-your-api-credentials-secure")) { "keeping your API credentials secure" } %> to ensure tokens are securely stored.
    </p>

    <p>
      To encourage reports and ensure that exposed tokens can be quickly and easily revoked, we do not require authentication for submissions. As a result, GitHub is unable to provide further information about the source of the reported token.
    </p>

    <p>
      If you did not submit this token to GitHub's credential revocation API and you believe that your token was exposed, you can <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: settings_user_audit_log_url)) { "review your account security logs" } %> to ensure that unauthorized activity has not occurred using this token.
      To learn more about reviewing your account security logs, visit <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: "#{GitHub.help_url}/authentication/keeping-your-account-and-data-secure/reviewing-your-security-log")) { "our help docs" } %>.
    </p>

    <%= render(Mail::ButtonComponent.new(
      text: "Regenerate your #{@pat_type}",
      url: @new_pat_url,
      classes: "btn-primary btn-large mt-4",
    )) %>
  <% end %>
<% end %>

<% content_for :footer_text do %>
  You're receiving this email because your <%= @pat_type %> was revoked by GitHub.
<% end %>
