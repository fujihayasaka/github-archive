<% if @credentials_deleted %>
<% content_for :header do %>
  You deleted all keys, tokens, and their associated SSO authorizations for @<%= @target_user.display_login %> in <%= @enterprise_name %>
<% end %>
<% else %>
<% content_for :header do %>
  You revoked all SSO authorizations for keys and tokens belonging to @<%= @target_user.display_login %> in <%= @enterprise_name %>
<% end %>
<% end %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      <strong>
        <% if @credentials_deleted %>
          You deleted all user keys, tokens, and their associated SSO authorizations for @<%= @target_user.display_login %> in <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: @enterprise_url)) { @enterprise_name } %>.
        <% else %>
          You revoked all SSO authorizations for keys and tokens belonging to @<%= @target_user.display_login %> that have access to <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: @enterprise_url)) { @enterprise_name } %>.
        <% end %>
      </strong>
    </p>

    <% if @revoked_counts.values.any? { |v| v > 0 } %>
      <ul>
        <% if @revoked_counts[:classic_pats].to_i > 0 %>
          <li><%= pluralize(@revoked_counts[:classic_pats], "personal access token") %> (classic)</li>
        <% end %>
        <% if @revoked_counts[:fine_grained_pats].to_i > 0 %>
          <li><%= pluralize(@revoked_counts[:fine_grained_pats], "fine-grained personal access token") %></li>
        <% end %>
        <% if @revoked_counts[:oauth_app_tokens].to_i > 0 %>
          <li><%= pluralize(@revoked_counts[:oauth_app_tokens], "GitHub App and OAuth app user access token") %></li>
        <% end %>
        <% if @revoked_counts[:ssh_keys].to_i > 0 %>
          <li><%= pluralize(@revoked_counts[:ssh_keys], "SSH key") %></li>
        <% end %>
      </ul>
    <% end %>

    <% if @credentials_deleted %>
      <p>
        This was a permanent action. The user will need to generate new tokens, SSH keys, SSO authorizations, and organization access granted by fine-grained personal access tokens before they can access enterprise resources again.
      </p>
    <% else %>
      <p>
        This affected all of the user's SSH keys and tokens that had access to organization-level resources where SSO was enforced. This was a permanent action, and the affected tokens and keys cannot be reauthorized.
      </p>
    <% end %>

    <p>
      You can review the full list of affected credentials in your <%= render(Primer::Beta::Link.new(classes: "Link--inTextBlock", href: @audit_log_url)) { "enterprise audit log" } %>.
    </p>

    <%= render(Mail::ButtonComponent.new(
      text: "Review the enterprise audit log",
      url: @audit_log_url,
      classes: "btn-primary btn-large tmp-mt-4",
    )) %>

    <p>
      If you did not perform this action, please contact GitHub Support immediately.
    </p>
  <% end %>
<% end %>

<% content_for :footer_text do %>
  You are receiving this email because you initiated a credential revocation for @<%= @target_user.display_login %> in <%= @enterprise_name %>.
<% end %>
