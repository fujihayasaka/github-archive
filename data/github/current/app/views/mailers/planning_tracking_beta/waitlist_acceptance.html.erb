<% content_for :header do %>
  Welcome <%= @organization.safe_profile_name %> to the GitHub Issues: Sub-issues, issue types and advanced search beta
<% end %>

<%= render(Mail::RowComponent.new) do %>
    <%= render(Mail::ColumnComponent.new) do %>
    <p>
      We're thrilled to invite you to start testing our new and improved issues. Check out the <a href="https://docs.github.com/en/issues/tracking-your-work-with-issues">documentation</a> for a quick introduction.
    </p>

    <p>
      Your perspective will help us make GitHub Issues even better. Please visit our <a href="https://gh.io/AAsf8f4">feedback discussion</a> to ask questions and share your feedback. We'd love to hear from you!
    </p>
    <%= render(Mail::SpacerComponent.new) %>
    <%= render(Mail::ButtonComponent.new(text: "Try it now", url: @organization_url, classes: "btn-primary btn-large")) %>
    <%= render(Mail::SpacerComponent.new) %>

    <p>
      The GitHub team
    </p>
  <% end %>
<% end %>
