<% content_for :header do %>
  Action required: API version <%= @deprecation_version %> will be retired
<% end %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      Hi <strong><%= @user.display_login %></strong>,
    </p>

    <p>
      GitHub REST API version <strong><%= @deprecation_version %></strong> is closing down and will be <strong>retired on <%= @deprecation_date %></strong>. After this date, requests using this version will no longer be accepted.
    </p>

    <p>
      We recommend updating to the latest version, <strong><%= @latest_version %></strong>, as soon as possible. You can review what changed and find migration guidance in the <a href="<%= @changelog_url %>">API versioning documentation</a>.
    </p>

    <%= render(Mail::SpacerComponent.new) %>

    <%= render(Mail::ContainerComponent.new) do %>
      <%= render(
        Mail::ButtonComponent.new(
          text: "Review migration guide",
          url: @changelog_url,
          classes: "btn-primary btn-large"
        )
      ) %>
    <% end %>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      If you've already upgraded to the newer version then please disregard this email.
    </p>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      Thank you,<br>
      The GitHub API Team
    </p>
  <% end %>
<% end %>

<% content_for :content_footer do %>
  Button not working? Paste the following link into your browser: <a href="<%= @changelog_url %>"><%= @changelog_url %></a>
<% end %>

<% content_for :footer_text do %>
  You're receiving this email because you have an account that uses the GitHub REST API.
<% end %>
