<% content_for :header do %>
  Your API calls may be affected by breaking changes in a newer version
<% end %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      Hi <strong><%= @user.display_login %></strong>,
    </p>

    <p>
      We've noticed that you have integrations making GitHub REST API requests without including the <code>X-GitHub-Api-Version</code> header. These requests are currently defaulted to version <strong><%= @selected_version %></strong>.
    </p>

    <p>
      When the version your requests currently default to is retired on <strong><%= @selected_version_retirement_date %></strong>, your requests will be automatically moved to a newer version. This could cause unexpected behavior in your integrations.
    </p>

    <% if @app_count.positive? %>
      <p>
        You have <%= pluralize(@app_count, "app") %> that <%= @app_count == 1 ? "is" : "are" %> not sending an API version.
      </p>

      <% if @app_count <= 5 && @app_names.present? %>
        <p>
          Apps associated with this account:
        </p>

        <ul style="margin-top: 0; padding-left: 24px;">
          <% @app_names.each do |app_name| %>
            <li><%= app_name %></li>
          <% end %>
        </ul>

        <%= render(Mail::SpacerComponent.new) %>
      <% end %>
    <% end %>

    <% if @token_count.positive? %>
      <p>
        You have <%= pluralize(@token_count, "personal access token") %> that <%= @token_count == 1 ? "is" : "are" %> not sending an API version.
      </p>

      <% if @token_count <= 5 && @token_names.present? %>
        <p>
          Tokens associated with this account:
        </p>

        <ul style="margin-top: 0; padding-left: 24px;">
          <% @token_names.each do |token_name| %>
            <li><%= token_name %></li>
          <% end %>
        </ul>

        <%= render(Mail::SpacerComponent.new) %>
      <% end %>
    <% end %>

    <p>
      Use the following links to review the apps and tokens associated with your account:
    </p>

    <ul style="margin-top: 0; padding-left: 24px;">
      <li>
        <a href="<%= @personal_github_apps_url %>">Manage your GitHub Apps</a>
      </li>
      <li>
        <a href="<%= @oauth_apps_url %>">Manage your OAuth Apps</a>
      </li>
      <li>
        <a href="<%= @fine_grained_tokens_url %>">Manage your fine-grained personal access tokens</a>
      </li>
      <li>
        <a href="<%= @classic_tokens_url %>">Manage your classic personal access tokens</a>
      </li>
    </ul>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      We recommend updating your integrations to use the latest version by sending the header <strong><code>X-GitHub-Api-Version: <%= @latest_version %></code></strong> with every request. You can learn more and find migration guidance in the <a href="<%= @changelog_url %>">API versioning documentation</a>.
    </p>

    <%= render(Mail::SpacerComponent.new) %>

    <%= render(Mail::ContainerComponent.new) do %>
      <%= render(
        Mail::ButtonComponent.new(
          text: "Review API version changes",
          url: @breaking_changes_url,
          classes: "btn-primary btn-large"
        )
      ) %>
    <% end %>

    <%= render(Mail::SpacerComponent.new) %>

    <p>
      Thank you,<br>
      The GitHub API Team
    </p>
  <% end %>
<% end %>

<% content_for :content_footer do %>
  Button not working? Paste the following link into your browser: <a href="<%= @breaking_changes_url %>"><%= @breaking_changes_url %></a>
<% end %>

<% content_for :footer_text do %>
  You're receiving this email because you have apps or tokens making API requests without specifying a version.
<% end %>
