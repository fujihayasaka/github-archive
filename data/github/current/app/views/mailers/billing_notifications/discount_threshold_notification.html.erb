<% content_for :header do %>
  <%= @subject %>
<% end %>

<style>
  <%= render :partial => "mailers/layouts/styles/billing_email_styles", :formats => [:css] %>
</style>

<%= render(Mail::HeaderTitleComponent.new(
  title: @email_context.mail_product_title,
  icon: @email_context.mail_icon,
)) %>

<%= render(Mail::SpacerComponent.new(size: 16)) %>

<p>
  <%= @email_context.text %>
</p>

<%= render(
  partial: "mailers/shared/progress_bar",
  locals: {
    color: @email_context.threshold >= 100 ? "yellow" : "blue",
    percentage: @email_context.threshold,
    label: @email_context.progress_bar_details_text,
    amount: nil
  }
) %>


<%= render(Mail::SpacerComponent.new(size: 32)) %>

<p>
  <%= "You will be billed for usage beyond this included amount. You can create budgets to track and control your spending." %>
</p>

<p><%= @email_context.usage_reset_date_text %>.</p>

<%= render(Mail::SpacerComponent.new(size: 16)) %>

<%= render(Mail::ContainerComponent.new) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "Manage budgets",
      url: @budgets_url,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>

<%= render(Mail::SpacerComponent.new) %>

<% content_for :footer_text do %>
  <%= @footer_text %>
<% end %>
