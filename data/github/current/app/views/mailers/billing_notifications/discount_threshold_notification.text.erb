<%= @email_context.text %> for the <%= account_description(@owner) %>.

<% if @email_context.recommendation_text.present? %>
<%= @email_context.recommendation_text %>
<% if @email_context.disclaimer_text.present? %>

<%= @email_context.disclaimer_text %>
<% end %>
<% elsif !@owner.try(:has_any_trade_restrictions?) && !@owner.delegate_billing_to_business? %>
<%= @email_context.usage_reset_date_text %>.
<% end %>
