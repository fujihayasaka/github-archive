<% content_for :header do %>
  <%= @subject %>
<% end %>

<%= render(Mail::HeaderTitleComponent.new(title: @display_name, avatar: @billable_entity)) %>
<%= render(Mail::SpacerComponent.new) %>
<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      Dear Customer,
    </p>
    <p>
      On <%= @migration_date %>, <strong><%= @display_name %></strong> will transition to a new billing platform for an enhanced billing experience.
    </p>
    <%= render(Mail::SpacerComponent.new) %>
    <p><strong>What is the new billing platform?</strong></p>
    <p>
      The new billing platform is a suite of new features designed to help you understand and manage your GitHub spend.
    </p>
    <%= render(Mail::SpacerComponent.new) %>
    <p>
      Benefits of the new platform include:
    </p>
    <p>
      <ul class="ml-3">
        <li>Spend transparency - view usage for organizations, repositories, products, and SKUs by hour, day, month, or year</li>
        <li>Improved control - set budgets to limit spending and configure alerts to stay informed of budget utilization</li>
      </ul>
    </p>
    <%= render(Mail::SpacerComponent.new) %>
    <p>
      For more information, refer to "<a href="<%= @using_billing_platform_url %>">About the new billing platform.</a>"
    </p>
    <%= render(Mail::SpacerComponent.new) %>
    <p><strong>What to expect:</strong></p>
    <p>You will gain access to the new billing experience on <strong><%= @migration_date %>.</strong></p>
    <ul class="ml-3">
      <li>
        Once transitioned, a new <strong>Billing & Licensing</strong> section will appear in your account settings.
      </li>
      <li>
        Spending limits will be migrated and recreated as budgets in the new billing experience. For more details about budgets, visit "<a href="<%= @billing_platform_budget_url %>">Preventing overspending.</a>"
      </li>
      <li>
        Historical usage will not be visible in the new billing experience. You will still be able to see historical usage by generating a usage report.
      </li>
    </ul>
    <%= render(Mail::SpacerComponent.new) %>
    <p><strong>Important changes:</strong></p>
    <ul class="ml-3">
      <li>
        Git Large File Storage will transition from prepaid, quota-based data packs to a usage-based metered billing model. Credits will be issued for any unused data packs. For more information, visit "<a href="<%= @billing_platform_lfs_url %>">About enhanced billing for Git Large File Storage.</a>"
      </li>
      <li>
        Some billing-related APIs will no longer work or will work differently. For more information about API changes, visit "<a href="<%= @billing_platform_rest_api_url %>">Migrating from the endpoints used for the previous billing platform.</a>"
      </li>
    </ul>
  <% end %>
<% end %>

<% content_for :footer_text do %>
  You're receiving this email because you're an owner of <%= @display_name %> on GitHub.
<% end %>
