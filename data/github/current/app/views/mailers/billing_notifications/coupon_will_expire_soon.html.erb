<% content_for :header do %>
  <%= @subject %>
<% end %>

<%= render Mail::HeaderTitleComponent.new(title: @subject, avatar: @billable_entity) %>

<p>
  Greetings, <%= @display_login %>
</p>

<p>
  Your <strong><%= @discount_amount %></strong> discount on <strong><%= @product_name %></strong> ends on <strong><%= @expiration_date %></strong>—that's in <%= @time_until_expiration %>.
</p>

<% if !@has_active_subscription %>
<p>
  You don't currently have an active <%= @product_name %> subscription, so nothing will be charged when this coupon expires.
</p>
<% elsif @education_coupon %>
<p>
  After that, your subscription will be cancelled and you can resubscribe at any time.
</p>
<% elsif @has_payment_or_invoiced %>
<p>
  After that, your subscription continues at <strong><%= @regular_price_with_period %></strong>—no action needed, your payment method is already on file.
</p>
<% else %>
<p>
  Add a payment method to continue at <strong><%= @regular_price_with_period %></strong>, or your subscription will be cancelled.
</p>
<% end %>

<%= render(Mail::SpacerComponent.new) %>

<%= render(Mail::ContainerComponent.new) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: @button_text,
      url: @settings_url,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>

<%= render(Mail::SpacerComponent.new) %>

<% if @show_downgrade_option %>
<p>
  Or downgrade to <%= branded_plan_name(GitHub::Plan.free) %>—you'll keep access to your private repos.
</p>
<% end %>

<% if @education_coupon %>
<p>
  If you are still a student or teacher, you may apply for a new academic discount coupon at <%= link_to "https://education.github.com", "https://education.github.com" %>.
</p>
<% end %>

<p>
  Questions? <%= link_to "Contact support", contact_url %>.
</p>

<p>
  —The GitHub Team
</p>

<hr class="rule">

<p class="email-text-small email-text-gray">
  Button not working? Paste the following link into your browser:<br>
  <%= link_to @settings_url, @settings_url.to_s %>
</p>

<% content_for :footer_text do %>
  <%= @footer_text %>
<% end %>
