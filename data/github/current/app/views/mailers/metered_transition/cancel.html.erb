<% content_for :header do %>
  <%= @subject %>
<% end %>

<%= render(Mail::HeaderTitleComponent.new(title: "", avatar: @business)) %>

<p>
  Hello!
</p>
<p>
  We're writing to confirm that your scheduled switch to metered billing for <%= link_to @business.name, enterprise_url(@business) %> has been successfully cancelled. Your current billing arrangement will remain unchanged, and no action is required on your part.
</p>
<p>
  If you have any questions or would like to discuss your billing options further, please don't hesitate to reach out to <%= link_to "GitHub Support", GitHub.support_url %>.
</p>

<%= render(Mail::SpacerComponent.new) %>
<%= render(Mail::ContainerComponent.new(classes: "py-4")) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "Contact us",
      url: contact_url,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>
<%= render(Mail::SpacerComponent.new) %>

<hr class="rule">

<p class="email-text-small email-text-gray">
  Button not working? Paste the following link into your browser:<br>
  <%= link_to contact_url, contact_url.to_s %>
</p>

<%= render(Mail::SpacerComponent.new) %>

<% content_for :footer_text do %>
  You are receiving this because you are an enterprise admin for <strong><%= @business.name %></strong> on GitHub.
<% end %>
