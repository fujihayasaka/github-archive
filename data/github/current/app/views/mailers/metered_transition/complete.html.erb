<% content_for :header do %>
  <%= @subject %>
<% end %>

<%= render(Mail::HeaderTitleComponent.new(title: "", avatar: @business)) %>

<p>
  Hello!
</p>
<p>
  We're confirming that <%= link_to @business.name, enterprise_url(@business) %> has successfully transitioned to metered billing.
</p>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      What this means for you:
    </p>
    <ul class="px-4">
      <li>Usage will now be billed based on the licenses you use. No more pre-paid licenses necessary.</li>
      <li>You can view consolidated, detailed usage and billing information anytime under <%= link_to "Billing and licensing", @billing_licensing_link %>.</li>
    </ul>
  <% end %>
<% end %>

<%= render(Mail::SpacerComponent.new) %>
<p>
  If you have any questions about your transition or how metered billing works, please see our <%= link_to "documentation", "https://docs.github.com/en/enterprise-cloud@latest/billing/managing-your-billing/about-usage-based-billing-for-licenses" %> or reach out to <%= link_to "GitHub Support", GitHub.support_url %>.
</p>

<%= render(Mail::SpacerComponent.new) %>
<%= render(Mail::ContainerComponent.new(classes: "py-4")) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "Contact us",
      url: contact_url,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>
<%= render(Mail::SpacerComponent.new) %>

<hr class="rule">

<p class="email-text-small email-text-gray">
  Button not working? Paste the following link into your browser:<br>
  <%= link_to contact_url, contact_url.to_s %>
</p>

<% content_for :footer_text do %>
  You are receiving this because you are an enterprise admin for <strong><%= @business.name %></strong> on GitHub.
<% end %>
