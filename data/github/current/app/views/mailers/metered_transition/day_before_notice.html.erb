<% content_for :header do %>
  <%= @subject %>
<% end %>

<%= render(Mail::HeaderTitleComponent.new(title: "", avatar: @business)) %>

<p>
  Hello!
</p>
<p>
  This is a friendly reminder that <%= link_to @business.name, enterprise_url(@business) %> is scheduled to transition to metered billing tomorrow, <%= @transition.transition_date.strftime("%B %-d, %Y") %>.
</p>
<p>
  With metered billing, you'll only be charged for the licenses you use. The transition will occur automatically — no action is needed from you. Today is the last day to <%= link_to "cancel", enterprise_licensing_url(@business) %> the transition.
</p>
<p>
  To learn more about usage-based billing, visit our <%= link_to "documentation", "https://docs.github.com/en/enterprise-cloud@latest/billing/managing-your-billing/about-usage-based-billing-for-licenses" %>. If you need further assistance, please reach out to <%= link_to "GitHub Support", GitHub.support_url %>.
</p>

<%= render(Mail::SpacerComponent.new) %>
<%= render(Mail::ContainerComponent.new(classes: "py-4")) do %>
  <%= render(
    Mail::ButtonComponent.new(
      text: "Contact us",
      url: contact_url,
      classes: "btn-primary btn-large"
    )
  ) %>
<% end %>
<%= render(Mail::SpacerComponent.new) %>

<hr class="rule">

<p class="email-text-small email-text-gray">
  Button not working? Paste the following link into your browser:<br>
  <%= link_to contact_url, contact_url.to_s %>
</p>

<%= render(Mail::SpacerComponent.new) %>

<% content_for :footer_text do %>
  You are receiving this because you are an enterprise admin for <strong><%= @business.name %></strong> on GitHub.
<% end %>
