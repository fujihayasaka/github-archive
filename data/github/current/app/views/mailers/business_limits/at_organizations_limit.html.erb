<% content_for :header do %>
  Organizations limit reached for the <%= @business.name %> enterprise
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Organizations limit reached", avatar: @business %>

<p>
  The <strong><%= @business.name %></strong> enterprise has
  reached the limit of <%= number_with_delimiter(@business.organizations_limit) %> organizations.
</p>

<p>
  <strong><%= @business.name %></strong> will not be able to add more organizations while at the limit.
</p>

<p>
  Please delete any unnecessary organizations or transfer organizations to another enterprise to keep within
  the supported limit.
</p>

<p>
  Visit the <a href="https://gh.io/enterprise-limits">enterprise limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you’re an owner of the <strong><%= @business.name %></strong>
  enterprise on GitHub.
<% end %>
