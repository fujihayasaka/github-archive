<% content_for :header do %>
  Members limit approaching for the <%= @business.name %> enterprise
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Members limit approaching", avatar: @business %>

<p>
  The <strong><%= @business.name %></strong> enterprise is
  approaching the limit of <%= number_with_delimiter(@business.members_limit) %>
  members in the enterprise.
</p>

<p>
  The enterprise currently has <%= number_with_delimiter(@members_count) %>
  members.
</p>

<p>
  If the limit of <%= number_with_delimiter(@business.members_limit) %> members
  is reached, <strong><%= @business.name %></strong> will not be able to add more members.
</p>

<p>
  Visit the <a href="https://gh.io/enterprise-limits">enterprise limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you’re an owner of the <strong><%= @business.name %></strong>
  enterprise on GitHub.
<% end %>
