<% content_for :header do %>
  Set up two-factor authentication to access <%= @organization.safe_profile_name %> organization
<% end %>

<%= render Mail::HeaderTitleComponent.new \
  title: "#{@organization.safe_profile_name} now requires two-factor authentication", avatar: @organization %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      Hi @<%= @actor.display_login %>,
    </p>
    <p>
      Your organization, <%= @organization.safe_profile_name %> that you are a <%= @role_and_preposition %>, now requires all users to have two-factor authentication (2FA).
      You must set up two-factor authentication to access any repositories, projects, or discussions.
    </p>
    <%= render(Mail::ButtonComponent.new(
      text: "Enable two-factor authentication",
      url: settings_user_2fa_intro_url(:host => GitHub.urls.host_name),
      classes: "btn-primary btn-large width-full my-3"
    )) %>
    <p>
      For more information about two-factor authentication, see <%= link_to "our documentation", "#{GitHub.help_url}/authentication/securing-your-account-with-two-factor-authentication-2fa/about-two-factor-authentication" %>. <br>
      <%= link_to "View the organizations", settings_organizations_url %> you belong to that require 2FA.
    </p>
  <% end %>
<% end %>

<% content_for :footer_text do %>
  You’re receiving this email because content you access is now protected by a two-factor authentication requirement,
  and you do not have 2FA enabled.
<% end %>
