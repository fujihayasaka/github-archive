<% content_for :header do %>
  Set up secure two-factor authentication methods to access <%= @organization.safe_profile_name %> organization
<% end %>

<%= render Mail::HeaderTitleComponent.new \
  title: "#{@organization.safe_profile_name} only allows secure two-factor authentication methods", avatar: @organization %>

<%= render(Mail::RowComponent.new) do %>
  <%= render(Mail::ColumnComponent.new) do %>
    <p>
      Hi @<%= @actor.display_login %>,
    </p>
    <p>
      Your organization, <%= @organization.safe_profile_name %> that you are <%= @role_and_preposition %>, now requires all users to only have secure two-factor authentication (2FA) methods.
      You currently have SMS/Text message configured as a 2FA method, which is not considered secure.
      To access <%= @organization.safe_profile_name %> resources, remove SMS/Text message as a 2FA method.
    </p>

    <p>
      If this is your only 2FA method, you will need to add an authenticator app as a 2FA method before you can remove SMS/Text message for 2FA.
    </p>

    <p>
      Once you have added an authenticator app as a 2FA method, you can add additional secure 2FA methods, such as:
      <div class="mt-2 pl-3 ml-3">
        <ul>
          <li>Security keys</li>
          <li>Passkeys</li>
          <li>GitHub Mobile App</li>
        </ul>
      </div>

    </p>

    <%= render(Mail::ButtonComponent.new(
      text: "Update your two-factor authentication methods",
      url: settings_security_url(:host => GitHub.urls.host_name),
      classes: "btn-primary btn-large width-full my-3"
    )) %>
    <p>
      For more information about two-factor authentication, see <%= link_to "our documentation", "#{GitHub.help_url}/authentication/securing-your-account-with-two-factor-authentication-2fa/about-two-factor-authentication" %>. <br>
      <%= link_to "View the organizations", settings_organizations_url %> you belong to that require secure 2FA methods.
    </p>
  <% end %>
<% end %>

<% content_for :footer_text do %>
  You’re receiving this email because content you access is now protected by a secure two-factor authentication methods requirement,
  and you have an insecure two-factor authentication method enabled.
<% end %>
