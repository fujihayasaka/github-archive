<% content_for :header do %>
  Members limit approaching for the <%= @team.name %> team
<% end %>

<%= render Mail::HeaderTitleComponent.new title: "Members limit approaching", avatar: @team %>

<p>
  The <strong><%= @team.name %></strong> team is
  approaching the limit of <%= number_with_delimiter(@team.members_limit) %>
  members in the team.
</p>

<p>
  The team currently has <%= number_with_delimiter(@members_count) %>
  members.
</p>

<p>
  If the limit of <%= number_with_delimiter(@team.members_limit) %> members
  is reached, <strong><%= @team.name %></strong> will not be able to add more members.
</p>

<p>
  Visit the <a href="https://gh.io/team-limits">team limits page</a> to learn more.
</p>

<% content_for :footer_text do %>
  You’re receiving this email because you can manage members of the <strong><%= @team.name %></strong>
  team on GitHub.
<% end %>
