<p class="tmp-mb-3">
  Your enterprise has made GitHub <%= Copilot::COPILOT_CODE_REVIEW %> available. To let your developers in <%= link_to @organization_login, user_url(@organization_login) %> use it, enable the organization policy.
</p>

<p class="tmp-mb-3">
  <%= Copilot::COPILOT_CODE_REVIEW %> gives engineers suggestions directly in pull requests so they can find issues earlier, improve code quality, and speed up reviews.
</p>

<%= render(Mail::RowComponent.new) do %>
  <b>How to enable</b>

  <%= render(Mail::ColumnComponent.new) do %>
    <ol>
      <li class="tmp-mb-3 tmp-ml-3">Go to <b><%= link_to "Organization settings → Copilot → Policies", settings_org_copilot_policies_url(@organization) %></b></li>
      <li class="tmp-mb-3 tmp-ml-3">Enable <b><%= Copilot::COPILOT_CODE_REVIEW %></b></li>
    </ol>
  <% end %>
<% end %>

<div class="tmp-mb-3" style="text-align: center;">
  <img src="<%= mailer_static_asset_path("images/email/copilot/copilot-code-review-policy-toggle.png") %>" alt="Org settings screen with 'Enable Copilot code review' toggle highlighted." width="514">
</div>

<%= render(Mail::ButtonComponent.new(
  text: "Get started with #{Copilot::COPILOT_CODE_REVIEW} now",
  url: Copilot::CODE_REVIEW_REQUEST_DOCS_URL,
  classes: "btn-primary btn-large"
)) %>

<% content_for :footer_text do %>
  <p>
    You are receiving this because you are an administrator of the <%= link_to "@#{@organization_login}", user_url(@organization_login) %> organization.
  </p>
<% end %>
