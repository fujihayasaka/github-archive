<p class="mb-3">
  You now have access to GitHub <%= Copilot::COPILOT_CODE_REVIEW %>. An administrator from your <%= link_to @organization_login, user_url(@organization_login) %> organization has enabled this feature for you. With <%= Copilot::COPILOT_CODE_REVIEW %>, you'll get suggestions directly in your pull requests, helping you spot issues faster, improve code quality, and speed up your review workflow.
</p>

<%= render(Mail::ButtonComponent.new(
  text: "Get started with #{Copilot::COPILOT_CODE_REVIEW} now",
  url: Copilot::CODE_REVIEW_REQUEST_DOCS_URL,
  classes: "btn-primary btn-large"
)) %>

<%= render(Mail::SpacerComponent.new) %>

<p class="mb-3">
  To get started, select <b>Copilot</b> as your reviewer on any pull request.
</p>

<% content_for :footer_text do %>
  <p>
    You are receiving this because you are the owner of the <%= link_to "@#{@user_login}", user_url(@user_login) %> account, and an administrator has granted you access to <%= Copilot::COPILOT_CODE_REVIEW %>.
  </p>
<% end %>
