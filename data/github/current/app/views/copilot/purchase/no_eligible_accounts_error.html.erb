<div class="container-lg my-4">
  <%= render(Primer::Beta::Heading.new(tag: :h2, mb: 3)) { "Activate GitHub Copilot" } %>
  <hr>
  <%= render(Primer::Beta::BorderBox.new(mt: 3, padding: :spacious)) do |component| %>
    <% component.with_body do %>
      <%= render(Primer::Beta::Heading.new(tag: :h3, mb: 3)) { "GitHub Copilot plans require a valid organization or enterprise" } %>
      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, mb: 3)) do %>
        To purchase and try latest Copilot features, including Chat-based assistance in the GitHub Platform, conversational search and summarization on internal documentation and skills for pull request:
      <% end %>
      <%= render(Primer::Beta::Link.new(href: settings_enterprises_path , underline: true)) { "Make sure you're signed in as the owner of an Enterprise" } %>
      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, mb: 3)) { "See the list of Enterprises you own." } %>

      <%= render(Primer::Beta::Link.new(href: settings_organizations_path , underline: true)) { "Make sure you're signed in as the owner of an Organization" } %>
      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, mb: 3)) { "See the list of Organizations you own." } %>

      <%= render(Primer::Beta::Link.new(href: copilot_signup_path, underline: true)) { "Purchase GitHub Copilot for Individuals instead" } %>

      <%= render(Primer::Beta::Text.new(tag: :p, my: 3, color: :muted)) do %>
        For more information on purchasing GitHub Copilot, <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_BILLING_DOCUMENTATION, underline: true)) { "visit the documentation" } %>.
      <% end %>

      <hr>

      <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, color: :muted)) do %>
        Your organization or enterprise's use of GitHub Copilot is subject to your GitHub agreement and
        <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_SPECIFIC_TERMS, underline: true)) { "the specific GitHub Copilot terms" } %>.
      <% end %>
    <% end %>
  <% end %>
</div>
