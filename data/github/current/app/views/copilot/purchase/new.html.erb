<%= render(Copilot::Purchase::PageComponent.new(selected_account: selected_account)) do |c| %>
  <div class="container-lg my-4">
    <%= render(Primer::Beta::Heading.new(tag: :h2, mb: 2)) { "Activate GitHub Copilot" } %>
    <hr>

    <%= render Primer::Alpha::Layout.new(first_in_source: :main, gutter: :spacious, mt: 5) do |component| %>
      <% component.with_main do %>
        <%= render(Copilot::Purchase::AccountComponent.new(accounts: accounts, selected_account: selected_account, eligibility: account_eligibility)) %>
        <%= render(Copilot::Purchase::PlansOfferedComponent.new(selected_account: selected_account)) %>
        <%= render(Copilot::Purchase::BillingComponent.new(selected_account: selected_account, eligibility: account_eligibility)) %>
      <% end %>

      <% component.with_sidebar(col_placement: :end, row_placement: :end) do %>
        <copilot-purchase-intent-form data-account-type="<%= selected_account.class.name %>">
          <%= primer_form_with(
              method: :put,
              url: copilot_plan_purchase_update_path,
              data: { target: "copilot-purchase-intent-form.form" },
          ) do |form| %>
            <%= form.hidden_field c.account_type(selected_account).downcase, value: c.account_name(selected_account) %>
            <%= render(Copilot::Purchase::CheckoutSectionComponent.new) do |component| %>
              <% component.with_children do %>
                <%= render(Primer::Beta::Text.new(tag: :p, font_size: 3, font_weight: :bold)) { "Summary" } %>
                <hr>
                <%= render(Primer::Beta::Text.new(tag: :p, font_size: 5, font_weight: :bold)) { "GitHub Copilot" } %>
                <%= render(Primer::Beta::Text.new(tag: :p, font_size: 6, color: :muted, mb: 2)) { "Monthly • No seats assigned yet" } %>
                <%= render(
                  Primer::Beta::Button.new(
                    scheme: :primary,
                    size: :medium,
                    tag: :button,
                    type: :submit,
                    disabled: !account_eligibility[:eligible],
                    mb: 2,
                    block: true,
                    data: { target: "copilot-purchase-intent-form.formSubmitBtn" }
                  )
                ) do |_c| %>
                  Enable GitHub Copilot
                <% end %>
                <%= render(
                  Primer::Beta::Button.new(
                    scheme: :default,
                    size: :medium,
                    tag: :a,
                    block: true,
                    href: return_to_path
                  )
                ) do |_c| %>
                  Cancel
                <% end %>
                <%= render(Primer::Beta::Text.new(tag: :p, mt: 3, mb: 0, color: :subtle, text_align: :center, font_size: 6)) do %>
                  Your existing agreement with GitHub governs your use of GitHub Copilot. See GitHub Copilot specific terms <%= render(Primer::Beta::Link.new(underline: true, href: "https://github.com/customer-terms/github-copilot-product-specific-terms")) { "here" } %>. If you require invoices, <%= render(Primer::Beta::Link.new(underline: true, href: "https://github.com/enterprise/contact")) { "contact our sales team" } %>.
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </copilot-purchase-intent-form>
      <% end %>
    <% end %>
  </div>
<% end %>
