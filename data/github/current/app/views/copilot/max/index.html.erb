<%
  page_info(
    title: "Signup to GitHub #{product_name}",
    class: "bgColor-inset",
    full_height_scrollable: true,
    full_height: true,
    hide_footer: logged_in?,
    marketing_page_theme: logged_in? ? nil : "dark",
    richweb: {
      title: "GitHub #{product_name}",
      description: "Get AI-based suggestions and answers to your questions with GitHub Copilot, your AI pair programmer.",
      url: T.must(request).original_url,
      image: image_path("modules/site/social-cards/copilot-pro-plus.png"),
    },
  )

  has_active_pro_trial = copilot_user && copilot_user.has_trial_access?
%>

<%= render Primer::Alpha::Stack.new(direction: :vertical, align: :center, container: :md, px: [2, 4], py: [6, 7]) do %>
  <%= render Primer::Alpha::Stack.new(direction: :vertical, w: :full, gap: :spacious, border: true, border_radius: 3, bg: :default, classes: "tmp-p-4") do %>
    <div data-hpc>
      <%= render Primer::Alpha::Stack.new(align: :center, mb: 2) do %>
        <div class="copilot-pro__head-glow">
          <%= render Primer::Beta::Octicon.new(:copilot, height: 24, color: :default) %>
        </div>
      <% end %>

      <%= render Primer::Beta::Heading.new(tag: :h1, text_align: :center, mb: 2) do %>
        Get started with <span style="white-space: nowrap;"><%= product_name %></span>
      <% end %>

      <%= render Primer::Beta::Text.new(tag: :p, color: :muted, font_size: 4, text_align: :center, mb: 0) do %>
        For developers who need maximum flexibility and extensive model choice
      <% end %>
    </div>

    <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
      <%= form_with url: form_submit_path, method: :get do |f| %>
        <% tracking_params&.each do |key, value| %>
          <%= f.hidden_field key, value: value %>
        <% end %>

        <% if has_active_pro_trial %>
          <%= render Primer::Alpha::Banner.new(icon: :info, classes: "tmp-mt-3") do %>
            Upgrading to <%= product_name %> will end your current Pro trial. <%= render Primer::Beta::Link.new(href: Copilot::COPILOT_MAX_DOCS_LINK, target: "_blank", classes: "Link--inTextBlock", style: "white-space: nowrap;") do %>Learn more<% end %>
          <% end %>
        <% end %>

        <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, size: :large, block: true, classes: "tmp-mt-3") do %>
          Upgrade now
        <% end %>
      <% end %>

      <% if logged_in? && current_user.member_or_billing_manager_for_any_organization? %>
        <%= render Primer::Beta::Text.new(tag: :p, color: :muted, font_size: 6, text_align: :center, mt: 1, mb: 0) do %>
          Part of an organization? Upgrade to <%= render Primer::Beta::Link.new(href: copilot_business_signup_path, classes: "Link--inTextBlock") do %>Copilot Business<% end %> to enable across teams.
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
