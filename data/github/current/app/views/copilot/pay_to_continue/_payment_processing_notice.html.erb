<%#
  Shown when an India RBI customer is sent back to the pay-to-continue page because their manual
  payment couldn't be confirmed in time (see billing/zuora.ts and Billing::ManualPaymentRedirect).
  It tells them their payment is still processing and to try again once it finishes. Renders nothing
  unless the payment-processing flag is present on the request.
-%>
<% if params[Billing::ManualPaymentRedirect::PAYMENT_PROCESSING_PARAM].present? %>
  <%= render(Primer::Alpha::Banner.new(
    icon: :info,
    scheme: :default,
    test_selector: "rbi-payment-processing-notice",
    classes: "tmp-mb-4",
  )) do %>
    Thanks for your payment. It may already be complete, but can take a few moments to process.
    Select "Pay now" again to reset your usage cap. You won't be charged twice if the payment was already processed.
  <% end %>
<% end %>
