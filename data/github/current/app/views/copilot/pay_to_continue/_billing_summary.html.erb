<%# locals(amount_to_pay:, submit_path:, return_to:) -%>

<%
  has_entered_all_required_info = current_user.has_saved_billing_information? && current_user.has_valid_payment_method?
  formatted_amount = amount_to_pay.format(no_cents_if_whole: false)
%>

<%= render Primer::Box.new(border: true, border_radius: 2, bg: :default, classes: "tmp-p-3") do %>
  <h2 class="sr-only">Pay for additional usage summary</h2>

  <%= render Primer::Alpha::Stack.new(direction: :horizontal, justify: :space_between, mb: 2) do %>
    <%= render Primer::Beta::Text.new(tag: :p, font_size: 5, font_weight: :bold, flex_grow: 0, mb: 0) do %>
      <span>Pay for additional usage</span>
    <% end %>

    <%= render Primer::Beta::Text.new(tag: :p, font_size: 5, font_weight: :bold, mb: 0) do %>
      <%= formatted_amount %>
    <% end %>
  <% end %>

  <%= render Primer::Beta::Text.new(tag: :p, color: :default, font_size: 6, classes: "tmp-mb-3") do %>
    You will be billed <%= formatted_amount %> today.
  <% end %>

  <% if has_entered_all_required_info %>
    <hr class="tmp-my-3">

    <%= render "copilot/pay_to_continue/subscribe_form", amount_to_pay: amount_to_pay, submit_path: submit_path, return_to: return_to %>
  <% end %>
<% end %>
