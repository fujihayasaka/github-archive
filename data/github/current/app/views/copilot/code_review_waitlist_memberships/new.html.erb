<div class="d-flex flex-column flex-lg-row">

  <div class="col-12 col-lg-6">
    <div class="copilot-waitlist-header-section copilot-waitlist-header-customization">
      <div class="copilot-waitlist-section-inner">
        <div class="copilot-waitlist-beta-bubble">
          Preview
        </div>
        <p class="lh-condensed copilot-waitlist-header">Join the waitlist for Copilot-powered code reviews</p>

        <p class="text-light mt-4 mb-4">
          Get fast AI-powered code feedback in pull requests on GitHub.com and in Visual Studio Code. Jump from your pull request to Copilot Workspace to refine, validate and land suggestions.
        </p>
      </div>
    </div>
  </div>
  <div class="copilot-waitlist-form-section col-12 col-lg-6 pr-8 pb-8 pl-8 pt-10">
    <div class="copilot-waitlist-section-inner">
      <% if has_copilot_individual %>
        <%= render(Copilot::BetaSignupFormComponent.new(
          signup_url_path: copilot_code_review_waitlist_memberships_create_path,
          signup_cta_text: "Join the waitlist",
          preview_terms: preview_terms,
          preview_terms_text: "You will receive an email once you are accepted into the preview.",
        )) %>
      <% elsif organizations.any? %>
        <p class="mb-2 h3">Tell us about your organization</p>

        <%= render(Copilot::BetaSignupFormComponent.new(
          signup_url_path: copilot_code_review_waitlist_memberships_create_path,
          signup_cta_text: "Join the waitlist",
          preview_terms: preview_terms,
          preview_terms_text: "You will receive an email once you are accepted into the preview.",
          organizations: organizations,
        )) %>
      <% elsif has_copilot_standalone_business %>
        <p class="mb-2 h3">You aren't eligible for this preview</p>

        <p class="mb-4">
          This preview isn't available at this time if you use a <%= link_to "dedicated enterprise for Copilot", "#{GitHub.help_url}/admin/copilot-business-only/about-enterprise-accounts-for-copilot-business", class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %>.
        </p>
      <% else %>
        <p class="mb-2 h3">You need an active GitHub Copilot subscription</p>

        <p class="mb-4">
          It looks like you don't have access to an active GitHub Copilot subscription.
          Please subscribe to GitHub Copilot, and then return to this page to join the waitlist.
        </p>

        <%= render(Site::ButtonComponent.new(
          role: :button,
          scheme: :muted,
          url: "https://github.com/features/copilot#pricing",
          text: "Get started with GitHub Copilot",
          arrow: true,
          classes: "width-full copilot-waitlist-buy-button"
        )) %>
      <% end %>
    </div>
  </div>
</div>
