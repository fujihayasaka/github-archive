<% page_info title: "Signup to GitHub Copilot" %>
<% product_name = (feature_enabled_globally_or_for_user?(feature_name: :copilot_edu_ui_free_signup) && copilot_user.can_signup_for_educational?) ? Copilot::INDIVIDUAL_EDU_PRODUCT_NAME : Copilot::INDIVIDUAL_PRO_PRODUCT_NAME %>
<%= render Copilot::SignupComponent.new(fullscreen: true) do |signup_component| %>
  <% signup_component.with_heading do %>
    <span class="copilot-signup-heading">
      GitHub <%= product_name %>
    </span>
  <% end %>
  <% signup_component.with_subheading do %>
    <span class="copilot-signup-subheading">
      Your AI pair programmer
    </span>
  <% end %>
  <% signup_component.with_main do %>
    <%= render partial: "copilot/free_user_signup", locals: { copilot_user: copilot_user, form_submit_path: form_submit_path, product_name: product_name } %>
  <% end %>
<% end %>
