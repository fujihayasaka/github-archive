<%
  error ||= false
%>

<% page_info title: "Signup to GitHub Copilot" %>
<%= render Copilot::SignupComponent.new do |signup_component| %>
  <% signup_component.with_heading do %>
    <span class="copilot-signup-heading">
      <% if copilot_user.has_limited_access? %>
        GitHub <%= Copilot::INDIVIDUAL_FREE_PRODUCT_NAME %>
      <% elsif feature_enabled_globally_or_for_user?(feature_name: :copilot_edu_ui_free_signup) && copilot_user.has_educational_access? %>
        GitHub <%= Copilot::INDIVIDUAL_EDU_PRODUCT_NAME %>
      <% else %>
        GitHub <%= Copilot::INDIVIDUAL_PRO_PRODUCT_NAME %>
      <% end %>
    </span>
  <% end %>
  <% signup_component.with_subheading do %>
    <span class="copilot-signup-subheading">
      Your AI pair programmer
    </span>
  <% end %>
  <% signup_component.with_main do %>
    <div class="container-md p-responsive clearfix tmp-mt-3">
      <%= render(Primer::Beta::Heading.new(tag: :h2, classes: "tmp-mb-3")) { "Select your preferences" } %>
      <%= render partial: "/copilot/settings", locals: { view: :onboarding, error: error, error_message: error_message, form_submit_path: form_submit_path, copilot_user: copilot_user } %>
    </div>
  <% end %>
<% end %>
