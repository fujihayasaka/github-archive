<%# locals(copilot_user:, form_submit_path:, tracking_params:, signup_duration:) -%>
<% page_info title: "GitHub Copilot Free" %>
<%= render Primer::Beta::Blankslate.new(spacious: true, data: {hpc: true}) do |component| %>
  <%= component.with_visual_image(src: image_path("modules/copilot/signup-header.png"), alt: "Copilot Logo") %>
  <%= component.with_heading(tag: :h2).with_content("Oops, something went wrong") %>
  <%= component.with_description do %>
    Copilot is unavailable to you at this time.
  <% end %>
<% end %>
