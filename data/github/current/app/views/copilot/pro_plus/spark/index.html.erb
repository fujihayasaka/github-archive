<%
  page_info(
    title: "Sign up for GitHub Spark",
    class: "bgColor-inset",
    full_height_scrollable: true,
    full_height: true,
    hide_footer: logged_in?,
    marketing_page_theme: logged_in? ? nil : "dark",
    richweb: {
      title: "Sign up for GitHub Spark",
      description: "GitHub Spark gives you the smoothest path from idea to production—powered by the platform trusted by over 150 million developers.",
      url: T.must(request).original_url,
      image: image_path("modules/site/social-cards/github-spark.png"),
    },
  )

  has_active_pro_trial = copilot_user && copilot_user.has_trial_access?
%>

<%= render Primer::Alpha::Stack.new(direction: :vertical, align: :center, container: :md, px: [2, 4], py: [6, 7]) do %>
  <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :spacious, p: 4, border: true, border_radius: 3, bg: :default, w: :full) do %>
    <div data-hpc>
      <%= render Primer::Alpha::Stack.new(align: :center, mb: 2) do %>
        <div class="copilot-pro__head-glow">
          <%= render Primer::Beta::Octicon.new(:copilot, height: 24, color: :default) %>

          <div class="copilot-sparkle-icon">
            <%= render Primer::Beta::Octicon.new(:"sparkle-fill") %>
          </div>
        </div>
      <% end %>

      <%= render Primer::Beta::Heading.new(tag: :h1, text_align: :center, classes: "text-wrap-balance", style: "line-height: var(--base-size-40);") do %>
        Access Spark with <span style="white-space: nowrap;">Copilot Pro<span class="copilot-pro-plus__plus-glow">+</span></span>
      <% end %>
    </div>

    <hr class="my-0">

    <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
      <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4, display: :flex, align_items: :center) do %>
        What's included:
      <% end %>

      <ul class="list-style-none d-flex flex-column gap-2 fgColor-muted">
        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:"sparkle-fill", size: :small, color: :done, mr: 2, style: "margin-top: 2px;") %>

          <span>
            Up to 375 Spark messages included per month
          </span>
        </li>

        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:"sparkle-fill", size: :small, color: :done, mr: 2, style: "margin-top: 2px;") %>

          <span>
            The option to purchase more Spark messages as you go
          </span>
        </li>

        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:"sparkle-fill", size: :small, color: :done, mr: 2, style: "margin-top: 2px;") %>

          <span>
            10 active app building sessions at a time
          </span>
        </li>

        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:"sparkle-fill", size: :small, color: :done, mr: 2, style: "margin-top: 2px;") %>

          <span>
            Build an unlimited number of apps
          </span>
        </li>

        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:"sparkle-fill", size: :small, color: :done, mr: 2, style: "margin-top: 2px;") %>

          <span>
            Unlimited manual edits
          </span>
        </li>

        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:check, size: :small, color: :success, mr: 2, style: "margin-top: 2px;") %>

          <span>
            Access to <%= render Primer::Beta::Link.new(href: features_copilot_plans_path, target: "_blank", classes: "Link--inTextBlock fgColor-muted", style: "white-space: nowrap;") do %>Copilot Pro+<% end %> including coding agent (preview) and more models in chat
          </span>
        </li>
      </ul>
    <% end %>

    <hr class="my-0">

    <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
      <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4, display: :flex, align_items: :center, classes: "sr-only") do %>
        <span class="d-inline-block mr-3 rounded-3" style="width: 4px; height: 1rem; background: #75D36F"></span>
        Billing frequency
      <% end %>

      <%= form_with url: form_submit_path, method: :get do |f| %>
        <% tracking_params&.each do |key, value| %>
          <%= f.hidden_field key, value: value %>
        <% end %>

        <%= render "copilot/signup/billing_frequency_fields",
          payment_duration: payment_duration,
          monthly_price: Copilot::COPILOT_PRO_PLUS_MONTHLY_BASE_PRICE,
          yearly_price: Copilot::COPILOT_PRO_PLUS_YEARLY_BASE_PRICE
        %>

        <% if has_active_pro_trial %>
          <%= render Primer::Alpha::Banner.new(icon: :info, mt: 3) do %>
            Upgrading to Copilot Pro+ will end your current Pro trial. <%= render Primer::Beta::Link.new(href: "https://gh.io/copilot-pro-plus", target: "_blank", classes: "Link--inTextBlock", style: "white-space: nowrap;") do %>Learn more<% end %>
          <% end %>
        <% end %>

        <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, size: :large, block: true, mt: 3) do %>
          Upgrade now
        <% end %>
      <% end %>

      <% if logged_in? && current_user.member_or_billing_manager_for_any_organization? %>
        <%= render Primer::Beta::Text.new(tag: :p, color: :muted, font_size: 6, text_align: :center, mt: 1, mb: 0) do %>
          Part of an organization? Upgrade to <%= render Primer::Beta::Link.new(href: copilot_business_signup_path, classes: "Link--inTextBlock") do %>Copilot Business<% end %> to enable across teams.
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
