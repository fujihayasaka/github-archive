<%
  page_info(
    title: "Signup to GitHub Copilot Pro+",
    class: "bgColor-inset",
    full_height_scrollable: true,
    full_height: true,
    hide_footer: logged_in?,
    marketing_page_theme: logged_in? ? nil : "dark",
    richweb: {
      title: "GitHub Copilot Pro+",
      description: "Get AI-based suggestions and answers to your questions with GitHub Copilot, your AI pair programmer.",
      url: T.must(request).original_url,
      image: image_path("modules/site/social-cards/copilot-pro-plus.png"),
    },
  )

  has_active_pro_trial = copilot_user && copilot_user.has_trial_access?
  bonus_message_enabled = feature_enabled_globally_or_for_current_user?(:copilot_premium_requests_bonus_message)
%>

<%= render Primer::Alpha::Stack.new(direction: :vertical, align: :center, container: :md, px: [2, 4], py: [6, 7]) do %>
  <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :spacious, p: 4, border: true, border_radius: 3, bg: :default) do %>
    <% if feature_enabled_globally_or_for_current_user?(:site_copilot_pro_plus_flow_copy)%>
      <div data-hpc>
        <%= render Primer::Alpha::Stack.new(align: :center, mb: 2) do %>
          <div class="copilot-pro__head-glow">
            <%= render Primer::Beta::Octicon.new(:copilot, height: 24, color: :default) %>
          </div>
        <% end %>

        <%= render Primer::Beta::Heading.new(tag: :h1, text_align: :center, mb: 2, style: "line-height: var(--base-size-40);") do %>
          Get started with <span style="white-space: nowrap;">Copilot Pro<span class="copilot-pro-plus__plus-glow">+</span></span>
        <% end %>
      </div>

      <hr class="my-0">

      <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
        <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4, display: :flex, align_items: :center) do %>
          Everything in Copilot Pro with extra perks:
        <% end %>

        <ul class="list-style-none d-flex flex-column gap-2 fgColor-muted">
          <li class="d-flex flex-row">
            <%= render Primer::Beta::Octicon.new(:check, size: :small, color: :success, mr: 2, style: "margin-top: 2px;") %>

            <span>
              Access to all models, including Claude Opus 4, o3, and GPT-4.5
            </span>
          </li>

          <li class="d-flex flex-row">
            <%= render Primer::Beta::Octicon.new(:check, size: :small, color: :success, mr: 2, style: "margin-top: 2px;") %>

            <span>
              Up to 1,500 premium requests per month – 30x more premium requests with the option to buy more
            </span>
          </li>

          <li class="d-flex flex-row">
            <%= render Primer::Beta::Octicon.new(:check, size: :small, color: :success, mr: 2, style: "margin-top: 2px;") %>

            <span>
              Coding agent (preview)
            </span>
          </li>

          <% if feature_enabled_globally_or_for_current_user?(:site_spark_activation_flows) %>
            <li class="d-flex flex-row">
              <%= render Primer::Beta::Octicon.new(:"sparkle-fill", size: :small, color: :done, mr: 2, style: "margin-top: 2px;") %>

              <span>
                Access to <%= render Primer::Beta::Link.new(href: "/features/spark", target: "_blank", classes: "Link--inTextBlock fgColor-muted", style: "white-space: nowrap;") do %>GitHub Spark<% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if bonus_message_enabled && has_active_pro_trial %>
        <%= render Primer::Beta::Text.new(tag: :p, color: :muted, font_size: 5, text_align: :left, mt: 2, mb: 0) do %>
          <span class="text-bold">Bonus:</span> Premium requests will remain unlimited while billing is postponed. We’ll share an updated timeline once it’s available. <%= render Primer::Beta::Link.new(href: "https://gh.io/copilot-premium-requests", target: "_blank", classes: "Link--inTextBlock", style: "white-space: nowrap;") do %>Learn more<% end %>
        <% end %>
      <% end %>

      <hr class="my-0">
    <% else %>
      <div data-hpc>
        <%= render Primer::Alpha::Stack.new(align: :center, mb: 2) do %>
          <div class="copilot-pro__head-glow">
            <%= render Primer::Beta::Octicon.new(:copilot, height: 24, color: :default) %>
          </div>
        <% end %>

        <%= render Primer::Beta::Heading.new(tag: :h1, text_align: :center, mb: 2) do %>
          Get started with <span style="white-space: nowrap;">Copilot Pro<span class="copilot-pro-plus__plus-glow">+</span></span>
        <% end %>

        <%= render Primer::Beta::Text.new(tag: :p, color: :muted, font_size: 4, text_align: :center, mb: 0) do %>
          For developers who need maximum flexibility and extensive model choice <span class="d-sm-inline-block">with up to 1,500 premium requests per month</span>
        <% end %>

        <% if bonus_message_enabled && has_active_pro_trial %>
          <%= render Primer::Beta::Text.new(tag: :p, color: :muted, font_size: 5, text_align: :center, mt: 2, mb: 0) do %>
            <span class="text-bold">Bonus:</span> Premium requests will remain unlimited while billing is postponed. We’ll share an updated timeline once it’s available. <%= render Primer::Beta::Link.new(href: "https://gh.io/copilot-premium-requests", target: "_blank", classes: "Link--inTextBlock", style: "white-space: nowrap;") do %>Learn more<% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
      <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4, display: :flex, align_items: :center, classes: "sr-only") do %>
        <span class="d-inline-block mr-3 rounded-3" style="width: 4px; height: 1rem; background: #75D36F"></span>
        Billing frequency
      <% end %>

      <%= form_with url: form_submit_path, method: :get do |f| %>
        <% tracking_params&.each do |key, value| %>
          <%= f.hidden_field key, value: value %>
        <% end %>

        <%= render "copilot/signup/billing_frequency_fields",
          payment_duration: payment_duration,
          monthly_price: Copilot::COPILOT_PRO_PLUS_MONTHLY_BASE_PRICE,
          yearly_price: Copilot::COPILOT_PRO_PLUS_YEARLY_BASE_PRICE
        %>

        <% if bonus_message_enabled && !has_active_pro_trial %>
          <%= render Primer::Alpha::Banner.new(icon: :info, mt: 3) do %>
            <span class="text-bold">Bonus:</span> Premium requests will remain unlimited while billing is postponed. We’ll share an updated timeline once it’s available. <%= render Primer::Beta::Link.new(href: "https://gh.io/copilot-premium-requests", target: "_blank", classes: "Link--inTextBlock", style: "white-space: nowrap;") do %>Learn more<% end %>
          <% end %>
        <% end %>

        <% if has_active_pro_trial %>
          <%= render Primer::Alpha::Banner.new(icon: :info, mt: 3) do %>
            Upgrading to Copilot Pro+ will end your current Pro trial. <%= render Primer::Beta::Link.new(href: "https://gh.io/copilot-pro-plus", target: "_blank", classes: "Link--inTextBlock", style: "white-space: nowrap;") do %>Learn more<% end %>
          <% end %>
        <% end %>

        <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, size: :large, block: true, mt: 3) do %>
          Upgrade now
        <% end %>
      <% end %>

      <% if logged_in? && current_user.member_or_billing_manager_for_any_organization? %>
        <%= render Primer::Beta::Text.new(tag: :p, color: :muted, font_size: 6, text_align: :center, mt: 1, mb: 0) do %>
          Part of an organization? Upgrade to <%= render Primer::Beta::Link.new(href: copilot_business_signup_path, classes: "Link--inTextBlock") do %>Copilot Business<% end %> to enable across teams.
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
