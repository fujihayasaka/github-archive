<%# locals(payment_duration:, subscribe_path:, copilot_user:) -%>

<%
  copilot_price = payment_duration == "monthly" ? 3900 : 39000
  billing_period = payment_duration == "monthly" ? 1.month : 1.year
  next_billing_date = (Time.now + billing_period).strftime("%B %e, %Y")
%>

<%= render Primer::Box.new(p: 3, border: true, border_radius: 2, bg: :default) do %>
  <h2 class="sr-only">Subscription summary</h2>

  <%= render Primer::Alpha::Stack.new(direction: :horizontal, justify: :space_between) do %>
    <%= render Primer::Beta::Text.new(tag: :p, font_size: 5, font_weight: :bold, flex_grow: 0) do %>
      <span>GitHub Copilot Pro+</span>
    <% end %>

    <%= render Primer::Beta::Text.new(tag: :p, font_size: 5, font_weight: :bold) do %>
      <%= Billing::Money.new(copilot_price).format(no_cents_if_whole: false) %>
    <% end %>
  <% end %>

  <%= render Primer::Beta::Text.new(tag: :p, color: :default, font_size: 6) do %>
      You will be billed <%= Billing::Money.new(copilot_price).format(no_cents_if_whole: false) %> today. Your next payment will be <%= Billing::Money.new(copilot_price).format(no_cents_if_whole: false) %> on <%= next_billing_date %>.
  <% end %>

  <% if current_user.has_saved_trade_screening_record? && current_user.has_valid_payment_method? %>
    <% if current_user.trade_screening_record.country_code == "KR" %>
      <%= render Primer::Alpha::Dialog.new(title: "Privacy agreement", size: :medium_portrait) do |d| %>
        <% d.with_header(show_divider: true) do %>
          Privacy agreement
        <% end %>

        <% d.with_show_button(scheme: :primary, size: :large, block: true, mt: 3) { "Continue" } %>

        <% d.with_body do %>
          <%= render "copilot/pro_plus/subscribe_form", payment_duration: payment_duration, subscribe_path: subscribe_path, hide_submit: true %>
        <% end %>

        <% d.with_footer(show_divider: true) do %>
          <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, size: :large, block: true,
            form: "copilot-pro-plus-subscription-form",
            data: {
              target: "billing-checkout.submitButton",
              action: "click:billing-checkout#handleSubscriptionActivation"
            }
          ) do %>
            Activate GitHub Copilot Pro+
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <hr class="my-3">

      <%= render "copilot/pro_plus/subscribe_form", payment_duration: payment_duration, subscribe_path: subscribe_path %>
    <% end %>
  <% end %>
<% end %>
