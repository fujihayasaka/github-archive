<% page_info(
  title: "GitHub Copilot Pro+ Checkout",
  class: "bgColor-inset",
  full_height_scrollable: true,
  full_height: true,
  hide_footer: logged_in?,
) %>

<%= render Primer::Box.new(container: :lg, px: [2, 4], py: [5, 7]) do %>
  <%= render Primer::Beta::Heading.new(tag: :h1, mb: 2, font_size: 2, text_align: :left) do %>
    Subscribe to GitHub&nbsp;Copilot&nbsp;Pro+
  <% end %>

  <%= render "copilot/pro_plus/steps_list" %>

  <billing-checkout>
    <%= render Primer::Alpha::Layout.new(gutter: :spacious, first_in_source: :main) do |component| %>
      <% component.with_main do %>
        <%= render Copilot::ProPlusBillingComponent.new(
          user: current_user,
          payment_duration: payment_duration,
          return_to_path: return_to_path,
          tracking_params: tracking_params
        ) %>
      <% end %>

      <% component.with_sidebar(col_placement: :end, row_placement: :end, mt: [2, 2, 0]) do %>
        <%= render "copilot/pro_plus/billing_summary",
          payment_duration: payment_duration,
          subscribe_path: subscribe_path,
          copilot_user: copilot_user
        %>
      <% end %>
    <% end %>
  </billing-checkout>
<% end %>
