<%
  page_info(
    title: "GitHub Copilot Pro+ Checkout",
    class: "bgColor-inset",
    full_height_scrollable: true,
    full_height: true,
    hide_footer: logged_in?,
  )

  has_no_billing_and_payment_info = !current_user.has_saved_billing_information? && !current_user.has_valid_payment_method?
  has_billing_but_no_payment_info = current_user.has_saved_billing_information? && !current_user.has_valid_payment_method?
  has_billing_and_payment_info = current_user.has_saved_billing_information? && current_user.has_valid_payment_method?
  billing_info_exists_without_errors = billing_info_exists_without_errors?(current_user)

  steps = [
    { title: "Billing information", is_current: has_no_billing_and_payment_info },
    { title: "Payment method", is_current: has_billing_but_no_payment_info },
    { title: "Review", is_current: has_billing_and_payment_info }
  ]

  if FeatureFlag.vexi.enabled?(:copilot_pro_plus_premium_requests, current_user, default: false)
    steps.insert(0, { title: "Premium request settings", is_current: premium_requests.blank? })
    steps[1][:is_current] = premium_requests.present? && has_no_billing_and_payment_info
    steps[2][:is_current] = premium_requests.present? && has_billing_but_no_payment_info
    steps[3][:is_current] = premium_requests.present? && has_billing_and_payment_info
  end

%>

<%= render Primer::Box.new(container: :lg, px: [3, 4], py: [5, 7]) do %>
  <%= render Primer::Beta::Heading.new(tag: :h1, mb: 2, font_size: 2, text_align: :left, data: {hpc: true}) do %>
    Subscribe to <span style="white-space: nowrap;">GitHub Copilot Pro+</span>
  <% end %>

  <% if copilot_user.use_token_based_billing? %>
    <p>For developers who need maximum flexibility and extensive model choice.</p>
  <% else %>
    <p>For developers who need maximum flexibility and extensive model choice with up to 1,500 premium requests per month.</p>
  <% end %>

  <%= render "copilot/signup/payment_processing_notice" %>
  <%= render "copilot/signup/rbi_manual_payment_notice", user: current_user, product_name: "GitHub Copilot Pro+" %>

  <%= render "copilot/signup/steps_list", steps: steps %>

  <billing-checkout data-pro-plus="true" data-payment-period="<%= payment_duration %>" data-dynamic-payment-period-enabled="true">
    <%= render Primer::Alpha::Layout.new(gutter: :spacious, first_in_source: :main) do |component| %>
      <% component.with_main do %>
        <%= render Copilot::ProPlusBillingComponent.new(
          user: current_user,
          payment_duration: payment_duration,
          premium_requests: premium_requests,
          return_to_path: return_to_path,
          tracking_params: tracking_params
        ) %>
      <% end %>

      <% component.with_sidebar(col_placement: :end, row_placement: :end, mt: [2, 2, 0]) do %>
        <% if FeatureFlag.vexi.enabled?(:copilot_cfi_pay_to_continue, current_user, default: false) %>
          <%= render "copilot/pro_plus/billing_summary_cfi",
            subscribe_path: subscribe_path,
            copilot_user: copilot_user,
            billing_info_exists_without_errors: billing_info_exists_without_errors
          %>
        <% else %>
          <%= render "copilot/pro_plus/billing_summary",
            payment_duration: payment_duration,
            subscribe_path: subscribe_path,
            copilot_user: copilot_user,
            billing_info_exists_without_errors: billing_info_exists_without_errors
          %>
        <% end %>
      <% end %>
    <% end %>
  </billing-checkout>
<% end %>
