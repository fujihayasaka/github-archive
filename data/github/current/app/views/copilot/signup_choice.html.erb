<%# locals(copilot_user:, form_submit_path:, tracking_params:, signup_duration:) -%>
<% page_info title: "Signup to GitHub Copilot" %>
<%= render Copilot::SignupComponent.new do |signup_component| %>
  <% signup_component.with_new_heading do %>
    <%= render(Primer::Beta::Text.new(tag: :span)) { "Try GitHub Copilot" } %>
    <%= render(Primer::Beta::Text.new(tag: :span, color: :accent)) { "Free" } %>
  <% end %>
  <% signup_component.with_main do %>
    <% if restricted || has_trade_restriction %>
      <%= render(TradeCompliance::TradeScreeningRestrictionNoticeComponent.new(
        target: copilot_user.user_object,
        title: "You cannot proceed",
        description: restricted.present? ? "You are restricted from using Copilot Free." : nil,
        class_name: "container-sm",
        feature_type: :copilot,
      )) %>
    <% else %>
      <%= render(Primer::Box.new(bg: :default, mb: 5, border: false, container: :xl, data: {hpc: true})) do %>
        <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, col: 12, style: "grid-gap: 16px")) do %>
          <%= render(Primer::Beta::BorderBox.new(col: 6, mx: :auto)) do |component| %>
            <% component.with_body(border_bottom: 0) do %>
              <%= render(Primer::Beta::Text.new(tag: :p, mb: 3, mt: 2)) do %>
                <%= render(Primer::Beta::Text.new(font_size: 4, color: :accent, font_weight: :bold, mt: 0, mb: 0)) { "What's included?" } %>
              <% end %>
              <ul style="list-style: none">
                <li class="mb-3">
                  <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1, color: :accent)) %>
                  <%= render(Primer::Beta::Text.new) { "2,000 in-editor code completions" } %>
                </li>
                <li class="mb-3">
                  <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1, color: :accent)) %>
                  <%= render(Primer::Beta::Text.new) { "50 interactions with Copilot Chat in GitHub and your IDE" } %>
                </li>
                <li class="mb-3">
                  <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1, color: :accent)) %>
                  <%= render(Primer::Beta::Text.new) { "Access to the latest models, like Claude 3.5 Sonnet and OpenAI o1" } %>
                </li>
                <li class="mb-5">
                  <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1, color: :accent)) %>
                  <%= render(Primer::Beta::Text.new) { "Works with VS Code, JetBrains IDEs, Neovim, Xcode, and more" } %>
                </li>
              </ul>
              <hr>
              <%= render(Primer::Beta::Text.new(tag: :p, mt: 5)) do %>
                <%= render(Primer::Beta::Text.new(color: :subtle, font_weight: :light, font_size: :small)) do %>
                  By continuing, you agree to our
                  <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_SPECIFIC_TERMS, underline: true)) do %>
                    Terms and Conditions
                  <% end %>
                  and grant your IDE permission to access your GitHub account for Copilot. Copilot may show public code
                  suggestions and use telemetry to improve the product. You may change these settings at any time.
                <% end %>
              <% end %>
              <%= render(Primer::Box.new(display: :flex, direction: :column, justify_content: :center, container: :sm, pr: 10, pl: 10, mt: 3)) do %>
                <%= form_with url: form_submit_path do |f| %>
                  <%= render(Primer::Beta::Button.new(
                    type: :submit,
                    scheme: :primary,
                    block: true,
                  )) do |_c|
                    "Start using Copilot Free"
                  end %>
                <% end %>
                <%= render(Primer::Beta::Text.new(tag: :span, color: :subtle, mt: 3, mb: 2, font_weight: :light, text_align: :center, font_size: :small)) do %>
                  or
                  <% if eligible_for_trial %>
                    <%= render(Primer::Beta::Link.new(href: ci_path)) do %>
                      try Copilot Pro free
                    <% end %>
                    for 30 days
                  <% else %>
                    signup for
                    <%= render(Primer::Beta::Link.new(href: ci_path)) do %>
                      Copilot Pro
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
