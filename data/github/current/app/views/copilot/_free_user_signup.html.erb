<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%= render(Primer::Box.new(bg: :transparent, classes: "tmp-mt-3")) do %>
  <%= render(Primer::Box.new(bg: :default, border_radius: 2, border: true, box_shadow: :medium, container: :sm, classes: "tmp-p-4 tmp-mb-5")) do %>
    <%= render(Primer::Beta::Heading.new(tag: :h2, classes: "tmp-mb-3")) { "Use GitHub Copilot for free" } %>
    <%= render(Primer::Box.new(bg: :done, border: true, border_radius: 3, classes: "tmp-p-3 tmp-mb-3")) { "🎉 Congratulations! You are eligible to use GitHub #{product_name} for free." } %>
    <ul class="list-style-none hanging-icon-list tmp-mb-4 tmp-mt-3 color-fg-muted" >
      <li class="tmp-mb-3"><%= render(Primer::Beta::Octicon.new(:check, color: :success, style: "margin-top: 2")) %> Get code suggestions in more than a dozen coding languages including Python, JavaScript, TypeScript, Go, and Ruby</li>
      <li class="tmp-mb-3"><%= render(Primer::Beta::Octicon.new(:check, color: :success, style: "margin-top: 2")) %> Plugs into IDEs including VS Code, Visual Studio, Neovim, and JetBrains</li>
    </ul>
    <%= render(Primer::Beta::Heading.new(tag: :h3, classes: "tmp-mb-3")) { "Eligibility requirements" } %>
    <p class="color-fg-muted">GitHub Copilot is free to use for open source maintainers, teachers and students. We check eligibility monthly, per our policies.</p>
    <%= form_with url: form_submit_path do |f| %>
      <%= render(Primer::ButtonComponent.new(scheme: :primary, type: :submit, w: :full, classes: "btn-medium tmp-mt-4")) { "Get access to GitHub Copilot" } %>
    <% end %>
  <% end %>
<% end %>
