<%
  error ||= false
  view ||= nil
%>
<%= render(Primer::Box.new(color: :muted, font_weight: :light, classes: "tmp-mb-4 tmp-mt-4")) do %>
  <% if view == :onboarding %>
    <p class="tmp-mb-3">You can change these at any time from your account settings.</p>
  <% end %>
<% end %>

<%= render(Copilot::Policies::UserSettingsComponent.new(copilot_user: copilot_user, submit_path: form_submit_path, error: error, view: view, error_message: error_message)) %>

<% if view == :settings %>
  <%= render(Primer::Box.new(mt: 1, font_size: :small, color: :muted, font_weight: :light, classes: "tmp-mb-4")) do %>
    <%= render(Primer::Beta::Octicon.new(icon: :info)) %>
    It can take up to 30 minutes for the changes to take effect. Restart your code editor for the changes to take effect immediately.
  <% end %>
<% end %>
