<%#
  Shown when an India RBI customer is sent back to the checkout page because their manual payment
  couldn't be confirmed in time (see billing/zuora.ts and Billing::ManualPaymentRedirect). It tells
  them their payment is still processing and to activate again once it finishes. Renders nothing
  unless the payment-processing flag is present on the request.
-%>
<% if params[Billing::ManualPaymentRedirect::PAYMENT_PROCESSING_PARAM].present? %>
  <%= render(Primer::Alpha::Banner.new(
    icon: :info,
    scheme: :default,
    test_selector: "rbi-payment-processing-notice",
    classes: "tmp-mb-4",
  )) do %>
    <%= Billing::ManualPaymentRedirect::FINALIZATION_RETRY_MESSAGE %>
  <% end %>
<% end %>
