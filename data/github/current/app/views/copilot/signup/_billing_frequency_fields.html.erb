<%# locals(payment_duration:, monthly_price: 10, yearly_price: 100, is_trial: false) -%>

<%
  is_trial ||= false
  yearly_saving = (monthly_price * 12) - yearly_price
%>

<billing-duration data-bg-color-class="bgColor-muted" data-border-color-class="copilot-signup__billing-frequency--active-border-color">
  <fieldset class="copilot-signup__billing-frequency" role="radiogroup">
    <legend class="sr-only">Choose your billing frequency</legend>

    <label
      for="pay-monthly"
      class="radio-label rounded-2 p-3 width-full <%= payment_duration == "monthly" ? " bgColor-muted copilot-signup__billing-frequency--active-border-color" : "" %>"
      data-target="billing-duration.monthlyRadioInput"
      data-action="click:billing-duration#select"
    >
      <div class="mb-3">
        <input name="payment_duration" type="radio" value="monthly"
          class="js-payment-method radio-input m-0 mr-1 float-none"
          data-selected-tab="pay-monthly"
          id="pay-monthly"
          data-action="click:billing-checkout#monthlyPaymentSelected"
          <%= payment_duration == "monthly" ? "checked" : "" %>
        >

        <%= render Primer::Beta::Text.new(tag: :span, font_weight: :bold, font_size: 5) do %>
          Pay monthly
        <% end %>
      </div>

      <span class="h2"><%= Billing::Money.new(monthly_price * 100).format(no_cents_if_whole: false) %></span> <span class="text-light color-fg-muted text-small">USD</span> <span class="text-light color-fg-muted"> / month <% if is_trial %>after trial<% end %></span>
    </label>

    <label
      for="pay-yearly"
      class="radio-label rounded-2 p-3 width-full <%= payment_duration == "yearly" ? " bgColor-muted copilot-signup__billing-frequency--active-border-color" : "" %>"
      data-target="billing-duration.yearlyRadioInput"
      data-action="click:billing-duration#select"
    >
      <%= render Primer::Alpha::Stack.new(direction: :horizontal, justify: :space_between, mb: 3) do %>
        <div>
          <input name="payment_duration" type="radio" value="yearly"
            class="js-payment-method radio-input m-0 mr-1 float-none"
            data-selected-tab="pay-yearly"
            id="pay-yearly"
            data-action="click:billing-checkout#yearlyPaymentSelected"
            <%= payment_duration == "yearly" ? "checked" : "" %>
          >

          <%= render Primer::Beta::Text.new(tag: :span, font_weight: :bold, font_size: 5) do %>
            Pay yearly
          <% end %>
        </div>

        <%= render Primer::Beta::Label.new(tag: :span, scheme: :primary, size: :medium, inline: true) do %>
          Save <%= Billing::Money.new(yearly_saving * 100).format(no_cents_if_whole: false) %>
        <% end %>
      <% end %>

      <span class="h2"><%= Billing::Money.new(yearly_price * 100).format(no_cents_if_whole: false) %></span> <span class="text-light color-fg-muted text-small">USD</span> <span class="text-light color-fg-muted"> / year <% if is_trial %>after trial<% end %></span>
    </label>
  </fieldset>
</billing-duration>
