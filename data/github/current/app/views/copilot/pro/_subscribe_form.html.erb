<%# locals(payment_duration:, subscribe_path:, hide_submit: false) %>
<% hide_submit ||= false %>

<%= form_with(url: subscribe_path, id: "copilot-pro-subscription-form") do |f| %>
  <%= f.hidden_field "success_path", value: success_path if success_path.present? %>
  <%= f.hidden_field "return_to_path", value: return_to_path if return_to_path.present? %>

  <%= f.hidden_field "payment_duration", value: payment_duration %>
  <%= f.hidden_field "user_contact_info[email]", value: current_user.email %>
  <%= f.hidden_field "user_contact_info[first_name]", value: current_user.billing_contact&.first_name %>
  <%= f.hidden_field "user_contact_info[last_name]", value: current_user.billing_contact&.last_name %>
  <%= f.hidden_field "user_contact_info[country]", value: current_user.billing_contact&.country_code, class: "js-consent-experience-country-select" %>

  <%= render_react_partial name: "consent-experience", props: {
    fieldName: "user_contact_info[marketing_consent]",
    initialCountry: current_user.billing_contact&.country_code,
    countryFieldSelector: ".js-consent-experience-country-select",
    privacyStatementHref: GitHub.privacy_statement_url,
    emailSubscriptionSettingsLinkHref: new_settings_link_request_path,
    exampleFields: ["name", "email address", "country"],
    listExampleFields: true,
    hasPhone: false,
    formControlClass: "form-checkbox f6 text-normal fgColor-muted mt-0 mb-3",
    labelClass: "f6 text-normal fgColor-muted",
    noticeClass: "f6 text-normal fgColor-muted #{current_user.billing_contact&.country_code == "KR" ? " mb-0 mt-3" : "my-3"}",
    emphasizedTextForKoreaClass: "text-bold f4"
  } %>

  <% unless hide_submit %>
    <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, size: :large, block: true,
      data: {
        target: "billing-checkout.submitButton",
        action: "click:billing-checkout#handleSubscriptionActivation"
      }
    ) do %>
      Activate now
    <% end %>
  <% end %>
<% end %>
