<%# locals(payment_duration:) -%>

<billing-duration data-bg-color-class="bgColor-muted" data-border-color-class="copilot-pro__billing-frequency--active-border-color">
  <fieldset class="copilot-pro__billing-frequency" role="radiogroup">
    <legend class="sr-only">Choose your billing frequency</legend>

    <label
      for="pay-monthly"
      class="radio-label rounded-2 p-3 width-full <%= payment_duration == "monthly" ? " bgColor-muted copilot-pro__billing-frequency--active-border-color" : "" %>"
      data-target="billing-duration.monthlyRadioInput"
      data-action="click:billing-duration#select"
    >
      <div class="mb-3">
        <input name="payment_duration" type="radio" value="monthly"
          class="js-payment-method radio-input m-0 mr-1 float-none"
          data-selected-tab="pay-monthly"
          id="pay-monthly"
          <%= payment_duration == "monthly" ? "checked" : "" %>
        >

        <%= render Primer::Beta::Text.new(tag: :span, font_weight: :bold, font_size: 5) do %>
          Monthly plan
        <% end %>
      </div>

      <span class="h2">$10</span> <span class="text-light color-fg-muted text-small">USD</span> <span class="text-light color-fg-muted"> /month </span>
    </label>

    <label
      for="pay-yearly"
      class="radio-label rounded-2 p-3 width-full <%= payment_duration == "yearly" ? " bgColor-muted copilot-pro__billing-frequency--active-border-color" : "" %>"
      data-target="billing-duration.yearlyRadioInput"
      data-action="click:billing-duration#select"
    >
      <%= render Primer::Alpha::Stack.new(direction: :horizontal, justify: :space_between, mb: 3) do %>
        <div>
          <input name="payment_duration" type="radio" value="yearly"
            class="js-payment-method radio-input m-0 mr-1 float-none"
            data-selected-tab="pay-yearly"
            id="pay-yearly"
            <%= payment_duration == "yearly" ? "checked" : "" %>
          >

          <%= render Primer::Beta::Text.new(tag: :span, font_weight: :bold, font_size: 5) do %>
            Yearly plan
          <% end %>
        </div>

        <%= render Primer::Beta::Label.new(tag: :span, scheme: :primary, size: :medium, inline: true) do %>
          Save $20
        <% end %>
      <% end %>

      <span class="h2">$100</span> <span class="text-light color-fg-muted text-small">USD</span> <span class="text-light color-fg-muted"> /year </span>
    </label>
  </fieldset>
</billing-duration>
