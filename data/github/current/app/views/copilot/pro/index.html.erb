<%
  page_info(
    title: "Signup to GitHub Copilot Pro",
    class: "bgColor-inset",
    full_height_scrollable: true,
    full_height: true,
    hide_footer: logged_in?,
    marketing_page_theme: logged_in? ? nil : "dark",
    richweb: {
      title: "GitHub Copilot Pro · Try free for 30 days",
      description: "Get AI-based suggestions and answers to your questions with GitHub Copilot, your AI pair programmer. Try free for 30 days with unlimited access and extra perks.",
      url: T.must(request).original_url,
      image: image_path("modules/site/social-cards/copilot-pro.png"),
    },
  )

  is_eligible_for_trial = !logged_in? || copilot_user.eligible_for_trial?
  marketing_gpt5_ga_enabled = user_or_global_feature_enabled?(:marketing_gpt5_ga_updates)
%>

<%= render Primer::Alpha::Stack.new(direction: :vertical, align: :center, container: :md, px: [2, 4], py: [6, 7]) do %>
  <%= render Primer::Alpha::Stack.new(direction: :vertical, w: :full, gap: :spacious, p: 4, border: true, border_radius: 3, bg: :default) do %>
    <div data-hpc>
      <%= render Primer::Alpha::Stack.new(align: :center, mb: 2) do %>
        <div class="copilot-pro__head-glow">
          <%= render Primer::Beta::Octicon.new(:copilot, height: 24, color: :default) %>
        </div>
      <% end %>

      <%= render Primer::Beta::Heading.new(tag: :h1, text_align: :center, style: "line-height: var(--base-size-40);") do %>
        <%= is_eligible_for_trial ? "Try Copilot Pro for 30 days free" : "Get started with Copilot Pro" %>
      <% end %>
    </div>

    <hr class="my-0">

    <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
      <%= render Primer::Beta::Heading.new(tag: :h2, font_size: 4, display: :flex, align_items: :center) do %>
        Everything in Copilot Free and:
      <% end %>

      <ul class="list-style-none d-flex flex-column gap-2 fgColor-muted">
        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:check, size: :small, color: :success, mr: 2, style: "margin-top: 2px;") %>

          <% if marketing_gpt5_ga_enabled %>
            <span>
              Unlimited agent mode and chat with GPT-5<sup><%= render Primer::Beta::Link.new(href: "https://docs.github.com/copilot/managing-copilot/monitoring-usage-and-entitlements/about-premium-requests", target: "_blank", classes: "Link--inTextBlock", style: "white-space: nowrap;") do %>*<% end %></sup>
            </span>
          <% else %>
            <span>
              Unlimited agent mode and chat with GPT-4.1<sup><%= render Primer::Beta::Link.new(href: "https://docs.github.com/copilot/managing-copilot/monitoring-usage-and-entitlements/about-premium-requests", target: "_blank", classes: "Link--inTextBlock", style: "white-space: nowrap;") do %>*<% end %></sup>
            </span>
          <% end %>
        </li>

        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:check, size: :small, color: :success, mr: 2, style: "margin-top: 2px;") %>

          <span>
            Unlimited code completions<sup><%= render Primer::Beta::Link.new(href: "https://docs.github.com/copilot/managing-copilot/monitoring-usage-and-entitlements/about-premium-requests", target: "_blank", classes: "Link--inTextBlock", style: "white-space: nowrap;") do %>*<% end %></sup>
          </span>
        </li>

        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:check, size: :small, color: :success, mr: 2, style: "margin-top: 2px;") %>

          <span>
            Access to Anthropic Claude Sonnet 4, GPT-5, Gemini 2.5 Pro, and more
          </span>
        </li>

        <li class="d-flex flex-row">
          <%= render Primer::Beta::Octicon.new(:check, size: :small, color: :success, mr: 2, style: "margin-top: 2px;") %>

          <span>
            300 premium requests to use the latest models and code review
          </span>
        </li>

        <% if FeatureFlag.vexi.enabled?(:site_spark_pro_activation_flow, current_user, default: false) %>
          <li class="d-flex flex-row">
            <%= render Primer::Beta::Octicon.new(:"sparkle-fill", size: :small, color: :done, mr: 2, style: "margin-top: 2px;") %>

            <span>
              Access to <%= render Primer::Beta::Link.new(href: "/features/spark", target: "_blank", classes: "Link--inTextBlock fgColor-muted", style: "white-space: nowrap;") do %>GitHub Spark<% end %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= render Primer::Alpha::Stack.new(direction: :vertical, gap: :normal) do %>
      <%= form_with url: form_submit_path, method: :get do |f| %>
        <% tracking_params&.each do |key, value| %>
          <%= f.hidden_field key, value: value %>
        <% end %>

        <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, size: :large, block: true, mt: 3) do %>
          <% if logged_in? && copilot_user.has_limited_access? %>
            Upgrade now
          <% else %>
            Try now
          <% end %>
        <% end %>
      <% end %>

      <% if logged_in? && current_user.member_or_billing_manager_for_any_organization? %>
        <%= render Primer::Beta::Text.new(tag: :p, color: :muted, font_size: 6, text_align: :center, mt: 1, mb: 0) do %>
          Part of an organization? Upgrade to <%= render Primer::Beta::Link.new(href: copilot_business_signup_path, classes: "Link--inTextBlock") do %>Copilot Business<% end %> to enable across teams.
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
