<%= render(Primer::Beta::Details.new(overlay: :default, position: :relative, display: :inline_block)) do |details| %>
  <% details.with_summary(classes: "btn-link p-1", "aria-label": aria_label, role: "button") do %>
    <%= render(Primer::Beta::Octicon.new(:info, size: :small, color: :muted)) %>
  <% end %>
  <% details.with_body do %>
    <%= render(Primer::Box.new(position: :absolute, mb: 1, style: "z-index: 100; bottom: 100%; left: 50%; transform: translateX(-50%);")) do %>
      <%= render(Primer::Beta::Popover.new(left: true, right: true)) do |popover| %>
        <% popover.with_heading { heading } %>
        <% popover.with_body(caret: :bottom, p: 3, style: "width: 280px;") do %>
          <%= body %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
