<%= render(Primer::Beta::BorderBox.new(padding: :default, )) do |component| %>
  <%= component.with_header(scheme: :warning) do |header| %>
    <% header.with_title(tag: :h2) do %>
      Quotas
    <% end %>
  <% end %>
  <%= component.with_row(scheme: :default) do %>
    <% if limited_user.present? && limited_user.subscribed? %>
      <%= primer_form_with(url: copilot_quota_update_path(this_user), method: :put) do |f| %>
        <%= render(Primer::Alpha::TextField.new(hidden: true, label: "", name: "mode", value: "quotas")) %>
        <% ::Copilot::LimitedUser::ALLOWED_FEATURES.each do |feature| %>
          <div>
            <%= render(
              Primer::Alpha::TextField.new(
                name: "quotas[#{feature}]",
                label: "#{feature.titleize} Quota",
                value: limited_user.feature_quota_remaining(feature: feature),
              )
            ) %>
          </div>
        <% end %>
        <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, display: :inline, mr: 2, mt: 2, "aria-label": "Save Quotas") do %>
          Save quotas
        <% end %>
      <% end %>
    <% else %>
      <% if copilot_user.has_cfb_access? || copilot_user.has_cfe_access? %>
        This user is subscribed to Copilot Business or Copilot Enterprise. They cannot be used for testing.
      <% else %>
        This user isn't subscribed to Free Limited so we can't do the whole quota thing. If you would like, you can subscribe the user to Copilot Free by clicking the button below.
        <hr>
        <%= primer_form_with(url: copilot_quota_update_path(this_user), method: :put) do |f| %>
          <%= render(Primer::Beta::ButtonGroup.new) do |button_group| %>
            <% button_group.with_button(scheme: :success, type: :submit, display: :inline, mr: 2, mt: 2, name: "mode", value: "subscribe") do %>
              <% if copilot_user.has_cfi_access? %>
                Downgrade to Copilot Free
              <% else %>
                Subscribe to Copilot Free
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
