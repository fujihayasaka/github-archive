<%= render(Primer::Beta::BorderBox.new(padding: :default, )) do |component| %>
  <%= component.with_header(scheme: :warning) do |header| %>
    <% header.with_title(tag: :h2) do %>
      Reset Quotas
    <% end %>
  <% end %>

  <%= component.with_row(scheme: :default) do %>
    <% if (limited_user.present? && limited_user.subscribed?) || copilot_user.consumptive_user? %>
      <%= primer_form_with(url: copilot_quota_update_path(this_user), method: :put) do |f| %>
        <%= render(Primer::Alpha::TextField.new(hidden: true, label: "", name: "mode", value: "quotas")) %>
        <% if user_or_global_feature_enabled?(:copilot_premium_quota_reset) %>
          <% copilot_user.quota_snapshots.each do |feature, details| %>
            <% next if Copilot::Users::PremiumInteractions::ALLOWED_INTERVAL_FEATURES.include?(feature) %>
            <% if copilot_user.can_access_feature?(feature) %>
              <%= render(
                Primer::Alpha::TextField.new(
                  name: "quotas[#{feature}]",
                  label: "#{feature.titleize} Quota Remaining (of #{details[:entitlement]} entitlement)",
                  value: details[:quota_remaining],
                  data: { test_selector: "quotas_#{feature}" },
                )
              ) %>
            <% end %>
          <% end %>
        <% elsif limited_user.present? && limited_user.subscribed? %>
          <% ::Copilot::LimitedUser::ALLOWED_FEATURES.each do |feature| %>
            <div>
              <%= render(
                Primer::Alpha::TextField.new(
                  name: "quotas[#{feature}]",
                  label: "#{feature.titleize} Quota",
                  value: limited_user.feature_quota_remaining(feature: feature),
                )
              ) %>
            </div>
          <% end %>
        <% end %>
        <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, display: :inline, mr: 2, mt: 2, "aria-label": "Save Quotas") do %>
          Save quotas
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<hr>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Quotas Snapshot
    <% end %>
  <% end %>

  <% snapshot_rows = [
    ["chat", "Chat Feature"],
    ["completions", "Completions Feature"],
    ["premium_interactions", "Premium Interactions"],
  ] %>

  <% snapshot_rows.each do |feature, title| %>
    <% details = copilot_user.quota_snapshots.fetch(feature, {}) %>

    <%= component.with_row(data: { test_selector: "quota_snapshot_#{feature}" }) do %>
      <div class="d-flex flex-items-center">
        <span class="mr-2 text-bold"><%= title %>:</span>
        <div class="d-flex flex-items-center">
          <% if has_limited_access? && limited_user&.subscribed? && feature == "premium_interactions" %>
            <%= render Primer::Beta::Label.new(scheme: :danger) do %>
              Not Applicable
            <% end %>
          <% elsif details[:unlimited] %>
            <%= render Primer::Beta::Label.new(scheme: :success) do %>
              Unlimited
            <% end %>
          <% else %>
            <div class="d-flex flex-row">
              <%= render Primer::Beta::Label.new(scheme: :default) do %>
                <% if (has_limited_access? && tbb_result) || details[:token_based_billing] %>
                  <%= "#{details[:entitlement]} AIC" %>
                <% else %>
                  <%= "#{details[:entitlement]} PRU" %>
                <% end %>
              <% end %>
              <%= render Primer::Beta::Text.new(tag: :span, classes: "ml-2", color: :muted) do %>
                <%= " Percent Remaining: #{details[:percent_remaining]} %" %>
              <% end %>
              <span class="ml-2 color-fg-muted d-inline-flex flex-items-center">
                | Overage Permitted:
                <%= render Primer::Beta::Octicon.new(
                  icon: details[:overage_permitted] ? "check" : "x",
                  color: details[:overage_permitted] ? :success : :danger,
                  ml: 1,
                ) %>
              </span>
              <span class="ml-2 color-fg-muted d-inline-flex flex-items-center">
                | Has Quota:
                <%= render Primer::Beta::Octicon.new(
                  icon: details[:has_quota] ? "check" : "x",
                  color: details[:has_quota] ? :success : :danger,
                  ml: 1,
                ) %>
              </span>
              <% if !has_limited_access? %>
                <span class="ml-2 color-fg-muted d-inline-flex flex-items-center">
                  | UBB:
                  <%= render Primer::Beta::Octicon.new(
                    icon: details[:token_based_billing] ? "check" : "x",
                    color: details[:token_based_billing] ? :success : :danger,
                    ml: 1,
                  ) %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
