<% page_info title: "Quotas for #{this_user.display_login}" %>
<%= render(Primer::Alpha::Layout.new) do |component| %>
  <%= component.with_main(p: 6) do %>
    <% if limited_user.present? %>
      <% if limited_user.subscribed? %>
        <%= primer_form_with(url: copilot_quota_update_path(this_user), method: :put) do |f| %>
          <%= render(Primer::Alpha::TextField.new(hidden: true, label: "", name: "mode", value: "quotas")) %>
          <% ::Copilot::LimitedUser::ALLOWED_FEATURES.each do |feature| %>
            <div>
              <%= render(
                Primer::Alpha::TextField.new(
                  name: "quotas[#{feature}]",
                  label: "#{feature.titleize} Quota",
                  value: limited_user.feature_quota_remaining(feature: feature),
                )
              ) %>
            </div>
          <% end %>
          <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, display: :inline, mr: 2, mt: 2, "aria-label": "Save Quotas") do %>
            Save quotas
          <% end %>
        <% end %>
        <hr>
        <%= primer_form_with(url: copilot_quota_update_path(this_user), method: :put) do |f| %>
          <%= render(Primer::Alpha::TextField.new(hidden: true, label: "", name: "mode", value: "unsubscribe")) %>
          <%= render Primer::Beta::Button.new(scheme: :danger, type: :submit, display: :inline, mr: 2, mt: 2, "aria-label": "Unsubscribe Limited User") do %>
            Unsubscribe Limited User
          <% end %>
        <% end %>
      <% else %>
        <%= primer_form_with(url: copilot_quota_update_path(this_user), method: :put) do |f| %>
          <%= render(Primer::Alpha::TextField.new(hidden: true, label: "", name: "mode", value: "subscribe")) %>
          <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, display: :inline, mr: 2, mt: 2, "aria-label": "Subscribe Limited User") do %>
            Subscribe Limited User
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      This user ain't subscribed to Free Limited so we can't do the whole quota thing.
      <hr>
      <%= primer_form_with(url: copilot_quota_update_path(this_user), method: :put) do |f| %>
        <%= render(Primer::Alpha::TextField.new(hidden: true, label: "", name: "mode", value: "subscribe")) %>
        <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit, display: :inline, mr: 2, mt: 2, "aria-label": "Subscribe Limited User") do %>
          Subscribe Limited User
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= component.with_sidebar(p: 6) do %>
    <%= render(Primer::Beta::BorderBox.new(padding: :default, )) do |component| %>
      <%= component.with_header(scheme: :warning) do |header| %>
          Monthly Quotas
      <% end %>
      <% Copilot::LimitedUser.monthly_quotas.each do |quota, value| %>
        <%= component.with_row(scheme: :default) { "#{quota.titleize} Quota: #{value}" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>


