<% page_info title: "Quotas for #{this_user.display_login}" %>
<%
  tbb_result, tbb_err = copilot_user.calculate_use_token_based_billing
  is_cb_ce_sku = copilot_user.has_ce_access? || copilot_user.has_cb_access?
%>
<%= render(Primer::Alpha::Layout.new) do |component| %>
  <%= component.with_main(p: 6) do %>
    <%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
      <%= component.with_header(scheme: :warning) do |header| %>
        <% header.with_title(tag: :h2) do %>
          User Details
        <% end %>
      <% end %>
      <%= component.with_row(scheme: :default) do %>
        <div class="d-flex flex-justify-between">
          <div class="pr-2">
            <div class="d-flex flex-items-start flex-items-center">
              <span class="mr-2">Username:</span>
              <span id="display_login" class="pr-1"><%= this_user.display_login %></span>
            </div>
          </div>
        </div>
      <% end %>
      <%= component.with_row(scheme: :default) do %>
        <div class="d-flex flex-justify-between">
          <div class="pr-2">
            <div class="d-flex flex-items-start flex-items-center">
              <span class="mr-2">Access Type:</span>
              <span id="display_login" class="pr-1"><%= copilot_user.access_type %></span>
            </div>
          </div>
        </div>
      <% end %>
      <%= component.with_row(scheme: :default) do %>
        <div class="d-flex flex-justify-between">
          <div class="pr-2">
            <div class="d-flex flex-items-start flex-items-center">
              <span class="mr-2">Token Based Billing:</span>
              <span id="token_billing_status" class="pr-1"><%
                if tbb_result %>
                  <%= render Primer::Beta::Label.new(scheme: :success) do %>
                    Active
                  <% end %>
                <% elsif tbb_err.present? %>
                  <%= render Primer::Beta::Label.new(scheme: :danger) do %>
                    <%= tbb_err %>
                  <% end %>
                <% else %>
                  <%= render Primer::Beta::Label.new(scheme: :default) do %>
                    Disabled
                  <% end %>
                <% end %>
              </span>
            </div>
          </div>
        </div>
      <% end %>
      <%= component.with_row(scheme: :default) do %>
        <div class="d-flex flex-justify-between">
          <div class="pr-2">
            <div class="d-flex flex-items-start flex-items-center">
              <span class="mr-2">Analytics Tracking ID:</span>
              <span id="analytics_tracking_id" class="pr-1"><%= this_user.analytics_tracking_id %></span>
              <%= render(Primer::Beta::ClipboardCopy.new(for: "analytics_tracking_id", "aria-label": "Copy text to the system clipboard")) %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
    <% if !tbb_result && (limited_user&.subscribed? || copilot_user.consumptive_user?) %>
      <hr>
      <%= render partial: "copilot/quotas/quotas", locals: { copilot_user: copilot_user, limited_user: limited_user, this_user: this_user, tbb_result: tbb_result } %>
    <% end %>

    <% if tbb_result %>
      <hr>
      <% if is_cb_ce_sku %>
        <%
          budget_info = copilot_user.quota_snapshots["premium_interactions"]
        %>
        <%= render partial: "copilot/quotas/show_pooled_entitlements", locals: { budget_info: budget_info, copilot_user: copilot_user } %>
      <% elsif copilot_user.interval_snapshots.any? %>
        <%= render partial: "copilot/quotas/show_usage_window_for_cfi", locals: { copilot_user: copilot_user, limited_user: limited_user, this_user: this_user  } %>
      <% elsif limited_user&.subscribed? || copilot_user.consumptive_user? %>
        <%= render partial: "copilot/quotas/quotas", locals: { copilot_user: copilot_user, limited_user: limited_user, this_user: this_user, tbb_result: tbb_result } %>
      <% end %>
    <% end %>

    <% if copilot_user.consumptive_user? %>
      <hr>
      <%= render partial: "copilot/quotas/consumptive_user", locals: { consumptive_user: consumptive_user } %>
    <% end %>
  <% end %>
  <%= component.with_sidebar(p: 6) do %>
    <% if limited_user&.subscribed? %>
      <%= render(Primer::Beta::BorderBox.new(padding: :default)) do |component| %>
        <% component.with_header(scheme: :warning) do |header| %>
          <% header.with_title(tag: :h2) do %>
            Monthly Free Quotas
          <% end %>
        <% end %>
        <% Copilot::Quotas.monthly_quotas.each do |quota, value| %>
          <%= component.with_row(scheme: :default) { "#{quota.titleize} Quota: #{value}" } %>
        <% end %>
      <% end %>
    <% end %>
    <% if copilot_user.consumptive_user? %>
      <%= render(Primer::Beta::BorderBox.new(padding: :default)) do |component| %>
        <% component.with_header(scheme: :warning) do |header| %>
          <% header.with_title(tag: :h2) do %>
            Monthly Premium Quotas
          <% end %>
        <% end %>
        <% Copilot::Quotas.premium_interactions_monthly_quotas.each do |quota, value| %>
          <%= component.with_row(scheme: :default) { "#{quota.titleize} Quota: #{value}" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

