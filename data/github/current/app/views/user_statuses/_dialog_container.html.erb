<%
  status = current_user.user_status_when_not_expired
  truncate = false unless local_assigns.key?(:truncate)
  link_mentions = true unless local_assigns.key?(:link_mentions)
  compact = false unless local_assigns.key?(:compact)
  circle = false unless local_assigns.key?(:circle)
  user_preferences = {
    tone: logged_in? ? current_user.preferred_emoji_skin_tone : 0,
  }
%>

<react-partial-anchor>
  <%= render(Primer::Beta::Button.new(
    scheme: :link,
    role: "button",
    display: :block,
    classes: "Link--secondary no-underline min-width-0 p-2",
    data: {
        target: "react-partial-anchor.anchor"
    }
  )) do |d| %>
    <%= render(partial: "user_statuses/button_content", locals: {
      show_header: false,
      truncate: truncate,
      link_mentions: link_mentions,
      compact: compact,
      circle: circle,
      profile: true,
      status: status,
      tone: user_preferences[:tone],
    }) %>
  <% end %>
  <template data-target="react-partial-anchor.template">
    <%= render_react_partial(
      name: "user-status-dialog",
      props: {
        userPreferences: user_preferences,
        userStatusData: render(Site::Header::UserStatusItemAttributesComponent.new(user_status: current_user.user_status_when_not_expired)),
      },
      disable_ssr: true
    ) %>
  </template>
</react-partial-anchor>
