<%# erblint:counter DeprecatedComponentsCounter 3 %>
<div data-filterable-for="repository-owner-filter-field">
  <%= render Primer::ButtonComponent.new(
    scheme: :link,
    classes: "SelectMenu-item rounded-0 color-fg-muted pt-2 pb-2 pl-4",
    "data-show-dialog-id": "unwatch-all-dialog"
  ) do %>
    All repositories
  <% end %>
  <%= render(Primer::Alpha::Dialog.new(id: "unwatch-all-dialog", title: "Confirm unwatching all repositories", aria_described_by: 'unwatch-all')) do |dialog| %>
    <% dialog.with_header(show_divider: true) %>
    <% dialog.with_body do %>
      <p class="f5" id="unwatch-all">
        You will stop receiving notifications for all repositories that you are watching.
      </p>
    <% end %>
    <% dialog.with_footer(show_divider: true) do %>
      <%= form_tag unwatch_all_path do %>
        <input type="hidden" name="subscription_type" value="<%= subscription_type %>">
        <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "unwatch-all-dialog" })) { "Cancel" } %>
        <%= render Primer::Beta::Button.new(
          scheme: :danger,
          type: :submit,
          autofocus: true,
          ml: 1,
          data: {
            **analytics_click_attributes(
              category: "Unwatch all",
              action: "click unwatch all repositories",
              label: "subscription_type:#{subscription_type}",
            )
          },
        ) do %>
          Unwatch
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% repo_owners_with_counts.each do |(repo_owner)| %>
    <% description_element_id = "unwatch-#{repo_owner.id}" %>
    <% description_text_id = "unwatch-#{repo_owner.id}-desc" %>
    <%= render Primer::ButtonComponent.new(
      scheme: :link,
      tag: :summary,
      classes: "SelectMenu-item",
      style: "width: 100%",
      "data-show-dialog-id": description_element_id
    ) do %>
      <%= avatar_for(repo_owner, 20, class: "mr-2") %>
      <div class="ws-normal">
        <span class="text-bold mr-1"><%= repo_owner.display_login %></span><%= repo_owner.profile_name %>
      </div>
    <% end %>
    <%= render(Primer::Alpha::Dialog.new(id: description_element_id, title: "Confirm unwatching #{repo_owner.name}'s repositories", aria_described_by: description_text_id)) do |dialog| %>
      <% dialog.with_header(show_divider: true) %>
      <% dialog.with_body do %>
        <p class="f5" id="<%= description_element_id %>">
          You will stop receiving notifications for all repositories owned by <%= repo_owner.name %> that you are watching.
        </p>
      <% end %>
      <% dialog.with_footer(show_divider: true) do %>
        <%= form_tag unwatch_all_path do %>
          <input type="hidden" name="owner_id" value="<%= repo_owner.id %>">
          <input type="hidden" name="subscription_type" value="<%= subscription_type %>">

          <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": description_element_id })) { "Cancel" } %>
          <%= render Primer::ButtonComponent.new(
            scheme: :danger,
            type: :submit,
            autofocus: true,
            ml: 1,
            data: {
              **analytics_click_attributes(
                category: "Unwatch all",
                action: "click unwatch #{repo_owner.name}'s repositories",
                label: "owner:#{repo_owner.display_login};subscription_type:#{subscription_type}",
              )
            },
          ) do %>
            Unwatch
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
