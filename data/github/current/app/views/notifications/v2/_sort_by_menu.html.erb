<div class="<%= container_classes %>" <%= test_selector("notifications-sort-by-menu") %>>
  <% selected_sort_order_label = Notifications::SortOrder::OPTIONS.fetch(view.sort_order) %>
  <%= render(Primer::Alpha::ActionMenu.new(select_variant: :single, dynamic_label: true, dynamic_label_prefix: "Sort by")) do |menu_component| %>
    <% menu_component.with_show_button(display: :flex) do |button| %>
      <% button.with_trailing_action_icon(icon: :"triangle-down") %>
      <%= selected_sort_order_label %>
    <% end %>
    <% Notifications::SortOrder::OPTIONS.each do |sort_order, label| %>
      <% menu_component.with_item(
        label: label,
        active: view.sort_order == sort_order,
        href: notifications_beta_update_sort_order_path,
        form_arguments: {
          method: :post,
          inputs: [
            { name: "query", value: params[:query] },
            { name: "sort_order", value: sort_order },
          ]
        }
      ) %>
    <% end %>
  <% end %>
</div>
