<%# Renders a PollIncludeFragmentComponent that polls the copilot_digest_job_status endpoint %>
<%# When polling_url is nil (e.g. cluster unavailable), renders an error state instead %>
<%
  locals = ensure_local_vars(local_assigns, {
    required: [:polling_url],
    optional: [],
    defaults: {},
    view: "notifications/v2/copilot_digest_poll"
  })
%>


<% if polling_url.present? %>
  <%= render GitHub::PollIncludeFragmentComponent.new(
    src: polling_url,
    test_selector: "copilot-digest-fragment"
  ) do %>
    <div class="d-flex flex-justify-center">
      <div class="d-flex flex-column flex-items-center">
        <%= primer_octicon(:copilot, size: :medium, mr: 2, color: :muted) %>
        <%= render(Primer::Beta::Heading.new(tag: :h3, my: 2)) do %>
          Getting your digest ready
        <% end %>

        <%= render(Primer::Beta::Heading.new(tag: :h3, color: :muted, font_weight: :light)) do %>
          Sifting through your notifications<span class="AnimatedEllipsis"></span>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: :"copilot-error", test_selector: "copilot-digest-error")) do %>
    <%= "Unable to load Copilot digest. Please try again later." %>
  <% end %>
<% end %>
