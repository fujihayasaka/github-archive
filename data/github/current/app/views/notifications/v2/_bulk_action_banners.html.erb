<div
  class="js-bulk-action-toasts mb-3"
  data-job-url="<%= view.bulk_job_path(viewer_id) %>"
  <% if view.bulk_action_job_running?(viewer_id) %>data-job-in-progress<% end %>
>
  <template class="js-bulk-actions-processing-toast">
    <%= render(Primer::Alpha::Banner.new(scheme: :default, icon: "clock", dismiss_scheme: :remove)) { "Bulk actions currently being processed." } %>
  </template>

  <template class="js-bulk-actions-already-processing-toast">
    <%= render(Primer::Alpha::Banner.new(scheme: :default, icon: "clock", dismiss_scheme: :remove)) { "We're still processing your last request. Please wait for that to complete before submitting a new request." } %>
  </template>

  <template class="js-bulk-actions-failed-toast">
  <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: "alert", dismiss_scheme: :remove)) { "Bulk action processing failed, please try again." } %>
  </template>

  <template class="js-bulk-actions-succeeded-toast">
    <%= render(Primer::Alpha::Banner.new(scheme: :success, icon: "check-circle", dismiss_scheme: :remove)) { "Bulk action processing complete." } %>
  </template>

  <template class="js-bulk-actions-unsupported-query-toast">
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: "alert", dismiss_scheme: :remove)) { "Bulk actions are not currently supported for this query." } %>
  </template>
</div>

<div class="js-notifications-banners-target"></div>
