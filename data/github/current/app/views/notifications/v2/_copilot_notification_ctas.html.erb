<%
  locals = ensure_local_vars(local_assigns, {
    required: [],
    optional: [:copilot_notification, :wrapper_class],
    defaults: { wrapper_class: "" },
  })

  copilot_notification = locals[:copilot_notification]
%>

<% if copilot_notification.present? && copilot_notification.ctas.present? %>
  <div class="d-flex gap-2 mr-2 <%= locals[:wrapper_class] %>">
    <% copilot_notification.ctas.each_with_index do |cta, index| %>
      <% is_last = copilot_notification.ctas.length > 1 && index == copilot_notification.ctas.length - 1 %>
      <% button_type = is_last ? :secondary : :primary %>
      <% cta_href = copilot_notification.cta_url(cta) %>
      <%= render(Primer::Beta::Button.new(
        tag: :a,
        href: cta_href,
        size: :small,
        scheme: button_type,
        data: analytics_click_attributes(
          category: "copilot_digest_item",
          action: "cta_click",
          label: cta,
          button_type: button_type,
          subject_type: copilot_notification.subject_data&.dig(:type),
          model: copilot_notification.metadata&.dig(:model),
          version: copilot_notification.metadata&.dig(:version),
          priority: copilot_notification.priority,
        ))
      ) do %>
        <%= cta %>
      <% end %>
    <% end %>
  </div>
<% end %>
