<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%# view is an instance of Notification::V2::IndexView %>

<%
  page_info(
    title: "Notifications",
    breadcrumb: "Notifications",
    footer: false,
    class: "notifications-v2"
  )
%>

<div class="d-flex flex-column flex-md-row tmp-pb-sm-3 tmp-px-sm-3 p-0 height-full width-full js-notifications-container"
     data-url="<%= view.notifications_path %>"
>
  <h1 class='sr-only'>Notifications</h1>
  <% track_render_partial("notifications/index/notifications_tabs") do %>
    <%= render partial: "notifications/v2/notifications_tabs", locals: { view: view } %>
  <% end %>

  <div class="col-12 col-sm-12 col-md-9 col-lg-10 col-xl-10">
    <div class="flex-auto tmp-pl-md-3 pl-0 js-check-all-container min-width-0 pt-0 tmp-pt-md-3">

    <% unless view.copilot_digest_view? %>
      <%# mobile view %>
      <div class="d-block mt-0 tmp-mb-md-3 mb-0 px-2 px-sm-0 d-md-none" <%= test_selector("notifications-mobile-view") %>>
        <div class="d-flex">
          <%# Unread toggle %>
          <% if view.show_unread_toggle? %>
            <% track_render_partial("notifications/index/unread_toggle") do %>
              <div class="BtnGroup mr-2 col-12" <%= test_selector("notifications-all-unread-toggle") %>>
                <% if view.selected_tab?(:inbox) %>
                  <%= form_tag notifications_beta_set_preferred_inbox_query_path, method: :post do %>
                    <%= render(Primer::Alpha::SegmentedControl.new("aria-label": "Notification filters", full_width: false,
                    size: :medium)) do |component| %>
                      <% component.with_item(type: :submit, name: "query", label: "All", value: "", selected: view.all?)%>
                      <% component.with_item(type: :submit, name: "query", label: "Unread", value: "is:unread", selected: view.unread_only?) %>
                    <% end %>
                  <% end %>
                <% else %>
                  <%= render(Primer::Alpha::SegmentedControl.new("aria-label": "Notification filters", full_width: false, size: :medium)) do |component| %>
                    <% component.with_item(tag: :a, label: "All", href: view.notifications_path(unread: true, read:
                    true), selected: view.all?)%>
                    <% component.with_item(tag: :a, label: "Unread", href: view.notifications_path(unread: true, read:
                    false), selected: view.unread_only?) %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <%# Group by repo/date toggle %>
          <% if view.can_be_grouped_by_repo? %>
            <% track_render_partial("notifications/index/grouped_by_repo") do %>
              <div class="notification-group-by ml-2 d-md-block col-12 width-full" <%= test_selector("notifications-group-by-list-menu") %>>
                <%= render(Primer::Alpha::ActionMenu.new(select_variant: :single, dynamic_label: true, dynamic_label_prefix: "Group by")) do |menu_component| %>
                  <% menu_component.with_show_button(display: :flex) do |button| %>
                    <% button.with_trailing_action_icon(icon: :"triangle-down") %>
                    <% view.grouped_by_list? ? "Repository" : "Date" %>
                  <% end %>
                  <% menu_component.with_item(
                    label: "Repository",
                    active: view.grouped_by_list? ? true : false,
                    href: notifications_beta_update_view_preference_path,
                    form_arguments: {
                      method: :post,
                      inputs: [
                        { name: "query", value: params[:query] },
                        { name: "view_preference", value: "group_by_repository" },
                      ]
                    }
                  ) %>
                  <% menu_component.with_item(
                    label: "Date",
                    active: view.grouped_by_list? ? false : true,
                    href: notifications_beta_update_view_preference_path,
                    form_arguments: {
                      method: :post,
                      inputs: [
                        { name: "query", value: params[:query] },
                        { name: "view_preference", value: "sort_by_date" },
                      ]
                    }
                  ) %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>

        <%# Search notifications input %>
        <div class="notifications-query-builder-wrapper col-12 width-full mt-1">
          <%= render(Primer::Experimental::QueryBuilder.new(
            id: "notifications-search-input",
            input_name: "query",
            label_text: "Search notifications",
            visually_hide_label: true,
            placeholder: "Search notifications",
            value: params[:query] || "",
            form_action_url: "",
            test_selector: "notifications-query-builder-search",
            "data-suggestable-authors": notifications_beta_suggested_authors_path,
            "data-suggestable-repositories": notifications_beta_suggested_repositories_path,
            "data-suggestable-owners": notifications_beta_suggested_owners_path,
            "data-suggestable-types": view.suggestable_types.to_json,
            "data-suggestable-reasons": view.suggestable_reasons.to_json,
            "data-min-width": 140,
          )) do |component| %>
            <% component.with_leading_visual_icon(icon: :search) %>
          <% end %>
        </div>

        <%# Save custom search filter Dialog %>
        <% if view.show_save_custom_search? %>
          <% track_render_partial("notifications/index/custom_inboxes_dialog") do %>
            <%= render partial: "notifications/v2/custom_inboxes_dialog", locals: { button_location: :search } %>
          <% end %>
        <% end %>

        <%# Recent notifications alert %>
        <div class="notification-recent-alerts d-flex">
          <div class="notification-recent-alerts-item d-md-block mt-2">
            <%= render Primer::Alpha::IncludeFragment.new(test_selector: "deferred_large_recent_notifications_alert", src: view.notifications_recent_notifications_alert_path(since: last_notification_timestamp)) do %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# desktop view %>
    <% unless view.copilot_digest_view? %>
      <div class="d-flex flex-items-center mt-0 tmp-mb-md-3 mb-0 px-2 px-sm-0 flex-sm-wrap flex-md-wrap flex-lg-wrap gap-3 flex-justify-end">
        <div class="d-flex flex-items-center min-width-0 flex-1 d-none d-sm-flex">
          <% if view.show_unread_toggle? %>
            <% track_render_partial("notifications/index/unread_toggle") do %>
              <div class="BtnGroup mr-2 d-none d-md-block flex-shrink-0" <%= test_selector("notifications-all-unread-toggle") %>>
                <% if view.selected_tab?(:inbox) %>
                  <%= form_tag notifications_beta_set_preferred_inbox_query_path, method: :post do %>
                    <%= render(Primer::Alpha::SegmentedControl.new("aria-label": "Notification filters", full_width: false,
                    size: :medium)) do |component| %>
                      <% component.with_item(type: :submit, name: "query", label: "All", value: "", selected: view.all?)%>
                      <% component.with_item(type: :submit, name: "query", label: "Unread", value: "is:unread", selected: view.unread_only?) %>
                    <% end %>
                  <% end %>
                <% else %>
                  <%= render(Primer::Alpha::SegmentedControl.new("aria-label": "Notification filters", full_width: false, size: :medium)) do |component| %>
                    <% component.with_item(tag: :a, label: "All", href: view.notifications_path(unread: true, read:
                    true), selected: view.all?)%>
                    <% component.with_item(tag: :a, label: "Unread", href: view.notifications_path(unread: true, read:
                    false), selected: view.unread_only?) %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          <% end %>

            <div class="notifications-query-builder-wrapper d-none d-md-block col-12 col-sm-7 min-width-0 width-full">
              <%= render(Primer::Experimental::QueryBuilder.new(
                id: "notifications-search-input",
                input_name: "query",
                label_text: "Search notifications",
                visually_hide_label: true,
                placeholder: "Search notifications",
                value: params[:query] || "",
                form_action_url: "",
                test_selector: "notifications-query-builder-search",
                "data-suggestable-authors": notifications_beta_suggested_authors_path,
                "data-suggestable-repositories": notifications_beta_suggested_repositories_path,
                "data-suggestable-owners": notifications_beta_suggested_owners_path,
                "data-suggestable-types": view.suggestable_types.to_json,
                "data-suggestable-reasons": view.suggestable_reasons.to_json,
                "data-min-width": 140,
              )) do |component| %>
                <% component.with_leading_visual_icon(icon: :search) %>
              <% end %>
            </div>


          <% if view.show_save_custom_search? %>
            <% track_render_partial("notifications/index/custom_inboxes_dialog") do %>
              <%= render partial: "notifications/v2/custom_inboxes_dialog", locals: { button_location: :search } %>
            <% end %>
          <% end %>

          <% if view.can_be_grouped_by_repo? %>
            <% track_render_partial("notifications/index/grouped_by_repo") do %>
              <div class="notification-group-by ml-2 d-none d-md-block flex-shrink-0" <%= test_selector("notifications-group-by-list-menu") %>>
                <%= render(Primer::Alpha::ActionMenu.new(select_variant: :single, dynamic_label: true, dynamic_label_prefix: "Group by")) do |menu_component| %>
                  <% menu_component.with_show_button(display: :flex) do |button| %>
                    <% button.with_trailing_action_icon(icon: :"triangle-down") %>
                    <% view.grouped_by_list? ? "Repository" : "Date" %>
                  <% end %>
                  <% menu_component.with_item(
                    label: "Repository",
                    active: view.grouped_by_list? ? true : false,
                    href: notifications_beta_update_view_preference_path,
                    form_arguments: {
                      method: :post,
                      inputs: [
                        { name: "query", value: params[:query] },
                        { name: "view_preference", value: "group_by_repository" },
                      ]
                    }
                  ) %>
                  <% menu_component.with_item(
                    label: "Date",
                    active: view.grouped_by_list? ? false : true,
                    href: notifications_beta_update_view_preference_path,
                    form_arguments: {
                      method: :post,
                      inputs: [
                        { name: "query", value: params[:query] },
                        { name: "view_preference", value: "sort_by_date" },
                      ]
                    }
                  ) %>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <div class="notification-recent-alerts d-flex flex-shrink-0">
            <div class="notification-recent-alerts-item d-none d-md-block flex-shrink-0">
              <%= render Primer::Alpha::IncludeFragment.new(test_selector: "deferred_large_recent_notifications_alert", src: view.notifications_recent_notifications_alert_path(since: last_notification_timestamp)) do %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

      <% unless view.web_notifications_enabled_for_user? %>
        <% track_render_partial("notifications/index/web_notifications_disabled_flash") do %>
          <%= render(Primer::Beta::Flash.new) do %>
            Web notifications are currently disabled. You can enable them now in your <%= link_to "notifications settings", settings_notification_preferences_path, class: "Link--inTextBlock" %>.
          <% end %>
        <% end %>
      <% end %>

      <% track_render_partial("notifications/index/bulk_action_banners") do %>
        <%= render partial: "notifications/v2/bulk_action_banners", locals: { viewer_id: current_user.id, view: view } %>
      <% end %>

      <% track_render_partial("notifications/index/copilot_feedback_survey_banner") do %>
        <% survey_banner = Copilot::FeedbackSurvey.first_visible_survey_banner_for_user(current_user, [
          "oss-sentiment-test",
          "oss-maintainer-sentiment-top",
          "oss-maintainer-sentiment-popular",
          "oss-maintainer-sentiment-casual",
          "oss-contributors",
        ]) %>

        <% if survey_banner %>
          <div class="clearfix tmp-mb-3 tmp-mt-3">
            <%= render_react_partial name: "copilot-survey", props: {
              bannerText: survey_banner.body,
              bannerTitle: survey_banner.title,
              icon: 'compose',
              ctaUrl: survey_banner.cta_url,
              ctaText: survey_banner.cta_text,
              bannerSlug: survey_banner.slug,
              surveyOpenCallbackPath: copilot_feedback_survey_open_path,
              surveyDismissCallbackPath: copilot_feedback_survey_dismiss_path
            } %>
          </div>
        <% end %>
      <% end %>

      <% if view.selected_tab?(:inbox) && !current_user.dismissed_notice?("notifications_onboarding_banner") %>
        <% track_render_partial("notifications/index/onboarding_banner") do %>
          <%= render partial: "notifications/v2/onboarding_banner" %>
        <% end %>
      <% end %>

      <% if view.copilot_digest_view? %>
        <% track_render_partial("notifications/index/copilot_notifications_list") do %>
          <%= render partial: "notifications/v2/copilot_notifications_list", locals: {
            total_count: total_count,
            polling_url: copilot_digest_polling_url,
            view: view
          } %>
        <% end %>
      <% elsif view.grouped_by_list? %>
        <% track_render_partial("notifications/index/notifications_grouped_list") do %>
          <%= render partial: "notifications/v2/notifications_grouped_list", locals: {
            notifications: notifications,
            total_count: total_count,
            view: view
          } %>
        <% end %>
      <% else %>
        <% track_render_partial("notifications/index/notifications_list") do %>
          <%= render partial: "notifications/v2/notifications_list", locals: {
            total_count: total_count,
            notifications: notifications,
            view: view
          } %>
        <% end %>

        <% track_render_partial("notifications/index/notifications_list_footer") do %>
          <%= render partial: "notifications/v2/notifications_list_footer", locals: {
            view: view,
            total_count: total_count,
            page_info: page_info,
            notifications_size: notifications.size,
            first_item_offset: first_item_offset,
          } %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<% content_for :scripts do %><%# erblint:disable NoContentForScripts %>
  <%= javascript_bundle "notifications-v2" %>
<% end %>
