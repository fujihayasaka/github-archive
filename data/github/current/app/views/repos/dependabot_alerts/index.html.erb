<%
  # view is an instance of RepositoryAlerts::IndexView
  page_info(
    title: "#{heading} · #{current_repository.name_with_display_owner}",
    container_xl: true,
    selected_link: :alerts,
    dashboard_pinnable_repository_id: current_repository.global_relay_id
  )
%>

<%= render layout: "layouts/repository/security", locals: { selected_tab: selected_tab } do %>
  <%= render "repos/dependabot_alerts/list", view: view, save_view_url: save_view_url, heading: heading, phase: phase %>
<% end %>
