<div class="d-flex flex-items-end flex-column flex-sm-row clearfix" <%= test_selector "repository-advisory-cve-form" %>>
  <dl class="form-group my-0 float-left col-12 col-sm-6 col-md-4">
    <dt>
      <%= form.label :cve_selection, "CVE identifier" %>
    </dt>

    <dd class="form-group-body my-0 clearfix">
      <%= form.select :cve_selection, view.cve_selection_options, { prompt: "Select an option", selected: view.cve_selection_option }, { required: true, class: "js-cve-selection width-full" } %>
    </dd>
  </dl>

  <div class="js-requesting-cve float-left col-12 col-sm-6 col-md-8 mt-2 mt-sm-0 pl-sm-2 text-small" <%= "hidden" unless view.cve_selection_option == "requesting" %>>
    <p class="color-fg-muted d-table-cell">After you create your draft advisory, GitHub can assign a CVE ID to your repository security advisory prior to public disclosure. Once you publish the advisory, GitHub publishes the CVE details.</p>
  </div>
  <div class="js-existing-cve float-left col-12 col-sm-6 col-md-8 mt-2 mt-sm-0 pl-sm-2" <%= "hidden" unless view.cve_selection_option == "existing" %>>
    <%= form.text_group "Existing CVE", :cve_id, group_class: "my-0", class: "form-control input-block", placeholder: "e.g. CVE-#{Date.current.year}-######", error: error_for(view.form_advisory, :cve_id) %>
  </div>
  <div class="js-not-applicable-cve float-left col-12 col-sm-6 col-md-8 mt-2 mt-sm-0 pl-sm-2 text-small" <%= "hidden" unless view.cve_selection_option == "not_applicable" %>>
    <p class="color-fg-muted d-table-cell">This security advisory does not require a CVE ID or is not eligible for one. You can still publish your advisory without a CVE.</p>
  </div>
</div>
