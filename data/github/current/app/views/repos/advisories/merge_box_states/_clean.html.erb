<div class="<% if responsive? %>ml-0 pl-0 tmp-ml-md-6 tmp-pl-md-3<% else %>tmp-ml-6 tmp-pl-3<% end %> tmp-mt-3 branch-action mb-0 branch-action-state-<%= view.viewer_can_merge? ? "clean" : "dirty" %>">
  <span class="branch-action-icon <% if responsive? %>d-none d-md-flex<% else %>d-flex<% end %> flex-items-center flex-justify-center">
    <%= primer_octicon(:"git-merge", size: :medium) %>
  </span>

  <div class="branch-action-body timeline-comment--caret">
    <div class="branch-action-item">
      <% if view.rule_violation_messages.any? %>
        <div class="branch-action-item-icon completeness-indicator completeness-indicator-error">
          <%= primer_octicon(:x) %>
        </div>
        <div class="h4 status-heading">This advisory may be blocked by repository rules</div>
        <div class="status-meta">
          <strong><%= pluralize(view.rule_violation_messages.size, "repository rule") %> found</strong>
          <details class="tmp-mt-1">
          <summary class="text-small Link--secondary cursor-pointer">Show rules</summary>
          <ul class="text-normal tmp-ml-3 tmp-mb-0 tmp-mt-1">
            <% view.rule_violation_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
          </details>
        </div>
      <% else %>
        <div class="branch-action-item-icon completeness-indicator completeness-indicator-success">
          <%= primer_octicon(:check) %>
        </div>
        <div class="h4 status-heading">This advisory is ready to be merged</div>
        <span class="status-meta">Merging can be performed automatically.</span>
      <% end %>
    </div>
    <div class="merge-message">
      <%= render "repos/advisories/merge_button", view: view %>
    </div>
  </div>
</div>
