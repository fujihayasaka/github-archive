<% if view.viewer_can_lock? %>
  <div class="discussion-sidebar-item border-top">
    <%= form_tag(lock_repository_advisory_path(id: view.advisory.ghsa_id), method: :post) do %>
      <%= render(Primer::Alpha::Dialog.new(
        title: "Lock advisory",
        id: "advisory-lock-conversation",
        size: :large
      )) do |dialog| %>
        <% dialog.with_show_button(
          scheme: :link,
          font_weight: :bold,
          underline: false,
          classes: "Link--primary",
        ) do |button| %>
          <% button.with_leading_visual_icon(icon: :lock) %>
          Lock advisory
        <% end %>
        <% dialog.with_body do %>
          <p class="text-bold">Are you sure you want to lock this advisory?</p>
          <ul class="tmp-ml-3">
            <li class="mb-2">Other users <strong>can't edit or update</strong> this advisory.</li>
            <li class="mb-2">
              Repository administrators <strong>can still make changes</strong>.
            </li>
            <li>You can always unlock this advisory again in the future.</li>
          </ul>
          <div class="tmp-mt-3">
            <label for="lock-reason" class="f5 text-bold">Reason for locking</label>
            <select name="reason" id="lock-reason" class="form-select width-full mt-1">
              <option value="">Choose a reason</option>
              <% RepositoryAdvisory::Locking::LOCK_REASONS.each do |reason| %>
                <option value="<%= reason %>"><%= reason.humanize %></option>
              <% end %>
            </select>
            <p class="note mt-1">Optionally, choose a reason for locking this advisory.</p>
          </div>
        <% end %>
        <% dialog.with_footer do %>
          <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "advisory-lock-conversation" })) { "Cancel" } %>
          <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { "Lock advisory" } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% elsif view.viewer_can_unlock? %>
  <div class="discussion-sidebar-item border-top">
    <%= render(Primer::Alpha::Dialog.new(
      title: "Unlock advisory",
      id: "advisory-unlock-conversation",
      size: :medium
    )) do |dialog| %>
      <% dialog.with_show_button(
        scheme: :link,
        font_weight: :bold,
        underline: false,
        classes: "Link--primary",
      ) do |button| %>
        <% button.with_leading_visual_icon(icon: :key) %>
        Unlock advisory
      <% end %>
      <% dialog.with_body do %>
        <p class="text-bold">Are you sure you want to unlock this advisory?</p>
        <ul class="tmp-ml-3">
          <li class="mb-2"><strong>Everyone</strong> with access will be able to edit this advisory once more.</li>
          <li>You can always lock this advisory again in the future.</li>
        </ul>
      <% end %>
      <% dialog.with_footer do %>
        <%= form_tag(unlock_repository_advisory_path(id: view.advisory.ghsa_id), method: :delete) do %>
          <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "advisory-unlock-conversation" })) { "Cancel" } %>
          <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { "Unlock advisory" } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
