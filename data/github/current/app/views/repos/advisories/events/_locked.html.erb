<%# view is an instance of RepositoryAdvisories::EventView %>
<% formatted_reason = view.value_is&.downcase&.gsub("_", " ") %>
<div class="TimelineItem" id="<%= view.dom_id %>" data-team-hovercards-enabled>
  <span class="TimelineItem-badge"><%= primer_octicon(view.icon) %></span>
  <div class="TimelineItem-body">
    <% if view.event_name == "locked" %>
      Locked<% if formatted_reason %> as <strong><%= formatted_reason %></strong><% end %> and limited editing to repository admins
    <% else %>
      Unlocked this advisory
    <% end %>

    <a href="#<%= view.dom_id %>" class="Link--secondary"><%= time_ago_in_words_js(view.timestamp) %></a>
  </div>
</div>
