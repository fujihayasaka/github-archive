<% description = local_assigns[:description] || "Sorry, we couldn't find this file in the repository." %>

<div class="d-flex flex-column flex-items-center text-center tmp-pt-4 pb-2 px-2" <%= test_selector("scanning-missing-blob") %>>
  <h3 class="f4">Preview unavailable</h3>
  <p class="color-fg-muted"><%= description %></p>
</div>

<% if local_assigns[:helper].present? && local_assigns[:helper].message_text.present? %>
  <div class="border-top">
    <%= render Suggestions::AlertAnnotationComponent.new(
          alert_title: local_assigns[:alert_title] || "",
          alert_description_html: local_assigns[:helper].message_text,
          alert_code_paths_url: local_assigns[:code_paths_url],
          alert_rule_severity: local_assigns[:alert_rule_severity],
          tool_display_name: local_assigns[:tool_display_name]
        )
    %>
  </div>
<% end %>
