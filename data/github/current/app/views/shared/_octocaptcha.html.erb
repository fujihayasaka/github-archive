<%# erblint:counter GoogleAnalyticsDeprecation 1 %>
<%
  include_header = local_assigns.fetch(:include_header, true)
  dynamically_load_captcha = local_assigns.fetch(:dynamically_load_captcha, false)
  datadome_js_tag = local_assigns.fetch(:datadome_js_tag, false)
%>

<div class="<%= signup_form_margin("y") %>" <%= test_selector("signup-form-captcha")%>>
  <% if include_header %>
    <%= signup_h2("Verify your account", class: signup_form_margin("b")) %>
  <% end %>

  <div class="js-octocaptcha-spinner d-flex flex-justify-center flex-items-center width-full">
    <%= image_tag "spinners/octocat-spinner-128.gif", size: "64x64", alt: "Waiting for verification." %>
  </div>

  <div class="js-octocaptcha-success d-none d-flex flex-justify-center flex-items-center width-full">
    <%= primer_octicon(:check, height: 64, color: :success, "aria-label": "Account has been verified. Please continue.") %>
  </div>

  <div class="width-full"
    data-ga-event-category="Signup funnel entrance"
  >
    <% if dynamically_load_captcha %>
      <iframe data-src="<%= GitHub.urls.octocaptcha_url_with_src_params(origin_page, version: local_assigns[:version], captcha_demo: local_assigns[:captcha_demo], style_theme: local_assigns[:style_theme], datadome_js_tag: datadome_js_tag, datadome_request_id: request.headers["HTTP_X_DATADOME_REQUESTID"], datadome_session_id: request.headers["HTTP_X_DATADOME_SESSIONID"], datadome_isbot: request.headers["HTTP_X_DATADOME_ISBOT"], datadome_ruletype: request.headers["HTTP_X_DATADOME_RULETYPE"], datadome_botname: request.headers["HTTP_X_DATADOME_BOTNAME"], datadome_captchapassed: request.headers["HTTP_X_DATADOME_CAPTCHAPASSED"], datadome_traffic_rule_response: request.headers["HTTP_X_DATADOME_TRAFFIC_RULE_RESPONSE"], datadome_captchaurl: request.headers["HTTP_X_DATADOME_CAPTCHAURL"], datadome_devicecheckpassed: request.headers["HTTP_X_DATADOME_DEVICECHECKPASSED"], datadome_matchedmodels: request.headers["HTTP_X_DATADOME_MATCHEDMODELS"]) %>" class="js-octocaptcha-frame width-full d-block v-hidden border-0 rounded-2" title="Please verify by completing this captcha."></iframe>
    <% else %>
      <iframe src="<%= GitHub.urls.octocaptcha_url_with_src_params(origin_page, version: local_assigns[:version], captcha_demo: local_assigns[:captcha_demo], style_theme: local_assigns[:style_theme], datadome_js_tag: datadome_js_tag, datadome_request_id: request.headers["HTTP_X_DATADOME_REQUESTID"], datadome_session_id: request.headers["HTTP_X_DATADOME_SESSIONID"], datadome_isbot: request.headers["HTTP_X_DATADOME_ISBOT"], datadome_ruletype: request.headers["HTTP_X_DATADOME_RULETYPE"], datadome_botname: request.headers["HTTP_X_DATADOME_BOTNAME"], datadome_captchapassed: request.headers["HTTP_X_DATADOME_CAPTCHAPASSED"], datadome_traffic_rule_response: request.headers["HTTP_X_DATADOME_TRAFFIC_RULE_RESPONSE"], datadome_captchaurl: request.headers["HTTP_X_DATADOME_CAPTCHAURL"], datadome_devicecheckpassed: request.headers["HTTP_X_DATADOME_DEVICECHECKPASSED"], datadome_matchedmodels: request.headers["HTTP_X_DATADOME_MATCHEDMODELS"]) %>" class="js-octocaptcha-frame width-full d-block v-hidden border-0 rounded-2" title="Please verify by completing this captcha."></iframe>
    <% end %>
  </div>

  <input
    required
    name="octocaptcha-token"
    class="js-octocaptcha-token d-none"
    data-octocaptcha-url="<%= GitHub.urls.octocaptcha_url %>"
    data-octocaptcha-timeout="<%= octocaptcha_timeout ||= 30_000 %>"
    <% if dynamically_load_captcha %>
      data-dynamically-load-captcha="<%= dynamically_load_captcha %>"
    <% end %>
  >
</div>
