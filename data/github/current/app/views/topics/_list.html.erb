<% if topics.any? %>
  <div class="f6">
    <% topics.each do |topic| %>
      <%= render(Topics::TagComponent.new(
        name: topic.name,
        href: current_user&.is_enterprise_managed? ? search_path(q: "topic:#{topic.name}", type: "Repositories") : topic.resource_path,
      )) %>
    <% end %>
  </div>
<% end %>
