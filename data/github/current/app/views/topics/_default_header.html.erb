<%
  page_info(
    title: "#{topic.safe_display_name} · GitHub Topics",
    stafftools: stafftools_topic_path(topic.name)
  )
%>

<div class="container-lg p-responsive tmp-py-5">
  <div class="gutter-md">
    <div class="col-lg-9 col-md-8 d-flex flex-items-center tmp-mb-3 tmp-mb-sm-0">
      <div class="d-flex flex-1">
        <div
          class="border color-border-subtle color-bg-accent f4 color-fg-muted text-bold rounded flex-shrink-0 text-center tmp-mr-3"
          style="width: 48px; height: 48; line-height: 48px;"
        >
          #
        </div>

        <h1 class="h1">
          <%= topic.safe_display_name %>
        </h1>
      </div>

      <topic-feeds-toast-trigger data-topic-display-name="<%= topic.safe_display_name %>" data-topic-name="<%= topic.name %>">
        <%= render Stars::ButtonComponent.new(entity: topic, context: "topic", display: :inline_block) %>
      </topic-feeds-toast-trigger>
    </div>
  </div>
</div>

