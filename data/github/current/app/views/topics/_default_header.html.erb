<%
  page_info(
    title: "#{topic.safe_display_name} · GitHub Topics",
    stafftools: stafftools_topic_path(topic.name)
  )
%>

<%
  # Define experiment variables at the top level
  if current_user.present? && user_feature_enabled?(:discover_more_projects_with_copilot) && !GitHub.multi_tenant_enterprise? && !current_user.is_enterprise_managed? 
    experiment_id = "discover_more_projects_with_copilot"
    variant = hawaii_experiment_variant(
      experiment_id: experiment_id,
      user_id: current_user.id,
      variant_count: 2
    )
    experiment_tag = "button"
    experiment_context = "experiment_#{experiment_id}_variant_#{variant}"
    experiment_location = "topics_header"

    prompt = <<~PROMPT.chomp
      1. Generate a list (without displaying them) of the 10 most interesting open source #{topic.name} projects on GitHub.
      2. Output this list as a table (not in a codeblock) that includes the description of the project, and a link to the repo, but leaves out the number of stars.
    PROMPT
  end
%>

<div class="container-lg p-responsive py-5">
  <div class="gutter-md">
    <div class="col-lg-9 col-md-8 d-flex flex-items-center mb-3 mb-sm-0">
      <div class="d-flex flex-1">
        <div
          class="border color-border-subtle color-bg-accent f4 color-fg-muted text-bold rounded flex-shrink-0 text-center mr-3"
          style="width: 48px; height: 48; line-height: 48px;"
        >
          #
        </div>

        <h1 class="h1">
          <%= topic.safe_display_name %>
        </h1>
      </div>

      <topic-feeds-toast-trigger data-topic-display-name="<%= topic.safe_display_name %>" data-topic-name="<%= topic.name %>">
        <!--Add Discover button-->
        <% if current_user.present? && user_feature_enabled?(:discover_more_projects_with_copilot) && !GitHub.multi_tenant_enterprise? && !current_user.is_enterprise_managed? %>
            <% case variant %>
            <% when 0 %>
              <%= content_tag(
                :span,
                data: {
                  **analytics_visible_attributes(
                    category: experiment_context,
                  )
                }) do %>
              <% end %>
            <% when 1 %>
              <div class="js-notice d-none d-lg-inline-block">
                <%= link_to(
                  copilot_immersive_path(prompt:),
                  class: "btn btn-sm btn-primary",
                  style: "margin-right: 5px;",
                  "aria-label": "Discover more #{topic.safe_display_name} projects",
                  data: {
                      **analytics_click_attributes(
                        category: experiment_context,
                        action: "discover_more_#{topic.safe_display_name}_projects",
                        tag: experiment_tag,
                        context: experiment_context,
                        location: experiment_location
                      ),
                      **analytics_visible_attributes(
                        category: experiment_context,
                      )
                  }
                ) do %>
                  <%= primer_octicon(:copilot, mr: 1)%> <%="Discover more #{topic.name} projects" %>
                <% end %>
              </div>
            <% end %>
        <% end %>
        <!--End Add Discover button-->
        <%= render Stars::ButtonComponent.new(entity: topic, context: "topic", display: :inline_block) %>
      </topic-feeds-toast-trigger>
    </div>
  </div>
</div>

