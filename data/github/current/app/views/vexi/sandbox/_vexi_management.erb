<%= render(Primer::Beta::BorderBox.new(mb: 3)) do |c| %>
  <% c.with_header(font_weight: :bold) { "Vexi Management" } %>

  <% c.with_row do %>
    <%= primer_form_with(url: _vexi_sandbox_index_path, method: :get) do |form| %>
      <%= render(FeatureManagement::FeatureFlagManagementForm.new(form, params: permitted_params)) %>
    <% end %>
  <% end %>
<% end %>

<% if permitted_params["feature_flag_name"].present? && permitted_params["update_feature_flag"].present? %>
  <%= render :partial => "vexi/sandbox/feature_definition", locals: {
    header_title: "Feature Flag Definition",
    feature_flag_data: feature_flag_data,
  } %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(mb: 3)) do |c| %>
  <% c.with_header(font_weight: :bold) { "Vexi Check Evaluation" } %>

  <% c.with_row do %>
    <%= primer_form_with(url: _vexi_sandbox_index_path, method: :get) do |form| %>
      <%= render(FeatureManagement::FeatureFlagEvaluationForm.new(form, params: permitted_params, nav_option: "vexi_management")) %>
    <% end %>
  <% end %>
<% end %>

<% if permitted_params["feature_flag_name"].present? && permitted_params["submit"].present? %>
  <%= render :partial => "vexi/sandbox/feature_states", locals: {
    feature_flag_checks: vexi_checks,
    header_title: "Vexi Calls",
  } %>
<% end %>
