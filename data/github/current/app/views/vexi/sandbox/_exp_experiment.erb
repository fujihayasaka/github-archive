<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |c| %>
  <% c.with_header(font_weight: :bold) { "EXP Treatment Assignment" } %>

  <% c.with_row do %>
    <%= primer_form_with(url: _vexi_sandbox_index_path, method: :get) do |form| %>
      <input type="hidden" name="nav_option" value="exp_experiment">

      <div class="d-flex flex-column tmp-mb-3">
        <%= render Primer::Alpha::TextField.new(name: :exp_randomization_unit, label: "Randomization Unit", value: permitted_params[:exp_randomization_unit], caption: "Format: key:value (e.g. user_id:test_unit_1, device_id:abc123). Required.") %>
      </div>

      <div class="d-flex flex-column tmp-mb-3">
        <%= render Primer::Alpha::TextField.new(name: :exp_audience_filters, label: "Audience Filters (key=value, comma-separated)", value: permitted_params[:exp_audience_filters], caption: "e.g. country=US,clientid=my-app") %>
      </div>

      <div class="d-flex flex-row">
        <%= form.submit "Get Treatment Assignment", scheme: :primary %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if exp_result.present? %>
  <%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |c| %>
    <% c.with_header(font_weight: :bold) { "Result" } %>

    <% c.with_row do %>
      <div class="d-flex flex-column">
        <strong>Status:</strong>
        <code><%= exp_result[:status] %></code>
      </div>
    <% end %>

    <% c.with_row do %>
      <div class="d-flex flex-column">
        <strong>Request user_params:</strong>
        <code><%= exp_result[:request_user_params]&.to_json %></code>
      </div>
    <% end %>

    <% c.with_row do %>
      <div class="d-flex flex-column">
        <strong>Feature Variables:</strong>
        <code><%= exp_result[:feature_variables]&.to_json %></code>
      </div>
    <% end %>

    <% c.with_row do %>
      <div class="d-flex flex-column">
        <strong>Assigned Variants:</strong>
        <code><%= exp_result[:assigned_variants]&.to_json %></code>
      </div>
    <% end %>

    <% c.with_row do %>
      <div class="d-flex flex-column">
        <strong>Data Version:</strong>
        <code><%= exp_result[:data_version] %></code>
      </div>
    <% end %>

    <% c.with_row do %>
      <div class="d-flex flex-column">
        <strong>Assignment Context:</strong>
        <code><%= exp_result[:assignment_context] %></code>
      </div>
    <% end %>
  <% end %>
<% end %>
