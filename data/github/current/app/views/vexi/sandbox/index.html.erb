<% page_info title: "Vexi Sandbox" %>

<div class="d-flex flex-row p-2">
  <%# Navigation %>
  <div class="d-flex flex-column">
    <%= render(Primer::Beta::BorderBox.new(mr: 3)) do |c| %>
      <% c.with_header(font_weight: :bold) { "Navigation" } %>

      <% nav_options.each do |nav_option| %>
        <% c.with_row do %>
          <%= render(Primer::Beta::Link.new(href: _vexi_sandbox_index_path(nav_option: nav_option),
            muted: page == nav_option, scheme: :primary, classes: "Link--inTextBlock")) do %>
            <% nav_option %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%# Body %>
  <div class="d-flex flex-column flex-justify-center" style="flex-grow: 1">
    <% if page.empty? || page == "landing" %>
      <%= render :partial => "vexi/sandbox/landing", locals: { page: page, vexi_checks: vexi_checks } %>
    <% end %>
    <% if page.empty? || page == "vexi_with_preload" %>
      <%= render :partial => "vexi/sandbox/vexi_with_preload", locals: { page: page, vexi_checks: vexi_checks } %>
    <% end %>
    <% if page.empty? || page == "vexi_with_preload_directly_from_adapter" %>
      <%= render :partial => "vexi/sandbox/vexi_with_preload_directly_from_adapter", locals: { page: page, vexi_checks: vexi_checks } %>
    <% end %>
    <% if page == "vexi_test" %>
      <%= render :partial => "vexi/sandbox/vexi_test", locals: { page: page, vexi_checks: vexi_checks } %>
    <% end %>
    <% if page == "vexi_debug" %>
      <%= render :partial => "vexi/sandbox/vexi_debug", locals: { page: page, vexi_checks: vexi_checks } %>
    <% end %>
    <% if page == "vexi_actors" %>
      <%= render :partial => "vexi/sandbox/vexi_actors", locals: { page: page, vexi_checks: vexi_checks } %>
    <% end %>
  </div>
</div>
