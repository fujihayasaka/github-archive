<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |c| %>
  <% c.with_header(font_weight: :bold) { header_title } %>

  <% c.with_row do %>
    <% if feature_flag_data.present? %>
      <table class="width-full">
        <thead>
          <tr>
            <th class="tmp-pr-3">Feature Flag Name</th>
            <th class="tmp-pr-3">Percentage of Actors</th>
            <th class="tmp-pr-3">Percentage of Calls</th>
            <th class="tmp-pr-3">Actors</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tmp-pr-3 pb-2"><code><%= feature_flag_data.name %></code></td>
            <td class="tmp-pr-3 pb-2">
              <%= number_with_precision(feature_flag_data.percentage_of_actors, precision: 1) %>%
            </td>
            <td class="tmp-pr-3 pb-2">
              <%= number_with_precision(feature_flag_data.percentage_of_calls, precision: 1) %>%
            </td>
            <td class="tmp-pr-3 pb-2">
              <% if feature_flag_data.actors.any? %>
                <ul class="list-style-none mb-0">
                  <% feature_flag_data.actors.each do |actor_id| %>
                    <li><code><%= actor_id %></code></li>
                  <% end %>
                </ul>
              <% else %>
                <span class="color-fg-muted">None</span>
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>
    <% else %>
      <%= render Primer::Alpha::Banner.new(icon: :info, classes: "tmp-mb-4") do %>
        No feature flag data available. Please enter a feature flag name and evaluate it first.
      <% end %>
    <% end %>
  <% end %>
<% end %>
