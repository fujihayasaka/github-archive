<%= render(Primer::Beta::BorderBox.new(mb: 3)) do |c| %>
  <% c.with_header(font_weight: :bold) { header_title } %>

  <% c.with_row do %>
    <table>
      <thead>
        <tr>
          <th class="pr-3">Feature Flag Name</th>
          <th class="pr-3">Code</th>
          <th class="pr-3">Result</th>
        </tr>
      </thead>
      <tbody>
        <% feature_flag_checks.each do |ff_check| %>
        <tr>
          <td class="pr-3 pb-2"><%= ff_check[:feature_flag] %></td>
          <td class="pr-3 pb-2"><%= ff_check[:code] %></td>
          <td class="pr-3 pb-2"><%= ff_check[:result] %></td>
        </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
