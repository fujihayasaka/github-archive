<%= render(Primer::Beta::BorderBox.new(mb: 3)) do |c| %>
  <% c.with_header(font_weight: :bold) { "Vexi Debug" } %>

  <% c.with_row do %>
    <%= primer_form_with(url: _vexi_sandbox_index_path, method: :get) do |form| %>
      <%= render(FeatureManagement::FeatureFlagEvaluationForm.new(form, params: permitted_params)) %>
    <% end %>
  <% end %>
<% end %>

<% if permitted_params["feature_flag_name"].present? %>
  <%= render :partial => "vexi/sandbox/feature_states", locals: {
    feature_flag_checks: vexi_checks,
    header_title: "Vexi Calls",
  } %>
<% end %>

