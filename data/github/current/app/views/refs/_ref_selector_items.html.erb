<%= render(Primer::Alpha::SelectPanel::ItemList.new(
  select_variant: :single,
  aria: { label: 'Choose a tag to compare' },
  )) do |list| %>
  <% compare_tag_encoding_fix_enabled = FeatureFlag.vexi.enabled?(:compare_tag_encoding_fix, repository, default: false) %>
  <% refs.each do |ref| %>
    <% if compare_tag_encoding_fix_enabled %>
      <% list.with_item(
        active: ref.name == tag_name,
        href: compare_path(repository, "#{ref.name}...#{tag_name}")
      ) do %>
        <%= ref.name %>
      <% end %>
    <% else %>
      <% list.with_item(
        active: ref.name == tag_name,
        href: compare_path(repository, "#{ref.name}...#{escape_url_branch(tag_name).gsub('%2B', '+')}")
      ) do %>
        <%= ref.name %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
