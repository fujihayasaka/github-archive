<% page_info title: "GitHub Spark Waitlist" %>
<div class="d-flex flex-column flex-lg-row">

  <div class="col-12 col-lg-6">
    <div class="copilot-waitlist-header-section copilot-waitlist-header-jetbrains">
      <div class="copilot-waitlist-section-inner">
        <div class="copilot-waitlist-beta-bubble">
          Technical Preview
        </div>
        <p class="lh-condensed copilot-waitlist-header">Join the GitHub Spark waitlist</p>

        <p class="text-light mt-4 mb-4">
          Join the technical preview for early access to GitHub Spark, an AI-powered app platform that allows you to create, use, and share personalized micro apps ("sparks").
        </p>
      </div>
    </div>
  </div>

  <div class="copilot-waitlist-form-section col-12 col-lg-6 pr-8 pb-8 pl-8 pt-10">
    <p class="mb-2 h3">Thank you! <%= current_user.display_login %> is now on the waitlist for GitHub Spark.</p>

    <p class="mb-2">
      Admission to the technical preview for GitHub Spark will be limited. You will receive an email if you are
      granted access.
    </p>
  </div>
</div>
