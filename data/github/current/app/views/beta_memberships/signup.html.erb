<%# view is an instance of BetaMemberships::View %>

<% content_for :head do %>
  <%= stylesheet_bundle :site %>
<% end %>

<% if beta.respond_to?(:waitlist_closed?) && beta.waitlist_closed? %>
  <% page_info title: "This waitlist is closed" %>
<% else %>
  <% page_info title: "Join the #{beta.feature_name} waitlist" %>
<% end %>

<%= render Beta::SignupComponent.new(beta: beta) %>
