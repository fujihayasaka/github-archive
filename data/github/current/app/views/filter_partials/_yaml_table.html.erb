<% is_vertical_front_matter = outermost_table && th_row.length == tb_row.length %>
<table<% if outermost_table %> data-table-type="yaml-metadata"<% if is_vertical_front_matter %> class="vertical-front-matter"<% end %><% end %>>
<% if is_vertical_front_matter %>
  <tbody>
  <% th_row.each_with_index do |header, index| %>
  <tr>
    <th><%= transcode_yaml_value(header) %></th>
    <td><%= transcode_yaml_value(tb_row[index]) %></td>
  </tr>
  <% end %>
  </tbody>
<% else %>
<% if th_row.any? -%>
  <thead>
  <tr>
  <% th_row.each do |header| %>
  <th><%= transcode_yaml_value(header) %></th>
  <% end %>
  </tr>
  </thead>
<% end %>
  <tbody>
<% if tb_row.any? -%>
  <tr>
  <% tb_row.each do |row| %>
  <td><div><%= transcode_yaml_value(row) %></div></td>
  <% end %>
  </tr>
<% end %>
  </tbody>
<% end %>
</table>
