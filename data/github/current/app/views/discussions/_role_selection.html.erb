<div class="d-flex flex-items-center">
  <span class="color-fg-muted">You're starting a discussion as</span>
  <%= render(
    Primer::Alpha::ActionMenu.new(
      select_variant: :single,
      size: :auto,
      dynamic_label: true,
      classes: "role-menu",
      name: "post_as_admin"
    )
  ) do |menu| %>
    <% menu.with_show_button(scheme: :invisible) do |button| %>
      <%= current_user.name %>
      <% button.with_trailing_action_icon(icon: :"triangle-down") %>
    <% end %>

    <% menu.with_group do |group| %>
      <% group.with_heading(title: "Start discussion as")%>

      <% group.with_avatar_item(
        id: "user_role",
        src: current_user.primary_avatar_url,
        username: current_user.name,
        label: current_user.name,
        data: { value: "false" },
        active: true,
        classes: "role-select-button text-semibold js-selected-avatar",
      ) %>

      <% group.with_avatar_item(
        id: "admin_role",
        src: current_repository.owner.primary_avatar_url,
        username: "#{current_repository.owner.safe_profile_name} Admin",
        label: "#{current_repository.owner.safe_profile_name} Admin",
        active: false,
        data: { value: "true" },
        classes: "role-select-button text-semibold js-selected-avatar",
      ) %>
    <% end %>
  <% end %>
</div>
