<% if timeline.show_as_verified_answer?(comment) %>
  <%= form_tag(
    verified_answer_discussion_comment_path(comment),
    method: :delete,
    "data-replace-remote-form-target": remote_form_id,
    class: "d-inline-flex js-discussion-comment-unverify-answer",
    hidden: true
  ) do %>
  <% end %>
  <%= render(Primer::Alpha::ActionMenu.new(mr: 2)) do |menu| %>
    <% menu.with_show_button(scheme: :invisible, classes: "social-reaction-summary-item discussion-footer-answer-button") do %>
      <div class="d-flex">
        <%= render(Primer::Beta::Octicon.new(icon: :"verified", color: :accent, classes: "mr-2" )) %>
        <%= render Primer::Beta::Text.new(color: :muted, font_size: :small ).with_content("Verified answer") %>
        <%= render(Primer::Beta::Octicon.new(icon: "kebab-horizontal", classes: "ml-2", style: "margin-top: 2px")) %>
      </div>
    <% end %>
      <% menu.with_item(label: "Unverify answer", classes: "js-discussions-trigger-unverify-answer", test_selector: "unverify-answer") %>
    <% end %>
<% else %>
  <%= form_tag(
    verified_answer_discussion_comment_path(comment),
    method: :post,
    "data-replace-remote-form-target": remote_form_id,
    class: "d-inline-flex js-discussion-comment-verify-answer",
    hidden: true
  ) do %>
  <% end %>
  <%= form_tag(
    unmark_as_answer_discussion_comment_path(comment),
    method: :delete,
    "data-replace-remote-form-target": remote_form_id,
    class: "d-inline-flex js-discussion-comment-unmark-answer",
    hidden: true
  ) do %>
  <% end %>
  <%= render(Primer::Alpha::ActionMenu.new(mr: 2)) do |menu| %>
  <% menu.with_show_button(scheme: :invisible, classes: "social-reaction-summary-item discussion-footer-answer-button") do %>
    <div class="d-flex">
      <%= render(Primer::Beta::Octicon.new(icon: :"check-circle-fill", color: :success, classes: "mr-2" )) %>
      <%= render Primer::Beta::Text.new(color: :muted, font_size: :small ).with_content("Unmark as answer") %>
      <%= render(Primer::Beta::Octicon.new(icon: "kebab-horizontal", classes: "ml-2", style: "margin-top: 2px")) %>
    </div>
  <% end %>
    <% menu.with_item(label: "Verify answer", classes: "js-discussions-trigger-verify-answer", test_selector: "verify-answer") %>
    <% menu.with_item(label: "Unmark as answer", type: :submit, classes: "js-discussions-trigger-unmark-answer", test_selector: "unmark-answer")%>
  <% end %>
<% end %>
