<%
  page_info(
    title: "Select your GitHub plan",
    class: "header-overlay",
    full_height: true,
  )

  contentful_custom_content_entry ||= contentful_custom_content_entry
%>

<% content_for :signups_left_panel do %>
  <%= render(Signups::SignupsContentPanelComponent.new(custom_page_param: custom_page_param, contentful_custom_content_entry: contentful_custom_content_entry)) %>
<% end %>

<div class="copilot-business-signup mx-6">
  <div class="border-box width-full">
    <%= render Primer::Beta::Label.new(scheme: :done, mt: 1, mb: 2, title: "Label: Recommended") do %>
      Recommended
    <% end %>
    <h1 class="h3">Enterprise account</h1>
    <p class="mt-2 color-fg-muted">
      Centrally manage policy, billing, permissions, and benefits for multiple organizations.
    </p>

    <div class="d-flex flex-column mt-4">
      <div class="d-inline-flex align-items-center mb-4">
        <div class="flex-row mr-2">
          <div class="d-flex feature-icon-circle">
            <%= render Primer::Beta::Octicon.new(icon: :copilot, color: :default) %>
          </div>
        </div>
        <div class="flex-row">
          <h2 class="h5">Copilot Business</h2>
          <p class="color-fg-muted">Free for <%= Billing::EnterpriseCloudTrial::TRIAL_LENGTH.in_days.to_i %> days, then $<%= Copilot::COPILOT_BUSINESS_MONTHLY_BASE_PRICE %> per user/month</p>
        </div>
      </div>

      <div class="d-inline-flex align-items-center mb-4">
        <div class="flex-row mr-2">
          <div class="d-flex feature-icon-circle">
            <%= render Primer::Beta::Octicon.new(icon: :"shield-lock", color: :default) %>
          </div>
        </div>
        <div class="flex-row">
          <h2 class="h5">Advanced Security</h2>
          <p class="color-fg-muted">Free for <%= Billing::EnterpriseCloudTrial::TRIAL_LENGTH.in_days.to_i %> days, then $49 per month/per committer</p>
        </div>
      </div>

      <div class="d-inline-flex align-items-center mb-4">
        <div class="flex-row mr-2">
          <div class="d-flex feature-icon-circle">
            <%= render Primer::Beta::Octicon.new(icon: :server, color: :default) %>
          </div>
        </div>
        <div class="flex-row">
          <h2 class="h5">Enterprise Cloud</h2>
          <p class="color-fg-muted">Free for <%= Billing::EnterpriseCloudTrial::TRIAL_LENGTH.in_days.to_i %> days, then $21 per user/month</p>
        </div>
      </div>
    </div>

    <%= render(Primer::Beta::Link.new(classes: "btn btn-mktg btn-block", href: enterprise_trial_accounts_new_path(with: params[:with]))) { "Create an enterprise account" } %>
  </div>

  <h2 class="h3 mt-4">Other options:</h2>

  <div class="border-box width-full mt-3 mb-6">
    <h1 class="h3">Organization account</h1>
    <p class="mt-2 color-fg-muted">A single organization.</p>

    <div class="d-flex flex-column mt-3">
      <div class="d-inline-flex align-items-center mb-4">
        <div class="flex-row mr-2">
          <div class="d-flex feature-icon-circle">
            <%= render Primer::Beta::Octicon.new(icon: :copilot, color: :default) %>
          </div>
        </div>
        <div class="flex-row">
          <h2 class="h5">Copilot Business</h2>
          <p class="color-fg-muted">$<%= Copilot::COPILOT_BUSINESS_MONTHLY_BASE_PRICE %> per user/month</p>
        </div>
      </div>

      <div class="d-inline-flex align-items-center mb-4">
        <div class="flex-row mr-2">
          <div class="d-flex feature-icon-circle">
            <%= render Primer::Beta::Octicon.new(icon: :"shield-lock", color: :default) %>
          </div>
        </div>
        <div class="flex-row">
          <h2 class="h5">Advanced Security</h2>
          <p class="color-fg-muted">
            Free for public repositories<br>
            $49 per month/per committer for private repositories
          </p>
        </div>
      </div>
    </div>

    <%= render(Primer::Beta::Link.new(classes: "btn btn-dfd-secondary btn-block", href: new_organization_path(with: params[:with]))) { "Create an organization account" } %>
  </div>
</div>
