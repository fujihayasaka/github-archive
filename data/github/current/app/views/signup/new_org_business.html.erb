<%
  page_info(
    title: title,
    class: "header-overlay",
    full_height: true,
  )

  contentful_custom_content_entry ||= contentful_custom_content_entry
  with_param ||= nil
  is_logged_in ||= false
  has_organization ||= false
  hide_enterprise_copilot_business ||= false
%>

<% content_for :signups_left_panel do %>
  <%= render(Signups::SignupsContentPanelComponent.new(custom_page_param: custom_page, contentful_custom_content_entry: contentful_custom_content_entry, is_logged_in: is_logged_in, has_organization: has_organization, with_param: with_param)) %>
<% end %>

<div class="copilot-business-signup tmp-mx-6">
  <div class="border-box width-full">
    <%= render Primer::Beta::Label.new(scheme: :done, mt: 1, mb: 2, title: "Label: Recommended") do %>
      Recommended
    <% end %>
    <h1 class="h3">Enterprise account</h1>
    <p class="mt-2 color-fg-muted">
      Centrally manage policy, billing, permissions, and benefits for multiple organizations.
    </p>

    <div class="d-flex flex-column tmp-mt-4">
      <% if hide_enterprise_copilot_business %>
        <p class="color-fg-muted tmp-mb-4">
          Note: Copilot Business is currently unavailable for enterprise accounts.
        </p>
      <% else %>
        <div class="d-inline-flex align-items-center tmp-mb-4">
          <div class="flex-row mr-2">
            <div class="d-flex feature-icon-circle">
              <%= render Primer::Beta::Octicon.new(icon: :copilot, color: :default) %>
            </div>
          </div>
          <div class="flex-row">
            <h2 class="h5">Copilot Business</h2>
            <p class="color-fg-muted">Free for <%= Billing::EnterpriseCloudTrial::TRIAL_LENGTH.in_days.to_i %> days, then $<%= Copilot::COPILOT_BUSINESS_MONTHLY_BASE_PRICE %> per user/month</p>
          </div>
        </div>
      <% end %>

      <div class="d-inline-flex align-items-center tmp-mb-4">
        <div class="flex-row mr-2">
          <div class="d-flex feature-icon-circle">
            <%= render Primer::Beta::Octicon.new(icon: :"shield-lock", color: :default) %>
          </div>
        </div>
        <div class="flex-row">
          <h2 class="h5">Advanced Security</h2>
          <p class="color-fg-muted">Free for <%= Billing::EnterpriseCloudTrial::TRIAL_LENGTH.in_days.to_i %> days, then $49 per month/per committer</p>
        </div>
      </div>

      <div class="d-inline-flex align-items-center tmp-mb-4">
        <div class="flex-row mr-2">
          <div class="d-flex feature-icon-circle">
            <%= render Primer::Beta::Octicon.new(icon: :server, color: :default) %>
          </div>
        </div>
        <div class="flex-row">
          <h2 class="h5">Enterprise Cloud</h2>
          <p class="color-fg-muted">Free for <%= Billing::EnterpriseCloudTrial::TRIAL_LENGTH.in_days.to_i %> days, then $21 per user/month</p>
        </div>
      </div>
    </div>

    <% benefit_label = with_param.present? ? "benefit:#{with_param};" : "" %>
    <%= render(Primer::Beta::Link.new(
      classes: "btn btn-mktg btn-block",
      href: enterprise_trial_accounts_new_path(with: with_param),
      data: analytics_click_attributes(
            category: "Get started",
            action: "click create business get started",
            label: "#{benefit_label}ref_cta:business;ref_loc:account_create;business"
          )
      )) do %>
      Create an enterprise account
    <% end %>
  </div>

  <h2 class="h3 tmp-mt-4">Other options:</h2>

  <div class="border-box width-full tmp-mt-3 tmp-mb-6">
    <h1 class="h3">Organization account</h1>
    <p class="mt-2 color-fg-muted">A single organization.</p>

    <div class="d-flex flex-column tmp-mt-3">
      <div class="d-inline-flex align-items-center tmp-mb-4">
        <div class="flex-row mr-2">
          <div class="d-flex feature-icon-circle">
            <%= render Primer::Beta::Octicon.new(icon: :copilot, color: :default) %>
          </div>
        </div>
        <div class="flex-row">
          <h2 class="h5">Copilot Business</h2>
          <p class="color-fg-muted">$<%= Copilot::COPILOT_BUSINESS_MONTHLY_BASE_PRICE %> per user/month</p>
        </div>
      </div>

      <div class="d-inline-flex align-items-center tmp-mb-4">
        <div class="flex-row mr-2">
          <div class="d-flex feature-icon-circle">
            <%= render Primer::Beta::Octicon.new(icon: :"shield-lock", color: :default) %>
          </div>
        </div>
        <div class="flex-row">
          <h2 class="h5">Advanced Security</h2>
          <p class="color-fg-muted">
            Free for public repositories<br>
            $49 per month/per committer for private repositories
          </p>
        </div>
      </div>
    </div>

    <%= render(Primer::Beta::Link.new(
      classes: "btn btn-dfd-secondary btn-block",
      href: new_organization_path(with: with_param),
      data: analytics_click_attributes(
        category: "Get started",
        action: "click create org get started",
        label: "#{benefit_label}ref_cta:org;ref_loc:account_create;org"
      )
    )) do %>
      Create an organization account
    <% end %>
  </div>
</div>
