<%
  page_info(
    title: "Select your GitHub plan",
    class: "header-overlay",
    full_height: true,
  )

  octocaptcha = Octocaptcha.new(session, page: :signup_redesign)
  show_captcha = octocaptcha.show_captcha?
  dynamically_load_captcha = show_captcha && octocaptcha.is_more_data_exchange_enabled.call
  octocaptcha_timeout = Octocaptcha::HIGHER_BROWSER_LOAD_TIMEOUT
  enable_msft_analytics ||= enable_msft_analytics
  octolytics_id ||= octolytics_id
  feature_flag_msg ||= feature_flag_msg
  custom_page_param ||= custom_page_param
  contentful_custom_content_entry ||= contentful_custom_content_entry
  social_signup_enabled ||= social_signup_enabled
  social_info_url = "#{social_signup_info_path}?social=true"
  social_redirect_url = login_path
%>

<% content_for :signups_left_panel do %>
  <%= render(Signups::SignupsContentPanelComponent.new(custom_page_param: custom_page_param, contentful_custom_content_entry: contentful_custom_content_entry)) %>
<% end %>

<div class="p-4 m-4">
<%= render(Primer::Beta::Subhead.new(align_items: :center)) do |component| %>
  <% component.with_heading(tag: :h1) do %>
    Choose the enterprise or organization where you want to use Copilot Business
  <% end %>
  <% component.with_description do %>
    Before you can use Copilot Business, you need to choose the enterprise or organization account in which you'll protect your code. You can also
    <%= render(Primer::Beta::Link.new(href: "/get_started?new", underline: true)) do %>
       create a new organization or enterprise account.
     <% end %>
  <% end %>
<% end %>
<%= render Primer::Alpha::UnderlinePanels.new(
    label: "Choose"
  ) do |component| %>
    <%= component.with_tab(id: "orgs", selected: false, test_selector: "orgs-tab") do |tab| %>
      <%= tab.with_text { "Organizations" } %>
      <%= tab.with_panel do %>
          <%= render Primer::Alpha::IncludeFragment.new(src: signup_orgs_path(format: :html_fragment, with: params[:with]), data: {turbo_frame: "org_list"}) do %>
            <%= render(Primer::Beta::Spinner.new(size: :small)) %>
          <% end %>
      <% end %>
    <% end %>
    <%= component.with_tab(id: "enterprises", selected: true, test_selector: "businesses-tab") do |tab| %>
      <%= tab.with_text { "Enterprises" } %>
      <%= tab.with_panel do %>
        <%= render Primer::Alpha::IncludeFragment.new(src: signup_enterprise_path(format: :html_fragment, with: params[:with]), data: {turbo_frame: "business_list"}) do %>
          <%= render(Primer::Beta::Spinner.new(size: :small)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
<% if enable_msft_analytics %>
  <microsoft-analytics>
    <% if content_for?(:microsoft_analytics_addition) %>
      <%= yield :microsoft_analytics_addition %>
    <% end %>
  </microsoft-analytics>
<% end %>
