<%
  page_info(
    title: title,
    class: "header-overlay",
    full_height: true,
  )

  octocaptcha = Octocaptcha.new(session, page: :signup_redesign)
  show_captcha = octocaptcha.show_captcha?
  dynamically_load_captcha = show_captcha && octocaptcha.is_more_data_exchange_enabled.call
  octocaptcha_timeout = Octocaptcha::HIGHER_BROWSER_LOAD_TIMEOUT
  enable_msft_analytics ||= enable_msft_analytics
  octolytics_id ||= octolytics_id
  feature_flag_msg ||= feature_flag_msg
  custom_page ||= custom_page
  contentful_custom_content_entry ||= contentful_custom_content_entry
  social_signup_enabled ||= social_signup_enabled
  social_info_url = "#{social_signup_info_path}?social=true"
  social_redirect_url = login_path
  get_started_link_text ||= get_started_link_text
  get_started_title ||= get_started_title
  get_started_text_body ||= get_started_text_body
  is_logged_in ||= false
  has_organization ||= false
%>

<% content_for :signups_left_panel do %>
  <%= render(Signups::SignupsContentPanelComponent.new(custom_page_param: custom_page, contentful_custom_content_entry: contentful_custom_content_entry, is_logged_in: is_logged_in, has_organization: has_organization, with_param: with_param)) %>
<% end %>

<% risk_assessment = with_param == "risk-assessment" %>
<div class="copilot-business-signup tmp-mx-6 tmp-p-4 flex-1">
  <div class="tmp-mb-4">
    <h1 class="h3"><%= get_started_title %></h1>
    <p class="mt-2 color-fg-muted">
      <%= get_started_text_body %>
      <%= render(Primer::Beta::Link.new(href: get_started_url, underline: true)) do %>
        <%= get_started_link_text %>
      <% end %>.
    </p>
  </div>
  <% if risk_assessment %>
    <%= render Primer::Alpha::IncludeFragment.new(src: signup_orgs_path(with: params[:with]), classes: "d-block width-full") do %>
      <%= render(Primer::Beta::Spinner.new(size: :small)) %>
    <% end %>
  <% else %>
    <%= render Primer::Alpha::UnderlinePanels.new(
      label: "Choose"
    ) do |component| %>
      <%= component.with_tab(id: "enterprises", selected: true, test_selector: "businesses-tab") do |tab| %>
        <%= tab.with_text do %>
          <%= render Primer::Beta::Octicon.new(icon: :globe, color: :default, mr: 2) %>
          Enterprises
        <% end %>
        <%= tab.with_panel do %>
          <%= render Primer::Alpha::IncludeFragment.new(src: signup_enterprise_path(with: params[:with])) do %>
            <%= render(Primer::Beta::Spinner.new(size: :small)) %>
          <% end %>
        <% end %>
      <% end %>
      <%= component.with_tab(id: "orgs", selected: false, test_selector: "orgs-tab") do |tab| %>
        <%= tab.with_text do %>
          <%= render Primer::Beta::Octicon.new(icon: :organization, color: :default, mr: 2) %>
          Organizations
        <% end %>
        <%= tab.with_panel do %>
          <%= render Primer::Alpha::IncludeFragment.new(src: signup_orgs_path(with: params[:with])) do %>
            <%= render(Primer::Beta::Spinner.new(size: :small)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

<% if enable_msft_analytics %>
  <microsoft-analytics>
    <% if content_for?(:microsoft_analytics_addition) %>
      <%= yield :microsoft_analytics_addition %>
    <% end %>
  </microsoft-analytics>
<% end %>
