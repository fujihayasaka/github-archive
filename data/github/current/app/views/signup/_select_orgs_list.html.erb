<turbo-frame id="orgs_list" class="mt-3">
  <%= form_with url: signup_orgs_path(with: params[:with]),
    method: :get,
    data: { turbo_frame: "orgs_list" },
    class: "mb-3" do %>
    <div class="auto-search-group">
      <input class="form-control width-full input-contrast auto-search-input"
        type="text"
        name="query"
        value="<%= params[:query] %>"
        placeholder="Search or filter organizations"
        aria-label="Search or filter organizations"
        autocomplete="off"
        data-throttled-autosubmit>
      <%= render Primer::Beta::Octicon.new(icon: "search") %>
      <%= render(Primer::Beta::Spinner.new(size: :small, classes: "spinner")) %>
    </div>
  <% end %>
  <% if organizations.any? %>
    <%= render(Primer::Box.new(border: true, border_radius: 2)) do %>
      <% organizations.each do |organization| %>
        <%= render(Primer::Box.new(
            border: :bottom,
            display: :flex,
            align_items: :center,
            justify_content: :space_between,
            direction: :row,
            p: 2))  do %>
          <div>
            <%= link_to h(user_path(organization)) do %>
              <%= render GitHub::AvatarComponent.new actor: organization, size: 48, mr: 2 %>
            <% end %>
            <%= render(Primer::Beta::Link.new(href: h(user_path(organization)), font_size: 4, font_weight: :bold)) do %>
              <%= organization.safe_profile_name %>
            <% end %>
          </div>
          <%= render Primer::Beta::Button.new(
            tag: :a,
            pr: 2,
            href: "/github-copilot/purchase?organization=#{organization.safe_profile_name}&with=#{params[:with]}"
          ) do %>
            Continue
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if organizations.respond_to?(:total_pages) %>
      <div class="paginate-container">
        <%= will_paginate(organizations,
            renderer: TurboPaginationCollectionFrameReplaceLinkRenderer,
            html: { "data-turbo-frame": "orgs_list" }) %>
      </div>
    <% end %>
  <% else %>
    No organizations found
  <% end %>
</turbo-frame>
