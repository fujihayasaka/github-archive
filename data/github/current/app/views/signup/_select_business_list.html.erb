<turbo-frame id="business_list" class="mt-3">
  <%= form_with url: signup_enterprise_path(with: params[:with]),
    method: :get,
    data: { turbo_frame: "business_list" },
    class: "mb-3" do %>
    <div class="auto-search-group">
      <input class="form-control width-full input-contrast auto-search-input"
        type="text"
        name="query"
        value="<%= params[:query] %>"
        placeholder="Search or filter enterprises"
        aria-label="Search or filter enterprises"
        autocomplete="off"
        data-throttled-autosubmit>
      <%= render Primer::Beta::Octicon.new(icon: "search") %>
      <%= render(Primer::Beta::Spinner.new(size: :small, classes: "spinner")) %>
    </div>
  <% end %>
  <% if businesses.any? %>
    <%= render(Primer::Box.new(border: true, border_radius: 2)) do %>
      <% businesses.each do |business| %>
        <%= render(Primer::Box.new(
            border: :bottom,
            display: :flex,
            align_items: :center,
            justify_content: :space_between,
            direction: :row,
            p: 2))  do %>
          <div>
            <%= link_to h(enterprise_path(business)) do %>
              <%= render GitHub::AvatarComponent.new actor: business, size: 48, mr: 2 %>
            <% end %>
            <%= render(Primer::Beta::Link.new(href: h(enterprise_path(business)), font_size: 4, font_weight: :bold)) do %>
              <%= business.safe_profile_name %>
            <% end %>
          </div>
          <%= render Primer::Beta::Button.new(
            tag: :a,
            pr: 2,
            href: business.trial? ? enterprise_trial_activations_path(business) : settings_copilot_enterprise_path(business)
          ) do %>
            Continue
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if businesses.respond_to?(:total_pages) %>
      <div class="paginate-container">
        <%= will_paginate(businesses,
            renderer: TurboPaginationCollectionFrameReplaceLinkRenderer,
            html: { "data-turbo-frame": "business_list" }) %>
      </div>
    <% end %>
  <% else %>
    No enterprises found.
  <% end %>
</turbo-frame>

