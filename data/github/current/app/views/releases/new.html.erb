<%# rubocop:disable Lint/InstanceVariable %>
<%
  page_info(
    title: %{New release · #{current_repository.name_with_display_owner}},
    container_xl: true,
    selected_link: :repo_releases,
  )
  @disable_branch_selector = true

  marketplace_view = Releases::ActionMarketplaceView.new(
    release: @release,
    current_user: current_user,
    marketplace_enabled: GitHub.marketplace_enabled?,
    query_params: params
  )
%>

<%= render layout: "layouts/repository_container", locals: { repository: current_repository } do %>
<div class="clearfix container-xl px-3 px-md-4 px-lg-5 mt-4">
  <%= render(Primer::Beta::Breadcrumbs.new(mb: 2, test_selector: "release-new-breadcrumb")) do |component| %>
    <% component.with_item(href: releases_path(current_repository)) do %>Releases<% end %>
    <% component.with_item(href: request.path) { "New Release" } %>
  <% end %>
  <%= render Primer::Beta::Subhead.new(mb: 4) do |component| %>
    <% component.with_heading(tag: :h3, size: :medium) do %>
      <strong>New release</strong>
    <% end %>
  <% end %>
  <h1 class='sr-only'>New release</h1>
  <div class="clearfix">
    <div class="float-left col-12 col-md-9 pr-md-3">
      <% if @immutable_releases_enabled %>
        <%= render(Primer::Alpha::Banner.new(icon: :info, mb: 4, test_selector: "immutable-release-enabled-banner")) do %>
          Immutable releases have been enabled. Your ability to edit this release after publishing will be limited
          to release title and notes.
          <%= render(Primer::Beta::Link.new(href: "#{GitHub.help_url}/code-security/supply-chain-security/understanding-your-software-supply-chain/immutable-releases", classes: "Link--inTextBlock", scheme: :default, underline: true)) { "Learn more about immutable releases" } %>
        <% end %>
      <% end %>
      <% if marketplace_view.show_locked? %>
        <% if marketplace_view.potential_marketplace_action? && !marketplace_view.action_package_listed_to_marketplace?  %>
          <%= render partial: "releases/action_marketplace_locked", locals: { view: marketplace_view } %>
        <% end %>
      <% end %>
      <h2 class="sr-only">New release form</h2>
      <%= form_for @release,
          :url => create_release_path,
          :html => {
            :class => "js-release-form",
            :"data-repo-url" => repository_path(current_repository)
          } do |f| %>
        <%= render partial: "releases/release_form", locals: { f: f, marketplace_view: marketplace_view } %>
      <% end %>
    </div>

    <div class="float-left col-12 col-md-3 pl-md-2 pt-4 pt-md-0">
      <%= render :partial => "releases/suggestions" %>
    </div>
  </div>
</div>
<% end %>
