<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%= render Primer::Alpha::IncludeFragment.new(display: :flex, classes: "flex-column flex-items-center tmp-m-4 tmp-p-4", src: view.results_path) do %>
  <div data-hide-on-error class="tmp-m-4 tmp-p-4 d-flex flex-column flex-items-center">
    <%= render(Primer::Beta::Spinner.new) %>
    <div class="color-fg-muted no-wrap">Loading audit log entries&hellip;</div>
  </div>
  <div data-show-on-error hidden>
    Something went wrong.
    <%= render(Primer::ButtonComponent.new("data-retry-button": "", variant: :small)) { "Retry" } %>
  </div>
<% end %>
