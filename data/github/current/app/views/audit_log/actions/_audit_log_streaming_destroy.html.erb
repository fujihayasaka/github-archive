<% case view.entry.hit[:audit_log_stream_sink] %>
<% when "azure_blob" %>
  Deleted Azure Blob Storage endpoint.
<% when "azure_hubs" %>
  Deleted Azure Event Hubs endpoint.
<% when "datadog" %>
  Deleted Datadog endpoint.
<% when "google_cloud" %>
  Deleted Google Cloud Storage endpoint.
<% when "s3" %>
  Deleted Amazon S3 endpoint.
<% when "splunk" %>
  Deleted Splunk endpoint.
<% else %>
  Deleted <%= view.entry.hit[:audit_log_stream_sink] %> streaming endpoint.
<% end %>
