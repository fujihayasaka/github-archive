<% if view.entry.hit.data[:failure_type] %>
  <% case view.entry.hit.data[:failure_type].to_s %>
  <% when "passkey" %>
    Failed to login with passkey <%= view.entry.hit.data[:note].try(:downcase) %>
  <% when "social_provider" %>
    Failed to login via social identity provider <%= view.entry.hit.data[:note].try(:downcase) %>
  <% else %>
    Failed to login <%= view.entry.hit.data[:note].try(:downcase) %>
  <% end %>
<% else %>
  Failed to login <%= view.entry.hit.data[:note].try(:downcase) %>
<% end %>


