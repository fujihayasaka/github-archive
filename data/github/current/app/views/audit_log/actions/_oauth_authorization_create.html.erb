<% if view.personal_access_token? %>
  Created authorization for <%= view.oauth_type %> with <span class="context"><%= view.oauth_scopes %></span> scope(s)
<% else %>
  Created authorization for <%= view.oauth_type %> <span class="context">(<%= view.oauth_application_name %>)</span>
  with <span class="context"><%= view.oauth_scopes %></span> scope(s)
<% end %>
