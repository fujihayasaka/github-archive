<% if view.entry.hit.data[:business] %>
  Overage policy was <strong><%= view.entry.hit.data[:policy_enabled] %></strong> for business
  <span class="context"><%= view.entry.hit.data[:business] %></span>
  for policy type
  <span class="context"><%= view.entry.hit.data[:policy_type] %></span> and name
  <span class="context"><%= view.entry.hit.data[:policy_name] %></span>.
<% elsif view.entry.hit.data[:org] %>
  Overage policy was <strong><%= view.entry.hit.data[:policy_enabled] %></strong> for organization
  <span class="context"><%= view.entry.hit.data[:org] %></span>
  for policy type
  <span class="context"><%= view.entry.hit.data[:policy_type] %></span> and name
  <span class="context"><%= view.entry.hit.data[:policy_name] %></span>.
<% else %>
  Overage policy was <strong><%= view.entry.hit.data[:policy_enabled] %></strong> for policy type
  <span class="context"><%= view.entry.hit.data[:policy_type] %></span> and name
  <span class="context"><%= view.entry.hit.data[:policy_name] %></span>.
<% end %>
