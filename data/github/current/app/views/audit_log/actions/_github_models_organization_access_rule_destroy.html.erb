<%# `view` is an instance of `AuditLog::AuditLogEntryView` %>
<span class="context"><%= view.link_to_actor %></span> deleted
<%= view.entry.hit[:allow] ? "an allowing" : "a blocking" %>
GitHub Models access rule for
<span class="context"><%= view.link_to_org %></span> that
<% if (model = view.entry.hit[:model]).present? %>
  targeted <span class="context"><%= view.link_to_model %></span>.
<% elsif (custom_model = view.entry.hit[:custom_model]).present? %>
  <%
    custom_model_slug = view.entry.hit[:custom_model_slug]
    uses_custom_name = custom_model_slug.present? && custom_model != custom_model_slug
  %>
  targeted custom model &ldquo;<span class="context"><%= custom_model %></span>&rdquo;<%= "." unless uses_custom_name %>
  <% if uses_custom_name %>
    using model <span class="context"><%= slug %></span>.
  <% end %>
<% elsif (publisher = view.entry.hit[:model_publisher]).present? %>
  targeted models from <span class="context"><%= publisher %></span>.
<% elsif (custom_key = view.entry.hit[:custom_key]).present? %>
  targeted custom models using
  <% if (custom_key_provider = view.entry.hit[:custom_key_provider]).present? %>
    <span class="context"><%= pretty_custom_key_provider(custom_key_provider) %></span>
  <% end %>
  key <span class="context"><%= custom_key %></span>.
<% else %>
  <%# global block rule was deleted for the org (global allow rules can't exist) %>
  blocked all models except those explicitly allowed. Now models will be available except for those
  explicitly blocked.
<% end %>
