<% config_value = view.entry.hit.data[:configuration_value] %>
<% if config_value == "allow_all" %>
  App access requests are now allowed for members and outside collaborators in <%= view.link_to_org %>
<% elsif config_value == "allow_org_members_only" %>
  App access requests are now limited to members only in <%= view.link_to_org %>
<% elsif config_value == "disabled" %>
  App access requests are now disabled for everyone in <%= view.link_to_org %>
<% end %>
