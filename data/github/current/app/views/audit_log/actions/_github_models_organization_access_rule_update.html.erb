<%# `view` is an instance of `AuditLog::AuditLogEntryView` %>
<span class="context"><%= view.link_to_actor %></span> modified
<%= view.entry.hit[:old_allow] ? "an allowing" : "a blocking" %>
GitHub Models access rule for
<span class="context"><%= view.entry.safe_organization_name %></span> that now
<%= view.entry.hit[:allow] ? "allows" : "blocks" %>
<% if (model = view.entry.hit[:model]).present? %>
  access to <span class="context"><%= view.link_to_model %></span>.
<% elsif (publisher = view.entry.hit[:model_publisher]).present? %>
  access to models from <span class="context"><%= publisher %></span>.
<% else %>
  GitHub Models access.
<% end %>
