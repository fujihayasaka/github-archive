<% exemption_message = view.entry.hit.data[:exempt_administrators] == true ? "Exempting administrators" : "Not exempting administrators" %>
<% if view.entry.hit.data[:old_token_expiration] != view.entry.hit.data[:token_expiration] %>
  <% if view.entry.hit.data[:old_token_expiration] %>
    <strong><%= view.entry.safe_actor_login %></strong> changed <%= view.programmatic_access_type %> maximum lifetime from <%= view.entry.hit.data[:old_token_expiration] %> days to <%= view.entry.hit.data[:token_expiration] %> days (<%= exemption_message %>)
  <% else %>
    <strong><%= view.entry.safe_actor_login %></strong> set <%= view.programmatic_access_type %> maximum lifetime to <%= view.entry.hit.data[:token_expiration] %> days (<%= exemption_message %>)
  <% end %>
<% else %>
  <strong><%= view.entry.safe_actor_login %></strong> maximum lifetime for <%= view.programmatic_access_type %> is <%= exemption_message.downcase %> now.
<% end %>
