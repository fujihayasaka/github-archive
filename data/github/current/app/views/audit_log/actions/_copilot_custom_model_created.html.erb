<%# `view` is an instance of `AuditLog::AuditLogEntryView` %>
<%
  name = view.entry.hit[:copilot_custom_model]
  slug = view.entry.hit[:copilot_custom_model_slug]
  uses_custom_name = name != slug
%>
<span class="context"><%= view.link_to_actor %></span> created a custom
<span class="context"><%= pretty_custom_key_provider(view.entry.hit[:copilot_custom_key_provider]) %></span>
model named &ldquo;<span class="context"><%= name %></span>&rdquo;<%= "," if uses_custom_name %>
<% if uses_custom_name %>
  using model <span class="context"><%= slug %></span>
<% end %>
in <span class="context"><%= view.link_to_org %></span>,
using custom key <span class="context"><%= view.entry.hit[:copilot_custom_key] %></span>.
