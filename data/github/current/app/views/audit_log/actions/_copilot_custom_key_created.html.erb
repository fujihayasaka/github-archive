<%# `view` is an instance of `AuditLog::AuditLogEntryView` %>
<%
  deployment_url = view.entry.hit[:deployment_url]
%>
<span class="context"><%= view.link_to_actor %></span> created a custom
<span class="context"><%= pretty_copilot_byok_custom_key_provider(view.entry.hit[:copilot_custom_key_provider]) %></span> key
<% if view.org? %>
  in <span class="context"><%= view.link_to_org %></span>
<% elsif view.business? %>
  in <span class="context"><%= view.link_to_business %></span>
<% end %>
named
<span class="context"><%= view.entry.hit[:copilot_custom_key] %></span><%= "." if deployment_url.blank? %>
<% if deployment_url.present? %>
  using deployment URL <code class="context"><%= deployment_url %></code>.
<% end %>
