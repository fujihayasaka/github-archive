<%# `view` is an instance of `AuditLog::AuditLogEntryView` %>
<span class="context"><%= view.link_to_actor %></span> deleted the custom
<span class="context"><%= pretty_copilot_byok_custom_key_provider(view.entry.hit[:copilot_custom_key_provider]) %></span>
key named <span class="context"><%= view.entry.hit[:copilot_custom_key] %></span>
<% if view.org? %>
  in <span class="context"><%= view.link_to_org %></span>.
<% elsif view.business? %>
  in <span class="context"><%= view.link_to_business %></span>.
<% end %>
