<% if view.entry.hit.data[:business] %>
  Budget was <strong>created</strong> for business
  <span class="context"><%= view.entry.hit.data[:business] %></span>
  with a limit of
  <span class="context"><%= view.entry.hit.data[:target_amount] %></span>
  (<span class="context"><%= view.entry.hit.data[:budget_limit_type] %></span>).
<% elsif view.entry.hit.data[:org] %>
  Budget was <strong>created</strong> for organization
  <span class="context"><%= view.entry.hit.data[:org] %></span>
  with a limit of
  <span class="context"><%= view.entry.hit.data[:target_amount] %></span>
  (<span class="context"><%= view.entry.hit.data[:budget_limit_type] %></span>).
<% else %>
  Budget was <strong>created</strong> with a limit of
  <span class="context"><%= view.entry.hit.data[:target_amount] %></span>
  (<span class="context"><%= view.entry.hit.data[:budget_limit_type] %></span>).
<% end %>
<% if view.entry.hit.data[:alert_enabled] %>
  <span>Budget alerts are enabled.</span>
<% end %>
