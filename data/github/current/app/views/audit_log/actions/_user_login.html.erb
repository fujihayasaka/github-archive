Logged in

<% if view.entry.hit.data[:sign_in_method] %>
  <% case view.entry.hit.data[:sign_in_method].to_s %>
  <% when "passkey" %>
    with passkey
  <% when "social_provider" %>
    via social identity <%= view.entry.hit.data[:social_email_address] %>
  <% end %>
<% elsif view.entry.hit.data[:sign_in_verification_method] && view.entry.hit.data[:sign_in_verification_method] == "passkey" %>
  with passkey
<% end %>
