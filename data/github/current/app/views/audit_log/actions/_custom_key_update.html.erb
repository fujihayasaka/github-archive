<%# `view` is an instance of `AuditLog::AuditLogEntryView` %>
<%
  deployment_url = view.entry.hit[:deployment_url]
  old_deployment_url = view.entry.hit[:old_deployment_url]
  name = view.entry.hit[:custom_key]
  old_name = view.entry.hit[:old_custom_key]
  name_changed = old_name.present? && name.present?
%>
<span class="context"><%= view.link_to_actor %></span> changed
<% if name_changed %>
  an
<% else %>
  the
<% end %>
<span class="context"><%= pretty_custom_key_provider(view.entry.hit[:custom_key_provider]) %></span> custom key
<% unless name_changed %>
  named <span class="context"><%= name %></span>
<% end %>
in <span class="context"><%= view.link_to_org %></span>.
<% if name_changed %>
  It was renamed from <span class="context"><%= old_name %></span> to <span class="context"><%= name %></span>.
<% end %>
<% if old_deployment_url.present? && deployment_url.present? %>
  The deployment URL was switched from <code class="context"><%= old_deployment_url %></code>
  to <code class="context"><%= deployment_url %></code>.
<% end %>
