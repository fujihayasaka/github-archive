<%# `view` is an instance of `AuditLog::AuditLogEntryView` %>
<%
  copilot_chat_enabled = view.entry.hit[:copilot_chat_enabled]
  old_copilot_chat_enabled = view.entry.hit[:old_copilot_chat_enabled]
  copilot_chat_setting_changed = !copilot_chat_enabled.nil? && !old_copilot_chat_enabled.nil? &&
    copilot_chat_enabled != old_copilot_chat_enabled
  name = view.entry.hit[:custom_model]
  old_name = view.entry.hit[:old_custom_model]
  slug = view.entry.hit[:custom_model_slug]
  uses_custom_name = name != slug
  name_changed = old_name.present? && name.present?
%>
<span class="context"><%= view.link_to_actor %></span> changed
<% if name_changed %>
  an
<% else %>
  the
<% end %>
<span class="context"><%= pretty_custom_key_provider(view.entry.hit[:custom_key_provider]) %></span> custom model
<% unless name_changed %>
  named &ldquo;<span class="context"><%= name %></span>&rdquo;
<% end %>
<% if uses_custom_name %>
  using model <span class="context"><%= slug %></span>
<% end %>
in <span class="context"><%= view.link_to_org %></span>.
<% if name_changed %>
  It was renamed from &ldquo;<span class="context"><%= old_name %></span>&rdquo;
  to &ldquo;<span class="context"><%= name %></span>&rdquo;.
<% end %>
<% if copilot_chat_setting_changed %>
  Copilot Chat is
  <% if copilot_chat_enabled %>
    now
  <% else %>
    no longer
  <% end %>
  enabled.
<% end %>
