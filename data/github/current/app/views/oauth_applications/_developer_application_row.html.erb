<div class="Box-row d-flex flex-items-center">
  <div class="CircleBadge CircleBadge--small position-relative flex-shrink-0" style="background-color: #<%=developer_application_row.preferred_bgcolor %>;">
    <%= link_to oauth_application_path(developer_application_row), class: "CircleBadge-icon" do %>
      <%= oauth_application_logo(developer_application_row, 30, :alt => developer_application_row.name) %>
    <% end %>
  </div>
  <div class="TableObject-item TableObject-item--primary pl-3">
    <span class="text-bold">
      <%= link_to developer_application_row.name, oauth_application_path(developer_application_row), :class => "text-bold" %>
      <% if developer_application_row.pending_deletion? %>
        <%= render(Primer::Beta::Label.new(ml: 1, scheme: :attention, title: "Label: Pending deletion")) { "Pending deletion" } %>
      <% end %>
    </span><br>
    <% if developer_application_row.description? %>
      <div class="text-small color-fg-muted ws-normal"><%= truncate(developer_application_row.description, :length => 40) %></div>
    <% end %>
  </div>
  <div class="flex-self-center flex-justify-end">
    <%= link_to "Edit", oauth_application_path(developer_application_row), :class => "btn btn-sm", 'data-pjax' => true %>
  </div>
</div>
