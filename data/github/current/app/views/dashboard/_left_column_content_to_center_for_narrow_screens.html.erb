<% unless dashboard_universe_enabled? &&
  !FeatureFlag.vexi.enabled?(:disable_dashboard_repositories_mobile, current_user, default: false) %>
  <div class="d-block d-md-none">
    <nav class="mt-2 tmp-mb-4 Details js-repos-container" <%= test_selector("dashboard-repositories-box")%> aria-labelledby="dashboard-repositories-nav-heading">
      <h2 id="dashboard-repositories-nav-heading" class="f5 tmp-mb-4 d-flex flex-justify-between flex-items-center">Top Repositories</h2>
      <div class="Box px-2 py-1 color-bg-default">
        <%= render Primer::Alpha::IncludeFragment.new(src: dashboard_my_top_repositories_path(q: query, location: "center", mobile: true)) do %>
          <div class="text-center tmp-p-3 tmp-mb-4 mt-2">
            <%= render(Primer::Beta::Spinner.new) %>
            <p class="color-fg-muted my-2 mb-0">Loading...</p>
          </div>
        <% end %>
      </div>
    </nav>
  </div>
<% end %>
