<div class="d-block d-md-none">
  <% if user_feature_enabled?(UserDashboardPin::WEB_FEATURE) %>
    <nav class="mt-2 mb-4 Details js-repos-container" id="dashboard-favorites-box" aria-labelledby="dashboard-favorites-nav-heading">
      <div id="dashboard-favorites-nav-heading" class="d-flex flex-justify-between flex-items-center">
        <h2 class="f4 mb-1 text-normal">Favorites</h2>
      <% if any_pinned_repos? %>
        <%= render Primer::Beta::Button.new(
          scheme: :invisible,
          hide: :whenWide,
          size: :medium,
          display: :flex,
          id: "dialog-show-edit-dashboard-favorites",
          data: {
            "show-dialog-id": "edit-dashboard-favorites",
            target: "modal-dialog.show-button"
          },
          aria: {
            label: "Edit favorites"
          },
          test_selector: "dashboard-favorites-edit-button-mobile"
        ).with_content("Edit") %>
      <% end %>
      </div>
      <div class="Box pt-2 mt-2 px-2 py-1 color-bg-default">
        <%= render Primer::Alpha::IncludeFragment.new(src: dashboard_favorites_path, "data-targets": "loading-context.fragments") do %>
          <div class="mb-4 Details js-repos-container <%= "mt-5" unless user_can_switch_contexts? %>" <%= test_selector("dashboard-favorite-repos") %> data-repository-hovercards-enabled role="navigation" aria-label="Your Favorite Repositories">
            <div class="d-flex flex-justify-between flex-items-center">
              <h2 class="hide-sm hide-md mb-1 f5">
                Favorites
              </h2>
            </div>
          </div>
          <loading-subscriber></loading-subscriber>
        <% end %>
      </div>
    </nav>

    <nav class="mt-2 mb-4 Details js-repos-container" <%= test_selector("dashboard-repositories-box")%> aria-labelledby="dashboard-repositories-nav-heading">
      <h2 id="dashboard-repositories-nav-heading" class="f4 mb-1 text-normal d-flex flex-justify-between flex-items-center">Top Repositories</h2>
      <div class="Box px-2 py-1 color-bg-default">
        <%= render Primer::Alpha::IncludeFragment.new(src: dashboard_my_top_repositories_path(q: query, location: "center", mobile: true)) do %>
          <div class="text-center p-3 mb-4 mt-2">
            <%= render(Primer::Beta::Spinner.new) %>
            <p class="color-fg-muted my-2 mb-0">Loading...</p>
          </div>
        <% end %>
      </div>
    </nav>
  <% else %>
    <nav class="mt-2 mb-4 Details js-repos-container" <%= test_selector("dashboard-repositories-box")%> aria-labelledby="dashboard-repositories-nav-heading">
      <h2 id="dashboard-repositories-nav-heading" class="f5 mb-4 d-flex flex-justify-between flex-items-center">Top Repositories</h2>
      <div class="Box px-2 py-1 color-bg-default">
        <%= render Primer::Alpha::IncludeFragment.new(src: dashboard_my_top_repositories_path(q: query, location: "center", mobile: true)) do %>
          <div class="text-center p-3 mb-4 mt-2">
            <%= render(Primer::Beta::Spinner.new) %>
            <p class="color-fg-muted my-2 mb-0">Loading...</p>
          </div>
        <% end %>
      </div>
    </nav>
  <% end %>

  <div class="mb-4">
    <%= render Primer::Alpha::IncludeFragment.new(src: dashboard_recent_activity_path(organization_id: current_organization.try(:global_relay_id), mobile: true)) do %>
      <div class="text-center p-3">
        <%= render(Primer::Beta::Spinner.new) %>
        <p class="color-fg-muted my-2 mb-0">Loading...</p>
      </div>
    <% end %>
  </div>

  <% if current_user.organizations.any? %>
    <div class="mb-4 js-repos-container user-repos" id="dashboard-user-teams-repos">
      <h2 class="f5 mb-4">Your teams</h2>
      <div class="Box px-2 py-1 color-bg-default">
        <%= render partial: "dashboard/user_teams", locals: { teams: teams, viewer: current_user, query: team_query, location: "center" } %>
      </div>
    </div>
  <% end %>
</div>
