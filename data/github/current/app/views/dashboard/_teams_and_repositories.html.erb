<%= render Dashboard::LoadingContextComponent.new do |c| %>
  <% c.with_details do %>
    <% if user_feature_enabled?(UserDashboardPin::WEB_FEATURE) %>
      <%= render Primer::Alpha::IncludeFragment.new(src: dashboard_favorites_path, "data-targets": "loading-context.fragments") do %>
        <div class="mb-4 Details js-repos-container <%= "mt-5" unless user_can_switch_contexts? %>" <%= test_selector("dashboard-favorite-repos") %> data-repository-hovercards-enabled role="navigation" aria-label="Your Favorite Repositories">
          <div class="d-flex flex-justify-between flex-items-center">
            <h2 class="hide-sm hide-md mb-1 f5">
              Favorites
            </h2>
          </div>
        </div>
        <loading-subscriber></loading-subscriber>
      <% end %>
    <% end %>

    <% if FeatureFlag.vexi.enabled?(:dashboard_repositories, current_user, default: false) %>
      <%= render_react_partial name: "dashboard-repositories", props: { title: "Repositories" } %>
    <% else %>
      <%= render Primer::Alpha::IncludeFragment.new(src: dashboard_my_top_repositories_path(q: user_repo_query, location: "left"), "data-targets": "loading-context.fragments") %>
    <% end %>

    <% unless FeatureFlag.vexi.enabled?(:dashboard_hide_teams_and_recent_activity, current_user, default: false) %>
      <div class="mb-4">
        <%= render Primer::Alpha::IncludeFragment.new(src: dashboard_recent_activity_path(organization_id: current_organization.try(:global_relay_id)), "data-targets": "loading-context.fragments") %>
      </div>

      <% unless current_user.feature_preview_enabled?(:global_nav_experiment) || user_feature_enabled?(:dashboard_nav_experiment) %>
        <% if current_user.teams.any? %>
          <div class="js-repos-container user-repos mb-3 pb-6" id="dashboard-user-teams">
            <%= render partial: "dashboard/user_teams", locals: { teams: teams, viewer: viewer, query: team_query, location: "left" } %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
