<% if current_user.in_onboarding_period? %>
  <% promos = onboarding_promos(current_user: current_user, current_copilot_user_v2: current_copilot_user_v2) %>
  <div <%= test_selector('onboarding-marketing-banners') %>>
    <% promos.each do |promo| %>
      <% if current_user.feature_flag_enabled?(promo[:feature], default: false) && UserNotice.find(promo[:notice]).effective? && !current_user.dismissed_notice?(promo[:notice]) && (promo[:extra_condition].nil? || promo[:extra_condition].call) %>
        <%= render promo[:partial], notice: promo[:notice], **(promo[:locals] || {}) %> <%# rubocop:disable GitHub/RailsViewRenderLiteral %>
        <% break %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% unless current_user.in_onboarding_period? %>
  <% promos = marketing_promos(current_user: current_user, current_copilot_user_v2: current_copilot_user_v2, request: request, copilot_user: Copilot::User.new(current_user)) %>
  <div <%= test_selector('marketing-banners') %>>
    <% promos.each do |promo| %>
      <% if current_user.feature_flag_enabled?(promo[:feature], default: false) && UserNotice.find(promo[:notice]).effective? && !current_user.dismissed_notice?(promo[:notice]) && (promo[:extra_condition].nil? || promo[:extra_condition].call) %>
        <%= render promo[:partial], notice: promo[:notice], **(promo[:locals] || {}) %> <%# rubocop:disable GitHub/RailsViewRenderLiteral %>
        <% break %>
      <% end %>
    <% end %>
  </div>
<% end %>
