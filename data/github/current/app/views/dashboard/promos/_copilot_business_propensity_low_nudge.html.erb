<div class="js-notice" <%= test_selector('copilot-business-propensity-low-nudge') %>>
  <%= form_tag(
    dismiss_notice_path(notice),
    class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
    style: "background: linear-gradient(180deg, #000 -16.56%, #0E1117 100%); z-index: 1; padding-top: 18px !important; padding-bottom: 18px !important; #{ user_feature_enabled?(:feeds_v2) ? '' : 'max-width: 340px;' }",
    data: analytics_visible_attributes(
      action: "visible",
      tag: "tile",
      context: "cb_nudge_low_propensity_v1",
      location: "dashboard_nudges_top_right",
      label: "visible_tile_cb_nudge_low_propensity_v1_dashboard_nudges_top_right",
      category: "In-product banner",
      text: "copilot-business-low-banner",
    )
  ) do %>
    <img src="<%= image_path('modules/dashboard/promos/copilot/promo-copilot-business-bg.webp') %>" alt="" width="357" height="220" class="position-absolute bottom-0 right-0 width-full height-full events-none" style="z-index: -1; object-fit: cover;">

    <div class="position-absolute p-2" style="top: 2px; right: 6px; z-index: 1;">
      <%= render(Primer::Beta::CloseButton.new(
        type: :submit,
        color: :on_emphasis,
        style: "color: #ffffff !important",
        data: analytics_click_attributes(
          category: "dashboard_notices",
          action: "dismiss",
          tag: "icon",
          context: "cb_nudge_low_propensity_v1",
          location: "dashboard_nudges_top_right",
          label: "dismiss_icon_cb_nudge_low_propensity_v1_dashboard_nudges_top_right",
        ))) %>
    </div>

    <h3 class="h3 col-11" style="color: #ffffff !important; letter-spacing: -0.4px; line-height: 24px;">
      Curious about<br> AI-powered coding?
    </h3>

    <p class="mb-0" style="color: #d0d7de !important; margin-right: 37%; line-height: 18px; letter-spacing: -0.28px; margin-top: 12px;">
      Add Copilot Business to your plan and see how it transforms your workflows.
    </p>

    <%= render Primer::Beta::Button.new(
      size: :medium,
      tag: :a,
      href: features_copilot_copilot_business_path(ref: "dashboard_nudge"),
      block: true,
      classes: "dash-promo-dark-btn",
      data: {
        test_selector: "copilot-business-propensity-nudge-cta",
        **analytics_click_attributes(
          category: "dashboard_notices",
          action: "explore_copilot_business",
          tag: "button",
          context: "cb_nudge_low_propensity_v1",
          location: "dashboard_nudges_top_right",
          label: "explore_copilot_business_button_cb_nudge_low_propensity_v1_dashboard_nudges_top_right",
        ),
      }
    ) do %>
      Explore Copilot Business
    <% end %>

    <style>
      .dash-promo-dark-btn {
        margin-top: 24px;
        min-height: 36px;
        border-radius: 8px;
        font-weight: 600;
        color: #000000 !important;
        background: #ffffff !important;
        letter-spacing: -0.02em;
        border: 1px solid #6e7781 !important;
      }

      .dash-promo-dark-btn:hover {
        background: #f5f5f5 !important;
      }
    </style>
  <% end %>
</div>
