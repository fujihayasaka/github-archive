<%
nudge_location = "dashboard"
nudge_category = "site_universe_25_banners_day_2_pre_event"
nudge_id = :site_universe_25_banners_day_2_pre_event
nudge_group = :connect
%>
<div class="js-notice marketing-banner" <%= test_selector(nudge_category) %>>
  <%  current_user.track_nudge_impression(id: nudge_id, group: nudge_group) %>
  <div class="universe-promo-container universe-promo-container-design-2">
    <div class="universe-hero-section">
      <div class="universe-header">
        <img src="/static/images/modules/dashboard/promos/github_universe_header_light.svg" alt="GitHub Universe 2025" class="universe-header-logo">

        <%= form_tag(
          dismiss_notice_path(nudge_id, { nudge: true, group: nudge_group }),
          class: "universe-dismiss-form",
          data: analytics_visible_attributes(category: nudge_category, group: nudge_group)
        ) do %>
          <%= render(Primer::Beta::IconButton.new(
            type: :submit,
            icon: :x,
            scheme: :invisible,
            aria: { label: "Dismiss" },
            color: :on_emphasis,
            style: "color: #59636E !important",
            data: analytics_click_attributes(
              category: nudge_category,
              tag: "a",
              action: "dismiss",
              location: nudge_location,
              group: nudge_group,
            ))) %>
        <% end %>
      </div>

      <img src="/static/images/modules/dashboard/promos/github_universe_clouds_light.webp?v=1" alt="GitHub Universe Banner" class="universe-hero-image universe-hero-image-clouds-light">
      <img src="/static/images/modules/dashboard/promos/github_universe_clouds_dark.webp?v=1" alt="GitHub Universe Banner" class="universe-hero-image universe-hero-image-clouds-dark">
    </div>

    <div class="universe-event-info">
      <div class="universe-date-location">
        Oct 28-29<span class="universe-location-separator">■</span>San Francisco
      </div>
    </div>

    <div class="universe-promotion">
      <h3 class="universe-promo-description">It’s almost time! The Universe Day 2 keynote will begin soon.</h3>
    </div>

    <div class="universe-actions">
      <%= link_to(
        "/in-product-messaging/dismiss-and-redirect?group=#{nudge_group}&notice=#{nudge_id}&destination_key=#{nudge_id}",
        class: "universe-cta-design-2",
        data: analytics_click_attributes(action: "click", category: nudge_category, group: nudge_group)
      ) do %>
        Explore now
      <% end %>
    </div>
  </div>
</div>
