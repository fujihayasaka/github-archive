<%
    nudge_html_element       = "a"
    nudge_category           = "dashboard_copilot_agent_mode_launch_nudge_step_2"
    nudge_location           = "dashboard_right_sidebar"
    nudge_id                 = :dashboard_copilot_agent_mode_launch_nudge_step_2
    nudge_group              = :discover
    variant_count            = 2

    experiment_id = "dashboard_copilot_agent_mode_launch_nudge_step_2"

    # Get initial variant from experiment (0, 1, or 2)
    initial_variant = hawaii_experiment_variant(
      experiment_id: experiment_id,
      user_id: current_user.id,
      variant_count: variant_count,
    )

    # Override variant based on feature flags
    variant = initial_variant
    variant = 0 if user_feature_enabled?(:dashboard_copilot_agent_mode_launch_nudge_step_2_variant_0_preference)
    variant = 1 if user_feature_enabled?(:dashboard_copilot_agent_mode_launch_nudge_step_2_variant_1_preference)
%>

<div class="js-notice marketing-banner" <%= test_selector(nudge_category) %>>
  <% case variant %>
  <% when 0 %>
    <%  current_user.track_nudge_impression(id: nudge_id, group: nudge_group) %>
    <%= form_tag(
      dismiss_notice_path(nudge_id, { nudge: true, group: nudge_group }),
      class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
      style: "background: linear-gradient(90deg, #060628 0%, #080535 100%); z-index: 1; padding-top: 13px !important; padding-bottom: 13px !important; width: 356px;",
      data: analytics_visible_attributes(category: "#{nudge_category}_#{variant}", group: nudge_group)
    ) do %>
      <span <%= test_selector("#{nudge_category}_#{variant}") %>></span>
      <img src="<%= image_path('modules/dashboard/promos/general/gradient-bg-copilot-1746115965.retina.jpg') %>" alt="" width="355" height="215" class="position-absolute events-none" style="z-index: -1; object-fit: cover; bottom: -1px; right: 0px; width: 100%; height: 102% !important;">

      <div class="position-absolute p-2" style="top: 4px; right: 6px; z-index: 1;">
        <%= render(Primer::Beta::CloseButton.new(
          type: :submit,
          color: :on_emphasis,
          style: "color: #ffffff !important",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "dismiss",
            location: nudge_location,
            group: nudge_group,
          ))) %>
      </div>

      <div class="position-relative z-1">

        <img src="<%= image_path('modules/dashboard/promos/general/1-hour-exercise-button-1745439211.svg') %>" alt="1 hour exercise" style="margin-bottom: 10px;">
        <h3 class="col-11" style="color: #ffffff !important; letter-spacing: -0.02em; margin-bottom:10px; max-width: 200px; line-height: 130%;">
          Get started with Copilot agent mode
        </h3>

        <div>
          <span style="margin-bottom: 5px; font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 25px;">Guided walkthrough with real code</span>
          <span style="margin-bottom: 5px; font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 25px;">Use agent mode to build and compare outputs</span>
          <span style="font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 25px;">No agent mode experience needed</span>
        </div>

        <%= render Primer::Beta::Button.new(
          size: :medium,
          tag: :a,
          href: "/in-product-messaging/dismiss-and-redirect?group=#{nudge_group}&notice=#{nudge_id}&destination_key=#{nudge_category}",
          block: true,
          classes: "dash-promo-dark-btn",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "start_learning_now",
            location: nudge_location,
            group: nudge_group,
          )
        ) do %>
          Start learning now
        <% end %>
      </div>
    <% end %>
  <% when 1 %>
    <%  current_user.track_nudge_impression(id: nudge_id, group: nudge_group) %>
    <%= form_tag(
      dismiss_notice_path(nudge_id, { nudge: true, group: nudge_group }),
      class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
      style: "background: linear-gradient(90deg, #060628 0%, #080535 100%); z-index: 1; padding-top: 13px !important; padding-bottom: 13px !important; width: 356px;",
      data: analytics_visible_attributes(category: "#{nudge_category}_#{variant}", group: nudge_group)
    ) do %>
      <span <%= test_selector("#{nudge_category}_#{variant}") %>></span>
      <img src="<%= image_path('modules/dashboard/promos/general/gradient-bg-copilot-1746115965.retina.jpg') %>" alt="" width="355" height="215" class="position-absolute events-none" style="z-index: -1; object-fit: cover; bottom: -1px; right: 0px; width: 100%; height: 102% !important;">

      <div class="position-absolute p-2" style="top: 4px; right: 6px; z-index: 1;">
        <%= render(Primer::Beta::CloseButton.new(
          type: :submit,
          color: :on_emphasis,
          style: "color: #ffffff !important",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "dismiss",
            location: nudge_location,
            group: nudge_group,
          ))) %>
      </div>

      <div class="position-relative z-1">

        <img src="<%= image_path('modules/dashboard/promos/general/1-hour-exercise-button-1745439211.svg') %>" alt="1 hour exercise" style="margin-bottom: 10px;">
        <h3 class="col-11" style="color: #ffffff !important; letter-spacing: -0.02em; margin-bottom:10px; max-width: 200px; line-height: 130%;">
          Build an app with Copilot agent mode
        </h3>

        <div>
          <span style="margin-bottom: 5px; font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 25px;">Start a ready-to-go dev enviroment</span>
          <span style="margin-bottom: 5px; font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 25px;">Prompt agent mode to build a full stack app</span>
          <span style="font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 25px;">Compare outputs from GPT-4o and other models</span>
        </div>

        <%= render Primer::Beta::Button.new(
          size: :medium,
          tag: :a,
          href: "/in-product-messaging/dismiss-and-redirect?group=#{nudge_group}&notice=#{nudge_id}&destination_key=#{nudge_category}",
          block: true,
          classes: "dash-promo-dark-btn",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "start_building_now",
            location: nudge_location,
            group: nudge_group,
          )
        ) do %>
          Start building now
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<style>
  .dash-promo-dark-btn {
    margin-top: 24px;
    min-height: 36px;
    border-radius: 8px;
    font-weight: 600;
    color: #000000 !important;
    background: #ffffff !important;
    letter-spacing: -0.02em;
    border: 1px solid #6e7781 !important;
  }

  .dash-promo-dark-btn:hover {
    background: #f5f5f5 !important;
  }

  @media (max-width: 1450px) {
    .marketing-banner {
      display: none !important;
    }
  }
</style>
