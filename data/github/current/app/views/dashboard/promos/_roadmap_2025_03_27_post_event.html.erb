<%
    nudge_html_element       = "a"
    nudge_category           = "dashboard_2025_03_27_roadmap_post_event"
    nudge_location           = "dashboard_right_sidebar"
%>
  <div class="js-notice" <%= test_selector('dashboard_2025_03_27_roadmap_post_event') %>>
    <%= form_tag(
      dismiss_notice_path(:dashboard_2025_03_27_roadmap),
      class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
      style: "z-index: 1; padding-top: 18px !important; padding-bottom: 18px !important; #{ user_feature_enabled?(:feeds_v2) ? '' : 'max-width: 340px;' }",
      data: analytics_visible_attributes(category: nudge_category)
    ) do %>

      <img
        id="dashboard_2025_03_27_roadmap_post_event_bg_light"
        src="<%= image_path('modules/dashboard/promos/events/dashboard_2025_03_27_roadmap_bg_photo_v1.jpg') %>"
        alt=""
        width="355"
        height="215"
        class="position-absolute bottom-0 right-0 width-full height-full events-none"
        style="z-index: -1; object-fit: cover;"
      >

      <div class="position-absolute p-2" style="top: 4px; right: 6px; z-index: 1;">
        <%= render(Primer::Beta::CloseButton.new(
          type: :submit,
          color: :on_emphasis,
          style: "color: #ffffff !important",
          data: analytics_click_attributes(
            category: nudge_category,
            tag: nudge_html_element,
            action: "dismiss",
            location: nudge_location,
          ))) %>
      </div>

      <div class="position-relative z-1">
        <div style="margin-bottom: 15px;">
          <%= render(Primer::Beta::Label.new(
              tag: :span,
              size: :medium,
              inline: true,
              style: "background: #313177; border:0; padding: 5px 15px; font-size: 10px; color: #F6F8FA;",
              classes: "text-mono"
            )) { "WEBINAR" } %>
        </div>

        <h3 class="h3 col-7" style="line-height: 130%; margin-bottom: 10px; color: #ffffff !important; letter-spacing: -0.02em; display: inline-block; max-width: 270px;">
          Preview GitHub's latest innovations
        </h3>
        <div class="col-7" style="display: inline; position: absolute; right: -70px;">
          <img src="<%= image_path("modules/dashboard/promos/events/dashboard_2025_03_27_roadmap_mario.jpg") %>" alt="Mario Rodriguez" width="97" height="97" style="max-width: 85%; height: auto; border-radius: 50%; object-fit: cover;">
        </div>
        <div style="letter-spacing: -0.05em; color: #AFB8C1; font-size: 12px;">
          <div>
            with Mario Rodriguez,
          </div>
          <div>
            GitHub's Chief Product Officer
          </div>
          </div>

        <%= render Primer::Beta::Button.new(
          size: :medium,
          tag: :a,
          href: "/click-and-dismiss?notice=dashboard_2025_03_27_roadmap&destination_key=dashboard_2025_03_27_roadmap_post_event",
          block: true,
          classes: "dash-promo-dark-btn",
          data: analytics_click_attributes(
            category: nudge_category,
            tag: nudge_html_element,
            action: "watch_on_demand",
            location: nudge_location,
            )
        ) do %>
          Watch on demand
        <% end %>
      </div>

      <style>
        .js-notice { background: none; }

        .dash-promo-dark-btn {
          margin-top: 24px;
          min-height: 36px;
          border-radius: 8px;
          font-weight: 600;
          color: #000000 !important;
          background: #ffffff !important;
          letter-spacing: -0.02em;
          border: 1px solid #6e7781 !important;
        }

        .dash-promo-dark-btn:hover {
          background: #f5f5f5 !important;
        }
      </style>
    <% end %>
  </div>
