<%# locals: (notice:, user_propensity:) -%>
<div class="js-notice" <%= test_selector('copilot-business-propensity-nudge') %>>
  <%= form_tag(
    dismiss_notice_path(notice),
    class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
    style: "background: linear-gradient(180deg, #000 -16.56%, #0E1117 100%); z-index: 1; padding-top: 18px !important; padding-bottom: 18px !important; min-height: 210px; display: flex; flex-direction: column; #{ user_feature_enabled?(:feeds_v2) ? '' : 'max-width: 340px;' }",
    data: analytics_visible_attributes(
      action: "visible",
      tag: "tile",
      context: "cb_nudge_#{user_propensity.group}_propensity_v1",
      location: "dashboard_nudges_top_right",
      label: "visible_tile_cb_nudge_#{user_propensity.group}_propensity_v1_dashboard_nudges_top_right",
      category: "In-product banner",
      text: "copilot-business-#{user_propensity.group}-banner",
    )
  ) do %>
    <img src="<%= image_path('modules/dashboard/promos/copilot/promo-copilot-business-bg.webp') %>" alt="" width="357" height="220" class="position-absolute bottom-0 right-0 width-full height-full events-none" style="z-index: -1; object-fit: cover;">

    <div class="position-absolute p-2" style="top: 2px; right: 6px; z-index: 1;">
      <%= render(Primer::Beta::CloseButton.new(
        type: :submit,
        color: :on_emphasis,
        style: "color: #ffffff !important",
        data: analytics_click_attributes(
          category: "dashboard_notices",
          action: "dismiss",
          tag: "icon",
          context: "cb_nudge_#{user_propensity.group}_propensity_v1",
          location: "dashboard_nudges_top_right",
          label: "dismiss_icon_cb_nudge_#{user_propensity.group}_propensity_v1_dashboard_nudges_top_right",
        ))) %>
    </div>

    <h3 class="h3" style="color: #ffffff !important; letter-spacing: -0.4px; line-height: 24px; margin-right: 37%; margin-bottom: auto;">
      Add Copilot Business to your plan and code up to
      <%= link_to "55% faster.", "https://github.blog/news-insights/research/survey-ai-wave-grows/", target: "_blank", class: "dash-promo-inline-link", style: "color: #54effd !important;", data: {
        **analytics_click_attributes(
          category: "dashboard_notices",
          action: "view_source",
          tag: "link",
          context: "cb_nudge_#{user_propensity.group}_propensity_v1",
          location: "dashboard_nudges_top_right",
          label: "view_source_link_cb_nudge_#{user_propensity.group}_propensity_v1_dashboard_nudges_top_right",
        )
      } %>
    </h3>

    <%= render Primer::Beta::Button.new(
      size: :medium,
      tag: :a,
      href: copilot_plan_purchase_path(priority: "business", organization: user_propensity.organization_login, ref: "dashboard_nudge"),
      block: true,
      classes: "dash-promo-dark-btn",
      data: {
        test_selector: "copilot-business-propensity-nudge-cta",
        **analytics_click_attributes(
          category: "dashboard_notices",
          action: "copilot_business_checkout",
          tag: "button",
          context: "cb_nudge_#{user_propensity.group}_propensity_v1",
          location: "dashboard_nudges_top_right",
          label: "copilot_business_checkout_button_cb_nudge_#{user_propensity.group}_propensity_v1_dashboard_nudges_top_right",
        ),
      }
    ) do %>
      Get started with Copilot Business
    <% end %>

    <style>
      .dash-promo-dark-btn {
        margin-top: 24px;
        min-height: 36px;
        border-radius: 8px;
        font-weight: 600;
        color: #000000 !important;
        background: #ffffff !important;
        letter-spacing: -0.02em;
        border: 1px solid #6e7781 !important;
      }

      .dash-promo-dark-btn:hover {
        background: #f5f5f5 !important;
      }

      .dash-promo-inline-link {
        text-decoration: underline !important;
        text-decoration-color: currentColor;
        text-decoration-thickness: 2px !important;
        text-underline-position: under;
      }

      .dash-promo-inline-link:hover {
        text-decoration-thickness: 3px !important;
      }
    </style>
  <% end %>
</div>
