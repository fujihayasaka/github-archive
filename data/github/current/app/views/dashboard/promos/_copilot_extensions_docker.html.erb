<%
    experiment_id = "dashboard_copilot_extensions_docker_simple_vs_value"

    variant = hawaii_experiment_variant(
      experiment_id: experiment_id,
      user_id: current_user.id,
      variant_count: 2
    )

    experiment_html_element       = "a"
    experiment_category           = "experiment_#{experiment_id}_variant_#{variant}"
    experiment_location           = "dashboard_right_sidebar"
%>
  <div class="js-notice" <%= test_selector('dashboard_copilot_extensions_docker') %>>
    <%# Begin A|B Test %>
    <% case variant %>
    <% when 0 %>
      <%= form_tag(
        dismiss_notice_path(:dashboard_copilot_extensions_docker),
        class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
        style: "background: linear-gradient(90deg, #060628 0%, #080535 100%); z-index: 1; padding-top: 18px !important; padding-bottom: 18px !important; #{ user_feature_enabled?(:feeds_v2) ? '' : 'max-width: 340px;' }",
        data: analytics_visible_attributes(category: experiment_category)
      ) do %>
        <img src="<%= image_path('modules/dashboard/promos/copilot/copilot_extensions_docker_bg_b.jpg') %>" alt="" width="355" height="215" class="position-absolute bottom-0 right-0 width-full height-full events-none" style="z-index: -1; object-fit: cover;">

        <div class="position-absolute p-2" style="top: 4px; right: 6px; z-index: 1;">
          <%= render(Primer::Beta::CloseButton.new(
            type: :submit,
            color: :on_emphasis,
            style: "color: #ffffff !important",
            data: analytics_click_attributes(
              category: experiment_category,
              tag: experiment_html_element,
              action: "dismiss",
              location: experiment_location,
            ))) %>
        </div>

        <div class="position-relative z-1" style="text-align: center;">
          <div>
            <img src="<%= image_path("modules/dashboard/promos/copilot/copilot_extensions_docker_logo.svg") %>" alt="Docker logo" width="48" height="48" style="max-width: 85%; height: auto;">
          </div>

          <h3 class="h2 col-11" style="color: #ffffff !important; letter-spacing: -0.02em; display: inline-block; max-width: 270px;">
            Docker just got easier with GitHub Copilot
          </h3>

          <%= render Primer::Beta::Button.new(
            size: :medium,
            tag: :a,
            href: "/marketplace/docker-for-github-copilot?utm_source=github&utm_medium=banner&utm_campaign=dashboard_copilot_extensions_docker_nudge",
            block: true,
            classes: "dash-promo-dark-btn",
            data: analytics_click_attributes(
              category: experiment_category,
              tag: experiment_html_element,
              action: "get_started",
              location: experiment_location,
              )
          ) do %>
            Get Started
          <% end %>
        </div>

        <style>
          .dash-promo-dark-btn {
            margin-top: 24px;
            min-height: 36px;
            border-radius: 8px;
            font-weight: 600;
            color: #000000 !important;
            background: #ffffff !important;
            letter-spacing: -0.02em;
            border: 1px solid #6e7781 !important;
          }

          .dash-promo-dark-btn:hover {
            background: #f5f5f5 !important;
          }

          .dash-banner-visual {
            right: -9% !important;
          }

          @media (min-width: 1400px) {
            .dash-banner-visual {
              right: -4% !important;
            }
          }

          @media (max-width: 1400px) {
            .dash-banner-visual {
              display: none;
            }
          }
        </style>
      <% end %>
    <% when 1 %>
      <%= form_tag(
        dismiss_notice_path(:dashboard_copilot_extensions_docker),
        class: "Box position-relative rounded-2 mb-4 p-4 js-notice-dismiss overflow-hidden",
        style: "background: linear-gradient(90deg, #060628 0%, #080535 100%); z-index: 1; padding-top: 18px !important; padding-bottom: 18px !important; #{ user_feature_enabled?(:feeds_v2) ? '' : 'max-width: 340px;' }",
        data: analytics_visible_attributes(category: experiment_category)
      ) do %>
        <img src="<%= image_path('modules/dashboard/promos/copilot/copilot_extensions_docker_bg_a.jpg') %>" alt="" width="355" height="215" class="position-absolute bottom-0 right-0 width-full height-full events-none" style="z-index: -1; object-fit: cover;">
        <div class="position-absolute p-2" style="top: 4px; right: 6px; z-index: 1;">
          <%= render(Primer::Beta::CloseButton.new(
            type: :submit,
            color: :on_emphasis,
            style: "color: #ffffff !important",
            data: analytics_click_attributes(
              category: experiment_category,
              tag: experiment_html_element,
              action: "dismiss",
              location: experiment_location,
            ))) %>
        </div>

        <div class="position-relative z-1">
          <img src="<%= image_path("modules/dashboard/promos/copilot/copilot_extensions_docker_copilot_logo.svg") %>" alt="Docker logo" width="23" height="21" style="height: auto;">
          <img src="<%= image_path("modules/dashboard/promos/copilot/copilot_extensions_docker_x.svg") %>" alt="Docker logo" width="15" height="15" style="height: auto; margin-left: 2px; margin-bottom: 2px;">
          <img src="<%= image_path("modules/dashboard/promos/copilot/copilot_extensions_docker_logo.svg") %>" alt="Docker logo" width="35" height="35" style="max-width: 85%; height: auto; margin-bottom: -5px;">

          <h3 class="h3 col-11" style="color: #ffffff !important; letter-spacing: -0.02em; display: inline-block; max-width: 270px; margin-top: 15px; margin-bottom: 10px;">
            Docker for GitHub Copilot
          </h3>

          <span style="display: block; color: #ffffff !important; background: url(<%= image_path("modules/dashboard/promos/copilot/copilot_extensions_docker_check.svg") %>) no-repeat left center; padding-left: 25px;">Learn about containerization</span>
          <span style="display: block; color: #ffffff !important; background: url(<%= image_path("modules/dashboard/promos/copilot/copilot_extensions_docker_check.svg") %>) no-repeat left center; padding-left: 25px;">Generate Docker assets</span>
          <span style="display: block; color: #ffffff !important; background: url(<%= image_path("modules/dashboard/promos/copilot/copilot_extensions_docker_check.svg") %>) no-repeat left center; padding-left: 25px;">Analyze project vulnerabilities</span>

          <%= render Primer::Beta::Button.new(
            size: :medium,
            tag: :a,
            href: "/marketplace/docker-for-github-copilot?utm_source=github&utm_medium=banner&utm_campaign=dashboard_copilot_extensions_docker_nudge",
            block: true,
            classes: "dash-promo-dark-btn",
            data: analytics_click_attributes(
              category: experiment_category,
              tag: experiment_html_element,
              action: "get_started",
              location: experiment_location,
            )
          ) do %>
            Install extension for free
          <% end %>
        </div>

        <style>
          .dash-promo-dark-btn {
            margin-top: 24px;
            min-height: 36px;
            border-radius: 8px;
            font-weight: 600;
            color: #000000 !important;
            background: #ffffff !important;
            letter-spacing: -0.02em;
            border: 1px solid #6e7781 !important;
          }

          .dash-promo-dark-btn:hover {
            background: #f5f5f5 !important;
          }

          .dash-banner-visual {
            right: -9% !important;
          }

          @media (min-width: 1400px) {
            .dash-banner-visual {
              right: -4% !important;
            }
          }

          @media (max-width: 1400px) {
            .dash-banner-visual {
              display: none;
            }
          }
        </style>
      <% end %>
    <% end %>
    <%# End A|B Test %>
  </div>
