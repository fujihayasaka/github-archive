<%
    nudge_html_element       = "a"
    nudge_category           = "dashboard_onboarding_copilot_free_oss_nudge"
    nudge_location           = "dashboard_right_sidebar"
    nudge_id                 = :dashboard_onboarding_copilot_free_oss_nudge
    nudge_group              = :discover # options in github/in-product-messaging/blob/main/journey-centric-messaging.md

%>

<div class="js-notice marketing-banner" <%= test_selector(nudge_category) %>>
  <%  current_user.track_nudge_impression(id: nudge_id, group: nudge_group) %>
  <%= form_tag(
    dismiss_notice_path(nudge_id, { nudge: true, group: nudge_group }),
    class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
    style: "background: linear-gradient(90deg, #060628 0%, #080535 100%); z-index: 1; padding-top: 18px !important; padding-bottom: 18px !important; width: 356px;",
    data: analytics_visible_attributes(category: nudge_category, group: nudge_group)
  ) do %>
    <img src="<%= image_path('modules/dashboard/promos/general/gradient-bg-copilot-1746018342.retina.jpg') %>" alt="" width="355" height="215" class="position-absolute bottom-0 right-0 width-full height-full events-none" style="z-index: -1; object-fit: cover;">

    <div class="position-absolute p-2" style="top: 4px; right: 6px; z-index: 1;">
      <%= render(Primer::Beta::CloseButton.new(
        type: :submit,
        color: :on_emphasis,
        style: "color: #ffffff !important",
        data: analytics_click_attributes(
          category: nudge_category,
          tag: nudge_html_element,
          action: "dismiss",
          location: nudge_location,
          group: nudge_group,
        ))) %>
    </div>

    <div class="position-relative z-1">
      <img src="<%= image_path("modules/dashboard/promos/general/logo-line-copilot-1746018342.svg") %>" alt="GitHub Copilot" width="182" height="22" style="max-width: 85%; height: auto;" class="d-block">

      <h3 class="h5 col-11" style="color: #ffffff !important; letter-spacing: -0.02em; margin-top: 20px;">
        Copilot Pro for Maintainers
      </h3>

      <p class="mb-0 text-small mt-1" style="color: #eaeef2 !important; max-width: 200px;">
        Thanks for all you do for open source! You're eligible for a free Copilot Pro subscription.
      </p>

      <%= render Primer::Beta::Button.new(
        size: :medium,
        tag: :a,
        href: "/github-copilot/free_signup?utm_campaign=copilot-maintainers-devrel&utm_medium=in_product_message&utm_source=github",
        block: true,
        classes: "dash-promo-dark-btn",
        data: analytics_click_attributes(
          category: nudge_category,
          context: nudge_category,
          tag: nudge_html_element,
          action: "open_copilot",
          location: nudge_location,
          group: nudge_group,
        )
      ) do %>
        Activate Copilot Pro for Free
      <% end %>
    </div>

    <style>
      .dash-promo-dark-btn {
        margin-top: 24px;
        min-height: 36px;
        border-radius: 8px;
        font-weight: 600;
        color: #000000 !important;
        background: #ffffff !important;
        letter-spacing: -0.02em;
        border: 1px solid #6e7781 !important;
      }

      .dash-promo-dark-btn:hover {
        background: #f5f5f5 !important;
      }

      .dash-banner-visual {
        right: -9% !important;
      }

      @media (min-width: 1400px) {
        .dash-banner-visual {
          right: -4% !important;
        }
      }

      @media (max-width: 1450px) {
        .marketing-banner {
          display: none !important;
        }
      }
    </style>
  <% end %>
</div>
