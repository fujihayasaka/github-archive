<div class="js-notice" <%= test_selector('dashboard-announcements') %>>
  <%= form_tag(
    dismiss_notice_path(:dashboard_promo_copilot_extensions),
    class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
    style: "background: #000000; z-index: 1; padding-top: 18px !important; padding-bottom: 18px !important; #{ user_feature_enabled?(:feeds_v2) ? '' : 'max-width: 340px;' }",
    data: analytics_visible_attributes(category: "In-product banner", text: "copilot_extensions")
  ) do %>
    <img src="<%= image_path('modules/dashboard/promos/copilot/copilot-extensions-bg-smalls.jpg') %>" alt="" width="355" height="195" class="position-absolute bottom-0 left-0 width-full height-full events-none" style="z-index: -1; object-position: right bottom; object-fit: cover;">

  <div class="position-absolute p-2" style="top: 4px; right: 6px;">
    <%= render(Primer::Beta::CloseButton.new(
      type: :submit,
      color: :on_emphasis,
      style: "color: #ffffff !important",
      data: analytics_click_attributes(
        category: "dashboard_notices",
        action: "Dismiss copilot_extensions",
      ))) %>
  </div>

    <img src="<%= image_path("modules/dashboard/promos/copilot/copilot-logo-white.svg") %>" alt="GitHub Copilot" width="182" height="22" style="max-width: 85%; height: auto;" class="d-block">

    <h3 class="h5 col-11 mt-3" style="color: #ffffff !important; letter-spacing: -0.02em;">
      Extensions are here!
    </h3>

    <p class="mb-0 pr-2 text-small mt-1" style="color: #e8e9f6 !important;">
      Extend GitHub Copilot with ready-to-use extensions or build your own using our developer platform with APIs, documentation, and guides.
    </p>

  <%= render Primer::Beta::Button.new(
    size: :medium,
    tag: :a,
    href: "https://github.com/features/copilot/extensions",
    block: true,
    classes: "dash-promo-dark-btn",
    data: analytics_click_attributes(
      category: "dashboard_notices",
      action: "copilot_extensions",
    )
  ) do %>
    Learn more
  <% end %>

    <style>
      .dash-promo-dark-btn {
        margin-top: 26px;
        min-height: 36px;
        border-radius: 8px;
        font-weight: 600;
        color: #000000 !important;
        background: #ffffff !important;
        letter-spacing: -0.02em;
        border: 1px solid #6e7781 !important;
      }

      .dash-promo-dark-btn:hover {
        background: #f5f5f5 !important;
      }
    </style>
  <% end %>
</div>
