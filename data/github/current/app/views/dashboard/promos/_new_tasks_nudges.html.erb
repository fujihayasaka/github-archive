<%= render(InProductTargeting::Components::DashboardNudges::CopilotCliForDevsNudgeComponent.new(
  user: current_user,
)) %>

<% current_user.businesses.each do |business| %>
  <%= render(InProductTargeting::Components::DashboardNudges::DfdDashboardNudgesComponent.new(
    business: business,
    user: current_user,
  )) %>
  <%= render(InProductTargeting::Components::DashboardNudges::CopilotCliEnabledDashboardNudgeComponent.new(
    business: business,
    user: current_user,
  )) %>
<% end %>
<% current_user.organizations.each do |organization| %>
  <%= render(InProductTargeting::Components::DashboardNudges::OrganizationNudgeComponent.new(
    organization: organization,
    user: current_user,
  )) %>
  <%= render(InProductTargeting::Components::DashboardNudges::OrganizationCopilotCliEnabledDashboardNudgeComponent.new(
    organization: organization,
    user: current_user,
  )) %>
<% end %>
