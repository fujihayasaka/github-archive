<%
    nudge_html_element       = "a"
    nudge_category           = "dashboard_copilot_agent_mode_launch_nudge_step_3"
    nudge_location           = "dashboard_right_sidebar"
    nudge_id                 = :dashboard_copilot_agent_mode_launch_nudge_step_3
    nudge_group              = :discover
    variant_count            = 3

    experiment_id = "dashboard_copilot_agent_mode_launch_nudge_step_3"

    # Get initial variant from experiment (0, 1, or 2)
    initial_variant = hawaii_experiment_variant(
      experiment_id: experiment_id,
      user_id: current_user.id,
      variant_count: variant_count,
    )

    # Override variant based on feature flags
    variant = initial_variant
    variant = 0 if user_feature_enabled?(:dashboard_copilot_agent_mode_launch_nudge_step_3_variant_0_preference)
    variant = 1 if user_feature_enabled?(:dashboard_copilot_agent_mode_launch_nudge_step_3_variant_1_preference)
    variant = 2 if user_feature_enabled?(:dashboard_copilot_agent_mode_launch_nudge_step_3_variant_2_preference)
%>

<div class="js-notice marketing-banner" <%= test_selector(nudge_category) %>>
  <% case variant %>
  <% when 0 %>
    <%  current_user.track_nudge_impression(id: nudge_id, group: nudge_group) %>
    <%= form_tag(
      dismiss_notice_path(nudge_id, { nudge: true, group: nudge_group }),
      class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
      style: "background: linear-gradient(90deg, #060628 0%, #080535 100%); z-index: 1; padding-top: 17px !important; padding-bottom: 17px !important; width: 356px;",
      data: analytics_visible_attributes(category: "#{nudge_category}_#{variant}", group: nudge_group)
    ) do %>
      <span <%= test_selector("#{nudge_category}_#{variant}") %>></span>
      <img src="<%= image_path('modules/dashboard/promos/general/gradient-bg-copilot-1744981421.retina.jpg') %>" alt="" width="355" height="215" class="position-absolute events-none" style="z-index: -1; object-fit: cover; bottom: -1px; right: 0px; width: 100%; height: 102% !important;">

      <div class="position-absolute p-2" style="top: 8px; right: 6px; z-index: 1;">
        <%= render(Primer::Beta::CloseButton.new(
          type: :submit,
          color: :on_emphasis,
          style: "color: #ffffff !important",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "dismiss",
            location: nudge_location,
            group: nudge_group,
          ))) %>
      </div>

      <div class="position-relative z-1">

        <h3 class="col-11" style="color: #ffffff !important; letter-spacing: -0.02em; margin-bottom:10px; max-width: 200px; line-height: 120%;">
          Learn Copilot agent mode in 12 minutes
        </h3>

        <div style="width: 180px;">
          <span style="margin-bottom: 5px; font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 19px;">Enable agent mode</span>
          <span style="margin-bottom: 5px; font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 19px;">Automate codebase search</span>
          <span style="font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 19px;">Run terminal commands and UI tests</span>
        </div>

        <%= render Primer::Beta::Button.new(
          size: :medium,
          tag: :a,
          href: "/in-product-messaging/dismiss-and-redirect?group=#{nudge_group}&notice=#{nudge_id}&destination_key=#{nudge_category}",
          block: true,
          classes: "dash-promo-dark-btn",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "watch_on_youtube",
            location: nudge_location,
            group: nudge_group,
          )
        ) do %>
          <span style="font-size: 12px; display: block; background: url(<%= image_path("modules/dashboard/promos/general/youtube-icon-1745512656.svg") %>) no-repeat left center; padding-left: 35px;">Watch on YouTube</span>
        <% end %>
      </div>
    <% end %>
  <% when 1 %>
    <%  current_user.track_nudge_impression(id: nudge_id, group: nudge_group) %>
    <%= form_tag(
      dismiss_notice_path(nudge_id, { nudge: true, group: nudge_group }),
      class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
      style: "background: linear-gradient(90deg, #060628 0%, #080535 100%); z-index: 1; padding-top: 17px !important; padding-bottom: 17px !important; width: 356px;",
      data: analytics_visible_attributes(category: "#{nudge_category}_#{variant}", group: nudge_group)
    ) do %>
      <span <%= test_selector("#{nudge_category}_#{variant}") %>></span>
      <img src="<%= image_path('modules/dashboard/promos/general/gradient-bg-copilot-1745512656.retina.jpg') %>" alt="" width="355" height="215" class="position-absolute events-none" style="z-index: -1; object-fit: cover; bottom: -1px; right: 0px; width: 100%; height: 102% !important;">

      <div class="position-absolute p-2" style="top: 8px; right: 6px; z-index: 1;">
        <%= render(Primer::Beta::CloseButton.new(
          type: :submit,
          color: :on_emphasis,
          style: "color: #ffffff !important",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "dismiss",
            location: nudge_location,
            group: nudge_group,
          ))) %>
      </div>

      <div class="position-relative z-1">

        <h3 class="col-11" style="color: #ffffff !important; letter-spacing: -0.02em; margin-bottom:10px; max-width: 200px; line-height: 120%;">
          Learn Copilot agent mode in 12 minutes
        </h3>

        <div style="width: 180px;">
          <span style="margin-bottom: 5px; font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 19px;">Enable agent mode</span>
          <span style="margin-bottom: 5px; font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 19px;">Automate codebase search</span>
          <span style="font-size: 12px; display: block; color: #C4CBD5 !important; background: url(<%= image_path("modules/dashboard/promos/general/green-check-1744981421.svg") %>) no-repeat left top 2px; padding-left: 19px;">Run terminal commands and UI tests</span>
        </div>

        <%= render Primer::Beta::Button.new(
          size: :medium,
          tag: :a,
          href: "/in-product-messaging/dismiss-and-redirect?group=#{nudge_group}&notice=#{nudge_id}&destination_key=#{nudge_category}",
          block: true,
          classes: "dash-promo-dark-btn",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "watch_on_youtube",
            location: nudge_location,
            group: nudge_group,
          )
        ) do %>
          <span style="font-size: 12px; display: block; background: url(<%= image_path("modules/dashboard/promos/general/youtube-icon-1745512656.svg") %>) no-repeat left center; padding-left: 35px;">Watch on YouTube</span>
        <% end %>
      </div>
    <% end %>
  <% when 2 %>
    <%  current_user.track_nudge_impression(id: nudge_id, group: nudge_group) %>
    <%= form_tag(
      dismiss_notice_path(nudge_id, { nudge: true, group: nudge_group }),
      class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
      style: "background: linear-gradient(90deg, #060628 0%, #080535 100%); z-index: 1; padding-top: 17px !important; padding-bottom: 17px !important; width: 356px;",
      data: analytics_visible_attributes(category: "#{nudge_category}_#{variant}", group: nudge_group)
    ) do %>
      <span <%= test_selector("#{nudge_category}_#{variant}") %>></span>
      <img src="<%= image_path('modules/dashboard/promos/copilot-agent-mode-launch/gradient-bg-copilot-1745512656.retina.jpg') %>" alt="" width="355" height="215" class="position-absolute events-none" style="z-index: -1; object-fit: cover; bottom: -1px; right: 0px; width: 100%; height: 102% !important;">

      <div class="position-absolute p-2" style="top: 4px; right: 6px; z-index: 1;">
        <%= render(Primer::Beta::CloseButton.new(
          type: :submit,
          color: :on_emphasis,
          style: "color: #ffffff !important",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "dismiss",
            location: nudge_location,
            group: nudge_group,
          ))) %>
      </div>

      <div class="position-relative z-1">

        <img src="<%= image_path('modules/dashboard/promos/general/12-minute-demo-button-1745512656.jpg.svg') %>" alt="12 minute demo" style="margin-bottom: 5px;">
        <h2 class="col-11" style="color: #ffffff !important; letter-spacing: -0.02em; max-width: 130px; line-height: 120%;">
          Copilot agent mode in VS Code
        </h2>

        <%= render Primer::Beta::Button.new(
          size: :medium,
          tag: :a,
          href: "/in-product-messaging/dismiss-and-redirect?group=#{nudge_group}&notice=#{nudge_id}&destination_key=#{nudge_category}",
          block: true,
          classes: "dash-promo-dark-btn",
          data: analytics_click_attributes(
            category: "#{nudge_category}_#{variant}",
            tag: nudge_html_element,
            action: "watch_on_youtube",
            location: nudge_location,
            group: nudge_group,
          )
        ) do %>
          <span style="font-size: 12px; display: block; background: url(<%= image_path("modules/dashboard/promos/general/youtube-icon-1745512656.svg") %>) no-repeat left center; padding-left: 35px;">Watch on YouTube</span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<style>
  .dash-promo-dark-btn {
    margin-top: 24px;
    min-height: 36px;
    border-radius: 8px;
    font-weight: 600;
    color: #000000 !important;
    background: #ffffff !important;
    letter-spacing: -0.02em;
    border: 1px solid #6e7781 !important;
  }

  .dash-promo-dark-btn:hover {
    background: #f5f5f5 !important;
  }

   @media (max-width: 1450px) {
    .marketing-banner {
      display: none !important;
    }
  }
</style>
