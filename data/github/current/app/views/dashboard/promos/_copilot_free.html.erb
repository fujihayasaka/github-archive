<div class="js-notice" <%= test_selector('dashboard_onboarding_copilot_free') %>>
  <%= form_tag(
    dismiss_notice_path(:dashboard_onboarding_copilot_free),
    class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
    style: "background: linear-gradient(90deg, #060628 0%, #080535 100%); z-index: 1; padding-top: 18px !important; padding-bottom: 18px !important; #{ user_feature_enabled?(:feeds_v2) ? '' : 'max-width: 340px;' }",
    data: analytics_visible_attributes(category: "dashboard_onboarding_copilot_free")
  ) do %>
    <img src="<%= image_path('modules/dashboard/promos/copilot/copilot-free-bg.webp') %>" alt="" width="355" height="215" class="position-absolute bottom-0 right-0 width-full height-full events-none" style="z-index: -1; object-fit: cover;">

    <img src="<%= image_path('modules/dashboard/promos/copilot/copilot-free-visuals.webp') %>" alt="" width="355" height="187" class="position-absolute top-0 events-none dash-banner-visual" style="height: auto;">

    <div class="position-absolute p-2" style="top: 4px; right: 6px; z-index: 1;">
      <%= render(Primer::Beta::CloseButton.new(
        type: :submit,
        color: :on_emphasis,
        style: "color: #ffffff !important",
        data: analytics_click_attributes(
          category: "dashboard_onboarding_copilot_free",
          tag: "a",
          action: "dismiss",
          location: "dashboard_right_sidebar",
        ))) %>
    </div>

    <div class="position-relative z-1">
      <img src="<%= image_path("modules/dashboard/promos/copilot/copilot-logo-gradient-white.svg") %>" alt="GitHub Copilot" width="182" height="22" style="max-width: 85%; height: auto;" class="d-block">

      <h3 class="h5 col-11" style="color: #ffffff !important; letter-spacing: -0.02em; margin-top: 20px;">
        Available for free
      </h3>

      <p class="mb-0 text-small mt-1" style="color: #eaeef2 !important; max-width: 200px;">
        Up to 50 chats and 2,000 code completions per month, access to Claude 3.5 Sonnet, and more.
      </p>

      <%= render Primer::Beta::Button.new(
        size: :medium,
        tag: :a,
        href: "https://github.com/copilot?utm_source=github&utm_medium=banner&utm_campaign=copilotfree-bannerdashboard-onboarding",
        block: true,
        classes: "dash-promo-dark-btn",
        data: analytics_click_attributes(
          category: "dashboard_onboarding_copilot_free",
          context: "dashboard_onboarding_copilot_free",
          tag: "a",
          action: "open_copilot",
          location: "dashboard_right_sidebar",
        )
      ) do %>
        Open Copilot
      <% end %>
    </div>

    <style>
      .dash-promo-dark-btn {
        margin-top: 24px;
        min-height: 36px;
        border-radius: 8px;
        font-weight: 600;
        color: #000000 !important;
        background: #ffffff !important;
        letter-spacing: -0.02em;
        border: 1px solid #6e7781 !important;
      }

      .dash-promo-dark-btn:hover {
        background: #f5f5f5 !important;
      }

      .dash-banner-visual {
        right: -9% !important;
      }

      @media (min-width: 1400px) {
        .dash-banner-visual {
          right: -4% !important;
        }
      }
    </style>
  <% end %>
</div>
