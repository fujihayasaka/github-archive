<%
nudge_id = :universe26_dashboard_banner_seblaunch
nudge_category = "db_seblaunch_uni26"
nudge_location = "dashboard"
nudge_group = :connect
nudge_url = "https://githubuniverse.com/?utm_source=github&utm_medium=banner&utm_campaign=db_seblaunch_uni26"
%>
<div class="js-notice marketing-banner" <%= test_selector(nudge_category) %>>
  <%  InProductTargeting::NudgeMemory.new(current_user).save_a_copy_of_impression_analytics_to_dotcom(id: nudge_id, group: nudge_group) %>

  <div class="universe26banner">
    <div class="universe26banner-hero-section">
      <div class="universe26banner-header">
        <img src="/static/images/modules/dashboard/promos/universe26-logo-light.svg" alt="GitHub Universe 2026" class="universe26banner-header-logo universe26banner-asset universe26banner-asset--light">
        <img src="/static/images/modules/dashboard/promos/universe26-logo-dark.svg" alt="GitHub Universe 2026" class="universe26banner-header-logo universe26banner-asset universe26banner-asset--dark">

        <%= form_tag(
          dismiss_notice_path(nudge_id, { nudge: true, group: nudge_group }),
          class: "universe26banner-dismiss-form",
          data: analytics_visible_attributes(category: nudge_category, group: nudge_group)
        ) do %>
          <%= render(Primer::Beta::IconButton.new(
            type: :submit,
            icon: :x,
            scheme: :invisible,
            aria: { label: "Dismiss" },
            color: :on_emphasis,
            data: analytics_click_attributes(
              category: nudge_category,
              tag: "a",
              action: "dismiss",
              location: nudge_location,
              group: nudge_group,
            ))) %>
        <% end %>
      </div>

      <img src="/static/images/modules/dashboard/promos/universe26.webp" alt="GitHub Universe Banner" class="universe26banner-hero-image">
    </div>

    <div class="universe26banner-event-info">
      <div class="universe26banner-date-location">
        Oct 28-29<span class="universe26banner-location-separator">■</span>San Francisco, CA
      </div>
    </div>

    <div class="universe26banner-promotion">
      <h3 class="universe26banner-promo-description">Save $600 with Super Early Bird passes through July 8.</h3>
    </div>

    <div class="universe26banner-actions">
      <%= link_to(
        nudge_url,
        class: "universe26banner-cta",
        data: analytics_click_attributes(action: "click", category: nudge_category, group: nudge_group)
      ) do %>
        Register now
      <% end %>
    </div>
  </div>
</div>
