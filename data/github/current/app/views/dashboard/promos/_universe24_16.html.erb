<div class="js-notice" <%= test_selector('dashboard-announcements') %>>
  <%= form_tag(
    dismiss_notice_path(:dashboard_promo_universe24_16),
    class: "Box position-relative rounded-2 mb-4 p-3 js-notice-dismiss overflow-hidden",
    style: "background: linear-gradient(92.79deg, #000000 -246.32%, #000231 -20.84%, #150E46 103.47%); z-index: 1; padding-top: 18px !important; padding-bottom: 18px !important; #{ user_feature_enabled?(:feeds_v2) ? '' : 'max-width: 340px;' }",
    data: analytics_visible_attributes(category: "In-product banner", text: "universe24_banner16li")
  ) do %>
    <img src="<%= image_path('modules/dashboard/promos/universe24/universe24-banner-graphic-16.jpg') %>" alt="" width="355" height="205" class="position-absolute bottom-0 right-0 width-full height-full events-none" style="z-index: -1; object-fit: cover;">

    <div class="position-absolute p-2" style="top: 4px; right: 6px;">
      <%= render(Primer::Beta::CloseButton.new(
        type: :submit,
        color: :on_emphasis,
        style: "color: #ffffff !important",
        data: analytics_click_attributes(
          category: "dashboard_notices",
          action: "Dismiss universe24_banner16li",
        ))) %>
    </div>

    <img src="<%= image_path("modules/dashboard/promos/universe24/logo-dark.svg") %>" alt="Universe24" width="195" height="21" style="max-width: 85%; height: auto" class="d-block">

    <p class="mb-0 pr-2 color-fg-muted f5" style="color: #ffffff !important; margin-top: 22px; letter-spacing: -0.01em;">
      <strong>Get 30+ hours of free content</strong> <span style="color: #e6e7ec;">when you watch all the virtual sessions you may have missed at GitHub Universe.</span>
    </p>

    <%= render Primer::Beta::Button.new(
      size: :medium,
      tag: :a,
      href: "https://githubuniverse.com/?utm_source=github&utm_medium=banner&utm_campaign=24banner16li",
      block: true,
      classes: "universe24-dark-btn",
      data: analytics_click_attributes(
        category: "dashboard_notices",
        action: "universe24_banner16li",
      )
    ) do %>
      Watch now
    <% end %>

    <style>
      .universe24-dark-btn {
        margin-top: 26px;
        min-height: 36px;
        border-radius: 8px;
        font-weight: 600;
        color: #000000 !important;
        background: #ffffff !important;
        letter-spacing: -0.02em;
        border: 1px solid #6e7781 !important;
      }

      .universe24-dark-btn:hover {
        background: #f5f5f5 !important;
      }
    </style>
  <% end %>
</div>
