<div class="copilotPreview__container">
  <copilot-dashboard-entrypoint>
    <div class="copilotPreview">
      <label class="sr-only" for="copilot-dashboard-entrypoint-textarea">Ask a question</label>
      <textarea
        id="copilot-dashboard-entrypoint-textarea"
        data-target="copilot-dashboard-entrypoint.textarea"
        class="copilotPreview__input"
        placeholder="Ask a question"
        rows="1"
        autofocus
      ></textarea>
      <div class="copilotPreview__trailingItems">
        <a href="https://github.com/copilot" class="copilotPreview__copilotButton" data-target="copilot-dashboard-entrypoint.copilot_button">
          <%= render Primer::Beta::Octicon.new(:copilot) %>
          Copilot
        </a>
        <%= render(
          Primer::Beta::IconButton.new(
            icon: "paper-airplane",
            "aria-label": "Send",
            scheme: :invisible,
            size: :small,
            data: { target: "copilot-dashboard-entrypoint.send_button" }
          )
        ) %>
      </div>
    </div>

    <% suggestions = [
      {
        id: 0,
        raw: 'Open issues in facebook/react',
        title: 'Open issues in <span class="fgColor-muted">facebook/react</span>',
        icon: :'issue-opened',
        color: 'var(--fgColor-success)'
      },
      {
        id: 1,
        raw: 'Pull requests in microsoft/vscode',
        title: 'Pull requests in <span class="fgColor-muted">microsoft/vscode</span>',
        icon: :'git-pull-request',
        color: 'var(--fgColor-success)'
      },
      {
        id: 2,
        raw: 'Recent commits in torvalds/linux',
        title: 'Recent commits in <span class="fgColor-muted">torvalds/linux</span>',
        icon: :'git-commit',
        color: 'var(--display-blue-fgColor)'
      },
      {
        id: 3,
        raw: 'Pull requests in rails/rails',
        title: 'Pull requests in <span class="fgColor-muted">rails/rails</span>',
        icon: :'git-pull-request',
        color: 'var(--fgColor-success)'
      },
      {
        id: 4,
        raw: 'Find the five latest issues assigned to me',
        title: 'Find issues assigned to me',
        icon: :'issue-opened',
        color: 'var(--fgColor-success)'
      },
      {
        id: 5,
        raw: 'What is a hash table?',
        title: 'What is a hash table?',
        icon: :'question',
        color: 'var(--display-blue-fgColor)'
      },
      {
        id: 6,
        raw: 'Tooltip libraries in JavaScript',
        title: 'Tooltip libraries in <span class="fgColor-muted">JavaScript</span>',
        icon: :'code',
        color: 'var(--display-gray-fgColor)'
      },
      {
        id: 7,
        raw: 'Latest nodejs/node release',
        title: 'Latest <span class="fgColor-muted">nodejs/node</span> release',
        icon: :'tag',
        color: 'var(--display-purple-fgColor)'
      }
    ] %>

    <% random_suggestions = suggestions.sample(3) %>

    <div class="copilotPreview__footer" data-target="copilot-dashboard-entrypoint.footer">
      <ul
        class="copilotPreview__suggestions"
        data-target="copilot-dashboard-entrypoint.suggestions"
      >
        <% random_suggestions.each do |suggestion| %>
          <li>
            <button
              type="button"
              class="copilotPreview__suggestionButton"
              data-raw="<%= suggestion[:raw] %>"
              data-action="click:copilot-dashboard-entrypoint#handleSuggestionClick"
            >
              <div style="color: <%= suggestion[:color] %>;">
                <%= render(Primer::Beta::Octicon.new(suggestion[:icon], size: :small)) %>
              </div>
              <%# rubocop:disable Rails/OutputSafety %>
              <div><%= raw(suggestion[:title]) %></div>
            </button>
          </li>
        <% end %>
      </ul>

      <div
        class="copilotPreview__disclaimer"
        data-target="copilot-dashboard-entrypoint.disclaimer"
      >
        <%= render(
          Primer::Beta::Link.new(
            href: "https://docs.github.com/en/copilot/responsible-use-of-github-copilot-features/responsible-use-of-github-copilot-chat-in-githubcom",
            scheme: :secondary,
            classes: "Link--inTextBlock"
          )
        ) { "Copilot" } %>
        uses AI. Check for mistakes.
      </div>
    </div>
  </copilot-dashboard-entrypoint>
</div>
