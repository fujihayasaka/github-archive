<%= notices_for(current_user) %>

<% unless FeatureFlag.vexi.enabled?(:disable_dashboard_conditional_access_banner, current_user, default: false) %>
  <% if FeatureFlag.vexi.enabled?(:dashboard_cap_banner_deferred, current_user, default: false) %>
    <%= render Primer::Alpha::IncludeFragment.new(
      loading: "lazy",
      src: dashboard_cap_banner_path,
      test_selector: "dashboard-cap-banner-async",
      classes: "tmp-mb-3",
    ) do %>
      <span data-hide-on-error></span>
      <span data-show-on-error hidden></span>
    <% end %>
  <% else %>
    <%= render partial: "dashboard/cap_banner" %>
  <% end %>
<% end %>

<% if show_nudges_section %>
  <%= render partial: "dashboard/promos/new_tasks_nudges" %>
<% end %>
