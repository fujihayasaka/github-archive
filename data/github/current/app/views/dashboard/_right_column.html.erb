<%# rubocop:disable GitHub/ContentFor %>

<% content_for :right_column do %>
  <% if !GitHub.enterprise? && ExploreFeed::Spotlight.all.current.dashboard.any? %>
    <%= render(Explore::Spotlight::DashboardItemComponent.new(
      spotlight: ExploreFeed::Spotlight.all.current.dashboard.first,
    )) %>
  <% end %>

  <% if !current_user.feature_enabled?(:site_user_optout) %>
    <% unless current_user.in_onboarding_period? %>
      <%# Example of extra rendering condition for a dashboard banner
        {
          feature: :site_copilot_ga_dashboard,
          notice: :dashboard_promo_copilot_ga,
          partial: "dashboard/dashboard_promo_copilot",
          extra_condition: -> { !copilot_user?.has_signed_up? }
        },
      %>
      <%# only display one marketing banner at once; ordered based on priority %>
      <% promos = [
        {
          feature: :site_universe24_16,
          notice: :dashboard_promo_universe24_16,
          partial: "dashboard/promos/universe24_16"
        },
        {
          feature: :site_copilot_extensions_banner,
          notice: :dashboard_promo_copilot_extensions,
          partial: "dashboard/promos/copilot_extensions"
        },
      ] %>
      <div <%= test_selector('marketing-banners') %>>
        <% promos.each do |promo| %>
          <% if current_user.feature_enabled?(promo[:feature]) && UserNotice.find(promo[:notice]).effective? && !current_user.dismissed_notice?(promo[:notice]) && (promo[:extra_condition].nil? || promo[:extra_condition].call) %>
            <%= render promo[:partial] %>
            <% break %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if current_user.feature_enabled?(:subdomain_cookies_message_dashboard) && !current_user.dismissed_notice?("subdomain_cookies_message") %>
      <%= render "dashboard/subdomain_cookies_notice" %>
    <% end %>
  <% end %>

  <% if show_existing_user_github_education_banner? %>
    <%= render "dashboard/github_education_banner_existing_user" %>
  <% end %>

  <% unless GitHub.enterprise? || current_user.in_onboarding_period? %>
    <include-fragment loading="lazy" src="<%= dashboard_changelog_path %>" <%= test_selector("dashboard-changelog-fragment")%>>
      <div class="d-flex flex-items-center">
        <%= render(Primer::Beta::Spinner.new(my: 6, flex: 1)) %> <%# rubocop:disable GitHub/RailsViewRenderLiteral %>
      </div>
    </include-fragment>
  <% end %>

  <% featured_recommendations_repos = explore_repos.map(&:repository) %>

  <% unless current_user.in_onboarding_period? && current_user.feature_enabled?(:nux_explore_repos) %>
    <%= render(Dashboard::Sidebar::ExploreRepositoriesComponent.new(repositories: featured_recommendations_repos)) %> <%# rubocop:disable GitHub/RailsViewRenderLiteral %>
  <% end %>
<% end %>
