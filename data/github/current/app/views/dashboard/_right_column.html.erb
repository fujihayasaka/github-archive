<% if !GitHub.enterprise? && ExploreFeed::Spotlight.all.current.dashboard.any? %>
  <%= render(Explore::Spotlight::DashboardItemComponent.new(
    spotlight: ExploreFeed::Spotlight.all.current.dashboard.first,
  )) %>
<% end %>

<%= render "dashboard/right_column_marketing_promos" %>

<% if show_existing_user_github_education_banner? %>
  <%= render "dashboard/github_education_banner_existing_user" %>
<% end %>

<% if current_user.feature_flag_enabled?(:enable_dashboard_changelog, default: false) %>
  <% unless GitHub.enterprise? || current_user.in_onboarding_period? %>
    <%= render Primer::Alpha::IncludeFragment.new(loading: "lazy", src: dashboard_changelog_path, test_selector: "dashboard-changelog-fragment") do %>
      <div class="tmp-mb-3 dashboard-changelog color-bg-default border color-border-muted tmp-p-3">
        <%= render(Primer::Beta::Spinner.new(flex: 1)) %> <%# rubocop:disable GitHub/RailsViewRenderLiteral %>
      </div>
    <% end %>
  <% end %>
<% end %>
