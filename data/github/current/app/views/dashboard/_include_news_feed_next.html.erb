<%# rubocop:disable GitHub/ContentFor %>

<div class="d-flex flex-items-center flex-justify-<%= current_user.feature_flag_enabled?(:productivity_dashboard, default: false) ? 'end' : 'between' %>">
  <% if current_user.feature_flag_enabled?(:productivity_dashboard, default: false) %>
    <h2 class="sr-only" data-target="feed-container.feedTitle" <%= test_selector('feed-title-sr-only') %>><%= feed_title %></h2>
  <% else %>
    <h2 class="f5 mb-1" data-target="feed-container.feedTitle" <%= test_selector('feed-title-nux') %>><%= feed_title %></h2>
  <% end %>

  <div class="d-flex flex-items-center">
    <%= render Primer::Beta::Details.new(overlay: :default, reset: true, data: { "menu-trigger": "feed-filter-menu", target: 'feed-container.filterTrigger' }, classes: "js-feed-filter-menu feed-filter-menu hx_rsm", position: :relative, id: "feed-filter-menu", ml: 3, mr: 0) do |c| %>
      <% c.with_summary(classes: "hx_rsm-trigger", style: "padding-left: 0.75rem; padding-right: 0.75rem") do |component| %>
        <% component.with_leading_visual_icon(icon: :filter) %>
        Filter
        <% component.with_trailing_visual_counter(count: 0, hidden: true, data: { target: 'feed-container.filterCounter' }) %>
      <% end %>

      <% c.with_body(tag: :"details-menu",
        classes: "SelectMenu-modal dropdown-menu-sw hx_rsm-modal feed-filter-menu-body", position: :absolute) do %><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
          <%= render Primer::Alpha::IncludeFragment.new("aria-label": "Filters are loading", "data-target": "feed-container.filterFragment") do %>
            <div class="text-center p-3 mt-2">
              <%= render(Primer::Beta::Spinner.new(size: :medium)) %>
            </div>
          <% end %>
      <% end %>
    <% end %>
    <% if content_for?(:right_column) %>
      <div class="hide-xl ml-2">
        <%= render Primer::Alpha::Dialog.new(
          title: "Explore",
          id: 'explore-dashboard-responsive',
          position: :right,
        ) do |d| %>
          <% d.with_show_button(icon: "sidebar-expand", "aria-label": "Explore") %>
          <% d.with_body(my: 2) do %>
            <%= content_for :right_column %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%= render partial: "dashboard/for_you_feed" %>
