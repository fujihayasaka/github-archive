<div class="top-0 overflow-y-auto d-flex flex-column js-left-column-scroll-container">
  <div class="px-3 pt-3">
    <% unless current_user.feature_preview_enabled?(:global_nav_experiment) || user_feature_enabled?(:dashboard_nav_experiment) %>
      <% if user_can_switch_contexts? %>
        <div class="px-1 py-3 mb-2">
          <%= render Dashboard::ContextSwitcherComponent.new(
          current_context: current_context,
          user_can_create_orgs: user_can_create_organizations?,
          id: "switch_dashboard_context_left_column",
        ) %>
        </div>
      <% end %>
    <% end %>
    <% if dashboard_universe_enabled? && !user_feature_enabled?(:disable_dashboard_left_column_nav_list) %>
      <div class="mb-3">
        <%
          selected_item = :home if ["/", "/dashboard"].include?(request.path)
          selected_item = :feed if request.path == "/feed"
        %>
        <%= render(Primer::Beta::NavList.new(aria: { label: "Site navigation" }, selected_item_id: selected_item)) do |list|
          list.with_item(label: "Home", href: home_path, selected_by_ids: [:home]) do |item|
            item.with_leading_visual_icon(icon: :home)
          end
          list.with_item(label: "Feed", href: feed_path, selected_by_ids: [:feed]) do |item|
            item.with_leading_visual_icon(icon: :globe)
          end
        end %>
      </div>
    <% elsif user_feature_enabled?(:dashboard_nav_experiment) %>
      <div class="mb-3">
        <%= render(Primer::Beta::NavList.new(aria: { label: "Site navigation" })) do |list|
          list.with_item(label: "Home", href: "/") do |item|
            item.with_leading_visual_icon(icon: :home)
          end
          list.with_item(label: "Issues", href: "/issues") do |item|
            item.with_leading_visual_icon(icon: "issue-opened")
          end
          list.with_item(label: "Pull requests", href: "/pulls") do |item|
            item.with_leading_visual_icon(icon: "git-pull-request")
          end
          list.with_item(label: "Projects", href: "/projects") do |item|
            item.with_leading_visual_icon(icon: :project)
          end
          list.with_item(label: "Codespaces", href: "/codespaces") do |item|
            item.with_leading_visual_icon(icon: :codespaces)
          end
          list.with_item(label: "Discussions", href: "/discussions") do |item|
            item.with_leading_visual_icon(icon: "comment-discussion")
          end
        end %>
      </div>
    <% end %>
  </div>
  <%= render partial: "dashboard/teams_and_repositories", locals: { user_repo_query: user_repo_query } %>
</div>
