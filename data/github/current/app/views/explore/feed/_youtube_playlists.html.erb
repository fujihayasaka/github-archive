<% videos = [
  {
    title: "Get the latest developer and open source news",
    series: "The Download",
    description: "Join Senior Director of Developer Advocacy Cassidy Williams for all the latest developer, open source, and GitHub news.",
    embed_id: "PL0lo9MOBetEE0goMLEl97vO7slruNVj43"
  },
  {
    title: "Discover the world of open source with Open Source Friday",
    series: "Open Source Fridays",
    description: "Discover how your favorite open source projects are created. Live coding and technical insights from the maintainers themselves.",
    embed_id: "PL0lo9MOBetEFmtstItnKlhJJVmMghxc0P"
  },
  {
    title: "Hack on open source with us",
    series: "Rubber Duck Thursdays",
    description: "Join us for Rubber Duck Thursdays! A lighthearted and informal stream where we work on some projects and do some live coding.",
    embed_id: "PL0lo9MOBetEEkxEQuYjIvrCbJTrsvRj36"
  }
] %>

<% video = videos.sample %>

<article class="border rounded color-shadow-small color-bg-default my-4">
  <div class="video-responsive">
    <iframe width="560" height="315" src="https://www.youtube.com/embed/videoseries?list=<%= video[:embed_id] %>" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
  </div>
  <div class="border-top color-bg-default p-3 rounded-bottom-2">
    <h2 class="f6 color-fg-muted mb-3">
      <%= render(Primer::Beta::Octicon.new(:"video")) %>
      <%= video[:series] %>
    </h2>
    <div class="d-flex">
      <h3 class="h3 color-fg-default wb-break-word mb-2">
      <a
        href="https://www.youtube.com/playlist?list=<%= video[:embed_id] %>"
        <%= safe_analytics_click_attributes(
          category: "Explore",
          action: "Go to video[:series]",
          label: "logged_in:#{current_user.present?}"
        ) %>>
      <%= video[:title] %></a>
      </h3>
    </div>
    <div class="markdown-body f5 mb-2 color-fg-muted">
      <p><%= video[:description] %></p>
    </div>
  </div>
</article>
