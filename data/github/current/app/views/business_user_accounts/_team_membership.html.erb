<div class="d-flex flex-items-center flex-justify-between" <%= test_selector "team-#{team.id}" %>>

  <div class="d-flex flex-items-center gap-3">
    <div>
      <% if team.business_team? %>
        <%= link_to(enterprise_team_path(slug: business.slug, team_slug: team.slug)) do %>
          <%= avatar_for(team, 32, class: "avatar") %>
        <% end %>
      <% else %>
        <%= link_to(team_path(team)) do %>
          <%= avatar_for(team, 32, class: "avatar") %>
        <% end %>
      <% end %>
    </div>

    <div class="d-flex flex-items-center">
      <% if team.business_team? %>
        <%= link_to(
          enterprise_team_path(slug: business.slug, team_slug: team.slug),
          class: "f5 d-block width-fit Link--primary no-underline text-bold"
        ) do %>
          <%= team.name %>
        <% end %>
        <%= render Primer::Beta::Label.new(
          ml: 2,
          display: :inline_block,
          align_self: :center,
          scheme: :secondary,
          title: "Team managed by the enterprise",
          test_selector: "team-enterprise-badge"
        ).with_content("Enterprise team") %>
      <% else %>
        <%= link_to(team_path(team), class: "f5 d-block width-fit Link--primary no-underline text-bold") do %>
          <%= team.name %>
        <% end %>
      <% end %>
    </div>

    <% if team.scim_managed_enterprise? && team.externally_managed? %>
      <% external_group = team.external_group_team.external_group %>
      <div class="m-2">
        <%= render Primer::Beta::Label.new(scheme: :secondary, title: "IdP External Group Team: #{external_group.display_name}", test_selector: "idp-group") do %>
          <%= link_to "IdP Group", external_group_members_enterprise_path(slug: business.slug, id: external_group.id) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if team.organization %>
    <div class="d-flex flex-justify-center">
      <div class="color-fg-muted f6 text-right mr-1">
        <%= primer_octicon(:organization) %> Organization: <%= link_to team.organization.display_login, user_path(team.organization), class: "Link--inTextBlock" %>
      </div>
    </div>
  <% end %>

  <% if team.business_team? && business.erp_feature_enabled?(:enterprise_teams_org_assignment) %>
    <div class="d-flex flex-justify-center" <%= test_selector "team-org-count-#{team.id}" %>>
      <div class="color-fg-muted f6 text-right mr-1">
        Access to
        <%= render(Primer::Beta::Link.new(
          href: enterprise_team_organization_assignments_path(business, team),
          classes: "Link--inTextBlock",
        )) { pluralize(team.organizations.count, "organization") } %>
      </div>
    </div>
  <% end %>
</div>
