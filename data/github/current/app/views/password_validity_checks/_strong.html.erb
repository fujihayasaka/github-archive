<% hide_strength_sentence = local_assigns.fetch(:hide_strength_sentence, false) %>
<% hide_password_validity_pills = local_assigns.fetch(:hide_password_validity_pills, false) %>

<% unless hide_password_validity_pills %>
  <div class="mb-1" <%= test_selector("password-validity-pills") %>>
    <span class="password-validity-pill password-validity-pill-success mr-2 rounded-2"></span>
    <span class="password-validity-pill password-validity-pill-success mr-2 rounded-2"></span>
    <span class="password-validity-pill password-validity-pill-success rounded-2"></span>
  </div>
<% end %>

<p class="password-validity-summary password-validity-summary-success my-2  js-nux-sr-only">
  Password is strong
</p>

<% unless hide_strength_sentence %>
  <p <%= test_selector("password-strength-sentence")%>>
    <%= password_strength_sentence(include_documentation_link: false) %>
  </p>
<% end %>
