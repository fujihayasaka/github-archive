<% hide_strength_sentence = local_assigns.fetch(:hide_strength_sentence, false) %>
<% hide_password_validity_pills = local_assigns.fetch(:hide_password_validity_pills, false) %>

<% unless hide_password_validity_pills %>
  <div class="mb-1" <%= test_selector("password-validity-pills") %>>
    <span class="password-validity-pill password-validity-pill-close mr-2 rounded-2"></span>
    <span class="password-validity-pill password-validity-pill-close mr-2 rounded-2"></span>
    <span class="password-validity-pill rounded-2"></span>
  </div>
<% end %>

<p class="password-validity-summary password-validity-summary-close my-2">
  <%= safe_join([
    render(Primer::Beta::Octicon.new(icon: :"alert-fill", size: :xsmall)),
    "Password needs a number and lowercase letter"
  ], " ") %>
</p>

<% unless hide_strength_sentence %>
  <p><%= password_strength_sentence(include_documentation_link: false) %></p>
<% end %>
