<% hide_strength_sentence = local_assigns.fetch(:hide_strength_sentence, false) %>
<% hide_password_validity_pills = local_assigns.fetch(:hide_password_validity_pills, false) %>

<% unless hide_password_validity_pills %>
  <div class="mb-1" <%= test_selector("password-validity-pills") %>>
    <span class="password-validity-pill password-validity-pill-fail mr-2 rounded-2"></span>
    <span class="password-validity-pill mr-2 rounded-2"></span>
    <span class="password-validity-pill rounded-2"></span>
  </div>
<% end %>

<p class="password-validity-summary password-validity-summary-fail my-2">
  Password is too long
</p>

<% unless hide_strength_sentence %>
  <p>Make sure it's no more than <%= PasswordStrengthHelper::MAXIMUM_VALID_CHARACTERS %> characters.</p>
<% end %>
