<div class="avatar-parent-child TimelineItem-avatar d-none d-md-block">
  <%= cached_linked_avatar comment.author %>

  <%
    # Check if author is a Bot and via_app points to the same bot to avoid duplicate avatars
    author_is_bot = comment.author.is_a?(Bot)
    bot_same_as_via_app = author_is_bot && comment.respond_to?(:via_app?) && comment.via_app? &&
                          comment.author.permalink(include_host: true) == comment.via_app.html_url
  %>

  <% if comment.respond_to?(:via_app?) && comment.via_app? && !bot_same_as_via_app %>
    <a href="<%= comment.via_app.html_url %>">
      <img src="<%= comment.via_app.logo_url.to_s %>" alt="<%= comment.via_app.name %>" width="20" height="20" class="avatar avatar-child rounded-2">
    </a>
  <% elsif author_is_bot && comment.author.is_dependabot? %>
    <%= cached_dependabot_avatar %>
  <% end %>
</div>
