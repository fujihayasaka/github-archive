<% page_info title: "Invalid Redirect URI" %>

<div class="container-md tmp-px-3 tmp-mt-3">
  <%= render Primer::Beta::Blankslate.new(narrow: true, spacious: true, border: true) do |blankslate| %>
    <% blankslate.with_visual_icon(icon: "alert-fill", size: :medium, color: :attention) %>
    <% blankslate.with_heading(tag: :h2).with_content("Be careful!") %>
    <% blankslate.with_description do %>
      <% if local_assigns[:rejection_reason] == :fragment_present %>
        <p>The <code>redirect_uri</code> contains a hash fragment (<code>#</code>), which is not allowed.</p>
        <p>According to <a href="https://datatracker.ietf.org/doc/html/rfc6749#section-3.1.2" class="Link--inTextBlock" target="_blank" rel="noopener noreferrer">RFC 6749 Section 3.1.2.3</a>, OAuth redirect URIs must not include fragment components for security reasons.</p>
        <p>The application should update its registered callback URL to remove any hash fragments.</p>
      <% else %>
        <p>The <code>redirect_uri</code> is not associated with this application.</p>
        <p>The application might be misconfigured or could be trying to redirect you to a website you weren't expecting.</p>
      <% end %>
    <% end %>
  <% end %>
</div>
