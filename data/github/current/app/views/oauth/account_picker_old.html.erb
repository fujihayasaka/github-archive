<% page_info :title => "Verify Session" %>
<% multi_account_enabled = account_switcher_helper.enabled? %>

<div class="auth-form tmp-px-3" <%= test_selector "switch_account_view" %> data-hpc>
  <% if from_vscode_social %>
    <%= render Primer::Alpha::Banner.new(mb: 2) do %>
      If you continue with <strong><%= params[:provider].capitalize %></strong>, you will be signed out of all of your accounts.
    <% end %>
  <% end %>
  <div class="auth-form-header p-0">
    <h1>Select user to authorize <strong><%= application.name %></strong></h1>
  </div>
  <%= render "shared/flash" %>

  <%= render partial: "sessions/account_switcher_box", locals: {
    view_name: "switch_account",
    signing_out: false,
    continue_to: oauth_account_picker_path(account_picker_params),
    continue_method: :post,
    return_to: return_to_target,
  }%>

  <% if from_vscode_social %>
    <div class="tmp-mt-3 text-center f4">or</div>
    <%= form_tag kill_session_path, method: "post" do %>
      <%= hidden_field_tag :after_logout, social_initiate_path(provider: params[:provider], return_to: return_to_target) %>
      <%= submit_tag "Continue with #{params[:provider].capitalize}", class: "btn btn-large btn-primary width-full" %>
    <% end %>
  <% else %>
    <% if multi_account_enabled %>
      <%= link_to "Use a different account", login_path(return_to: return_to_target, add_account: "1", allow_signup: account_picker_params[:allow_signup], client_id: params["client_id"]), class: "btn btn-large width-full text-center tmp-mt-3", role: "button" %>
    <% else %>
      <%= button_to "Use a different account", kill_session_path(after_logout: return_to_target), method: :post, class: "btn btn-large width-full text-center tmp-mt-3" %>
    <% end %>
  <% end %>
</div>
