<% if suggestions.any? %>
  <p class="color-fg-muted">Suggestions</p>
  <% suggestions.each do |suggestion| %>
    <%= render partial: "pull_requests/suggested_reviewer_row", locals: { suggestion: suggestion, pull_request: pull_request, current_user: current_user } %>
  <% end %>

  <%= render "issues/sidebar/reviewers_hint", pull_request: pull_request %>
<% elsif !local_assigns[:suppress_empty_state] %>
  <%= render "issues/sidebar/reviewers_none", pull_request: pull_request %>
<% end %>
