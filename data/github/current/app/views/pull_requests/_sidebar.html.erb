<%# rubocop:disable Lint/InstanceVariable %>
<% pull_node = defined?(pull_node) ? pull_node : nil %>
<% deferred_content = defined?(deferred_content) ? deferred_content : false %>
<% add_debugging_for_repo = defined?(add_debugging_for_repo) ? add_debugging_for_repo : nil %>

<%= render "issues/sidebar", deferred_content: deferred_content, issue: pull.issue, issue_node: pull_node, discussion_categories: [], add_debugging_for_repo: add_debugging_for_repo %>
