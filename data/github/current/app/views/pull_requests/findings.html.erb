<%# rubocop:disable Lint/InstanceVariable %>
<%
  pull_request_page_info(@pull)
  page_info breadcrumb_object: @pull

  pull_title = @pull.title.blank? ? "Untitled" : @pull.title
%>

<%= render layout: "issues/issues" do %>
  <div class="tmp-mb-0">
    <%= render partial: "comments/title", locals: {
      pull: @pull,
      comment: @pull.issue,
      issue: @pull.issue,
      title: pull_title,
    } %>
  </div>

  <%= render partial: "pull_requests/lazy_tabs", locals: { pull: @pull } %>

  <%= render_react_partial name: "copilot-code-review-findings", props: findings_props, disable_ssr: true %>
<% end %>
