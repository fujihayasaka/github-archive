<%= render PullRequests::Copilot::CodingAgentBannerComponent.new(pull_request: pull_request, current_user: current_user, current_repository: current_repository) %>

<%= render "pull_requests/timeline", pull_node: pull_node %>

<%# render target for ui/packages/copilot-code-review-upsell %>
<div id="copilot-code-review-limits-banner"></div>

<% if pull_request.closed? %>
  <%# we don't want to do this for pull requests that have a closed event. %>
  <%# anything older than 2011-03-16 doesn't have events though. %>
  <% if !pull_request.closed_by %>
    <div class="TimelineItem">
      <div class="TimelineItem-badge color-fg-on-emphasis color-bg-danger-emphasis">
        <%= primer_octicon(:"circle-slash") %>
      </div>
      <div class="TimelineItem-body">
        This pull request was <strong>closed</strong>.
      </div>
    </div>
    <div class="TimelineItem-break"></div>
  <% end %>
<% end %>

<div class="discussion-timeline-actions">
  <%= render partial: "pull_requests/deployments_box_wrapper", locals: { pull: pull_request, gate_requests: gate_requests, no_padding: true } %>
</div>

<%= render "shared/hidden_unicode_alert" %>
