<div class="Box-row d-flex flex-justify-between">
  <div>
    <a href="<%= devtools_experiment_path(experiment.name) %>">
      <%= experiment.name %>
    </a>
    <% if experiment.running_too_long? %>
      <%= render Primer::Beta::Label.new(scheme: :danger, ml: 1, title: "Label: Running Too Long") do %>
        Running Too Long
      <% end %>
    <% end %>
  </div>
  <div>
    <% mismatches = experiment.mismatches_present? %>
    <% if mismatches.nil? %>
      <%= render Primer::Beta::Label.new(scheme: :secondary, ml: 1, title: "Label: Mismatches Unknown") do %>
        Mismatches unknown
      <% end %>
    <% elsif mismatches %>
      <%= render Primer::Beta::Label.new(scheme: :warning, ml: 1, title: "Label: Mismatches Present") do %>
        Mismatches present
      <% end %>
    <% else %>
      <%= render Primer::Beta::Label.new(scheme: :success, ml: 1, title: "Label: No Mismatches") do %>
        No mismatches
      <% end %>
    <% end %>
    <span class="text-small">Runs for <%= experiment.percent %>% of calls</span>
  </div>
</div>
