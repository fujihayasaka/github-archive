<% name = "#{experiment.name}##{mismatch.id}" %>

<% page_info title: "Experiment Mismatch", selected_link: :mismatch %>

<% content_for :pagehead_path do %>
  / <a href="<%= devtools_experiments_path %>">Experiments</a>
  / <a href="<%= devtools_experiment_path(experiment) %>"><%= experiment.name %></a>
  / <a href="<%= devtools_experiment_mismatches_path(experiment) %>">Mismatches</a>
  / <a href="<%= devtools_experiment_mismatch_path(experiment, mismatch.science_event) %>"><%= name %></a>
<% end %>

<div id="experiment-mismatch">
  <div class="Box">
    <div class="Box-header d-flex flex-items-center">
      <h3 class="Box-title overflow-hidden flex-auto">
        <%= "Mismatch #{name}" %>
      </h3>
    </div>
    <div class="Box-row">
      <%= render partial: "devtools/mismatches/mismatch", locals: { mismatch: mismatch } %>
    </div>
  </div>
</div>
