<% if feature_flag.actors.length > 0 %>
  <ul <%= test_selector("actors-list") %>>
    <% actors.each do |actor| %>
      <% if !Object.const_defined?(actor.vexi_actor_type) %>
        <li>Unsupported actor type: <%= actor.value %></li>
      <% elsif actor %>
        <% case actor.vexi_actor_type %>
        <% when User.name %>
          <%= render partial: "devtools/feature_flags/actors/user", locals: { user: actor, feature_flag: feature_flag } %>
        <% when Organization.name %>
          <%= render partial: "devtools/feature_flags/actors/organization", locals: { organization: actor, feature_flag: feature_flag } %>
        <% when Team.name %>
          <%= render partial: "devtools/feature_flags/actors/team", locals: { team: actor, feature_flag: feature_flag } %>
        <% when Repository.name %>
          <%= render partial: "devtools/feature_flags/actors/repository", locals: { repository: actor, feature_flag: feature_flag } %>
        <% when MemexProject.name %>
          <%= render partial: "devtools/feature_flags/actors/memex_project", locals: { memex_project: actor, feature_flag: feature_flag } %>
        <% when Business.name %>
          <%= render partial: "devtools/feature_flags/actors/enterprise", locals: { enterprise: actor, feature_flag: feature_flag } %>
        <% when Integration.name %>
          <%= render partial: "devtools/feature_flags/actors/integration", locals: { integration: actor, feature_flag: feature_flag } %>
        <% when OauthApplication.name %>
          <%= render partial: "devtools/feature_flags/actors/oauth_application", locals: { oauth_application: actor, feature_flag: feature_flag } %>
        <% when Vulnerability.name %>
          <%= render partial: "devtools/feature_flags/actors/vulnerability", locals: { vulnerability: actor, feature_flag: feature_flag } %>
        <% when GitHub::FlipperHost.name %>
          <%= render partial: "devtools/feature_flags/actors/host", locals: { host: actor, feature_flag: feature_flag } %>
        <% when GitHub::FlipperRole.name %>
          <%= render partial: "devtools/feature_flags/actors/role", locals: { role: actor, feature_flag: feature_flag } %>
        <% else %>
          <%= render partial: "devtools/feature_flags/actors/other", locals: { actor: actor, feature_flag: feature_flag } %>
        <% end %>
      <% end %>
    <% end %>
  </ul>

  <div class="paginate-container">
    <%= will_paginate(actors, class: "d-flex d-md-inline-block pagination") %>
  </div>
<% else %>
  <div class="Box-row">
    <div class="my-2">
      <em>No actors have been granted access to <strong><%= feature_flag.name %></strong>.</em>
    </div>
  </div>

<% end %>
