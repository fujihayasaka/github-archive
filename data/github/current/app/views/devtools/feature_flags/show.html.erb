<%# erblint:counter ButtonComponentMigrationCounter 2 %>
<% page_info(title: feature_flag.name, selected_link: :features) %>

<style>
.ButtonGroupWithDialogs {
  border-right-width: 1px;
  border-top-right-radius: 6px;
  border-bottom-right-radius: 6px;
}
</style>

<% content_for :pagehead_path do %>
  / <a href="<%= devtools_feature_flags_path %>">Feature Flags</a>
  / <strong><%= feature_flag.name %></strong>
<% end %>

<% if GitHub.devtools_feature_flags_ui_enabled? %>
  <div class="Box tmp-mb-5" data-hpc>
    <div class="Box-header d-flex flex-items-center">
      <h3 class="Box-title flex-auto"><%= feature_flag.name %></h3>
    </div>

    <%= render Devtools::FeatureEnabledFlashComponent.new(feature: feature_flag) %>
  </div>

  <div class="Box Box--condensed tmp-mb-5">
    <div class="Box-header d-flex flex-items-center">
      <h3 class="Box-title flex-auto">Edit actors</h3>

      <%= render(Primer::Beta::ButtonGroup.new(size: :small)) do |component| %>
        <% component.with_button(tag: :a, href: devtools_feature_flag_add_actor_path(feature_flag.name)) { "Add actor" } %>
        <% component.with_button(tag: :a, href: devtools_feature_flag_remove_actor_path(feature_flag.name)) { "Remove actor" } %>
        <% component.with_button(tag: :a, href: devtools_feature_flag_check_actor_path(feature_flag.name)) { "Check actor" } %>
      <% end %>
    </div>

    <%= render Devtools::GateOverrideMessageComponent.new(feature: feature_flag) %>

    <div class="Box-body">
      <p class="mt-2">Feature flags can also be enabled for a user from the command line in development.</p>
      <code>
        <p>$ bin/toggle-feature-flag enable <%= feature_flag.name %> <%= current_user.name %></p>
        <p>$ bin/toggle-feature-flag disable <%= feature_flag.name %>  <%= current_user.name %></p>
      </code>

      <hr>

      <div class="d-flex flex-justify-between flex-items-center my-2">
        <div>
          <p>Enable this feature for individual users, organizations, enterprises, repositories, etc.</p>
          <p>
            <strong><%= pluralize feature_flag.actors.length, "actor" %></strong>
            <%= "has".pluralize(feature_flag.actors.length) %> access to <strong><%= feature_flag.name %></strong>
          </p>
        </div>

        <% if feature_flag.actor_types.size > 1 %>
          <%= form_tag devtools_feature_flag_path(feature_flag.name), method: :get do %>
            <%= hidden_field_tag 'show_big_feature_actors', true, {:id => 'show_big_feature_actors'} %>
            <%= select_tag :actor_type, options_for_select(feature_flag.actor_types, selected_actor_filter),
              class: "form-select select-sm",
              prompt: "Filter by actor type...",
              "aria-label": "Filter by actor type",
              "data-autosubmit": true
            %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if show_big_feature_actors %>
      <%= render partial: "devtools/feature_flags/actors", locals: { actors: actors, feature_flag: feature_flag } %>
    <% else %>
      <div class="Box-row">
        <div class="my-2">
          This feature has a lot of actors and for performance reasons the list isn't being shown automatically.
          <%= form_tag devtools_feature_flag_path(feature_flag.name), method: :get do %>
            <%= hidden_field_tag 'show_big_feature_actors', true, {:id => 'show_big_feature_actors'} %>
            <%= render(Primer::Beta::Button.new(type: :submit, mt: 2)) do %>
              Retrieve Actors
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="Box tmp-mb-5">
    <div class="Box-header">
      <h3 class="Box-title">Edit custom gates</h3>
    </div>
    <%= render Devtools::GateOverrideMessageComponent.new(feature: feature_flag, context: :custom_gates) %>
    <div>
      <% if feature_flag.available_groups.any? %>
        <div class="Box-row d-flex flex-items-center flex-justify-between">
          <div>
            <h4><%= label_tag(:custom_gate, "Enable a custom gate") %></h4>
            <p>Note: The <u>preview_features</u> custom gate is equivalent to staff-shipping</p>
            <p>For descriptions about each custom gate please see the
              <a class="Link--inTextBlock" href="https://thehub.github.com/epd/engineering/products-and-services/dotcom/features/feature-flags/custom-gates/">
                Custom Gates Documentation
              </a>
              on TheHub.
            </p>
          </div>

          <%= form_tag devtools_feature_flag_custom_gate_path(feature_flag.name), method: :post, class: "tmp-ml-3" do |f| %>
            <%= select_tag(:custom_gate, options_for_select(feature_flag.available_groups.sort), class: "select-sm") %>
            <%= submit_tag "Add gate", class: "btn btn-sm" %>
          <% end %>
        </div>
      <% end %>

      <div class="Box-row">
        <h4>Enabled Custom Gates</h4>
        <p>
          Enable this feature for a predefined group of actors. Use the
          <code>preview_features</code> group to staff-ship your feature.
        </p>
        <p>
          Custom gates can be defined with arbitrary Ruby code. See
          <a class="Link--inTextBlock" href="https://github.com/github/github/blob/master/lib/feature_flags_common/custom_gates.rb">
            all our defined custom gates
          </a>.
        </p>

        <% if feature_flag.custom_gates_values.any? %>
          <p class="tmp-mt-4">
            <strong><%= pluralize feature_flag.custom_gates_values.length, "custom gate" %></strong> enabled for <strong><%= feature_flag.name %></strong>
          </p>

          <ul class="tmp-ml-3">
            <% feature_flag.custom_gates_values.each do |custom_gate| %>
              <li>
                <%= custom_gate %>
                <span class="stafftools-email-actions">
                  <%= form_tag devtools_feature_flag_delete_custom_gate_path(feature_flag.name, custom_gate), method: :delete, class: "inline-form", "data-confirm" => "Are you sure you want to grant all users access to #{feature_flag.name}?" do %>
                    <%= render Primer::Beta::Button.new(type: :submit, "data-confirm": "Remove custom gate #{ custom_gate }", value: custom_gate, scheme: :link, color: :danger, "aria-label": "Remove custom gate #{custom_gate}") do %>
                      <%= render(Primer::Beta::Octicon.new(icon: 'trash')) %>
                    <% end %>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p>No custom gates enabled for <strong><%= feature_flag.name %></strong>.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="Box tmp-mb-5">
    <div class="Box-header">
      <h3 class="Box-title">Edit percentage of calls (Dark-shipping)</h3>
    </div>
    <%= render Devtools::GateOverrideMessageComponent.new(feature: feature_flag, context: :dark_ship) %>
    <div class="Box-row">
      <p>
        Enable this feature for a percentage of <code>enabled?</code> calls. This is primarily useful for dark-shipping.
      </p>
      <p><small>
        Note: Do not use this for anything user-visible as it can cause features to turn on or off each time the user reloads the page.
      </small></p>
      <p>
        <a class="Link--inTextBlock" href="https://thehub.github.com/epd/engineering/products-and-services/internal/feature-flags/resources/targeting-rules/#percentage-of-calls-dark-shipping">
          Read more here.
        </a>
      </p>
      <p>
        <% if feature_flag.custom_call_percentage? %>
          <span class="color-fg-danger">Manually set to <%= feature_flag.percentage_of_calls_value %>%</span>
        <% end %>
      </p>
      <%= form_tag devtools_feature_flag_percentage_of_calls_path(feature_flag.name), :method => :put do |f| %>
        <p class="clearfix">
          <span class="BtnGroup">
            <% FeatureManagement::Models::DevtoolsFeature::PERCENTAGES.each do |n| %>
              <button type="submit"
                      data-confirm="Are you sure you want to enable this flag for <%= n %>% of enabled? calls?"
                      name="percentage_of_calls" value="<%= n %>"
                      class="btn
                      <% if feature_flag.percentage_of_calls_value == n %>selected<% end %>
                      BtnGroup-item">
                <%= n %>%
              </button>
            <% end %>
          </span>
        </p>
      <% end %>
    </div>
    <div class="Box-row">
      <%= form_tag devtools_feature_flag_percentage_of_calls_path(feature_flag.name), :method => :put do |f| %>
      <div class="form-group">
        <div class="form-group-header">
          <label for="percentage_of_calls">Set Percentage Manually</label>
        </div>
        <div class="form-group-body">
          <p class="note">For more fine grained control over the percentage feel free to define your own percentage. Decimals can used to a hundredth of a percent. For example: <code>25.01</code></p>
          <div class="input-group col-2">
            <span class="input-group-button"><span class="btn">%</span></span>
            <%= number_field_tag :percentage_of_calls, feature_flag.percentage_of_calls_value, class: "form-control", in: 0..100, step: 0.01 %>
          </div>
        </div>
      </div>
      <div class="form-group">
        <p class="form-actions">
          <%= submit_tag "Submit Percentage", :class => "btn btn-primary" %>
        </p>
      </div>
      <% end %>
    </div>
  </div>

  <div class="Box tmp-mb-5">
    <div class="Box-header">
      <h3 class="Box-title">Edit percentage of actors</h3>
    </div>
    <%= render Devtools::GateOverrideMessageComponent.new(feature: feature_flag, context: :actors) %>
    <div class="Box-row">
      <p>
        Enable this feature for a percentage of actors. Use this setting to
        gradually enable your feature for more and more users, orgs, or
        repositories.
      </p>
      <p>If you are not passing an actor (user, repository, etc) to the <em>enabled?</em> call this rollout will not work and you will need to use dark shipping instead.</p>
      <p><small>
        Note: This is <em>in addition to</em> the individual actors and groups of
        actors listed above. This percentage does not affect whether those
        individuals or groups have access.
      </small></p>
      <p>
        <a class="Link--inTextBlock" href="https://thehub.github.com/epd/engineering/products-and-services/internal/feature-flags/resources/targeting-rules/#percentage-of-actors">
          Read more here.
        </a>
      </p>
      <p>
        <% if feature_flag.custom_actor_percentage? %>
          <span class="color-fg-danger">Manually set to <%= feature_flag.percentage_of_actors_value %>%</span>
        <% end %>
      </p>
      <%= form_tag devtools_feature_flag_percentage_of_actors_path(feature_flag.name), method: :put do |f| %>
        <p class="clearfix">
          <span class="BtnGroup">
            <% FeatureManagement::Models::DevtoolsFeature::PERCENTAGES.each do |n| %>
              <button type="submit"
                      name="percentage_of_actors"
                      data-confirm="Are you sure you want to enable this flag for <%= n %>% of actors?"
                      value="<%= n %>"
                      class="btn <% if feature_flag.percentage_of_actors_value == n %>selected<% end %>
                      BtnGroup-item">
                <%= n %>%
              </button>
            <% end %>
          </span>
        </p>
      <% end %>
    </div>
    <div class="Box-row">
      <%= form_tag devtools_feature_flag_percentage_of_actors_path(feature_flag.name), method: :put do |f| %>
      <div class="form-group">
        <div class="form-group-header">
          <label for="percentage_of_actors">Set Percentage Manually</label>
        </div>
        <div class="form-group-body">
          <p class="note">For more fine grained control over the percentage feel free to define your own percentage. Decimals can used to a hundredth of a percent. For example: <code>25.01</code></p>
          <div class="input-group col-2">
            <span class="input-group-button"><span class="btn">%</span></span>
            <%= number_field_tag :percentage_of_actors, feature_flag.percentage_of_actors_value, class: "form-control", in: 0..100, step: 0.01 %>
          </div>
        </div>
      </div>
      <div class="form-group">
        <p class="form-actions">
          <%= submit_tag "Submit Percentage", :class => "btn btn-primary" %>
        </p>
      </div>
      <% end %>
    </div>
  </div>

  <%= render(Primer::Beta::BorderBox.new(border_color: :danger, classes: "tmp-mb-5")) do |component| %>
    <% component.with_header(bg: :danger, border_color: :danger, font_weight: :bold) do %>
      Danger Zone
    <% end %>

    <% component.with_body(border_color: :danger) do %>
      <p>Feature flags can also be toggled from the command line in development.</p>
      <code>
        <p>$ bin/toggle-feature-flag enable <%= feature_flag.name %></p>
        <p>$ bin/toggle-feature-flag disable <%= feature_flag.name %></p>
      </code>

      <hr class="bleed-flush">

      <div class="d-flex">
        <div class="flex-1">
          <h4>Master keys</h4>
          <p>Enable or disable for <strong>everyone</strong> with one click.</p>
        </div>
        <%= form_tag devtools_feature_flag_enable_path(feature_flag.name), method: :post, class: "inline-form tmp-pr-3" do %>
          <button type="submit"
                  data-confirm="Are you sure you want to grant all users access to <%= feature_flag.name %>?"
                  class="btn<%= " btn-danger" unless feature_flag.fully_enabled? %>"
                  <%= " disabled" if feature_flag.fully_enabled? %>>
            Enable
          </button>
        <% end %>

        <%= form_tag devtools_feature_flag_disable_path(feature_flag.name), method: :post, class: "inline-form" do %>
          <button type="submit"
                  data-confirm="Are you sure you want to disable <%= feature_flag.name %>?"
                  class="btn<%= " btn-danger" if feature_flag.fully_enabled? %>"
                  <%= " disabled" if feature_flag.fully_disabled? %>>
            Disable
          </button>
        <% end %>
      </div>

      <hr class="bleed-flush">

      <div class="d-flex">
        <div class="flex-1">
          <h4>Delete feature</h4>
          <p>Deleting a feature disables it for everyone.</p>
        </div>

        <% if GitHub.multi_tenant_enterprise? %>
          <%= render partial: 'devtools/feature_flags/action_disabled_dialog', locals: {
            title: "Action Not Allowed",
            dialog_id: "delete-feature-flag-dialog",
            button_text: "Delete",
            button_scheme: :danger,
            button_size: :medium,
            dialog_message: "Deleting feature flags is not allowed on proxima stamps. Please delete the feature from the dotcom devtools UI."} %>
        <% else %>
          <%= form_tag devtools_feature_flag_path(feature_flag.name), method: :delete, class: "inline-form" do %>
            <%= render Primer::Beta::Button.new(type: :submit, "data-confirm": "Are you sure you want to delete #{ feature_flag.name }?", scheme: :danger) do %>Delete<% end %>
          <% end %>
        <% end %>

      </div>

    <% end %>
  <% end %>

  <%= render(Devtools::CodeUsageComponent.new(feature_flag.code_usage)) %>

  <% if celebrate %>
    <confetti-container></confetti-container>
  <% end %>
<% else %>
  <%= render(Primer::Alpha::Banner.new(scheme: :default, full: false, classes: "tmp-mb-3 tmp-mt-3")) do %>
    <div <%= test_selector "warning-description" %>>
      <p>The feature flag UI as part of devtools is only available in development.</p>
    </div>
  <% end %>
<% end %>
