<% page_info title: "New feature" %>

<% content_for :pagehead_path do %>
  / <a href="<%= devtools_feature_flags_path %>">Feature Flags</a>
  / <strong>New feature</strong>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do %>
    <h2 class="h5 text-normal">New feature</h2>
  <% end %>

  <% component.with_body do %>
    <%= form_with url: devtools_feature_flags_path, method: :post, local: true do |f| %>
      <div class="form-group">
        <div class="form-group-header">
          <label for="name">Name *</label>
        </div>
        <div class="form-group-body">
          <%= text_field_tag :name %>
        </div>
        <% if errors[:name] %>
          <p class="color-fg-danger"><%= errors[:name] %></p>
        <% end %>
      </div>

      <div class="form-checkbox">
        <label>
          <%= check_box_tag :enable, "true", false %>
          <%= "Fully enable?" %>
        </label>
      </div>

      <p class="form-actions text-right">
        <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit, mr: 2)) { "Create Feature" } %>
        <%= render(Primer::Beta::Button.new(tag: :a, href: devtools_feature_flags_path)) { "Cancel" } %>
      </p>
    <% end %>
  <% end %>
<% end %>
