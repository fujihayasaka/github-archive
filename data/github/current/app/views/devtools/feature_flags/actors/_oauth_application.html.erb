<%# erblint:counter ButtonComponentMigrationCounter 1 %>
<li class="Box-row">
  <%= primer_octicon(:repo) %>
  <a href="<%= stafftools_user_application_path(oauth_application.user, oauth_application) %>" class="Link--inTextBlock"><%= oauth_application.name %></a>

  <span class="stafftools-email-actions">
    <%= form_tag devtools_feature_flag_delete_actor_path(feature_flag), method: :delete, class: "inline-form" do %>
      <input type="hidden" name="vexi_id" value="<%=  oauth_application.vexi_id %>">
      <button type="submit" class="btn-link color-fg-danger" title="Remove access for <%= oauth_application.name %>"><%# herb:disable html-no-title-attribute %>
        <%= primer_octicon(:trash) %>
      </button>
    <% end %>
  </span>
</li>
