<%# erblint:counter ButtonComponentMigrationCounter 1 %>
<li class="Box-row">
  <%= render(Primer::Beta::Octicon.new(icon: "repo")) %>
  <a href="<%= gh_stafftools_app_path(integration.user, integration) %>" class="Link--inTextBlock"><%= integration.name %></a>

  <span class="stafftools-email-actions">
    <%= form_tag devtools_feature_flag_delete_actor_path(feature_flag), method: :delete, class: "inline-form" do %>
      <input type="hidden" name="vexi_id" value="<%= integration.vexi_id %>">
      <button type="submit" class="btn-link color-fg-danger" title="Remove access for <%= integration.name %>"><%# herb:disable html-no-title-attribute %>
        <%= primer_octicon(:trash) %>
      </button>
    <% end %>
  </span>
</li>
