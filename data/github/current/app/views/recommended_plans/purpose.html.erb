<%
  page_info(
    title: "What are the top 2 things you want to do with GitHub?",
    class: "header-overlay",
    full_height: true,
  )
%>

<div class="container-xl position-relative z-2 p-responsive mt-n5">
  <div class="d-lg-flex gutter-md-spacious">
    <div class="col-lg-6 col-xl-7">
      <%= svg("signup/icons/team-mentions", class: "d-block mb-3", width: "80") %>
      <h1 class="h2-mktg d-inline-block features-category--title text-gradient-mint-blue mb-3" data-hpc>
        Tell us a bit about yourself.
      </h1>
      <p class="f2-mktg text-normal text-gray-light-mktg mb-6">We'll get you started on the right track.</p>
    </div>
    <div class="col-lg-6 col-xl-5">
      <div class="rounded-3 color-shadow-extra-large color-bg-default px-3 px-sm-5 py-5">
        <span class="Progress Progress--small mb-3">
          <span class="Progress-item" style="width: 66%; background-color: #4969ed;"></span>
        </span>
        <%= primer_form_with(url: signup_recommended_plan_path, scope: :suggested_plan, method: :post) do |f| %>
          <%= render(RecommendedPlans::PurposeForm.new(f, show_validation_message: show_validation_message)) %>
        <% end %>
      </div>
    </div>
  </div>
</div>
