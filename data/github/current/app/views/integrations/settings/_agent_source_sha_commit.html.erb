<%# locals: (integration:, agent_source_fields:) %>
<% sha_has_errors = field_has_errors?(integration, :"agent_source.commit_oid") %>

<div class="mb-0 d-flex flex-row gap-4 flex-justify-between flex-items-center">
  <div class="d-flex flex-column gap-1">
    <div>
      <span id="agent-source-sha-commit-label" class="text-bold color-fg-default">SHA<span class="color-fg-danger" aria-hidden="true">*</span><span class="sr-only">, required</span></span>
      <p id="agent-source-sha-commit-description" class="note mb-0">
        The SHA commit ID that will be used as the anchor for your Agent.
      </p>
    </div>
  </div>
  <div class="d-flex flex-items-center gap-2 js-agentic-sha-editor">
    <% if integration.agent_source&.commit_oid && !sha_has_errors %>
      <span class="js-agentic-sha-field" hidden>
        <%= render(Primer::Alpha::TextField.new(
          name: "#{agent_source_fields.object_name}[commit_oid]",
          label: "SHA",
          visually_hide_label: true,
          full_width: true,
          value: integration.agent_source&.commit_oid,
          required: true,
          invalid: false,
          aria: { describedby: "agent-source-sha-commit-description" },
          style: "width: 240px;"
        )) %>
      </span>

      <code <%= test_selector("agent-source-sha-commit-code") %> class="js-agentic-sha-code color-bg-inset p-1 rounded">
        <%= integration.agent_source.commit_oid %>
      </code>

      <%= render(
        Primer::Beta::IconButton.new(
          icon: :pencil,
          scheme: :secondary,
          size: :small,
          aria: { label: "Edit SHA commit ID" },
          classes: "js-agentic-integration-sha-edit"
        )
      ) %>
    <% else %>
      <%= render(Primer::Alpha::TextField.new(
        name: "#{agent_source_fields.object_name}[commit_oid]",
        label: "SHA",
        visually_hide_label: true,
        full_width: true,
        value: integration.agent_source&.commit_oid,
        required: true,
        invalid: sha_has_errors,
        validation_message: error_for(integration, :"agent_source.commit_oid", human_field: "SHA"),
        aria: { describedby: "agent-source-sha-commit-description" },
        style: "width: 240px;"
      )) %>
    <% end %>
  </div>
</div>
