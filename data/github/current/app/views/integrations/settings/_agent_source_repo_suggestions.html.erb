<%= render(Primer::Alpha::SelectPanel::ItemList.new(
    aria: { label: "repositories" },
    select_variant: :single,
  )) do |list| %>
  <% repos.each do |repo| %>
    <% list.with_item(
      label: repo.name_with_display_owner,
      content_arguments: { data: { value: repo.id } },
      active: repo.id == selected_repository_id,
      test_selector: "agent-source-repo-suggestion-item",
    ) do |item|  %>
      <% item.with_leading_visual_icon(icon: repo.repo_type_icon) %>
    <% end %>
  <% end %>
<% end %>
