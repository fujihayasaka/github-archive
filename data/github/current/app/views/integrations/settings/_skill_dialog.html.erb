<%= render Primer::Alpha::Dialog.new(
  id: dialog_id,
  data: { "integration-agent-form": "skill-edit-dialog" },
  title: title,
  size: :medium_portrait,
  text_align: :left,
) do |d| %>
  <% d.with_header(show_divider: true) %>
  <% d.with_show_button(scheme: button_scheme, icon: local_assigns[:icon] ? icon : nil, aria: { label: aria_label }, data: local_assigns[:open_action] ? { action: open_action } : nil) { "Add new skill" } %>
  <% d.with_body do %>
    <div class="Box-row">
      <div class="d-flex flex-column" style="gap: 1rem;">
        <%= render Primer::Alpha::TextField.new(
          name: nil,
          required: true,
          label: "Name",
          caption: "Name of the skill that is used by the model, and visible to the user as well when it is invoked.",
          data: { "integration-agent-form": "skill-form-name-field" },
          value: "",
        ) %>
        <%= render Primer::Alpha::TextArea.new(
          name: nil,
          required: true,
          label: "Inference description",
          caption: "This helps the model understand when it should select the skill.  A good description will indicate what the skill does, when it should be called, and expected inputs and outputs.",
          data: { "integration-agent-form": "skill-form-description-field" },
          value: "",
        ) %>
        <%= render Primer::Alpha::TextField.new(
          name: nil,
          required: true,
          label: "URL",
          caption: "The API endpoint for the skill.",
          data: { "integration-agent-form": "skill-form-url-field" },
          value: "",
        ) %>
        <%# Manually define the field here as we want to use code blocks %>
        <div class="FormControl width-full FormControl--fullWidth">
          <label for="integration_agent[skill_data][][parameters]">Parameters *</label>
          <div class="FormControl-input-wrap">
            <code>
              <%= text_area_tag nil,
                JSON.pretty_generate({
                  type: 'object',
                  properties: {
                    optional_param_1: {
                      type: 'string',
                      description: 'This parameter expects a string value',
                    },
                  },
                }),
                id: "integration_agent[skill_data][][parameters]",
                class: "form-control FormControl-input FormControl-textarea",
                data: { "integration-agent-form": "skill-form-parameters-field" },
                rows: 7 %>
            </code>
          </div>
          <span class="FormControl-caption">A JSON-schema that defines the parameters of the skill.</span>
        </div>
      </div>
    </div>
  <% end %>
  <% d.with_footer(show_divider: true) do %>
    <%= render Primer::Beta::Button.new(
      type: :button,
      data: { "close-dialog-id": dialog_id },
    ) do %>Cancel<% end %>
    <%= render Primer::Beta::Button.new(
      id: submit_id,
      type: :button,
      scheme: :primary,
      data: { action: submit_action, "close-dialog-id": dialog_id },
    ) do %><%= submit_label %><% end %>
  <% end %>
<% end %>
