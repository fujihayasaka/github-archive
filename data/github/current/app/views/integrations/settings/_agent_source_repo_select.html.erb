<%# locals: (integration:, agent_source_fields:) %>
<div class="mb-0 d-flex flex-row gap-4 flex-justify-between flex-items-center">
  <div class="d-flex flex-column gap-1">
    <div>
      <span id="agent-source-repository-label" class="text-bold color-fg-default">Plugin repository <span class="color-fg-danger" aria-hidden="true">*</span><span class="sr-only">, required</span></span>
      <p id="agent-source-repository-description" class="note mb-0">
        The public repository where your plugin is stored.
      </p>
    </div>
    <% if field_has_errors?(integration, :"agent_source.repository_id") %>
      <div id="agent-source-repository-validation" class="FormControl-inlineValidation">
        <span class="FormControl-inlineValidation--visual"><%= render(Primer::Beta::Octicon.new(icon: :"alert-fill", size: :xsmall, aria: { hidden: true })) %></span>
        <span><%= error_for(integration, :"agent_source.repository_id", human_field: "Plugin repository") %></span>
      </div>
    <% end %>
  </div>
  <div class="d-flex flex-items-center gap-2">
    <% if field_has_errors?(integration, :"agent_source.repository_id") %>
      <%= render(Primer::Beta::Octicon.new(icon: :"alert", color: :danger, size: :small, aria: { hidden: true })) %>
    <% end %>
    <%= render(Primer::Alpha::SelectPanel.new(
      id: "agentic-app-repository-menu-list",
      title: "Select repository",
      select_variant: :single,
      no_results_label: "No repositories found",
      dynamic_label: true,
      form_arguments: { builder: agent_source_fields, name: "repository_id", value: integration.agent_source&.repository_id },
      fetch_strategy: :remote,
      src: gh_settings_app_agent_source_repo_suggestions_path(integration, selected_repository_id: integration.agent_source&.repository_id),
    )) do |menu| %>
      <% menu.with_show_button(
        aria: { describedby: "agent-source-repository-label agent-source-repository-description agent-source-repository-validation" },
        test_selector: "agent-source-repo-select-button",
      ) do |button| %>
        <% button.with_leading_visual_icon(icon: :repo, color: :muted) %>
        <% button.with_trailing_action_icon(icon: "triangle-down") %>
        <%= integration.agent_source&.repository&.name_with_display_owner || "Select repository" %>
      <% end %>
    <% end %>
  </div>
</div>
