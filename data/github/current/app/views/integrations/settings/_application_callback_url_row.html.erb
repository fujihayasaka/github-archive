<%# erblint:counter ButtonComponentMigrationCounter 1 %>
<%= form.hidden_field :_destroy %>
<div class="js-application-callback-url-container">
  <dl class="form-group js-application-callback-url <%= 'errored' if has_errors || (default && has_collection_errors) %>">
    <dt><%= form.label :url, "#{application_callback_url_user_facing_name.upcase_first}" %></dt>
    <dd class="input-group">
      <%= form.text_field :url, value: form.object.raw_url, class: "js-application-callback-url-field", placeholder: "e.g. https://example.com/auth" %>

      <span class="input-group-button">
        <button class="btn color-fg-danger js-delete-application-callback-url" type="button">
          Delete
        </button>
      </span>
    </dd>

    <% if default && has_collection_errors %>
      <dd class="error"><%= error_for(integration, :application_callback_urls, human_field: "") %></dd>
    <% elsif has_errors %>
      <dd class="error"><%= error_for(form.object, :url) %></dd>
    <% end %>
  </dl>

  <% if !!callback_url_matching_strategy_enabled %>
    <dl class="form-group ml-3">
      <dt>
        <label for="<%= form.object_name %>_matching_strategy" aria-describedby="help-text-for-callback-url-matching-strategy">
          <%= form.check_box :matching_strategy, { checked: form.object.permissive_matching_strategy? }, "permissive", "strict" %>
          This redirect URI uses wildcard matching
        </label>
      </dt>
      <dd>
        <p class="note" id="help-text-for-callback-url-matching-strategy">
          Checking this option will allow your app's tokens to be sent to any subdomain of the redirect URI.
        </p>
      </dd>
    </dl>
  <% end %>
</div>
