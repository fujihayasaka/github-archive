<%# view is an instance of Integrations::ShowView %>
<div class="d-flex flex-column gap-3">
  <%= form_for view.integration, url: gh_settings_app_update_agent_setup_path(view.integration), method: :put, html: {"aria-label": "Agent setup", class: "d-flex flex-column gap-3"} do |f| %>
    <%= f.fields_for :agent_source do |agent_source_fields| %>
      <%= render(Primer::Beta::BorderBox.new(padding: :default, my: 0)) do |component| %>
        <%= component.with_row(scheme: :default) do %>
          <%= render partial: "integrations/settings/agent_source_repo_select", locals: { integration: view.integration, agent_source_fields: agent_source_fields } %>
        <% end %>
        <%= component.with_row(scheme: :default) do %>
          <%= render partial: "integrations/settings/agent_source_sha_commit", locals: { integration: view.integration, agent_source_fields: agent_source_fields } %>
        <% end %>
      <% end %>

      <div class="d-flex flex-column gap-1">
        <div>
          <%= agent_source_fields.label :update_message, "Update message" %>
          <div class="note">
            This will be displayed on the update approval page to users. Explain why you are adding Agent features to this App.
          </div>
        </div>

        <%= agent_source_fields.text_area(
          :update_message,
          style: "width: 100%",
          rows: 6,
          error: error_for(view.integration, :"agent_source.update_message", human_field: "Update message")
        ) %>
      </div>
    <% end %>

    <div class="d-flex flex-justify-end">
      <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary) do %><%= submit_label %><% end %>
    </div>
  <% end %>

  <% if view.integration.agent_source&.persisted? %>
    <%= render partial: "integrations/settings/agent_source_danger_zone", locals: { integration: view.integration } %>
  <% end %>
</div>
