<%# `view` is an instance of Integrations::ShowView or Settings::Organization::ManageIntegrationView %>

<% agent_setup_path = gh_settings_app_agent_setup_path(view.integration) %>
<% new_agent_setup_path = gh_settings_app_new_agent_setup_path(view.integration) %>
<% selected_item = if current_page?(agent_setup_path) || current_page?(new_agent_setup_path)
  :agent_setup
end %>
<%= render(Primer::Beta::NavList.new(
    aria: { label: "GitHub App settings" },
    selected_item_id: selected_item,
  )) do |component| %>
  <% component.with_item(
    label: "General",
    href: gh_settings_app_path(view.integration),
  ) do |item| %>
    <% item.with_leading_visual_icon(icon: :apps) %>
  <% end %>
  <% component.with_item(
    label: "Permissions & events",
    href: gh_settings_app_permissions_path(view.integration),
  ) do |item| %>
    <% item.with_leading_visual_icon(icon: :lock) %>
  <% end %>
  <% if view.show_copilot_tab? %>
    <% component.with_item(
      label: "Copilot",
      href: gh_settings_app_integration_agent_path(view.integration),
    ) do |item| %>
      <% item.with_leading_visual_icon(icon: :copilot) %>
    <% end %>
  <% end %>
  <% if view.show_agent_setup? %>
    <% component.with_item(
      label: "Agent apps",
      href: agent_setup_path,
      selected_by_ids: [:agent_setup],
    ) do |item| %>
      <% item.with_leading_visual_icon(icon: :agent) %>
    <% end %>
  <% end %>
  <% if view.beta_features? %>
    <% component.with_item(
      label: "Optional features",
      href: gh_settings_app_beta_features_path(view.integration),
    ) do |item| %>
      <% item.with_leading_visual_icon(icon: :sliders) %>
    <% end %>
  <% end %>
    <% component.with_item(
      label: "Advanced",
      href: gh_settings_app_advanced_path(view.integration),
    ) do |item| %>
    <% item.with_leading_visual_icon(icon: :gear) %>
  <% end %>
  <% unless view.hide_install_app_section? %>
    <% component.with_item(
      label: "Install App",
      href: gh_settings_app_installations_path(view.integration),
    ) do |item| %>
      <% item.with_leading_visual_icon(icon: :download) %>
    <% end %>
  <% end %>
  <% if view.show_app_managers? %>
    <% component.with_item(
      label: "App managers",
      href: view.app_managers_path,
    ) do |item| %>
      <% item.with_leading_visual_icon(icon: :people) %>
    <% end %>
  <% end %>

  <% component.with_divider %>

  <% component.with_item(
    label: view.user_facing_app_url_text,
    href: gh_app_url(view.integration, current_user),
  ) do |item| %>
    <% item.with_trailing_visual_icon(icon: :"link-external") %>
  <% end %>

<% end %>
