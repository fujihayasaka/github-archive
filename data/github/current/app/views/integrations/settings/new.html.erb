<%# view is an instance of Integrations::FormView %>
<% page_info :title => view.page_title, :selected_link => view.selected_link, :sidebar => :settings %>
<% avoid_container_classes = current_context.business? %>
<div class="<% unless avoid_container_classes %>container-lg px-3 pt-6<% end %>">
  <div class="<% unless avoid_container_classes %>col-9 mx-auto<% end %>">

    <% content = capture do %>
      <div class="settings-next">
        <%= render Primer::Beta::Subhead.new do |component| %>
          <% component.with_heading(tag: :h2, font_size: 3) do %><%= view.page_title %><% end %>
        <% end %>

        <%= render "integrations/settings/form", :view => view, :form_action => gh_settings_apps_path(current_context) %>
      </div>
    <% end %>

    <% if current_context.business? %>
      <%= render layout: "businesses/layout", locals: { business: current_context } do %>
        <%= content %>
      <% end %>
    <% elsif current_context.organization? %>
      <%= content %>
    <% elsif current_context.user? %>
      <%= content %>
    <% end %>

  </div>
</div>
