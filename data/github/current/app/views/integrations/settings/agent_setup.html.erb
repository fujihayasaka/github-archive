<%# view is an instance of Integrations::ShowView %>
<% page_info\
  responsive: true,
  title: "GitHub Apps - #{view.integration.name}",
  selected_link: view.selected_link,
  stafftools: gh_stafftools_app_path(view.integration.owner, view.integration)
%>

<% content = capture do %>
  <div class="container-lg tmp-px-3">
    <div class="gutter clearfix">
      <div class="col-12 col-md-3 float-left tmp-my-3">
        <%= render "integrations/settings/integration_menu", :view => view %>
      </div>
      <div class="col-12 col-md-9 float-left">
        <%= render "integrations/settings/integration_header", :view => view %>
        <%= render Primer::Beta::Subhead.new do |component| %>
          <% component.with_heading(tag: :h2) do %>
            <%= view.integration.name %>
          <% end %>
        <% end %>
        <% if view.integration.agent_source.present? %>
          <%= render "integrations/settings/agent_setup_form", view: view, submit_label: "Save changes" %>
        <% else %>
          <%= render Primer::Beta::Blankslate.new(border: true) do |blankslate| %>
            <% blankslate.with_visual_icon(icon: :agent) %>
            <% blankslate.with_heading(tag: :h2) do %>
              Add agent features
            <% end %>
            <% blankslate.with_description do %>
              Agentic Apps can be @mentioned and also assigned to issues and PRs
            <% end %>
            <% blankslate.with_primary_action(href: gh_settings_app_new_agent_setup_path(view.integration)) do %>
              Add agent features
            <% end %>
            <% blankslate.with_secondary_action(href: GitHub.help_url).with_content("Learn more about Agentic Apps") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%= render layout: "settings/settings_focus" do %>
  <%= content %>
<% end %>
