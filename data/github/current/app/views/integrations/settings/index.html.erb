
<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% page_info :title => "GitHub Apps", :selected_link => :integrations, :sidebar => :settings %>
<% content = capture do %>
  <% unless view.pending_transfers.blank? %>
    <% if FeatureFlag.vexi.enabled?(:banner_migration, current_user, default: false) %>
      <%= render(Primer::Alpha::Banner.new(scheme: :warning, icon: "alert", classes: "tmp-mb-4")) do %>
        You have <%= view.pending_transfers.count %> pending integration transfer <%= pluralize_without_number(view.pending_transfers.count, 'request') %>. You can review those below.
      <% end %>
    <% else %>
      <%= render(Primer::Beta::Flash.new(scheme: :warning, icon: "alert", classes: "tmp-mb-4")) do %>
        You have <%= view.pending_transfers.count %> pending integration transfer <%= pluralize_without_number(view.pending_transfers.count, 'request') %>. You can review those below.
      <% end %>
    <% end %>

    <h4>Pending transfer requests</h4>

    <ul class="table-list org-transfer-requests">
      <% view.pending_transfers.each do |transfer| -%>
        <%= render :partial => 'integrations/settings/integration_transfer_row', :object => transfer %>
      <% end %>
    </ul>
  <% end %>

  <% if view.integrations.any? && user_feature_enabled?(:server_to_server_authnd_stateless_banner) && !current_user.dismissed_notice?(UserNotice::STATELESS_S2S_TOKEN_FORMAT_CHANGE_NOTICE, kv_store: GitHub::Authentication::KV.store) %>
    <%= render(Primer::Alpha::Banner.new(scheme: :default, icon: "info", classes: "tmp-mb-4 js-notice", test_selector: "stateless-s2s-token-format-change-notice")) do %>
      <%= form_tag(dismiss_notice_path(UserNotice::STATELESS_S2S_TOKEN_FORMAT_CHANGE_NOTICE), "data-turbo" => "false", class: "js-notice-dismiss") do %>
        <%= render(Primer::Beta::CloseButton.new(type: :submit, float: :right, "aria-label": "Dismiss notice")) %>
      <% end %>
      <div>
        <h5 class="mb-2">Upcoming change to GitHub App installation token format</h5>
        <p>
          GitHub App installation tokens will soon use a new stateless format (ghs_...) and may be longer (~520 characters).
          Apps with hardcoded length assumptions may break.
        </p>

        <p>
          Validate your apps and workflows with the per-request override header detailed in this <%= link_to "GitHub Changelog", "https://github.blog/changelog/2026-05-15-github-app-installation-tokens-per-request-override-header", class: "Link--inTextBlock" %>.
        </p>
      </div>
    <% end %>
  <% end %>

  <div class="settings-next">
    <% unless current_context.is_a?(Business) %>
    <%= render Primer::Beta::Subhead.new do |component| %>
      <% component.with_heading(tag: :h2, font_size: 3) do %>GitHub Apps<% end %>
      <% component.with_actions do %>
        <% if view.can_create_apps? && !view.integrations.empty? %>
        <%= link_to "New GitHub App",
            gh_new_settings_app_path(current_context),
            :class => new_integration_button_classes(current_context, ["btn", "btn-sm"]),
            "data-pjax" => true %>
        <% end %>
      <% end %>
      <% end %>
    <% end %>

    <% if view.integrations.empty? && view.can_create_apps? %>
      <%=render Primer::Beta::Blankslate.new(spacious: :spacious) do |component| %>
        <% component.with_visual_icon(icon: :apps) %>
        <% component.with_heading(tag: :h2).with_content("No GitHub Apps") %>
        <% component.with_description { "Want to build something that integrates with and extends GitHub? Register a new GitHub App to get started developing on the GitHub API." } %>
        <% component.with_primary_action(href: gh_new_settings_app_path(current_context)).with_content("New GitHub App") %>
        <% component.with_secondary_action(href: docs_url("apps/about-creating-github-apps"), target: "_blank").with_content("View documentation") %>
      <% end %>
    <% end %>
  </div>

  <% if view.integrations.any? %>
    <div class="Box js-navigation-container js-active-navigation-container clearfix tmp-mt-3">
      <% view.integrations.each do |integration| %>
        <%= render "integrations/settings/integration_row", :integration => integration %>
      <% end %>
    </div>

    <div class="paginate-container">
      <%= will_paginate view.integrations %>
    </div>

    <p class="text-small color-fg-muted">A GitHub App can act on its own behalf, taking actions via the API directly instead of impersonating a user. Read more in our <a class="Link--inTextBlock" href="<%= docs_url "apps/about-creating-github-apps" %>">developer documentation</a>.</p>
  <% end %>

  <% if current_context.organization? && org_admin? %>
    <%= render Primer::Beta::Subhead.new(spacious: true) do |component| %>
      <% component.with_heading(tag: :h2, font_size: 3) do %>Management<% end %>
    <% end %>

    <p>
      To see or change who can manage GitHub Apps belonging to your organization, see
      <%= render(Primer::Beta::Link.new(href: settings_org_role_assignments_path(current_context), classes: "Link--inTextBlock", scheme: :default )) { "organization role assignments" } %>.
      All organization owners can manage Apps, as well as users and teams with one or more of the app management permissions.
    </p>
  <% end %>
<% end %>

<% if current_context.business? %>
  <%= render layout: "businesses/layout",
      locals: {
        title: "GitHub Apps",
        business: current_context,
        container_attributes: "itemscope itemtype='http://schema.org/Business'",
        header_component_action: new_enterprise_integration_button_for(current_context),
      } do %>
    <%= render "businesses/integrations/tabs" %>
    <%= content %>
  <% end %>
<% elsif current_context.organization? %>
  <%= render layout: "orgs/settings/layout" do %>
    <%= content %>
  <% end %>
<% elsif current_context.user? %>
  <%= render layout: "settings/developer_settings" do %>
    <%= content %>
  <% end %>
<% end %>
