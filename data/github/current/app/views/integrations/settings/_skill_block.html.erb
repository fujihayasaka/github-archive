<div class="Box-row">
  <div class="float-right">
    <%= render partial: "integrations/settings/skill_dialog",
      locals: {
        title: "Edit Definition",
        dialog_id: dialog_id,
        button_scheme: :default,
        icon: :pencil,
        aria_label: "Edit skill",
        open_action: "click:integration-agent-form#openEditSkill",
        submit_id: "edit-skill-submit",
        submit_label: "Update Definition",
        submit_action: "click:integration-agent-form#saveEditSkill",
      }
    %>
    <%= render Primer::Beta::IconButton.new(
      type: :button,
      aria: { label: "Remove skill" },
      icon: :trash,
      size: :small,
      px: 2,
      ml: 1,
      data: { action: "click:integration-agent-form#removeSkill" }
    )%>
  </div>
  <h3 data-integration-agent-form="skill-name-title"><% if local_assigns[:skill] %><%= skill.name %><% end %></h3>
  <p data-integration-agent-form="skill-description-title"><% if local_assigns[:skill] %><%= skill.description %><% end %></p>
  <input type="hidden" name="integration_agent[skill_data][][name]" value="<%= skill.name if local_assigns[:skill] %>" data-integration-agent-form="skill-name-field">
  <input type="hidden" name="integration_agent[skill_data][][description]" value="<%= skill.description if local_assigns[:skill] %>" data-integration-agent-form="skill-description-field">
  <input type="hidden" name="integration_agent[skill_data][][url]" value="<%= skill.url if local_assigns[:skill] %>" data-integration-agent-form="skill-url-field">
  <input type="hidden" name="integration_agent[skill_data][][parameters]" value="<%= skill.parameters if local_assigns[:skill] %>" data-integration-agent-form="skill-parameters-field">
  <input type="hidden" name="integration_agent[skill_data][][return_type]" value="<%= skill.return_type if local_assigns[:skill] %>" data-integration-agent-form="skill-return-type-field">
</div>
