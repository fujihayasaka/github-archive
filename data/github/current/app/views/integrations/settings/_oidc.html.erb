<div>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h4) do %>
      OpenID Connect Token Exchange
    <% end %>

    <% component.with_description do %>
      Set up an OIDC configuration.
    <% end %>
  <% end %>
  <div class="d-flex flex-column" style="gap: 1rem">
    <%= render Primer::Alpha::CheckBox.new(
      name: "integration_agent[token_exchange_enabled]",
      label: "Enabled",
      caption: "Exchange GitHub identity information for a third-party token which will be propogated on app events.",
      checked: agent.token_exchange_enabled,
    ) %>

    <%= render Primer::Alpha::TextField.new(
      name: "integration_agent[token_exchange_url]",
      required: false,
      label: "Token exchange endpoint",
      caption: "The URL to generate the third-party token.",
      value: agent.token_exchange_url,
    ) %>

    <%= render Primer::Alpha::TextField.new(
      name: "integration_agent[third_party_token_header_key]",
      required: false,
      label: "Request header key",
      caption: "The request header key to which the third-party tokens will be attached.",
      value: agent.third_party_token_header_key,
    ) %>

    <%= render Primer::Alpha::TextField.new(
      name: "integration_agent[third_party_token_header_value]",
      required: false,
      label: "Request header value",
      caption: "A template for the request header value for the third-party token. Use \"${token}\" to represent the third-party token.",
      value: agent.third_party_token_header_value,
    ) %>
  </div>
</div>
