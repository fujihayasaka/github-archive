<div class="d-flex flex-column gap-2" <%= test_selector("agent-source-danger-zone") %>>
  <h2 class="f4">Danger zone</h2>

  <%= render(Primer::Beta::BorderBox.new(
    border_color: :danger,
  )) do |component| %>
    <% component.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center width-full gap-3">
        <div class="flex-auto d-flex flex-column gap-1">
          <span class="text-bold color-fg-default">
            Remove Agent features
          </span>
          <p class="note m-0">
            Removes all the features that make this App an Agentic App. You will no longer be able to <b>@mention</b> it or assign it to issues and pull requests.
          </p>
        </div>
        <div>
          <%= render Primer::Alpha::Dialog.new(
            id: "remove-agent-features-dialog",
            title: "Remove Agent features",
          ) do |d| %>
            <% d.with_show_button(scheme: :danger) { "Remove Agent features" } %>
            <% d.with_body do %>
              <p>
                You are about to <strong>remove all Agent features</strong> on the <%= integration.name %> GitHub App. You will no longer be able to <b>@mention</b> it or assign it to issues and PRs.
              </p>
              <p>
                If you ever want to re-enable Agent features for this App, you will need to send another update request to all App users.
              </p>
            <% end %>
            <% d.with_footer do %>
              <%= render Primer::Beta::Button.new(data: { "close-dialog-id": "remove-agent-features-dialog" }) do %>Cancel<% end %>
              <%= form_for integration, url: gh_settings_app_update_agent_setup_path(integration), method: :put do |f| %>
                <%= f.fields_for :agent_source, include_id: false do |agent_source_fields| %>
                  <%= agent_source_fields.hidden_field :_destroy, value: "1" %>
                <% end %>
                <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger) do %>Remove Agent features<% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
