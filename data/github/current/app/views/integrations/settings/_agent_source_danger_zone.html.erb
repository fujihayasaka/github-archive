<div class="d-flex flex-column gap-2" <%= test_selector("agent-source-danger-zone") %>>
  <h2 class="f4">Danger zone</h2>

  <%= render(Primer::Beta::BorderBox.new(
    border_color: :danger,
  )) do |component| %>
    <% component.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center width-full gap-3">
        <div class="flex-auto d-flex flex-column gap-1">
          <span class="text-bold color-fg-default">
            Disable agent features
          </span>
          <p class="note m-0">
            Removes all the features that make this app an agent app. You will no longer be able to assign issues to it, @mention it in pull request comments or trigger it from the Agents tab.
          </p>
        </div>
        <div>
          <%= render Primer::Alpha::Dialog.new(
            id: "remove-agent-features-dialog",
            title: "Disable agent features",
          ) do |d| %>
            <% d.with_show_button(scheme: :danger) { "Disable agent features" } %>
            <% d.with_body do %>
              <p>
                You are about to <strong>disable agent features</strong> on the <%= integration.name %> GitHub App. You will no longer be able to assign issues to it, @mention it in pull request comments or trigger it from the Agents tab.
              </p>
              <p>
                If you choose to re-enable agent features for this App in the future, users will need to opt in again for agent features.
              </p>
            <% end %>
            <% d.with_footer do %>
              <%= render Primer::Beta::Button.new(data: { "close-dialog-id": "remove-agent-features-dialog" }) do %>Cancel<% end %>
              <%= form_for integration, url: gh_settings_app_destroy_agent_setup_path(integration), method: :delete do |f| %>
                <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger) do %>Disable agent features<% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
