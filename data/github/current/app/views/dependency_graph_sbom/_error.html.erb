<%= render Primer::Beta::Blankslate.new(
  large: true,
  spacious: true,
) do |c| %>
  <% c.with_visual_icon(icon: :alert, color: :danger) %>
  <% c.with_heading(tag: :h2).with_content("SBOM generation failed") %>
  <% c.with_description { "We encountered a problem generating the SBOM. Please try again. If the problem persists, please contact support." } %>
  <% c.with_primary_action(href: network_dependencies_path).with_content("Back to Dependency Graph") %>
<% end %>
