<%= render Primer::Beta::Blankslate.new(
  large: true,
  spacious: true,
) do |c| %>
  <% c.with_visual_icon(icon: :"check-circle", color: :success) %>
  <% c.with_heading(tag: :h2).with_content("SBOM ready") %>
  <% c.with_description { "Your SBOM for #{repository.name_with_display_owner} has been generated successfully." } %>
  <% c.with_primary_action(href: download_url).with_content("Download SBOM") %>
<% end %>
