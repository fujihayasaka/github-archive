<% page_info selected_link: :dependency_graph %>

<%= render layout: "layouts/repository/insights" do %>

  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>Dependency graph<% end %>
  <% end %>

  <%= render GitHub::PollIncludeFragmentComponent.new(
    src: poll_url,
    accept: "text/fragment+html"
  ) do %>
    <%= render Primer::Beta::Blankslate.new(
      large: true,
      spacious: true,
    ) do |c| %>
      <% c.with_visual_spinner(size: :medium) %>
      <% c.with_heading(tag: :h2).with_content("Generating SBOM for #{repository.name_with_display_owner}") %>
      <% c.with_description { "This may take a while. This page will update when ready." } %>
    <% end %>
  <% end %>
<% end %>
