<%= render Primer::Beta::Blankslate.new(
  large: true,
  spacious: true,
) do |c| %>
  <% c.with_visual_icon(icon: :alert, color: :danger) %>
  <% c.with_heading(tag: :h2).with_content("SBOM does not exist") %>
  <% c.with_description { "This report either does not exist or has expired. Please generate a new SBOM." } %>
  <% c.with_primary_action(href: network_dependencies_path).with_content("Back to Dependency Graph") %>
<% end %>
