<% wrapper_classes ||= "" %>
<% if !target.has_saved_billing_information?(skip_validation_errors: true) %>
  <div class="border-top py-3 <%= wrapper_classes %>">
    <%= render Primer::Alpha::Banner.new(scheme: :warning, icon: :alert) do |component| %>
      <div class="d-flex flex-items-start flex-justify-between">
        <div class="flex-auto mr-3">
          <strong <%= test_selector("missing-billing-contact") %>>Payment information required</strong>
          <p class="text-small pt-1">
            To <%= action_desc %>, please add your payment details to complete the purchase.
          </p>
        </div>
        <%= render Primer::Beta::Button.new(
          type: :button,
          tag: :a,
          font_size: 6,
          target: "_blank",
          href: target_payment_method_path(target, return_to),
          test_selector: "billing-information-view-edit") do %>
            Add payment info
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
