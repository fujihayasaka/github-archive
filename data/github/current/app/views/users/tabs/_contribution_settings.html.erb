<%= render(Primer::Alpha::ActionMenu.new(
  mt: 1,
  classes: "float-right",
  select_variant: :multiple,
  size: :small,
)) do |menu| %>
  <% menu.with_show_button(
      scheme: :link,
      classes: "pinned-items-setting-link Link--muted",
    ) do |button|
    button.with_trailing_visual_icon(ml: -1, icon: :"triangle-down")
    "Contribution settings"
  end %>

  <% menu.with_item(
    label: "Private contributions",
    active: user.profile_settings.show_private_contribution_count?,
    href: set_private_contributions_preference_user_path(current_user),
    form_arguments: {
      method: :put,
      inputs: [{
        name: "user[show_private_contribution_count]",
        value: user.profile_settings.show_private_contribution_count? ? "0" : "1",
      }, {
        name: "return_to",
        value: "profile",
        type: "hidden",
      }],
    }
  ) do |item| %>
    <% if user.profile_settings.show_private_contribution_count?
      item.with_description.with_content("Turning off private contributions will show only public activity on your profile.")
    else
      item.with_description.with_content("Turning on private contributions will show anonymized private activity on your profile.")
    end %>
  <% end %>

 <% menu.with_item(
    label: "Activity overview",
    active: user.profile_settings.activity_overview_enabled?,
    href: set_activity_overview_preference_user_path(current_user),
    form_arguments: {
      method: :put,
      inputs: [{
        name: "user[activity_overview_enabled]",
        value: user.profile_settings.activity_overview_enabled? ? "0" : "1",
      }, {
        name: "return_to",
        value: "profile",
        type: "hidden",
      }],
    }
  ) do |item| %>
    <% if user.profile_settings.activity_overview_enabled?
      item.with_description.with_content("Turning off the activity overview will hide the section on your profile.")
    else
      item.with_description.with_content("Turning on the activity overview will show an overview of your activity across organizations and repositories.")
    end %>
  <% end %>
<% end %>
