<%
  defer_participants = FeatureFlag.vexi.enabled?(:prs_defer_participants, current_repository, current_repository&.owner, current_user, default: false)

  skip_repo_access_checks = FeatureFlag.vexi.enabled?(:skip_repo_access_checks_for_participants, current_repository, current_repository&.owner, current_user, default: false)
  if issue.pull_request?
    participants = issue.pull_request.participants_for(current_user, optimize_repo_access_checks: true, skip_repo_access_checks: skip_repo_access_checks, user_limit: PullRequest::VIEW_PARTICIPANT_LOAD_LIMIT)
  else
    participants = issue.participants_for(current_user, user_limit: Issue::VIEW_PARTICIPANT_LOAD_LIMIT)
  end

  count = issue.participant_count.nil? ? participants.size : issue.participant_count
%>
<div id="partial-users-participants" class="<%= defer_participants ? '' : 'discussion-sidebar-item' %>">
  <div class="participation">
    <h3 class="discussion-sidebar-heading text-bold">
      <%= number_with_delimiter(count) %> participant<%= 's' unless count == 1 %>
    </h3>
    <div class="participation-avatars d-flex flex-wrap">
      <% participants.each do |user| %>
        <%= profile_link user, class: "participant-avatar" do %>
          <%= avatar_for_with_copilot user, 26, class: "avatar" %><%= " " %><%# leave this space for copy/paste username strings %>
        <% end %>
      <% end %>
      <% if count > participants.size %>
        <span class="participation-more">and others</span>
      <% end %>
    </div>
  </div>
</div>
