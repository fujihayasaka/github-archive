<%= render(Primer::Beta::BorderBox.new) do |component| %>
  <% if accesses.any? %>
    <% component.with_row(display: :flex) do %>
        <span class="col-5 text-bold">
          Name
        </span>
        <span class="col-3 text-bold">
          Last Eight
        </span>
        <span class="col-4 text-bold">Created</span>
    <% end %>
    <% accesses.each do |access| %>
      <% component.with_row(display: :flex) do %>
        <span class="col-5">
          <%= link_to \
            access.name,
            stafftools_user_personal_access_token_path(this_user, access) %>
        </span>
        <span class="col-3">
          <code><%= ProgrammaticAccess::TokenManager.token_last_eight(access) %></code>
        </span>
        <span class="col-4"><%= time_ago_in_words access.created_at %> ago</span>
      <% end %>
    <% end %>
  <% else %>
    <% component.with_body do %>
      This account does not have any personal access tokens
    <% end %>
  <% end %>
<% end %>
