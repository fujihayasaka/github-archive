<% page_info :title => "Fine-grained personal access tokens - #{this_user}",
             :selected_link => :personal_access_tokens %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading do %>
    <span>Fine-grained personal access tokens</span>
  <% end %>
<% end %>

<% if this_user.organization? %>
  <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
    <% component.with_header(font_weight: :emphasized) { "Access Restriction" } %>
    <% component.with_body do %>
      <% if this_user&.business && !this_user.business.personal_access_tokens_delegated_policy? %>
        <%= render(Primer::Alpha::Banner.new(scheme: :warning, test_selector: "stafftools-enterprise-organization-delegation-notice")) do %>
          This setting is configured at the enterprise level ("<%= "#{this_user.business.name}" %>").
        <% end %>
      <% end %>

      <% if this_user.personal_access_tokens_allowed? %>
        <strong>Allowed</strong> &ndash; FGPATs are allowed to access the organization.
      <% else %>
        <strong>Restricted</strong> &ndash; FGPATs are not allowed to access the organization.
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
    <% component.with_header(font_weight: :emphasized) { "Auto-Approval" } %>
    <% component.with_body do %>
      <% if this_user&.business && !this_user.business.pat_requests_auto_approval_delegated_policy? %>
        <%= render(Primer::Alpha::Banner.new(scheme: :warning, test_selector: "stafftools-enterprise-organization-delegation-notice")) do %>
          This setting is configured at the enterprise level ("<%= "#{this_user.business.name}" %>").
        <% end %>
      <% end %>

      <% if this_user.pat_requests_auto_approved? %>
        <strong>Enabled</strong> &ndash; Tokens requested for this organization will work immediately, and organization members are not required to provide a justification when creating the token.
      <% else %>
        <strong>Disabled</strong> &ndash; All access requests by organization members to this organization must be approved before a token is usable.
      <% end %>
    <% end %>
  <% end %>
<% end %>

<turbo-frame id="personal-access-tokens-container" data-turbo-action="advance">
  <% if this_user.organization? %>
    <%= render partial: "stafftools/personal_access_tokens/expiration_note", locals: { organization: this_user } %>
    <%= render partial: "stafftools/personal_access_tokens/list_by_org", locals: { accesses: accesses } %>
  <% else %>
    <%= render partial: "stafftools/personal_access_tokens/list", locals: { accesses: accesses } %>
  <% end %>

  <% if accesses.respond_to?(:total_pages) %>
    <div class="paginate-container">
      <%= will_paginate(accesses, renderer: TurboActionReplaceLinkRenderer) %>
    </div>
  <% end %>
</turbo-frame>

<% if GitHub.runtime.dotcom? %>
  <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
    <% component.with_header(font_weight: :emphasized) do %>
      Pinned API Version
    <% end %>
    <% component.with_body do %>
      <%= render partial: "stafftools/pinned_api_versions/form", locals: { actor: this_user } %>
    <% end %>
  <% end %>
<% end %>
