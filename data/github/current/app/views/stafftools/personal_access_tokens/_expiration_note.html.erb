<% unless organization.personal_access_tokens_restricted? %>
  <%= render(Primer::Beta::BorderBox.new(mb: 4, test_selector: "stafftools-fgpat-expiration-limit-notice")) do |component| %>
    <% component.with_header(font_weight: :emphasized) { "Token Expiration Limit" } %>
    <% component.with_body do %>
      <% if organization.fine_grained_personal_access_token_expiration_limit_enabled? %>
        <% limit = organization.fine_grained_personal_access_token_expiration_limit %>
        <% enterprise = organization&.business %>
        Fine-grained personal access tokens that target the <strong><%= organization.display_login %></strong> organization must expire within <%= limit %> days of creation.

        <% if enterprise.present? %>
          <% enterprise_level_policy = enterprise.fine_grained_personal_access_token_expiration_limit == limit %>
          <% exempt = enterprise.fine_grained_personal_access_token_expiration_limit_exemption_enabled? %>
            <% if enterprise_level_policy %>
              This limit was set by the <strong><%= organization.business.display_login %></strong> enterprise.
            <% else %>
              This limit was set by this organization.
            <% end %>
          Enterprise administrators are <%= exempt ? "" : "not " %>exempt from this policy.
        <% else %>
          This limit was set by this organization.
        <% end %>
      <% else %>
        No expiration limit is enforced for this organization.
      <% end %>
    <% end %>
  <% end %>
<% end %>
