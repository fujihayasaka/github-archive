<%
  page_info(title: "#{ this_user } / knowledge bases", selected_link: :stafftools_knowledge_bases)
%>


<% if knowledge_base.nil? %>
  <%= render(Primer::Beta::Text.new(tag: :h1, test_selector: "copilot-settings-no-knowledge-base-found")) { "No knowledge base found" }%>
<% else %>
<%= render(Primer::Beta::BorderBox.new(mb: 3, test_selector: "knowledge-base")) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
        <div <%= test_selector("knowledge-base-name") %>><%= knowledge_base[:name] %></div>

         <%= render(Primer::Beta::Text.new(font_size: :small, color: :muted, test_selector: "knowledge-base-description")) { knowledge_base[:description] }%>
    <% end %>

      <% repositories.each do |repo| %>
        <% component.with_row do %>
          <%= render Primer::Box.new(display: :flex, direction: :row) do %>
            <%= render Primer::Box.new(flex: 1, display: :flex, direction: :column, justify_content: :center) do %>
              <%= render Stafftools::Copilot::DetailComponent.new(
                repo[:name],
                repo[:indexing_status].to_s,
                nil, # rubocop:disable Rails/OutputSafety
                label_scheme: repo[:indexing_status] == :indexed ? :success : :accent,
              ) %>
            <% end %>

            <%= primer_form_with(url: stafftools_user_knowledge_base_repo_description_path(this_user, id: knowledge_base[:id], repo_id: repo[:id]), method: :put) do |f| %>
              <%= render(Primer::Alpha::Dialog.new(title: "Auto-generated description", subtitle: "Repo description generated by Copilot", size: :large, position: :center, position_narrow: :bottom)) do |h| %>
                <% h.with_show_button(ml: 2, size: :small, scheme: :link) { "view auto-generate description" } %>

                <% h.with_body(mt: 2) do %>
                    <%= render(Primer::Alpha::TextArea.new(name: :description, full_width: true, label: "repo description", visually_hide_label: true, value: repo[:auto_generated_description], test_selector: "knowledge-base-repo-autogenerated-description")) %>
                <% end %>

                <% h.with_footer(show_divider: true) do %>
                  <%= f.submit("Save") %>
                <% end %>
              <% end %>
            <% end %>

          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
