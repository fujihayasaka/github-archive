<%
  page_info(title: "#{ this_user } / knowledge bases", selected_link: :stafftools_knowledge_bases)
%>


<%= render(Primer::Beta::BorderBox.new(mb: 3, test_selector: "knowledge-base")) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2, test_selector: "knowledge-base-name") do %>
      Knowledge Bases
    <% end %>

    <% if knowledge_bases.empty? %>
      <%= render(Primer::Beta::Text.new(tag: :h1, test_selector: "copilot-settings-no-knowledge-bases-found")) { "No knowledge bases found" }%>
    <% else %>
      <% knowledge_bases.each do |kb| %>
        <% component.with_row(display: :flex, direction: :row) do %>
          <%= render Primer::Box.new(flex: 1, d: :flex, justify_content: :center) do %>
            <div>
              <%= render(Primer::Beta::Text.new(mt: 2,
                font_weight: :bold,
                test_selector: "knowledge-base-name")) { kb[:name] } %>
            </div>
            <%= render(Primer::Beta::Text.new(
              color: :muted,
              font_weight: :light,
              font_size: :small,
              test_selector: "knowledge-base-description")) { kb[:description] } %>
          <% end %>

          <%= render Primer::Box.new do %>
            <%= render(Primer::Beta::Button.new(tag: :a, href: stafftools_user_knowledge_base_path(this_user, id: kb[:id]))) { "View" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
