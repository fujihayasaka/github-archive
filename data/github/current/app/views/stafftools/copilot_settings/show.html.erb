 <%
  page_info(title: "#{ this_user } / copilot", selected_link: :stafftools_user_copilot)
%>

<%= render Stafftools::Copilot::AccessComponent.new(
  copilot_user,
  copilot_auth.access_allowed?,
  copilot_auth.verbose_reason,
  copilot_auth_no_snippy.access_allowed?,
  copilot_auth_no_snippy.verbose_reason,
  copilot_user.latest_usage_detail,
  partner_orgs
) %>

<% if user_or_global_feature_enabled?(:copilot_premium_quota_reset) %>
  <%= render Stafftools::Copilot::QuotaResetComponent.new(copilot_user, limited_user) %>
<% else %>
  <%= render Stafftools::Copilot::LimitedUserComponent.new(copilot_user, limited_user) %>
<% end %>

<%= render Stafftools::Copilot::PooledEntitlementsComponent.new(copilot_user) %>

<%= render Stafftools::Copilot::CachedConsumptiveUserComponent.new(copilot_user) %>

<%= render Stafftools::Copilot::SubscriptionComponent.new(
  copilot_user.user_object,
  copilot_user.copilot_active_subscription_item,
  copilot_user.has_trial_subscription?,
  any_orgs_using_cfb: copilot_user.orgs_using_copilot_for_business.any?,
) %>

<%= render Stafftools::Copilot::BusinessSubscriptionComponent.new(seats) %>

<%= render Stafftools::Copilot::UserSettingsComponent.new(copilot_user, has_cfi_access: copilot_auth_no_snippy.has_cfi_access?) %>

<%= render(Stafftools::Copilot::WaitlistsComponent.new(copilot_user.user_object)) %>

<%= render Stafftools::Copilot::FreeSubscriptionComponent.new(
  copilot_user,
  engaged_oss_user: engaged_oss_user,
  free_user: free_user,
  coupon: coupon,
  github_star: copilot_user.github_star?,
  any_orgs_using_cfb: copilot_user.orgs_using_copilot_for_business.any?,
  subscription_item: copilot_user.copilot_active_subscription_item ||
    Billing::Public::SubscriptionItem.all_cancelled(
      account: copilot_user.user_object,
      product: Billing::Public::Product::ProductIdentifier.new(product_type: Billing::ProductUUID::COPILOT_PRODUCT_TYPE),
    ).value { [] }.first,
) %>

<%= render Stafftools::Copilot::TechnicalPreviewComponent.new(
  Copilot::TechnicalPreviewUser.where(user: copilot_user.user_object).first
) %>

<%= render Stafftools::Copilot::EditorNotificationComponent.new(
  Copilot::EditorNotification.where(user_id: copilot_user.user_object.id).order(:created_at)
) %>

<%= render Stafftools::Copilot::AuthAndCaptureComponent.new(entity: this_user) %>

<%= render "stafftools/copilot_settings/anthropic_user_profile",
  anthropic_owner: this_user,
  anthropic_input_id: "anthropic-user-id" %>

<%= render Stafftools::Copilot::BlocksComponent.new(user: copilot_user) %>

<div id="copilot-account-danger-zone" class="boxed-group dangerzone">
  <h3>Danger Zone</h3>
  <%= render Stafftools::Copilot::AbuseWarnComponent.new(copilot_user) %>
  <%= render Stafftools::Copilot::AdministrativeBlockComponent.new(copilot_user) %>
  <% if !copilot_user.trade_restricted? && !copilot_user.has_trade_screening_restriction?(feature_type: :copilot) %>
    <%= render Stafftools::Copilot::GrantFreeAccessComponent.new(
      copilot_user,
      Copilot::TechnicalPreviewUser.where(user: copilot_user.user_object).exists?,
      free_user,
      copilot_user.copilot_active_subscription_item,
    ) %>
  <% end %>
  <% if limited_user.present? %>
    <div class="boxed-group-inner">
      <div class="js-details-container Details">
        <div style="float: right;">
          <%= form_tag stafftools_user_copilot_unsubscribe_limited_user_path(copilot_user),
            :method => :post,
            class: "d-inline-block" do %>
            <%= render(Primer::Beta::Button.new(
              scheme: :danger,
              size: :medium,
              id: "cancel_copilot_free",
              tag: :button,
              type: :submit,
              block: true,
            )) { "Unsubscribe Free Limited User" } %>
          <% end %>
        </div>
        <h4>Unsubscribe Free Limited User</h4>
        <p>
          Unsubscribe the user from Copilot Free. This will remove their access to Copilot and delete their LimitedUser record.
        </p>
      </div>
    </div>
  <% end %>
  <%# Year plans are going away so this is just temporary to allow for testing, please remove once year plans are fully deprecated %>
  <% if current_user.feature_flag_enabled?(:copilot_stafftools_duration_change, default: false) && copilot_user.copilot_active_subscription_item.present? %>
    <div class="boxed-group-inner">
      <div class="js-details-container Details">
        <div style="float: right;">
          <%= form_tag stafftools_user_copilot_update_duration_path(copilot_user),
            :method => :post,
            class: "d-inline-block" do %>
            <%= render(Primer::Beta::Button.new(
              scheme: :danger,
              size: :medium,
              id: "change_copilot_duration",
              tag: :button,
              type: :submit,
              block: true,
            )) { "Change Copilot Duration" } %>
          <% end %>
        </div>
        <h4>Change Copilot Duration</h4>
        <p>
          Change the duration of the user's Copilot subscription to <%= copilot_user.copilot_active_subscription_item&.monthly? ? "yearly" : "monthly" %>.
        </p>
      </div>
    </div>
  <% end %>
  <%= render Stafftools::Copilot::CancelCopilotIndividualSubscriptionComponent.new(copilot_user) %>
</div>
