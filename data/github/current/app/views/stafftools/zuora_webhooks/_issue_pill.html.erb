<% url = webhook.investigation_notes_url %>
<% name = webhook.investigation_notes_url_name %>
<% is_github_issue = name.present? && name.include?("#") %>
<a href="<%= url %>" target="_blank" rel="noopener" class="no-underline">
  <% if is_github_issue %>
    <%= render(Primer::Beta::Label.new(scheme: :success)) do %>
      <%= render(Primer::Beta::Octicon.new(:"issue-opened", size: :small)) %>
      <%= name %>
    <% end %>
  <% else %>
    <%= render(Primer::Beta::Label.new(scheme: :secondary)) do %>
      <%= render(Primer::Beta::Octicon.new(:"link-external", size: :small)) %>
      <%= name || url.truncate(30) %>
    <% end %>
  <% end %>
</a>
