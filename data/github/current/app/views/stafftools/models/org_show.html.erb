<% page_info title: "#{org.display_login} · GitHub Models · Stafftools", selected_link: :stafftools_github_models %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h2, display: :flex, align_items: :center) do %>
    <span>
      <%= link_to "GitHub Models", stafftools_models_path %>
      / <%= link_to org.display_login, stafftools_user_models_path(org), class: "Link--primary" %>
    </span>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |border_box| %>
  <% border_box.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Models access
    <% end %>
  <% end %>

  <% border_box.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2">
        <div class="d-flex flex-items-start flex-items-center">
          Has @<%= org.display_login %> enabled GitHub Models?
        </div>
      </div>
      <div class="d-flex flex-justify-end position-relative">
        <%= render Primer::Beta::Octicon.new(
          icon: (models_enabled ? "check-circle-fill" : "x-circle-fill"),
          color: (models_enabled ? :success : :danger),
          mr: 2,
        )%>
        <span <%= test_selector("org-models-enabled") %>><%= models_enabled ? "yes" : "no" %></span>
      </div>
    </div>
  <% end %>

  <% if models_enabled %>
    <% border_box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="pr-2">
          <div class="d-flex flex-items-start flex-items-center">
            Does @<%= org.display_login %> have any rules around which models are allowed?
          </div>
        </div>
        <div class="d-flex flex-justify-end position-relative">
          <%= render Primer::Beta::Octicon.new(
            icon: (model_access_rules_enabled ? "check-circle-fill" : "x-circle-fill"),
            color: (model_access_rules_enabled ? :success : :danger),
            mr: 2,
          )%>
          <span <%= test_selector("org-models-rules-enabled") %>><%= model_access_rules_enabled ? "yes" : "no" %></span>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if models_enabled && model_access_rules_enabled %>
  <%= render(Primer::Beta::BorderBox.new(
    padding: :condensed,
    mt: 3,
    test_selector: "model-access-rules",
  )) do |border_box| %>
    <% border_box.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Models access rules
        <span class="text-normal color-fg-muted">
          &mdash;
          <% if is_allowlist %>
            An <strong>enabled list</strong> contains rules to explicitly allow access to models. A global block of all models is made, then specific allow rules are made.
          <% else %>
            A <strong>disabled list</strong> contains rules to explicitly block access to models.
          <% end %>
        </span>
      <% end %>
    <% end %>

    <% org_access_rules_publisher.each do |rule| %>
      <% border_box.with_row(display: :flex, align_items: :center, justify_content: :space_between) do %>
        <div>
          <%= render(Primer::Beta::Avatar.new(src: rule.publisher.logo_url, shape: :square, alt: rule.publisher_name)) %>
          <%= render Primer::Beta::Link.new(
            href: marketplace_search_path(publisher: rule.publisher_name, type: "models"),
            underline: true,
          ).with_content(rule.publisher_name) %>
          has been <%= is_allowlist ? "enabled" : "disabled" %>
        </div>
        <%= render Primer::Beta::Label.new.with_content("Publisher") %>
      <% end %>
    <% end %>

    <% org_access_rules_custom_key.each do |rule| %>
      <% border_box.with_row(display: :flex, align_items: :center, justify_content: :space_between) do %>
        <div <%= test_selector("custom-key-rule") %>>
          <%= render(Primer::Beta::Avatar.new(src: rule.custom_key.logo_url, shape: :square,
            alt: rule.custom_key_name)) %>
          <%= rule.custom_key_name %>
          has been <%= is_allowlist ? "enabled" : "disabled" %>
        </div>
        <%= render Primer::Beta::Label.new.with_content("Custom key") %>
      <% end %>
    <% end %>

    <% org_access_rules_model.each do |rule| %>
      <% border_box.with_row(display: :flex, align_items: :center, justify_content: :space_between) do %>
        <div>
          <%= render(Primer::Beta::Avatar.new(src: rule.publisher.logo_url, shape: :square, alt: rule.publisher_name)) %>
          <%= render Primer::Beta::Link.new(
            href: rule.model_details_path,
            underline: true,
          ).with_content(rule.model_slug) %>
          has been <%= is_allowlist ? "enabled" : "disabled" %>
        </div>
        <%= render Primer::Beta::Label.new.with_content("Default model") %>
      <% end %>
    <% end %>

    <% org_access_rules_custom_model.each do |rule| %>
      <% border_box.with_row(display: :flex, align_items: :center, justify_content: :space_between) do %>
        <div <%= test_selector("custom-model-rule") %>>
          <%= render(Primer::Beta::Avatar.new(src: rule.custom_model.logo_url, shape: :square,
            alt: rule.custom_key_name)) %>
          <%= rule.custom_model_name %>
          <% if (custom_model_slug = rule.custom_model_slug).present? && custom_model_slug != rule.custom_model_name %>
            (<code><%= custom_model_slug %></code>)
          <% end %>
          <% if (custom_key_name = rule.custom_key_name).present? %>
            via <%= custom_key_name %>
          <% end %>
          has been <%= is_allowlist ? "enabled" : "disabled" %>
        </div>
        <%= render Primer::Beta::Label.new.with_content("Custom model") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed, mt: 3)) do |border_box| %>
  <% border_box.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Models billing
    <% end %>
  <% end %>

  <% border_box.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2">
        <div class="d-flex flex-items-start flex-items-center">
          <label for="enabled_models_billing" class="mr-2">
            Enabled GitHub Models billing?
          </label>
        </div>
        <p class="note">If false, <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/github-models/use-github-models/prototyping-with-ai-models#rate-limits", underline: true)) { "free rate limits" } %> applies where users can still continue to use GitHub Models but requests are now rate limited.</p>
      </div>
      <div class="d-flex flex-justify-end position-relative" <%= test_selector("models-enabled-billing") %>>
        <%= render Primer::Beta::Octicon.new(
          icon: (enabled_models_billing ? "check-circle-fill" : "x-circle-fill"),
          color: (enabled_models_billing ? :success : :danger),
          mr: 2,
        )%>
        <%= enabled_models_billing ? "yes" : "no" %>
      </div>
    </div>
  <% end %>

  <% border_box.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2">
        <div class="d-flex flex-items-start flex-items-center">
          <label for="can_show_models_billing" class="mr-2">
            Can @<%= org.display_login %> see GitHub Models billing toggle? (can_show_models_billing?)
          </label>
        </div>
      </div>
      <div class="d-flex flex-justify-end position-relative" <%= test_selector("models-can-show-models-billing") %>>
        <%= render Primer::Beta::Octicon.new(
          icon: (can_show_models_billing ? "check-circle-fill" : "x-circle-fill"),
          color: (can_show_models_billing ? :success : :danger),
          mr: 2,
        )%>
        <%= can_show_models_billing ? "yes" : "no" %>
      </div>
    </div>
  <% end %>

  <% border_box.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2">
        <div class="d-flex flex-items-start flex-items-center">
          <label for="can_enable_models_billing" class="mr-2">
            Can @<%= org.display_login %> enable models billing? (can_enable_models_billing?)
          </label>
        </div>
      </div>
      <div class="d-flex flex-justify-end position-relative" <%= test_selector("models-can-enable-billing") %>>
        <%= render Primer::Beta::Octicon.new(
          icon: (can_enable_models_billing ? "check-circle-fill" : "x-circle-fill"),
          color: (can_enable_models_billing ? :success : :danger),
          mr: 2,
        )%>
        <%= can_enable_models_billing ? "yes" : "no" %>
      </div>
    </div>
  <% end %>

  <% border_box.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2">
        <div class="d-flex flex-items-start flex-items-center">
          <label for="has_payment_method" class="mr-2">
           Credit card or PayPal as payment method?
          </label>
        </div>
      </div>
      <div class="d-flex flex-justify-end position-relative" <%= test_selector("models-has-payment-method") %>>
        <%= render Primer::Beta::Octicon.new(
          icon: (has_payment_method ? "check-circle-fill" : "x-circle-fill"),
          color: (has_payment_method ? :success : :danger),
          mr: 2,
        )%>
        <%= has_payment_method ? "yes" : "no" %>
      </div>
    </div>
  <% end %>

  <% if org.customer.present? %>
    <% border_box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="pr-2">
          <div class="d-flex flex-items-start flex-items-center">
            <label for="can_proceed_with_usage" class="mr-2">
              Can proceed with models usage?
            </label>
          </div>
        </div>
        <div class="d-flex flex-justify-end position-relative">
          <%= render Primer::Beta::Button.new(tag: :a, href: stafftools_billing_can_proceed_with_usage_path(customer_id: org.customer.id, product: "models", sku: "models_inference")) do %>
            Check canProceedWithUsage
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<div class="mt-4">
  <h2 class="mb-2">Billing</h2>

  <%= render GitHubModels::Users::BillingUsageComponent.new(
    user: org,
    can_enable_models_billing: can_enable_models_billing,
    has_payment_method: has_payment_method,
    billing_enabled: billing_enabled,
    models_billing_disabled_by_non_payment_method_reason: models_billing_disabled_by_non_payment_method_reason,
    in_stafftools: true
  ) %>
</div>

<% if allowed_models.any? %>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, mt: 3)) do |border_box| %>
    <% border_box.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Allowed models
        <%= render Primer::Beta::Counter.new(count: allowed_models.size) %>
        <span class="text-normal color-fg-muted">
          &mdash;
          The models members of @<%= org.display_login %> are permitted to use based on the organization's policy.
        </span>
      <% end %>
    <% end %>

    <% allowed_models.each do |model| %>
      <% is_custom = model.is_a?(ModelsByok::CustomModel) %>
      <% border_box.with_row(display: :flex, align_items: :center, justify_content: :space_between) do %>
        <div <%= test_selector("allowed-model") %>>
          <%= render(Primer::Beta::Avatar.new(src: model.logo_url, shape: :square,
            alt: is_custom ? model.custom_key_name : model.publisher)) %>
          <% if is_custom %>
            <%= model.name %>
          <% else %>
            <%= render Primer::Beta::Link.new(
              href: model.details_path,
              underline: true,
            ).with_content(model.friendly_name) %>
          <% end %>
          <% if is_custom && model.slug != model.name || !is_custom %>
            <code><%= model.slug %></code>
          <% end %>
          <span class="color-fg-muted">
            <% if is_custom %>
              via <%= model.custom_key_name %>
            <% else %>
              by <%= model.publisher %>
            <% end %>
          </span>
        </div>
        <%= render Primer::Beta::Label.new.with_content(is_custom ? "Custom model" : "Default model") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
