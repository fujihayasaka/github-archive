<% page_info title: "#{org.display_login} · GitHub Models · Stafftools", selected_link: :stafftools_github_models %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h2, display: :flex, align_items: :center) do %>
    <span>
      <%= link_to "GitHub Models", stafftools_models_path %>
      / <%= link_to org.display_login, stafftools_user_models_path(org), class: "Link--primary" %>
    </span>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |border_box| %>
  <% border_box.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Models access
    <% end %>
  <% end %>

  <% border_box.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2">
        <div class="d-flex flex-items-start flex-items-center">
          Is feature flag for org policies enabled for @<%= org.display_login %>?
        </div>
        <p class="note">
          <%= render Primer::Beta::Link.new(
            href: "https://devportal.githubapp.com/feature-flags/github_models_org_access_policies/overview",
            scheme: :primary,
          ).with_content("Link to feature flag") %>
        </p>
      </div>
      <div class="d-flex flex-justify-end position-relative">
        <%= render Primer::Beta::Octicon.new(
          icon: (org_access_policies_ff_enabled ? "check-circle-fill" : "x-circle-fill"),
          color: (org_access_policies_ff_enabled ? :success : :danger),
          mr: 2,
        )%>
        <span <%= test_selector("org-models-ff-enabled") %>><%= org_access_policies_ff_enabled %></span>
      </div>
    </div>
  <% end %>

  <% border_box.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2">
        <div class="d-flex flex-items-start flex-items-center">
          Has @<%= org.display_login %> enabled GitHub Models?
        </div>
      </div>
      <div class="d-flex flex-justify-end position-relative">
        <%= render Primer::Beta::Octicon.new(
          icon: (models_enabled ? "check-circle-fill" : "x-circle-fill"),
          color: (models_enabled ? :success : :danger),
          mr: 2,
        )%>
        <span <%= test_selector("org-models-enabled") %>><%= models_enabled %></span>
      </div>
    </div>
  <% end %>

  <% if models_enabled %>
    <% border_box.with_row do %>
      <div class="d-flex flex-justify-between flex-items-center">
        <div class="pr-2">
          <div class="d-flex flex-items-start flex-items-center">
            Does organization have any rules around models allowed?
          </div>
        </div>
        <div class="d-flex flex-justify-end position-relative">
           <%= render Primer::Beta::Octicon.new(
            icon: (model_access_rules_enabled ? "check-circle-fill" : "x-circle-fill"),
            color: (model_access_rules_enabled ? :success : :danger),
            mr: 2,
          )%>
           <span <%= test_selector("org-models-rules-enabled") %>><%= model_access_rules_enabled %></span>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>


<% if models_enabled && model_access_rules_enabled %>
  <%= render(Primer::Beta::Heading.new(tag: :h3, my: 2)) { is_allowlist ? "Allow list" : "Disabled list" } %>
  <% if is_allowlist %>
    <p><b>Allow list</b> is a list of models and publishers that the organization has allowed usage of. A global block of all models and publishers is enabled, and then specific allow rules are made.</p>
  <% else %>
    <p><b>Disabled list</b> is a list of models and publishers that the organization has not allowed usage of.</p>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |border_box| %>
    <% border_box.with_header do |h| %>
      <% h.with_title(tag: :h4) do %>
        Publishers
      <% end %>
    <% end %>

    <% if org_access_rules_publisher.empty? %>
      <% border_box.with_row do %>
        <div>
          No publisher rules found
        </div>
      <% end %>
    <% end %>

    <% org_access_rules_publisher.each do |rule| %>
      <% border_box.with_row do %>
        <div>
          <%= render(Primer::Beta::Avatar.new(src: rule.publisher.logo_url, shape: :square, alt: rule.publisher_name)) %>
          <%= render Primer::Beta::Link.new(
            href: marketplace_search_path(publisher: rule.publisher_name, type: "models"),
            scheme: :primary,
          ).with_content(rule.publisher_name) %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, mt: 3)) do |border_box| %>
    <% border_box.with_header do |h| %>
      <% h.with_title(tag: :h4) do %>
        Models
      <% end %>
    <% end %>

    <% if org_access_rules_model.empty? %>
      <% border_box.with_row do %>
        <div>
          No model rules found
        </div>
      <% end %>
    <% end %>

    <% org_access_rules_model.each do |rule| %>
      <% border_box.with_row do %>
        <div>
          <%= render(Primer::Beta::Avatar.new(src: rule.publisher.logo_url, shape: :square, alt: rule.publisher_name)) %>
          <%= render Primer::Beta::Link.new(
            href: rule.model_details_path,
            scheme: :primary,
          ).with_content(rule.model_slug) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
