<% page_info title: "GitHub Models Pricing · Stafftools", selected_link: :models_multipliers %>

<%= render layout: "stafftools/stafftools" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h1) do %>
      GitHub Models Pricing
    <% end %>
    <% component.with_actions do %>
      <%= render(
        Primer::Beta::Button.new(
          tag: :a,
          href: new_stafftools_models_multiplier_path
        )
      ) { "Create new multiplier pricing" } %>
    <% end %>
  <% end %>

  <% if models_multipliers.any? %>
    <%= render(Primer::Beta::BorderBox.new(padding: :condensed, mb: 2)) do |component| %>
      <%= component.with_body(p: 0) do %>
        <table class="stafftools-table">
          <thead>
            <tr>
              <th class="text-bold">Model</th>
              <th class="text-bold text-right numerals pr-1">Input multiplier</th>
              <th class="text-bold text-right numerals pr-1">Cached input multiplier</th>
              <th class="text-bold text-right numerals pr-1">Output multiplier</th>
              <th class="text-bold">Options</th>
            </tr>
          </thead>
          <tbody>
            <% models_multipliers.each do |multiplier| %>
              <tr>
                <td>
                  <%= link_to multiplier.model_details_path, class: "Link--primary d-flex flex-items-center gap-2" do %>
                    <%= render Stafftools::Models::LogoComponent.new(model: multiplier.model, flex_shrink: 0, vertical_align: :middle) %>
                    <span class="text-bold"><%= multiplier.model_friendly_name %></span>
                  <% end %>
                </td>
                <td class="text-right pr-1"><%= multiplier.input %></td>
                <td class="text-right pr-1"><%= multiplier.cached_input || "N/A" %></td>
                <td class="text-right pr-1"><%= multiplier.output %></td>
                <td class="d-flex">
                  <%= link_to edit_stafftools_models_multiplier_path(multiplier), class: "Link--primary" do %>
                    <%= render(Primer::Beta::Octicon.new(:pencil, "aria-label": "Edit multiplier", size: :small)) %>
                  <% end %>
                  <%= button_to stafftools_models_multiplier_path(multiplier), method: :delete, data: { confirm: "Are you sure you want to delete this multiplier? If a model has no multiplier it defaults to free tier rules." }, class: "Button Button--link Button--medium ml-2 Link--primary" do %>
                    <%= render(Primer::Beta::Octicon.new(:trash, "aria-label": "Delete multiplier", size: :small)) %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% end %>

    <div class="paginate-container">
      <%= will_paginate models_multipliers %>
    </div>
  <% else %>
    <%= render Primer::Beta::Blankslate.new do |c| %>
      <% c.with_heading(tag: :h2) do %>
        There are no multipliers defined for GitHub Models.
      <% end %>
    <% end %>
  <% end %>
<% end %>
