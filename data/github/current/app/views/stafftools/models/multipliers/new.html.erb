<% page_info title: "GitHub Models Pricing · Stafftools", selected_link: :models_multipliers %>

<%= render layout: "stafftools/stafftools" do %>
  <%= render(Primer::Beta::Breadcrumbs.new(mb: 3)) do |breadcrumb| %>
    <%= breadcrumb.with_item(href: stafftools_models_multipliers_path).with_content("GitHub Models Pricing") %>
    <%= breadcrumb.with_item(href: request.path).with_content("Multiplier") %>
  <% end %>

  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>
      <%= multiplier.persisted? ? "Update an existing" : "Create a new" %> multiplier pricing
    <% end %>
  <% end %>

  <%= render Stafftools::Models::MultiplierComponent.new(multiplier: multiplier) %>
<% end %>
