<%# rubocop:disable Lint/InstanceVariable %>
<% page_info title: "GitHub Models" %>

<%= render layout: "stafftools/stafftools" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h1) do %>
      GitHub Models
    <% end %>
  <% end %>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, mt: 4)) do |component| %>
    <% component.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Job
      <% end %>
    <% end %>
    <% component.with_row(test_selector: "models-dialog-form") do %>
      <%= form_tag stafftools_models_update_path, method: :put do %>
        <% unless GitHub.flipper[:project_neutron_fetch_catalog_items_job].enabled? %>
          <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
            The job is currently turned off. To turn it on, enable
            <%= link_to "project_neutron_fetch_catalog_items_job", "https://devportal.githubapp.com/feature-flags/project_neutron_fetch_catalog_items_job/overview", class: "Link--inTextBlock"  %>.
          <% end %>
        <% end %>

        <%= render(Primer::Alpha::Dialog.new(
          title: "Update GitHub Models catalog data",
          id: "models-dialog",
        )) do |d| %>
          <% d.with_show_button { "Run catalog sync job" } %>
          <% d.with_body do %>
            <p>
              Clicking "Sync catalog" will fetch the latest GitHub Models catalog data from Azure. It may take a few minutes to complete.
            </p>
          <% end %>
          <% d.with_footer do %>
            <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit)) { "Sync catalog" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% unless last_updated_at.nil? %>
    <%= render(Primer::Beta::BorderBox.new(padding: :condensed, mt: 4)) do |component| %>
      <% component.with_header do |h| %>
        <% h.with_title(tag: :h2) do %>
          Last updated at
        <% end %>
      <% end %>
      <% component.with_row(align_items: :center, test_selector: "models-dialog-form") do %>
        <p>
          <%= last_updated_at %> (<%= time_ago_in_words_js(last_updated_at) %>)
        </p>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Stafftools::Models::BulkBlocksComponent.new) %>

  <%= render(Primer::Beta::BorderBox.new(mt: 4)) do |component| %>
    <% component.with_header do %>
      <h3 class="h5">Model Visibility</h3>
    <% end %>

    <% @catalog_items.each do |catalog_item| %>
      <% component.with_row do %>
        <%= render(Primer::Box.new(display: :flex, align_items: :center, justify_content: :space_between)) do %>
          <%= render(Primer::Box.new(display: :flex, align_items: :center, justify_content: :space_between)) do %>
            <%= render(Stafftools::Models::LogoComponent.new(catalog_item: catalog_item)) %>
            <span class="text-bold"><%= catalog_item.parsed_value.dig(:model, :name) %></span>
          <% end %>
          <div>
            <%= render Primer::Alpha::ActionMenu.new(
              select_variant: :single,
              dynamic_label: true,
              dynamic_label_prefix: "Visibility"
            ) do |menu| %>
              <% menu.with_show_button { "Visibility" } %>
              <% menu.with_item(
                label: "Visible",
                active: catalog_item.visible?,
                href: stafftools_models_update_visibility_url(catalog_item.id),
                form_arguments: {
                  method: :put,
                  name: "visibility",
                  value: "visible"
                }
              ) %>
              <% menu.with_item(
                label: "Staffshipped",
                active: catalog_item.staffshipped?,
                href: stafftools_models_update_visibility_url(catalog_item.id),
                form_arguments: {
                  method: :put,
                  name: "visibility",
                  value: "staffshipped"
                }
              ) %>
              <% menu.with_item(
                label: "Hidden",
                active: catalog_item.hidden?,
                href: stafftools_models_update_visibility_url(catalog_item.id),
                form_arguments: {
                  method: :put,
                  name: "visibility",
                  value: "hidden"
                }
              ) %>
            <% end %>
          </div>
        <% end %>
      <% end%>
    <% end %>
  <% end %>
<% end %>
