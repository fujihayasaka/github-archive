<%# Recompute oauth_enterprise_limits rows for every OAuth token this user
    holds. Posts to Stafftools::OauthEnterpriseLimitsController#recompute_user
    which enqueues a single OauthEnterpriseLimitUpdateUserJob. %>
<% return unless FeatureFlag.vexi.enabled?(Stafftools::OauthEnterpriseLimitsController::FEATURE_FLAG, default: false) %>

<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
  <% box.with_header do |header| %>
    <% header.with_title(tag: :h3) { "OAuth enterprise limits" } %>
  <% end %>
  <% box.with_row do %>
    <p class="color-fg-muted">
      Recompute <code>oauth_enterprise_limits</code> rows for every OAuth token
      <%= this_user.login %> holds. One job is enqueued per distinct OAuth
      application.
    </p>
    <%= form_tag stafftools_user_recompute_oauth_enterprise_limits_for_user_path(this_user.login) do %>
      <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit) do %>
        Recompute OAuth enterprise limits
      <% end %>
    <% end %>
  <% end %>
<% end %>
