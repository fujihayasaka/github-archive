<% page_info title: "Safeguard limits", selected_link: :safeguard_limits %>

<% limits_list = capture do %>
  <%= render Primer::Beta::Subhead.new do |subhead| %>
    <% subhead.with_heading(tag: :h2) do %>Safeguard limits<% end %>
  <% end %>

  <%= render Primer::Beta::BorderBox.new(
    padding: :condensed,
    test_selector: "safeguard-limits-list"
  ) do |box| %>
    <% box.with_row do %>
      <% link_url = if limits_target == GitHub
        stafftools_enterprise_limits_path
      else
        stafftools_enterprise_enterprise_limits_path(limits_target.slug)
      end %>
      <%= link_to "Enterprise limits", link_url %>
    <% end %>

    <% enterprise_teams_limits_available = if limits_target == GitHub
      GitHub.can_change_enterprise_team_limits?
    else
      (BusinessTeam.enabled_for_enterprise?(business: limits_target) || limits_target.enterprise_teams_enabled?) && !GitHub.single_business_environment?
    end %>
    <% if enterprise_teams_limits_available %>
      <% box.with_row do %>
        <% link_url = if limits_target == GitHub
          stafftools_enterprise_team_limits_path
        else
          stafftools_enterprise_enterprise_team_limits_path(limits_target.slug)
        end %>
        <%= link_to "Enterprise team limits", link_url, data: test_selector_hash("enterprise-team-limits-link") %>
      <% end %>
    <% end %>

    <% if limits_target == GitHub %>
      <% box.with_row do %>
        <%= link_to "Organization limits", stafftools_organization_limits_path %>
      <% end %>

      <% box.with_row do %>
        <%= link_to "Organization team limits", stafftools_organization_team_limits_path %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if limits_target == GitHub %>
  <%= render layout: "stafftools/stafftools" do %>
    <%= limits_list %>
  <% end %>
<% else %>
  <%= limits_list %>
<% end %>
