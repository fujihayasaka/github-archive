<% page_info title: "Decrypt Flamegraph" %>
<%= render layout: "stafftools/stafftools" do %>
  <div class="Box">
    <%= form_tag stafftools_decrypt_flamegraph_path, multipart: true, method: :post do %>
      <div class="Box-header">
        <h3 class="Box-title">Decrypt Flamegraph</h3>
      </div>
      <div class="Box-body">
        <label>
          Encrypted Flamegraph File
          <div>
            <input name="flamegraph" class="button-file-chooser flamegraph-file-chooser position-relative flamegraph-file-chooser-text" type="file">
          </div>
        </label>
      </div>

      <div class="Box-footer form-actions">
        <%= render Primer::Beta::Button.new(type: :submit, block: true, scheme: :default) do %>
          <span class="d-md-inline-block d-none">Decrypt</span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
