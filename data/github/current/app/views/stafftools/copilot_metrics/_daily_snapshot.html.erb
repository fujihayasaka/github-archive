<%= render(Primer::Beta::Details.new(test_selector: "date-summary")) do |c| %>
  <% date = detail["date"] %>
  <% c.with_summary(button: false) do %>
    <%= date %>
  <% end %>

  <% c.with_body do %>
    <%= render(Primer::Beta::BorderBox.new(padding: :condensed, test_selector: "#{date}-metrics")) do |component| %>
      <% component.with_row do %>
        <td <%= test_selector("total-active-users") %>>Total Active Users: <%= detail["total_active_users"] %></td>
      <% end %>
      <% component.with_row do %>
        <td <%= test_selector("total-engaged-users") %>>Total Engaged Users: <%= detail["total_engaged_users"] %></td>
      <% end %>
      <% component.with_row do %>
        <td <%= test_selector("copilot-ide-code-completions") %>>
          <%= render partial: "stafftools/copilot_metrics/json_detail", locals: {
            title: "Copilot IDE Code Completions",
            data: detail["copilot_ide_code_completions"],
          } %>
        </td>
      <% end %>
      <% component.with_row do %>
        <td <%= test_selector("copilot-ide-chat") %>>
          <%= render partial: "stafftools/copilot_metrics/json_detail", locals: {
            title: "Copilot IDE Chat",
            data: detail["copilot_ide_chat"],
          } %>
        </td>
      <% end %>
      <% component.with_row do %>
        <td <%= test_selector("copilot-dotcom-chat") %>>
          <%= render partial: "stafftools/copilot_metrics/json_detail", locals: {
            title: "Copilot Dotcom Chat",
            data: detail["copilot_dotcom_chat"],
          } %>
        </td>
      <% end %>
      <% component.with_row do %>
        <td <%= test_selector("copilot-dotcom-pull-requests") %>>
          <%= render partial: "stafftools/copilot_metrics/json_detail", locals: {
            title: "Copilot Dotcom Pull Requests",
            data: detail["copilot_dotcom_pull_requests"],
          } %>
        </td>
      <% end %>
    <% end %>
  <% end %>
<% end %>
