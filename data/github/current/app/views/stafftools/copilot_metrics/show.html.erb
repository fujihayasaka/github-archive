<% page_info title: "Copilot Usage Metrics" %>
<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Copilot Organization Metrics
    <% end %>
<% end %>

<%= render(Primer::Beta::Button.new(
  tag: :a,
  href: stafftools_user_copilot_metrics_path(this_user, format: :json),
  target: "_blank",
  test_selector: "view-as-json-button",
)) do |_c| %>
  View As JSON
<% end %>
<br>

<% details.each do |detail| %>
  <%= render partial: "stafftools/copilot_metrics/daily_snapshot", locals: {
    detail:,
  } %>
<% end %>
