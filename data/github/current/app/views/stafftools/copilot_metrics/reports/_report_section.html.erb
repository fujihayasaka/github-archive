<% if files.any? %>
  <div class="Box tmp-mb-3">
    <div class="Box-header">
      <h3 class="Box-title" data-test-id="<%= entity_type %>-export-files-title"><%= title %></h3>
    </div>
    <ul class="Box-body">
      <% files.each_with_index do |export_file, index| %>
        <li class="Box-row d-flex flex-justify-between flex-items-center">
          <div class="d-flex flex-items-center">
            <span class="mr-2 text-mono color-fg-muted"><%= index + 1 %>.</span>
            <code class="mr-2"><%= export_file["name"] %></code>
          </div>
          <%= render Primer::Beta::Button.new(
            tag: :a,
            href: export_file["url"],
            target: "_blank",
            rel: "noopener noreferrer",
            scheme: :primary,
            size: :small,
            test_selector: "download-#{export_file["name"].parameterize}-button"
          ) do %>
            <%= primer_octicon "download", size: :small, classes: "mr-1" %>
            Download
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  <div class="Box tmp-mb-3">
    <div class="Box-header">
      <h3 class="Box-title"><%= title %></h3>
    </div>
    <div class="Box-body">
      <%= render Primer::Beta::Blankslate.new(
        icon: :"file-zip",
        icon_size: :small,
        description: "No #{entity_type} export files are currently available.",
        data: { test_id: "#{entity_type}-export-files-blank-state" }
      ) do |component| %>
        <% component.with_heading(tag: :h4) do %>
          No <%= entity_type.capitalize %> Reports Available
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
