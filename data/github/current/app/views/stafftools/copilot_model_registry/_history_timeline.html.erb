<%# erblint:counter ButtonComponentMigrationCounter 1 %>
<%# History Timeline partial %>
<%# Usage: render partial: "stafftools/copilot_model_registry/history_timeline", locals: { history_entries: entries } %>
<%
  entries = local_assigns[:history_entries] || []
%>
<% if entries.any? %>
  <details class="tmp-mb-4">
    <summary class="btn btn-sm" style="cursor: pointer; list-style: none;">
      <div class="d-flex flex-items-center">
        <%= render(Primer::Beta::Octicon.new(:history, size: :small, mr: 2)) %>
        <strong>Change History</strong>
        <span class="color-fg-muted ml-2">— <%= entries.size %> <%= entries.size == 1 ? "entry" : "entries" %></span>
      </div>
    </summary>

    <div class="Box tmp-mt-3">
      <div class="Box-header color-bg-subtle">
        <strong><%= render(Primer::Beta::Octicon.new(:history, size: :small, mr: 1)) %> Timeline</strong>
      </div>
      <% entries.sort_by { |e| e[:created_at] || Time.at(0) }.reverse.each_with_index do |entry, idx| %>
        <%
          action = entry[:action].to_s
          actor = entry[:actor].to_s
          created_at = entry[:created_at]
          action_icon = case action
            when "create" then :plus
            when "update" then :pencil
            when "delete" then :trash
            when "restore" then :history
            else :dot
          end
          action_color = case action
            when "create" then "color-fg-success"
            when "update" then "color-fg-accent"
            when "delete" then "color-fg-danger"
            when "restore" then "color-fg-attention"
            else "color-fg-muted"
          end
          action_label = case action
            when "create" then "Created"
            when "update" then "Updated"
            when "delete" then "Deleted"
            when "restore" then "Restored"
            else action.capitalize
          end
        %>
        <div class="Box-row d-flex flex-items-start" style="<%= 'border-top: 1px solid var(--borderColor-muted);' unless idx == 0 %>">
          <div class="d-flex flex-items-center flex-shrink-0 tmp-mr-3" style="width: 32px; justify-content: center;">
            <span class="<%= action_color %>">
              <%= render(Primer::Beta::Octicon.new(action_icon, size: :small)) %>
            </span>
          </div>
          <div class="flex-auto">
            <div class="d-flex flex-items-center flex-justify-between">
              <div>
                <%= render(Primer::Beta::Label.new(scheme: action == "delete" ? :danger : action == "create" ? :success : action == "restore" ? :attention : :accent, classes: "mr-2")) { action_label } %>
                <span class="text-small">
                  by <strong><%= actor.present? ? actor : "unknown" %></strong>
                </span>
              </div>
              <span class="text-small color-fg-muted">
                <% if created_at %>
                  <%= time_ago_in_words(created_at) %> ago
                <% end %>
              </span>
            </div>

            <% if entry[:json_content_before].present? || entry[:json_content_after].present? %>
              <details class="tmp-mt-2">
                <summary class="text-small Link--secondary" style="cursor: pointer;">
                  View content snapshot
                </summary>
                <div class="d-flex tmp-mt-2" style="gap: 12px;">
                  <% if entry[:json_content_before].present? %>
                    <div class="flex-1">
                      <div class="text-small text-bold color-fg-muted tmp-mb-1">Before</div>
                      <pre class="p-2 color-bg-subtle rounded-2" style="font-size: 11px; max-height: 300px; overflow: auto; white-space: pre-wrap; word-break: break-word;"><%= entry[:json_content_before] %></pre>
                    </div>
                  <% end %>
                  <% if entry[:json_content_after].present? %>
                    <div class="flex-1">
                      <div class="text-small text-bold color-fg-muted tmp-mb-1">After</div>
                      <pre class="p-2 color-bg-subtle rounded-2" style="font-size: 11px; max-height: 300px; overflow: auto; white-space: pre-wrap; word-break: break-word;"><%= entry[:json_content_after] %></pre>
                    </div>
                  <% end %>
                </div>
              </details>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </details>
<% else %>
  <div class="text-small color-fg-muted tmp-mb-4">
    <%= render(Primer::Beta::Octicon.new(:history, size: :small, mr: 1)) %>
    No change history available.
  </div>
<% end %>
