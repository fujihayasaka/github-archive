<%
  page_info(title: "SIMSHIP Instructions - #{model[:name]}", description: "SIMSHIP deployment instructions for #{model[:name]}")
%>
<%= render layout: "stafftools/stafftools" do %>

  <div class="site-admin-subhead ruleless">
    <div class="tmp-mb-3">
      <%= render(Primer::Beta::Link.new(href: stafftools_copilot_model_registry_index_path, classes: "Link--inTextBlock")) do %>
        <%= render Primer::Beta::Octicon.new(icon: :"arrow-left", size: :small) %>
        Back to Model Registry
      <% end %>
    </div>

    <h2 class="site-admin-subhead-heading">🚢 SIMSHIP Instructions: <%= model[:name] %></h2>
    <p class="text-small color-fg-muted tmp-mb-3">
      Model Key: <code><%= model[:key] %></code> | Vendor: <%= model[:vendor] %>
    </p>

    <!-- Quick Timeline Summary -->
    <%= render Primer::Alpha::Banner.new(icon: :"clock", scheme: :default, classes: "tmp-mt-3 tmp-mb-4") do %>
      <strong>Quick Timeline:</strong>
      <%= render(Primer::Beta::Label.new(scheme: :secondary)) { "Pre-launch" } %> Endpoint flags to 100%
      <%= render(Primer::Beta::Label.new(scheme: :warning)) { "Launch day start" } %> Policy setup + set primary flag to 0%
      <%= render(Primer::Beta::Label.new(scheme: :success)) { "After policy setup" } %> Integration visibility to 100%
      <%= render(Primer::Beta::Label.new) { "After smoke tests" } %> Gradual rollout of primary flag
    <% end %>

    <!-- Policy Feature Flags Section -->
    <h3 class="h3 tmp-mb-3">📋 Policy Feature Flags (Gradual Rollout)</h3>
    <%= render Primer::Alpha::Banner.new(icon: :people, mt: 2, scheme: :warning, classes: "tmp-mb-3") do %>
      These control WHO can use the model (user/org access). The primary feature flag below should be gradually rolled out from 0% to 100% after initial setup and smoke testing.
    <% end %>
    <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
      <% if model[:feature_flag].present? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
            <div>
              <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Primary Feature Flag ⭐" } %>
              <div class="text-small color-fg-muted mt-1">Main rollout flag - use this for gradual % rollout to control policy access</div>
            </div>
            <%= render(Primer::Beta::Link.new(
              href: "https://devportal.githubapp.com/feature-flags/#{model[:feature_flag]}/overview",
              target: "_blank",
              classes: "btn btn-sm"
            )) do %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
              <%= model[:feature_flag] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if model[:skip_policy_feature_flag].present? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
            <div>
              <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Skip Policy Feature Flag ⚠️" } %>
              <div class="text-small color-fg-muted mt-1"><strong>CRITICAL:</strong> UNSHIP this on launch day - it bypasses policy checks</div>
            </div>
            <%= render(Primer::Beta::Link.new(
              href: "https://devportal.githubapp.com/feature-flags/#{model[:skip_policy_feature_flag]}/overview",
              target: "_blank",
              classes: "btn btn-sm"
            )) do %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
              <%= model[:skip_policy_feature_flag] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if model[:policy_pro_feature_flag].present? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
            <div>
              <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Policy Pro Feature Flag" } %>
              <div class="text-small color-fg-muted mt-1">Feature flag for Pro tier policy access</div>
            </div>
            <%= render(Primer::Beta::Link.new(
              href: "https://devportal.githubapp.com/feature-flags/#{model[:policy_pro_feature_flag]}/overview",
              target: "_blank",
              classes: "btn btn-sm"
            )) do %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
              <%= model[:policy_pro_feature_flag] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if model[:policy_ga_feature_flag].present? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
            <div>
              <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Policy GA Feature Flag" } %>
              <div class="text-small color-fg-muted mt-1">Feature flag for GA policy access</div>
            </div>
            <%= render(Primer::Beta::Link.new(
              href: "https://devportal.githubapp.com/feature-flags/#{model[:policy_ga_feature_flag]}/overview",
              target: "_blank",
              classes: "btn btn-sm"
            )) do %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
              <%= model[:policy_ga_feature_flag] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if model[:policy_rollout_complete_feature_flag].present? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
            <div>
              <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Policy Rollout Complete Feature Flag" } %>
              <div class="text-small color-fg-muted mt-1">Indicates completion of policy rollout</div>
            </div>
            <%= render(Primer::Beta::Link.new(
              href: "https://devportal.githubapp.com/feature-flags/#{model[:policy_rollout_complete_feature_flag]}/overview",
              target: "_blank",
              classes: "btn btn-sm"
            )) do %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
              <%= model[:policy_rollout_complete_feature_flag] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <!-- Rollout Feature Flags Section -->
    <% if model[:visible_feature_flags].present? && model[:visible_feature_flags].any? %>
      <h3 class="h3 tmp-mb-3">🎯 Integration Visibility Flags (Enable on Launch Day)</h3>
      <%= render Primer::Alpha::Banner.new(icon: :rocket, mt: 2, scheme: :success, classes: "tmp-mb-3") do %>
        Enable these to 100% on launch day after policy setup. They make the model visible in client UIs (VS Code, dotcom, mobile, etc.). The primary policy flag still controls actual access.
      <% end %>
      <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
        <% model[:visible_feature_flags].each do |flag_check| %>
          <%= component.with_row do %>
            <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full, mb: 2)) do %>
              <div class="flex-1">
                <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold, mb: 1)) { flag_check["flag_name"] || flag_check[:flag_name] } %>
                <% conditions = flag_check["conditions"] || flag_check[:conditions] %>
                <% if conditions %>
                  <div class="text-small color-fg-muted mt-2">
                    <% integrations = conditions["integrations_allow_list"] || conditions[:integrations_allow_list] %>
                    <% categories = conditions["integration_categories_allow_list"] || conditions[:integration_categories_allow_list] %>
                    <% requires_hmac = conditions["requires_valid_hmac"] || conditions[:requires_valid_hmac] %>

                    <% if integrations&.any? %>
                      <div class="mb-1">
                        <%= render(Primer::Beta::Octicon.new(:apps, size: :small, mr: 1)) %>
                        <strong>Integrations:</strong> <%= integrations.join(", ") %>
                      </div>
                    <% end %>

                    <% if categories&.any? %>
                      <div class="mb-1">
                        <%= render(Primer::Beta::Octicon.new(:stack, size: :small, mr: 1)) %>
                        <strong>Categories:</strong> <%= categories.join(", ") %>
                      </div>
                    <% end %>

                    <% if requires_hmac %>
                      <div class="mb-1">
                        <%= render(Primer::Beta::Octicon.new(:"shield-check", size: :small, mr: 1)) %>
                        <strong>Requires valid HMAC</strong>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <%= render(Primer::Beta::Link.new(
                href: "https://devportal.githubapp.com/feature-flags/#{flag_check["flag_name"] || flag_check[:flag_name]}/overview",
                target: "_blank",
                classes: "btn btn-sm"
              )) do %>
                <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
                View Flag
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <!-- Endpoint Feature Flags Section -->
    <% if model[:endpoint_feature_flags].present? && model[:endpoint_feature_flags].any? %>
      <h3 class="h3 tmp-mb-3">🔌 Endpoint Feature Flags (Enable to 100% Before Launch)</h3>
      <%= render Primer::Alpha::Banner.new(icon: :"shield-check", mt: 2, scheme: :danger, classes: "tmp-mb-3") do %>
        <strong>PRE-LAUNCH REQUIREMENT:</strong> These MUST be at 100% BEFORE launch day (ideally days before). They enable technical infrastructure, not user access.
      <% end %>
      <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
        <% model[:endpoint_feature_flags].each do |flag| %>
          <%= component.with_row do %>
            <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
              <div>
                <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { flag } %>
                <div class="text-small color-fg-muted mt-1">Technical endpoint availability - must be 100% before users can access</div>
              </div>
              <%= render(Primer::Beta::Link.new(
                href: "https://devportal.githubapp.com/feature-flags/#{flag}/overview",
                target: "_blank",
                classes: "btn btn-sm"
              )) do %>
                <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
                <%= flag %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <!-- Additional Feature Flags Section -->
    <h3 class="h3 tmp-mb-3">⚙️ Operational Feature Flags (Ship to 100% Anytime)</h3>
    <%= render Primer::Alpha::Banner.new(icon: :gear, mt: 2, scheme: :default, classes: "tmp-mb-3") do %>
      These operational flags don't affect user access and can be enabled at 100% whenever needed for operations/monitoring.
    <% end %>
    <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
      <% if model[:retry_feature_flag].present? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
            <div>
              <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Retry Feature Flag" } %>
              <div class="text-small color-fg-muted mt-1">Controls automatic retry logic for failed requests</div>
            </div>
            <%= render(Primer::Beta::Link.new(
              href: "https://devportal.githubapp.com/feature-flags/#{model[:retry_feature_flag]}/overview",
              target: "_blank",
              classes: "btn btn-sm"
            )) do %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
              <%= model[:retry_feature_flag] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if model[:warning_message_high_usage_ff].present? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
            <div>
              <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Warning: High Usage" } %>
              <div class="text-small color-fg-muted mt-1">Shows high usage warning messages to users</div>
            </div>
            <%= render(Primer::Beta::Link.new(
              href: "https://devportal.githubapp.com/feature-flags/#{model[:warning_message_high_usage_ff]}/overview",
              target: "_blank",
              classes: "btn btn-sm"
            )) do %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
              <%= model[:warning_message_high_usage_ff] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if model[:warning_message_degraded_performance_ff].present? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
            <div>
              <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Warning: Degraded Performance" } %>
              <div class="text-small color-fg-muted mt-1">Shows degraded performance warning messages</div>
            </div>
            <%= render(Primer::Beta::Link.new(
              href: "https://devportal.githubapp.com/feature-flags/#{model[:warning_message_degraded_performance_ff]}/overview",
              target: "_blank",
              classes: "btn btn-sm"
            )) do %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
              <%= model[:warning_message_degraded_performance_ff] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if model[:warning_message_degraded_performance_provider_ff].present? %>
        <%= component.with_row do %>
          <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full)) do %>
            <div>
              <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) { "Warning: Provider Degraded Performance" } %>
              <div class="text-small color-fg-muted mt-1">Shows provider-specific degraded performance warnings</div>
            </div>
            <%= render(Primer::Beta::Link.new(
              href: "https://devportal.githubapp.com/feature-flags/#{model[:warning_message_degraded_performance_provider_ff]}/overview",
              target: "_blank",
              classes: "btn btn-sm"
            )) do %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, mr: 1)) %>
              <%= model[:warning_message_degraded_performance_provider_ff] %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <!-- SIMSHIP Checklist -->
    <h3 class="h3 tmp-mb-3">✅ SIMSHIP Deployment Checklist</h3>
    <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
      <%= component.with_row do %>
        <div class="markdown-body">
          <ol>
            <li><strong>Step 1: Pre-launch (Days Before Launch):</strong>
              <ul>
                <li>✅ Verify all endpoint feature flags are at <strong>100%</strong></li>
                <% if model[:endpoint_feature_flags].present? && model[:endpoint_feature_flags].any? %>
                  <% model[:endpoint_feature_flags].each do |flag| %>
                    <li><code><%= flag %></code> → 100%</li>
                  <% end %>
                <% end %>
              </ul>
            </li>
            <li><strong>Step 2: Launch Day - Policy Setup:</strong>
              <ul>
                <li>📋 Enable policy flags for Enterprise/Org (enables the policy system itself)</li>
                <li>⚠️ <strong>CRITICAL:</strong> Set skip policy flag to 0% (<code><%= model[:skip_policy_feature_flag] %></code>) - removes policy bypass</li>
                <li>🎯 Set primary feature flag to 0% (<code><%= model[:feature_flag] %></code>) - ready to start rollout</li>
              </ul>
            </li>
            <li><strong>Step 3: Launch Day - Make Model Visible:</strong>
              <ul>
                <li>🚀 Enable integration visibility flags to 100% (makes model appear in UI pickers)</li>
                <% if model[:visible_feature_flags].present? && model[:visible_feature_flags].any? %>
                  <% model[:visible_feature_flags].each do |flag_check| %>
                    <li><code><%= flag_check["flag_name"] || flag_check[:flag_name] %></code> → 100%</li>
                  <% end %>
                <% end %>
              </ul>
            </li>
            <li><strong>Step 4: Smoke Testing:</strong>
              <ul>
                <li>Test VS Code for typical Hubber use case (Chat and Agent Mode)</li>
                <li>Verify inline policy enablement works on individual accounts</li>
                <li>Dotcom Chat smoke test</li>
                <li>Mobile mode smoke test (if applicable)</li>
                <li>CLI mode smoke test (if applicable)</li>
                <li>CCA mode smoke test (if applicable)</li>
              </ul>
            </li>
            <li><strong>Step 5: Gradual Rollout (Increase User Access):</strong>
              <ul>
                <li>📢 Communicate in team channel that rollout is starting</li>
                <li>📈 Gradually increase primary feature flag (<code><%= model[:feature_flag] %></code>) from 0% → 10% → 25% → 50% → 75% → 100%</li>
                <li>⏸️ Pause at each percentage to monitor metrics and errors before continuing</li>
              </ul>
            </li>
          </ol>
        </div>
      <% end %>
    <% end %>

    <!-- Model Details -->
    <h3 class="h3 tmp-mb-3">📊 Model Details</h3>
    <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
      <%= component.with_row do %>
        <div><strong>Model Key:</strong> <%= model[:model_key] %></div>
      <% end %>
      <%= component.with_row do %>
        <div><strong>Name:</strong> <%= model[:name] %></div>
      <% end %>
      <%= component.with_row do %>
        <div><strong>Vendor:</strong> <%= model[:vendor] %></div>
      <% end %>
      <%= component.with_row do %>
        <div><strong>Plans:</strong> <%= model[:plans].join(", ") %></div>
      <% end %>
      <%= component.with_row do %>
        <div><strong>Preview:</strong> <%= model[:preview] ? "Yes" : "No" %></div>
      <% end %>
      <%= component.with_row do %>
        <div><strong>Internal:</strong> <%= model[:internal] ? "Yes" : "No" %></div>
      <% end %>
      <%= component.with_row do %>
        <div><strong>Inline Approval Enabled:</strong> <%= model[:inline_approval_enabled] ? "Yes" : "No" %></div>
      <% end %>
      <% if model[:documentation_link].present? %>
        <%= component.with_row do %>
          <div>
            <strong>Documentation:</strong>
            <%= render(Primer::Beta::Link.new(href: model[:documentation_link], target: "_blank", classes: "Link--inTextBlock")) do %>
              <%= model[:documentation_link_text].presence || model[:documentation_link] %>
              <%= render(Primer::Beta::Octicon.new("link-external", size: :small, ml: 1)) %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
