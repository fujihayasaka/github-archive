<%
  page_info(title: "Copilot Model Registry - Cache View", description: "Cached Copilot models comparison")
%>
<%= render layout: "stafftools/stafftools" do %>

  <div class="site-admin-subhead ruleless">
    <div class="tmp-mb-3">
      <%= render(Primer::Beta::Link.new(href: stafftools_copilot_model_registry_index_path, classes: "Link--inTextBlock")) do %>
        <%= render(Primer::Beta::Octicon.new(:"arrow-left", size: :small, mr: 1)) %>
        Back to Model Registry
      <% end %>
    </div>

    <h2 class="site-admin-subhead-heading">🪿 Copilot Model Registry — Cache View</h2>
    <% if models_diff %>
      <%= render Primer::Alpha::Banner.new(
        icon: :alert,
        scheme: :warning,
        test_selector: "copilot-model-registry-warning",
        classes: "tmp-mt-3") do |component| %>
        <strong>Warning:</strong> There is a difference between the registry models and cached models
        <%= button_to "Update Cached Models", stafftools_copilot_model_registry_index_path, method: :post, class: "btn btn-sm btn-primary tmp-mt-3", data: { confirm: "Are you sure you want to update the cached models?" } %>
        <%= button_to "Delete Cached Models", stafftools_copilot_model_registry_path("all"), method: :delete, class: "btn btn-sm btn-danger tmp-mt-3", data: { confirm: "Are you sure you want to delete the cached models?" } %>
      <% end %>
    <% end %>

    <% unless models_diff %>
       <%= render Primer::Alpha::Banner.new(
        icon: :info,
        scheme: :default,
        test_selector: "copilot-model-registry-info",
        classes: "tmp-mt-3") do |component| %>
        <strong>Info:</strong> The registry models and cached models are the same
        <%= button_to "Delete Cached Models", stafftools_copilot_model_registry_path("all"), method: :delete, class: "btn btn-sm btn-danger tmp-mt-3", data: { confirm: "Are you sure you want to delete the cached models?" } %>
      <% end %>
    <% end %>
    <h4 class="site-admin-subhead-heading tmp-my-3">Registry Models (<%= registry_models.size %>)</h4>
    <% if registry_models.any? %>
      <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
        <% registry_models.each do |model| %>
          <%= component.with_row(scheme: :default) do %>
            <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full, mb: 1)) do %>
              <%= render(Primer::Beta::Link.new(href: stafftools_copilot_model_registry_path(model.model_key))) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) do %>
                  <%= model.name %>
                <% end %>
              <% end %>
              <div>
                <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2).with_content("Preview")) if model.preview %>
                <%= render(Primer::Beta::Label.new(scheme: :secondary, ml: 2).with_content("Internal")) if model.internal %>
              </div>
            <% end %>
            <div class="mb-1 color-fg-muted text-small">
              <%= render(Primer::Beta::Octicon.new(:key, size: :small, mr: 1)) %>
              <%= model.model_key %>
            </div>
            <div class="mb-1 color-fg-muted text-small">
              <%= render(Primer::Beta::Octicon.new(:copilot, size: :small, mr: 1)) %>
              <%= model.plans.join(", ").gsub("copilot_", " ").titleize %>
            </div>
            <div class="mb-1 color-fg-muted text-small">
              <%= render(Primer::Beta::Octicon.new(:beaker, size: :small, mr: 1)) %>
              <%= render(Primer::Beta::Link.new(href: "https://devportal.githubapp.com/feature-flags/#{model.feature_flag}/overview", classes: "Link--inTextBlock").with_content(model.feature_flag)) %>
            </div>
            <div class="color-fg-muted">
              <%= model.description %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
        <%= component.with_row do %>
          No models found
        <% end %>
      <% end %>
    <% end %>

    <h4 class="site-admin-subhead-heading tmp-my-3">Cached Models (<%= cached_models.size %>)</h4>
    <% if cached_models.any? %>
      <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
        <% cached_models.each do |model| %>
          <%= component.with_row(scheme: :default) do %>
            <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, width: :full, mb: 1)) do %>
              <%= render(Primer::Beta::Link.new(href: stafftools_copilot_model_registry_path(model.model_key))) do %>
                <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :bold)) do %>
                  <%= model.name %>
                <% end %>
              <% end %>
              <div>
                <%= render(Primer::Beta::Label.new(scheme: :success, ml: 2).with_content("Preview")) if model.preview %>
                <%= render(Primer::Beta::Label.new(scheme: :secondary, ml: 2).with_content("Internal")) if model.internal %>
              </div>
            <% end %>
            <div class="mb-1 color-fg-muted text-small">
              <%= render(Primer::Beta::Octicon.new(:key, size: :small, mr: 1)) %>
              <%= model.model_key %>
            </div>
            <div class="mb-1 color-fg-muted text-small">
              <%= render(Primer::Beta::Octicon.new(:copilot, size: :small, mr: 1)) %>
              <%= model.plans.join(", ").gsub("copilot_", " ").titleize %>
            </div>
            <div class="mb-1 color-fg-muted text-small">
              <%= render(Primer::Beta::Octicon.new(:beaker, size: :small, mr: 1)) %>
              <%= render(Primer::Beta::Link.new(href: "https://devportal.githubapp.com/feature-flags/#{model.feature_flag}/overview", classes: "Link--inTextBlock").with_content(model.feature_flag)) %>
            </div>
            <div class="color-fg-muted">
              <%= model.description %>
              <% if model.documentation_link.present? && model.documentation_link_text.present? %>
                <%= render(Primer::Beta::Link.new(href: model.documentation_link, classes: "Link--inTextBlock")) { model.documentation_link_text }  %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-3")) do |component| %>
        <%= component.with_row do %>
          No models found
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
