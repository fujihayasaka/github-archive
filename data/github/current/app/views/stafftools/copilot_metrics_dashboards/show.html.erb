<% page_info title: "Copilot Metrics Dashboards" %>
<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Copilot Organization Metrics Dashboards<% end %>
<% end %>

<%= render_react_partial name: "stafftools-copilot-metrics-dashboards", props: {
  dashboards: [
    {
      title: "Copilot user onboarding",
      historicalMetrics: Copilot::Metrics::Dashboards::UserOnboarding.new(owner: this_user).payload,
      metricsDataType: "adoption",
    },
    {
      title: "Copilot code completions acceptance rate",
      historicalMetrics: Copilot::Metrics::Dashboards::CompletionsAcceptanceRate.new(owner: this_user).payload,
      metricsDataType: "code_acceptance",
    },
    {
      title: "Copilot generated code acceptance rate",
      historicalMetrics: Copilot::Metrics::Dashboards::GeneratedCodeAcceptanceRate.new(owner: this_user).payload,
      metricsDataType: "code_acceptance",
    },
    {
      title: "Average commits per contributor",
      historicalMetrics: Copilot::Metrics::Dashboards::AverageCommits.new(owner: this_user).payload,
      metricsDataType: "average_contribution",
    },
    {
      title: "Average pull requests merged per contributor",
      historicalMetrics: Copilot::Metrics::Dashboards::AveragePullRequestsMerged.new(owner: this_user).payload,
      metricsDataType: "average_contribution",
    },
    {
      title: "Average pull request lead time",
      historicalMetrics: Copilot::Metrics::Dashboards::PullRequestLeadTime.new(owner: this_user).payload,
      metricsDataType: "average_pull_request_lead_time",
    }
  ]
} %>
