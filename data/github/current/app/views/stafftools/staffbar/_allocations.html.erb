<li>
  <%= render(Primer::Alpha::Dialog.new(id: "staffbar-allocations", title: "Allocations", size: :auto, color: :default)) do |d| %>
    <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white", data: hydro_click_tracking_attributes("staff_bar.allocations.click", {})) do %>
      <%= render Primer::Beta::Text.new(tag: :strong, color: view.allocations_scheme) do %>
        <%= view.obj_allocated %>
      <% end %> allocations
    <% end %>

    <% d.with_header(show_divider: true) %>

    <% d.with_body do %>
      <p>This request made
        <%= render Primer::Beta::Text.new(tag: :strong, color: view.allocations_scheme) do %>
          <%= view.obj_allocated %>
        <% end %> allocations

        <% if view.allocations_scheme == :danger %>
          😭
        <% elsif view.allocations_scheme == :attention %>
          👀
        <% else %>
          🙂
        <% end %>
      </p>

      <p> &lt; 300k allocations per request is acceptable. </p>
      <p> &lt; 100k allocations per request is a good target. </p>

      <p>Too many allocations will result in worse performance
      as we spend more time in garbage collection.</p>

      See
      <%= render(Primer::Beta::Link.new(href: "https://thehub.github.com/epd/engineering/dev-practicals/performance/tools/allocation-tracer/", classes: "Link--inTextBlock", scheme: :default, underline: true)) { "Allocation Tracer docs" } %>
      for how to identify costly allocations.
    <% end %>
  <% end %>
</li>
