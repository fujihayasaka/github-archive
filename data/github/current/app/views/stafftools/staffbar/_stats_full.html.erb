<%# erblint:counter DeprecatedComponentsCounter 3 %>
<% view ||= Stafftools::Staffbar::Stats.new(request: request) %>

<ul class="stats js-stats js-full" data-turbo-replace id="staffbar-stats">
  <% if view.exceptions? %>
    <li>
      <span class="stat-toggle">
        <a href="/devtools/exceptions">
          <%= time_ago_in_words_js view.most_recent_exception %>
        </a>
        exception
      </span>
    </li>
  <% end %>

  <% if view.job_stats? %>
    <%= render_nothing_if_database_fails do %>
      <li>
        <span class="stat-toggle">
          <strong><%= view.pending_jobs %></strong>
          <span><%= "job".pluralize(view.pending_jobs_raw) %></span>
        </span>
      </li>
    <% end %>
  <% end %>

  <% if view.enterprise? %>
    <li>
      <span class="stat-toggle">
        <strong><%= view.server_status(:elasticsearch) %></strong>
        elasticsearch
      </span>
    </li>

    <li>
      <span class="stat-toggle">
        <strong><%= view.server_status(:redis2) %></strong>
        redis
      </span>
    </li>

    <li>
      <span class="stat-toggle">
        <strong><%= view.server_status(:memcached) %></strong>
        cache
      </span>
    </li>
  <% end %>

  <%= render partial: "stafftools/staffbar/stats_response_time" %>
</ul>

<ul class="stats more-stats js-more-stats" data-turbo-replace id="staffbar-more-stats">
  <li>
    <% if Rails.env.development? %>
      <p class="m-0 d-inline-block switcher">Switch to <%= runtime_switcher_link %></p>
    <% elsif Rails.env.production? && !GitHub.single_or_multi_tenant_enterprise? && !GitHub.garage_unicorn? %>
      <%= form_tag labs_path, method: :patch, class: ["switcher", "d-inline", GitHub.employee_unicorn? ? "employee-unicorn" : ""] do %>
        Switch <%= "back" if GitHub.employee_unicorn? %> to
        <%= render Primer::Beta::Button.new(
          type: :submit,
          scheme: :link,
        ).with_content(GitHub.employee_unicorn? ? "GitHub.com" : "GitHub:lab") %>
      <% end %>
    <% end %>
  </li>

  <li>
    <%= render Stafftools::AdjacentTextNodes::AdjacentTextNodesMenuComponent.new %>
  </li>

  <%= render Issues::MetadataSuggestionStaffbarComponent.new(
    issue: respond_to?(:current_issue) ? current_issue : nil,
    controller_name: controller_name,
    action_name: action_name,
    repository: respond_to?(:current_repository) ? current_repository : nil,
  ) %>

  <% if GitHub.stats_ui_enabled? %>
    <li>
      <%= render Stafftools::React::ReactProfilingToggleComponent.new %>
    </li>
    <li>
      <%= render Stafftools::React::ReactQueryDevtoolsComponent.new %>
    </li>
    <% if Rails.env.development? %>
      <li>
        <accessibility-scan-toggle>
          <%= render(Primer::Beta::Button.new(
            id: "accessibility-scan-button",
            size: :small,
            scheme: :link,
            color: :on_emphasis,
            "aria-label": "Axe Scan",
            "data-target": "accessibility-scan-toggle.button",
            "data-action": "click:accessibility-scan-toggle#toggleAccessibilityScan",
          )) do |c| %>
            <% c.with_tooltip(text: "Toggle axe scanning for accessibility issues") %>
            <%= render(Primer::Beta::Octicon.new(icon: :accessibility, size: :small)) %>
          <% end %>
        </accessibility-scan-toggle>
      </li>
    <% end %>

    <li>
      <%= render Primer::Beta::Button.new(
        scheme: :link,
        tag: :a,
        href: view.api_insights_pane_path,
        color: :on_emphasis,
        size: :small,
        id: "enable-api-insights-button",
        "aria-label": "Enable Api Insights"
      ) do |c| %>
        <% c.with_tooltip(text: "Enable Api Insights") %>
        <%= primer_octicon(:"light-bulb") %>
      <% end %>
    </li>

    <% unless view.enterprise? %>
      <li>
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-cache-configure", title: "Cache partitions", subtitle: "Check the partitions you wish to skip")) do |d| %>
          <% d.with_show_button(scheme: :link, classes: "color-text-white", aria: { label: "Configure cache partitions" }) do |s| %>
              <% s.with_tooltip(text: "Configure cache partitions") %>
              <%= primer_octicon(:cache) %>
          <% end %>
          <%= form_with url: '.', method: :get, class: "pt-3" do %>
            <%= d.with_body do %>
              <% GitHub.cache_partitions.each do |key, partition| %>
                <div class="form-checkbox">
                  <label>
                    <input type="checkbox" name="skipmc[]" <%= "checked" if partition.skip %> value="<%= key %>">
                    <%= key %>
                  </label>
                </div>
              <% end %>
            <% end %>
            <%= d.with_footer(show_divider: true) do %>
              <%= render(Primer::ButtonComponent.new(scheme: :default, data: { "close-dialog-id": "staffbar-cache-configure" })) { "Cancel" } %>
              <%= render(Primer::ButtonComponent.new(scheme: :primary, type: :submit)) { "Skip partitions" } %>
            <% end %>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <% if view.profiling_enabled? %>
      <li>
        <%= render Primer::Beta::Button.new(
          scheme: :link,
          tag: :a,
          href: view.vernier_profile_path,
          id: "download-vernier-profile-button",
          color: :on_emphasis,
          size: :small,
          download: true,
          "aria-label": "Vernier profile. View at https://vernier.prof",
        ) do |c| %>
          <% c.with_tooltip(text: "Vernier profile. View at https://vernier.prof") %>
          <%= primer_octicon(:graph) %>
        <% end %>
      </li>
    <% end %>

    <li>
      <% if view.cache_tracer_enabled? %>
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-cache-tracer", title: "Cache Tracer", size: :auto, color: :default)) do |d| %>
            <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do |button| %>
              <% button.with_tooltip(text: "View cache tracer", direction: :s) %>
              <%= primer_octicon(:archive) %>
            <% end %>

          <% d.with_header(show_divider: true) %>

          <% d.with_body(classes: "overflow-auto") do %>
            <table class="width-full">
              <thead>
                <tr>
                  <th>Key</th>
                  <th>Latency (ms)</th>
                  <th>Operation</th>
                </tr>
              </thead>
              <% view.cache_events.each do |event| %>
                <tr class="<%= event[:slow] ? "color-bg-attention" : nil %>">
                  <td>
                    <% if event[:slow] %>
                      <details>
                        <summary>
                          <%= view.cache_key_utf8_safe(event[:key]) %>
                        </summary>
                        <div class="overflow-auto no-wrap">
                          <% view.cache_event_formatted_stack_locations(event).each do |location| %>
                            <a href="<%= location.view_source_url %>" target="_blank" class="Link--muted d-block">
                              <%= location.description %>
                            </a>
                          <% end %>
                        </div>
                      </details>
                    <% else %>
                      <%= view.cache_key_utf8_safe(event[:key]) %>
                    <% end %>
                  </td>
                  <td><%= view.cache_event_formatted_latency(event) %></td>
                  <td><%= event[:operation] %></td>
                </tr>
              <% end %>
            </table>
          <% end %>
        <% end %>
      <% else %>
        <%= render Primer::Beta::Button.new(
          scheme: :link,
          tag: :a,
          href: view.cache_tracer_path,
          id: "enable-cache-tracer-button",
          size: :small,
          "aria-label": "Enable cache tracer",
          color: :on_emphasis
        ) do |c| %>
          <% c.with_tooltip(text: "Enable cache tracer") %>
          <%= primer_octicon(:archive) %>
        <% end %>
      <% end %>
    </li>

    <% unless GitHub.enterprise? %>
      <li id="staff-bar-web-vitals">
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-web-vitals", title: "Web vitals", size: :auto, color: :default)) do |d| %>
          <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white", aria: { label: "Web vitals" }) do |button| %>
            <% button.with_tooltip(text: "Web vitals", direction: :s) %>
            <%= primer_octicon(:heart) %>
          <% end %>

          <% d.with_header(show_divider: true) do %>
            <p class="color-fg-muted mb-0">
              <abbr title="Time to First Byte">TTFB</abbr> - <span data-metric="ttfb">pending...</span><%# erblint:disable GitHub::Accessibility::NoTitleAttribute %>
            </p>
            <p class="color-fg-muted mb-0">
              <abbr title="Largest Contentful Paint - enabling staffbar may affect LCP scoring">LCP</abbr> - <span data-metric="lcp">pending...</span><%# erblint:disable GitHub::Accessibility::NoTitleAttribute %>
            </p>
            <p class="color-fg-muted mb-0">
              <abbr title="Cumulative Layout Shift">CLS</abbr> - <span data-metric="cls">pending...</span><%# erblint:disable GitHub::Accessibility::NoTitleAttribute %>
            </p>
            <p class="color-fg-muted mb-0">
              <abbr title="First Input Delay">FID</abbr> - <span data-metric="fid">pending...</span><%# erblint:disable GitHub::Accessibility::NoTitleAttribute %>
            </p>
            <p class="color-fg-muted mb-0">
              <abbr title="Highest Priority Content">HPC</abbr> - <span data-metric="hpc">pending...</span><%# erblint:disable GitHub::Accessibility::NoTitleAttribute %>
            </p>

            <p>
              Look at <a class="Link--inTextBlock" href="https://catalog.githubapp.com/scorecards/web-performance">the web performance scorecard</a> to learn more.
            </p>
          <% end %>
        <% end %>
      </li>

      <li id="staff-bar-bundle-sizes">
        <bundle-size-stats>
          <%= render(Primer::Alpha::Dialog.new(id: "staffbar-bundle-sizes", title: "Bundle sizes", size: :auto, color: :default)) do |d| %>
            <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white", aria: { label: "Bundle sizes" }) do |button| %>
              <% button.with_tooltip(text: "Bundle sizes", direction: :s) %>
              <%= primer_octicon(:code) %>
            <% end %>

            <% d.with_header(show_divider: true) do %>
              <%= render(Primer::Beta::IconButton.new(
                scheme: :invisible,
                icon: :trash,
                variant: :small,
                ml: 2,
                aria: { "label": "Clear log" },
                data: { "action": "click:bundle-size-stats#clearLog" }
              )) %>
            <% end %>

            <% d.with_body(classes: "overflow-auto") do %>
              <ul data-target="bundle-size-stats.logList" style="max-height: 400px; min-height: 100px; overflow: auto"></ul>
            <% end %>
          <% end %>
        </bundle-size-stats>
      </li>
      <li>
        <%= render Stafftools::AzureExp::StaffbarComponent.new %>
      </li>
    <% end %>

    <% if view.render_stats? %>
      <li <% if !view.render_stats_visible? %>hidden<% end %>>
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-render-stats", title: "Rendering", size: :auto, color: :default)) do |d| %>
          <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do %>
            <strong><%= view.render_time %></strong> render
          <% end %>

          <% d.with_header(show_divider: true) do %>
            <p class="color-fg-muted mb-0">
              <%= view.render_time %> total
            </p>
          <% end %>

          <% d.with_body(classes: "overflow-auto render-trace") do %>
            <%= view.render_trace_html %>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <% if view.process_stat_tracked?(:gc) %>
      <%= render partial: "stafftools/staffbar/allocations", locals: { view: view } %>
    <% end %>

    <% if view.process_stat_tracked?(:redis) %>
      <li <% if !view.process_stat_visible?(:redis) %>hidden<% end %>>
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-redis-stats", title: "Redis", size: :auto, color: :default)) do |d| %>
          <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do %>
            <strong><%= view.process_stat(:redis_stats) %></strong> redis
          <% end %>

          <% d.with_header(show_divider: true) do %>
            <p class="color-fg-muted mb-0">
              <%= view.process_stat(:redis_stats) %> total
            </p>
          <% end %>

          <% d.with_body(classes: "overflow-auto") do %>
            <%= render partial: "stafftools/staffbar/event_trace", locals: { event_traces: view.redis_trace } %>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <% if view.process_stat_tracked?(:memcached) %>
      <% cache_visible = view.process_stat_visible?(:memcached) || (view.process_stat_tracked?(:cache) && view.process_stat_visible?(:cache)) %>
      <li <% if !cache_visible %>hidden<% end %>>
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-cache-stats", title: "Cache", size: :auto, color: :default)) do |d| %>
          <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do |button| %>
            <% if view.process_stat_tracked?(:cache) %>
              <% button.with_tooltip(text: "#{view.process_stat(:memcached_stats)} GitHub::Cache ops", direction: :s) %>
              <strong><%= view.process_stat(:memcached_stats) %></strong>
            <% else %>
              <strong><%= view.process_stat(:memcached_stats) %></strong>
            <% end %> cache
          <% end %>

          <% d.with_header(show_divider: true) do %>
            <p class="color-fg-muted mb-0">
              <%= view.process_stat(:memcached_stats) %> total
              <span class="float-right">
                * A cached value of nil is counted as a miss here.
              </span>
            </p>
          <% end %>

          <% d.with_body(classes: "overflow-auto") do %>
            <table class="width-full">
              <tr>
                <th>Key</th>
                <th class="text-right">Set</th>
                <th class="text-right">Hit*</th>
                <th class="text-right">Miss*</th>
              </tr>
              <% GitHub::Cache::Client.query_keys.each do |key, count| %>
                <tr>
                  <td><%= view.cache_key_utf8_safe(key.inspect) %></td>
                  <td class="text-right"><%= GitHub::Cache::Client.query_sets[key] %></td>
                  <td class="text-right"><%= GitHub::Cache::Client.query_hits[key] %></td>
                  <td class="text-right"><%= GitHub::Cache::Client.query_misses[key] %></td>
                </tr>
              <% end %>
            </table>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <% if view.process_stat_tracked?(:es) %>
      <li <% if !view.process_stat_visible?(:es) %>hidden<% end %>>
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-es-stats", title: "Elasticsearch", size: :auto, color: :default)) do |d| %>
          <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do |button| %>
            <% button.with_tooltip(text: view.es_loader_stats, direction: :s) %>
            <strong><%= view.process_stat(:es_stats) %></strong> es
          <% end %>

          <% d.with_header(show_divider: true) do %>
            <p class="color-fg-muted mb-2">
              <strong><%= view.process_stat(:es_stats) %></strong> total
            </p>
          <% end %>

          <% d.with_body(classes: "overflow-auto") do %>
            <% Elastomer::QueryStats.instance.each_with_index do |stat, index| %>
              <div class="Box-row">
                <h5 class="mb-1">Request took <%= stat.time %> ms, matching <%= stat.total %> documents (timed out: <%= stat.timed_out %>)</h5>
                <p class="mb-1 mt-2 text-small color-fg-muted">Standard curl:</p>
                <div class="input-group">
                  <input id="site-es-query-curl-<%= index %>" type="text" value="<%= stat.curl %>" class="form-control input-sm" data-autoselect readonly aria-label="Curl command">
                  <span class="input-group-button">
                    <%= render Primer::Beta::ClipboardCopy.new(for: "site-es-query-curl-#{index}", "aria-label": "Copy curl to clipboard", classes: "btn btn-sm zeroclipboard-button") %>
                  </span>
                </div>
                <p class="mb-1 mt-2 text-small color-fg-muted">Curl with profiling enabled:</p>
                <div class="input-group">
                  <input id="site-es-query-curl-profile-<%= index %>" type="text" value="<%= stat.curl_with_profile %>" class="form-control input-sm" data-autoselect readonly aria-label="Curl command with profiling enabled">
                  <span class="input-group-button">
                    <%= render Primer::Beta::ClipboardCopy.new(for: "site-es-query-curl-profile-#{index}", "aria-label": "Copy curl with profiling to clipboard", classes: "btn btn-sm zeroclipboard-button") %>
                  </span>
                </div>
                <details class="mb-3">
                  <summary class="mt-3"><%= stat.url %></summary>
                  <%= stat.hl_body %>
                </details>
              </div>
            <% end %>
          <% end %>

          <% d.with_footer(show_divider: true) do %>
            <%= render Primer::ButtonComponent.new(block: true) do %>Close<% end %>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <% if view.process_stat_tracked?(:graphql) %>
      <li <% if !view.process_stat_visible?(:graphql) %>hidden<% end %>>
        <% graphql_css_class = params[:graphql_query_trace] ? "js-graphql-performance-pane-toggle" : "" %>

        <span class="stat-toggle">
          <%= render Primer::Beta::Link.new(
            href: view.graphql_tracer_path,
            classes: graphql_css_class,
            id: "staffbar-graphql-stats-link"
          ) do |c| %>
            <% c.with_tooltip(text: view.graphql_loader_stats, direction: :s) %>
            <strong><%= view.process_stat(:graphql_stats) %></strong>
          <% end %>
          graphql
        </span>
      </li>
    <% end %>

    <% if view.process_stat_tracked?(:mysql) %>
      <li <% if !view.process_stat_visible?(:mysql) %>hidden<% end %>>
        <span class="stat-toggle">
          <%= render Primer::Beta::Link.new(
            href: view.mysql_tracer_path,
            id: "staffbar-mysql-stats-link",
            "data-turbo": false
          ) do |c| %>
            <% c.with_tooltip(text: view.sql_tooltip, direction: :s) %>
            <%= view.process_stat(:mysql_stats) %>
              / <span style="color: #774aa2">
                <%= GitHub::MysqlInstrumenter.primary_query_count %>
              </span>
              / <%= view.query_cache_hits %>
          <% end %>
          sql
        </span>
      </li>
    <% end %>

    <% if view.process_stat_tracked?(:mysql) %>
      <li <% if !view.process_stat_visible?(:mysql) %>hidden<% end %>>
        <% cluster_details = view.bucket_clusters(required_clusters: controller.required_clusters, optional_clusters: controller.optional_clusters) %>
        <%= render(Primer::Alpha::Dialog.new(title: "MySQL Cluster Stats", size: :auto, color: :default)) do |dialog| %>
          <% dialog.with_header(show_divider: true) %>
          <% dialog.with_show_button(scheme: :link, classes: "stat-toggle color-text-white", "aria-label": "MySQL Cluster Stats") do |button| %>
            <% button.with_tooltip(text: "Queries against required / optional / undeclared clusters", direction: :s) %>
            <strong><%= cluster_details[:required].length %> / <%= cluster_details[:optional].length %> / <%= cluster_details[:undeclared].length %></strong>
            clusters
          <% end %>
          <% dialog.with_body(classes: 'ws-normal') do %>
            <% if cluster_details[:required].any? %>
              <h4 class="pb-1">Required clusters:</h4>
              <p class="pb-1">Clusters required to render this page.</p>

              <%= render "stafftools/staffbar/cluster_details", clusters: cluster_details[:required], disabled_clusters: view.disabled_cluster_names %>
            <% end %>

            <% if cluster_details[:optional].any? %>
              <h4 class="pb-1">Optional clusters:</h4>
              <p class="pb-1">Clusters this page can render without.</p>

              <%= render "stafftools/staffbar/cluster_details", clusters: cluster_details[:optional], disabled_clusters: view.disabled_cluster_names %>
            <% end %>

            <% if cluster_details[:undeclared].any? %>
              <h4 class="pb-1">Undeclared clusters:</h4>
              <p class="pb-1">Clusters that aren't declared. Please declare clusters in your controller via <code>depends_on_cluster</code>.</p>
              <%= render "stafftools/staffbar/cluster_details", clusters: cluster_details[:undeclared], disabled_clusters: view.disabled_cluster_names %>
            <% end %>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <% if view.process_stat_tracked?(:gitrpc) %>
      <li <% if !view.process_stat_visible?(:gitrpc) %>hidden<% end %>>
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-gitrpc-stats", title: "GitRPC", size: :auto, color: :default)) do |d| %>
          <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do |button| %>
            <% button.with_tooltip(text: view.gitrpc_call_stats, direction: :s) %>
            <%= view.process_stat(:gitrpc_stats) %> gitrpc
          <% end %>

          <% d.with_header(show_divider: true) do %>
            <p class="color-fg-muted mb-0">
              <%= view.process_stat(:gitrpc_stats) %> total
            </p>
          <% end %>

          <% d.with_body(classes: "overflow-auto") do %>
            <%= render partial: "stafftools/staffbar/event_trace", locals: { event_traces: view.gitrpc_trace } %>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <% if view.process_stat_tracked?(:markdown) %>
      <li <% if !view.process_stat_visible?(:markdown) %>hidden<% end %>>
        <span class="stat-toggle">
          <%= render(Primer::Alpha::Dialog.new(id: "staffbar-markdown-stats", title: "Markdown", size: :auto, color: :default)) do |d| %>
            <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do %>
              <strong><%= view.process_stat(:markdown_stats) %></strong> md
            <% end %>

            <% d.with_header(show_divider: true) do %>
              <p class="color-fg-muted mb-0">
                <%= view.process_stat(:markdown_stats) %> total
              </p>
            <% end %>

            <% d.with_body(classes: "overflow-auto") do %>
              <pre><%= view.markdown_call_stats %></pre>
            <% end %>
          <% end %>
        </span>
      </li>
    <% end %>

    <% if GitHub.feature_flag_ui_enabled? && view.process_stat_tracked?(:tested_features) %>
      <% vexi_enabled_features, vexi_disabled_features = VexiSubscriber.tested_features.keys.partition { |feature| VexiSubscriber.tested_features[feature] } %>
      <% vexi_preloaded_features = VexiSubscriber.preloaded_features %>
      <li <% if VexiSubscriber.tested_features.empty? %>hidden<% end %>>
        <div class="d-flex">
          <%= render(Primer::Alpha::Dialog.new(id: "staffbar-features-stats", title: "Features", size: :auto, color: :default)) do |d| %>
            <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do %>
              <strong>
                <%= number_with_delimiter vexi_enabled_features.size %>
                /
                <%= number_with_delimiter VexiSubscriber.tested_features.size %>
              </strong> features
            <% end %>

            <% d.with_header(show_divider: true) %>

            <% d.with_body(classes: "pb-3") do %>
              <%= render(Primer::Alpha::UnderlinePanels.new(with_panel: true, label: "Feature flags stats")) do |c| %>
                <% c.with_tab(id: "vexi-feature-flags-tab", panel_id: "vexi-feature-flags-panel", selected: true, href: "#") do |t| %>
                  <% t.with_text { "Feature Flags" } %>
                  <% t.with_panel do %>
                    <% if vexi_enabled_features.size != 0 %>
                      <table class="flags-table">
                        <caption>Enabled</caption>

                        <thead>
                          <tr>
                            <td></td>

                            <th>
                              Preloaded?

                              <a href="https://thehub.github.com/epd/engineering/dev-practicals/performance/features/#preloading-feature-flags">
                                <%= render Primer::Beta::Octicon.new(icon: "info", "aria-label": "View docs") %>
                              </a>
                            </th>

                            <th>Toggle in URL</th>

                          </tr>
                        </thead>

                        <tbody>
                          <% vexi_enabled_features.sort.each do |feature| %>
                            <tr>
                              <th>
                                <a href="<%= "https://devportal.githubapp.com/feature-flags/#{feature}/overview" %>" >
                                  <%= feature %>
                                </a>
                              </th>

                              <td>
                                <% if vexi_preloaded_features.include?(feature) %>
                                  <span aria-label="Yes" role="img">✅</span>
                                <% else %>
                                  <span aria-label="No" role="img">❌</span>
                                <% end %>
                              </td>

                              <td>
                                <a href="?<%= request.query_parameters.merge(
                                  _features: [request.query_parameters[:_features], "!#{feature}"].compact.join(",")
                                ).to_query %>">
                                  Disable
                                </a>
                              </td>

                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    <% end %>

                    <% if vexi_disabled_features.size != 0 %>
                      <table class="flags-table">
                        <caption>Disabled</caption>

                        <thead>
                          <tr>
                            <td></td>

                            <th>
                              Preloaded?

                              <a href="https://thehub.github.com/epd/engineering/dev-practicals/performance/features/#preloading-feature-flags">
                                <%= render Primer::Beta::Octicon.new(icon: "info", "aria-label": "View docs") %>
                              </a>
                            </th>

                            <th>Toggle in URL</th>

                          </tr>
                        </thead>

                        <tbody>
                          <% vexi_disabled_features.sort.each do |feature| %>
                            <tr>
                              <th>
                                <a href="<%= "https://devportal.githubapp.com/feature-flags/#{feature}/overview" %>" >
                                  <%= feature %>
                                </a>
                              </th>

                              <td>
                                <% if vexi_preloaded_features.include?(feature) %>
                                  <span aria-label="Yes" role="img">✅</span>
                                <% else %>
                                  <span aria-label="No" role="img">❌</span>
                                <% end %>
                              </td>

                              <td>
                                <a href="?<%= request.query_parameters.merge(
                                  _features: [request.query_parameters[:_features], feature].compact.join(",")
                                ).to_query %>">
                                  Enable
                                </a>
                              </td>

                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    <% end %>

                    <p class="mb-4">
                      Time taken to preload <%= vexi_preloaded_features.size %> features: <%= sprintf('%.3f', VexiSubscriber.total_preload_duration * 1000) %>ms
                    </p>

                    <h4>
                      <%= VexiSubscriber.total_enabled_calls %>
                      Feature#enabled? calls
                      (<%= sprintf('%.3f', VexiSubscriber.total_enabled_duration * 1000) %>ms)
                    </h4>

                    <table class="width-full mb-4">
                      <tr>
                        <th>Feature</th>
                        <th>enabled? call durations (µs)</th>
                      </tr>

                      <% VexiSubscriber.tested_feature_timings.sort.to_h.each do |name, durations| %>
                        <tr>
                          <td><%= name %></td>
                          <td><%= durations.map { |duration| (duration * 1_000_000).round }.join(", ") %></td>
                        </tr>
                      <% end %>
                    </table>
                  <% end %>
                <% end %>

                <% c.with_tab(id: "feature-previews-tab", panel_id: "feature-previews-panel", href: "#") do |t| %>
                  <% t.with_text { "Feature Previews" } %>
                  <% t.with_panel do %>
                    <%
                        enabled_feature_previews, disabled_feature_previews = current_user.checked_feature_previews.partition { |k, v| v.fetch(:enabled) }
                    %>
                    <%=
                      render(Site::ServerStats::FeaturePreviewComponent.new(
                        title: "Enabled Feature Previews",
                        feature_previews_info: enabled_feature_previews,
                      ))
                    %>
                    <%=
                      render(Site::ServerStats::FeaturePreviewComponent.new(
                        title: "Disabled Feature Previews",
                        feature_previews_info: disabled_feature_previews,
                      ))
                    %>
                  <% end %>
                <% end %>

                <% c.with_tab(id: "feature-flags-cache-tab", panel_id: "feature-flags-cache-panel", selected: false, href: "#", "aria-label": "Feature Flags Cache") do |t| %>
                  <% t.with_text { "Feature Flags Cache" } %>
                  <% t.with_panel do %>
                    <div class="Box-header">
                      <h3>Cache</h3>
                      <p>
                        <%= "%.0fms" % (FeatureFlag::Cache::MemcachedClient.query_time * 1000) %> total
                        /
                        <%= FeatureFlag::Cache::MemcachedClient.query_count %> count
                        <span class="float-right">
                          * A cached value of nil is counted as a miss here.
                        </span>
                      </p>
                    </div>
                    <div class="Box-body overflow-auto">
                      <table class="width-full">
                        <tr>
                          <th class="text-left">Key</th>
                          <th class="text-right">Set</th>
                          <th class="text-right">Hit*</th>
                          <th class="text-right">Miss*</th>
                        </tr>
                        <% FeatureFlag::Cache::MemcachedClient.query_keys.each do |key, count| %>
                          <tr>
                            <td><%= view.cache_key_utf8_safe(key.inspect) %></td>
                            <td class="text-right"><%= FeatureFlag::Cache::MemcachedClient.query_sets[key] %></td>
                            <td class="text-right"><%= FeatureFlag::Cache::MemcachedClient.query_hits[key] %></td>
                            <td class="text-right"><%= FeatureFlag::Cache::MemcachedClient.query_misses[key] %></td>
                          </tr>
                        <% end %>
                      </table>
                    </div>
                  <% end %>
                <% end %>

                <% c.with_tab(id: "feature-flags-cache-tracer-tab", panel_id: "feature-flags-cache-tracer-panel", selected: false, href: "#", "aria-label": "Feature Flags Cache Tracer") do |t| %>
                  <% t.with_text { "Feature Flags Cache Tracer" } %>
                  <% t.with_panel do %>
                    <div class="Box-header">
                      <h3>Feature Flag Cache Tracer</h3>
                      <p>
                        <%= "%.0fms" % (FeatureFlag::Cache::MemcachedClient.query_time * 1000) %> total
                        /
                        <%= FeatureFlag::Cache::MemcachedClient.query_count %> count
                      </p>
                    </div>
                    <% if FeatureFlag::Cache::MemcachedClient.track_events %>
                      <div class="Box-body overflow-auto">
                        <table class="width-full">
                          <thead>
                            <tr>
                              <th>Key(s)</th>
                              <th>Latency (ms)</th>
                              <th>Operation</th>
                              <th>Site</th>
                              <th>Host(s)</th>
                            </tr>
                          </thead>
                          <% FeatureFlag::Cache::MemcachedClient.query_events.each do |event| %>
                            <% slow = event[:latency] / FeatureFlag::Cache::MemcachedClient.query_time >= 0.10 %>
                            <tr class="<%= slow ? "color-bg-attention" : nil %>">
                              <td>
                                <% if slow %>
                                  <details>
                                    <summary>
                                      <%= view.cache_key_utf8_safe(event[:key]) %>
                                    </summary>
                                    <div class="overflow-auto no-wrap">
                                      <% view.cache_event_formatted_stack_locations(event).each do |location| %>
                                        <a href="<%= location.view_source_url %>" target="_blank" class="Link--muted d-block">
                                          <%= location.description %>
                                        </a>
                                      <% end %>
                                    </div>
                                  </details>
                                <% else %>
                                  <%= view.cache_key_utf8_safe(event[:key]) %>
                                <% end %>
                              </td>
                              <td><%= view.cache_event_formatted_latency(event) %></td>
                              <td><%= event[:operation] %></td>
                              <td><%= event[:site] %></td>
                              <td><%= event[:host] %></td>
                            </tr>
                          <% end %>
                        </table>
                      </div>
                    <% else %>
                      <a href="<%= view.ff_cache_tracer_path %>">Enable feature flag cache tracer</a>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </li>
    <% end %>

    <% if GitHub.external_identity_session_enforcement_enabled? &&
        current_external_identity_sessions.any? %>
      <li>
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-external-identities", title: "External Identities", size: :auto, color: :default)) do |d| %>
          <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do %>
            <strong><%= number_with_delimiter current_external_identity_sessions.size %></strong>
            external <%= "identity".pluralize(current_external_identity_sessions.size) %>
          <% end %>

          <% d.with_header(show_divider: true) do %>
            <p class="color-fg-muted mb-0">
              <%= current_external_identity_sessions.size %> active external <%= "identity".pluralize(current_external_identity_sessions.size) %>
            </p>
          <% end %>

          <% d.with_body(classes: "overflow-auto") do %>
            <table class="width-full">
              <thead>
              <tr>
                <th>Name ID</th>
                <th>Target</th>
                <th>Expires At</th>
              </tr>
              </thead>
              <tbody>
              <% current_external_identity_sessions.each do |session| %>
                <% identity = session.external_identity %>
                <tr>
                <td><%= identity.saml_user_data.name_id %></td>
                <td><%= identity.target %></td>
                <td><%= session.expires_at %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <% if view.process_stat_tracked?(:glb) %>
      <li>
        <%= render(Primer::Alpha::Dialog.new(id: "staffbar-glb-stats", title: "GLB", size: :auto, color: :default)) do |d| %>
          <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white") do %>
            <strong><%= view.glb_regions %></strong>
          <% end %>

          <% d.with_header(show_divider: true) do %>
            <p class="color-fg-muted mb-0">GLB Hosts</p>
          <% end %>

          <% d.with_body(classes: "overflow-auto") do %>
            <pre><%= view.glb_hosts %></pre>
          <% end %>
        <% end %>

        <div id="glb_performance" hidden></div>
      </li>
    <% end %>
  <% end %>

  <%= render partial: "stafftools/staffbar/authz", locals: { view: view } %>
</ul>
