<%# erblint:counter ButtonComponentMigrationCounter 2 %>

<% enterprise = params[:enterprise] || GitHub.single_or_multi_tenant_enterprise? -%>
<section aria-label="Staff Bar" id="serverstats" class="clearfix server-stats <% if site_admin_performance_stats_mode_enabled? %>more-enabled<% end %>">
  <div class="tmp-px-3 clearfix">
      <% if site_admin? || employee? %>
        <% hydro_site_admin = hydro_click_tracking_attributes("staff_bar.site_admin.click", {}) %>
        <a id="staffbar-site-admin-link" class="float-right stafftools-icon js-site-admin-link" href="<%= admin_url %>" data-hotkey="Shift+A" data-hydro-click="<%= hydro_site_admin["hydro-click"] %>" data-hydro-click-hmac="<%= hydro_site_admin["hydro-click-hmac"] %>"><%# herb:disable dotcom-html-data-hotkey %>
          <%= primer_octicon(:rocket) %>
        </a>
        <%= render(Primer::Alpha::Tooltip.new(for_id: "staffbar-site-admin-link", type: :label, text: "Site admin", direction: :sw)) %>
        <% if Rails.env.production? && employee? && site_admin? %>
          <% hydro_spamurai = hydro_click_tracking_attributes("staff_bar.spamurai.click", {}) %>
          <a id="staffbar-spamurai-link" class="float-right stafftools-icon js-spamurai-link" href="<%= Spam::EXTERNAL_SPAMURAI_BASE_URL %>" data-hotkey="Shift+S" data-hydro-click="<%= hydro_spamurai["hydro-click"] %>" data-hydro-click-hmac="<%= hydro_spamurai["hydro-click-hmac"] %>"><%# herb:disable dotcom-html-data-hotkey %>
            <%= primer_octicon(:squirrel) %>
          </a>
          <%= render(Primer::Alpha::Tooltip.new(for_id: "staffbar-spamurai-link", type: :label, text: "Spamurai", direction: :sw)) %>
        <% end %>
      <% elsif GitHub.billing_enabled? && biztools_user? %>
        <% hydro_biztools = hydro_click_tracking_attributes("staff_bar.biztools.click", {}) %>
        <a id="staffbar-biztools-link" class="biztools-briefcase js-site-admin-link" href="<%= biztools_url %>" data-hotkey="Shift+B" data-hydro-click="<%= hydro_biztools["hydro-click"] %>" data-hydro-click-hmac="<%= hydro_biztools["hydro-click-hmac"] %>"><%# herb:disable dotcom-html-data-hotkey %>
          <%= primer_octicon(:briefcase) %>
        </a>
        <%= render(Primer::Alpha::Tooltip.new(for_id: "staffbar-biztools-link", type: :label, text: "Biztools", direction: :s)) %>
      <% end %>

      <%= form_tag site_admin_performance_stats_path, method: :patch do %>
        <% hydro_show_more_stats = hydro_click_tracking_attributes("staff_bar.show_more_stats.click", {from: site_admin_performance_stats_mode_enabled?, to: !site_admin_performance_stats_mode_enabled?}) %>
        <input type="hidden" name="enabled" value="<%= !site_admin_performance_stats_mode_enabled? %>">
        <button type="submit" class="float-right btn-link stats-show-more-stats"
          aria-label="Show more stats" <%= test_selector "site-admin-stats-ellipsis" %> data-hydro-click="<%= hydro_show_more_stats["hydro-click"] %>" data-hydro-click-hmac="<%= hydro_show_more_stats["hydro-click-hmac"] %>">
          <%= primer_octicon(:ellipsis) %>
        </button>
      <% end %>

    <%= render partial: "stafftools/staffbar/stats" %>

    <% if GitHub.kubernetes_backend_available? %>
      <%= form_tag canary_path(toggle: !canary_cookie_enabled?), method: :patch, class: "d-inline ml-1 canary-me #{"enabled" if canary_cookie_enabled?}" do %>
        <% hydro_canary = hydro_click_tracking_attributes("staff_bar.canary_toggle.click", {from: canary_cookie_enabled?, to: !canary_cookie_enabled?}) %>
        <button type="submit" class="btn-link" title="<%= canary_cookie_enabled? ? "Disable" : "Enable" %> canary unicorns" data-hydro-click="<%= hydro_canary["hydro-click"] %>" data-hydro-click-hmac="<%= hydro_canary["hydro-click-hmac"] %>"><%# herb:disable html-no-title-attribute %>
          <img src="<%= image_path "modules/logos/canary-logo.png" %>" width="16" height="16" alt="">
        </button>
      <% end %>
    <% end %>

    <div class="m-0 d-inline-block serverstats-branch">
      <% if Rails.env.development? %>
        <%= render Primer::Beta::Label.new(scheme: :primary, mr: 1, title: "Label: DEVELOPMENT MODE", color: :inherit) do %>
          DEVELOPMENT <% if GitHub.multi_tenant_enterprise? %> | MULTI-TENANT <% end %>
        <% end %>
      <% end %>
      <% if GitHub.role == :lab %>
        <%= render Primer::Beta::Label.new(scheme: :orange, mr: 1, title: "Label: LAB MODE") do %>
          LAB
        <% end %>
      <% end %>
      <% if request.headers["X-GitHub-UI-Pass-Through"] == "true" %>
        <%= render Primer::Beta::Label.new(scheme: :attention, mr: 1, title: "This request was served by dotcom, but passed through the UI Service. You can bypass this by adding `?_ui=false` to the URL") do %>
          Rails via UI
        <% end %>
      <% end %>
      <% if ui_sha_override_active? %>
        <%= render Primer::Beta::Label.new(scheme: :purple) do %>
          <% hydro_ui_preview_commit = hydro_click_tracking_attributes("staff_bar.ui_preview_commit.click", {url: github_ui_commit_url}) %>
          <a class="color-fg-done no-underline" href="<%= github_ui_commit_url %>" target="_blank" rel="noopener noreferrer" aria-label="Go to commit in github-ui" data-hydro-click="<%= hydro_ui_preview_commit["hydro-click"] %>" data-hydro-click-hmac="<%= hydro_ui_preview_commit["hydro-click-hmac"] %>">
            UI PREVIEW
          </a>
          <%= render(Primer::Beta::IconButton.new(
            scheme: :invisible,
            size: :small,
            ml: 0,
            icon: :x,
            id: "clear-github-ui-sha",
            classes: "stafftools-ui-preview-button",
            "aria-label": "Leave UI Preview Mode",
            data: hydro_click_tracking_attributes("staff_bar.ui_preview_commit.clear_click", {})
          )) %>
        <% end %>
      <% end %>
      <% if enterprise? %>
        <%= primer_octicon(:"chevron-right") %>
      <% else %>
        <%= primer_octicon(:"git-branch") %>
      <% end %>
      <span class="current-branch css-truncate expandable">
        <% ref = GitHub.current_ref.dup.force_encoding("UTF-8").scrub!.presence %>
        <% master_ref = ref == "master" %>
        <% unknown_ref = ref == "unknown" %>

        <% current_sha = GitHub.current_sha %>
        <% short_current_sha = current_sha[0, 7].presence %>
        <% is_sha_ref = ref == short_current_sha || ref == current_sha %>

        <% good_ref = ref && !unknown_ref && !is_sha_ref %>

        <% display_sha_link = !master_ref && !unknown_ref && short_current_sha &&
                              Rails.env.production? && !GitHub.enterprise? %>
        <% sha_link = "/github/github/compare/master...#{current_sha}" %>

        <% displayed_sha = false %>
        <% displayed_sha_link = false %>

        <span class="current-branch-name css-truncate-target">
          <% if good_ref %>
            <%= ref %>
          <% elsif display_sha_link %>
            <%= link_to short_current_sha, sha_link, data: hydro_click_tracking_attributes("staff_bar.sha_link.click", {sha: short_current_sha}) %>
            <% displayed_sha = displayed_sha_link = true %>
          <% elsif short_current_sha %>
            <%= short_current_sha %>
            <% displayed_sha = true %>
          <% else %>
            <%= ref %>
          <% end %>
        </span>
        <span class="sha">
          <% if short_current_sha %>
            <% if display_sha_link %>
              <%= link_to short_current_sha, sha_link, data: hydro_click_tracking_attributes("staff_bar.sha_link.click", {sha: short_current_sha}) %>
            <% else %>
              <%= short_current_sha %>
            <% end %>
          <% end %>
        </span>
      </span>

      <%= render GitHubUI::StaffbarVersionComponent.new %>
    </div>

    <% if GitHub.staffbar_service_info_enabled? && controller.respond_to?(:logical_service) %>
      <div class="m-0 d-inline-block serverstats-service">
        <% isKnownService = controller.logical_service != GitHub::Serviceowners::UNKNOWN_SERVICE %>
        <span class="js-catalog-unknown-service" <%= "hidden" if isKnownService %>>
          <%= emoji_tag Emoji.find_by_alias("cat2"), title: "Service Catalog" %>

          <span class="current-service">
            unknown
          </span>
        </span>
        <% hydro_service_catalog = hydro_click_tracking_attributes("staff_bar.service_catalog.click", {}) %>
        <a href="https://app.us.getport.io/artifactEntity?identifier=<%= controller.logical_service %>"
           target="app.us.getport.io"
           class="js-catalog-known-service no-underline"
           <%= "hidden" unless isKnownService %>
           data-hydro-click="<%= hydro_service_catalog["hydro-click"] %>"
           data-hydro-click-hmac="<%= hydro_service_catalog["hydro-click-hmac"] %>">

          <%= emoji_tag Emoji.find_by_alias("cat2"), title: "Service Catalog" %>

          <span class="current-service js-catalog-service-name">
            <%= controller.logical_service %>
          </span>
        </a>
      </div>
    <% end %>

    <% unless GitHub.enterprise? %>
      <div class="m-0 d-inline-block">
        <%= render partial: "stafftools/staffbar/feedback" %>
      </div>
    <% end %>

    <% unless enterprise %>
      <div class="m-0 d-inline-block">
      <%= render(Primer::Alpha::Dialog.new(id: "staffbar-rails-version", title: "Rails #{Rails.version}", size: :auto)) do |d| %>
        <% d.with_show_button(scheme: :link, classes: "stat-toggle color-text-white", data: hydro_click_tracking_attributes("staff_bar.rails_version.click", {})) do %>
          <span class="rails-version">Rails <%= Rails.version %></span>
        <% end %>
        <% d.with_header(show_divider: true) %>
        <% d.with_body do %>
          <h4>Controller and action</h4>
            <%= controller_path %>#<%= action_name %>
          <h4 class="tmp-mt-3">Middleware</h4>
          <ul class="list-style-none tmp-mb-3">
            <% Rails.application.middleware.each do |middleware| %>
              <li><%= middleware.klass %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
      </div>
      <p class="m-0 d-inline-block rails-version" id="staffbar-ruby-version">| Ruby <%= RUBY_VERSION %></p>
      <%= render(Primer::Alpha::Tooltip.new(for_id: "staffbar-ruby-version", type: :description, text: RUBY_REVISION, direction: :s)) %>
      <p class="m-0 d-inline-block rails-version" id="staffbar-react-version"></p>
    <% end %>
  </div>
</section>
