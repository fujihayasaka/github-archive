<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%# erblint:counter DeprecatedInPrimerCounter 2 %>
<% view ||= Stafftools::Staffbar::Stats.new(request: request) %>
<% if view.response_time_stats %>
  <li class="js-pjax-stat" hidden style="line-height: 2.25">
    <%= render Primer::Tooltip.new(label: "PJAX Navigations", direction: :s) do %>
      <%= render Primer::Beta::Label.new(scheme: :success, size: :large) do %>
        ♻️ <span class="js-pjax-count color-fg-on-emphasis">0</span>
      <% end %>
    <% end %>
  </li>
  <li style="line-height: 2.25">
    <%= render Primer::Beta::Label.new(scheme: view.label_scheme, size: :large, classes: "color-text-white") do %>
      <%= render(Primer::Alpha::Dialog.new(
          dialog_id: "staffbar-stats-response-time",
          show_header_divider: true,
          show_footer_divider: false,
          header_variant: :large,
          width: :medium,
          title: "Extended Response Time Details",
          color: :default,
        )) do |c| %>
        <% c.with_show_button(scheme: :link, classes: "color-text-white") do |b| %>
          <% b.with_tooltip(text: "View more response time stats") %>
          <%= view.label_summary %>
        <% end %>
        <% c.with_body do %>
          <% if !GitHub.enterprise? %>
            <div class="mt-3">
              <div>
                <p class="mb-1">
                  <strong>GLB → nginx:</strong> <%= view.glb_to_ngnix_time_stats %>
                </p>
                <p class="mb-1">
                  <strong>nginx queue time:</strong> <%= view.nginx_queued_time_stats %>
                </p>
                <p class="mb-1">
                  <strong>Web server response:</strong> <%= view.response_time_stats %> (alloy: <%= view.alloy_time_stats %>)
                </p>
                <% if view.process_stat_tracked?(:gc) %>
                  <p class="mb-1">
                    <strong>Garbage collection:</strong> <%= view.gc_time %> (<%= view.gc_count_by_type %>)
                  </p>
                <% end %>
              </div>

              <div class="mt-3">
                <p class="mb-1">
                  <strong>Server:</strong> <%= GitHub.local_host_name %>
                </p>
                <p class="mb-0">
                  <strong>Ruby:</strong> <%= RUBY_DESCRIPTION %>
                </p>
              </div>
            </div>
          <% else %>
            <div class="color-fg-muted p-3">
              Extended response time details are not available in enterprise environments.
            </div>
          <% end %>
        <% end %>
      <% end %>

      <%= render Stafftools::SoftNav::SoftNavStaffbarComponent.new %>
      <%= render Stafftools::React::ReactStaffbarComponent.new %>
      <%= render Stafftools::DataHpc::DatahpcStaffbarComponent.new %>
      <% if view.luc? %>
        <strong class="color-text-white">
          [LUC <%= emoji_tag Emoji.find_by_alias("lab_coat"), title: "Using LUC Environment" %>]
        </strong>
      <% end %>
    <% end %>
  </li>
<% end %>
