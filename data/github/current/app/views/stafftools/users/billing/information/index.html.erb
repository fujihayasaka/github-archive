<% page_info container_xl: true %>

<div class="tmp-mb-4">
  <%= render(Primer::Beta::Heading.new(tag: :h1, test_selector: "page-title")) { "Payment Information" } %>
  <%= render(Primer::Beta::Text.new(color: :muted)) { "View billing and shipping information for #{this_user.login}" } %>
</div>

<% if GitHub.billing_enabled? %>
  <div class="Box tmp-mt-3 tmp-mb-3">
    <ul>
      <%= render(Stafftools::Billing::ContactInformationComponent.new(
        customer: this_user.billable_owner.customer,
        contact_type: :billing,
        show_info: params[:show_billing_info] == "true"
      )) %>
      <%= render(Stafftools::Billing::ContactInformationComponent.new(
        customer: this_user.billable_owner.customer,
        contact_type: :shipping,
        show_info: params[:show_shipping_info] == "true"
      )) %>
    </ul>
  </div>

  <%= render(Billing::Stafftools::BillingInformationComponent.new(account: this_user)) %>
<% else %>
  <%= render(Primer::Beta::Blankslate.new) do |component| %>
    <% component.with_visual_icon(icon: :"credit-card") %>
    <% component.with_heading(tag: :h2).with_content("Billing not enabled") %>
    <% component.with_description do %>
      Billing features are not enabled in this environment.
    <% end %>
  <% end %>
<% end %>
