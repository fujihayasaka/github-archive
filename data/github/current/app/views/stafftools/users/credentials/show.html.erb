<% page_info title: "Credentials", selected_link: :stafftools_user_credentials %>

<%= render Primer::Beta::Subhead.new(spacious: true) do |component| %>
  <% component.with_heading(tag: :h2) do %>Credentials<% end %>
<% end %>

<p class="tmp-mb-4">
  View and revoke credentials owned or authorized by
  <strong>@<%= this_user.display_login %></strong>.
</p>

<%= render Stafftools::Users::CredentialsOverviewComponent.new(user: this_user) %>

<%= render Stafftools::Users::CredentialsDangerZoneComponent.new(user: this_user) %>
