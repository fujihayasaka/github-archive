<%# Dotcom Copilot card — dimmed when Licensify is the active source %>
<%= render_fallback_on_error(fallback: render("stafftools/businesses/enterprise_licensing/error_fallback", message: "Could not load Copilot data.")) do %>
  <% dotcom_payload = copilot_overview_react_payload_for_org(organization: this_org) %>
  <% pill_left_offset = dotcom_payload[:isTrial] ? '175px' : '140px' %>
  <div class="position-relative" style="<%= customer_uses_licensify ? 'opacity: 0.4;' : '' %>" <%= test_selector("dotcom-copilot-overview") %>>
    <div class="position-absolute d-flex flex-row gap-2" style="top: 21px; left: <%= pill_left_offset %>; z-index: 1;">
      <%= render Primer::Beta::Label.new(scheme: :secondary) do %>Dotcom<% end %>
      <% if customer_uses_licensify %>
        <%= render Primer::Beta::Label.new(scheme: :secondary) do %>Not shown to customer<% end %>
      <% else %>
        <%= render Primer::Beta::Label.new(scheme: :success) do %>Active for customer<% end %>
      <% end %>
    </div>
    <%= render_react_partial(
      name: "licensing-copilot-overview",
      props: {
        enterpriseContactUrl: ent_contact_url,
        copilot: dotcom_payload,
        slug: this_org.to_param,
        isStafftools: true
      }
    ) %>
  </div>
<% end %>

<%# Licensify Copilot card — dimmed when dotcom is the active source %>
<%= render_fallback_on_error(fallback: render("stafftools/businesses/enterprise_licensing/error_fallback", message: "Could not load Copilot data.")) do %>
  <% licensify_payload = licensify_copilot_overview_react_payload_for_org(organization: this_org) %>
  <% pill_left_offset = licensify_payload[:isTrial] ? '175px' : '140px' %>
  <div class="tmp-mt-3 position-relative" style="<%= customer_uses_licensify ? '' : 'opacity: 0.4;' %>" <%= test_selector("licensify-copilot-overview") %>>
    <div class="position-absolute d-flex flex-row gap-2" style="top: 21px; left: <%= pill_left_offset %>; z-index: 1;">
      <%= render Primer::Beta::Label.new(scheme: :accent) do %>Licensify<% end %>
      <% if customer_uses_licensify %>
        <%= render Primer::Beta::Label.new(scheme: :success) do %>Active for customer<% end %>
      <% else %>
        <%= render Primer::Beta::Label.new(scheme: :secondary) do %>Not shown to customer<% end %>
      <% end %>
    </div>
    <%= render_react_partial(
      name: "licensing-copilot-overview",
      props: {
        enterpriseContactUrl: ent_contact_url,
        copilot: licensify_payload,
        slug: this_org.to_param,
        isStafftools: true,
      }
    ) %>
  </div>
<% end %>
