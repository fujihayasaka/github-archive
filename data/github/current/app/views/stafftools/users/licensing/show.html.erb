<% page_info title: "Licensing", selected_link: :licensing %>

<%= render "stafftools/users/licensing/navigation" %>

<%= render(Primer::Beta::Subhead.new) do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Licensing
  <% end %>
<% end %>

<% if view.account.org_business_plan? %>
  <%= render partial: "orgs/settings/licensing/advanced_security_section", locals: { view: view, target: target, stafftools: true } %>

  <% customer_has_code_quality = show_code_quality_licensify_ui?([view.account.licensed_customer]) %>
  <%= render_fallback_on_error(fallback: render("stafftools/businesses/enterprise_licensing/error_fallback", message: "Could not load Code Quality data.")) do %>
    <div class="position-relative overflow-hidden" style="<%= customer_has_code_quality ? '' : 'opacity: 0.4;' %>" <%= test_selector("licensify-code-quality-overview") %>>
      <div class="position-absolute d-flex flex-row gap-2" style="top: 21px; left: 175px; z-index: 1;">
        <%= render Primer::Beta::Label.new(scheme: :accent) do %>Licensify<% end %>
        <% if customer_has_code_quality %>
          <%= render Primer::Beta::Label.new(scheme: :success) do %>Active for customer<% end %>
        <% else %>
          <%= render Primer::Beta::Label.new(scheme: :secondary) do %>Not shown to customer<% end %>
        <% end %>
      </div>
      <%= render_react_partial(
        name: "licensing-code-quality-overview",
        props: {
          codeQuality: licensify_code_quality_overview_react_payload_for_org(organization: view.account),
          slug: view.account.display_login,
          isStafftools: true,
        }
      ) %>
    </div>
  <% end %>
<% end %>
<%= render partial: "orgs/settings/licensing/copilot_section", locals: { view: view, target: view.account } %>
<% customer_uses_licensify = customer_has_licensify_copilot_ui?(view.account.licensed_customer, business: view.account.business) %>
<%= render partial: "stafftools/users/licensing/copilot_stafftools_overview", locals: { this_org: view.account, customer_uses_licensify: customer_uses_licensify } %>

<%= render partial: "orgs/settings/licensing/current_plan_section", locals: { view: view } %>

<%= render "billing_settings/github_usage_section", view: view, is_stafftools_route: defined?(is_stafftools_route) ? is_stafftools_route : false, target: view.account, is_trial_expired: false %>


