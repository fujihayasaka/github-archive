<%= render(Primer::Alpha::Dialog.new(
  title: title,
  id: "#{title.parameterize}-dialog",
  size: :medium_portrait,
  disable_scroll: true,
  )) do |c| %>
  <% c.with_show_button(scheme: :link, color: :default) do %>
    <%= sms_registration.sms_number %>
  <% end %>
  <% c.with_header(show_divider: true) %>
  <% c.with_body do %>
    <table class="stafftools-table security-history-detail">
      <tr>
        <th>SMS number</th>
        <td><%= sms_registration.sms_number %></td>
      </tr>
      <tr>
        <%
          sms_country_code = GitHub::TwoFactorAuthentication.sms_country_code(sms_registration.sms_number)
          sms_countries = GitHub::TwoFactorAuthentication.sms_country_names_for_code(sms_country_code)
        %>
        <th>Country Code</th>
        <td>
        <p>
          <%= sms_countries.join(", ") %>
        </p>
          <% if sms_countries.length > 1 %>
            <br>
            <p class="note">Note: This country code is mapped to different countries.</p>
          <% end %>
        </td>
      </tr>
      <tr>
        <th>SMS provider</th>
        <td><%= sms_registration.sms_provider %></td>
      </tr>
      <tr>
        <th>Available providers</th>
        <td>
          <p>
            <%= GitHub::Messaging.available_providers(sms_country_code).join(", ") %>
          </p>
        </td>
      </tr>
      <tr>
        <th>Consecutive Missed OTP Count</th>
        <td><%= sms_registration.consecutive_missed_otp_count %></td>
      </tr>
      <tr>
        <th>Last OTP Sent At</th>
        <td><%= sms_registration.last_otp_sent_at %></td>
      </tr>
      <tr>
        <th>Last OTP Success At</th>
        <td><%= sms_registration.last_otp_success_at %></td>
      </tr>
      <tr>
        <th>Created At</th>
        <td><%= sms_registration.created_at %></td>
      </tr>
      <tr>
        <th>Last Used At</th>
        <td><%= sms_registration.last_used_at %></td>
      </tr>
    </table>
  <% end %>
<% end %>
