<% page_info title: "User Spark Workbenches", selected_link: :sparks %>


<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h3) do %>
      Spark Workbenches
    <% end %>
  <% end %>

  <% component.with_row do %>
    <% if sparks.any? %>
      <ul class="list-style-none">
        <% sparks.each do |spark| %>
          <%= render partial: "stafftools/users/sparks/spark", locals: { spark: spark } %>
        <% end %>
      </ul>
    <% else %>
      <p>This account has no defined Spark Workbenches.</p>
    <% end %>
  <% end %>
<% end %>
