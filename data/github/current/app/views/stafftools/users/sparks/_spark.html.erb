<li class="Box-row py-4">
  <span class="float-right">
    <%= render(Primer::Experimental::Dialog.new(
      dialog_id: "delete-user-spark-#{spark.uuid_string}-dialog",
      width: :large,
      title: "Delete Spark?",
      form_url: stafftools_user_spark_path(this_user, id: spark.uuid_string),
      form_method: :delete,
      data: { "test-selector": "delete-user-spark-#{spark.uuid_string}-dialog" }
    )) do |d| %>
      <% d.with_show_button(
        color: :danger,
        float: :right,
      ) { "Delete" }%>
      <% d.with_body do %>
        <p>
          This will remove and unpublish this Spark.
        </p>
      <% end %>
      <% d.with_button(
        data: { "close-dialog-id": "delete-user-spark-#{spark.uuid_string}-dialog" }
      ) { "Cancel" } %>
      <% d.with_button(
        type: :submit,
        scheme: :danger,
        data: { "disable-with": "" }
      ) { "Delete" } %>
    <% end %>
  </span>

  <code class="mr-2"><%= spark.uuid_string %></code>

  <span class="application-name Truncate">
    <span class="Truncate-text"><%= spark.name %></span>
  </span>

  <span class="Truncate">
    <span class="Truncate-text"><%= spark.description %></span>
  </span>
</li>
