<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% page_info title: "Renaming #{old_login}…" %>

<%= render GitHub::PollIncludeFragmentComponent.new(src: stafftools_user_rename_status_path(user.id)) do %>
  <%= render Primer::BlankslateComponent.new(
    title: "Renaming #{old_login} to #{new_login}…",
    description: "This may take a few minutes to complete.",
    large: true,
    spacious: true,
  ) do |component| %>
    <% component.with_spinner(size: :large) %>
  <% end %>
<% end %>
