<%
  page_info title: "#{this_user.login} - Actions"
%>
<% unless GitHub.enterprise? %>
  <div class="Box Box--condensed mt-3">
    <div class="Box-header">
      <h3 class="Box-title">
        Restore Actions Billing Owner
      </h3>
    </div>
      <ul>
        <li class="Box-row pt-2">
          <% if !this_user.spammy? %>
            <%= form_tag stafftools_actions_restore_billing_owner_path(this_user), method: :post do %>
              <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, float: :right, ml: 2) do %>Restore Billing Owner<% end %>
            <% end %>
            <p>This should resolve the error "Billing Owner (User or Organization) is deleted".</p>
          <% else %>
            <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, float: :right, ml: 2, disabled: true) do %>Restore Billing Owner<% end %>
            <p>This user is spammy and cannot be restored.</p>
          <% end %>
        </li>
      </ul>
  </div>

  <div class="Box Box--condensed mt-3">
    <div class="Box-header">
      <h3 class="Box-title">
        Immutable Actions opt-out
      </h3>
    </div>
      <ul>
        <li class="Box-row pt-2">
          <div class="d-flex flex-justify-between flex-items-center">
            <% if ImmutableActionsOptOut.where(workflow_repo_owner_id: this_user.id).exists? %>
              <div>
                <%= render Primer::Beta::Octicon.new(icon: "x-circle-fill", color: :danger, mr: 1) %>
                This user is opted out of immutable actions for self-hosted and larger runners.
              </div>
              <div class="d-flex flex-justify-end position-relative">
                <%= form_tag stafftools_actions_opt_out_of_immutable_actions_for_self_hosted_runners_path(this_user), method: :post do %>
                  <input type="hidden" name="opt_out_new_state" value="false">
                  <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, float: :right, ml: 2) do %>Opt in<% end %>
                <% end %>
              </div>
            <% else %>
              <div>
                <%= render Primer::Beta::Octicon.new(icon: "check-circle-fill", color: :success, mr: 1) %>
                This user is NOT opted out of immutable actions for self-hosted and larger runners.
              </div>
              <div class="d-flex flex-justify-end position-relative">
                <%= form_tag stafftools_actions_opt_out_of_immutable_actions_for_self_hosted_runners_path(this_user), method: :post do %>
                  <input type="hidden" name="opt_out_new_state" value="true">
                  <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, float: :right, ml: 2) do %>Opt out<% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </li>
      </ul>
  </div>
<% end %>
