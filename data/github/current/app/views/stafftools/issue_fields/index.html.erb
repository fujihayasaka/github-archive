
<%= render(Primer::Beta::BorderBox.new(mt: 5)) do |component| %>
  <% component.with_header do %>
    <%= render(Primer::Beta::Heading.new(tag: :h3)) { "Issue Fields owned by \"#{owner.login}\"" } %>
  <% end %>

  <% component.with_row do %>
    <%= render(Primer::Box.new(display: :flex)) do %>
      <%= render(Primer::Box.new(style: "flex: 1", font_weight: :bold)) { "Number of Issue Fields" } %>
      <%= render(Primer::Box.new(style: "flex: 2", word_break: :break_all)) do %>
        <%= issue_field_ids.count %>
      <% end %>
    <% end %>
  <% end %>
  <% component.with_row do %>
    <%= render(Primer::Box.new(display: :flex)) do %>
      <%= render(Primer::Box.new(style: "flex: 1", font_weight: :bold)) { "Issue Fields in Projects" } %>
      <%= render(Primer::Box.new(style: "flex: 2", word_break: :break_all)) do %>
        <%= issue_fields_in_projects.count %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(mt: 5)) do |component| %>
  <% component.with_header do %>
    <%= render(Primer::Beta::Heading.new(tag: :h3)) { "Actions" } %>
  <% end %>
  <% component.with_row do %>
    <%= render(Primer::Box.new(display: :flex)) do %>
      <%= render(Primer::Box.new(style: "flex: 4")) do %>
        <%= render(Primer::Beta::Heading.new(tag: :h4)) { "Re-sync Issue Fields to Project Columns" } %>
        <%= render(Primer::Box.new) do %>
          This action will re-sync all issue fields referenced in Project Columns within this Org's projects.
        <% end %>
      <% end %>
      <%= render(Primer::Box.new(style: "flex: 1")) do %>
        <%= form_with url: resync_issue_fields_stafftools_user_planning_issue_fields_path(owner), method: :patch do  %>
          <%= render(Primer::Beta::Button.new(type: :submit)) { "Re-sync Fields" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
