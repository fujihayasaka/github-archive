<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%
  page_info title: "#{this_user.login} - Actions"
%>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Actions<% end %>
<% end %>

<% if this_user.action_invocation_blocked? %>
  <% if FeatureFlag.vexi.enabled?(:banner_migration, current_user, default: false) %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, mt: 2, icon: "alert", test_selector: "actions-invocation-blocked-user", classes: "tmp-mb-4")) do %>
      Action invocation is blocked on this organization. Visit the <a class="Link--inTextBlock" href="<%= stafftools_user_administrative_tasks_path(this_user)%>">admin page</a> for more information.
    <% end %>
  <% else %>
    <%= render(Primer::Beta::Flash.new(scheme: :danger, mt: 2, icon: "alert", test_selector: "actions-invocation-blocked-user", classes: "tmp-mb-4")) do %>
      Action invocation is blocked on this organization. Visit the <a class="Link--inTextBlock" href="<%= stafftools_user_administrative_tasks_path(this_user)%>">admin page</a> for more information.
    <% end %>
  <% end %>
<% end %>

<!-- Org level billing info -->
<% if GitHub.billing_enabled? %>
  <div class="Box Box--condensed tmp-mt-3">
    <div class="Box-header">
      <h3 class="Box-title">
        Concurrency
      </h3>
    </div>
    <ul>
      <% if defined?(in_business) && in_business %>
        <li class="Box-row">
          <div class="Box Box--danger">
            <div class="Box-body text-bold" <%= test_selector "parent-enterprise-concurrency-notice" %>>
              To manage this organization's concurrency limits, see the parent enterprise
              <%= link_to parent_business.name, stafftools_actions_path(parent_business), class: "Link--inTextBlock" %>.
            </div>
          </div>
        </li>
      <% else %>
        <li class="Box-row">
          <div class="summary">
            <dl>
              <dt class="tmp-mr-5"><b>GitHub plan</b></dt>
              <dd><%= plan_name %></dd>
            </dl>
            <dl>
              <dt class="tmp-mr-5"><b>Trust Tier</b></dt>
              <dd>
                <%= render Primer::Beta::Label.new(scheme: trust_tier == 1 ? :success : trust_tier == 2 ? :attention : :danger) do %>
                  Tier <%= trust_tier %> - <%= trust_tier_name %>
                <% end %>
              </dd>
            </dl>
            <dl>
              <dt class="tmp-mr-5"><b>Total concurrent jobs</b></dt>
              <dd><%= concurrency_limits&.dig(:total) || max_concurrent_jobs %><% unless concurrency_limits.present? %><sup>*</sup><% end %></dd>
            </dl>
            <dl>
              <dt class="tmp-mr-5"><b>Maximum concurrent macOS jobs</b></dt>
              <dd><%= concurrency_limits&.dig(:macos) || max_concurrent_macos_jobs %><% unless concurrency_limits.present? %><sup>*</sup><% end %></dd>
            </dl>
            <% unless concurrency_limits.present? %>
              <p><sup>*</sup>We calculate these numbers from the plan based on <a class="Link--inTextBlock" href="https://docs.github.com/actions/reference/usage-limits-billing-and-administration#usage-limits">documentation</a> and they may be outdated or overridden for this organization.</p>
            <% end %>
          </div>
        </li>
      <% end %>
      <% unless defined?(in_business) && in_business %>
        <li class="Box-row">
          <details>
            <%= render(Primer::Beta::Button.new(tag: :summary, size: :small)) do %>
              Update concurrency limits
            <% end %>
            <div class="tmp-mt-3">
              <%= form_tag stafftools_actions_update_concurrency_limits_path(this_user), method: :post, class: "width-full" do %>
                <div class="form-group">
                  <div class="form-group-header">
                    <label for="total_limit">Total concurrent jobs</label>
                  </div>
                  <div class="form-group-body">
                    <%= number_field_tag :total_limit, concurrency_limits&.dig(:total) || max_concurrent_jobs,
                        min: 0, max: max_concurrent_jobs * 2, class: "form-control input-sm", style: "width: 200px;", autocomplete: "off" %>
                    <p class="note">Maximum allowed: <%= max_concurrent_jobs * 2 %> (2x plan-based limit). Set to 0 to disable.</p>
                  </div>
                </div>
                <div class="form-group">
                  <div class="form-group-header">
                    <label for="macos_limit">Maximum concurrent macOS jobs</label>
                  </div>
                  <div class="form-group-body">
                    <%= number_field_tag :macos_limit, concurrency_limits&.dig(:macos) || max_concurrent_macos_jobs,
                        min: 0, max: max_concurrent_macos_jobs, class: "form-control input-sm", style: "width: 200px;", autocomplete: "off" %>
                    <p class="note">Maximum allowed: <%= max_concurrent_macos_jobs %> (plan-based limit, can only be decreased). Set to 0 to disable.</p>
                  </div>
                </div>
                <%= render(Primer::Alpha::Banner.new(scheme: :warning, classes: "tmp-mb-3")) do %>
                  <strong>Need higher concurrency limits?</strong> To request an increase beyond the maximum limits shown above,
                  please follow the process documented in the
                  <a href="https://github.com/github/support-knowledge-base/blob/main/docs/support/c2c/actions/requesting-concurrency-increase.md" target="_blank" class="Link--inTextBlock">
                    concurrency increase request guide
                  </a>.
                <% end %>
                <div class="form-actions">
                  <%= render(Primer::Beta::Button.new(type: :submit)) do %>
                    Update Limits
                  <% end %>
                </div>
              <% end %>
            </div>
          </details>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="Box Box--condensed tmp-mt-3">
    <div class="Box-header">
      <h3 class="Box-title">
        Metered billing
      </h3>
    </div>
  </div>
<% end %>

<%# Org level actions general settings%>
<% if !GitHub.enterprise? %>
<div class="Box Box--condensed tmp-mt-3">
  <div class="Box-header">
    <h3 class="Box-title">
      Actions General Settings
    </h3>
  </div>
  <ul>
    <li class="Box-row">
      <div class="clearfix summary my-0">
        <% actions_general_settings.each do |key, value| %>
        <dl>
          <dt style="width: 50%"><%=key%></dt>
          <dd><%=value%></dd>
        </dl>
        <% end %>
      </div>
    </li>
  </ul>
</div>
<% end %>

<%# Actions Four Nines Onboarding info %>
<div class="tmp-mt-5">
  <%= render(Actions::FourNinesInfoComponent.new(account: this_user)) %>
</div>

<%# Larger-hosted runners Onboarding info %>
<div class="tmp-mt-5">
  <%= render(Actions::LargerRunnersOnboardingInfoComponent.new(owner: this_user)) %>
</div>

<%# Org level secrets %>
<div class="Box Box--condensed tmp-mt-3">
  <div class="Box-header">
    <h3 class="Box-title">
      Secrets
    </h3>
  </div>
  <ul>
    <li class="Box-row">
      <% if secrets.any? %>
        <table class="stafftools-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Availability</th>
              <th>Created At</th>
              <th>Updated At</th>
            </tr>
          </thead>
          <% secrets.each do |secret| %>
            <tr>
              <td class="wb-break-all"><%= secret[:name] %></td>
              <td class="wb-break-all"><%= secret[:visibility_description] %></td>
              <td><%= time_ago_in_words_js(secret[:created_at]) %></td>
              <td><%= time_ago_in_words_js(secret[:updated_at]) %></td>
            </tr>
          <% end %>
        </table>
      <% else %>
        <%= render Primer::Beta::Blankslate.new do |c| %>
          <% c.with_heading(tag: :h2) do %>
            There are no secrets for this organization.
          <% end %>
        <% end %>
      <% end%>
    </li>
  </ul>
</div>

<%#  Org level variables %>
<div class="Box Box--condensed tmp-mt-3">
  <div class="Box-header">
    <h3 class="Box-title">
      Variables
    </h3>
  </div>
  <ul>
    <li class="Box-row">
      <% if variables.any? %>
        <table class="stafftools-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Value</th>
              <th>Availability</th>
              <th>Created At</th>
              <th>Updated At</th>
            </tr>
          </thead>
          <% variables.each do |variable| %>
            <tr>
              <td class="wb-break-all"><%= variable[:name] %></td>
              <td class="wb-break-all"><%= Base64.strict_decode64(variable[:value]) %></td>
              <td><%= variable[:visibility_description] %></td>
              <td><%= time_ago_in_words_js(variable[:created_at]) %></td>
              <td><%= time_ago_in_words_js(variable[:updated_at]) %></td>
            </tr>
          <% end %>
        </table>
      <% else %>
        <%= render Primer::Beta::Blankslate.new do |c| %>
          <% c.with_heading(tag: :h2) do %>
            There are no variables for this organization.
          <% end %>
        <% end %>
      <% end%>
    </li>
  </ul>
</div>

<% if runner_groups.none? %>
<div class="Box Box--condensed tmp-mt-3">
   <div class="Box-header">
    <h3 class="Box-title">
      Runner Groups
    </h3>
  </div>
  <%= render Primer::Beta::Blankslate.new do |c| %>
    <% c.with_heading(tag: :h2) do %>
      There are no runner groups configured for this organization.
    <% end %>
  <% end %>
</div>
<% else %>
  <div class="tmp-mt-5">
    <%= render(Actions::RunnerGroupsComponent.new(
      owner: this_user,
      owner_settings: Actions::OrgRunnersView.new(settings_owner: this_user, current_user: current_user),
      runner_groups: runner_groups,
      can_create_groups: false,
      can_update_groups: false,
      can_manage_runners: false,
    )) %>
  </div>
<% end %>

<% if runners.none? %>
  <div class="Box Box--condensed tmp-mt-3">
    <div class="Box-header">
      <h3 class="Box-title">
        Runners
      </h3>
    </div>
    <%= render Primer::Beta::Blankslate.new do |c| %>
      <% c.with_heading(tag: :h2) do %>
        There are no runners configured for this organization.
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="tmp-mt-5">
    <%= render(Stafftools::ActionsRunners::RunnersListComponent.new(
      runners: runners,
      business: this_user,
      hosted_runner_group: hosted_runner_group,
      viewing_from_a_repository: false)
    ) %>
  </div>
<% end %>

<% unless GitHub.enterprise? %>
  <div class="Box Box--condensed tmp-mt-3">
    <div class="Box-header">
      <h3 class="Box-title">
        Restore Actions Billing Owner
      </h3>
    </div>
      <ul>
        <li class="Box-row pt-2">
          <% if !this_user.spammy? %>
            <%= form_tag stafftools_actions_restore_billing_owner_path(this_user), method: :post do %>
              <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, float: :right, ml: 2) do %>Restore Billing Owner<% end %>
            <% end %>
            <p>This should resolve the error "Billing Owner (User or Organization) is deleted".</p>
          <% else %>
            <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, float: :right, ml: 2, disabled: true) do %>Restore Billing Owner<% end %>
            <p>This user is spammy and cannot be restored.</p>
          <% end %>
        </li>
      </ul>
  </div>

  <div class="Box Box--condensed tmp-mt-3">
    <div class="Box-header">
      <h3 class="Box-title">
        Immutable Actions opt-out
      </h3>
    </div>
      <ul>
        <li class="Box-row pt-2">
          <div class="d-flex flex-justify-between flex-items-center">
            <% if ImmutableActionsOptOut.where(workflow_repo_owner_id: this_user.id).exists? %>
              <div>
                <%= render Primer::Beta::Octicon.new(icon: "x-circle-fill", color: :danger, mr: 1) %>
                This organization is opted out of immutable actions for self-hosted and larger runners.
              </div>
              <div class="d-flex flex-justify-end position-relative">
                <%= form_tag stafftools_actions_opt_out_of_immutable_actions_for_self_hosted_runners_path(this_user), method: :post do %>
                  <input type="hidden" name="opt_out_new_state" value="false">
                  <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, float: :right, ml: 2) do %>Opt in<% end %>
                <% end %>
              </div>
            <% else %>
              <div>
                <%= render Primer::Beta::Octicon.new(icon: "check-circle-fill", color: :success, mr: 1) %>
                This organization is NOT opted out of immutable actions for self-hosted and larger runners.
              </div>
              <div class="d-flex flex-justify-end position-relative">
                <%= form_tag stafftools_actions_opt_out_of_immutable_actions_for_self_hosted_runners_path(this_user), method: :post do %>
                  <input type="hidden" name="opt_out_new_state" value="true">
                  <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, float: :right, ml: 2) do %>Opt out<% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </li>
      </ul>
  </div>

<% end %>
