<%# Credential counts for organization - loaded asynchronously %>

<% capped_count = number_to_human(
  Organization::CredentialAuthorizationDependency::COUNT_LIMIT,
  precision: 0,
  format: "%n%u",
  units: { thousand: "k", million: "M" }
) %>

<%# Credential type display metadata %>
<% credential_types = [
  {
    key: :fine_grained_pats,
    title: "Fine-grained personal access tokens",
    description: "The fine-grained personal access tokens that have access to this organization.",
    unit: "token",
  },
  {
    key: :classic_pats,
    title: "Personal access tokens (classic)",
    description: "The personal access tokens (classic) that have access to this organization.",
    unit: "token",
  },
  {
    key: :ssh_keys,
    title: "SSH keys",
    description: "The SSH keys that have access to this organization.",
    unit: "key",
  },
  {
    key: :oauth_tokens,
    title: "GitHub App and OAuth app user access tokens",
    description: "GitHub App and OAuth app user access tokens that have access to this organization.",
    unit: "token",
  },
] %>

<div class="border rounded-2 overflow-hidden">
  <% if timed_out %>
    <div class="Box-row">
      <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
        Unable to load credential counts. The query timed out due to the large number of credentials in this organization.
      <% end %>
    </div>
  <% else %>
    <% credential_types.each do |cred_type| %>
      <% cred = counts[cred_type[:key]] %>
      <div class="Box-row d-flex flex-items-center flex-justify-between">
        <div class="flex-auto">
          <h4 class="h5 mb-1"><%= cred_type[:title] %></h4>
          <p class="color-fg-muted mb-0 f6">
            <%= cred_type[:description] %>
          </p>
        </div>
        <div class="tmp-ml-3">
          <span class="text-bold">
            <% if cred[:capped] %>
              <%= capped_count %>+ <%= cred_type[:unit].pluralize %>
            <% else %>
              <%= pluralize(cred[:count], cred_type[:unit]) %>
            <% end %>
          </span>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
