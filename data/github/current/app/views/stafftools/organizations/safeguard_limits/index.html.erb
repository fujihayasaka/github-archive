<% page_info title: "Safeguard limits", selected_link: :safeguard_limits %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h2) do %>Safeguard limits<% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(
  padding: :condensed,
  test_selector: "safeguard-limits-list"
) do |box| %>
  <% box.with_row do %>
    <%= link_to "Organization limits", stafftools_user_organization_limits_path(this_user) %>
  <% end %>

  <% box.with_row do %>
    <%= link_to "Organization team limits", stafftools_user_organization_team_limits_path(this_user) %>
  <% end %>
<% end %>
