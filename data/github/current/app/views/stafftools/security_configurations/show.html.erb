<%= page_info title: "Security configuration details • #{owner.display_login}" %>

<%= render Primer::Beta::Heading.new(tag: :h2, classes: "tmp-mb-4") do %>
  <%= render Primer::Beta::Breadcrumbs.new do |component| %>
    <% if owner.is_a?(Business) %>
      <% component.with_item(href: security_configurations_stafftools_enterprise_path(owner)) { "Security configurations" } %>
      <% component.with_item(href: security_configuration_stafftools_enterprise_path(owner, security_configuration)) { security_configuration.name } %>
    <% else %>
      <% component.with_item(href: security_configurations_stafftools_user_path(owner)) { "Security configurations" } %>
      <% component.with_item(href: security_configuration_stafftools_user_path(owner, security_configuration)) { security_configuration.name } %>
    <% end %>
  <% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(padding: :condensed, mb: 2) do |component| %>
  <% component.with_header(font_weight: :bold) { "Details" } %>
  <% component.with_row(test_selector: "config_name") do %>
    <%= content_tag :b, "Name:" %>
    <%= security_configuration.name %>
  <% end %>
  <% component.with_row(test_selector: "config_type") do %>
    <%= content_tag :b, "Type:" %>
    <%= security_configuration.type == "UnbundledSecurityConfiguration" ? "Unbundled" : "Bundled" %>
  <% end %>
  <% component.with_row(test_selector: "config_description") do %>
    <%= content_tag :b, "Description:" %>
    <%= security_configuration.description %>
  <% end %>
  <%# Only show bundle/unbundle when there's a mismatch between config type and billing state %>
  <% if owner.is_a?(Business) && !security_configuration.global? %>
    <% is_unbundled_config = !security_configuration.bundled? %>
    <% is_unbundled_billing = !owner.advanced_security_products_bundled_for_entity? %>
    <% if is_unbundled_config != is_unbundled_billing %>
      <% component.with_row(test_selector: "bundle_unbundle_action") do %>
        <%= content_tag :b, "Configuration Mismatch:" %>
        <% if is_unbundled_config && !is_unbundled_billing %>
          <span class="color-fg-attention">This is an unbundled configuration but the enterprise has bundled GHAS billing.</span>
          <br><br>
          <%= button_to "Bundle Configuration",
              security_configuration_bundle_stafftools_enterprise_path(owner, security_configuration_id: security_configuration.id),
              method: :post,
              class: "btn btn-sm btn-danger",
              data: { confirm: "Are you sure you want to bundle this security configuration? This will enable bundled GHAS and disable Code Security and Secret Protection SKUs." } %>
        <% else %>
          <span class="color-fg-attention">This is a bundled configuration but the enterprise has unbundled (Code Security + Secret Protection) billing.</span>
          <br><br>
          <%= button_to "Unbundle Configuration",
              security_configuration_unbundle_stafftools_enterprise_path(owner, security_configuration_id: security_configuration.id),
              method: :post,
              class: "btn btn-sm btn-danger",
              data: { confirm: "Are you sure you want to unbundle this security configuration? This will convert it to use Code Security and Secret Protection SKUs." } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(padding: :condensed, mb: 2) do |component| %>
  <% component.with_header(font_weight: :bold) { "Advanced Security" } %>
  <% component.with_row(test_selector: "feature_enable_ghas_status") do %>
    <%= content_tag :b, "Bundled GHAS enabled?" %>
    <%= security_configuration.enable_ghas(billable_entity:) ? "Yes" : "No" %>
  <% end %>
  <% component.with_row(test_selector: "feature_enable_cs_status") do %>
    <%= content_tag :b, "Code Security SKU enabled?" %>
    <%= security_configuration.display_sku_state(security_configuration.code_security_sku_enabled(billable_entity:)) %>
  <% end %>
  <% component.with_row(test_selector: "feature_enable_sp_status") do %>
    <%= content_tag :b, "Secret Protection SKU enabled?" %>
    <%= security_configuration.display_sku_state(security_configuration.secret_protection_sku_enabled(billable_entity:)) %>
  <% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(padding: :condensed, mb: 2) do |component| %>
  <% component.with_header(font_weight: :bold) { "Features" } %>
  <% SecurityConfiguration::ALL_FEATURES.each do |feature| %>
    <% component.with_row(test_selector: "feature_#{feature}_status") do %>
      <%= content_tag :b, "#{feature.to_s.titleize}:" %>
      <% if security_configuration.attributes[feature.to_s] != nil %>
        <%= security_configuration.attributes[feature.to_s].humanize %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(padding: :condensed, mb: 2) do |component| %>
  <% component.with_header(font_weight: :bold) { "Policy" } %>
  <% component.with_row(test_selector: "policy_enforced") do %>
    <%= content_tag :b, "Enforced?" %>
    <%= security_configuration.enforced?(owner) ? "Yes" : "No" %>
  <% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(padding: :condensed, mb: 2) do |component| %>
  <% component.with_header(font_weight: :bold) { "Repository application counts" } %>
  <% if repo_application_counts.present? %>
    <% repo_application_counts.each do |state, count| %>
      <% component.with_row(test_selector: "repos_#{state}_count") do %>
        <%= state.titleize %>: <%= ActiveSupport::NumberHelper.number_to_delimited(count) %>
      <% end %>
    <% end %>
  <% else %>
    <% component.with_row.with_content("This configuration has not been applied to any repositories.") %>
  <% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(padding: :condensed, mb: 2) do |component| %>
  <% component.with_header(font_weight: :bold) { "Audit logs" } %>
  <% component.with_row(test_selector: "audit_logs_all_events") do %>
    <%= content_tag :b, "All events for this configuration:" %>
    <% if owner.business? %>
      <%= link_to "View", stafftools_audit_log_path(query: "webevents | where business_id == #{owner.id} and data.security_configuration_id == '#{security_configuration.id}'") %>
    <% else %>
      <%= link_to "View", stafftools_audit_log_path(query: "webevents | where org == '#{owner.display_login}' and data.security_configuration_id == '#{security_configuration.id}'") %>
    <% end %>
  <% end %>
  <% component.with_row(test_selector: "audit_logs_update_events") do %>
    <%= content_tag :b, "Configuration updates:" %>
    <% if owner.business? %>
      <%= link_to "View", stafftools_audit_log_path(query: "webevents | where business_id == #{owner.id} and data.security_configuration_id == '#{security_configuration.id}' and action == 'security_configuration.update'") %>
    <% else %>
      <%= link_to "View", stafftools_audit_log_path(query: "webevents | where org == '#{owner.display_login}' and data.security_configuration_id == '#{security_configuration.id}' and action == 'security_configuration.update'") %>
    <% end %>
  <% end %>
  <% component.with_row(test_selector: "audit_logs_repo_events") do %>
    <%= content_tag :b, "Repo applied or failed events for this configuration:" %>
    <% if owner.business? %>
      <%= link_to "View", stafftools_audit_log_path(query: "webevents | where business_id == #{owner.id} and data.security_configuration_id == '#{security_configuration.id}' and (action == 'repository_security_configuration.applied' or action == 'repository_security_configuration.failed')") %>
    <% else %>
      <%= link_to "View", stafftools_audit_log_path(query: "webevents | where org == '#{owner.display_login}' and data.security_configuration_id == '#{security_configuration.id}' and (action == 'repository_security_configuration.applied' or action == 'repository_security_configuration.failed')") %>
    <% end %>
  <% end %>
  <% component.with_row(test_selector: "audit_logs_reference_docs") do %>
    <%= content_tag :b, "Audit log reference documentation:" %>
    <%= link_to "View", "https://github.com/github/security-products-enablement/blob/main/docs/playbook-audit-logs.md", target: "_blank", rel: "noopener" %>
  <% end %>
<% end %>
