<%#
  Renders a danger zone button to delete deactivated licenses for a customer.

  Parameters:
    customer_id: [Integer, String] The customer ID to delete licenses for
    dom_id_base: [String, Object] Base object/string for generating unique DOM IDs (default: "delete_deactivated_licenses")
    col_class: [String] Optional column width class (e.g., "col-6", "col-7") for the label section
%>
<% dom_id_base ||= "delete_deactivated_licenses" %>
<% col_class ||= "col-7" %>

<div class="Box-row">
  <div class="form-group d-flex mt-0">
    <div class="d-flex flex-column <%= col_class %>">
      <label>Delete deactivated licenses</label>
      <span class="note">
        Delete deactivated licenses for a specific product from Licensify, this may be needed to prevent continued billing for licenses that should not have been billed for in the first place and were deactivated by a backfill.
      </span>
    </div>
    <div class="d-flex flex-1 flex-justify-center flex-column">
      <%= render(Primer::Alpha::Dialog.new(
        title: "Delete deactivated licenses",
        id: dom_id(dom_id_base, :delete_deactivated_licenses),
        size: :medium_portrait,
      )) do |dialog| %>
        <% dialog.with_show_button(
          scheme: :danger,
          block: true
        ) { "Delete deactivated licenses" } %>
        <%= form_with(url: delete_deactivated_licenses_stafftools_customer_licensify_licenses_path(customer_id), method: :post) do |f| %>
          <%= render(Primer::Alpha::Dialog::Body.new) do %>
            <div class="form-group">
              <div class="form-group-header">
                <%= label_tag "product", "Product", class: "d-block mb-1" %>
                <p class="note">Select the product for which to delete deactivated licenses.</p>
              </div>
              <%= select_tag "product",
                options_for_select([
                  ["Bundled GHAS", "ghas"],
                  ["Code Security", "code_security"],
                  ["Secret Protection", "secret_protection"],
                  ["SDLC", "sdlc"],
                  ["Copilot", "copilot"],
                  ["Code Quality", "code_quality"],
                ]),
                class: "form-select",
                required: true
              %>
            </div>
          <% end %>

          <%= render(Primer::Alpha::Dialog::Footer.new) do %>
            <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": dom_id(dom_id_base, :delete_deactivated_licenses) })) { "Cancel" } %>
            <%= render(Primer::Beta::Button.new(type: :submit, scheme: :danger)) { "Delete" } %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
