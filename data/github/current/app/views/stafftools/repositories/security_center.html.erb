<%= render(Primer::Beta::Subhead.new(hide_border: true, spacious: true)) do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Analytics
    <span class="Subhead-actions f6">
      <% if analytics_data[:eligible?] %>
        <%= primer_octicon(:check, classes: "success") %>
        Belongs to eligible
        <%= safe_link_to "organization", stafftools_user_security_center_url, target: "_blank" %>
      <% else %>
        <%= primer_octicon(:x, classes: "error") %>
        Belongs to ineligible
        <%= safe_link_to "organization", stafftools_user_security_center_url, target: "_blank" %>
      <% end %>
    </span>
  <% end %>
  <% component.with_description do %>
    Master controls for the purge and initialization of analytics metric data. Please be careful.
  <% end %>
<% end %>

<%= render(Primer::Alpha::Stack.new(direction: :horizontal, justify: :space_between, mb: 3)) do %>
  <%= render(Primer::Alpha::Stack.new(w: :full, direction: :vertical)) do %>
    <%= render(Primer::Beta::BorderBox.new(w: :full, padding: :condensed, test_selector: "soa-repository-data")) do |component| %>
      <% component.with_header(p: 2) do |h| %>
        <% h.with_title(tag: :h3) { "SecurityOverviewAnalytics::Repository" } %>
      <% end %>

      <% if soa_repository.nil? %>
        <% component.with_body(p: 2) { "This repository has no metadata record in Analytics." } %>
      <% else %>
        <% component.with_body(border: 0, p: 2) do %>
          <table class="stafftools-table mb-0 border-0">
            <tr>
              <th>Name</th>
              <td><%= soa_repository.name %></td>
            </tr>
            <tr>
              <th>Visibility</th>
              <td><%= soa_repository.visibility %></td>
            </tr>
            <tr>
              <th>Archived</th>
              <td><%= soa_repository.archived %></td>
            </tr>
            <tr>
              <th>Pushed at</th>
              <td><%= soa_repository.pushed_at %></td>
            </tr>
            <tr>
              <th>Created at</th>
              <td><%= soa_repository.created_at %></td>
            </tr>
            <tr>
              <th>Updated at</th>
              <td><%= soa_repository.updated_at %></td>
            </tr>
          </table>
        <% end %>
      <% end %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(w: :full, padding: :condensed, test_selector: "soa-feature-status-data")) do |component| %>
      <% component.with_header(p: 2) do |h| %>
        <% h.with_title(tag: :h3) { "SecurityOverviewAnalytics::FeatureStatus" } %>
      <% end %>

      <% if soa_feature_status.nil? %>
        <% component.with_body(p: 2) { "This repository has no feature status rollup in Analytics." } %>
      <% else %>
        <% component.with_body(border: 0, p: 2) do %>
          <table class="stafftools-table mb-0 border-0">
            <tr>
              <th>Advanced Security</th>
              <td><%= soa_feature_status.advanced_security_status %></td>
            </tr>
            <tr>
              <th>Dependabot Alerts</th>
              <td><%= soa_feature_status.dependabot_alerts_status %></td>
            </tr>
            <tr>
              <th>&nbsp; Total</th>
              <td><%= soa_feature_status.dependabot_alerts_total_count %></td>
            </tr>
            <tr>
              <th>&nbsp; Critical</th>
              <td><%= soa_feature_status.dependabot_alerts_critical_count %></td>
            </tr>
            <tr>
              <th>&nbsp; High</th>
              <td><%= soa_feature_status.dependabot_alerts_high_count %></td>
            </tr>
            <tr>
              <th>&nbsp; Medium</th>
              <td><%= soa_feature_status.dependabot_alerts_medium_count %></td>
            </tr>
            <tr>
              <th>&nbsp; Low</th>
              <td><%= soa_feature_status.dependabot_alerts_low_count %></td>
            </tr>
            <tr>
              <th>Dependabot security updates</th>
              <td><%= soa_feature_status.dependabot_security_updates_status %></td>
            </tr>
            <tr>
              <th>Code scanning alerts</th>
              <td><%= soa_feature_status.code_scanning_alerts_status %></td>
            </tr>
            <tr>
              <th>&nbsp; Total</th>
              <td><%= soa_feature_status.code_scanning_alerts_total_count %></td>
            </tr>
            <tr>
              <th>&nbsp; Critical</th>
              <td><%= soa_feature_status.code_scanning_alerts_critical_count %></td>
            </tr>
            <tr>
              <th>&nbsp; High</th>
              <td><%= soa_feature_status.code_scanning_alerts_high_count %></td>
            </tr>
            <tr>
              <th>&nbsp; Medium</th>
              <td><%= soa_feature_status.code_scanning_alerts_medium_count %></td>
            </tr>
            <tr>
              <th>&nbsp; Low</th>
              <td><%= soa_feature_status.code_scanning_alerts_low_count %></td>
            </tr>
            <tr>
              <th>&nbsp; Info</th>
              <td><%= soa_feature_status.code_scanning_alerts_info_count %></td>
            </tr>
            <tr>
              <th>Code scanning Default Setup</th>
              <td><%= soa_feature_status.code_scanning_auto_codeql_status %></td>
            </tr>
            <tr>
              <th>Code scanning PR reviews</th>
              <td><%= soa_feature_status.code_scanning_pr_reviews_status %></td>
            </tr>
            <tr>
              <th>Secret scanning alerts</th>
              <td><%= soa_feature_status.secret_scanning_alerts_status %></td>
            </tr>
            <tr>
              <th>&nbsp; Total</th>
              <td><%= soa_feature_status.secret_scanning_alerts_total_count %></td>
            </tr>
            <tr>
              <th>Secret scanning push protection</th>
              <td><%= soa_feature_status.secret_scanning_push_protection_status %></td>
            </tr>
            <tr>
              <th>Created at</th>
              <td><%= soa_feature_status.created_at %></td>
            </tr>
            <tr>
              <th>Updated at</th>
              <td><%= soa_feature_status.updated_at %></td>
            </tr>
          </table>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Alpha::Stack.new(w: :full, direction: :vertical)) do %>
    <% analytics_data[:metric_types].each do |detail| %>
      <%= render(Primer::Beta::BorderBox.new(w: :full, padding: :condensed, test_selector: "soa-#{detail[:metric_type]}-data")) do |component| %>
        <% component.with_header do |h| %>
          <% h.with_title(tag: :h3) { detail[:metric_type].humanize } %>
        <% end %>
        <% component.with_body(border: 0, p: 2) do %>
          <table class="stafftools-table mb-0 border-0">
            <tr>
              <th>Initialized?</th>
              <td>
                <%= detail[:initialized?] %>
              </td>
            </tr>
            <% if detail.key?(:revision_count) %>
              <tr>
                <th>Total revisions</th>
                <td><%= number_with_delimiter(detail[:revision_count]) %></td>
              </tr>
            <% end %>
            <% if detail.key?(:current_count) %>
              <tr>
              <th>Current count</th>
                <td><%= number_with_delimiter(detail[:current_count]) %></td>
              </tr>
            <% end %>
            <% if detail.key?(:current_open_count) %>
              <tr>
                <th>&nbsp; Open</th>
                <td><%= number_with_delimiter(detail[:current_open_count]) %></td>
              </tr>
            <% end %>
            <% if detail.key?(:current_closed_count) %>
              <tr>
                <th>&nbsp; Closed</th>
                <td><%= number_with_delimiter(detail[:current_closed_count]) %></td>
              </tr>
            <% end %>
            <tr>
              <th>Last reconciled</th>
              <td>
                <%= detail[:last_reconciled] %>
              </td>
            </tr>
            <tr>
              <th>&nbsp; Locked?</th>
              <td><%= detail[:reconciliation_locked?] %></td>
            </tr>
            <tr>
              <th>&nbsp; Expires</th>
              <td><%= detail[:reconciliation_lock_expiry] %></td>
            </tr>
          </table>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
