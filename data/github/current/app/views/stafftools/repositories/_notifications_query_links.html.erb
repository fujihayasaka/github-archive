<div class="site-admin-unboxed">
  <div class="site-admin-subhead ruleless">
    <h2 class="site-admin-subhead-heading">
      Notifications
    </h2>
  </div>

  <p>
    For further information about querying notifications please see <a href="https://github.com/github/notifications/blob/master/docs/engineering/troubleshooting-notification-deliveries.md" class="Link--inTextBlock">troubleshooting notification deliveries</a>.
  </p>

  <table class="stafftools-table mb-4 border">
    <thead>
      <tr>
        <th>Data retention</th>
        <th>newsies</th>
        <th>notifyd</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Kusto</td>
        <td>30 days</td>
        <td>90 days</td>
      </tr>
      <tr>
        <td>Splunk</td>
        <td>180 days</td>
        <td>180 days</td>
      </tr>
    </tbody>
  </table>

  <table class="site-admin-table">
    <thead>
      <th colspan="2">newsies</th>
      <th colspan="2">notifyd</th>
    </thead>
    <% [nil, :email, :web, :mobile_push].each do |handler| %>
      <tr>
        <% text = handler ? handler.to_s.humanize : "all" %>
        <td>
          <% if handler != :mobile_push %>
            <a href="<%= kusto_query_url(view.kusto_db, view.notification_delivery_kusto_query(handler, :newsies)) %>" target="_blank">
              <span>Kusto </span>
              <span>&quot;<%= text %>&quot;</span>
              <span> query</span>
            </a>
          <% end %>
        </td>
        <td>
          <% if handler != :mobile_push %>
            <a href="<%= splunk_search_url(view.notification_delivery_splunk_query(handler, :newsies)) %>" target="_blank">
              <span>Splunk </span>
              <span>&quot;<%= text %>&quot;</span>
              <span> query</span>
            </a>
          <% end %>
        </td>
        <td>
          <% if handler != :web %>
            <a href="<%= kusto_query_url(view.kusto_db, view.notification_delivery_kusto_query(handler, :notifyd)) %>" target="_blank">
              <span>Kusto </span>
              <span>&quot;<%= text %>&quot;</span>
              <span> query</span>
            </a>
          <% end %>
        </td>
        <td>
          <% if handler != :web %>
            <a href="<%= splunk_search_url(view.notification_delivery_splunk_query(handler, :notifyd)) %>" target="_blank">
              <span>Splunk </span>
              <span>&quot;<%= text %>&quot;</span>
              <span> query</span>
            </a>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
</div>
