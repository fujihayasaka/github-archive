<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Commit Statuses
  <% end %>
<% end %>

<label for="search_query">Search by commit status ID or by SHA to get all commit statuses created for a single SHA</label>
<%= form_tag commit_statuses_overview_stafftools_repository_url, :method => :get do %>
  <div class="form-group">
    <%= text_field_tag :search_query, nil, :class => "short",
      :placeholder => "commit status id or SHA",
      :id => "search_query" %>
    <%= render Primer::Beta::Button.new(type: :submit) do %>Search<% end %>
  </div>
<% end %>

