<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    <a href="<%= commit_statuses_overview_stafftools_repository_path %>">Commit Statuses</a>
     / <%= sha %>
  <% end %>
<% end %>

<%= render Primer::Beta::Heading.new(tag: :h3, mb: 2, text: :bold) do %>
  Current Statuses by Context
<% end %>

<div class="py-2">
  The most recent commit statuses per context get displayed in the pull request merge box and are used for things like rulesets and branch protection rules. Older statuses with the same context are disregarded.
</div>

<table class="site-admin-table">
  <thead>
    <tr>
      <th>Context Name</th>
      <th>State</th>
      <th>Database ID</th>
    </tr>
  </thead>
  <tbody>
  <% current_statuses_by_context.each do |context, status| %>
    <tr>
      <td><%= context %></td>
      <td><%= status.first.state %> </td>
      <td><%= status.first.id %></td>
    </tr>
  <% end %>
  </tbody>
</table>

<%= render Primer::Beta::Heading.new(tag: :h3, mb: 2, text: :bold) do %>
  All commit statuses on SHA
<% end %>

<div>
  Total number of commit statuses for this SHA is <%= all_commit_statuses.length %>.
</div>

<% all_commit_statuses.each_with_index do |status, index| %>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "summary")) do |component| %>
    <% component.with_header(font_weight: :bold) do %>
        Status #<%= all_commit_statuses.length - index %>
    <% end %>
    <% component.with_body do %>
      <dl <%= test_selector("commit-status-item") %>>
        <dt>Database ID</dt>
        <dd><%= status.id %></dd>
      </dl>
      <dl>
        <dt>Context</dt>
        <dd><%= status.context %></dd>
      </dl>
      <dl>
        <dt>State</dt>
        <dd><%= status.state %></dd>
      </dl>
      <dl>
        <dt>Creator ID</dt>
        <dd><%= status.creator_id %></dd>
      </dl>
      <dl>
        <dt>Description</dt>
        <dd><%= status.description %></dd>
      </dl>
      <dl>
        <dt>Created at</dt>
        <dd><%= status.created_at&.utc&.iso8601 %></dd>
      </dl>
      <dl>
        <dt>Archived at</dt>
        <dd><%= status.archived_at&.utc&.iso8601 %></dd>
      </dl>
    <% end%>
  <% end %>
<% end %>



