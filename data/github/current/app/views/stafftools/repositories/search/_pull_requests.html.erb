<%
  name = 'Pull Requests Index'
  view = Stafftools::RepositoryViews::Search::PullRequestsView.new(repository:, current_user:)
  repair_job = RepairPullRequestsIndexJob.new("pull-requests", repo_id: current_repository.id)
%>
<h4 class="attention tmp-mb-4"><%= name %></h4>
<% if view.searchable? %>
  <p>The search index contains <%= pluralize(view.document_count, "pull request") %>.</p>
  <div class="Box mb-2" style="border: none; padding-right: 0">
    <div class="Box-header py-2" style="border: none;">
      <h5 class="Box-title">Backfill Operations</h5>
    </div>
    <div class="Box-body pb-2" style="border: none; padding-right: 0;">
      <p>
        Use "Backfill Pull Requests" to push existing MySQL data to the search index.
        <% if view.hubber_tools_available? %>
          <a  class="Link--inTextBlock"
            href="<%= view.docs_url %>#backfilling">
            Learn more about backfills</a>.
        <% end %>
      </p>
      <% if view.backfill_in_progress? || view.backfill_paused? || view.backfill_finished? %>
        <div class="Box mb-2" style="border: none;">
          <div class="Box-header" style="border: none;">
            <h6 class="Box-title">Backfill Status<% if view.backfill_paused? %> (Paused)<% elsif view.backfill_finished? %> (Finished)<% end %></h6>
          </div>
          <div class="Box-body" style="border: none;">
            <div class="d-flex flex-wrap">
              <div class="col-6 mb-2">
                <strong>Start time:</strong><br>
                <% if view.backfill_start_time %>
                  <%= time_ago_in_words(view.backfill_start_time) %> ago
                  <span class="color-fg-muted">(<%= view.backfill_start_time.strftime("%Y-%m-%d %H:%M:%S %Z") %>)</span>
                <% else %>
                  Unknown
                <% end %>
              </div>
              <div class="col-6 mb-2">
                <strong>Elapsed time:</strong><br>
                <% if view.backfill_wall_clock_elapsed_time %>
                  <%= distance_of_time_in_words(view.backfill_wall_clock_elapsed_time) %>
                <% else %>
                  -
                <% end %>
              </div>
              <div class="col-6 mb-2">
                <strong>Workers:</strong><br>
                <%= view.backfill_active_workers_count %> active / <%= view.backfill_workers_count %> configured
              </div>
              <div class="col-6 mb-2">
                <% if view.hubber_tools_available? %>
                  <strong>Monitoring:</strong><br>
                  <%= safe_link_to "Datadog Dashboard", view.repair_dashboard_url,
                      class: "Link--inTextBlock", target: "_blank" %>
                <% end %>
              </div>
            </div>

            <div class="tmp-mt-3">
              <strong>Progress:</strong>
              <%= progress_bar(view.backfill_progress, percentage: true, precision: 1) %>
              <span class="color-fg-muted"><%= view.backfill_progress.round(1) %>%</span>
            </div>
          </div>
        </div>

        <% if view.backfill_in_progress? %>
          <%= form_tag gh_pause_backfill_stafftools_repository_pull_requests_path(repository), :method => "post" do %>
            <div class="text-right">
              <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, classes: "tmp-mb-3") do %>Pause Backfill<% end %>
            </div>
          <% end %>
        <% elsif view.backfill_paused? || view.backfill_finished? %>
          <%= form_tag gh_reset_backfill_stafftools_repository_pull_requests_path(repository), :method => "post" do %>
            <div class="text-right">
              <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, classes: "tmp-mb-3") do %>Reset Backfill<% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% unless view.backfill_finished? %>
        <%= form_tag gh_backfill_stafftools_repository_pull_requests_path(repository), :method => "post" do %>
          <div class="form-group mb-2">
            <%= label_tag :workers, "Number of workers:" %>
            <%= number_field_tag :workers,
                view.worker_count_render_value,
                min: 1, max: 100, class: "form-control", style: "width: 100px;" %>
            <% if view.backfill_active_workers_count > 0 %>
              <small class="form-text color-fg-muted">
                Current: <%= view.backfill_workers_count %> workers configured
              </small>
            <% end %>
          </div>
          <p class="mb-2">
            Start with the default worker count and adjust as needed.
            <% if view.hubber_tools_available? %>
              [<%= safe_link_to(
                "docs",
                "#{view.docs_url}#setting-worker-count",
                class: "Link--inTextBlock")
              %>]
            <% end %>
          </p>

          <div class="text-right">
            <%= render Primer::Beta::Button.new(type: :submit, classes: "tmp-mb-3") do %>
              <%= view.backfill_label %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
  <% if view.reindex? %>
    <div class="Box tmp-mb-3" style="border: none;">
      <div class="Box-header py-2" style="border: none;">
        <h5 class="Box-title">Reindex Operations</h5>
      </div>
      <div class="Box-body pb-2" style="border: none; padding-right: 0;">
          <p> <strong>Not recommended for large data sets!</strong></p>
          <p>
            Use "Reindex Pull Requests" to fully sync MySQL data to the search index.
        <% if view.hubber_tools_available? %>
            <a class="Link--inTextBlock" href="<%= "#{view.docs_url}#reindexing" %>">
              Learn more about reindexing
            </a>.
        <% end %>
            <% if view.hubber_tools_available? %>
              For large data sets (thousands of PRs), we recommend backfilling instead.
              If you absolutely need a full reindex for a large data set, please
              reach out in <%= safe_link_to "#elasticsearch", "https://github.slack.com/archives/elasticsearch", class: "Link--inTextBlock" %>!
            <% end %>
          </p>
        <% if view.reindex_reason %>
          <%= render Primer::Alpha::Banner.new(variant: :warning, classes: "tmp-mb-3") do %>
            <%= primer_octicon(:alert, mr: 1) %><%= view.reindex_reason %>
          <% end %>
        <% end %>
        <%= form_tag gh_reindex_stafftools_repository_pull_requests_path(repository), :method => "post" do %>
          <div class="text-right">
            <%= render Primer::Beta::Button.new(type: :submit, classes: "tmp-mb-3") do %>
              <%= view.reindex_label %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <% if view.purge? %>
    <%= form_tag gh_purge_stafftools_repository_pull_requests_path(repository), :method => "post" do %>
      <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary, classes: "boxed-action") do %>Purge Pull Requests<% end %>
    <% end %>
    <p><%= view.purge_reason %></p>
  <% else %>
    This repository has no indexed pull requests.
  <% end %>
<% end %>
