<%# erblint:counter DeprecatedComponentsCounter 2 %>
<%
name = 'Code Search Index (blackbird)'
%>
<%
view = Stafftools::RepositoryViews::Search::BlackbirdView.new(:repository => repository)
%>

<% if !view.lexical_search_ok? || view.has_error? || view.indexing_error.present? %>
  <%= form_tag gh_reindex_blackbird_stafftools_repository_path(repository), :method => 'post' do %>
    <%= render Primer::ButtonComponent.new(type: :submit, classes: "boxed-action") do %>Index Code<% end %>
  <% end %>
<% end %>

<% if !view.semantic_code_search_ok? || view.has_error? || view.indexing_error.present? %>
  <%= form_tag gh_reindex_blackbird_embeddings_stafftools_repository_path(repository), :method => 'post' do %>
    <%= render Primer::ButtonComponent.new(type: :submit, classes: "boxed-action") do %>Index Embeddings<% end %>
  <% end %>
<% end %>

<h4><%= name %></h4>

<p><%= view.description %> </p>

<% if view.indexing_error.present? %>
  <p>
    There was a problem indexing this repository. Reindexing is unlikely to fix the issue.
  </p>
  <p>
    <%= primer_octicon(:alert, mr: 1, classes: "error") %>
    <%= view.indexing_error %>
  </p>
<% end %>
