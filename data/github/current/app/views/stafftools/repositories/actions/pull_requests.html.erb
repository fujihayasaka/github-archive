<% title = "CI & Pull Requests" %>
<% page_info :title => title %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>
      <%= title %>
    <% end %>
  <% end %>
  <% if issues.any? %> <%# domain-isolation-query-violation:ignore:packages/issues (SELECT) %>
    <table class="site-admin-table">
      <% issues.each do |issue| %> <%# domain-isolation-query-violation:ignore:packages/issues (SELECT) %>
        <% if issue.pull_request? %> <%# domain-isolation-query-violation:ignore:packages/issues (SELECT) %>
          <tr <%= test_selector("pull-request-item") %>>
            <td class="tiny">
                <% if issue.open? %>
                  <%= primer_octicon(:"git-pull-request", classes: "open") %>
                <% elsif issue.pull_request.merged? %>
                  <%= primer_octicon(:"git-pull-request", classes: "merged") %>
                <% else %>
                  <%= primer_octicon(:"git-pull-request-closed", classes: "closed") %>
                <% end %>
            </td>
            <td>
              <%= link_to \
                    "##{issue.number}" ,
                    gh_actions_pull_request_stafftools_repository_path(issue.pull_request) %>
            </td>
            <td>
              Created by <%= issue.user %>
            </td>
            <td class="right-align">
              <%= issue.created_at %>
             </td>
          </tr>
        <% end %>
      <% end %>
    </table>

    <div class="paginate-container">
      <%= will_paginate issues, :params => {:user_id => params[:user_id], :repository => params[:repository]} %>
    </div>
  <% end %>
