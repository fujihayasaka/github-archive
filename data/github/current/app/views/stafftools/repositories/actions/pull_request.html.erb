<% title = "Pull Request" %>
<% page_info :title => title %>
<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    <%= render(Primer::Beta::Link.new(href:  gh_actions_pull_requests_stafftools_repository_path(current_repository), classes: "Link--inTextBlock")) { "CI & Pull Requests" } %>
     / #<%= pull_request.number %>
  <% end %>
  <% component.with_actions(display: :flex) do %>
    <%= form_tag gh_stafftools_repository_pull_request_path(pull_request), method: :get do %>
      <%= render Primer::Beta::Button.new(type: :submit, float: :right, ml: 2) do %>Extra pull request information<% end %>
    <% end %>
  <% end %>
<% end %>

<div>
  The pull request head REF is <%= pull_request.head_ref %>
</div>

<%= render(Primer::Beta::Link.new(href: gh_stafftools_repository_reflog_path(current_repository) + push_log_path)) do %>
  View full push log for this head REF
<% end %>

<div class="Box mt-3">
  <div class="Box-header">
    <h3 class="Box-title">Commits (<%= commits.length %>)</h3>
  </div>
  <ul class="list-style-none">
    <% commits.each do |commit| %>
      <li class="Box-row d-flex flex-items-center" <%= test_selector("pull-request-commit-item") %>>
        <div class="flex-auto">
          <strong class="d-block">
            <%= render(Primer::Beta::Link.new(href: gh_actions_pull_request_commit_stafftools_repository_path(current_repository, pull_request.id, commit.oid))) do %>
              OID: <%= commit.oid %>
            <% end %>
          </strong>
          <div class="text-small">
            <%= render(Primer::Beta::Link.new(href: Stafftools::RepositoriesHelper.get_splunk_link_for_workflow_run_invocation_logs(commit.oid, commit.created_at))) do %>
              Launch Invocation logs
            <% end %>
          </div>
          <div class="text-small color-fg-muted">Created at: <%= commit.created_at %></div>
        </div>
      </li>
    <% end %>
  </ul>
</div>

