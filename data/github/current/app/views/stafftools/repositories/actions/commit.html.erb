<% title = "Commit Details" %>
<% page_info :title => title %>
<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    <%= render(Primer::Beta::Link.new(href: gh_actions_pull_requests_stafftools_repository_path(current_repository), classes: "Link--inTextBlock")) { "CI & Pull Requests" } %>
     / <%= render(Primer::Beta::Link.new(href: gh_actions_pull_request_stafftools_repository_path(pull_request), classes: "Link--inTextBlock")) { "##{pull_request.number}" } %> /
     <%= commit.oid %>
  <% end %>
<% end %>


<%= render Primer::Beta::Heading.new(tag: :h3, mb: 2, text: :bold) do %>
  Commit Details
<% end %>

<table class="site-admin-table">
  <tbody>
    <tr>
      <th style="width: 200px;">OID (SHA)</th>
      <td><code><%= commit.oid %></code></td>
    </tr>
    <tr>
      <th>Created At</th>
      <td><%= commit.created_at %></td>
    </tr>
    <tr>
      <th>Author</th>
      <td><%= commit.author_name %></td>
    </tr>
  </tbody>
</table>

<%= render Primer::Beta::Heading.new(tag: :h2, mb: 2, text: :bold) do %>
  Commit Statuses
<% end %>

<%= render(Primer::Beta::Link.new(href: gh_commit_statuses_sha_summary_stafftools_repository_path(repository, commit.oid))) do %>
  View Commit Statuses on this SHA
<% end %>

<%= render Primer::Beta::Heading.new(tag: :h2, my: 2, text: :bold) do %>
  Third Party Check Suites (<%= third_party_check_suites.length %>)
<% end %>

<% if third_party_check_suites.any? %>
  <div class="d-flex flex-wrap">
    <% third_party_check_suites.each do |check_suite| %>
      <div class="Box Box--condensed mr-3 mb-3 col-md-5" <%= test_selector("third-party-check-suite-item") %>>
        <div class="Box-header d-flex flex-items-center">
          <h3 class="Box-title flex-auto"><%= "Third Party Check Suite" %></h3>
        </div>
        <div class="Box-body">
          <div class="m-0">
            <div class="d-flex flex-items-center mb-2 mt-2">
              <span class="text-bold mr-2">Check Suite ID:</span>
              <span><%= check_suite.id %></span>
            </div>

            <div class="d-flex flex-items-center mb-2">
              <span class="text-bold mr-2">GitHub App ID:</span>
              <span><%= check_suite.github_app_id %></span>
            </div>
          </div>
        </div>
        <div class="Box-footer d-flex flex-items-center">
          <%= render(Primer::Beta::Link.new(href: check_suite_overview_stafftools_repository_path(check_suite_id: check_suite.id), target: "_blank", classes: "btn btn-sm mr-2")) { "View Details" } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No third-party check suites found for this commit.</p>
<% end %>

<%= render Primer::Beta::Heading.new(tag: :h2, my: 2, text: :bold) do %>
  Actions Check Suites (<%= actions_check_suites.length %>)
<% end %>

<% if actions_check_suites.any? %>
  <div class="d-flex flex-wrap">
    <% actions_check_suites.each do |check_suite| %>
      <div class="Box Box--condensed mr-3 mb-3 col-md-5" <%= test_selector("actions-check-suite-item") %>>
        <div class="Box-header d-flex flex-items-center">
          <h3 class="Box-title flex-auto"> Workflow Run <%= check_suite.workflow_run.id %></h3>
        </div>
        <div class="Box-body">
          <div class="m-0">
            <div class="d-flex flex-items-center mb-2 mt-2">
              <span class="text-bold mr-2">Check Suite ID:</span>
              <span><%= check_suite.id %></span>
            </div>

            <div class="d-flex flex-items-center mb-2">
              <span class="text-bold mr-2">Workflow Name:</span>
              <span><%= check_suite.workflow_run.name %></span>
            </div>

            <div class="d-flex flex-items-center mb-2">
              <span class="text-bold mr-2">Triggered By:</span>
              <span><%= check_suite.workflow_run.event %> / <%= check_suite.workflow_run.action %></span>
            </div>

            <div class="d-flex flex-items-center mb-2">
              <span class="text-bold mr-2">Workflow File:</span>
              <span class="text-small color-fg-muted"><code><%= check_suite.workflow_run.workflow_file_path %></code></span>
            </div>
          </div>
        </div>
        <div class="Box-footer d-flex flex-items-center">
          <%= render(Primer::Beta::Link.new(href: actions_workflow_execution_stafftools_repository_path(check_suite_id: check_suite.id), target: "_blank", classes: "btn btn-sm mr-2")) { "View Details" } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No GitHub Actions check suites found for this commit.</p>
<% end %>
