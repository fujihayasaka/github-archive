<div class="boxed-group">
  <h3>Latest runs</h3>
  <div class="boxed-group-inner">
    <h4><label for="actions_workflow_query">Search by workflow run id / check suite id / check run id</label></h4>
    <%= form_tag gh_actions_latest_runs_stafftools_repository_path(current_repository), :method => :get do %>
      <div class="form-group">
        <%= text_field_tag :query, params[:query], :class => "short",
          :placeholder => "workflow run id / check suite id / check run id",
          :id => "actions_workflow_query" %>
        <%= render Primer::Beta::Button.new(type: :submit) do %>Search<% end %>
      </div>
    <% end %>

    <h4 class="tmp-mt-3">Filter workflow runs</h4>
    <%= form_tag gh_actions_latest_runs_stafftools_repository_path(current_repository), :method => :get do %>
      <div class="d-flex flex-wrap tmp-mb-3">
        <div class="form-group tmp-mr-3" style="flex: 0 0 auto; min-width: 150px;">
          <label for="status_filter" class="text-small">Status</label>
          <%= select_tag :status, options_for_select([
            ["All", "all"],
            ["Queued", "queued"],
            ["In Progress", "in_progress"],
            ["Completed", "completed"],
            ["Waiting", "waiting"],
            ["Pending", "pending"]
          ], params[:status] || "all"), :id => "status_filter", :class => "form-select form-select-sm" %>
        </div>

        <div class="form-group tmp-mr-3" style="flex: 0 0 auto; min-width: 150px;">
          <label for="conclusion_filter" class="text-small">Conclusion</label>
          <%= select_tag :conclusion, options_for_select([
            ["All", "all"],
            ["Success", "success"],
            ["Failure", "failure"],
            ["Neutral", "neutral"],
            ["Cancelled", "cancelled"],
            ["Timed Out", "timed_out"],
            ["Action Required", "action_required"],
            ["Skipped", "skipped"],
            ["Stale", "stale"],
            ["Startup Failure", "startup_failure"]
          ], params[:conclusion] || "all"), :id => "conclusion_filter", :class => "form-select form-select-sm" %>
        </div>

        <div class="form-group tmp-mr-3" style="flex: 0 0 auto; min-width: 150px;">
          <label for="created_within_hours_filter" class="text-small">Created Within</label>
          <%= select_tag :created_within_hours, options_for_select([
            ["No Filter", ""],
            ["Last 24 hours", "24"],
            ["Last 48 hours", "48"],
            ["Last 72 hours", "72"]
          ], params[:created_within_hours] || ""), :id => "created_within_hours_filter", :class => "form-select form-select-sm" %>
        </div>

        <div class="form-group" style="flex: 0 0 auto; min-width: 100px;">
          <label for="limit_filter" class="text-small">Max Results</label>
          <%= select_tag :limit, options_for_select([
            ["10", "10"],
            ["50", "50"],
            ["100", "100"],
            ["200", "200"]
          ], params[:limit] || "50"), :id => "limit_filter", :class => "form-select form-select-sm" %>
        </div>
      </div>

      <div class="d-flex flex-wrap tmp-mb-3">
        <div class="form-group tmp-mr-3" style="flex: 0 0 auto; min-width: 100px;">
          <label for="created_after" class="text-small">Created After</label>
          <%= datetime_field_tag :created_after, params[:created_after], :id => "created_after", :class => "form-control input-sm" %>
        </div>

        <div class="form-group tmp-mr-3" style="flex: 0 0 auto; min-width: 100px;">
          <label for="created_before" class="text-small">Created Before</label>
          <%= datetime_field_tag :created_before, params[:created_before], :id => "created_before", :class => "form-control input-sm" %>
        </div>

        <div class="form-group tmp-mr-3" style="flex: 0 0 auto; min-width: 100px;">
          <label for="updated_after" class="text-small">Updated After</label>
          <%= datetime_field_tag :updated_after, params[:updated_after], :id => "updated_after", :class => "form-control input-sm" %>
        </div>

        <div class="form-group" style="flex: 0 0 auto; min-width: 100px;">
          <label for="updated_before" class="text-small">Updated Before</label>
          <%= datetime_field_tag :updated_before, params[:updated_before], :id => "updated_before", :class => "form-control input-sm" %>
        </div>
      </div>

      <%= render Primer::Alpha::Banner.new(scheme: :warning, classes: "tmp-mb-3") do %>
        <strong>Performance Warning:</strong> These filters run without adequate database indices and may cause performance degradation or slow queries. Use with caution, especially on repositories with large numbers of workflow runs.
      <% end %>

      <div class="form-actions d-flex">
        <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, mr: 2) do %>Apply Filters<% end %>
        <%= link_to "Clear Filters", gh_actions_latest_runs_stafftools_repository_path(current_repository), class: "btn btn-md" %>
      </div>
    <% end %>

    <div class="text-small mb-1 mt-2">
      <%= link_to "Workflow run deletion audit logs", Stafftools::RepositoriesHelper.get_audit_log_link_for_repo_deleted_workflow_runs(current_repository.id) %>
    </div>
    <% if workflow_runs.none? %>
      <%= render Primer::Beta::Blankslate.new do |c| %>
        <% c.with_heading(tag: :h2) do %>
          There are no runs executed so far for this repository.
        <% end %>
      <% end %>
    <% else %>
      <ul class="boxed-group-list">
        <% workflow_runs.each do |run| %>
          <li class="stafftools-auditlog">
            <%= render Primer::Beta::Octicon.new(icon: "workflow", height: 32) %>
            <div class='js-details-container Details audit-log-entry'>
              <strong class='audit-log-title'><%= run.title %></strong>
              <relative-time datetime="<%= run.created_at.utc.iso8601 %>"></relative-time>
              <p>Status: <%= run.status %></p>
              <% if run.conclusion %>
                <p>Conclusion: <%= run.conclusion %></p>
              <% end %>
              <p>Triggered by: <%= run.event %></p>
              <p>Branch: <%= run.head_branch %></p>
              <p>Commit: <%= run.head_sha %></p>
              <p>Workflow: <%= run.workflow&.path %></p>
              <% if run.workflow_run_executions.present? %>
                <p>Attempts: <%= run.workflow_run_executions.size %></p>
              <% end %>
              <a href="<%= actions_workflow_execution_stafftools_repository_path(check_suite_id: run.check_suite_id)%>">See more details</a>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
