<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Immutable Actions
  <% end %>
<% end %>

<% if immutable_actions_migration_enabled %>
  <div>
    <%= render Primer::Beta::Octicon.new(icon: "check-circle-fill", color: :success, mr: 1) %>
    migrate_to_immutable_actions feature flag enabled. This flag enables UI for repository admins to kick off a migration that creates immutable action versions for each tag of an existing action.
  </div>
<% else %>
  <div>
    <%= render Primer::Beta::Octicon.new(icon: "x-circle-fill", color: :danger, mr: 1) %>
    migrate_to_immutable_actions feature flag not enabled. This flag enables UI for repository admins to kick off a migration that creates immutable action versions for each tag of an existing action.
  </div>
<% end %>

<% if rms_publish_enabled %>
  <div>
    <%= render Primer::Beta::Octicon.new(icon: "check-circle-fill", color: :success, mr: 1, mt: 4) %>
    rms_publish_immutable_actions feature flag enabled. This flag allows for publishing immutable actions in the container registry backend and is needed for succesful publishing and migration.
  </div>
<% else %>
  <div>
    <%= render Primer::Beta::Octicon.new(icon: "x-circle-fill", color: :danger, mr: 1, mt: 4) %>
    rms_publish_immutable_actions feature flag not enabled. This flag allows for publishing immutable actions in the container registry backend and is needed for succesful publishing and migration.
  </div>
<% end %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h5, mt: 4) do %>
    Migration status
  <% end %>
<% end %>
<div>
  Status: <%= migration_status %>
</div>
<% if migration_status != "not_started" %>
  <div class="my-2">
    If the migration is stuck for some reason or completed with failures then you can reset the migration which will allow repository admins to see a banner to start the migration again.
  </div>
  <%= form_tag reset_immutable_actions_migration_stafftools_repository_path, method: :post do %>
    <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, mt: 2) do %>Reset migration status to not_started<% end %>
  <% end %>
<% end %>

