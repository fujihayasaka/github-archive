<%= render(Primer::Beta::BorderBox.new) do |box| %>
  <% box.with_header do %>
    <span class="text-bold">Concurrency Groups</span>
  <% end %>
  <% box.with_body do %>
    <div class="tmp-mb-3 p-2 color-bg-subtle rounded-2">
      <div class="d-flex flex-items-center">
        <span class="mr-2 text-bold">Run Service:</span>
        <%= link_to "Production",
          actions_concurrency_groups_stafftools_repository_path(
            current_repository.owner,
            current_repository,
            use_lab: nil
          ),
          class: "btn btn-sm mr-2 #{use_lab_run_service? ? '' : 'btn-primary'}" %>
        <%= link_to "Lab",
          actions_concurrency_groups_stafftools_repository_path(
            current_repository.owner,
            current_repository,
            use_lab: "true"
          ),
          class: "btn btn-sm #{use_lab_run_service? ? 'btn-primary' : ''}" %>
        <% if use_lab_run_service? %>
          <%= render(Primer::Beta::Label.new(scheme: :attention, ml: 2)) { "Using Lab" } %>
        <% end %>
      </div>
    </div>

    <% if error %>
      <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: "alert", classes: "tmp-mb-3")) do %>
        Error loading concurrency groups: <%= error %>
      <% end %>
    <% else %>
      <p class="text-small color-fg-muted tmp-mb-3">
        Total active concurrency groups: <strong><%= total_count %></strong>
      </p>

      <% if groups.any? %>
        <%= render(Primer::Beta::BorderBox.new) do |box| %>
          <% box.with_header do %>
            <div class="d-flex flex-justify-between flex-items-center width-full">
              <span class="text-bold" style="flex: 2;">Group Name</span>
              <span class="text-bold" style="flex: 3;">Last Acquired At</span>
              <span class="text-bold" style="flex: 1;">Actions</span>
            </div>
          <% end %>
          <% groups.each do |group| %>
            <% box.with_row do %>
              <div class="d-flex flex-justify-between flex-items-center width-full">
                <div style="flex: 2;">
                  <code><%= group.group_name %></code>
                </div>
                <div style="flex: 3;">
                  <% if group.last_acquired_at && group.last_acquired_at.seconds > 0 %>
                    <%= time_ago_in_words(Time.at(group.last_acquired_at.seconds)) %> ago
                    <span class="text-small color-fg-muted">
                      (<%= Time.at(group.last_acquired_at.seconds).utc.strftime("%Y-%m-%d %H:%M:%S UTC") %>)
                    </span>
                  <% else %>
                    <span class="color-fg-muted">N/A</span>
                  <% end %>
                </div>
                <div style="flex: 1;">
                  <%= link_to "View Details",
                    actions_concurrency_group_stafftools_repository_path(
                      current_repository.owner,
                      current_repository,
                      group_name: group.group_name,
                      use_lab: use_lab_run_service? ? "true" : nil
                    ),
                    class: "btn btn-sm" %>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>

        <% if next_cursor.present? %>
          <div class="tmp-mt-3">
            <%= link_to "Load More",
              actions_concurrency_groups_stafftools_repository_path(
                current_repository.owner,
                current_repository,
                cursor: next_cursor,
                use_lab: use_lab_run_service? ? "true" : nil
              ),
              class: "btn" %>
          </div>
        <% end %>
      <% else %>
        <div class="blankslate">
          <%= render Primer::Beta::Octicon.new(icon: "workflow", size: :medium) %>
          <h3>No active concurrency groups</h3>
          <p>There are no active concurrency groups for this repository.</p>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
