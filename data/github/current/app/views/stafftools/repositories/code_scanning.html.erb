<%# erblint:counter DeprecatedComponentsCounter 2 %>
<% page_info title: "#{current_repository.name_with_display_owner} - Code scanning" %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed, test_selector: "code-scanning-reconciliation", classes: "tmp-mb-3")) do |component| %>
  <% component.with_header(p: 2, bg: :accent) do |h| %>
    <% h.with_title(tag: :h3) { "Resync data" } %>
  <% end %>

  <% component.with_body(p: 2, display: :flex, justify_content: :space_between) do %>
    <%= render(Primer::Box.new) do %>
      <%= render(Primer::Beta::Heading.new(tag: :h4)) { "Trigger code scanning reconciliation" } %>
      <p>Triggers background jobs to reconcile code scanning metadata and repository feature status.</p>
      <p class="note">Safe to run multiple times. Updates are asynchronous and usually complete within a few minutes.</p>
    <% end %>

    <%= render(Primer::Box.new) do %>
      <%= form_tag code_scanning_trigger_reconciliation_stafftools_repository_path(current_repository.owner, current_repository), method: :post do %>
        <%= render Primer::ButtonComponent.new(type: :submit) do %>Run code scanning reconciliation<% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed, test_selector: "code-scanning-alert-counts", classes: "tmp-mb-3")) do |component| %>
  <% component.with_header(p: 2) do |h| %>
    <% h.with_title(tag: :h3) { "Code scanning service alert counts" } %>
  <% end %>

  <% component.with_body(p: 0) do %>
    <table class="site-admin-table mb-0 border-0">
      <thead>
        <tr>
          <th>Total</th>
          <th>Open</th>
          <th>Closed</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= alert_counts[:total] %></td>
          <td><%= alert_counts[:open] %></td>
          <td><%= alert_counts[:closed] %></td>
        </tr>
      </tbody>
    </table>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed, test_selector: "code-scanning-analyses-count", classes: "tmp-mb-3")) do |component| %>
  <% component.with_header(p: 2) do |h| %>
    <% h.with_title(tag: :h3) { "Code scanning analysis count" } %>
  <% end %>

  <% component.with_body(p: 0) do %>
    <table class="site-admin-table mb-0 border-0">
      <thead>
        <tr>
          <th>Analysis Count</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= analyses_count %></td>
        </tr>
      </tbody>
    </table>
  <% end %>
<% end %>

<div class="Box Box--danger" <%= test_selector("code-scanning-danger-zone") %>>
  <div class="Box-header">
    <h3 class="Box-title color-fg-danger">Danger zone</h3>
  </div>

  <div class="Box-row d-flex flex-justify-between flex-items-center">
    <div>
      <h4 class="mb-1">Delete All Alerts in a Repo</h4>
      <p class="mb-1 color-fg-danger text-bold">Danger: this removes all code scanning alerts for this repository.</p>
      <p class="note mb-0">Currently under construction.</p>
    </div>

    <%= render layout: "shared/details_dialog", locals: {
      button_class: "btn btn-danger",
      button_text: "Delete All Alerts in a Repo",
      title: "Delete all alerts in a repository",
    } do %>
      <div class="Box-body overflow-auto">
        <p>
          This will request deletion of all code scanning alerts for this repository.
          <strong>Are you certain?</strong>
        </p>
      </div>
      <div class="Box-footer">
        <p>To confirm, type <strong><%= current_repository.name_with_display_owner %></strong> in the box below.</p>
        <%= form_tag code_scanning_delete_alerts_stafftools_repository_path(current_repository.owner, current_repository), method: :post, class: "stafftools" do %>
          <p>
            <input
              type="text"
              class="form-control input-block"
              required
              pattern="<%= case_insensitive_pattern current_repository.name_with_display_owner %>"
              aria-label="Type in the repository name to confirm deleting all code scanning alerts."
              name="verify"
              autocomplete="off"
            >
          </p>
          <%= render Primer::ButtonComponent.new(type: :submit, scheme: :danger, block: true, "data-disable-invalid": "") do %>
            Delete all alerts
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

