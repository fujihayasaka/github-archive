<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Checks
  <% end %>
<% end %>

<div class="mb-2"> Check runs and check suites can be created by GitHub Actions and by other GitHub Apps. Use this page to search for check suites and check runs in this repository not created by GitHub Actions.</div>

<label for="check_suite_query">Search by check suite id</label>
<%= form_tag checks_overview_stafftools_repository_url, :method => :get do %>
  <div class="form-group">
    <%= text_field_tag :check_suite_query, nil, :class => "short",
      :placeholder => "check suite id",
      :id => "check_suite_query" %>
    <%= render Primer::Beta::Button.new(type: :submit) do %>Search<% end %>
  </div>
<% end %>

<label for="check_run_query">Search by check run id</label>
<%= form_tag checks_overview_stafftools_repository_url, :method => :get do %>
  <div class="form-group">
    <%= text_field_tag :check_run_query, nil, :class => "short",
      :placeholder => "check run id",
      :id => "check_run_query" %>
    <%= render Primer::Beta::Button.new(type: :submit) do %>Search<% end %>
  </div>
<% end %>


<% if latest_check_suites.any? %>
  <div class="boxed-group mt-5">
    <h3>Latest Check Suites</h3>
    <div class="boxed-group-inner">
      <ul class="boxed-group-list">
        <% latest_check_suites.each do |check_suite| %>
          <li class="stafftools-auditlog">
            <%= render Primer::Beta::Octicon.new(icon: "check-circle", height: 32) %>
            <div class='js-details-container Details audit-log-entry' <%= test_selector("check-suite-item") %>>
              <strong class='audit-log-title'>ID: <%= check_suite.id %></strong>
              <relative-time datetime="<%= check_suite.created_at.utc.iso8601 %>"></relative-time>
              <p>GitHub App_id: <%= check_suite.github_app_id %></p>
              <p>Head SHA: <%= check_suite.head_sha %></p>
              <a href="<%= check_suite_overview_stafftools_repository_path(check_suite_id: check_suite.id)%>">See more details</a>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% else %>
  <%= render Primer::Beta::Blankslate.new do |c| %>
    <% c.with_heading(tag: :h2) do %>
      There are no third party checks in this repository.
    <% end %>
  <% end %>
<% end %>



