<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    <a href="<%= checks_overview_stafftools_repository_url %>">Checks</a>
     / Check Suite <%= check_suite.id %>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "summary")) do |component| %>
  <% component.with_header(font_weight: :bold) do %>
      Check Suite
  <% end %>
  <% component.with_body do %>
    <dl>
      <dt>Check Suite ID</dt>
      <dd><%= check_suite.id %></dd>
    </dl>
    <dl>
      <dt>Repository ID</dt>
      <dd><%= check_suite.repository_id %></dd>
    </dl>
    <dl>
      <dt>GitHub App ID</dt>
      <dd><%= check_suite.github_app_id %></dd>
    </dl>
    <dl>
      <dt>GitHub App</dt>
      <dd><%= link_to github_app.name, gh_stafftools_app_path(github_app.owner, github_app) %></dd>
    </dl>
    <dl>
      <dt>Head SHA</dt>
      <dd><%= check_suite.head_sha %></dd>
    </dl>
    <dl>
      <dt>Created at</dt>
      <dd><%= check_suite.created_at&.utc&.iso8601 %></dd>
    </dl>
    <dl>
      <dt>Completed at</dt>
      <dd><%= check_suite.completed_at&.utc&.iso8601 %></dd>
    </dl>
    <dl>
      <dt>Archived at</dt>
      <dd><%= check_suite.archived_at&.utc&.iso8601 %></dd>
    </dl>
    <dl>
      <dt>Status</dt>
      <dd><%= check_suite.status %></dd>
    </dl>
    <dl>
      <dt>Conclusion</dt>
      <dd><%= check_suite.conclusion %></dd>
    </dl>
  <% end%>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "summary")) do |component| %>
  <% component.with_header(font_weight: :bold) do %>
    Check Runs
  <% end %>
  <% check_runs.each do |check_run| %>
    <% component.with_row do %>
      <h4>Check run ID: <%= check_run.id %></h4>
      <dl <%= test_selector("check-run-item") %>>
        <dt>Name</dt>
        <dd><%= check_run.name %></dd>
      </dl>
      <dl>
        <dt>Created at</dt>
        <dd><%= check_run.created_at&.utc&.iso8601 %></dd>
      </dl>
      <dl>
        <dt>Completed at</dt>
        <dd><%= check_run.completed_at&.utc&.iso8601 %></dd>
      </dl>
      <dl>
        <dt>Status</dt>
        <dd><%= check_run.status %></dd>
      </dl>
      <dl>
        <dt>Conclusion</dt>
        <dd><%= check_run.conclusion %></dd>
      </dl>
      <dl>
        <dt>External ID</dt>
        <dd><%= check_run.external_id %></dd>
      </dl>
    <% end %>
  <% end %>
<% end %>
