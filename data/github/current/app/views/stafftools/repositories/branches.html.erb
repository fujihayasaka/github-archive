<% page_info :title => "#{current_repository.name_with_owner} - Branches" %>

<%= render Primer::Beta::BorderBox.new(padding: :condensed, classes: "tmp-mb-3") do |component| %>
  <% component.with_header(font_weight: :bold) { "RefPush Repair" } %>
  <% component.with_row do %>
    <p>
      Queue a background job to repair RefPush records for this repository.
      Run this when branches are showing up in the branches list but do not exist in git.
      <%= form_tag expand_nwo_from(:repair_ref_pushes_stafftools_repository_path, current_repository) do %>
        <%= render Primer::Beta::Button.new(type: :submit) do %>Repair RefPush records<% end %>
      <% end %>
    </p>
  <% end %>
<% end %>
