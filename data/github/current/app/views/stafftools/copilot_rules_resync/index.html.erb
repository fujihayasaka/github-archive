<%
  page_info(title: "Copilot Rules Resync", description: "Re-propagate Copilot model policies to organizations for all enterprises with rules")
%>
<%= render layout: "stafftools/stafftools" do %>
  <div class="site-admin-subhead ruleless">
    <h2 class="site-admin-subhead-heading">Copilot Rules Resync</h2>
    <p class="color-fg-muted">
      Re-propagate Copilot model settings to organizations for every enterprise that has at least one
      Copilot rule configured for a propagatable Copilot model policy. Use this after toggling the
      <code>setting_rules_copilot_models</code> rollout flag back off, when organizations need to reset
      to the current enterprise settings.
    </p>
  </div>
  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% component.with_header do %>
      <h3 class="f4">Trigger Resync</h3>
    <% end %>
    <% component.with_body do %>
      <%= render Primer::Alpha::Banner.new(
        icon: :alert,
        scheme: :danger,
        test_selector: "copilot-rules-resync-warning",
        classes: "tmp-mb-3") do %>
        <strong>Warning:</strong> This enqueues a global background job that scans every enterprise
        which has added Copilot model rules, and re-propagates the enterprise setting value to all of
        its organizations. If you don't know what all that means, don't click this button.
      <% end %>
      <%= form_with url: stafftools_copilot_rules_resync_index_path, method: :post, local: true do |f| %>
        <div class="form-group">
          <div class="form-group-header">
            <label for="reason">Reason for resync</label>
          </div>
          <div class="form-group-body">
            <%= f.text_area :reason,
                class: "form-control width-full",
                rows: 3,
                required: true,
                placeholder: "Reason for running resync" %>
          </div>
          <p class="note">
            This reason will be logged for audit purposes. Be specific about why this resync is needed.
          </p>
        </div>
        <%= f.submit "Trigger Resync",
            class: "btn btn-danger tmp-mt-3",
            data: { confirm: "Are you sure? This will enqueue jobs for every (enterprise, copilot model) pair that has an enterprise-level rule." } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
