<% page_info title: "OAuth enterprise limits — bulk recompute" %>

<%= render layout: "stafftools/stafftools" do %>
  <div class="UnderlineNav UnderlineNav--full UnderlineNav--right tmp-mb-3">
    <div class="container-lg UnderlineNav-container tmp-px-3">
      <span class="UnderlineNav-actions f3">
        <%= link_to "Site Admin", stafftools_path %> /
        <%= link_to "OAuth enterprise limits", stafftools_oauth_enterprise_limits_path %>
      </span>
    </div>
  </div>

  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% component.with_header do |h| %>
      <% h.with_title(tag: :h2) { "Bulk recompute" } %>
    <% end %>
    <% component.with_body do %>
      <p>
        Upload a JSON file containing an array of
        <code>{"app_id": Integer, "user_id": Integer}</code> entries (up to
        <%= Stafftools::OauthEnterpriseLimitsController::MAX_BULK_PAIRS %>).
        Each entry enqueues one <code>OauthEnterpriseLimitJob</code> with
        <code>action: "write"</code>.
      </p>

      <pre class="color-bg-subtle p-2 mt-2 mb-2"><code>[
        { "app_id": 12345, "user_id": 67890 },
        { "app_id": 12345, "user_id": 67891 }
]</code></pre>

      <%= form_with url: recompute_bulk_stafftools_oauth_enterprise_limits_path, method: :post, multipart: true do |form| %>
        <div class="tmp-mb-2">
          <%= form.label :file, "JSON file", for: "oauth_enterprise_limits_file", class: "d-block" %>
          <%= form.file_field :file,
            id: "oauth_enterprise_limits_file",
            accept: "application/json,.json",
            "aria-label": "JSON file containing (app_id, user_id) pairs" %>
        </div>

        <div class="tmp-mt-2 tmp-mb-4">
          <%= form.check_box(:dry_run, { checked: true, class: "tmp-mr-1", id: "oauth_enterprise_limits_dry_run" }, "1", "0") %>
          <%= form.label(:dry_run, "Dry run (parse and validate; do not enqueue)", for: "oauth_enterprise_limits_dry_run") %>
        </div>

        <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit)) { "Upload" } %>
      <% end %>
    <% end %>
  <% end %>

  <% if local_assigns[:pairs].present? %>
    <%= render(Primer::Beta::BorderBox.new(classes: "tmp-mt-3")) do |component| %>
      <% component.with_header do |h| %>
        <% h.with_title(tag: :h3) do %>
          <%= dry_run ? "Dry run preview" : "Enqueued" %>
          (showing first <%= [pairs.size, 50].min %> of <%= pairs.size %>)
        <% end %>
      <% end %>
      <% pairs.first(50).each do |pair| %>
        <% component.with_row { "app_id=#{pair["app_id"]}, user_id=#{pair["user_id"]}" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
