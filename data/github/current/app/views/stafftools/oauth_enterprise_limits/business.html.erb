<% page_info title: "Recompute OAuth enterprise limits — #{business.name}" %>

<%= render layout: "stafftools/stafftools" do %>
  <div class="UnderlineNav UnderlineNav--full UnderlineNav--right tmp-mb-3">
    <div class="container-lg UnderlineNav-container tmp-px-3">
      <span class="UnderlineNav-actions f3">
        <%= link_to "Site Admin", stafftools_path %> /
        Recompute OAuth enterprise limits
      </span>
    </div>
  </div>

  <%= render(Primer::Beta::BorderBox.new) do |box| %>
    <% box.with_header do |header| %>
      <% header.with_title(tag: :h2) { "Recompute OAuth enterprise limits for #{business.name}" } %>
    <% end %>
    <% box.with_row do %>
      <p>
        Recompute <code>oauth_enterprise_limits</code> rows for every OAuth token
        held by a member of any organization in
        <strong><%= business.name %></strong>. Fans out one
        <code>OauthEnterpriseLimitUpdateOrganizationJob</code> per organization,
        which in turn fans out one <code>OauthEnterpriseLimitUpdateUserJob</code>
        per member with at least one OAuth token. For large enterprises this can
        be hundreds of thousands of jobs.
      </p>

      <%= render(Primer::Alpha::Dialog.new(
        size: :medium_portrait,
        title: "Recompute OAuth enterprise limits",
        test_selector: "recompute-oauth-enterprise-limits-business-dialog",
      )) do |dialog| %>
        <% dialog.with_show_button(scheme: :danger) { "Recompute OAuth enterprise limits" } %>
        <%= render(Primer::Alpha::Dialog::Body.new) do %>
          <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
            This will enqueue one <code>OauthEnterpriseLimitUpdateOrganizationJob</code>
            per organization in <strong><%= business.name %></strong>, which
            will in turn enqueue one per member with an OAuth token.
          <% end %>
          <%= form_tag recompute_oauth_enterprise_limits_for_enterprise_stafftools_enterprise_path(business.slug) do %>
            <%= render Primer::Beta::Button.new(scheme: :danger, type: :submit) do %>
              Confirm recompute
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
