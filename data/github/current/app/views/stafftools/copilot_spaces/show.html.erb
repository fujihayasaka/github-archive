<% page_info title: "@#{user.display_login} · Copilot Spaces · Stafftools", selected_link: :copilot_spaces %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h2, display: :flex, align_items: :center) do %>
    <span>
      Copilot Spaces / <%= link_to user.display_login, stafftools_user_copilot_spaces_path(user), class: "Link--primary" %>
    </span>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |border_box| %>
  <% border_box.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Spaces Overview
    <% end %>
  <% end %>

  <% border_box.with_row do %>
    <div class="d-flex flex-justify-between flex-items-center">
      <div class="pr-2">
        <div class="d-flex flex-items-start flex-items-center">
          <label class="mr-2">
            Total Copilot Spaces for @<%= user.display_login %>
          </label>
        </div>
        <p class="note">
          <%= total_spaces %> spaces with <%= total_resources %> total resources
          <% if total_spaces > 0 %>
            <br>
            <%= total_public_spaces %> public, <%= total_private_spaces %> private
            <% if total_shared_private_spaces > 0 %>
              , <%= total_shared_private_spaces %> shared with collaborators
            <% end %>
          <% end %>
        </p>
      </div>
      <div class="d-flex flex-justify-end position-relative">
        <span class="text-bold h4 color-fg-accent"><%= total_spaces %></span>
      </div>
    </div>
  <% end %>
<% end %>

<% if spaces.any? %>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "tmp-mt-3")) do |border_box| %>
    <% border_box.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Spaces List
      <% end %>
    <% end %>

    <% spaces.each do |space| %>
      <% border_box.with_row(display: :flex, justify_content: :space_between, align_items: :center) do %>
        <div class="pr-2 flex-auto">
          <div class="d-flex flex-items-center gap-2 text-bold">
            <%= link_to space.name, copilot_spaces_show_by_number_path(space.owner.display_login, space.number), class: "Link--primary" %>
            <% if space.description.present? %>
              <span class="text-small text-normal color-fg-muted">- <%= truncate(space.description, length: 100) %></span>
            <% end %>
          </div>
          <div class="d-flex flex-items-center gap-3 mt-1">
            <span class="text-small color-fg-muted">
              <%= space.resources.count %> resources
            </span>
            <% if space.creator %>
              <span class="text-small color-fg-muted">
                Created by <%= space.creator.display_login %>
              </span>
            <% end %>
            <span class="text-small color-fg-muted">
              Created <%= time_ago_in_words_js(space.created_at) %>
            </span>
            <span class="text-small color-fg-muted">
              Updated <%= time_ago_in_words_js(space.updated_at) %>
            </span>
          </div>
        </div>
        <div class="d-flex flex-items-center gap-2">
          <%= render Primer::Beta::Label.new(
            scheme: space_visibility_scheme(space),
          ).with_content(space_visibility_text(space)) %>
          <% unless space.base_role == "none" %>
            <%= render Primer::Beta::Label.new(
              scheme: :default,
            ).with_content(format_base_role_label(space.base_role)) %>
          <% end %>
          <% if space.collaborators_count > 0 %>
            <%= render Primer::Beta::Label.new(
              scheme: :success,
            ).with_content("Shared with #{pluralize(space.collaborators_count, 'collaborator')}") %>
          <% end %>
          <div class="tmp-ml-3 tmp-pl-3" style="border-left: 1px solid var(--borderColor-default);">
            <%= render Primer::Beta::Button.new(
              tag: :a,
              href: stafftools_user_copilot_space_path(user, space),
              size: :small,
              scheme: :default,
              "aria-label": "Manage space"
            ) do %>
              <%= primer_octicon("gear", size: :small) %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "tmp-mt-3")) do |border_box| %>
    <% border_box.with_row do %>
      <div class="text-center tmp-py-4">
        <h3 class="color-fg-muted mb-2">No Copilot Spaces</h3>
        <p class="color-fg-muted">This user has not created any Copilot Spaces yet.</p>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render Stafftools::CopilotSpaces::UserBlockComponent.new(user: user) %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "tmp-mt-3")) do |border_box| %>
  <% border_box.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Resources
    <% end %>
  <% end %>

  <% border_box.with_row do %>
    <%= link_to "#{user.display_login} Splunk logs", splunk_search_url("index=* gh.actor.id=#{user.id}") %>
  <% end %>

  <% border_box.with_row do %>
    <%= link_to "User Profile", stafftools_user_overview_path(user) %>
  <% end %>
<% end %>
