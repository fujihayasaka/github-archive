<% page_info title: "@#{org.display_login} · Spark · Stafftools", selected_link: :stafftools_spark %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h2, display: :flex, align_items: :center) do %>
    <span>
      <%= link_to "Spark", stafftools_spark_path %>
      / <%= link_to org.display_login, stafftools_user_spark_path(org), class: "Link--primary" %>
    </span>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |border_box| %>
  <% border_box.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Organization Members with Spark Workbenches
    <% end %>
  <% end %>

  <% if org_members.empty? %>
    <% border_box.with_row do %>
      No members of this organization have Spark workbenches.
    <% end %>
  <% end %>

  <% org_members.each do |member| %>
    <% border_box.with_row(display: :flex, align_items: :center, justify_content: :space_between) do %>
      <div class="flex-auto">
        <div class="d-flex flex-items-center">
          <%= render Primer::Beta::Octicon.new(icon: "person", size: :small, mr: 2) %>
          <%= link_to member.login, stafftools_user_path(member.login), class: "Link--primary text-bold" %>
        </div>
      </div>
      <div class="d-flex flex-items-center">
        <span class="mr-3">
          <%= render Primer::Beta::Counter.new(count: member.spark_count) %>
          <%= "workbench".pluralize(member.spark_count) %>
        </span>
        <%= link_to "View sparks", stafftools_user_spark_path(member.login), class: "btn btn-sm" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if org_members.total_pages > 1 %>
  <div class="paginate-container mt-3">
    <%= will_paginate org_members %>
  </div>
<% end %>
