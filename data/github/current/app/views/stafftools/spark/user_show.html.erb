<% page_info title: "@#{user.display_login} · Spark · Stafftools", selected_link: :stafftools_spark %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h2, display: :flex, align_items: :center) do %>
    <span>
      <%= link_to "Spark", stafftools_spark_path %>
      / <%= link_to user.display_login, stafftools_user_spark_path(user), class: "Link--primary" %>
    </span>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |border_box| %>
  <% border_box.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Spark access
    <% end %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "Does #{user.display_login} have Spark access?",
      value: user.spark_enabled?,
      note: "The ultimate yes/no answer to whether this user can use Spark."
    ) %>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "tmp-mt-3")) do |border_box| %>
  <% border_box.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Access Debug Information
    <% end %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "copilot_user.spark_enabled?",
      value: copilot_user.spark_enabled?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "copilot_workbench feature flag",
      value: user.feature_flag_enabled?(:copilot_workbench, default: false)
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "github_spark feature flag",
      value: user.feature_flag_enabled?(:github_spark, default: false)
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "is_enterprise_managed?",
      value: user.is_enterprise_managed?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "has_cb_access?",
      value: copilot_user.has_cb_access?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "has_ce_access?",
      value: copilot_user.has_ce_access?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "has_pro_plus_access?",
      value: copilot_user.has_pro_plus_access?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "has_pro_access?",
      value: copilot_user.has_pro_access?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "has_cfb_access?",
      value: copilot_user.has_cfb_access?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "has_cfe_access?",
      value: copilot_user.has_cfe_access?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "has_cfi_access?",
      value: copilot_user.has_cfi_access?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "has_limited_access?",
      value: copilot_user.has_limited_access?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "has_copilot_standalone_business?",
      value: copilot_user.has_copilot_standalone_business?
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "enterprises.spark_enabled?",
      value: copilot_user.copilot_businesses.any?(&:spark_enabled?)
    ) %>
  <% end %>

  <% border_box.with_row do %>
    <%= render Stafftools::Spark::StatusRowComponent.new(
      description: "orgs.spark_enabled?",
      value: copilot_user.copilot_enterprise_organizations.any?(&:spark_enabled?)
    ) %>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed, classes: "tmp-mt-3")) do |border_box| %>
  <% border_box.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Spark Workbenches
      <%= render Primer::Beta::Counter.new(count: sparks.total_entries) %>
    <% end %>
  <% end %>

  <% if sparks.empty? %>
    <% border_box.with_row do %>
      This user has no Spark workbenches.
    <% end %>
  <% end %>

  <% sparks.each do |spark| %>
    <% border_box.with_row(display: :flex, align_items: :center, justify_content: :space_between) do %>
      <div class="flex-auto">
        <div class="d-flex flex-items-center">
          <code class="mr-2"><%= spark.uuid_string %></code>
          <strong><%= spark.name %></strong>
        </div>
        <% if spark.description.present? %>
          <p class="note mb-0"><%= spark.description %></p>
        <% end %>
      </div>
      <%= render(Primer::Experimental::Dialog.new(
        dialog_id: "delete-spark-#{spark.uuid_string}-dialog",
        width: :large,
        title: "Delete Spark Workbench?",
        form_url: delete_stafftools_user_spark_path(user, spark.uuid_string),
        form_method: :delete,
        data: { "test-selector": "delete-spark-#{spark.uuid_string}-dialog" }
      )) do |d| %>
        <% d.with_show_button(
          color: :danger,
        ) { "Delete" }%>
        <% d.with_body do %>
          <p>
            This will remove and unpublish this Spark workbench.
          </p>
          <p>
            <strong>UUID:</strong> <code><%= spark.uuid_string %></code><br>
            <strong>Name:</strong> <%= spark.name %>
          </p>
        <% end %>
        <% d.with_button(
          data: { "close-dialog-id": "delete-spark-#{spark.uuid_string}-dialog" }
        ) { "Cancel" } %>
        <% d.with_button(
          type: :submit,
          scheme: :danger,
          data: { "disable-with": "" }
        ) { "Delete" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if sparks.total_pages > 1 %>
  <div class="paginate-container tmp-mt-3">
    <%= will_paginate sparks %>
  </div>
<% end %>
