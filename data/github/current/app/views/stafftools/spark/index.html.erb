<% page_info title: "Spark · Stafftools", selected_link: :stafftools_spark %>

<%= render layout: "stafftools/stafftools" do %>
  <%= render Primer::Beta::Subhead.new do |subhead| %>
    <% subhead.with_heading(tag: :h2) do %>
      Spark Workbenches
    <% end %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |border_box| %>
    <% border_box.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Recent Spark Workbenches
        <%= render Primer::Beta::Counter.new(count: sparks.total_entries) %>
      <% end %>
    <% end %>

    <% if sparks.empty? %>
      <% border_box.with_row do %>
        No Spark workbenches found.
      <% end %>
    <% end %>

    <% sparks.each do |spark| %>
      <% border_box.with_row(display: :flex, align_items: :center, justify_content: :space_between) do %>
        <div class="flex-auto">
          <div class="d-flex flex-items-center mb-1">
            <code class="mr-2"><%= spark.uuid_string %></code>
            <%= link_to spark.name, stafftools_user_spark_path(spark.user.login), class: "Link--primary" %>
          </div>
          <div class="d-flex flex-items-center color-fg-muted">
            <span class="mr-3">
              <%= render Primer::Beta::Octicon.new(icon: "person", size: :small) %>
              <%= link_to spark.user.login, stafftools_user_path(spark.user), class: "Link--muted" %>
            </span>
            <span class="mr-3">
              <%= render Primer::Beta::Octicon.new(icon: "clock", size: :small) %>
              <%= time_ago_in_words(spark.created_at) %> ago
            </span>
          </div>
          <% if spark.description.present? %>
            <p class="note mb-0 mt-1"><%= spark.description %></p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if sparks.total_pages > 1 %>
    <div class="paginate-container mt-3">
      <%= will_paginate sparks %>
    </div>
  <% end %>
<% end %>
