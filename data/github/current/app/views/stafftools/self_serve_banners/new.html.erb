<% page_info title: "Create Banner · Stafftools" %>

<%= render Primer::BaseComponent.new(tag: :div, display: :flex, align_items: :center) do %>
  <div class="container-lg p-4">
    <%= render Primer::Beta::Heading.new(tag: :h1, mb: 4) do %>
      Create Banner
    <% end %>

    <%= form_with(url: create_stafftools_self_serve_banner_path, method: "post", class: "width-full") do |form| %>
      <%= form.label "Banner title" %>
      <%= form.text_field :title,
        required: true,
        class: "form-control width-full mb-3",
        placeholder: "Enter banner title",
        "aria-label": "Banner title"
      %>

      <%= form.label "Banner message" %>
      <%= form.text_area :body,
        required: true,
        class: "form-control width-full mb-3",
        placeholder: "Enter banner message",
        "aria-label": "Banner message",
        rows: 3
      %>

      <%= form.label "Call to action link" %>
      <%= form.text_field :cta_url,
        required: true,
        class: "form-control width-full mb-3",
        placeholder: "Enter call to action link",
        "aria-label": "Call to action link"
      %>

      <%= form.label "Call to action text" %>
      <%= form.text_field :cta_text,
        required: true,
        class: "form-control width-full mb-3",
        placeholder: "Call to action text",
        "aria-label": "Call to action text"
      %>

      <%= form.label "Banner slug" %>
      <span class="note color-fg-muted mb-3 d-block">
        The slug is used to identify the banner and should match the value being passed to the banner component. It should be unique and contain only lowercase letters, numbers, and hyphens. It is important to not edit this without updating the corresponding banner code.
      </span>
      <%= form.text_field :slug,
        required: true,
        class: "form-control width-full mb-3",
        placeholder: "Enter banner slug",
        "aria-label": "Banner slug"
      %>

      <div class="mb-2">
        <%= form.label "Banner is visible" %>
        <%= form.check_box :visibility,
          class: "form-checkbox mr-2 ml-2",
          "aria-label": "Banner visibility"
        %>
      </div>
      <hr>
      <%= form.label "Upload CSV" %>
      <div id="csv-help" class="note color-fg-muted mt-1 mb-3">
        Upload a CSV file containing user ids of users you want to show the banner to and save your changes.
      </div>
      <%= form.file_field :csv_file,
        class: "form-control width-full",
        accept: ".csv",
        "aria-label": "Upload CSV file",
        "aria-describedby": "csv-help"
      %>
      <div id="csv-help" class="note color-fg-muted mt-1 mb-3">
        Upload a CSV file containing user ids to show the banner to.
      </div>

      <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary, mt: 3) do %>
        Save
      <% end %>

      <%= render Primer::Beta::Button.new(tag: :a, href: stafftools_self_serve_banners_path, scheme: :secondary, mt: 3, ml: 2) do %>
        Cancel
      <% end %>
    <% end %>
  </div>
<% end %>
