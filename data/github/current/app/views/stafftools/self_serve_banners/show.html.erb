<%= render Primer::BaseComponent.new(tag: :div, display: :flex, align_items: :center) do %>
  <div class="container-lg p-4" style="width: 100%;">
    <div class="d-flex flex-items-center flex-justify-between mb-4">
      <%= render Primer::Beta::Heading.new(tag: :h1) do %>
        Self-Serve Banners
      <% end %>
      <%= render Primer::Beta::Button.new(
        tag: :a,
        size: :large,
        href: new_stafftools_self_serve_banner_path,
      ) do %>
        <%= primer_octicon(:plus) %>
        New Banner
      <% end %>
    </div>

    <div class="Box">
      <% banners.each do |banner| %>
        <div class="Box-row d-flex flex-items-center">
          <div class="flex-auto" <%= test_selector("self-serve-banner-#{banner[:id]}") %>>
            <%= render Primer::Beta::Text.new(tag: :div, font_size: 4, font_weight: :bold) do %>
              <%= banner[:slug] %>
              <span class="flex-auto ml-1">
                <%= render(Primer::Beta::Octicon.new(banner.visibility? ? :eye : :"eye-closed", size: :small)) %>
              </span>
            <% end %>
            <%= render Primer::Beta::Text.new(font_weight: :bold) do %>
              Title:
            <% end %>
            <%= render Primer::Beta::Text.new do %>
              <%= banner[:title] %>
            <% end %>
          </div>
          <div class="flex-auto">
            <%= Copilot::FeedbackSurvey.number_of_targeted_users(banner.slug) %> users are currently being targeted with this banner
          </div>
          <div class="flex-shrink-0">
            <%= render Primer::Beta::Button.new(
              tag: :a,
              scheme: :link,
              size: :small,
              href: "#{edit_stafftools_self_serve_banner_path(banner[:id])}",
            ) do %>
              <%= primer_octicon(:pencil) %>
              Edit
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

