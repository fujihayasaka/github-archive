<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% page_info title: "Reused payment fingerprints", selected_link: :reused_card_fingerprints %>

<%= render layout: "stafftools/stafftools" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>
      Reused payment fingerprints
    <% end %>
  <% end %>

  <div class="boxed-group">
    <h3>Search for payment fingerprint</h3>
    <div class="boxed-group-inner">
      <p><label for="card-fingerprint">Search by card fingerprint or PayPal email</label></p>
      <%= form_tag lookup_stafftools_reused_card_fingerprints_path,
                    method: :get, id: "fingerprint-lookup" do %>
        <p>
          <%= text_field_tag :card_fingerprint, "", class: "form-control", placeholder: "Enter card fingerprint or PayPal email", id: "card-fingerprint", required: true %>
          <%= render Primer::Beta::Button.new(type: :submit) do %>Search<% end %>
        </p>
      <% end %>
    </div>
  </div>

  <%= render Primer::Beta::Flash.new(mb: 3) do %>
    Use the search above to lookup specific payment fingerprints (card fingerprints and PayPal emails) for investigation.
    Credit card and PayPal reuse across multiple accounts can be an indicator of fraudulent activity.
  <% end %>

  <div class="boxed-group flush">
    <h3>
      View all repeated fingerprints
    </h3>

    <div class="boxed-group-inner">
      <p>
        For a comprehensive view of all payment fingerprints that have been reused across 5 or more customers in the last 30 days, use the Kusto Dashboard:
      </p>
      <p>
        <%= link_to "Kusto Dashboard of all repeated fingerprints", 
            reused_card_fingerprints_kusto_dashboard_url, 
            target: "_blank",
            rel: "noopener noreferrer",
            class: "btn btn-primary" %>
      </p>
    </div>
  </div>
<% end %>
