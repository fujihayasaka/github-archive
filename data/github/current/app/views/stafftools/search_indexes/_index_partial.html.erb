<%# erblint:counter DeprecatedInPrimerCounter 4 %>
<%-
index = index_partial
up_to_date = index.up_to_date?
repair_job = index.repair_job
if current_user.feature_flag_enabled_or_raise?(:native_reindex) # rubocop:disable GitHub/FeatureManagement/NoVexiActorFeatureFlagEnabledOrRaiseUsage
  reindex_job = index.reindex_job
end
col_class = Elastomer.router.multiple_clusters? ? 'col-sm-3' : 'col-sm-4'
-%>
<div class="Box-row d-flex flex-items-center flex-wrap p-2" role="row" aria-label="Elasticsearch index row for <%= index.name %>">
  <div class="col-12 <%= col_class %> d-flex flex-items-center" role="cell">
    <h3 class="sr-only es-index-name" id="index-<%= index.name.parameterize %>-heading">Elasticsearch index <%= index.name %></h3>
    <span class="tooltipped tooltipped-se mr-2 es-icon es-primary <%= 'is-not-set' unless index.primary %>" aria-label="<%= index.name %> is<%= index.primary ? '' : ' not' %> the primary index" tabindex="0" role="img" aria-hidden="false"><%= primer_octicon(index.primary ? :star : :x) %></span><%# erblint:disable Primer::Accessibility::TooltippedMigration %>
    <span class="tooltipped tooltipped-se mr-2 es-icon es-up-to-date <%= up_to_date ? 'green' : 'orange' %>" aria-label="<%= index.name %> mappings are<%= up_to_date ? nil : ' not' %> up to date" tabindex="0" role="img" aria-hidden="false"><%= primer_octicon(up_to_date ? "check" : "x") %></span><%# erblint:disable Primer::Accessibility::TooltippedMigration %>
    <span class="tooltipped tooltipped-se mr-2 es-icon es-searchable<%= index.searchable ? '' : ' is-not-set' %>" aria-label="<%= index.name %> index is<%= index.searchable ? nil : ' not' %> searchable" tabindex="0" role="img" aria-hidden="false"><%= primer_octicon(index.searchable ? "book" : "x") %></span><%# erblint:disable Primer::Accessibility::TooltippedMigration %>
    <span class="tooltipped tooltipped-se es-icon es-writable<%= index.writable ? '' : ' is-not-set' %>" aria-label="<%= index.name %> index is<%= index.writable ? nil : ' not' %> writable" tabindex="0" role="img" aria-hidden="false"><%= primer_octicon(index.writable ? "pencil" : "x") %></span><%# erblint:disable Primer::Accessibility::TooltippedMigration %>
  </div>
  <div class="es-index-name col-12 <%= col_class %> es-text" role="cell"><a href="<%= stafftools_search_index_path index.name %>" aria-labelledby="index-<%= index.name.parameterize %>-heading"><%= index.name %></a></div>
  <% if Elastomer.router.multiple_clusters? %>
    <div class="col-12 col-sm-3 es-text es-index-cluster" role="cell"><%= index.cluster %></div>
  <% end %>
  <div class="col-12 <%= col_class %>" role="cell">
    <% if current_user.feature_flag_enabled_or_raise?(:native_reindex) # rubocop:disable GitHub/FeatureManagement/NoVexiActorFeatureFlagEnabledOrRaiseUsage %>
      <% if repair_job && repair_job.exists? %>
        <div class="es-repair-progress"><%= progress_bar(repair_job.progress, percentage: true, precision: 1) %></div>
      <% elsif reindex_job && reindex_job.exists? %>
        <% if reindex_job.stats[:reindex_error].blank? %>
          <%= progress_bar(reindex_job.progress, percentage: true, precision: 1) %>
        <% else %>
          <%= render Primer::Beta::Octicon.new(icon: "alert", color: :muted) %>
          <%= render(Primer::Beta::Text.new(tag: :span, font_size: :small, color: :muted)) do %>
            An error occurred while fetching the reindex status
          <% end %>
        <% end %>
      <% else %>
        <span class="color-fg-muted">&mdash;</span>
      <% end %>
    <% else %>
      <% if repair_job && repair_job.exists? %>
        <div class="es-repair-progress"><%= progress_bar(repair_job.progress, percentage: true, precision: 1) %></div>
      <% else %>
        <span class="color-fg-muted">&mdash;</span>
      <% end %>
    <% end %>
  </div>
</div>
