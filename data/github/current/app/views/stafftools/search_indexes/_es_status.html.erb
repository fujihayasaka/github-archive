<div class="d-flex flex-wrap pr-2 cluster-status-list">
  <div class="Box Box--condensed Box--shadow p-3 mb-4 col-12 col-sm-6 col-lg-4 cluster-status-box <%= cluster['status'] %>">
    <div class="d-flex flex-justify-between mb-2">
      <span class="f4 text-bold"><%= h cluster['cluster_name'] %></span>
      <span class="ml-2">
        <% status_scheme = case cluster['status']
          when 'green' then :success
          when 'yellow' then :attention
          when 'red' then :danger
          else :default
        end %>
        <%= render Primer::Beta::Label.new(scheme: status_scheme, size: :large) do %>
          <%= h cluster['status'].capitalize %>
        <% end %>
      </span>
    </div>
    <% if cluster['error'] %>
      <div class="color-fg-danger f5 my-2"><%= h cluster['error'] %></div>
    <% else %>
      <h3 class="sr-only" id="es-cluster-status-heading-<%= h cluster['cluster_name'].parameterize %>">Elasticsearch cluster <%= h cluster['cluster_name'] %> status</h3>
      <div class="m-0 d-flex flex-column" role="table" aria-labelledby="es-cluster-status-heading-<%= h cluster['cluster_name'].parameterize %>">
        <% %w[number_of_nodes number_of_data_nodes active_primary_shards active_shards relocating_shards initializing_shards unassigned_shards].each do |key| %>
          <div class="d-flex flex-column flex-sm-row flex-justify-between py-1 border-bottom color-border-muted" role="row">
            <div class="text-normal color-fg-muted text-truncate" role="cell"><%= h key.titleize %></div>
            <div class="text-bold m-0 text-truncate text-sm-right" role="cell"><%= h cluster[key] %></div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
