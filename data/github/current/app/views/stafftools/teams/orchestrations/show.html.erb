<% page_info \
  title: "#{this_user.login} - #{this_team.name} team orchestrations",
  selected_link: :org_teams %>

<%= render Primer::Beta::Subhead.new(hide_border: true) do |component| %>
  <% component.with_heading(
    tag: :h2,
    test_selector: "orchestration-#{orchestration.id}"
  ) do %>
    Orchestration #<%= orchestration.id %>
  <% end %>
<% end %>

<%= render(Stafftools::Orchestrations::ShowComponent.new(orchestration: orchestration)) %>
