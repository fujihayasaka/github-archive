<% if summary[key].present? %>
  <%= render(Primer::Alpha::Dialog.new(id: "summary-#{summary.id}-#{key}", size: :large, title: key)) do |c| %>
    <% c.with_show_button(size: :small) do |c| %>
      View
    <% end %>
    <% c.with_header(show_divider: true) do %>
      <%= key %>
    <% end %>
    <% c.with_body do %>
      <% summary[key].map do |k, v| %>
        <code>
          <%= "#{k}: #{v}" %>
        </code>
        <br>
      <% end %>
    <% end %>
  <% end %>
<% end %>
