<% page_info title: "Copilot Metric Summaries" %>
<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Copilot Metric Summaries
  <% end %>
<% end %>

<div class="overflow-x-auto">
  <table
    class="stafftools-table"
    role="region"
    aria-label="Metric Summaries"
    tabindex="0"
  >
    <thead>
      <tr>
        <th style="min-width: 110px;">Start Date</th>
        <th style="min-width: 110px;">End Date</th>
        <th>Total Seats</th>
        <th>Active Seats</th>
        <th>Inactive Seats</th>
        <th>Dormant Seats</th>
        <th>Code Suggestion Events</th>
        <th>LOC Generated</th>
        <th>Commit Counts</th>
        <th>PRs Merged</th>
        <th>PR Lead Time</th>
      </tr>
    </thead>
    <tbody>
      <% summaries.each do |summary| %>
        <tr>
          <td><%= summary.start_date %></td>
          <td><%= summary.end_date %></td>
          <td><%= summary.total_seats %></td>
          <td><%= summary.active_seats %></td>
          <td><%= summary.inactive_seats %></td>
          <td><%= summary.dormant_seats %></td>
          <td>
            <%= render partial: "stafftools/copilot_metric_summaries/json_dialog",
                       locals: { summary:, key: :code_suggestion_events } %>
          </td>
          <td>
            <%= render partial: "stafftools/copilot_metric_summaries/json_dialog",
                       locals: { summary:, key: :loc_generated } %>
          </td>
          <td>
            <%= render partial: "stafftools/copilot_metric_summaries/json_dialog",
                       locals: { summary:, key: :commit_counts } %>
          </td>
          <td>
            <%= render partial: "stafftools/copilot_metric_summaries/json_dialog",
                       locals: { summary:, key: :prs_merged } %>
          </td>
          <td>
            <%= render partial: "stafftools/copilot_metric_summaries/json_dialog",
                       locals: { summary:, key: :pr_lead_times } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="boxed-group mt-4">
  <h3>Recalculate last 100 days for <%= this_user.display_login %></h3>
  <div class="boxed-group-inner clearfix">
    <p>
      This will queue jobs that will recalculate the last 100 days for this organization.
    </p>
    <%= form_tag stafftools_user_copilot_metric_summaries_path(this_user), method: :put do %>
      <%= render Primer::Beta::Button.new(type: :submit) do %>
        Recalculate
      <% end %>
    <% end %>
  </div>
</div>

<div class="boxed-group dangerzone mt-4">
  <h3>Recalculate last 100 days for ALL ORGS</h3>
  <div class="boxed-group-inner clearfix">
    <h4 class="mb-2">Please check with the Copilot Controls team (#copilot-controls) before running this.</h4>
    <p>
      This will queue a series of jobs that will recalculate the last 100 days for every organization with copilot.
    </p>
    <p>
      <a href="https://app.datadoghq.com/dashboard/te2-74n-tsu/copilot-insights-dashboards-performance?fromUser=false&tile_focus=7384824367406793&from_ts=1747305178955&to_ts=1747319578955&live=true">
        Datadog Job Dashboard
      </a>
      &nbsp;|&nbsp;
      <a href="https://splunk.githubapp.com/en-US/app/gh_reference_app/search?earliest=-15h@h&latest=now&q=search%20index%3D%22prod-resque%22%20%22gh.job.name%22%3D%22Copilot::Metrics::BatchedSummaryJob%22&display.page.search.mode=smart&dispatch.sample_ratio=1&workload_pool=Standard&sid=1747319772.36518_45B3777C-A7B2-4267-8EE8-A2CE9C586BD8">
        Splunk Logs
      </a>
      &nbsp;|&nbsp;
      <a href="https://devportal.githubapp.com/feature-flags/copilot_metrics_batched_summary_job/overview">
        If anything goes wrong, disable this flag. This will make the jobs no-op.
      </a>
    </p>
    <%= form_tag stafftools_user_copilot_metric_summaries_recalculate_all_path(this_user), method: :put do %>
      <%= render Primer::Beta::Button.new(type: :submit, data: { confirm: "Please only proceed if you've confirmed with the Copilot Controls team" }) do %>
        Recalculate for all orgs
      <% end %>
    <% end %>
  </div>
</div>
