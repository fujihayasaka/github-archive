<% page_info title: "#{this_business.name} - Visual Studio Assignments", selected_link: :visual_studio_assignments %>

<%= render partial: "stafftools/businesses/enterprise_licensing/navigation" %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h1) do %>
    Visual Studio Assignments
    <% if agreement_id.present? %>
      <span class="color-fg-muted text-normal f4 ml-2">for agreement <%= agreement_id %></span>
    <% end %>
  <% end %>
<% end %>

<div class="d-flex flex-row gap-3 tmp-mb-4">
  <div class="Box tmp-p-3 flex-1 text-center">
    <%= render(Primer::Beta::Text.new(tag: :div, font_size: :small, color: :muted)) { "Total" } %>
    <%= render(Primer::Beta::Text.new(tag: :div, font_size: 3, font_weight: :semibold)) { (linked_count + unlinked_count).to_s } %>
  </div>
  <div class="Box tmp-p-3 flex-1 text-center">
    <%= render(Primer::Beta::Text.new(tag: :div, font_size: :small, color: :muted)) { "Matched" } %>
    <%= render(Primer::Beta::Text.new(tag: :div, font_size: 3, font_weight: :semibold, color: :success)) { linked_count.to_s } %>
  </div>
  <div class="Box tmp-p-3 flex-1 text-center">
    <%= render(Primer::Beta::Text.new(tag: :div, font_size: :small, color: :muted)) { "Unmatched" } %>
    <%= render(Primer::Beta::Text.new(tag: :div, font_size: 3, font_weight: :semibold, color: :attention)) { unlinked_count.to_s } %>
  </div>
</div>

<%= render Stafftools::BundledLicenseAssignments::ListComponent.new(
  assignments: assignments,
  query: query,
  action: action,
  search_form_path: stafftools_enterprise_bundled_license_assignments_path(this_business)
) %>
