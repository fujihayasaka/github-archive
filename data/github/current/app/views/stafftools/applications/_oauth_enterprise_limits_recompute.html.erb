<%# Recompute the oauth_enterprise_limits row for a single (app_id, user_id)
    pair. Posts to Stafftools::OauthEnterpriseLimitsController#recompute_pair
    which enqueues a single OauthEnterpriseLimitJob with action="write". %>
<% return unless FeatureFlag.vexi.enabled?(Stafftools::OauthEnterpriseLimitsController::FEATURE_FLAG, default: false) %>

<hr>
<h3 class="f5">OAuth enterprise limits</h3>
<p class="color-fg-muted">
  Recompute the <code>oauth_enterprise_limits</code> row for this app and a
  specific user. Defaults to <strong><%= this_user.login %></strong>
  (id <code><%= this_user.id %></code>); change the User ID to recompute for a
  different user.
</p>
<%= form_tag recompute_oauth_enterprise_limits_stafftools_user_application_path(this_user, app) do %>
  <dl class="form-group">
    <dt><label for="recompute-user-id">User ID</label></dt>
    <dd>
      <input type="number" class="form-control short" id="recompute-user-id"
        name="user_id_to_recompute" value="<%= this_user.id %>" min="1" required>
      <%= render Primer::Beta::Button.new(scheme: :primary, type: :submit) do %>
        Recompute
      <% end %>
    </dd>
  </dl>
<% end %>
