<% if scim_managed_enterprise?(this_business) || !GitHub.single_business_environment? %>
  <%= render Primer::Beta::Subhead.new(spacious: spacious) do |component| %>
    <% component.with_heading(tag: :h2) do %>Single sign-on<% end %>
  <% end %>
  <p class="color-fg-muted">
    <% if this_business.saml_provider.present? %>
      <%= primer_octicon(:"shield-lock", mr: 2) %>
      SAML single sign-on is <strong>enabled</strong> for the enterprise.
    <% elsif this_business.oidc_provider.present? %>
      <%= primer_octicon(:"shield-lock", mr: 2) %>
      OIDC single sign-on is <strong>enabled</strong> for the enterprise.
    <% else %>
      <%= primer_octicon(:x, mr: 2) %>
      Single sign-on is <strong>disabled</strong> for the enterprise.
      <% provider_type = this_business.removing_external_provider_type %>
      <% if provider_type.present? %>
        <div class="tmp-mt-2">
          <p>
            <%= primer_octicon(:alert, mr: 2, color: :attention) %>
            External provider removal is <strong>in progress</strong>. Background jobs are still running.
            For larger enterprises, this may take several hours or days to finish. Refresh page to see latest status.
          </p>
          <div class="Box Box--condensed tmp-mt-2">
            <ul>
              <li class="Box-row">
                <strong>Provider type being removed:</strong>
                <code><%= provider_type %></code>
              </li>
              <li class="Box-row">
                <strong>External identities remaining:</strong>
                <%= ExternalIdentity.where(business_id: this_business.id, provider_type: provider_type).count %>
              </li>
              <li class="Box-row">
                <em>When the count reaches 0, the removal KV flag will be cleared automatically and this banner will be replaced with a success message on the next page load.</em>
              </li>
            </ul>
          </div>
        </div>
      <% else %>
        <div class="tmp-mt-2">
          <p>
            <%= primer_octicon(:check, mr: 2, color: :success) %>
            No external provider removal is in progress and no related authentication background jobs are running. The process either completed successfully or was never started.
          </p>
        </div>
      <% end %>
    <% end %>
  </p>

  <% if this_business.saml_provider.present? %>
    <div class="Box Box--condensed tmp-mt-3">
      <div class="Box-header">
        <h3 class="Box-title">
          SAML Identity Provider settings
        </h3>
      </div>
      <ul>
        <li class="Box-row">
          <strong>Sign on URL</strong>
          <div class="mt-2">
            <pre><%= this_business.saml_provider.sso_url %></pre>
          </div>
        </li>
        <li class="Box-row">
          <strong>Issuer</strong>
          <div class="mt-2">
            <pre><%= this_business.saml_provider.issuer %></pre>
          </div>
        </li>
        <li class="Box-row">
          <strong>Public certificate</strong>
          <div class="mt-2">
            <pre><%= this_business.saml_provider.idp_certificate %></pre>
          </div>
        </li>
        <li class="Box-row">
          <strong>Public certificate validity dates</strong>
          <%= render Stafftools::SamlProvider::CertificateDatesComponent.new(certificate: this_business.saml_provider.idp_certificate) %>
        </li>
        <li class="Box-row">
          <strong>Public certificate issuer</strong>
          <%= render Stafftools::SamlProvider::CertificateIssuerComponent.new(certificate: this_business.saml_provider.idp_certificate, classes: 'mt-2') %>
        </li>
        <li class="Box-row">
          <strong>Public certificate subject</strong>
          <%= render Stafftools::SamlProvider::CertificateSubjectComponent.new(certificate: this_business.saml_provider.idp_certificate, classes: 'mt-2') %>
        </li>
        <li class="Box-row">
          <strong>Signature method</strong>
          <div class="mt-2">
            <pre><%= this_business.saml_provider.signature_method %></pre>
          </div>
        </li>
        <li class="Box-row">
          <strong>Digest method</strong>
          <div class="mt-2">
            <pre><%= this_business.saml_provider.digest_method %></pre>
          </div>
        </li>
      </ul>
    </div>

    <% unless this_business.enterprise_managed_user_enabled? %>
      <div class="Box Box--condensed tmp-mt-3" <%= test_selector("provisioning_settings_selector")%>>
        <div class="Box-header">
          <h3 class="Box-title">
            Provisioning settings
          </h3>
        </div>
        <ul>
          <% if FeatureFlag.vexi.enabled?(:enterprise_idp_provisioning, this_business, default: false) %>
            <li class="Box-row">
              <strong <%= test_selector "enterprise_idp_selector" %>>Enterprise IdP provisioning</strong>
              <div class="mt-2">
                <p class="color-fg-muted">
                    Enabled
                </p>
              </div>
            </li>
          <% end %>
          <li class="Box-row">
            <strong>SAML user provisioning</strong>
            <div class="mt-2">
              <p class="color-fg-muted">
                <% if this_business.saml_provider.provisioning_enabled? %>
                  Enabled
                <% else %>
                  Disabled
                <% end %>
              </p>
            </div>
          </li>
          <li class="Box-row">
          <strong>SAML user deprovisioning</strong>
          <div class="mt-2">
              <p class="color-fg-muted">
                <% if this_business.saml_provider.saml_deprovisioning_enabled? %>
                  Enabled
                <% else %>
                  Disabled
                <% end %>
              </p>
            </div>
          </li>
          <li class="Box-row">
            <strong>SCIM user provisioning and deprovisioning</strong>
            <div class="mt-2">
              <p class="color-fg-muted">
                <% if this_business.external_provider&.scim_provisioning_state_enabled? %>
                  Enabled
                <% else %>
                  Disabled
                <% end %>
              </p>
            </div>
          </li>
        </ul>
      </div>
    <% end %>

    <div class="Box Box--condensed tmp-mt-3">
      <div class="Box-header">
        <h3 class="Box-title">
          SAML members
        </h3>
      </div>
      <ul>
        <li class="Box-row">
          <%= link_to pluralize(this_business.linked_external_members_count, "linked member"), linked_external_members_stafftools_enterprise_external_identities_path(this_business) %>
        </li>

        <li class="Box-row">
          <%= link_to pluralize(this_business.unlinked_external_members_count, "unlinked member"), unlinked_external_members_stafftools_enterprise_external_identities_path(this_business) %>
        </li>

        <li class="Box-row" <%= test_selector "unlinked-external-identities" %>>
          <%= link_to pluralize(this_business.unlinked_external_identities_count, "unlinked external identity"), unlinked_external_identities_stafftools_enterprise_external_identities_path(this_business) %>
        </li>

        <% unless this_business.external_provider&.scim_provisioning_state_enabled? %>
          <li class="Box-row">
            <%= link_to pluralize(this_business.linked_saml_orgs.count, "linked organization"), linked_saml_orgs_stafftools_enterprise_external_identities_path(this_business) %>
          </li>
        <% end %>
      </ul>
    </div>

    <% unless this_business.enterprise_server_scim_enabled? %>
      <div class="Box Box--danger tmp-mt-3">
        <div class="Box-row">
          <%= render layout: "shared/details_dialog", locals: {
            button_text: "Disable SAML SSO",
            button_class: "btn btn-danger",
            details_class: "float-right mt-1",
            title: "Disable SAML SSO?",
          } do %>
            <%= render Primer::Alpha::Banner.new(scheme: :danger, full: true) do %>
              This action is destructive and cannot be undone. Please ensure appropriate authorization has been obtained.
            <% end %>
            <div class="Box-body overflow-auto">
              <% if this_business.enterprise_managed_user_enabled? %>
                <p class="tmp-mb-2 color-fg-danger">
                  Before proceeding, share the
                  <%= link_to(
                    "documentation",
                    "#{GitHub.help_url}/enterprise-cloud@latest/admin/managing-iam/configuring-authentication-for-enterprise-managed-users/disabling-authentication-and-provisioning-for-enterprise-managed-users#about-disabled-authentication-for-enterprise-managed-users",
                    class: "Link--inTextBlock",
                    target: "_blank",
                    rel: "noopener noreferrer"
                  ) %>
                  with the customer and confirm they understand the impact. For large enterprises, background jobs may take several hours or days to finish removing external provider data.
                </p>
              <% end %>
              <p class="tmp-mb-2">
                Disabling SAML SSO for the <strong><%= this_business.name %></strong> enterprise will trigger the following changes:
              </p>
              <ul class="tmp-ml-3 tmp-mb-3">
                <% if this_business.enterprise_managed_user_enabled? %>
                  <li>All enterprise managed user accounts will be <strong>suspended</strong></li>
                  <li>All external identities will be <strong>permanently deleted</strong></li>
                  <li>All personal access tokens, user SSH keys, and GPG keys will be <strong>permanently deleted</strong></li>
                  <li>All external groups provisioned by SCIM will be <strong>deleted</strong>, along with their team mappings</li>
                  <li>Avatar data for managed user accounts will be <strong>permanently removed</strong></li>
                <% else %>
                  <li>All linked SAML identities will be <strong>removed</strong></li>
                  <li>Previously authorized SSH keys and personal access tokens will need to be <strong>re-authorized</strong></li>
                  <li>Team sync mappings will be <strong>removed</strong></li>
                <% end %>
                <li>The SAML identity provider configuration will be removed and must be re-entered to re-enable SSO</li>
              </ul>
              <%= form_tag stafftools_enterprise_external_provider_path(this_business),
                method: :delete do %>
                <dl class="form-group">
                  <dt><label for="reason">Reason for disabling</label></dt>
                  <dd>
                    <input class="form-control" type="text" name="reason" id="reason"
                      placeholder="Please provide an explanation for the audit log." required autofocus>
                  </dd>
                </dl>
                <%= render Primer::Beta::Button.new(type: :submit, block: true, scheme: :danger) do %>I understand, disable SAML SSO<% end %>
              <% end %>
            </div>
          <% end %>

          <div class="listgroup-item-title">Remove SAML Identity Provider</div>
          <div class="listgroup-item-body">
            <strong>Warning:</strong> This will completely disable and remove the SAML Identity Provider configuration
            for the enterprise. For EMU enterprises, all user credentials (SSH keys, PATs, GPG keys) will be permanently destroyed
            and all managed users will be suspended.
          </div>
        </div>
      </div>
    <% end %>
  <% elsif this_business.oidc_provider.present? %>
    <div class="Box Box--condensed tmp-mt-3">
      <div class="Box-header">
        <h3 class="Box-title">
          OIDC Identity Provider settings
        </h3>
      </div>
      <ul>
        <li class="Box-row">
          <strong>Tenant Id</strong>
          <div class="mt-2">
            <pre><%= this_business.oidc_provider.tenant_id %></pre>
          </div>
        </li>
        <li class="Box-row">
          <strong>IdP Provider</strong>
          <div class="mt-2">
            <pre><%= this_business.oidc_provider.oidc_provider %></pre>
          </div>
        </li>
      </ul>
    </div>

    <div class="Box Box--condensed tmp-mt-3">
      <div class="Box-header">
        <h3 class="Box-title">
          OIDC members
        </h3>
      </div>
      <ul>
        <li class="Box-row">
          <%= link_to pluralize(this_business.linked_external_members.count, "linked member"), linked_external_members_stafftools_enterprise_external_identities_path(this_business) %>
        </li>

        <li class="Box-row">
          <%= link_to pluralize(this_business.unlinked_external_members.count, "unlinked member"), unlinked_external_members_stafftools_enterprise_external_identities_path(this_business) %>
        </li>

        <li class="Box-row" <%= test_selector "unlinked-external-identities" %>>
          <%= link_to pluralize(this_business.unlinked_external_identities_count, "unlinked external identity"), unlinked_external_identities_stafftools_enterprise_external_identities_path(this_business) %>
        </li>
      </ul>
    </div>

    <% unless this_business.enterprise_server_scim_enabled? %>
      <div class="Box Box--danger tmp-mt-3">
        <div class="Box-row">
          <%= render layout: "shared/details_dialog", locals: {
            button_text: "Disable OIDC SSO",
            button_class: "btn btn-danger",
            details_class: "float-right mt-1",
            title: "Disable OIDC SSO?",
          } do %>
            <%= render Primer::Alpha::Banner.new(scheme: :danger, full: true) do %>
              This action is destructive and cannot be undone. Please ensure appropriate authorization has been obtained.
            <% end %>
            <div class="Box-body overflow-auto">
              <% if this_business.enterprise_managed_user_enabled? %>
                <p class="tmp-mb-2 color-fg-danger">
                  Before proceeding, share the
                  <%= link_to(
                    "documentation",
                    "#{GitHub.help_url}/enterprise-cloud@latest/admin/managing-iam/configuring-authentication-for-enterprise-managed-users/disabling-authentication-and-provisioning-for-enterprise-managed-users#about-disabled-authentication-for-enterprise-managed-users",
                    class: "Link--inTextBlock",
                    target: "_blank",
                    rel: "noopener noreferrer"
                  ) %>
                  with the customer and confirm they understand the impact. For large enterprises, background jobs may take several hours or days to finish removing external provider data.
                </p>
              <% end %>
              <p class="tmp-mb-2">
                Disabling OIDC SSO for the <strong><%= this_business.name %></strong> enterprise will trigger the following changes:
              </p>
              <ul class="tmp-ml-3 tmp-mb-3">
                <% if this_business.enterprise_managed_user_enabled? %>
                  <li>All enterprise managed user accounts will be <strong>suspended</strong></li>
                  <li>All external identities will be <strong>permanently deleted</strong></li>
                  <li>All personal access tokens, user SSH keys, and GPG keys will be <strong>permanently deleted</strong></li>
                  <li>All external groups provisioned by SCIM will be <strong>deleted</strong>, along with their team mappings</li>
                  <li>Avatar data for managed user accounts will be <strong>permanently removed</strong></li>
                <% else %>
                  <li>All linked external identities will be <strong>removed</strong></li>
                <% end %>
                <li>The OIDC identity provider configuration will be removed and must be re-entered to re-enable SSO</li>
              </ul>
              <%= form_tag stafftools_enterprise_external_provider_path(this_business),
                method: :delete do %>
                <dl class="form-group">
                  <dt><label for="reason">Reason for disabling</label></dt>
                  <dd>
                    <input class="form-control" type="text" name="reason" id="reason"
                      placeholder="Please provide an explanation for the audit log." required autofocus>
                  </dd>
                </dl>
                <%= render Primer::Beta::Button.new(type: :submit, block: true, scheme: :danger) do %>I understand, disable OIDC SSO<% end %>
              <% end %>
            </div>
          <% end %>

          <div class="listgroup-item-title">Remove OIDC Identity Provider</div>
          <div class="listgroup-item-body">
            <strong>Warning:</strong> This will completely disable and remove the OIDC Identity Provider configuration
            for the enterprise. For EMU enterprises, all user credentials (SSH keys, PATs, GPG keys) will be permanently destroyed
            and all managed users will be suspended.
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if this_business.external_provider_enabled? || this_business.organization_saml_enabled? %>
    <%= render("stafftools/businesses/single_sign_on_setting",
      heading_text: "SSO lockdown",
      toggle_label: "SSO lockdown is",
      toggle_description: safe_join([
        "If enabled, all authentication via SSO will be blocked except for enterprise owners. ",
      ]),
      toggle_checked: this_business.sso_lockdown_enabled?,
      test_selector_text: "sso-lockdown",
    ) %>
  <% end %>

  <% if this_business.enterprise_managed_user_enabled? %>
    <%= render("stafftools/businesses/single_sign_on_setting",
      heading_text: "Single sign-on settings",
      toggle_label: "Automatic redirect setting is",
      toggle_description: safe_join([
        "If enabled, automatically redirect users to an enterprise single sign on page for this enterprise. ",
      ]),
      toggle_checked: this_business.sso_redirect_enabled?,
      test_selector_text: "sso-automatically-redirect-users",
    ) %>

    <%= render("stafftools/businesses/single_sign_on_setting",
      heading_text: "Open SCIM configuration",
      toggle_label: "Open SCIM configuration is",
      toggle_description: safe_join([
        "If enabled, allows enterprise to use open SCIM when provisioning users and security group. ",
      ]),
      toggle_checked: this_business.open_scim_enabled?,
      test_selector_text: "open-scim-configuration",
    ) %>

    <% if !GitHub.multi_tenant_enterprise? && !GitHub.enterprise? %>
      <%= render("stafftools/businesses/single_sign_on_setting",
        heading_text: "Proxy Security Header",
        toggle_label: "Proxy security header configuration is",
        toggle_description: safe_join([
          "If enabled, the enterprise will be able to use proxy security header. ",
          "The enterprise must be a premium plus customer to use this feature. ",
        ]),
        toggle_aria_label: "proxy security header",
        toggle_checked: this_business.proxy_security_header_enabled?,
        toggle_path: stafftools_enterprise_proxy_security_header_path(this_business),
        test_selector_text: "proxy-security-header",
      ) %>
    <% end %>
  <% end %>

  <% if this_business.saml_sso_enabled? && !this_business&.enterprise_managed_user_enabled? %>
    <%= render Primer::Beta::Subhead.new(spacious: true) do |component| %>
      <% component.with_heading(tag: :h2) do %>Team synchronization<% end %>
    <% end %>
    <p class="color-fg-muted">
      <% if this_business.team_sync_enabled? %>
        <%= primer_octicon(:check, mr: 2) %>
        Team synchronization is <strong>enabled</strong> for this enterprise.
        <div class="Box" <%= test_selector("team-sync-settings") %>>
          <div class="Box-row">
            <div class="text-small tmp-pr-3 d-inline">
              <strong><%= this_business.team_sync_tenant.provider_type %></strong>
              <code class="color-fg-muted"><%= this_business.team_sync_tenant.provider_id %></code><br>
            </div>
          </div>
        </div>

        <br>Team Sync <strong><%= this_business.team_sync_tenant.forbid_organization_invites? ? "cannot" : "can" %></strong> re-invite past members to this organization that were removed by an organization owner
      <% else %>
        <%= primer_octicon(:x, mr: 2) %>
        Team synchronization is <strong>disabled</strong> for this enterprise.
      <% end %>
    </p>
  <% end %>
<% end %>
