<% page_info title: "#{this_business.name} - Product Enablements", selected_link: :product_enablements %>

<div class="d-flex flex-column">
  <%= render "stafftools/businesses/enterprise_licensing/navigation" %>

  <%= render_react_partial(
    name: "licensify-product-enablements",
    disable_ssr: true,
    props: {
      customerId: this_business.customer_id.to_s,
      products: ['sdlc', 'ghas', 'code_security', 'secret_protection', 'copilot'],
      enablementTypes: Stafftools::Customers::ProductEnablementsController::SUPPORTED_ENABLEMENT_TYPES,
      sourceTypes: ['organization', 'enterprise_account'],
    }
  ) %>
</div>
