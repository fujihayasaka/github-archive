<% if users.any? %>
  <% users.each do |user| %>
    <li class="autocomplete-item" data-autocomplete-value="<%= user.display_login %>" role="option">
      <%= avatar_for user, 20, class: "avatar", "aria-hidden": "true" %>
      <%= user.display_login %>
      <% if user.display_name.present? %>
        <small class="text-normal"><%= user.display_name %></small>
      <% end %>
    </li>
  <% end %>
<% elsif query.present? %>
  <li class="autocomplete-item disabled" data-autocomplete-value="<%= query %>" aria-disabled="true" role="option">
    No matching members found
  </li>
<% end %>
