<% page_info title: this_business.name, selected_link: :business_people %>

<% members_title ||= "Members" %>
<% members_url ||= stafftools_enterprise_members_path(this_business) %>
<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    <%= link_to "People", stafftools_enterprise_people_path(this_business) %>
    / <%= link_to members_title, members_url %>
    / <%= this_member.login %>
  <% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(padding: :condensed) do |box| %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">ID</div>
      <div class="col-10" <%= test_selector "business-user-account-id" %>>
        <%= this_member.id %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Created</div>
      <div class="col-10">
        <%= this_member.created_at %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Updated</div>
      <div class="col-10">
        <%= this_member.updated_at %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Login</div>
      <div class="col-10">
        <%= this_member.login %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">User</div>
      <div class="col-10">
        <% if this_member.user.present? %>
          <%= render(Primer::Beta::Link.new(
            href: stafftools_user_path(this_member.user),
            test_selector: "user-link"
          )) { this_member.user.login } %>
        <% else %>
          None
        <% end %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Enterprise roles</div>
      <div class="col-10">
        <%= this_member.business_roles.join(", ") %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">License</div>
      <div class="col-10">
        <%= this_member.ghec_license_type %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">2FA status</div>
      <div class="col-10">
        <%= this_member.two_factor_status %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Profile name</div>
      <div class="col-10">
        <%= this_member.profile_name %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Verified emails</div>
      <div class="col-10">
        <%= this_member.verified_emails %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Cost center</div>
      <div class="col-10">
        <%= this_member.cost_center %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Spammy</div>
      <div class="col-10">
        <%= this_member.spammy %>
      </div>
    </div>
  <% end %>
  <% box.with_row(clearfix: true) do %>
    <div class="d-flex">
      <div class="col-3 text-bold">Last enterprise activity</div>
      <div class="col-10">
        <%= this_member.last_business_activity_at %>
      </div>
    </div>
  <% end %>
<% end %>
