<%= render Primer::Beta::Heading.new(tag: :h3, mb: 2, mt: 5, font_size: 4) do %>
  <%= heading_text %>
<% end %>
<%= render Primer::Box.new(border_radius: 2, border: true, test_selector: "single-sign-on-settings-#{test_selector_text}") do %>
  <%
    toggle_path ||= "NA"
    toggle_visible = toggle_path != "NA"
    enabled_label = toggle_checked ? "enabled" : "disabled"
  %>
  <%= render Primer::Box.new(border: :bottom, p: 3) do %>
    <%= render Primer::Box.new(display: :flex) do %>
      <%= render Primer::Box.new(w: :full) do %>
        <%= render Primer::Beta::Heading.new(tag: :h4, font_size: 5) do %>
          <%= toggle_label %>
          <%= enabled_label %>.
        <% end %>
        <%= render Primer::Box.new(mt: 1, color: :subtle) do %>
          <%= toggle_description %>
        <% end %>
      <% end %>

      <% if toggle_visible %>
        <div>
          <%= render Primer::Alpha::ToggleSwitch.new(
            src: toggle_path,
            aria: { label: toggle_aria_label + " " + enabled_label },
            size: :small,
            checked: toggle_checked,
            csrf_token: authenticity_token_for(toggle_path),
            mt: 1,
          ) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
