<% page_info title: "Personal Access Token policies - #{this_business.name}", selected_link: :business_policies %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Personal Access Token policies<% end %>
<% end %>

<%= render(Primer::Box.new(flex: 1, display: :flex, direction: :column)) do %>
  <%= render(Primer::Beta::Heading.new(tag: :h3, mb: 2)) { "Fine-grained Personal Access Tokens" } %>

  <% if this_business.patsv2_enabled? %>
    <% pat_restriction_delegated = this_business.personal_access_tokens_delegated_policy? %>
    <% pat_restricted = this_business.personal_access_tokens_restricted? %>
    <% pat_enforced = !pat_restriction_delegated && !pat_restricted %>

    <%= render(Primer::Beta::BorderBox.new(mb: 4, test_selector: "stafftools-fgpat-access-restriction-notice")) do |component| %>
      <% component.with_header(font_weight: :emphasized) { "Access Restriction" } %>
      <% component.with_body do %>
        <% if pat_restriction_delegated %>
          <strong>Delegated to Organizations</strong> &ndash; Organization administrators can restrict or permit access via FGPATs.
        <% elsif pat_restricted %>
          <strong>Restricted</strong> &ndash; FGPATs do not have access to the enterprise.
        <% elsif pat_enforced %>
          <strong>Permitted</strong> &ndash; FGPATs are permitted to access the enterprise.
        <% end %>
      <% end %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(mb: 4, test_selector: "stafftools-fgpat-auto-approval-notice")) do |component| %>
      <% component.with_header(font_weight: :emphasized) { "Auto-Approval" } %>
      <% component.with_body do %>
        <% auto_approval_delegated = this_business.pat_requests_auto_approval_delegated_policy? %>
        <% auto_approval_enabled = this_business.pat_requests_auto_approved? %>
        <% auto_approval_disabled = !auto_approval_delegated && !auto_approval_enabled %>

        <% if pat_restricted %>
          <strong>N/A</strong> &ndash; FGPATs are restricted for this enterprise.
        <% elsif auto_approval_delegated %>
          <strong>Delegated to Organizations</strong> &ndash; All organizations can choose to require administrator approval of FGPATs. By default, approval is required.
        <% elsif auto_approval_disabled %>
          <strong>Disabled</strong> &ndash; FGPATs that target organizations in the enterprise require approval. Org admin cannot override this setting.
        <% elsif auto_approval_enabled %>
          <strong>Enabled</strong> &ndash; Org members are able to create FGPATs that target organizations without providing a justification or getting approval.
        <% end %>
      <% end %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(mb: 4, test_selector: "stafftools-fgpat-expiration-limit-notice")) do |component| %>
      <% component.with_header(font_weight: :emphasized) { "Token Expiration Limit" } %>
      <% component.with_body do %>
        <% if this_business.fine_grained_personal_access_token_expiration_limit_enabled? %>
          Tokens that target this enterprise and its organizations must expire within <%= this_business.fine_grained_personal_access_token_expiration_limit %> days of creation.
          Enterprise administrators are <%= this_business.fine_grained_personal_access_token_expiration_limit_exemption_enabled? ? "" : "not " %>exempt from this policy.
        <% else %>
          No expiration limit is enforced for this enterprise.
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render(Primer::Beta::Text.new(mb: 4)) { "This business has not yet onboarded to Fine-grained Personal Access Tokens." } %>
  <% end %>

  <%= render(Primer::Beta::Heading.new(tag: :h3, mb: 2)) { "Personal Access Tokens (classic)" } %>
  <% legacy_pat_restricted = this_business.legacy_personal_access_tokens_restricted? %>

  <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
    <% component.with_header(font_weight: :emphasized) { "Access Restriction" } %>
    <% component.with_body do %>
      <% legacy_pat_restriction_delegated = this_business.legacy_personal_access_tokens_delegated_policy? %>
      <% legacy_pat_enforced = !legacy_pat_restriction_delegated && !legacy_pat_restricted %>

      <% if legacy_pat_restriction_delegated %>
        <strong>Delegated to Organizations</strong> &ndash; Organization administrators can restrict or permit access via PATs (classic).
      <% elsif legacy_pat_restricted %>
        <strong>Restricted</strong> &ndash; PATs (classic) do not have access to your enterprise.
      <% elsif legacy_pat_enforced %>
        <strong>Permitted</strong> &ndash; PATs (classic) are permitted to access your enterprise.
      <% end %>
    <% end %>
  <% end %>

  <% unless legacy_pat_restricted %>
    <%= render(Primer::Beta::BorderBox.new(mb: 4, test_selector: "stafftools-pat-classic-expiration-limit-notice")) do |component| %>
      <% component.with_header(font_weight: :emphasized) { "Token Expiration Limit" } %>
      <% component.with_body do %>
        <% if this_business.personal_access_token_classic_expiration_limit_enabled? %>
          <strong>Expiration Limit Enabled</strong> &ndash;
          Tokens used against resources belonging to this enterprise must expire within <%= this_business.personal_access_token_classic_expiration_limit %> days of creation.
          Enterprise administrators are <%= this_business.personal_access_token_classic_expiration_limit_exemption_enabled? ? "" : "not " %>exempt from this policy.
        <% else %>
          No expiration limit is enforced for this enterprise.
        <% end %>
      <% end %>
    <% end %>
  <% end %>

<% end %>
