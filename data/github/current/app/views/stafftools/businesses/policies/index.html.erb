<% page_info title: "Policies - #{this_business.name}", selected_link: :business_policies %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Policies<% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(padding: :condensed) do |component| %>
  <% component.with_row do %>
    <%= link_to "Repository policies", stafftools_enterprise_policy_path(this_business, "repositories") %>
  <% end %>
  <% component.with_row do %>
    <%= link_to "Actions policies", stafftools_enterprise_policy_path(this_business, "actions") %>
  <% end %>
  <% component.with_row do %>
    <%= link_to "Project policies", stafftools_enterprise_policy_path(this_business, "projects") %>
  <% end %>
  <% component.with_row do %>
    <%= link_to "Code security policies", stafftools_enterprise_policy_path(this_business, "code_security") %>
  <% end %>
  <% component.with_row do %>
    <%= link_to "Personal Access Token policies", stafftools_enterprise_policy_path(this_business, "personal-access-tokens") %>
  <% end %>
<% end %>
