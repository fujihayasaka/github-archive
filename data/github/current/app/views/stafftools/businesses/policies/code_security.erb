<% page_info title: "Code Security policies - #{this_business.name}", selected_link: :business_policies %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Code security policies<% end %>
<% end %>

<%= render(Primer::Beta::Heading.new(tag: :h3)) { "Dependency insights" } %>
<p>
  <strong><%= view.button_text %></strong> &ndash;
  <%= view.selected_option[:description] %>
</p>

<%= render(Primer::Beta::Heading.new(tag: :h3)) { "Dependabot alerts" } %>
<p>
  <strong>
    <%= this_business.repo_admins_can_modify_dependabot_alerts_enablement? ? 'Allowed' : 'Not Allowed' %>
  </strong> &ndash;
  For all organizations,
  repository admins can enable or disable Dependabot alerts.
</p>

<% if this_business.advanced_security_products_bundled? %>
  <%= render(Primer::Beta::Heading.new(tag: :h3)) { "GitHub Advanced Security" } %>
  <p>
    <strong>
      <%= this_business.repo_admins_can_modify_advanced_security_enablement? ? 'Allowed' : 'Not Allowed' %>
    </strong> &ndash;
    For all organizations,
    repository admins can enable or disable GitHub Advanced Security.
  </p>
<% else %>
  <%= render(Primer::Beta::Heading.new(tag: :h3)) { "GitHub Code Security" } %>
  <p>
    <strong>
      <%= this_business.repo_admins_can_modify_code_security_enablement? ? 'Allowed' : 'Not Allowed' %>
    </strong> &ndash;
    For all organizations,
    repository admins can enable or disable GitHub Code Security.
  </p>
<% end %>

<%= render(Primer::Beta::Heading.new(tag: :h3)) { "Secret Scanning" } %>
<p>
  <strong>
    <%= this_business.repo_admins_can_modify_secret_scanning_settings? ? 'Allowed' : 'Not Allowed' %>
  </strong> &ndash;
  For all organizations,
  repository admins can enable or disable Secret Scanning.
</p>

<%= render(Primer::Beta::Heading.new(tag: :h3)) { "AI detection in secret scanning" } %>
<p>
  <strong>
    <%= this_business.repo_admins_can_modify_generic_secrets_settings? ? 'Allowed' : 'Not Allowed' %>
  </strong> &ndash;
  For all organizations,
  repository admins can enable or disable AI detection in secret scanning.
</p>

<%= render(Primer::Beta::Heading.new(tag: :h3)) { "Copilot Autofix" } %>
<p>
  <strong>
    <%= this_business.code_scanning_autofix_policy_allowed? ? 'Allowed' : 'Not Allowed' %>
  </strong> &ndash;
  For all organizations,
  organization and repository admins can choose to enable or disable Copilot Autofix
</p>


<%= render(Primer::Beta::Heading.new(tag: :h3)) { "GitHub Advanced Security availability" } %>
<p>
  <% if this_business.all_members_can_enable_advanced_security? %>
    <strong>Allowed</strong> &ndash;
     All organizations can enable GitHub Advanced Security.
  <% elsif this_business.no_members_can_enable_advanced_security? %>
    <strong>Not available</strong> &ndash;
     No organizations can enable GitHub Advanced Security.
  <% elsif this_business.selected_members_can_enable_advanced_security? %>
    <strong>Selected organizations</strong> &ndash;
     Selected organizations can enable GitHub Advanced Security.

    <%= render Primer::Beta::BorderBox.new(classes: "js-scanning-alert-list js-check-all-container", id: "matching-orgs-list") do |component| %>
      <% component.with_header(display: :flex, align_items: :center, justify_content: :space_between, style: "gap: 16px;") do |header| %>
        <% header.with_title(tag: :h3, display: :flex, align_items: :center, style: "min-height: 32px; gap: 16px;") do %>
          Organizations
        <% end %>
      <% end %>

      <% view.orgs.each do |org| %>
        <% component.with_row do %>
          <%= render(Primer::Box.new(
            display: :flex,
            justify_content: :space_between,
            align_items: :center)
          ) do %>
            <%= render(Primer::Box.new(
              display: :flex,
              align_items: :center)
            ) do %>
              <%= render(Primer::Box.new(px: 3)) do %>
                <%= render Primer::Beta::Avatar.new(
                  src: PrimaryAvatar.url_for(org.primary_avatar_path, entity: org),
                  alt: org.display_login,
                  size: 32,
                  shape: :square
                ) %>
              <% end %>
              <%= org.display_login %>
            <% end %>

            <%= org.entity_advanced_security_policy %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render Primer::Box.new(classes: "paginate-container") do %>
      <%= will_paginate view.orgs %>
    <% end %>
  <% end %>
</p>
