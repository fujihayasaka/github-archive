<%= render Primer::Beta::Details.new(overlay: :default, reset: true, display: :inline_block, mb: 2, mr: 2) do |component| %>
  <% component.with_summary do %>
    <i>Trial type:</i>
    <% if filter.key?(:trial_type) %>
      <%= filter[:trial_type] == "dfd" ? "Digital Front Door" : "Standard" %>
    <% else %>
      All
    <% end %>
    <span class="dropdown-caret"></span>
  <% end %>

  <% component.with_body do %>
    <div class="SelectMenu SelectMenu--hasFilter position-relative">
      <details-menu role="menu" class="SelectMenu right-0"><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
        <div class="SelectMenu-modal">
          <header class="SelectMenu-header">
            <span class="SelectMenu-title">Filter by trial type</span>
          </header>

          <div class="select-menu-list">
            <% all_params = { query: query, tab: tab, filter: filter.except(:trial_type) } %>
            <a href="?<%= all_params.to_query %>" aria-checked="<%= filter[:trial_type].blank? %>" class="select-menu-item <% if filter[:trial_type].blank? %>selected<% end %>"  role="menuitemcheckbox">
              <%= render Primer::Beta::Octicon.new(icon: "check", classes: "select-menu-item-icon") %>
              <span class="select-menu-item-text">All</span>
            </a>

            <% {"digital front door": "dfd", "standard": "standard"}.map do |trial_type_key, trial_type_value| %>
              <% trial_type_params = { query: query, tab: tab, filter: filter.merge(trial_type: trial_type_value) } %>
              <a href="?<%= trial_type_params.to_query %>" aria-checked="<%= filter[:trial_type] == trial_type_value %>" class="select-menu-item <% if filter[:trial_type] == trial_type_value %>selected<% end %>" role="menuitemcheckbox">
                <%= render Primer::Beta::Octicon.new(icon: "check", classes: "select-menu-item-icon") %>
                <span class="select-menu-item-text"><%= trial_type_key.to_s.titleize %></span>
              </a>
            <% end %>
          </div>
        </div>
      </details-menu>
    </div>
  <% end %>
<% end %>
