<% page_info title: "Enterprise licensing - Enterprise Cloud", selected_link: :business_licenses %>

<%= render_fallback_on_error(fallback: render("businesses/enterprise_licensing/error_fallback", message: "Could not load Enterprise Cloud data.")) do %>
  <%= render_react_partial(
    name: "licensing-enterprise-cloud-details",
    props: {
      enterpriseContactUrl: ent_contact_url,
      slug: this_business.slug,
      isStafftools: true,
      stafftoolsBlaAuditLogPath: stafftools_bundled_license_assignment_audit_log_path(this_business, current_user),
      **T.must(ghe_details_react_payload(business: this_business, current_user: current_user))
    }
  ) %>
<% end %>
