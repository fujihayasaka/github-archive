<% page_info \
  title: "#{this_business.slug} - #{this_enterprise_team.name} team orchestrations",
  selected_link: :enterprise_teams %>

<%= render Primer::Beta::Subhead.new(hide_border: true) do |component| %>
  <% component.with_heading(
    tag: :h2,
    test_selector: "orchestration-#{orchestration.id}"
  ) do %>
    <%= link_to("Enterprise teams", stafftools_enterprise_teams_path(this_business)) %>
    /
    <%= link_to(
      this_enterprise_team.name,
      stafftools_enterprise_team_path(this_business, this_enterprise_team.id)
    ) %>
    /
    <%= link_to(
      "Orchestrations",
      stafftools_enterprise_team_orchestrations_path(this_business, this_enterprise_team.id)
    ) %>
    / Orchestration #<%= orchestration.id %>
  <% end %>
<% end %>

<%= render(Stafftools::Orchestrations::ShowComponent.new(orchestration: orchestration)) %>
