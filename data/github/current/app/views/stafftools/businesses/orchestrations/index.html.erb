<% page_info title: "Orchestrations", selected_link: :orchestrations %>

<%= render Primer::Beta::Subhead.new(hide_border: true) do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Orchestrations
  <% end %>
<% end %>

<% if orchestrations.any? %>
  <p <%= test_selector "retention-limit" %>>
    Orchestrations for the enterprise within the last <%= Orchestration::RETENTION_LIMIT.inspect %>.
  </p>
  <%= render Primer::Beta::BorderBox.new(padding: :condensed, spacious: true) do |box| %>
    <% box.with_header(clearfix: true) do %>
      <div class="d-flex">
        <div class="col-1">ID</div>
        <div class="col-2">State</div>
        <div class="col-2">Type</div>
        <div class="col-2">Step</div>
        <div class="col-1">Attempts</div>
        <div class="col-2">Duration</div>
        <div class="col-2">Created</div>
      </div>
    <% end %>

    <% orchestrations.each do |orchestration| %>
      <% box.with_row(clearfix: true, test_selector: "orchestration-#{orchestration.id}") do %>
        <div class="d-flex">
          <div class="col-1">
            <%= render(Primer::Beta::Link.new(
              href: stafftools_enterprise_orchestration_path(this_business, orchestration)
            )) do %>
              <%= orchestration.id %>
            <% end %>
          </div>
          <div class="col-2">
            <% case (orchestration.state) %>
            <% when "succeeded" %>
              <%= primer_octicon(:"check-circle", classes: "open") %>
            <% when "failed" %>
              <%= primer_octicon(:"x-circle", classes: "closed") %>
            <% when "created" %>
              <%= primer_octicon(:"circle", classes: "draft") %>
            <% else %>
              <%= primer_octicon(:"circle", classes: "merged", style: "color: rgb(219, 171, 10)") %>
            <% end %>
            <%= orchestration.state %>
          </div>
          <div class="col-2">
            <%= orchestration.type.gsub("BusinessOrchestration", "") %>
          </div>
          <div class="col-2">
            <%= orchestration.step_name %>
          </div>
          <div class="col-1">
            <%= orchestration.attempts %>
          </div>
          <div class="col-2">
            <%= "#{(orchestration.updated_at - orchestration.created_at).round(2)} sec" %>
          </div>
          <div class="col-2">
            <%= orchestration.created_at %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <div class="paginate-container">
    <%= will_paginate orchestrations %>
  </div>
<% else %>
  <%= render Primer::Beta::Blankslate.new do |c| %>
    <% c.with_heading(tag: :h2) do %>
      No orchestrations for the enterprise within the last <%= Orchestration::RETENTION_LIMIT.inspect %>.
    <% end %>
  <% end %>
<% end %>
