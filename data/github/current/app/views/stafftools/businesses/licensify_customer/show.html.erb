<% page_info title: "#{this_business.name} - Licensify customer", selected_link: :licensify_customer %>

<div class="d-flex flex-column">
  <%= render "stafftools/businesses/enterprise_licensing/navigation" %>

  <%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-4")) do |component| %>
    <% component.with_header do |h| %>
      <div class="d-flex text-bold flex-justify-between flex-items-center">
        <div id="licensify-customer-information">Licensify customer information</div>
        <div class="d-flex flex-items-center">
          <%= form_tag sync_customer_stafftools_licensify_customer_path(this_business), method: :post do %>
            <%= render Primer::Beta::Button.new(type: :submit) do %>Sync customer<% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% component.with_body do %>
      <div class="Box-row clearfix">
        <% if customer_not_found %>
          <div class="blankslate">
            <p>Customer record not found in Licensify. Click <strong>Sync customer</strong> to create it.</p>
            <p class="text-small color-fg-muted">Syncing happens in the background — if you already clicked, refresh the page in a few moments.</p>
          </div>
        <% elsif error.present? %>
          <%= render(Primer::Alpha::Banner.new(scheme: :danger, classes: "tmp-mb-3")) { "Could not load Licensify customer data: #{error}" } %>
        <% elsif customer_data.nil? %>
          <div class="blankslate">
            <p>No customer data found in Licensify for this enterprise (customer ID: <%= this_business.customer_id %>).</p>
          </div>
        <% else %>
          <div class="mb-2">
            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">Customer ID: </span>
              <span class="d-block col-8"><%= customer_data.id %></span>
            </div>

            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">SDLC licensing model: </span>
              <span class="d-block col-8"><%= licensing_model_label(customer_data.sdlcLicensingModel) %></span>
            </div>

            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">SDLC trial: </span>
              <span class="d-block col-8"><%= customer_data.sdlcTrial %></span>
            </div>

            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">GHAS licensing model: </span>
              <span class="d-block col-8"><%= licensing_model_label(customer_data.ghasLicensingModel) %></span>
            </div>

            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">GHAS trial: </span>
              <span class="d-block col-8"><%= customer_data.ghasTrial %></span>
            </div>

            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">Code Security licensing model: </span>
              <span class="d-block col-8"><%= licensing_model_label(customer_data.codeSecurityLicensingModel) %></span>
            </div>

            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">Code Security trial: </span>
              <span class="d-block col-8"><%= customer_data.codeSecurityTrial %></span>
            </div>

            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">Secret Protection licensing model: </span>
              <span class="d-block col-8"><%= licensing_model_label(customer_data.secretProtectionLicensingModel) %></span>
            </div>

            <div class="d-flex flex-justify-start mb-2">
              <span class="d-block col-4 text-bold">Secret Protection trial: </span>
              <span class="d-block col-8"><%= customer_data.secretProtectionTrial %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
