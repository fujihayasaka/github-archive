<%# Credential counts for stafftools - loaded asynchronously %>

<% capped_count = number_to_human(Business::CredentialAuthorizationDependency::COUNT_LIMIT, precision: 0, format: "%n%u", units: { thousand: "k", million: "M" }) %>

<div class="border rounded-2 overflow-hidden">
  <% if timed_out %>
    <%# Show error state when query times out %>
    <div class="Box-row">
      <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
        Credential counts could not be loaded. This could be due to the large number of credentials in this enterprise. You can retrieve credential authorization data for each organization using the REST API credential authorizations endpoint.
      <% end %>
    </div>
  <% else %>
    <%# Fine-grained personal access tokens %>
    <div class="Box-row d-flex flex-items-center flex-justify-between">
      <div class="flex-auto">
        <h4 class="h5 mb-1">Fine-grained personal access tokens</h4>
        <p class="color-fg-muted mb-0 f6">
          The fine-grained personal access tokens that have access to this enterprise.
        </p>
      </div>
      <div class="tmp-ml-3">
        <span class="text-bold">
          <% if counts[:fine_grained_pat_count_capped] %>
            <%= capped_count %>+ tokens
          <% else %>
            <%= pluralize(counts[:fine_grained_pat_count], "token") %>
          <% end %>
        </span>
      </div>
    </div>

    <%# Personal access tokens (classic) %>
    <div class="Box-row d-flex flex-items-center flex-justify-between">
      <div class="flex-auto">
        <h4 class="h5 mb-1">Personal access tokens (classic)</h4>
        <p class="color-fg-muted mb-0 f6">
          The personal access tokens (classic) that have access to this enterprise.
        </p>
      </div>
      <div class="tmp-ml-3">
        <span class="text-bold">
          <% if counts[:classic_pat_count_capped] %>
            <%= capped_count %>+ tokens
          <% else %>
            <%= pluralize(counts[:classic_pat_count], "token") %>
          <% end %>
        </span>
      </div>
    </div>

    <%# SSH keys %>
    <div class="Box-row d-flex flex-items-center flex-justify-between">
      <div class="flex-auto">
        <h4 class="h5 mb-1">SSH keys</h4>
        <p class="color-fg-muted mb-0 f6">
          The SSH keys that have access to this enterprise.
        </p>
      </div>
      <div class="tmp-ml-3">
        <span class="text-bold">
          <% if counts[:ssh_key_count_capped] %>
            <%= capped_count %>+ keys
          <% else %>
            <%= pluralize(counts[:ssh_key_count], "key") %>
          <% end %>
        </span>
      </div>
    </div>

    <%# GitHub App and OAuth app user access tokens %>
    <div class="Box-row d-flex flex-items-center flex-justify-between">
      <div class="flex-auto">
        <h4 class="h5 mb-1">GitHub App and OAuth app user access tokens</h4>
        <p class="color-fg-muted mb-0 f6">
          GitHub App and OAuth app user access tokens that have access to this enterprise.
        </p>
      </div>
      <div class="tmp-ml-3">
        <span class="text-bold">
          <% if counts[:oauth_application_access_token_count_capped] %>
            <%= capped_count %>+ tokens
          <% else %>
            <%= pluralize(counts[:oauth_application_access_token_count], "token") %>
          <% end %>
        </span>
      </div>
    </div>
  <% end %>
</div>
