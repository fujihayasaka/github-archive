<% page_info title: "#{this_business.name} - Enterprise Agreements", selected_link: :enterprise_agreements %>

<%= render partial: "stafftools/businesses/enterprise_licensing/navigation" %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h1) do %>Enterprise agreements<% end %>
  <% component.with_actions do %>
    <%= link_to "New agreement", new_stafftools_enterprise_agreement_path(this_business), class: "btn btn-primary", "data-test-selector": "new-agreement-link" %>
  <% end %>
<% end %>

<%= render Stafftools::EnterpriseAgreements::ListComponent.new(business: this_business) %>
