<% page_info title: "Licenses", selected_link: :licensify_licenses %>

<div class="d-flex flex-column">
  <%= render "stafftools/businesses/enterprise_licensing/navigation" %>

  <%= render_react_partial(
    name: "licensify-licenses",
    disable_ssr: true,
    props: {
      customerId: this_business.customer_id.to_s,
      licenseStatuses: Licensify::Services::V1::LicenseStatus.constants,
      product: 'sdlc',
    }
  ) %>

  <% if current_user.feature_enabled?(:stafftools_licensify_ghas_licenses) %>
    <%= render_react_partial(
      name: "licensify-licenses",
      disable_ssr: true,
      props: {
        customerId: this_business.customer_id.to_s,
        licenseStatuses: Licensify::Services::V1::LicenseStatus.constants,
        product: 'ghas',
      }
    ) %>
  <% end %>
</div>
