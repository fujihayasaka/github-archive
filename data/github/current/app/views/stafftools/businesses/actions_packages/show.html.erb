<% page_info title: "Actions & Packages usage" %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Actions & Packages Usage<% end %>
<% end %>

<% if this_business.billed_via_billing_platform? %>
  <%= render Primer::Alpha::Banner.new(scheme: :warning, mb: 4, test_selector: "page-deprecated-banner") do %>
    This page has been deprecated. You can now see customer's usage and budgets via the new <%= render Primer::Beta::Link.new(href: stafftools_enterprise_billing_usage_path(this_business), underline: :false).with_content("Billing and licensing") %> section.
  <% end %>
<% end %>

<%= render "stafftools/actions_packages/breakdown", business: true %>
<%= render "stafftools/actions_packages/utilities" %>
