<% page_info title: "Organization roles", selected_link: :custom_roles %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h1) { "Organization roles" } %>
  <% component.with_description do %>
    Listed below are all the organization roles that can be granted to members and teams in organizations owned by this enterprise. These roles are created and managed by the enterprise. Expand a role to view the details of the permissions included.
  <% end %>
<% end %>

<%= render(Businesses::CustomRoles::OrgRolesListComponent.new(business: this_business, viewer_permissions: { read: true, write: false, stafftools: true }, test_selector: "enterprise-org-roles-list-component")) %>
