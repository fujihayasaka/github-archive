<% page_info title: "Custom roles", selected_link: :custom_roles %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h1) { "Custom roles" } %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% if this_business.custom_enterprise_roles_supported? %>
    <% component.with_row(display: :flex, test_selector: "custom-enterprise-roles") do %>
      <%= render(Primer::Beta::Link.new(href: stafftools_enterprise_roles_path(this_business), flex: 1)) { "Enterprise roles" } %>
      <%= render(Primer::Beta::Text.new) { "#{pluralize(EnterpriseRole.custom_roles_for_enterprise(this_business).size, "custom role")}" } %>
    <% end %>

    <% component.with_row(display: :flex, test_selector: "custom-enterprise-role-assignments") do %>
      <%= render(Primer::Beta::Link.new(href: stafftools_enterprise_role_assignments_path(this_business))) { "Enterprise role assignments" } %>
    <% end %>
  <% end %>
<% end %>
