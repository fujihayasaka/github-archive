<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%= render(Primer::Alpha::Dialog.new(
  title: "Re-enable Audit log stream",
  subtitle: "",
  id: "reenable-audit-log-stream-#{stream[:stream].id}",
  show_divider: true,
  size: :medium_portrait,
  animation: :fade_in,
)) do |d| %>
  <% d.with_show_button(scheme: :default) { "Re-enable stream" } %>
  <% d.with_body do %>
    <h4 class="pb-2 tmp-pl-3 tmp-pt-3 tmp-pr-3">Are you sure you want to re-enable the Audit log stream?</h4>
    <p class="tmp-pl-3 tmp-pr-3 mb-0 color-fg-muted">This will re-enable the paused audit log stream on behalf of the enterprise.</p>
    <div class="tmp-p-3">
      <%= form_tag stafftools_audit_log_stream_reenable_endpoint_path(business, stream[:stream].id), method: :put do %>
        <input type="hidden">
        <%= render(Primer::ButtonComponent.new(type: :submit, scheme: :default, block: true)) { "Re-enable stream" } %>
      <% end %>
    </div>
  <% end %>
<% end %>
