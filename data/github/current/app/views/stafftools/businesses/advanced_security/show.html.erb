<% page_info title: "Advanced Security" %>
<%= render(Stafftools::Billing::AdvancedSecurityLicensingStateComponent.new(entity: this_business)) %>
<% skus.each do |sku| %>
  <div class="ml-4 mb-4">
  <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |component| %>
    <% component.with_header do %>
      <h2 class="Box-title" <%= test_selector("ghas-sku-enablement") %>> <%= sku.title %> Enablement</h2>
    <% end %>
    <% component.with_row do %>
      <div class="d-flex flex-justify-between">
        <span>Number of repositories with active <%= sku.title %> committers:</span>
        <span class="no-wrap">
          <strong <%= test_selector("ghas-enabled-repositories")%>><%= enabled_ghas_repositories_count(entity: this_business, sku:) %></strong>
          <%= link_to download_ghas_repositories_stafftools_advanced_security_path(this_business.slug, sku: sku.to_param),
            class: "btn-octicon ml-2 no-wrap" do %>
            <%= render(Primer::Beta::Octicon.new(icon: "download")) %> Download CSV
          <% end %>
        </span>
      </div>
    <% end %>
  <% end %>

  <%= render Stafftools::AdvancedSecurity::BusinessCommittersFormComponent.new(
    this_business: this_business,
    entities: request.params.fetch(:entities, {})[sku.to_param],
    sku:,
  ) %>
  </div>
<% end %>
<div class="ml-4">
  <%= render Primer::Beta::Subhead.new(hide_border: true) do |component| %>
    <% component.with_heading(tag: :h2, danger: true) do %>Danger zone<% end %>
  <% end %>
  <div class="Box Box--danger">
    <%= render Stafftools::AdvancedSecurity::GhasUnbundleTransitionComponent.new(
      business: this_business,
      transition: transition
    )%>
  </div>
</div>
