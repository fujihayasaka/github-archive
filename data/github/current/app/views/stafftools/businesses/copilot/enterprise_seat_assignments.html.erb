<div class="site-admin-subhead ruleless">
  <h2 class="site-admin-subhead-heading">
    Copilot Seat Assignments (<%= copilot_seat_assignments.total_entries %>)
  </h2>
</div>

<div class="d-flex flex-items-end">
  <%= form_with(url: standalone_seat_assignments_stafftools_copilot_url(this_business), method: :get, html: {class: "d-flex flex-items-end mb-3"}) do |form| %>
    <div class="mr-2">
      <div class="form-group-header">
        <%= form.label :search_by_assignable, for: "query" %>
      </div>
      <div class="form-group-body">
        <%= form.text_field :query, value: params[:query], id: "query", class: "form-control" %>
      </div>
    </div>
    <%= render(Primer::Beta::Button.new(type: :submit)) { "Search" } %>
  <% end %>

  <%= render(Primer::Alpha::Dialog.new(
    title: "Reinstate Access for All Copilot Seat Assignments",
    subtitle: "",
    id: "reinstate-copilot-seat-assignments-#{this_business&.id}",
    size: :xlarge,
  )) do |d| %>
    <% d.with_show_button(type: :button, scheme: :danger, mb: 3, ml: 5, aria: { label: "Show options", hidden: false }) { "Reinstate Access for All" } %>

    <% d.with_body do %>
      <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
        This will reinstate access for all Copilot seat assignments in this enterprise. Proceed with caution.
      <% end %>
    <% end %>

    <% d.with_footer do %>
      <%= form_with(url: business_reinstate_copilot_seat_assignments_stafftools_enterprise_url(this_business), method: :put) do |form| %>
        <%= hidden_field_tag :business_id, this_business.id %>
        <%= render(Primer::Beta::Button.new(type: :submit, scheme: :danger)) { "Confirm" } %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= render Stafftools::Copilot::StandalonePaginatedSeatAssignmentsComponent.new(copilot_seat_assignments, copilot_business.business_object) %>
