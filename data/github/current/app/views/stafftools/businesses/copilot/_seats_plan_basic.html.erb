<% enterprise_team = this_business.enterprise_teams %>
<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Access
    <% end %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Basic Seat Plan",
      true
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Copilot licensing enabled",
      this_business.copilot_licensing_enabled?
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Max Copilot Seats",
      this_business.copilot_max_seats,
      "What is the max number of Copilot seats this enterprise allows?",
    ) %>
  <% end %>
<% end %>

<%= render(Stafftools::Copilot::PlanComponent.new(copilot_business)) %>

<br>
<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Settings
    <% end %>
  <% end %>
  <% component.with_row do %>
    <%= form_tag copilot_refresh_organizations_caches_stafftools_enterprise_path(current_business), :method => :put do %>
      <%= render(Primer::Beta::ButtonGroup.new) do |component| %>
        <% component.with_button(type: :submit, id: "copilot-refresh-button", test_selector: "copilot-refresh-button") do |button| %>
          <% button.with_leading_visual_icon(icon: :sync) %>
          Refresh all enterprise members settings cache
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "#{Copilot::COPILOT_IN_DOTCOM}",
      copilot_business.copilot_for_dotcom_setting.titleize,
      "Whether this enterprise has enabled or disabled #{Copilot::COPILOT_IN_DOTCOM}",
      label_scheme: copilot_business.copilot_for_dotcom_enabled? ? :success : copilot_business.copilot_for_dotcom_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_CHAT_IN_IDE,
      copilot_business.chat_setting.titleize,
      "Whether this enterprise has allowed or blocked chat",
      label_scheme: copilot_business.chat_enabled? ? :success : copilot_business.no_chat_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::EDITOR_PREVIEW_FEATURES,
      copilot_business.editor_preview_features.titleize,
      "Whether this enterprise has enabled or disabled editor preview features",
      label_scheme: copilot_business.editor_preview_features_enabled? ? :success : copilot_business.editor_preview_features_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_CHAT_IN_MOBILE,
      copilot_business.mobile_chat_setting.titleize,
      "Whether this enterprise has enabled or disabled Copilot Chat in GitHub Mobile",
      label_scheme: copilot_business.mobile_chat_enabled? ? :success : copilot_business.no_mobile_chat_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::CLI_UI_NAME,
      copilot_business.cli_setting.titleize,
      "Whether this enterprise has enabled or disabled Copilot in the CLI",
      label_scheme: copilot_business.cli_enabled? ? :success : copilot_business.cli_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_DESKTOP,
      copilot_business.desktop_setting.titleize,
      "Whether this enterprise has enabled or disabled Copilot in GitHub Desktop",
      label_scheme: copilot_business.desktop_enabled? ? :success : copilot_business.desktop_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_METRICS_API_NAME,
      copilot_business.usage_telemetry_api_setting.titleize,
      "Whether this enterprise has enabled or disabled access to #{Copilot::COPILOT_METRICS_API_NAME} endpoints",
      label_scheme: copilot_business.telemetry_aggregation_enabled? ? :success : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_BING_ACCESS,
      copilot_business.bing_github_chat_no_policy? ? "No Policy" : copilot_business.bing_github_chat_enabled? ? "Enabled" : "Disabled",
      "Whether this enterprise has enabled or disabled the use of Bing Search in Copilot Chat in GitHub.com",
      label_scheme: copilot_business.bing_github_chat_enabled? ? :success : copilot_business.bing_github_chat_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_PUBLIC_CODE_SUGGESTIONS,
      copilot_business.no_public_code_suggestions_policy? ? "No Policy" : !copilot_business.public_code_suggestions_configured? ? "Unconfigured" : copilot_business.allow_public_code_suggestions? ? "Allow" : "Block",
      "Whether this enterprise has allowed or blocked public code suggestions",
      label_scheme: copilot_business.allow_public_code_suggestions? ? :success : copilot_business.no_public_code_suggestions_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_A_CHAT,
      copilot_business.a_chat_setting.titleize,
      "Whether this enterprise has enabled or disabled Anthropic Claude 3.5 model",
      label_scheme: copilot_business.a_chat_enabled? ? :success : copilot_business.a_chat_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_A_F,
      copilot_business.a_f_setting.titleize,
      "Whether this enterprise has enabled or disabled Anthropic Claude 3.7 model",
      label_scheme: copilot_business.a_f_enabled? ? :success : copilot_business.a_f_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
    <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_G_CHAT,
      copilot_business.g_chat_setting.titleize,
      "Whether this enterprise has enabled or disabled Google Gemini model",
      label_scheme: copilot_business.g_chat_enabled? ? :success : copilot_business.g_chat_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_G_TF,
      copilot_business.g_tf_setting.titleize,
      "Whether this enterprise has enabled or disabled #{Copilot::COPILOT_G_TF} model",
      label_scheme: copilot_business.g_tf_enabled? ? :success : copilot_business.g_tf_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_GTFF,
      copilot_business.gtff.titleize,
      "Whether this enterprise has enabled or disabled #{Copilot::COPILOT_GTFF} model",
      label_scheme: copilot_business.gtff_enabled? ? :success : copilot_business.gtff_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_O1,
      copilot_business.o1_setting.titleize,
      "Whether this enterprise has enabled or disabled Open AI o1 models",
      label_scheme: copilot_business.o1_enabled? ? :success : copilot_business.o1_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_O3,
      copilot_business.o3_setting.titleize,
      "Whether this enterprise has enabled or disabled Open AI o3 models",
      label_scheme: copilot_business.o3_enabled? ? :success : copilot_business.o3_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_OFO,
      copilot_business.ofo.titleize,
      "Whether this enterprise has enabled or disabled #{Copilot::COPILOT_OFO} model",
      label_scheme: copilot_business.ofo_enabled? ? :success : copilot_business.ofo_no_policy? ? :secondary : :danger
    ) %>
  <% end %>
  <% if this_business.feature_enabled?(:copilot_overages) %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Additional Copilot premium requests",
        copilot_business.overages_setting.titleize,
        "Whether this enterprise has enabled or disabled overages",
        label_scheme: copilot_business.overages_enabled? ? :success : copilot_business.overages_no_policy? ? :secondary : :danger
      ) %>
    <% end %>
  <% end %>
<% end %>
<br>

<%= render Stafftools::Copilot::EmailOptInOutComponent.new(
  entity: this_business,
  submit_path: business_toggle_copilot_email_notifications_stafftools_enterprise_path(this_business, notifications: params[:notifications]),
  notifications: params[:notifications]
) %>

<%= render Stafftools::Copilot::SeatEmissionsComponent.new(copilot_seat_emissions) %>
