<% page_info title: "Copilot" %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Copilot<% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
  <% component.with_header do |h| %>
    <% h.with_title(tag: :h2) do %>
      Copilot Access
    <% end %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Copilot Billable?",
      copilot_business.copilot_billable?,
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Copilot Metered Services Billable? (Billing Check)",
      copilot_business.billable_object.metered_services_billable?[:billable],
      "Reason: <strong>#{copilot_business.billable_object.metered_services_billable?[:reason]}</strong>".html_safe, # rubocop:disable Rails/OutputSafety
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Enterprise Billing Type",
      this_business.billing_type.present? ? this_business.billing_type : false,
      "What billing type does this enterprise have?",
      label_scheme: this_business.billing_type.present? ? :success : :danger,
    ) %>
  <% end %>
  <% if this_business.enterprise_agreements.where(status: "active").any? %>
    <% component.with_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Does this enterprise have an Azure Subscription ID?",
        this_business.customer.present? && this_business.customer.azure_subscription_id.present?,
        "Since this enterprise has an Enterprise Agreement, they MUST have an Azure Subscription ID.",
      ) %>
    <% end %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Is this enterprise a trial enterprise?",
      this_business.trial_status(this_business).present?,
      this_business.trial_status(this_business),
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Has this enterprise enabled Copilot?",
      !copilot_business.copilot_disabled?,
      "Current setting: #{copilot_business.copilot_enabled_setting}",
    ) %>
  <% end %>
  <% component.with_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Eligible to migrate to EnterpriseTeams?",
      copilot_business.eligible_to_migrate_to_enterprise_teams?,
    ) %>
  <% end %>
  <% component.with_row do %>
    <%
      active_trials_count = active_trials.count
      active_trial_copilot_plan = active_trials.first&.copilot_plan
    %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Does this enterprise have an organization with an associated Copilot Business/Enterprise trial?",
      copilot_business.has_trial_organization?,
      active_trials_count > 0 ? "#{active_trials_count} Copilot #{active_trial_copilot_plan&.capitalize} trial(s) active" : "No active trials",
    ) %>
  <% end %>

<% end %>

<%= render(Stafftools::Copilot::PlanComponent.new(copilot_business)) %>

<br>
<%= render Stafftools::Copilot::SettingsComponent.new(copilot_business) do |component| %>
  <% component.with_prepended_row do %>
    <%= form_tag copilot_refresh_organizations_caches_stafftools_enterprise_path(current_business), :method => :put do %>
      <%= render(Primer::Beta::ButtonGroup.new) do |component| %>
        <% component.with_button(type: :submit, id: "copilot-refresh-button", test_selector: "copilot-refresh-button") do |button| %>
          <% button.with_leading_visual_icon(icon: :sync) %>
          Refresh all enterprise members settings cache
        <% end %>
      <% end %>
    <% end %>
    <% component.with_prepended_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        Copilot::COPILOT_MCP_REGISTRY_ACCESS,
        copilot_business.mcp_registry_access.titleize,
        "What level of MCP registry access restriction that the enterprise has set",
        label_scheme: copilot_business.mcp_registry_access_is?("registry_only") ? :success : :danger
      ) %>
    <% end %>
  <% end %>

  <% component.with_prepended_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      Copilot::COPILOT_MCP_REGISTRY,
      nil,
      "Whether the enterprise has a #{Copilot::COPILOT_MCP_REGISTRY} set and what the url is",
    ) do |component| %>
      <% component.with_body do %>
      <p class="note">
        <%= copilot_business.mcp_registry_url.present? ? copilot_business.mcp_registry_url : "No MCP registry URL set" %>
      </p>
      <% end %>
    <% end %>
  <% end %>

  <% if current_user.feature_flag_enabled?(:copilot_overages, default: false) %>
    <% component.with_prepended_row do %>
      <%= render Stafftools::Copilot::DetailComponent.new(
        "Additional Copilot premium requests",
        copilot_business.overages.titleize,
        "Whether this enterprise has enabled or disabled overages",
        label_scheme: copilot_business.overages_enabled? ? :success : copilot_business.overages_no_policy? ? :secondary : :danger
      ) %>
    <% end %>
  <% end %>

  <% component.with_prepended_row do %>
    <%= render Stafftools::Copilot::DetailComponent.new(
      "Copilot code review blocked",
      copilot_business.code_review_repository_access_enabled? ? "Not blocked" : "Blocked",
      "Whether this enterprise has blocked Copilot code review in all enterprise repositories",
      label_scheme: copilot_business.code_review_repository_access_enabled? ? :danger : :success
    ) %>
  <% end %>
<% end %>
<br>

<%= render Stafftools::Copilot::EmailOptInOutComponent.new(
  entity: this_business,
  submit_path: business_toggle_copilot_email_notifications_stafftools_enterprise_path(this_business, notifications: params[:notifications]),
  notifications: params[:notifications]
) %>

<%= render(Stafftools::Copilot::WaitlistsComponent.new(this_business)) %>

<% if seat_assignments.any? %>
  <br>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
    <% component.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Copilot Organizations
      <% end %>
    <% end %>
    <% component.with_row do %>
      <table class="width-full px-1 mt-n1 boxed-group-table">
        <tr>
          <th>Organization</th>
          <th>Seat Count</th>
          <th>Pending Cancellation</th>
          <th>License</th>
        </tr>
        <% seat_assignments.each do |id, seat_assignment| %>
          <tr>
            <td>
              <%= render(Primer::Beta::Link.new(target: "_blank", href: stafftools_user_copilot_settings_path(seat_assignment[:organization]))) do %>
                <%= seat_assignment[:organization].display_login %><% if seat_assignment[:trial].present? %><span class="label"><%= seat_assignment[:trial].short_display_name %> - <%= seat_assignment[:trial].state.to_s.humanize %></span><% end %>
              <% end %>
            </td>
            <td>
              <%= seat_assignment[:seat_count] %> <% if seat_assignment[:seat_count] > 0 %>(<%= render(Primer::Beta::Link.new(target: "_blank", href: stafftools_user_copilot_seats_path(seat_assignment[:organization]))) do %>View<% end %>)<% end %>
            </td>
            <td>
              <%= seat_assignment[:seats_pending_cancellation_count] %>
            </td>
            <td>
              <%= render(Primer::Beta::Label.new(scheme: :default)) { Copilot::Organization.new(seat_assignment[:organization]).copilot_plan.capitalize } %>
            </td>
          </tr>
        <% end %>
      </table>
    <% end %>
    <% component.with_row(text_align: :right, display: :flex, justify_content: :flex_end) do %>
      <%= render Primer::Alpha::ActionMenu.new(menu_id: "copilot-export-menu") do |menu| %>
        <% menu.with_show_button do |button| %>
          <% button.with_leading_visual_icon(icon: :file) %>
          Get Usage report
          <% button.with_trailing_action_icon(icon: :"triangle-down") %>
        <% end %>
        <% menu.with_item(
          href: business_generate_copilot_activity_csv_stafftools_enterprise_path(this_business),
          form_arguments: { method: :post, data: { turbo: false } }
        ) do |item| %>
          Activity report (new)
          <% item.with_description.with_content(Copilot::COPILOT_ACTIVITY_REPORT_DESCRIPTION) %>
        <% end %>
      <% end %>
      <% if copilot_business.eligible_to_migrate_to_enterprise_teams? %>
        <%= form_with(url: migrate_to_enterprise_teams_copilot_stafftools_enterprise_path(this_business), method: :post, local: true) do |f| %>
          <%= render(Primer::Beta::Button.new(type: :submit)) do |button| %>
            Migrate to EnterpriseTeams
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <br>
  <%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
    <% component.with_header do |h| %>
      <% h.with_title(tag: :h2) do %>
        Danger Zone
      <% end %>
    <% end %>
    <% component.with_row do %>
      <%= render(Primer::Alpha::Dialog.new(
        title: "Reinstate Access for All Copilot Seat Assignments",
        subtitle: "",
        id: "reinstate-copilot-seat-assignments-#{this_business&.id}",
        size: :xlarge,
      )) do |d| %>
        <% d.with_show_button(type: :button, scheme: :danger, aria: { label: "Show options", hidden: false }) { "Reinstate Access for All Seat Assignments" } %>

        <% d.with_body do %>
          <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
            This will reinstate access for all Copilot seat assignments across all organizations within this enterprise. Proceed with caution.
          <% end %>
        <% end %>

        <% d.with_footer do %>
          <%= form_with(url: business_reinstate_copilot_seat_assignments_stafftools_enterprise_url(this_business), method: :put) do |form| %>
            <%= hidden_field_tag :business_id, this_business.id %>
            <%= render(Primer::Beta::Button.new(type: :submit, scheme: :danger)) { "Confirm" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render Stafftools::Copilot::SeatEmissionsComponent.new(copilot_seat_emissions) if copilot_seat_emissions.present? %>
