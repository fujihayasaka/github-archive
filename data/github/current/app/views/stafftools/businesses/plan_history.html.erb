<h3 id="plan-history-heading" class="Box-title mb-2">History</h3>
<%= render Primer::Box.new(classes: "border rounded-2 color-bg-default mb-4 p-0") do %>
  <div class="color-bg-default rounded-bottom-2">
    <table class="width-full" aria-labelledby="plan-history-heading" style="font-size: var(--text-body-size-small); border-collapse: collapse;">
      <thead>
        <tr>
          <th class="p-2 border-bottom color-bg-subtle text-bold text-left">Plan change</th>
          <th class="p-2 border-bottom color-bg-subtle text-bold text-left">Details</th>
          <th class="p-2 border-bottom color-bg-subtle text-bold text-right">Time</th>
        </tr>
      </thead>
      <tbody>
        <% if plan_history.any? %>
          <% plan_history.each do |billing_transaction| %>
            <%= render Stafftools::Billing::PlanHistoryComponent.new(billing_transaction) %>
          <% end %>
        <% else %>
          <tr>
            <td class="p-3 border-bottom text-bold">Signed-up</td>
            <td class="p-3 border-bottom"><%= business.plan_name.to_s.humanize %></td>
            <td class="p-3 border-bottom color-fg-muted text-right">
              <%= business.created_at.strftime("on %b %-d, %Y") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
<% if plan_history.respond_to?(:total_pages) && plan_history.total_pages > 1 %>
  <nav class="paginate-container" aria-label="Pagination">
    <%= will_paginate(plan_history) %>
  </nav>
<% end %>
