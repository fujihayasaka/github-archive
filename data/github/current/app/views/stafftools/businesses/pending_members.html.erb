<% page_info title: this_business.name, selected_link: :business_people %>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>
    <%= link_to "People", stafftools_enterprise_people_path(this_business) %>
    / Pending members
  <% end %>
<% end %>

<%= render Stafftools::SimpleSearchFormComponent.new(
  query_label: "Search pending members",
  form_url: stafftools_enterprise_pending_members_path(this_business)
) %>

<% if pending_member_invitations.any? %>
  <% disallowed_2fa_methods = this_business.get_two_factor_disallowed_methods %>
  <div class="Box Box--condensed">
    <ul>
      <% pending_member_invitations.each do |pending_member| %>
        <% invitee = pending_member.invitee %>
        <li class="Box-row d-flex flex-items-center"
          <%= test_selector "pending-member-#{pending_member.id}" %>>
          <% if pending_member.email.present? %>
            <span class="flex-auto">
              <%= primer_octicon(:mail, height: 20, color: :muted) %>
              <%= pending_member.email %>
            </span>
          <% else %>
            <span class="flex-auto">
              <%= avatar_for invitee, 20, class: :avatar %>
              <% if invitee.present? %>
                <%= link_to invitee.login, stafftools_user_path(invitee) %>
              <% else %>
                Invitee for invitation with ID <%= pending_member.id %> not found
              <% end %>
            </span>
          <% end %>
          <% if invitee.present? %>
            <span class="mr-4">
              <% if !invitee.two_factor_authentication_enabled? %>
                2FA not enabled
              <% elsif invitee.has_any_given_2fa_methods_configured?(disallowed_2fa_methods) %>
                2FA disallowed method
              <% end %>
            </span>
          <% end %>
          <span>
            Invited to
            <%= link_to pending_member.organization.login,
              stafftools_user_path(pending_member.organization.login) %>
          </span>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="paginate-container">
    <%= will_paginate pending_member_invitations %>
  </div>
<% else %>
  <%= render Primer::Beta::Blankslate.new(mb: 3) do |c| %>
    <% c.with_heading(tag: :h2) do %>
      No pending members
      <% if params[:query].present? %>
        matching <em><%= params[:query] %></em>
      <% end %>
      in this enterprise.
    <% end %>
  <% end %>
<% end %>
