<%# Credentials section for stafftools enterprise security page %>
<%# Uses lazy loading for dynamic credential counts %>

<%= render Primer::Beta::Subhead.new(spacious: true) do |component| %>
  <% component.with_heading(tag: :h2) do %>Credentials<% end %>
<% end %>

<%# Credentials overview section %>
<div class="tmp-mb-4">
  <div class="d-flex flex-items-center flex-justify-between mb-2">
    <h3 class="h4 mb-0">Overview</h3>
  </div>
  <p class="color-fg-muted tmp-mb-3">
    An overview of <a href="https://docs.github.com/authentication/keeping-your-account-and-data-secure/about-authentication-to-github#githubs-token-formats" target="_blank" class="Link--inTextBlock">user credentials</a> with at least one SSO authorization for an organization in this enterprise.
  </p>

  <%= render Primer::Alpha::IncludeFragment.new(
    src: credential_counts_stafftools_enterprise_security_path(business),
    loading: "lazy"
  ) do %>
    <div class="border rounded-2 overflow-hidden">
      <div class="Box-row d-flex flex-items-center flex-justify-between">
        <div class="flex-auto">
          <h4 class="h5 mb-1">Fine-grained personal access tokens</h4>
          <p class="color-fg-muted mb-0 f6">
            The fine-grained personal access tokens that have access to this enterprise.
          </p>
        </div>
        <div class="tmp-ml-3">
          <%= render Primer::Beta::Spinner.new(size: :small) %>
        </div>
      </div>

      <div class="Box-row d-flex flex-items-center flex-justify-between">
        <div class="flex-auto">
          <h4 class="h5 mb-1">Personal access tokens (classic)</h4>
          <p class="color-fg-muted mb-0 f6">
            The personal access tokens (classic) that have access to this enterprise.
          </p>
        </div>
        <div class="tmp-ml-3">
          <%= render Primer::Beta::Spinner.new(size: :small) %>
        </div>
      </div>

      <div class="Box-row d-flex flex-items-center flex-justify-between">
        <div class="flex-auto">
          <h4 class="h5 mb-1">SSH keys</h4>
          <p class="color-fg-muted mb-0 f6">
            The SSH keys that have access to this enterprise.
          </p>
        </div>
        <div class="tmp-ml-3">
          <%= render Primer::Beta::Spinner.new(size: :small) %>
        </div>
      </div>

      <div class="Box-row d-flex flex-items-center flex-justify-between">
        <div class="flex-auto">
          <h4 class="h5 mb-1">GitHub App and OAuth app user access tokens</h4>
          <p class="color-fg-muted mb-0 f6">
            GitHub App and OAuth app user access tokens that have access to your enterprise.
          </p>
        </div>
        <div class="tmp-ml-3">
          <%= render Primer::Beta::Spinner.new(size: :small) %>
        </div>
      </div>
    </div>
  <% end %>
</div>
