<% page_info :title => "Chat Attachment"  %>

<%= render layout: "stafftools/stafftools" do %>
  <%= render(Primer::Beta::Subhead.new) do |component| %>
    <% component.with_heading(tag: :h2) do %>
      Chat Attachment
    <% end %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
    <% component.with_header do |h| %>
      Database Record
    <% end %>
    <% component.with_row do %>
      <%= render "stafftools/copilot_chat_attachments/summary", :asset => this_asset %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :condensed, mt: 3)) do |component| %>
    <% component.with_header(font_weight: :bold, bg: :danger_emphasis, color: :on_emphasis, mb: 3) do %>
      Danger Zone
    <% end %>
    <% component.with_row do %>
      <%= render(Primer::Experimental::Dialog.new(
        dialog_id: "delete-chat-attachment-dialog",
        header_variant: :medium,
        width: :large,
        title: "Delete chat attachment",
        form_url: stafftools_copilot_chat_attachment_path(this_asset),
        form_method: :delete
      )) do |c| %>
        <% c.with_show_button(
          color: :danger,
          float: :right,
        ) do |s| %>
          Delete chat attachment
        <% end %>
        <% c.with_body do %>
          <p>
            This will delete the chat attachment. <strong>Are you certain?</strong>
          </p>
        <% end %>
        <% c.with_button(
          data: { "close-dialog-id": "delete-chat-attachment-dialog" }
        ) { "Cancel" } %>
        <% c.with_button(
          type: :submit,
          scheme: :danger,
          data: { "disable-with": "" }
        ) { "Delete chat attachment" } %>
      <% end %>
      <%= render(Primer::Beta::Heading.new(tag: :h3)) { "Delete chat attachment" } %>
      <%= render(Primer::Beta::Text.new(tag: :div, color: :muted, font_size: :small)) { "Delete this chat attachment. This is not reversible." } %>
    <% end %>
  <% end %>
<% end %>
