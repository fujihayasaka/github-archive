<% page_info(title: "Product Catalog") %>

<%= render(layout: "stafftools/stafftools") do %>
  <%= render(Primer::Beta::Subhead.new) do |component| %>
    <% component.with_heading(tag: :h2) do %>
      <%= render(Primer::Beta::Breadcrumbs.new) do |c| %>
        <% c.with_item(href: stafftools_product_catalog_index_path) do %>Product Catalog<% end %>
        <% c.with_item(href: request.path) do %>
          <% if product_uuid.name? %>
            <%= product_uuid.name %>
          <% else %>
            <%= "#{product_uuid.product_type}: #{product_uuid.product_key}" %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="container-lg clearfix">
    <%= render Primer::Beta::BorderBox.new do |component| %>
      <% component.with_header do %>
        <h3 class="f4">Basic Information</h3>
      <% end %>
      <% component.with_body do %>
        <table class="text-left d-table width-full">
          <tr>
            <th class="width-30">Type</th>
            <td class="tmp-px-3">
              <% if product_uuid.metered? %>
                <%= render Primer::Beta::Octicon.new(:meter) %> Metered Product
              <% elsif Billing::ProductUUID::SPONSORS_PRODUCT_TYPES.include?(product_uuid.product_type) %>
                <%= render Primer::Beta::Octicon.new(:heart) %> Sponsors Product
              <% elsif product_uuid.product_type == Billing::ProductUUID::MARKETPLACE_PRODUCT_TYPE %>
                <%= render Primer::Beta::Octicon.new(:package) %> Marketplace Product
              <% else %>
                <%= render Primer::Beta::Octicon.new(:database) %> Non-Metered Product
              <% end %>
            </td>
          </tr>
          <tr>
            <th>Id</th>
            <td class="tmp-px-3"><%= product_uuid.id %></td>
          </tr>
          <tr>
            <th>Name</th>
            <td class="tmp-px-3"><%= product_uuid.name %></td>
          </tr>
          <tr>
            <th>Product Key</th>
            <td class="tmp-px-3"><code><%= product_uuid.product_key %></code></td>
          </tr>
          <tr>
            <th>Product Type</th>
            <td class="tmp-px-3"><code><%= product_uuid.product_type %></code></td>
          </tr>
          <tr>
            <th>Billing Cycle</th>
            <td class="tmp-px-3">
              <%= render Primer::Beta::Label.new do %>
                <%= product_uuid.billing_cycle %>
              <% end %>
            </td>
          </tr>
          <tr>
            <th>Metered</th>
            <td class="tmp-px-3">
              <% if product_uuid.metered? %>
                <%= render Primer::Beta::Label.new(scheme: :success) do %>
                  <%= render Primer::Beta::Octicon.new(:check, size: :xsmall) %> Yes
                <% end %>
              <% else %>
                <%= render Primer::Beta::Label.new(scheme: :secondary) do %>
                  <%= render Primer::Beta::Octicon.new(:x, size: :xsmall) %> No
                <% end %>
              <% end %>
            </td>
          </tr>
        </table>
      <% end %>
    <% end %>
  </div>

  <br>

  <%= render Primer::Beta::BorderBox.new do |component| %>
    <% component.with_header do %>
      <h3 class="f4">Zuora Configuration</h3>
    <% end %>
    <% component.with_body do %>
      <table class="text-left d-table width-full">
        <tr>
          <th class="width-30">Product ID</th>
          <td class="tmp-px-3">
            <%= link_to product_uuid.zuora_product_id, zuora_product_url(product_id: product_uuid.zuora_product_id), target: "_blank", rel: "noopener" %>
          </td>
        </tr>
        <tr>
          <th>Product Rate Plan ID</th>
          <td class="tmp-px-3">
            <%= link_to product_uuid.zuora_product_rate_plan_id, zuora_product_url(product_id: product_uuid.zuora_product_id, rate_plan_id: product_uuid.zuora_product_rate_plan_id), target: "_blank", rel: "noopener" %>
          </td>
        </tr>
        <tr>
          <th class="v-align-top">Product Rate Plan Charges</th>
          <td class="tmp-px-3">
            <table>
              <% product_uuid.zuora_product_rate_plan_charge_ids.each do |charge_type, charge_id| %>
                <tr>
                  <th class="pr-2"><code><%= charge_type %></code></th>
                  <td><code><%= charge_id %></code></td>
                </tr>
              <% end %>
            </table>
          </td>
        </tr>
      </table>
    <% end %>
  <% end %>

  <% if product_uuid.charges.present? %>
    <br>

    <%= render(Primer::Beta::Subhead.new) do |component| %>
      <% component.with_heading(tag: :h3) do %>
        Charges
      <% end %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(padding: :condensed)) do |component| %>
      <% product_uuid.charges.each do |charge| %>
        <% component.with_row do %>
          <table class="text-left d-table">
            <tr>
              <th>Name</th>
              <td class="tmp-px-3"><%= charge.name %></td>
            </tr>
            <tr>
              <th>Type</th>
              <td class="tmp-px-3"><code><%= charge.type %></code></td>
            </tr>
            <tr>
              <th>Price</th>
              <td class="tmp-px-3"><%= number_to_currency(charge.price) %></td>
            </tr>
            <tr>
              <th>Billing Duration</th>
              <td class="tmp-px-3"><%= charge.billing_duration %></td>
            </tr>
            <% if charge.unit_of_measure.present? %>
              <tr>
                <th>Unit of Measure</th>
                <td class="tmp-px-3"><%= charge.unit_of_measure %></td>
              </tr>
            <% end %>
            <tr>
              <th>Zuora Charge ID</th>
              <td class="tmp-px-3"><code><%= charge.zuora_product_rate_plan_charge_id %></code></td>
            </tr>
          </table>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if product_uuid.metered? && billing_platform_product %>
    <br>

    <%= render Primer::Beta::BorderBox.new do |component| %>
      <% component.with_header do %>
        <h3 class="f4 color-fg-success">
          <%= render Primer::Beta::Octicon.new(:"check-circle") %> Billing Platform
        </h3>
      <% end %>
      <% component.with_body do %>
        <table class="text-left d-table width-full">
          <tr>
            <th class="width-30">SKU</th>
            <td class="tmp-px-3"><code><%= billing_platform_product[:sku] %></code></td>
          </tr>
          <tr>
            <th>Name</th>
            <td class="tmp-px-3"><%= billing_platform_product[:name] %></td>
          </tr>
          <tr>
            <th>Product Type</th>
            <td class="tmp-px-3"><code><%= billing_platform_product[:product_type] %></code></td>
          </tr>
          <tr>
            <th>Status</th>
            <td class="tmp-px-3">
              <%= render Primer::Beta::Label.new(scheme: :success) do %>
                <%= render Primer::Beta::Octicon.new(:check, size: :small) %> Synced
              <% end %>
            </td>
          </tr>
        </table>
      <% end %>
    <% end %>
  <% elsif product_uuid.metered? %>
    <br>
    <%= render Primer::Alpha::Banner.new(scheme: :warning) do %>
      This metered product does not have a corresponding record in Billing Platform.
    <% end %>
  <% end %>
<% end %>
