<% page_info title: "Onboarding Cohorts" %>

<%= render layout: "stafftools/stafftools" do %>
  <%= render(Stafftools::Billing::BillingPlatformOnboardingHeaderComponent.new) %>

  <% if cohorts.length > 0 %>
    <%= render(Primer::Beta::BorderBox.new(overflow: :hidden)) do |box| %>
      <% box.with_body(p: 0, overflow: :hidden) do %>
        <table class="stafftools-table">
          <thead>
            <th class="p-3">Cohort Name (Click to see customer info)</th>
            <th class="p-3">Number of Migrated Customers</th>
            <th class="p-3">Number of Non-Migrated Customers</th>
            <th class="p-3">Failed migrations</th>
            <%# todo: add planned migration date %>
            <th class="p-3">Migrate Now?</th>
          </thead>
          <tbody>
            <% cohorts.each do |cohort| %>
              <% need_to_migrate = cohort.not_processed_count > 0 %>
              <tr>
                <td class="p-3">
                  <%= render(Primer::Beta::Link.new(href: stafftools_billing_onboard_billing_platform_cohort_path(cohort.cohort_name))) { cohort.cohort_name } %>
                </td>
                <td class="p-3"><%= cohort.processed_count %></td>
                <td class="p-3"><%= cohort.not_processed_count %></td>
                <td class="p-3"><%= cohort.failed_count %></td>
                <%# todo: add planned migration date %>
                <td class="p-3">
                  <%= primer_form_with(url: stafftools_billing_onboard_billing_platform_cohorts_path, method: :post) do |f| %>
                    <%= f.hidden_field :cohort_name, value: cohort.cohort_name %>
                    <%= f.button(
                      "Migrate Now",
                      scheme: :secondary,
                      disabled: !need_to_migrate,
                      name: "migrate-cohort",
                      data: { confirm: "Are you sure you want to migrate cohort: #{cohort.cohort_name}?" }
                    ) %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% end %>
  <% elsif params[:cohort_name].present? && cohorts.empty? %>
    Could not find a billing platform customer for that query
  <% else %>
   There are currently no cohorts on billing platform
  <% end %>
<% end %>
