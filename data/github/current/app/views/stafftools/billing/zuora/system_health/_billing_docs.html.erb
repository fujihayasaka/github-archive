<%
  bill_invoices = billing_doc_volume.is_a?(Hash) ? (billing_doc_volume["totalGeneratedInvoices"] || billing_doc_volume[:totalGeneratedInvoices] || 0) : 0
  bill_memos = billing_doc_volume.is_a?(Hash) ? (billing_doc_volume["totalGeneratedCreditMemos"] || billing_doc_volume[:totalGeneratedCreditMemos] || 0) : 0
  bill_failed = billing_doc_volume.is_a?(Hash) ? (billing_doc_volume["totalFailedAccounts"] || billing_doc_volume[:totalFailedAccounts] || 0) : 0
  if error
    bill_status = "yellow"
    bill_label = "Unknown"
    bill_scheme = :attention
  else
    bill_status = bill_failed > 0 ? "red" : "green"
    bill_label = bill_failed > 0 ? "Unhealthy" : "Healthy"
    bill_scheme = bill_failed > 0 ? :danger : :success
  end
%>

<div class="health-card" style="flex: 1; min-width: 300px;">
  <% if error %>
    <%= render(Primer::Alpha::Banner.new(icon: :alert, scheme: :danger, mb: 2)) { error } %>
  <% end %>
  <div class="health-card-header">
    <span class="f4 text-bold">
      <span class="status-dot <%= bill_status %>"></span>Bill Runs
    </span>
    <%= render(Primer::Beta::Label.new(scheme: bill_scheme)) { bill_label } %>
  </div>
  <div class="metric-row"><span class="metric-label">Invoices generated</span><span class="metric-value"><%= number_with_delimiter(bill_invoices) %></span></div>
  <div class="metric-row"><span class="metric-label">Credit memos</span><span class="metric-value"><%= number_with_delimiter(bill_memos) %></span></div>
  <div class="metric-row"><span class="metric-label">Failed accounts</span><span class="metric-value" style="<%= "color: var(--fgColor-success);" if bill_failed == 0 %><%= "color: var(--fgColor-danger); font-weight: 700;" if bill_failed > 0 %>"><%= number_with_delimiter(bill_failed) %></span></div>
</div>
