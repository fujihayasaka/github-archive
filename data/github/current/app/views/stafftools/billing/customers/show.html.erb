<% page_info title: "Customer ##{customer.id}", container_xl: true %>

<%= render layout: "stafftools/stafftools" do %>
  <%# Breadcrumb %>
  <div class="tmp-mb-3">
    <%= render(Primer::Beta::Breadcrumbs.new) do |breadcrumbs| %>
      <% breadcrumbs.with_item(href: stafftools_billing_customers_path) do %>
        Customers
      <% end %>
      <% breadcrumbs.with_item(href: stafftools_billing_customer_path(customer), selected: true) do %>
        Customer #<%= customer.id %>
      <% end %>
    <% end %>
  </div>

  <%# Header %>
  <div class="d-flex flex-items-center flex-justify-between tmp-mb-3">
    <%= render(Primer::Beta::Subhead.new(classes: "tmp-mb-0")) do |subhead| %>
      <% subhead.with_heading(tag: :h2) do %>
        Customer #<%= customer.id %>
        <% if customer.name.present? %>
          — <%= customer.name %>
        <% end %>
      <% end %>
      <% subhead.with_description do %>
        <% if billable_owner.is_a?(Business) %>
          <%= render(Primer::Beta::Label.new(scheme: :accent)) do %>
            <%= render(Primer::Beta::Octicon.new(icon: "briefcase", classes: "tmp-mr-1")) %>
            Enterprise: <%= billable_owner.name %>
          <% end %>
        <% elsif billable_owner.is_a?(Organization) %>
          <%= render(Primer::Beta::Label.new(scheme: :accent)) do %>
            <%= render(Primer::Beta::Octicon.new(icon: "organization", classes: "tmp-mr-1")) %>
            Organization: @<%= billable_owner.login %>
          <% end %>
        <% elsif billable_owner.is_a?(User) %>
          <%= render(Primer::Beta::Label.new(scheme: :accent)) do %>
            <%= render(Primer::Beta::Octicon.new(icon: "person", classes: "tmp-mr-1")) %>
            User: @<%= billable_owner.login %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%# Health Dashboard (full width) %>
  <%= render(Stafftools::Billing::Customers::HealthDashboardComponent.new(
    customer: customer,
    payment_method: payment_method,
    plan_subscriptions: plan_subscriptions,
  )) %>

  <%# Compact Customer Info Bar (full width, horizontal key-value pairs) %>
  <%= render(Primer::Beta::BorderBox.new(classes: "tmp-mb-3")) do |box| %>
    <% box.with_header do %>
      <div class="d-flex flex-items-center flex-justify-between width-full">
        <h3 class="Box-title">
          <%= render(Primer::Beta::Octicon.new(icon: "info", classes: "tmp-mr-2")) %>
          Customer Info
        </h3>
        <div class="d-flex flex-items-center gap-2">
          <% if customer.locked_at.present? %>
            <%= render(Primer::Beta::Label.new(scheme: :danger)) do %>
              <%= render(Primer::Beta::Octicon.new(icon: "lock", classes: "tmp-mr-1")) %>
              Locked since <%= customer.locked_at.to_fs(:short) %>
            <% end %>
          <% end %>
          <%= render(Primer::Alpha::Dialog.new(
            title: "All Customer Attributes — ##{customer.id}",
            id: "customer-all-attrs-dialog",
            size: :xlarge,
            position: :right,
            position_narrow: :right,
          )) do |dialog| %>
            <% dialog.with_show_button(size: :small, scheme: :invisible) do %>
              <%= render(Primer::Beta::Octicon.new(icon: "list-unordered", classes: "tmp-mr-1")) %>
              All Attributes
            <% end %>
            <% dialog.with_body do %>
              <table class="stafftools-table width-full">
                <tr><th class="tmp-p-2 text-bold">ID</th><td class="tmp-p-2"><%= customer.id %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Name</th><td class="tmp-p-2"><%= customer.name %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Purpose</th><td class="tmp-p-2"><%= customer.purpose %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Billing Type</th><td class="tmp-p-2"><%= customer.billing_type %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Emails</th><td class="tmp-p-2"><%= customer.emails %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Street Address</th><td class="tmp-p-2"><%= customer.street_address %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Region</th><td class="tmp-p-2"><%= customer.region %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Postal Code</th><td class="tmp-p-2"><%= customer.postal_code %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Country</th><td class="tmp-p-2"><%= customer.country_code_alpha2 %></td></tr>
                <tr><th class="tmp-p-2 text-bold">VAT Code</th><td class="tmp-p-2"><%= customer.vat_code %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Bill Cycle Day</th><td class="tmp-p-2"><%= customer.bill_cycle_day %></td></tr>
                <tr><th class="tmp-p-2 text-bold">External UUID</th><td class="tmp-p-2"><code><%= customer.external_uuid %></code></td></tr>
                <tr><th class="tmp-p-2 text-bold">Zuora Account ID</th><td class="tmp-p-2"><code><%= customer.zuora_account_id %></code></td></tr>
                <tr><th class="tmp-p-2 text-bold">Zuora Account Number</th><td class="tmp-p-2"><code><%= customer.zuora_account_number %></code></td></tr>
                <tr><th class="tmp-p-2 text-bold">Locked At</th><td class="tmp-p-2"><%= customer.locked_at || "—" %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Disabled Reasons</th><td class="tmp-p-2"><%= customer.disabled_reasons&.to_a&.join(", ") || "—" %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Created</th><td class="tmp-p-2"><%= customer.created_at %></td></tr>
                <tr><th class="tmp-p-2 text-bold">Updated</th><td class="tmp-p-2"><%= customer.updated_at %></td></tr>
              </table>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% box.with_body(classes: "tmp-p-3") do %>
      <div class="d-flex flex-wrap gap-4">
        <div>
          <span class="d-block text-small text-bold color-fg-muted text-uppercase">ID</span>
          <span class="d-block"><%= customer.id %></span>
        </div>
        <div>
          <span class="d-block text-small text-bold color-fg-muted text-uppercase">Name</span>
          <span class="d-block"><%= customer.name || "—" %></span>
        </div>
        <div>
          <span class="d-block text-small text-bold color-fg-muted text-uppercase">Purpose</span>
          <span class="d-block">
            <%= render(Primer::Beta::Label.new(scheme: :secondary)) { customer.purpose.to_s.capitalize } %>
          </span>
        </div>
        <div>
          <span class="d-block text-small text-bold color-fg-muted text-uppercase">Billing Type</span>
          <span class="d-block">
            <%= render(Primer::Beta::Label.new(scheme: :accent)) do %>
              <% if customer.billing_type == "invoice" %>
                <%= render(Primer::Beta::Octicon.new(icon: "file", classes: "tmp-mr-1")) %>Invoice
              <% else %>
                <%= render(Primer::Beta::Octicon.new(icon: "credit-card", classes: "tmp-mr-1")) %>Card
              <% end %>
            <% end %>
          </span>
        </div>
        <% if customer.emails.present? %>
          <div>
            <span class="d-block text-small text-bold color-fg-muted text-uppercase">Email</span>
            <span class="d-block wb-break-word"><%= customer.emails %></span>
          </div>
        <% end %>
        <% if customer.vat_code.present? %>
          <div>
            <span class="d-block text-small text-bold color-fg-muted text-uppercase">VAT Code</span>
            <span class="d-block"><code><%= customer.vat_code %></code></span>
          </div>
        <% end %>
        <div>
          <span class="d-block text-small text-bold color-fg-muted text-uppercase">Bill Cycle Day</span>
          <span class="d-block"><%= customer.bill_cycle_day %></span>
        </div>
        <div>
          <span class="d-block text-small text-bold color-fg-muted text-uppercase">Created</span>
          <span class="d-block color-fg-muted"><%= customer.created_at.to_fs(:short) %></span>
        </div>
        <% if customer.disabled_reasons.present? && customer.disabled_reasons.any? %>
          <div>
            <span class="d-block text-small text-bold color-fg-muted text-uppercase">Disabled Reasons</span>
            <span class="d-block">
              <% customer.disabled_reasons.each do |reason| %>
                <%= render(Primer::Beta::Label.new(scheme: :attention, classes: "tmp-mr-1")) { reason.to_s } %>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# Billable Entities (full width) %>
  <%= render(Stafftools::Billing::Customers::BillableEntitiesComponent.new(
    customer: customer,
    customer_accounts: customer_accounts,
    billable_owner: billable_owner,
  )) %>

  <%# Payment Method + Zuora References (side-by-side) %>
  <div class="d-flex flex-column flex-md-row gap-3 tmp-mb-3">
    <div class="flex-1">
      <%= render(Stafftools::Billing::Customers::PaymentMethodCardComponent.new(
        customer: customer,
        payment_method: payment_method,
      )) %>
    </div>
    <div class="flex-1">
      <%= render(Stafftools::Billing::Customers::ZuoraInfoComponent.new(customer: customer)) %>
    </div>
  </div>

  <%# Plan Subscriptions (full width) %>
  <%= render(Stafftools::Billing::Customers::PlanSubscriptionsComponent.new(
    customer: customer,
    plan_subscriptions: plan_subscriptions,
  )) %>

  <%# Billing Contact (full width, trade compliance gated) %>
  <%= render(Stafftools::Billing::Customers::BillingContactComponent.new(
    customer: customer,
    billing_contact: billing_contact,
    show_billing_contact: show_billing_contact,
  )) %>
<% end %>
