<%# erblint:counter DeprecatedComponentsCounter 2 %>
<div class="summary">
  <dl>
    <dt>Zuora Auto Pay Status</dt>
    <dd>
      <% if account.customer.auto_pay? %>
        <%= render(Primer::Beta::Octicon.new(icon: "check")) %>
        On
      <% else %>
        <%= render(Primer::Beta::Octicon.new(icon: "x-circle")) %>
        Off
      <% end %>
    </dd>

    <% if account.customer.auto_pay_reasons.any? %>
      <dt>Auto Pay Reasons</dt>
      <dd>
        <% account.customer.auto_pay_reasons.each do |reason| %>
          <%= form_tag auto_pay_enable_path(account), class: "inline-form", method: :delete do %>
            <%= hidden_field_tag :auto_pay_reason, reason %>
            <%= render Primer::ButtonComponent.new(type: :submit, scheme: :link, "data-confirm": "Are you sure you want to remove #{reason}?") do %>
              <%= reason %>
            <% end %>
          <% end %>
        <% end %>
      </dd>
    <% end %>

    <% if account.payment_method&.valid_payment_token? %>
      <dt>Country</dt>
      <dd><%= account.payment_method.country %></dd>

      <dt>Region</dt>
      <dd><%= account.payment_method.region %></dd>
    <% end %>
  </dl>

  <br>
  <h4 class="h5">Manual Staff Override</h4>
  <p class="text-small">Manually disable auto pay for the selected reason:</p>
  <p>
    <%= form_tag auto_pay_disable_path(account), method: :post, class: "inline" do %>
      <%= select_tag :auto_pay_reason, options_for_select(Customer::AUTO_PAY_DISABLE_REASONS.keys, prompt: "Choose a reason"), required: true %>
      <%= render Primer::ButtonComponent.new(type: :submit, scheme: :link, "data-confirm": "Are you sure you want to disable AutoPay?") do %>
        <label for="auto_pay_reason">Disable AutoPay</label>
      <% end %>
    <% end %>
  </p>
</div>
