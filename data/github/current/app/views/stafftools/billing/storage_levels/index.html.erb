<% page_info title: "Watermark storage levels" %>
<%= render layout: "stafftools/stafftools" do %>
  <%= render(Primer::Beta::Subhead.new) do |component| %>
    <% component.with_heading(tag: :h2) do %>
      Watermark storage levels
    <% end %>
    <% component.with_description do %>
      <p>
        This form checks the watermark storage levels for a given customer and compares it with storage levels on the Git LFS side (if applicable for the given SKU).
      </p>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::Subhead.new) do |component| %>
    <% component.with_heading(tag: :h3) do %>
      Request
    <% end %>
    <% component.with_description do %>
      <%= form_tag stafftools_billing_storage_levels_path, :method => :get do %>
        <div class="form-group">
          <div class="form-group">
            <div class="form-group-header">
              <%= label_tag "customer_id", "Customer ID *" %>
            </div>
            <div class="form-group-body">
              <%= text_field_tag :customer_id, params[:customer_id], { required: true, placeholder: "101010" } %>
            </div>
            <div class="form-group-header">
              <%= label_tag "sku", "SKU *" %>
            </div>
            <div class="form-group-body">
              <%= select_tag :sku, options_for_select(storage_skus.map { |s| [s[:friendlyName], s[:sku]] }, params[:sku]), {
                required: true,
                class: "form-select",
              } %>
            </div>
            <div class="form-group-header">
              <%= label_tag "org_id", "Org ID *" %>
              <p class="note">Put 0 if you are querying a User account.</p>
            </div>
            <div class="form-group-body">
              <%= number_field_tag :org_id, params[:org_id], { required: true, placeholder: "101"} %>
            </div>
            <div class="form-group-header">
              <%= label_tag "repo_id", "Repo ID *" %>
            </div>
            <div class="form-group-body">
              <%= number_field_tag :repo_id, params[:repo_id], { required: true, placeholder: "101"} %>
            </div>
          </div>
        </div>

        <%= submit_tag "Check", class: "btn btn-danger", disabled: storage_skus.empty? %>
      <% end %>
    <% end %>
  <% end %>

  <% if billed_storage.present? && !error %>
    <%= render(Primer::Beta::Subhead.new) do |component| %>
      <% component.with_heading(tag: :h3) do %>
        Storage levels
      <% end %>
      <% component.with_description do %>
        <p>
          <strong>Billed storage:</strong> <%= number_with_delimiter(billed_storage) %> GB
        </p>
        <% if lfs_usage.present? %>
          <p>
            <strong>LFS usage:</strong> <%= number_with_delimiter(lfs_usage.to_f) %> GB
          </p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
