<% if result[:error] %>
  <span class="color-fg-danger text-bold">&#x26A0; <%= result[:error] %></span>
<% else %>
  <span class="color-fg-success text-bold">&#x2713;
    <% if result[:type] %><%= result[:type] %><% end %>
    <% if result[:slug] %>@<%= result[:slug] %><% end %>
    <% if result[:name] && result[:name] != result[:slug] %>(<%= result[:name] %>)<% end %>
  </span>
<% end %>
