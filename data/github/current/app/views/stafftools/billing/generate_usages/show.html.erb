<% page_info title: "Generate Usage" %>
<%= render layout: "stafftools/stafftools" do %>
  <%= render(Primer::Beta::Subhead.new) do |component| %>
    <% component.with_heading(tag: :h2) do %>
      Generate Usage
    <% end %>
    <% component.with_description do %>
      <p>
        This form emits usage for a customer. Possible use-cases are described in
        <%= link_to "this playbook", "https://github.com/github/gitcoin/blob/main/docs/playbook/howto/generate_usage.md", target: "_blank", class: "Link--inTextBlock" %>.
      </p>

      <p>
        Customer ID, SKU, Source URI and Quantity are required parameters in order to
        ensure usage is collected for the right product. It is encouraged to
        provide org &amp; repo IDs as well, but they are optional for flexibility.
      </p>

      <p>
        <strong>Note:</strong> Usage is generated by <em>customer ID</em>, which is a billing-specific identifier
        and is <strong>different</strong> from a business ID, org ID, or user ID. Use the lookup below each field
        to confirm you are targeting the correct entity before submitting.
      </p>
    <% end %>
  <% end %>

  <%= form_tag stafftools_billing_generate_usages_path, :method => :post do %>
    <div class="form-group">
      <div class="form-group">
        <div class="form-group-header">
          <%= label_tag "customer_id", "Customer ID *" %>
        </div>
        <div class="form-group-body">
          <entity-lookup data-lookup-url="<%= stafftools_billing_generate_usages_entity_lookups_path %>" data-entity-type="customer">
            <%= number_field_tag :customer_id, nil, {
              required: true,
              placeholder: "123",
              data: { target: "entity-lookup.input", action: "input:entity-lookup#scheduleLookup" }
            }.merge(enforce_positive_inputs ? { min: 0 } : {}) %>
            <p class="note">Enter the billing customer ID (not a business, org, or user ID).</p>
            <div data-target="entity-lookup.result" class="mt-1" aria-live="polite"></div>
          </entity-lookup>
        </div>
        <% display_skus = all_skus.map do |sku| %>
          <% friendly_name = case sku[:sku] %>
          <% when "coding_agent_premium_request" then "Copilot Cloud Agent Premium Request" %>
          <% when "coding_agent_ai_unit" then "Copilot Cloud Agent AI Credit" %>
          <% else sku[:friendlyName] %>
          <% end %>
          <% sku.merge(friendlyName: friendly_name) %>
        <% end %>
        <linked-sku-select data-linked-sku-select-skus-value="<%= display_skus.to_json %>">
          <div class="form-group-header">
            <%= label_tag "product", "Product *" %>
          </div>
          <div class="form-group-body">
            <%= select_tag :product, options_for_select(product_keys.map { |p| [p, p] }, params[:product]), {
              required: true,
              class: "form-select",
              data: {
                target: "linked-sku-select.product"
              }
            } %>
          </div>
          <div class="form-group-header">
            <%= label_tag "sku", "SKU *" %>
          </div>
          <div class="form-group-body">
            <% initial_skus = params[:product] ? display_skus.select { |s| s[:product] == params[:product] } : [] %>
            <%= select_tag :sku, options_for_select(initial_skus.map { |s| [s[:friendlyName], s[:sku]] }, params[:sku]), {
              required: true,
              class: "form-select",
              data: { target: "linked-sku-select.sku" }
            } %>
          </div>
        </linked-sku-select>
        <div class="form-group-header">
          <%= label_tag "org_id", "Org ID" %>
        </div>
        <div class="form-group-body">
          <entity-lookup data-lookup-url="<%= stafftools_billing_generate_usages_entity_lookups_path %>" data-entity-type="org">
            <%= number_field_tag :org_id, nil, {
              placeholder: "123",
              data: { target: "entity-lookup.input", action: "input:entity-lookup#scheduleLookup" }
            }.merge(enforce_positive_inputs ? { min: 0 } : {}) %>
            <div data-target="entity-lookup.result" class="mt-1" aria-live="polite"></div>
          </entity-lookup>
        </div>
        <div class="form-group-header">
          <%= label_tag "repo_id", "Repo ID" %>
        </div>
        <div class="form-group-body">
          <entity-lookup data-lookup-url="<%= stafftools_billing_generate_usages_entity_lookups_path %>" data-entity-type="repo">
            <%= number_field_tag :repo_id, nil, {
              placeholder: "123",
              data: { target: "entity-lookup.input", action: "input:entity-lookup#scheduleLookup" }
            }.merge(enforce_positive_inputs ? { min: 0 } : {}) %>
            <div data-target="entity-lookup.result" class="mt-1" aria-live="polite"></div>
          </entity-lookup>
        </div>
        <div class="form-group-header">
          <%= label_tag "actor_id", "Actor ID" %>
        </div>
        <div class="form-group-body">
          <entity-lookup data-lookup-url="<%= stafftools_billing_generate_usages_entity_lookups_path %>" data-entity-type="actor">
            <%= number_field_tag :actor_id, nil, {
              placeholder: "123",
              data: { target: "entity-lookup.input", action: "input:entity-lookup#scheduleLookup" }
            }.merge(enforce_positive_inputs ? { min: 0 } : {}) %>
            <div data-target="entity-lookup.result" class="mt-1" aria-live="polite"></div>
          </entity-lookup>
        </div>
        <div class="form-group-header">
          <%= label_tag "source_uri", "Source URI *" %>
        </div>
        <div class="form-group-body">
          <%= text_field_tag :source_uri, "gid://ManualCharge", required: true %>
        </div>
        <div class="form-group-header">
          <%= label_tag "quantity", "Quantity *" %>
        </div>
        <div class="form-group-body">
          <%= number_field_tag :quantity, nil, { step: "any", required: true, placeholder: "56.33" } %>
        </div>
        <div class="form-group-header">
          <%= label_tag "copilot_model", "Copilot Model" %>
        </div>
        <div class="form-group-body">
          <%= text_field_tag :copilot_model, nil, placeholder: "e.g., gpt-4o, claude-3.5-sonnet" %>
          <p class="note">Optional: Enter the Copilot model for premium request usage events.</p>
        </div>
        <div class="form-group-header">
          <%= label_tag "copilot_plan", "Copilot Plan" %>
        </div>
        <div class="form-group-body">
          <%= select_tag :copilot_plan, options_for_select([
            ["(none)", ""],
            ["UNKNOWN", "UNKNOWN"],
            ["BUSINESS", "BUSINESS"],
            ["ENTERPRISE", "ENTERPRISE"],
            ["INDIVIDUAL", "INDIVIDUAL"],
            ["INDIVIDUAL_FREE", "INDIVIDUAL_FREE"],
            ["INDIVIDUAL_TRIAL", "INDIVIDUAL_TRIAL"],
            ["INDIVIDUAL_PRO_PLUS", "INDIVIDUAL_PRO_PLUS"],
            ["INDIVIDUAL_EDU", "INDIVIDUAL_EDU"],
            ["INDIVIDUAL_MAX", "INDIVIDUAL_MAX"],
          ], params[:copilot_plan]), { class: "form-select" } %>
          <p class="note">Optional: Specify the Copilot plan/tier for this usage event (for spending limit fidelity).</p>
        </div>
        <div class="form-group-header">
          <%= label_tag "non_billable", "Non-Billable" %>
        </div>
        <div class="form-group-body">
          <%= check_box_tag :non_billable, "1", false %>
          <p class="note">Optional: Mark this usage as non-billable (included in plan). This applies a 100% discount, simulating usage within the included allowance. Useful for testing budget state creation for premium request budgets without incurring charges.</p>
        </div>
      </div>
    </div>

    <%= submit_tag "Send usage", class: "btn btn-danger", disabled: all_skus.empty? %>
  <% end %>
<% end %>
