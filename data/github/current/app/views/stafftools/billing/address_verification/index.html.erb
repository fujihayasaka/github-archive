<% page_info title: "Address Verification", selected_link: :billing_address_verification %>

<%= render layout: "stafftools/stafftools" do %>
  <div class="Box">
    <div class="Box-header">
      <h3 class="Box-title">
        <%= render Primer::Beta::Octicon.new(icon: "location", size: :small) %>
        Address Verification
      </h3>
    </div>
    <div class="Box-body">
      <p class="f5 color-fg-muted mb-3">
        Use this tool to verify customer addresses through Taxamo. This is useful for debugging address validation issues reported by customers.
      </p>

      <%= form_with url: stafftools_billing_address_verification_index_path, method: :get, local: true do |form| %>
        <dl class="form-group mb-3 width-full">
          <dt><%= form.label :street, "Street Address", class: "form-label" %></dt>
          <dd><%= form.text_field :street,
              placeholder: "88 Colin P Kelly Jr St",
              required: true,
              value: params[:street],
              class: "form-control input-lg width-full" %></dd>
        </dl>

        <dl class="form-group mb-3 width-full">
          <dt><%= form.label :city, "City", class: "form-label" %></dt>
          <dd><%= form.text_field :city,
              placeholder: "San Francisco",
              required: true,
              value: params[:city],
              class: "form-control input-lg width-full" %></dd>
        </dl>

        <div class="d-md-flex">
          <dl class="form-group col-md-6 pr-md-3 mb-3">
            <dt><%= form.label :region, "State/Region", class: "form-label" %></dt>
            <dd><%= form.text_field :region,
                placeholder: "CA",
                required: true,
                value: params[:region],
                class: "form-control input-lg" %></dd>
          </dl>

          <dl class="form-group col-md-6 mb-3">
            <dt><%= form.label :postal_code, "Postal Code", class: "form-label" %></dt>
            <dd><%= form.text_field :postal_code,
                placeholder: "94107",
                required: true,
                value: params[:postal_code],
                class: "form-control input-lg" %></dd>
          </dl>
        </div>

      <details class="details-reset mt-3">
        <%= render Primer::Beta::Button.new(tag: :summary, scheme: :link, color: :muted, font_size: 6) do %>
          <%= render Primer::Beta::Octicon.new(icon: "gear", size: :small) %>
          Advanced Options
        <% end %>
          <div class="mt-2 pl-3">
            <div class="d-md-flex">
              <dl class="form-group col-md-6 pr-md-3 mb-3">
                <dt><%= form.label :currency_code, "Currency Code", class: "form-label" %></dt>
                <dd><%= form.text_field :currency_code,
                    placeholder: "USD",
                    value: params[:currency_code] || "USD",
                    class: "form-control input-lg" %></dd>
              </dl>

              <dl class="form-group col-md-6 mb-3">
                <dt><%= form.label :billing_country_code, "Billing Country Code", class: "form-label" %></dt>
                <dd><%= form.text_field :billing_country_code,
                    placeholder: "US",
                    value: params[:billing_country_code] || "US",
                    class: "form-control input-lg" %></dd>
              </dl>
            </div>
          </div>
      </details>

        <div class="form-actions mt-4">
          <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary, size: :large)) do %>
            Verify Address
          <% end %>
          <%= render(Primer::Beta::Button.new(tag: :a, href: stafftools_billing_address_verification_index_path, scheme: :secondary, size: :large, ml: 2)) do %>
            Clear Form
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if lookup_result %>
    <div class="Box mt-3">
      <div class="Box-header">
        <h3 class="Box-title">
          <%= render Primer::Beta::Octicon.new(icon: "search", size: :small) %>
          Verification Results
        </h3>
      </div>
      <div class="Box-body">
      <% if lookup_result.exact_match? %>
        <%= render(Primer::Alpha::Banner.new(scheme: :success, icon: "check-circle", test_selector: "address-verification-success")) do %>
          Exact address match found
        <% end %>

        <% if match = lookup_result.match %>
            <div class="mt-3">
              <h4 class="f4 mb-2">Verified Address:</h4>
              <dl class="form-group-body">
                <dt class="text-bold">Street:</dt>
                <dd><%= match.street_name %></dd>
                <dt class="text-bold">City:</dt>
                <dd><%= match.city %></dd>
                <dt class="text-bold">Region:</dt>
                <dd><%= match.region %></dd>
                <dt class="text-bold">Postal Code:</dt>
                <dd><%= match.postal_code %></dd>
                <% if match.county.present? %>
                  <dt class="text-bold">County:</dt>
                  <dd><%= match.county %></dd>
                <% end %>
              </dl>
            </div>
        <% end %>
      <% elsif lookup_result.suggested_match? %>
        <%= render(Primer::Alpha::Banner.new(scheme: :warning, icon: "alert", test_selector: "address-verification-warning")) do %>
          Similar address found with suggested corrections
        <% end %>

        <% if match = lookup_result.match %>
            <div class="mt-3">
              <h4 class="f4 mb-2">Suggested Address:</h4>
              <p class="color-fg-muted mb-2">
                Consider suggesting this corrected version to the customer:
              </p>
              <dl class="form-group-body">
                <dt class="text-bold">Street:</dt>
                <dd>
                  <% if match.street_name != params[:street] %>
                    <span class="color-bg-attention-emphasis color-fg-on-emphasis px-1 rounded-1"><%= match.street_name %></span>
                  <% else %>
                    <%= match.street_name %>
                  <% end %>
                </dd>
                <dt class="text-bold">City:</dt>
                <dd>
                  <% if match.city != params[:city] %>
                    <span class="color-bg-attention-emphasis color-fg-on-emphasis px-1 rounded-1"><%= match.city %></span>
                  <% else %>
                    <%= match.city %>
                  <% end %>
                </dd>
                <dt class="text-bold">Region:</dt>
                <dd>
                  <% if match.region != params[:region] %>
                    <span class="color-bg-attention-emphasis color-fg-on-emphasis px-1 rounded-1"><%= match.region %></span>
                  <% else %>
                    <%= match.region %>
                  <% end %>
                </dd>
                <dt class="text-bold">Postal Code:</dt>
                <dd>
                  <% if match.postal_code != params[:postal_code] %>
                    <span class="color-bg-attention-emphasis color-fg-on-emphasis px-1 rounded-1"><%= match.postal_code %></span>
                  <% else %>
                    <%= match.postal_code %>
                  <% end %>
                </dd>
                <% if match.county.present? %>
                  <dt class="text-bold">County:</dt>
                  <dd><%= match.county %></dd>
                <% end %>
              </dl>
            </div>
        <% end %>
      <% elsif lookup_result.no_match? %>
        <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: "x-circle", test_selector: "address-verification-error")) do %>
          No address match found
        <% end %>

        <div class="mt-3">
          <p>The address could not be validated by Taxamo. This may indicate:</p>
          <ul>
            <li>Invalid or incorrect address details</li>
            <li>Address format issues</li>
            <li>Unsupported region or postal code</li>
          </ul>
        </div>
      <% end %>

      <% if lookup_result.error.present? %>
        <div class="mt-3">
          <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: "alert")) do %>
            Error Details
          <% end %>
          <% error = lookup_result.error %>
          <dl class="form-group-body mt-2">
            <dt class="text-bold">Error Code:</dt>
            <dd><%= error.error_code %></dd>
            <dt class="text-bold">Messages:</dt>
            <dd><%= error.messages.join(", ") %></dd>
          </dl>
        </div>
      <% end %>

      <% if raw_response %>
        <details class="details-reset mt-3">
          <%= render Primer::Beta::Button.new(tag: :summary, scheme: :link, color: :muted, font_size: 6) do %>
            <%= render Primer::Beta::Octicon.new(icon: "code", size: :small) %>
            Raw Taxamo Response (for debugging)
          <% end %>
          <div class="mt-3 p-3 color-bg-subtle border rounded-2">
            <pre class="color-fg-muted f6"><%= JSON.pretty_generate(raw_response) %></pre>
          </div>
        </details>
      <% end %>
      </div>
    </div>
  <% end %>
<% end %>
