<h2 class="mt-0 mb-2">Actions</h2>

<% if stafftools_action_authorized?(controller: Stafftools::BusinessStartupsProgramsController, action: :update) %>
  <%= render layout: "shared/details_dialog", locals: {
      button_class: "btn btn-sm mr-2",
      button_text: "Proceed to screening",
      title: "Confirm screening",
      disabled: application.application_status != "processing" } do %>
    <%= render(Primer::Beta::BorderBox.new) do |box| %>
      <% box.with_body do %>
        <p>Queue this application for automated screening?</p>
        <%= form_with url: stafftools_business_startups_program_path(application), method: :patch, local: true do |f| %>
          <%= f.hidden_field :decision, value: "screen" %>
          <%= f.submit "Confirm", class: "btn btn-primary btn-sm" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render layout: "shared/details_dialog", locals: {
      button_class: "btn btn-sm mr-2",
      button_text: "Accept (override)",
      title: "Accept application",
      disabled: application.application_status.in?(["accepted", "graduated"]) } do %>
    <%= render(Primer::Beta::BorderBox.new) do |box| %>
      <% box.with_body do %>
        <p>Manually accept this application?</p>
        <%= form_with url: stafftools_business_startups_program_path(application), method: :patch, local: true do |f| %>
          <%= f.hidden_field :decision, value: "accept" %>
          <%= f.label :reason, "Override reason (optional)", class: "form-label" %>
          <%= f.text_field :reason, class: "form-control mb-2" %>

          <fieldset class="border tmp-p-3 mb-2 rounded-2">
            <legend class="form-label h6">Billing Credit (optional)</legend>
            <p class="text-small color-fg-muted mb-2">Apply a discount credit via the Billing Platform when accepting.</p>

            <div class="form-checkbox mb-2">
              <%= f.check_box :apply_credit, class: "form-checkbox-details-trigger" %>
              <%= f.label :apply_credit, "Apply billing credit on accept" %>
            </div>

            <div class="mb-2">
              <%= f.label :credit_amount, "Credit amount (USD)", class: "form-label" %>
              <%= f.number_field :credit_amount, value: 10000, min: 1, step: "0.01", class: "form-control" %>
            </div>

            <div class="mb-2">
              <%= f.label :credit_duration_months, "Credit duration (months)", class: "form-label" %>
              <%= f.number_field :credit_duration_months, value: 12, min: 1, max: 60, class: "form-control" %>
            </div>
          </fieldset>

          <%= f.submit "Confirm acceptance", class: "btn btn-primary btn-sm" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render layout: "shared/details_dialog", locals: {
      button_class: "btn btn-sm mr-2",
      button_text: "Reject (override)",
      title: "Reject application",
      disabled: application.application_status.in?(["rejected", "graduated"]) } do %>
    <%= render(Primer::Beta::BorderBox.new) do |box| %>
      <% box.with_body do %>
        <p>Manually reject this application?</p>
        <%= form_with url: stafftools_business_startups_program_path(application), method: :patch, local: true do |f| %>
          <%= f.hidden_field :decision, value: "reject" %>
          <%= f.label :reason, "Rejection reason", class: "form-label" %>
          <%= f.text_field :reason, class: "form-control mb-2", required: true %>
          <%= f.submit "Confirm rejection", class: "btn btn-danger btn-sm" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
