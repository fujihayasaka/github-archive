
<tr>
  <td><%= link_to application.id, stafftools_business_startups_program_path(application) %></td>
  <td>
    <% if application.business.present? %>
      <%= link_to application.business.slug, stafftools_enterprise_path(application.business) %>
    <% else %>
      N/A
    <% end %>
  </td>
  <td>
    <% applicant = application.applicant %>
    <% if applicant.present? %>
      <%= link_to applicant.login, stafftools_user_path(applicant) %>
    <% else %>
      N/A
    <% end %>
  </td>
  <td><%= application.application_data&.dig("partner_id") || "N/A" %></td>
  <td><%= application.application_status || "N/A" %></td>
  <td><%= application.submitted_at || "N/A" %></td>
  <td><%= link_to "View", stafftools_business_startups_program_path(application) %></td>
</tr>
