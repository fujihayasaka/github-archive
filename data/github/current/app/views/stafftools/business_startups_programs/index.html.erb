<% page_info title: "GitHub for Startups Applications" %>

<div class="tmp-mb-4 d-flex flex-items-end flex-justify-between">
  <%= form_with url: stafftools_business_startups_programs_path, method: :get, local: true, class: "d-flex flex-items-end" do |f| %>
    <div class="tmp-mr-3">
      <%= f.label :status, "Status", class: "form-label" %>
      <%= f.select :status,
        options_for_select(
          [["All", ""]] + BusinessStartupsProgram.application_statuses.keys.map { |status| [status.titleize, status] },
          params[:status]
        ),
        {},
        class: "form-select"
      %>
    </div>
    <%= f.submit "Filter", class: "btn btn-sm" %>
  <% end %>

  <% if stafftools_action_authorized?(controller: Stafftools::BusinessStartupsProgramsController, action: :create) %>
    <%= render layout: "shared/details_dialog", locals: {
        button_class: "btn btn-primary btn-sm",
        button_text: "Create Application",
        title: "Create Application" } do %>
      <%= render(Primer::Beta::BorderBox.new) do |box| %>
        <% box.with_body do %>
          <%= form_with url: stafftools_business_startups_programs_path, method: :post, local: true do |f| %>
            <div class="tmp-mb-2">
              <%= f.label :business_slug, "Business slug", for: "business-startups-program-business-slug", class: "form-label d-block" %>
              <%= f.text_field :business_slug, id: "business-startups-program-business-slug", required: true, class: "form-control" %>
            </div>

            <div class="tmp-mb-2">
              <%= f.label :user_login, "User login", for: "business-startups-program-user-login", class: "form-label d-block" %>
              <%= f.text_field :user_login, id: "business-startups-program-user-login", required: true, class: "form-control" %>
            </div>

            <div class="tmp-mb-2">
              <%= f.label :email, "Email", for: "business-startups-program-email", class: "form-label d-block" %>
              <%= f.email_field :email, id: "business-startups-program-email", required: true, class: "form-control" %>
            </div>

            <div class="tmp-mb-2">
              <%= f.label :partner_id, "Partner ID", for: "business-startups-program-partner-id", class: "form-label d-block" %>
              <%= f.text_field :partner_id, id: "business-startups-program-partner-id", required: true, class: "form-control" %>
            </div>

            <%= f.submit "Create", class: "btn btn-primary btn-sm" %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

<table class="stafftools-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Enterprise account</th>
      <th>Applicant</th>
      <th>Partner/PID</th>
      <th>Status</th>
      <th>Submitted at</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% applications.each do |application| %>
      <%= render "stafftools/business_startups_programs/application_row", application: application %>
    <% end %>
  </tbody>
</table>

<%= will_paginate applications %>
