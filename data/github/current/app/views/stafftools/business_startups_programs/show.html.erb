<% page_info title: "GFS Application ##{application.id}" %>
<% applicant = application.applicant %>

<table class="stafftools-table tmp-mb-4">
  <tr>
    <th>Enterprise account</th>
    <td>
      <% if application.business.present? %>
        <%= link_to application.business.slug, stafftools_enterprise_path(application.business) %>
      <% else %>
        N/A
      <% end %>
    </td>
  </tr>
  <tr>
    <th>Applicant</th>
    <td>
      <% if applicant.present? %>
        <%= link_to applicant.login, stafftools_user_path(applicant) %>
      <% else %>
        N/A
      <% end %>
    </td>
  </tr>
  <tr>
    <th>Partner/PID</th>
    <td><%= application.application_data&.dig("partner_id") || "N/A" %></td>
  </tr>
  <tr>
    <th>Status</th>
    <td><%= application.application_status || "N/A" %></td>
  </tr>
  <tr>
    <th>Submitted at</th>
    <td><%= application.submitted_at || "N/A" %></td>
  </tr>
  <tr>
    <th>Processed at</th>
    <td><%= application.processed_at || "N/A" %></td>
  </tr>
  <tr>
    <th>Accepted at</th>
    <td><%= application.accepted_at || "N/A" %></td>
  </tr>
  <tr>
    <th>Rejected at</th>
    <td><%= application.rejected_at || "N/A" %></td>
  </tr>
  <tr>
    <th>Rejection reason</th>
    <td><%= application.rejection_reason || "N/A" %></td>
  </tr>
  <tr>
    <th>Company name</th>
    <td><%= application.application_data&.dig("company_name") || "N/A" %></td>
  </tr>
  <tr>
    <th>Crunchbase URL</th>
    <td><%= application.application_data&.dig("crunchbase_link") || "N/A" %></td>
  </tr>
  <tr>
    <th>Company website</th>
    <td><%= application.application_data&.dig("company_website") || "N/A" %></td>
  </tr>
  <tr>
    <th>Email</th>
    <td><%= application.applicant_email || "N/A" %></td>
  </tr>
</table>

<%= render "stafftools/business_startups_programs/actions", application: application %>
