<p>
In some cases some users get notifications from repositories they don't have access to, maybe because they don't belong to the same organization or because there is a typo in an email address. In these cases users can't block these emails. Here we can edit the list of emails so these users stop receiving them.
</p>

<%= form_with(url: gh_stafftools_repository_notification_settings_path(current_repository), model: view.hook, method: :put) do |form| %>
  <div class="form-group">
    <%= render Primer::Alpha::TextField.new(
      name: form.field_name(:config_attributes, :address),
      label: "Address (raw)",
      value: view.hook.masked_config["address"],
      placeholder: "one@example.com two@example.com",
      required: true,
      caption: "Whitespace separated email addresses (at most two)"
    ) %>
  </div>

  <div class="form-group">
    <%= render Primer::Alpha::CheckBox.new(
      name: form.field_name(:active),
      label: "Active",
      checked: view.hook.active?,
      caption: "We will send notification emails to the listed addresses when a push event is triggered"
    ) %>
  </div>

  <div class="form-group">
    <%= render Primer::Beta::Button.new(type: :submit) do %>
      Update
    <% end %>
  </div>
<% end %>

<div class="form-group">
  <%= render(Primer::Alpha::Dialog.new(id: "custom-dialog-clear-email", title: "Custom dialog clear email")) do |d| %>
    <% d.with_show_button(scheme: :danger, size: :medium) { "Delete" } %>
    <% d.with_header(show_divider: true, font_weight: :bold, font_size: 5) { "Clear email notification settings?" } %>
    <% d.with_body(p: 0) do %>
      <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
        This action cannot be undone. Future events will no longer be delivered to these configured email addresses.
      <% end %>
    <% end %>
    <% d.with_footer(pt: 3) do %>
      <%= form_tag gh_stafftools_repository_notification_settings_path(current_repository), class: "inline-form width-full", method: :delete do %>
        <% render(Primer::Beta::Button.new(
           scheme: :danger,
           type: :submit,
           size: :medium,
           block: true
         )) do |_c| %>
          Yes, clear email notification settings
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
