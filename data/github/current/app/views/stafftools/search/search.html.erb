<% view = Stafftools::RepositoryViews::IndexView.new %>
<%= render layout: "stafftools/stafftools" do %>
  <div class="stafftools-search" data-hpc>
    <%= form_tag "/stafftools/search", :method => :get, :id => "stafftools-search-form", :style => "display: inline-block;" do %>
      <%= text_field_tag :query, query, :class => "short", :autofocus => true,
        "aria-label" => "Search users, organizations, repositories, gists and OAuth applications" %>
      <%= render Primer::Beta::Button.new(type: :button, display: :inline_block, id: "regular-search-btn") do %>Search<% end %>
    <% end %>
    <%= form_tag "/stafftools/search", :method => :get, :id => "audit-search-form", :style => "display: inline-block; margin-left: 8px;" do %>
      <%= hidden_field_tag :query, query %>
      <%= hidden_field_tag :search_type, "audit_log_queries" %>
      <%= render Primer::Beta::Button.new(
        type: :button,
        display: :inline_block,
        scheme: :secondary,
        id: "audit-search-btn"
      ) do %>Search Deleted/Renamed<% end %>
    <% end %>
  </div>

  <div>
    <%= render_react_partial name: "search-results", props: { searchQuery: query, searchType: local_assigns[:search_type]} %>
  </div>
<% end %>
