<%# erblint:counter DeprecatedComponentsCounter 2 %>
<%# view is instance of IntegrationInstallations::ShowView %>
<% page_info \
  :title => "Update #{view.integration.name}'s repository access", :class => "color-bg-subtle", hide_marketplace_retargeting_notice: true, hide_marketplace_pending_installations_notice: true
%>

<div class="integrations-auth-wrapper">
  <div class="CircleBadge CircleBadge--medium mx-auto tmp-mb-4" style="<%= view.logo_background_color_style_rule %>">
    <%= oauth_application_logo(view.integration, 50, :class => "CircleBadge-icon" )%>
  </div>

  <h2 class="f2 tmp-mb-4 text-center text-normal">Update <%= view.integration.name %>'s repository access</h2>

  <div class="Box tmp-p-4 color-shadow-small">
    <% if show_agentic_edit_policy_warning? %>
      <%= render(Primer::Beta::Flash.new(scheme: :warning, classes: "tmp-mb-3")) do %>
        <%= view.integration.name %> provides agent features. Whether they're enabled for
        <%= view.target.safe_profile_name %> is managed by the
        <%= link_to "agent apps policy", settings_org_copilot_policies_path(view.target), class: "Link--inTextBlock" %> in organization settings.
      <% end %>
    <% end %>

    <p class="f4 border-bottom pb-2 tmp-mb-4">
      <%= view.integration.name %> has access to the following repositories
      <% if view.target == current_user %>
        personal account
        <%= account %>
        <%= avatar_for(view.target, 20, :class => 'target-avatar avatar float-right position-relative', :style => 'top:3px;' ) %>
      <% else %>
        organization
        <%= view.target.safe_profile_name %>
        <%= avatar_for(view.target, 20, :class => 'target-avatar avatar float-right position-relative' ) %>
      <% end %>
    </p>

    <%= render Primer::Beta::Subhead.new(spacious: true, mb: 0) do |component| %>
      <% component.with_heading(tag: :h2) do %>Repository access<% end %>
    <% end %>

    <%= form_for view.installation, url: gh_update_app_installation_path(view.integration, view.installation, current_user), method: :put, html: {class: "js-integrations-install-form"} do %>
      <%= hidden_field_tag "target_id", view.target.id %>
      <%= hidden_field_tag "integration_fingerprint", view.integration.fingerprint %>

      <div class="form-group settings-next my-0">
        <% if !view.repository_installation_required? %>
          <div class="form-checkbox integrations-install-target my-0">
            <label>
              <%= radio_button_tag "install_target", "none", view.installed_on_no_repositories?, :class => "js-installation-repositories-radio" %>
              No repositories
            </label>
            <p class="note text-small m-0 color-fg-muted">
              This App does not require access to your repositories.
            </p>
          </div>
        <% end %>
        <% if view.repository_installation_required? %>
          <div class="tmp-mt-4">
          <%= render partial: "integration_installations/select_repositories", locals: {
            repository_target_switching_disabled: true, # Repo admins are currently unable to request installation on "All" repositories from the Edit view
            view: view.suggestions_view,
          } %>
          </div>
        <% end %>

        <% access_group_view = IntegrationInstallations::AccessGroupingsView.new(integration_installation: view.installation) %>
        <%= render Primer::Beta::Subhead.new(spacious: true, mb: 0) do |component| %>
          <% component.with_heading(tag: :h2) do %>Permissions<% end %>
        <% end %>

        <%= render partial: "integration_installations/requested_permissions_list",
          locals: {
            access_group_view: access_group_view,
            row_class: "Box-row border-bottom px-0"
          }
         %>

        <% if show_agentic_installation_consent? %>
          <div class="form-group tmp-mt-4">
            <div class="d-flex flex-column flex-sm-row flex-justify-between flex-items-start gap-2">
              <div class="d-flex flex-column min-width-0 flex-auto">
                <p id="agentic-installation-toggle-label" class="text-bold mb-0">
                  Enable agent features
                </p>

                <p id="agentic-installation-toggle-note" class="text-small color-fg-muted mt-2 mb-0">
                  Allows agent features for <%= view.integration.name %>. You can assign issues to <%= link_to "agent apps", "https://gh.io/agent-apps-docs", class: "Link--inTextBlock", target: "_blank", rel: "noopener noreferrer" %>, @mention them in pull request comments and trigger them from the Agents tab.
                </p>

                <% unless agentic_installation_consent_manageable? %>
                  <p id="agentic-installation-toggle-disabled-note" class="text-small color-fg-attention mt-2 mb-0">
                    <%= primer_octicon(:alert, mr: 1) %>An organization administrator must enable this from organization settings.
                  </p>
                <% end %>

                <% if show_agentic_install_policy_warning? %>
                  <p id="agentic-installation-toggle-policy-note" class="text-small color-fg-attention mt-2 mb-0">
                    <%= primer_octicon(:alert, mr: 1) %>The <%= link_to "agent apps policy", settings_org_copilot_policies_path(current_target), class: "Link--inTextBlock" %> must be enabled in organization settings for agent features to become available.
                  </p>
                <% end %>
              </div>

              <div class="d-flex flex-items-center">
                <% describedby_ids = ["agentic-installation-toggle-note"] %>
                <% describedby_ids << "agentic-installation-toggle-disabled-note" unless agentic_installation_consent_manageable? %>
                <% describedby_ids << "agentic-installation-toggle-policy-note" if show_agentic_install_policy_warning? %>
                <%= hidden_field_tag "enable_agentic_features", "0" %>
                <%= check_box_tag "enable_agentic_features", "1", agentic_installation_consent_manageable?,
                  class: "FormControl-checkbox",
                  disabled: !agentic_installation_consent_manageable?,
                  aria: { labelledby: "agentic-installation-toggle-label", describedby: describedby_ids.join(" ") }
                %>
              </div>
            </div>
          </div>

          <hr class="tmp-my-4">
        <% end %>

        <div class="tmp-mt-4">
          <%= render Primer::ButtonComponent.new(scheme: :primary, classes: "js-integrations-install-form-submit", type: :submit, disabled: true) do %>Update access<% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
