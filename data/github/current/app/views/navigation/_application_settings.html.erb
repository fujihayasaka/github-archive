<%= render Primer::Beta::Subhead.new(hide_border: true) do |component| %>
  <% component.with_heading(tag: :h2) do %>Applications<% end %>
<% end %>

<%= render Primer::Alpha::UnderlineNav.new(label: "Application settings", tag: :div, align: :left, mb: 3) do |component| %>
  <% component.with_tab(href: gh_settings_installations_path(current_user), selected: current_page?(gh_settings_installations_path(current_user))) do |tab| %>
    <% tab.with_icon(icon: :download) %>
    <% tab.with_text { "Installed GitHub Apps" } %>
  <% end %>
  <% component.with_tab(href: settings_user_app_authorizations_path, selected: current_page?(settings_user_app_authorizations_path)) do |tab| %>
    <% tab.with_icon(icon: :apps) %>
    <% tab.with_text { "Authorized GitHub Apps" } %>
  <% end %>
  <% component.with_tab(href: settings_user_applications_path, selected: current_page?(settings_user_applications_path)) do |tab| %>
    <% tab.with_icon(icon: :person) %>
    <% tab.with_text { "Authorized OAuth Apps" } %>
  <% end %>
<% end %>
