<div class="col-md-3 col-12 pr-md-4 pr-0">
  <%= render(Primer::Beta::NavList.new(
      aria: { label: "OAuth app settings" },
    )) do |component| %>
    <% component.with_item(
      label: "General",
      href: oauth_application_path(current_application),
    ) %>
    <% component.with_item(
      label: "Optional features",
      href: settings_oauth_application_beta_features_path(current_application),
    ) %>
    <% component.with_item(
      label: "Advanced",
      href: settings_oauth_application_advanced_path(current_application),
    ) %>
  <% end %>
</div>
