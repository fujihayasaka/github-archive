<%
potential_selected_tabs = []
if scheduled_discussions_enabled?
  potential_selected_tabs << :draft if query&.include?("is:draft")
  potential_selected_tabs << :scheduled if query&.include?("is:scheduled")
end
potential_selected_tabs << :commented if query&.include?("commenter:")
potential_selected_tabs << :created
selected_tab = potential_selected_tabs.first

commented_selected = selected_tab == :commented
draft_selected = selected_tab == :draft
scheduled_selected = selected_tab == :scheduled
created_selected = selected_tab == :created

page_info title: "Discussions", breadcrumb: "Discussions"
%>

<div class="<%= class_names(
  "tmp-pt-4 position-relative p-responsive",
  "container-xl" => container_xl?,
  "container-lg" => !container_xl?
) %>">
  <%= render ConditionalAccess::UnauthorizedAccountsComponent.new(
    classes: "Box mb-1",
    container_classes: "mb-2",
    resource_label: "discussions",
    cap_filter: cap_filter
  ) %>
  <h1 class="sr-only">Discussions</h1>
  <div class="subnav d-flex tmp-mb-3 flex-column flex-md-row" data-pjax>
    <nav aria-label="Discussions filter" id="discussion-filter-header">
      <%= render(Primer::Alpha::SegmentedControl.new("aria-labelledby": "discussion-filter-header")) do |component| %>
        <%= component.with_item(
          tag: :a,
          href: all_discussions_path,
          label: "Created",
          selected: created_selected,
        ) %>
        <%= component.with_item(
          tag: :a,
          href: all_discussions_commented_path,
          label: "Commented",
          selected: commented_selected,
          ) %>
        <% if scheduled_discussions_enabled? %>
          <%= component.with_item(
                tag: :a,
                href: all_discussions_scheduled_path,
                label: "Scheduled",
                selected: scheduled_selected
              ) %>
          <%= component.with_item(
                tag: :a,
                href: all_discussions_draft_path,
                label: "Draft",
                selected: draft_selected
              ) %>
        <% end %>
      <% end %>
    </nav>
    <div class="flex-auto min-width-0">
      <%= form_tag discussions_dashboard_search_path, :method => :get, :class => "subnav-search tmp-ml-0 tmp-ml-md-3 tmp-mt-3 tmp-mt-md-0", :role => "search", :"aria-label" => "Discussions" do %>
        <%= render(
          Primer::Alpha::TextField.new(
            name: "discussions_q",
            label: "Search all discussions",
            placeholder: "Search all discussions",
            id: "js-issues-search",
            value: query.rstrip,
            full_width: true,
            visually_hide_label: true,
            show_clear_button: true,
            leading_visual: {
              icon: :search
            }
          )
        ) %>
      <% end %>
    </div>
  </div>

  <div class="Box Box--responsive hx_Box--firstRowRounded0" id="js-issues-toolbar" data-pjax data-hpc>
    <% if discussions.empty? %>
      <%= render Primer::Beta::Blankslate.new(spacious: true, test_selector: "discussions-blankslate") do |c| %>
        <% c.with_visual_icon(icon: "comment-discussion") %>

        <% c.with_heading(tag: :h2) do %>
          No discussions match the selected filters.
        <% end %>

        <% c.with_description do %>
          Discussions are used to ask questions and have open-ended conversations.
        <% end %>
      <% end %>
    <% else %>
      <div class="js-navigation-container js-active-navigation-container" data-discussion-hovercards-enabled data-repository-hovercards-enabled>
        <% discussions.each_with_index do |discussion, i| %>
          <%= render "orgs/discussions/discussion",
                discussion: discussion,
                index: i,
                participants: participants_by_discussion_id[discussion.id],
                show_actions_column: show_actions_column %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="d-flex flex-justify-center">
    <% if discussions.total_pages > 1 %>
      <div class="paginate-container">
        <div class="pagination">
          <%= will_paginate discussions %>
        </div>
      </div>
    <% end %>
  </div>
</div>
