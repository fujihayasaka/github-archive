<div class="mb-3 d-flex container-lg px-3">
  <h1 class="<%= view.visibility %> float-none flex-auto width-fit pl-0 d-md-flex d-inline-block">
    <span class="text-bold flex-self-center">Editing <%= link_to view.gist.title, user_gist_path(view.user_param, view.gist), class: "Link--inTextBlock" %></span>
    <% if view.gist.secret? %>
      <%= render Primer::Beta::Label.new(scheme: :secondary, flex_shrink: 0, align_self: :center, ml: 1, title: "Only those with the link can see this gist.") do %>
        Secret
      <% end %>
    <% end %>
  </h1>

  <ul class="pagehead-actions float-none d-md-flex d-none">
    <li>
      <% if view.gist.comments_enabled? %>
        <%= form_tag disable_comments_user_gist_path(view.user_param, view.gist), method: :put do %>
          <%= render Primer::Beta::Button.new(
            type: :submit,
            size: :small,
          ) do |c| %>
            <% c.with_leading_visual_icon(icon: :comment) %>
            Disable comments
          <% end %>
        <% end %>
      <% else %>
        <%= form_tag enable_comments_user_gist_path(view.user_param, view.gist), method: :put do %>
          <%= render Primer::Beta::Button.new(
            type: :submit,
            size: :small,
          ) do |c| %>
            <% c.with_leading_visual_icon(icon: :comment) %>
            Enable comments
          <% end %>
        <% end %>
      <% end %>
    </li>

    <li>
      <% if view.gist.secret? %>
        <%= form_tag make_public_user_gist_path(view.user_param, view.gist), method: :put do %>
          <%= render Primer::Beta::Button.new(
            type: :submit,
            size: :small,
            "data-confirm": "Are you positive you want to permanently make this Gist public?",
          ) do |c| %>
            <% c.with_leading_visual_icon(icon: :globe) %>
            Make public
          <% end %>
        <% end %>
      <% end %>
    </li>

    <li>
      <%= form_tag user_gist_path(view.user_param, view.gist), method: :delete do %>
        <%= render Primer::Beta::Button.new(
          type: :submit,
          size: :small,
          scheme: :danger,
          "data-confirm": "Are you positive you want to delete this Gist?",
        ) do |c| %>
          <% c.with_leading_visual_icon(icon: :trash) %>
          Delete
        <% end %>
      <% end %>
    </li>
  </ul>

  <div class="d-inline-block d-md-none ml-auto">
    <%= render(Primer::Alpha::ActionMenu.new(
      menu_id: "gist_edit_options",
      align_self: :start,
      ml: :auto,
      display: :inline_block,
    )) do |menu| %>
      <% menu.with_show_button(icon: "kebab-horizontal", size: :small, "aria-label": "Show Gist edit options" ) %>
      <% if view.gist.comments_enabled? %>
        <% menu.with_item(
        item_id: "disable_comments_from_gist_edit_options",
        label: "Disable comments",
        href: disable_comments_user_gist_path(view.user_param, view.gist),
        form_arguments: {
          method: :put
        },
      ) do |i| %>
        <% i.with_leading_visual_icon(icon: :comment) %>
      <% end %>
      <% menu.with_divider %>
    <% end %>
      <% if view.gist.secret? %>
        <% menu.with_item(
          item_id: "publish_from_gist_edit_options",
          label: "Make public",
          href: make_public_user_gist_path(view.user_param, view.gist),
          form_arguments: {
            method: :put
          },
          content_arguments: { "data-confirm": "Are you positive you want to permanently make this Gist public?" }
        ) do |i| %>
          <% i.with_leading_visual_icon(icon: :globe) %>
        <% end %>
      <% end %>
      <% menu.with_item(
        item_id: "delete_from_gist_edit_options",
        label: "Delete",
        scheme: :danger,
        href: user_gist_path(view.user_param, view.gist),
        form_arguments: {
          method: :delete
        },
        content_arguments: { "data-confirm": "Are you positive you want to delete this Gist?" }
      ) do |i| %>
        <% i.with_leading_visual_icon(icon: :trash) %>
      <% end %>
    <% end %>
  </div>
</div>
