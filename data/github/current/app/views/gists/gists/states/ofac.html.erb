<%= render Primer::Beta::Blankslate.new(narrow: true, classes: "tmp-mt-4") do |blankslate| %>
  <% blankslate.with_visual_icon(icon: "alert") %>
  <% blankslate.with_heading(tag: :h2).with_content("This secret gist has been disabled.") %>
  <% blankslate.with_description do %>
    <span class="text-left d-block"><%= trade_controls_secret_gist_restricted %></span>

    <% if gist.ui_content_adminable_by?(current_user) %>
      <div class="tmp-mt-3">
        <%= render(Primer::Alpha::Dialog.new(
          id: "gist-ofac-make-public-dialog",
          title: "Make this gist public",
          size: :medium_portrait,
          aria_described_by: "gist-ofac-public-dialog-description",
          style: "margin-top: 15vh;"
        )) do |dialog| %>
          <% dialog.with_show_button(scheme: :danger, size: :small) do %>
            <%= render Primer::Beta::Octicon.new(icon: "code-square") %>
            Make public
          <% end %>

          <% dialog.with_body do %>
            <%= render Primer::Alpha::Banner.new(
              id: "gist-ofac-public-dialog-description",
              scheme: :warning,
              icon: :alert,
              classes: "tmp-mb-3"
            ) do %>
              Please note: you will not be able to undo this action.
            <% end %>
            <ul class="tmp-ml-3" style="list-style-type: none;">
              <li>The code will be visible to everyone who can visit <%= GitHub.gist_url %></li>
              <li><%= trade_controls_restricted_public_abilities_for_gist %></li>
            </ul>
          <% end %>

          <% dialog.with_footer do %>
            <div class="float-right">
              <%= render Primer::Beta::Button.new(type: :button, data: { "close-dialog-id": "gist-ofac-make-public-dialog" }) do %>
                Cancel
              <% end %>
              <%= form_tag make_public_user_gist_path(gist.user_param, gist), method: :put, class: "d-inline-block" do %>
                <%= render Primer::Beta::Button.new(scheme: :danger, type: :submit, ml: 2, data: { "disable-with": "Making gist public..." }) do %>
                  I understand, make this gist public.
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
