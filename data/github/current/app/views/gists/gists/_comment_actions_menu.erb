<%# erblint:counter ButtonComponentMigrationCounter 4 %>
<%
  permalink_id = "#{diff_comment_id(comment)}-permalink"
  permalink_url_id = "#{diff_comment_id(comment)}-permalink-url"
  # Ghost comments (which have no user) are not updatable
  updatable =  comment.user && comment.async_viewer_can_update?(current_user).sync
  deletable = comment.async_viewer_can_delete?(current_user).sync
  minimizable = !comment.minimized? && comment.async_minimizable_by?(current_user).sync
  unminimizable = comment.minimized? && comment.async_unminimizable_by?(current_user).sync
  display_divider = updatable || deletable || minimizable || unminimizable
  permalink_url = comment.permalink_url
  absolute_permalink_url = comment.absolute_permalink_url
%>

<%= render Primer::Beta::ClipboardCopy.new("aria-label": "Copy link", classes: "dropdown-item btn-link", for: permalink_url_id, role: "menuitem") do %>
  Copy link
<% end %>
<div id="<%= permalink_url_id %>" class="d-none js-gist-comment-permalink" data-href="<%= permalink_url %>"></div>


<button
  type="button"
  role="menuitem"
  data-hotkey="<%= hotkeys_for(current_user, :pull_request_conversation, :reply) %>"
  class="dropdown-item btn-link js-comment-quote-reply">
  Quote reply
</button>

<% if display_divider %>
  <div role="none" class="dropdown-divider"></div>
<% end %>

<% if updatable %>
  <button
    type="button"
    role="menuitem"
    class="dropdown-item btn-link js-comment-edit-button"
    aria-label="Edit comment">
    Edit
  </button>
<% end %>

<% if minimizable %>
  <%= render layout: "shared/details_dialog", locals: {
      title: "Hide comment",
      button_text: "Hide",
      button_class: "dropdown-item btn-link",
      button_role: "menuitem",
      button_aria_label: "Hide comment",
      details_class: "width-full",
      dialog_class: "Box-overlay--narrow",
    } do %>
    <div class="Box-body">
      <p class="tmp-mb-3">Choose a reason for hiding this comment. The reason will be displayed to describe this comment to others.</p>
      <%= form_tag minimize_user_gist_comment_path(user_id: comment.gist.user_param, gist_id: comment.gist.repo_name, comment_id: comment.id), method: :put, class: "js-gist-comment-minimize" do %>
        <dl class="form-group">
          <dt><label for="gist-comment-classifier-<%= comment.id %>">Reason</label></dt>
          <dd>
            <select name="classifier" id="gist-comment-classifier-<%= comment.id %>" class="form-select width-full" aria-label="Reason" required>
              <option value>Choose a reason</option>
              <%= options_for_select(minimize_reasons_for_select) %>
            </select>
          </dd>
        </dl>
        <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary, block: true) do %>Hide comment<% end %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if unminimizable %>
  <%= form_tag unminimize_user_gist_comment_path(user_id: comment.gist.user_param, gist_id: comment.gist.repo_name, comment_id: comment.id), method: :put, class: "width-full inline-form js-gist-comment-unminimize" do %>
    <button
        type="submit"
        role="menuitem"
        class="dropdown-item btn-link"
        aria-label="Unhide comment">
      Unhide
    </button>
  <% end %>
<% end %>

<% if deletable %>
  <%= form_tag comment.comment_path_url, method: :delete, class: "width-full inline-form js-comment-delete" do %>
    <input type="hidden" name="input[id]" value="<%= comment.id %>">
    <button
        type="submit"
        role="menuitem"
        class="dropdown-item menu-item-danger btn-link"
        aria-label="Delete comment"
        data-confirm="Are you sure you want to delete this?">
      Delete
    </button>
  <% end %>
<% end %>

<% if comment.async_viewer_can_report?(current_user).sync %>
  <div role="none" class="dropdown-divider"></div>
  <%= link_to(flavored_contact_path(
    flavor: "report-content",
    report: "#{(comment.user || User.ghost).display_login} (user)",
    content_url: "#{absolute_permalink_url}"), {
        'aria-label' => "Report content",
        :class => "dropdown-item btn-link",
        :role => "menuitem"
      }) do %>
    Report
  <% end %>
<% end %>
