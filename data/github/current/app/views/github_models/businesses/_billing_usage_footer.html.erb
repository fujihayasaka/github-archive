<%= render Primer::Box.new(color: :muted, id: "github-models-businesses-billing-usage-footer") do %>
  <% if billing_enabled %>
    Paid usage has been enabled for Models. <a class="Link--inTextBlock" href="<%= new_enterprise_billing_budget_path(business) %>">Set a budget</a> to manage the Models spending for your enterprise.
    <div class="mt-2">
      If a budget is already set, no action is needed.
    </div>
  <% else %>
    Your enterprise has
    <%= render Primer::Beta::Link.new(href: docs_url("github-models/rate-limits"), underline: true).with_content("free rate limits") %>.
    Enable paid usage to avoid interruptions.
  <% end %>
<% end %>
