<%= render(Primer::Beta::BorderBox.new(mt: 2)) do |box| %>
  <% permissions.each do |permission, permission_action| %>
    <% box.with_row do %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, align_items: :center )) do %>
        <span><%= Permissions::FineGrainedResources::Metadata.title(permission) %></span>
        <%= render(Primer::Beta::Label.new(title: description = Permissions::FineGrainedResources::Metadata.action_description(permission_action), scheme: :secondary)) { description } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
