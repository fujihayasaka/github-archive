<%= render Primer::Beta::Blankslate.new(border: true, spacious: true, classes: "bgColor-muted", test_selector: "new-unauthorized-blankslate") do |c| %>
  <% c.with_heading(tag: :h2).with_content("Authorization required") %>
  <% c.with_description do %>
    This organization requires authorized access to generate a personal access token.
    <%= link_to "Learn more about authorizing a PAT with SAML single sign-on.", "#{GitHub.help_url}/articles/authorizing-a-personal-access-token-for-use-with-a-saml-single-sign-on-organization/", class: "Link--inTextBlock"%>
  <% end %>
  <% c.with_primary_action(href: authorization_path).with_content("Authorize") %>
<% end %>
