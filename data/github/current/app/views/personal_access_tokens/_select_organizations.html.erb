<%
  builder = ActionView::Helpers::FormBuilder.new(nil, nil, self, {})
%>

<%= render(Primer::Alpha::FormControl.new(label: "Resource owner", caption: "The token will only be able to make changes to resources owned by the selected resource owner. Tokens can always read all public repositories.", label_arguments: { id: "access-target-label", for: "resource-owner-select-panel-button" })) do |component| %>
  <% component.with_input do |input_arguments| %>
    <%= render(Primer::Alpha::SelectPanel.new(
      id: "resource-owner-select-panel",
      title: "Select resource owner",
      form_arguments: { builder: builder, name: "target_name", value: current_target.display_login },
      select_variant: :single,
      src: user_access_token_resource_owners_path(
        target_name: current_target.display_login,
        access_id: current_access&.id,
        menu_id: "resource-owner-select-panel"
      ),
      show_filter: true,
      dynamic_aria_label_prefix: "Selected resource owner",
      classes: "js-target-container",
      mb: 1
    )) do |panel| %>
      <% panel.with_show_button(**input_arguments) do |button| %>
        <%= render(GitHub::AvatarComponent.new(id: "resource-owner-select-panel-show-button-icon", actor: current_target, mr: 1)) %>
        <%= current_target.display_login %>
        <% button.with_trailing_action_icon(icon: :"triangle-down") %>
      <% end %>
      <% panel.with_subtitle { "You may only select resource owners with fine-grained PATs enabled." } %>
    <% end %>
  <% end %>
<% end %>
