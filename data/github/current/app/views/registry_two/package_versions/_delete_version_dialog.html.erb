<%= render(Primer::Alpha::Dialog.new(
    id: "delete-package-version-#{package_version.version}",
    title: "Delete this version?",
    size: :medium_portrait,
    visually_hide_title: false,
    src: "asd",
    "data-test-selector": "delete-package-version-dialog"
  )
) do |d| %>
  <% form_with(
    url: delete_package_version_path(user_type:, version: package_version.version),
    method: :delete
  ) do %>
    <% d.with_show_button(size: :small) do %>
      Delete
    <% end %>
    <% d.with_header(show_divider: false, variant: :large) %>
    <%= d.with_body do %>
      <p class="mb-3">
        <% if package_version.aop? %>
          This action cannot be undone. This will permanently delete the <%= package.name %>@<%= package_version.metadata&.tag&.name %> version.
        <% else %>
          This action cannot be undone. This will permanently delete the version <strong><%= package.name %>@<%= package_version.version %></strong>.
        <% end %>
      </p>
      <% if show_reclaimed_storage %>
        <p class="mb-3">
          Deleting this version will free <%= number_to_human_size(reclaimed_storage(package_version.version)) %> of shared storage, and the version will no longer be accessible once deleted.
        </p>
      <% end %>
      <div>
        <div class="d-inline-flex flex-items-center mb-2">
          <%= primer_octicon(:x, color: :danger, mr: 2) %>
          <p class="mb-0">Users will not be able to view, install, or reference this version</p>
        </div>
        <div class="d-inline-flex flex-items-center mb-2">
          <%= primer_octicon(:x, color: :danger, mr: 2) %>
          <p class="mb-0">This may break existing workflows</p>
        </div>
      </div>
      <% if package_version.aop? %>
        <% name_with_version = "#{package.name}@#{package_version.metadata&.tag&.name}" %>
        <p class="pt-1">Please type <strong><%= name_with_version %></strong> to confirm:</p>
        <input type="text" class="form-control input-block" autofocus required
          autocomplete="off"
          pattern="<%= case_insensitive_pattern name_with_version %>"
          aria-label="Type in the name of the package to confirm that you want to delete this version."
          name="verify">
        <input type='hidden' name='tag' value='<%=package_version.metadata&.tag&.name %>'>
      <% else %>
        <p class="pt-1">Please type <strong><%= package.name %></strong> to confirm:</p>
        <input type="text" class="form-control input-block" autofocus required
          autocomplete="off"
          pattern="<%= case_insensitive_pattern package.name %>"
          aria-label="Type in the name of the package to confirm that you want to delete this version."
          name="verify">
      <% end %>
    <% end %>
    <%= d.with_footer(show_divider: false) do %>
      <%= render Primer::Beta::Button.new(type: :submit, block: true, scheme: :danger, "data-disable-invalid": "") do %>
        I understand, delete this version
      <% end %>
    <% end %>
  <% end %>
<% end %>
