<% startup_application ||= BusinessStartupsProgram::Application.new %>
<% partner_id = startup_application.partner_id || params[:pid].to_s %>
<div class="width-full mx-auto tmp-mb-8 tmp-mb-md-12 tmp-px-5 tmp-px-md-8 tmp-pb-7 tmp-pt-8 tmp-pt-lg-10 text-center rounded-2 position-relative">
  <div class="color-fg-muted f3 text-medium pb-1 mb-2">GitHub for Startups</div>
  <h2 class="h2 tmp-mb-4 mx-auto container-md text-center">Scale your startup on GitHub</h2>
  <p class="f3 color-fg-subtle container-md mx-auto">
    Apply now to receive our new startup offer: $10,000 in flexible platform credits to build, ship, and scale with GitHub Enterprise, Copilot, Advanced Security, Actions, and more 🚀.
  </p>

  <div class="container-md mx-auto tmp-mt-6 position-relative text-left">
    <% if !valid_partner_id?(partner_id) %>
      <p class="f4">
        You need a referral link from your investor, accelerator, or incubator to apply.
        Please reach out to your partner for a GitHub for Startups application link.
      </p>
    <% elsif startup_program_enterprise_account_options.empty? %>
      <p class="f4">
        You are not an owner of any enterprise accounts. Please start a <%= link_to "GitHub Enterprise trial", enterprise_marketing_page_path, class: "Link--inTextBlock" %> first.
      </p>
    <% else %>
      <%= form_with url: enterprise_startups_create_path, scope: :startup_application, method: :post do |f| %>
        <%= f.hidden_field :partner_id, value: partner_id %>

        <dl class="form-group">
          <dt class="input-label">
            <%= f.label :business_id,
              "Enterprise Account",
              class: "required error-label-transition f5 text-bold",
              for: :startupApplicationBusinessId
            %>
          </dt>
          <dd>
            <%= f.select :business_id,
              options_for_select(startup_program_enterprise_account_options, startup_application.business_id),
              { prompt: "Select an enterprise account" },
              {
                id: :startupApplicationBusinessId,
                class: "required input-block form-select error-border-transition",
                required: true,
                value: startup_application.business_id,
              }
            %>
            <% if startup_application.errors[:business_id].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:business_id].to_sentence %></p>
            <% end %>
            <% if !startup_program_enterprise_accounts_and_ineligibility_reasons.any? { |_, ineligibility_reasons| ineligibility_reasons.empty? } %>
              <p class="color-fg-warning f6 mt-1">Select an existing GitHub Enterprise trial account, or <%= link_to "create a new one", "https://docs.github.com/en/enterprise-cloud@latest/admin/overview/setting-up-a-trial-of-github-enterprise-cloud", class: "Link--inTextBlock" %> if you don't have one yet. The account must be less than 90 days old and have a valid payment method on file.</p>
            <% end %>
          </dd>
        </dl>

        <dl class="form-group">
          <dt>
            <%= f.label :company_name, "Company Name", class: "required error-label-transition f5 text-bold", for: :companyName %>
          </dt>
          <dd>
            <%= f.text_field :company_name,
              id: :companyName,
              required: true,
              maxlength: 255,
              value: startup_application.company_name,
              class: "required form-control input-block error-border-transition",
              placeholder: "Acme, Inc."
            %>
            <% if startup_application.errors[:company_name].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:company_name].to_sentence %></p>
            <% end %>
          </dd>
        </dl>

        <div class="d-md-flex gutter-md-condensed">
          <dl class="col-md-6 form-group mb-0">
            <dt>
              <%= f.label :first_name, "First Name", class: "required error-label-transition f5 text-bold", for: :firstName %>
            </dt>
            <dd>
              <%= f.text_field :first_name,
                id: :firstName,
                required: true,
                maxlength: 255,
                value: startup_application.first_name,
                class: "required form-control input-block error-border-transition"
              %>
            <% if startup_application.errors[:first_name].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:first_name].to_sentence %></p>
            <% end %>
            </dd>
          </dl>

          <dl class="col-md-6 form-group mb-0">
            <dt>
              <%= f.label :last_name, "Last Name", class: "required error-label-transition f5 text-bold", for: :lastName %>
            </dt>
            <dd>
              <%= f.text_field :last_name,
                id: :lastName,
                required: true,
                maxlength: 255,
                value: startup_application.last_name,
                class: "required form-control input-block error-border-transition"
              %>
            <% if startup_application.errors[:last_name].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:last_name].to_sentence %></p>
            <% end %>
            </dd>
          </dl>
        </div>

        <dl class="form-group">
          <dt>
            <%= f.label :email, "Email address", class: "required error-label-transition f5 text-bold", for: :emailAddress %>
          </dt>
          <dd>
            <%= f.select :email,
              options_for_select(company_emails, startup_application.email),
              { prompt: "Select an email address" },
              {
                id: :emailAddress,
                class: "required input-block form-select error-border-transition",
                required: true,
              }
            %>
            <% if startup_application.errors[:email].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:email].to_sentence %></p>
            <% end %>
            <% if company_emails.empty? %>
              <span class="f5 text-italic">
                You don’t have any verified company email addresses on your GitHub account. Please add and verify a company email address before submitting this request.
              </span>
            <% else %>
              <span class="f5 text-italic">
                Please use an email with your company domain. Personal email addresses (e.g., @gmail.com, @yahoo.com) or emails that do not match your company domain will be rejected.
              </span>
            <% end %>
          </dd>
        </dl>

        <dl class="form-group">
          <dt>
            <%= f.label :role, _("Role in Company"), class: "required error-label-transition f5 text-bold", for: :roleInCompany %>
          </dt>
          <dd>
            <% roles = [
                ["Cofounder CEO", "ceo"],
                ["Cofounder/CTO", "cto"],
                ["Technical Lead", "tech-lead"],
                ["Cofounder (other)", "cofounder-other"],
              ]
            %>
            <%= f.select :role,
              roles,
              { selected: startup_application.role, include_blank: "Please select" },
              { id: :roleInCompany, class: "required input-block form-select error-border-transition", required: true }
            %>
            <% if startup_application.errors[:role].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:role].to_sentence %></p>
            <% end %>
          </dd>
        </dl>

        <dl class="form-group">
          <dt>
            <%= f.label :company_website, "Company Website", class: "required error-label-transition f5 text-bold", for: :companyWebsite %>
          </dt>
          <dd>
            <%= f.text_field :company_website,
              id: :companyWebsite,
              required: true,
              maxlength: 255,
              value: startup_application.company_website,
              class: "required form-control input-block error-border-transition",
              placeholder: "https://website.com"
            %>
            <% if startup_application.errors[:company_website].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:company_website].to_sentence %></p>
            <% end %>
            <span class="f5 text-italic">Applications with invalid websites and/or websites with inappropriate content will be rejected.</span>
          </dd>
        </dl>

        <dl class="form-group">
          <dt>
            <%= f.label :company_overview, "Company overview", class: "required error-label-transition f5 text-bold", for: :companyOverview %>
          </dt>
          <dd>
            <%= f.text_area :company_overview,
              id: :companyOverview,
              required: true,
              minlength: 50,
              maxlength: 1000,
              value: startup_application.company_overview,
              class: "required form-control input-block error-border-transition"
            %>
            <% if startup_application.errors[:company_overview].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:company_overview].to_sentence %></p>
            <% end %>
            <span class="f5 text-italic">In a few sentences, please share a bit more about your company.</span>
          </dd>
        </dl>

        <dl class="form-group">
          <dt>
            <%= f.label :industry, "Industry", class: "required error-label-transition f5 text-bold", for: :startupIndustry %>
          </dt>
          <dd>
            <% industry = [
                ["Agriculture & Mining", "agriculture-mining"],
                ["Business Services", "business-services"],
                ["Computers & Electronics", "computers-electronics"],
                ["Consumer Services", "consumer-services"],
                ["Education", "education"],
                ["Energy & Utilities", "energy-utilities"],
                ["Financial Services", "financial-services"],
                ["Food & Beverage", "food-beverage"],
                ["Government", "government"],
                ["Healthcare", "healthcare"],
                ["Manufacturing", "manufacturing"],
                ["Media & Entertainment", "media-entertainment"],
                ["Not for Profit", "not-for-profit"],
                ["Real Estate & Construction", "real-estate-construction"],
                ["Retail", "retail"],
                ["Software & Internet", "software-internet"],
                ["Telecommunications", "telecommunications"],
                ["Transportation & Storage", "transportation-storage"],
                ["Travel, Recreation, and Leisure", "travel-recreation-leisure"],
                ["Whole & Distribution", "whole-distribution"],
                ["Other", "other"]
              ]
            %>
            <%= f.select :industry,
              industry,
              { selected: startup_application.industry, include_blank: "Please select" },
              { id: :startupIndustry, class: "required input-block form-select error-border-transition", required: true }
            %>
            <% if startup_application.errors[:industry].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:industry].to_sentence %></p>
            <% end %>
          </dd>
        </dl>

        <dl class="form-group">
          <dt>
            <%= f.label :latest_funding_round, "Latest Funding Round", class: "required error-label-transition f5 text-bold", for: :startupFunding %>
          </dt>
          <dd>
            <% funding = [
                ["Bootstrap", "bootstrap"],
                ["Pre-Seed", "pre-seed"],
                ["Seed", "seed"],
                ["Series A", "series-a"],
                ["Series B", "series-b"],
                ["Series C or later", "series-c-or-later"]
              ]
            %>
            <%= f.select :latest_funding_round,
              funding,
              { selected: startup_application.latest_funding_round, include_blank: "Please select" },
              { id: :startupFunding, class: "required input-block form-select error-border-transition", required: true }
            %>
            <% if startup_application.errors[:latest_funding_round].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:latest_funding_round].to_sentence %></p>
            <% end %>
          </dd>
        </dl>

        <dl class="form-group">
          <dt>
            <%= f.label :funding_raised, "Total Funding Raised", class: "required error-label-transition f5 text-bold", for: :totalFundingRaised %>
          </dt>
          <dd>
            <% funding_raised_options = [
                ["<$1M USD", "less-than-1M"],
                ["$1M-$2M USD", "1M-2M"],
                ["$2M-$5M USD", "2M-5M"],
                ["$5M-$10M USD", "5M-10M"],
                ["$10M-$25M USD", "10M-25M"],
                ["$25M+ USD", "25M-and-more"]
              ]
            %>
            <%= f.select :funding_raised,
              funding_raised_options,
              { selected: startup_application.funding_raised, include_blank: "Please select" },
              { id: :totalFundingRaised, class: "required input-block form-select error-border-transition", required: true }
            %>
            <% if startup_application.errors[:funding_raised].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:funding_raised].to_sentence %></p>
            <% end %>
          </dd>
        </dl>

        <% if proof_of_funding_required? %>
        <dl class="form-group">
          <dt>
            <%= f.label :crunchbase_link, "Proof of Funding", class: "required error-label-transition f5 text-bold", for: :crunchbaseLink %>
          </dt>
          <dd>
            <%= f.text_field :crunchbase_link,
              id: :crunchbaseLink,
              required: true,
              maxlength: 255,
              minlength: 25,
              value: startup_application.crunchbase_link,
              class: "required form-control input-block error-border-transition"
            %>
            <% if startup_application.errors[:crunchbase_link].any? %>
              <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:crunchbase_link].to_sentence %></p>
            <% end %>
            <span class="f5 text-italic">Provide a link to your company's Crunchbase profile. If your startup is in stealth or your funding is listed elsewhere, you can submit an alternative proof-of-funding link here or email it to startups@github.com after submitting your application. Note that alternative submissions may require an additional 1–2 business days to verify.</span>
          </dd>
        </dl>
        <% end %>

        <div class="d-md-flex gutter-md-condensed">
          <%= render Site::CountrySelectComponent.new(
            label: "Country",
            id: :country,
            name: "startup_application[country]",
            country_list: "startups",
            form_group_classes: "col-md-6",
          ) %>
          <% if startup_application.errors[:country].any? %>
            <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:country].to_sentence %></p>
          <% end %>
        </div>

        <div class="required form-checkbox f5 tmp-mb-3 form-group">
          <label>
            <%= f.check_box :opt_in_checkbox, { required: true, class: "required error-border-transition", checked: startup_application.opt_in_checkbox == "True" }, "True", "False" %>
            I agree to receive communications from GitHub and GitHub for Startups related to program participation, product onboarding and education, events, and promotional materials. These communications are required for participation in the GitHub for Startups program.
          </label>
          <% if startup_application.errors[:opt_in_checkbox].any? %>
            <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:opt_in_checkbox].to_sentence %></p>
          <% end %>
        </div>

        <div class="required form-checkbox f5 tmp-mb-3 form-group">
          <label>
            <%= f.check_box :tos_checkbox, { required: true, class: "required error-border-transition", checked: startup_application.tos_checkbox == "True" }, "True", "False" %>
            I agree to the GitHub <%= link_to "Terms of Service", "https://docs.github.com/en/site-policy/github-terms/github-terms-of-service", class: "Link--inTextBlock" %> and <%= link_to "Customer Terms", "https://github.com/customer-terms", class: "Link--inTextBlock" %>.
          </label>
          <% if startup_application.errors[:tos_checkbox].any? %>
            <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:tos_checkbox].to_sentence %></p>
          <% end %>
        </div>

        <div class="required form-checkbox f5 tmp-mb-3 form-group">
          <label>
            <%= f.check_box :terms_checkbox, { required: true, class: "required error-border-transition", checked: startup_application.terms_checkbox == "True" }, "True", "False" %>
            I agree to the <a class="Link--inTextBlock" href="https://github.com/enterprise/startups#faq">GitHub for Startups Terms and Conditions</a>.
          </label>
          <% if startup_application.errors[:terms_checkbox].any? %>
            <p class="color-fg-danger f6 mt-1"><%= startup_application.errors[:terms_checkbox].to_sentence %></p>
          <% end %>
        </div>

        <div class="border rounded-2 color-border-default tmp-p-3 tmp-mb-3 f5">
          <p class="text-bold mb-2">GitHub for Startups Terms and Conditions</p>
          <ul class="tmp-ml-4">
            <li class="mb-1"><strong>Credits Application:</strong> Credits will be applied only to the Enterprise account submitted in this application and cannot be transferred to another account.</li>
            <li class="mb-1"><strong>One-Time Redemption:</strong> The GitHub for Startups offer is limited to one redemption per company. If you have previously received GitHub Enterprise credits through Microsoft or GitHub for Startups, you are not eligible to apply again. If you are applying on behalf of a different company, you must use a separate account with that company's domain. Accounts found to be in violation of these terms may have credits revoked at GitHub's discretion.</li>
            <li class="mb-1"><strong>Payment Method:</strong> Please expect an authorization charge on your payment method within a few days of onboarding. Failure to have a valid payment method on file or a failed authorization will result in your account being locked.</li>
            <li class="mb-1"><strong>Program Duration:</strong> Credits are valid for up to 12 months from approval. Credits expire upon full consumption or at the end of the 12-month period, whichever occurs first.</li>
            <li class="mb-1"><strong>Automatic Billing Transition:</strong> Upon credit exhaustion or program expiration, any active products will automatically transition to standard paid billing and will be charged to the payment method on file.</li>
            <li class="mb-1"><strong>Primary Contact Responsibility:</strong> All important program and billing communications are sent to the primary email address of the Enterprise account owner(s). Participants are responsible for monitoring this inbox.</li>
            <li class="mb-1"><strong>Downgrades:</strong> Participants may downgrade from GitHub Enterprise at any time. However, if the account is downgraded before credits are fully consumed or the program period ends, the startup forfeits any remaining credits and will not be eligible to reapply.</li>
            <li class="mb-1"><strong>Deprecation of Prior Offer:</strong> Please note that our previous startup offer has been discontinued and is no longer available.</li>
            <li class="mb-1"><strong>Data Residency:</strong> At this time, we do not support Enterprises with data residency, and can only accept standard accounts with Enterprise Cloud on GitHub.com.</li>
          </ul>
        </div>

        <%= f.button "Submit application",
          type: :submit,
          class: "Button--primary Button" %>
      <% end %>
    <% end %>
  </div>
</div>
