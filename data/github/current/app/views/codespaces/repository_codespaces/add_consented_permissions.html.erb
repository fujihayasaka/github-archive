<% page_info title: "Codespaces Add Consented Permissions", stafftools: stafftools_user_codespaces_path(current_user) %>
<%= render(Primer::Box.new(classes: "container-md tmp-pt-6")) do %>
  <%= render(Primer::Beta::Blankslate.new(border: true)) do |component| %>
    <% component.with_visual_icon(icon: :"check-circle-fill", color: :success) %>
    <% component.with_heading(tag: :h2) do %>
      You’re all set!
    <% end %>
    <% component.with_description(test_selector: "success-screen-copy") do %>
      Requested permissions were successfully authorized. You can now close this tab.
    <% end %>
    <% component.with_primary_action(href: repository_codespaces_path(repository)) do %>
      Go to repository codespaces
    <% end %>
  <% end %>
<% end %>
