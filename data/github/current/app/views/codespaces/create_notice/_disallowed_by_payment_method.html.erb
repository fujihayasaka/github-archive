<% if show_org_admin_text %>
  <%= render(Primer::Beta::Text.new(font_weight: :bold)) { billable_owner.display_login } %> has an issue with the payment method. You can adjust it in <%= link_to "payment settings", settings_org_billing_tab_path(billable_owner, tab: "payment_information"), class: "Link--inTextBlock" %>.
<% elsif show_org_user_text %>
  <%= render(Primer::Beta::Text.new(font_weight: :bold)) { billable_owner.display_login } %> has an issue with the payment method. Please contact an administrator to continue using codespaces.
<% else %>
  There seems to be an issue with your payment method. You can adjust it in <%= link_to "payment settings", settings_user_billing_tab_path(tab: "payment_information"), class: "Link--inTextBlock" %>.
<% end %>
