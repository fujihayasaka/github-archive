<%= render(Primer::Alpha::SelectPanel.new(
  use_experimental_non_local_form: user_feature_enabled?(:primer_select_panel_use_experimental_non_local_form),
  id: "primer_experimental_selectpanel_weekdays-delivery-day-menu",
  title: "Select days",
  select_variant: :multiple,
  fetch_strategy: :local,
  show_filter: false,
  "data-allow-blank": local_assigns[:allow_blank]
  )) do |menu| %>
  <% menu.with_show_button do |button| %>
    Select days
  <% end %>
  <% day_options.each do |day, day_attrs| %>
    <% menu.with_item(
      active: day_attrs[:selected],
      content_arguments: {
        data: {
          value: {day: day, class_name: day_attrs[:css_class]},
        }
      }
    ) do %>
      <span><%= day %></span>
    <% end %>
  <% end %>
<% end %>
<div class='d-flex flex-column ml-2 my-3'>
  <div class='color-fg-muted text-medium text-bold' id='prebuild-selected-weekdays'>
    Selected days
  </div>
  <ul class='ml-2 mt-2 d-none list-style-none text-medium color-fg-default' aria-labelledby='prebuild-selected-weekdays' id='prebuild-selected-weekdays-list'>
    <template>
      <li class=''>
        <input type="checkbox"
          name="<%= form.object_name %>[delivery_days][]"
          class="js-delivery-day-input"
          checked
          value=""
          hidden
        >
      </li>
    </template>
    <% filtered_counter = 0 %>
    <% day_options.each_with_index do |(day, day_attrs), index| %>
      <% if day_attrs[:selected] %>
        <% filtered_counter += 1 %>
        <li class='mb-2 d-inline'>
          <input type="checkbox"
              name="<%= form.object_name %>[delivery_days][]"
              class="js-delivery-day-input <%= day_attrs[:css_class] %>"
              checked
              value="<%= day %>"
              hidden>
          <%= day %>
        </li>
      <% end %>
    <% end %>
  </ul>
  <div id='days'><%= selected_days.to_sentence(last_word_connector: ', ', two_words_connector: ', ') %></div>
</div>

