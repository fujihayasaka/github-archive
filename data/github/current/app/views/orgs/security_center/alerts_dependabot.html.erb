<% page_info(title: "Security · #{heading} · #{organization.display_login}") %>

<%= render(
  SecurityCenter::PageComponent.new(
    backfill_in_progress: backfill_in_progress,
    organization:,
    selected_tab: selected_tab,
    user: current_user,
    auth_enumerator:,
  )
) do |page_component| %>
  <% page_component.with_header_section do %>
    <%= render(SecurityCenter::SubheadComponent.new(
      actor: current_user,
      scope: organization,
      heading: heading,
      phase: phase,
      hide_border: true
    )) do |c|
      c.with_phase_label
      c.with_feedback_link
    end %>
  <% end %>

  <% page_component.with_main_section do %>
    <div class="position-relative">
      <%= render DependabotAlerts::TableComponent.new(
        query:,
        es_query_result: es_query_result,
        query_string:,
        show_alert_number: false,
        alerts_page_path:,
        filter_suggestions_path:,
        menu_content_path:,
        teams_filter_menu_data:,
        show_incomplete_data_warning:,
        dismissal_reasons:,
        use_es: use_es,
        scope: organization,
        save_view_path: save_view_path
      ) %>

      <% if FeatureFlag.vexi.enabled?(:security_center_artifact_filters_popover, organization, default: false) %>
        <%= render SecurityCenter::ArtifactFiltersPopoverComponent.new(
          user: current_user,
          organization: organization,
          notice_name: :dependabot_alerts_artifact_filters_popover,
        ) %>
      <% end %>
    </div>
  <% end %>
<% end %>
