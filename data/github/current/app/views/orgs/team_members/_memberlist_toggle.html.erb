<div class="table-list-filters d-flex flex-wrap flex-items-center">
  <div class="<%= show_checkbox ? '' : 'tmp-pl-2' %> states d-flex flex-wrap flex-items-center js-membership-tabs">
    <%= render Primer::Beta::Button.new(scheme: :invisible, color: (view.child_team_membership? ? :muted : nil), classes: "js-membership-tab #{'selected' unless view.child_team_membership?}", data: { membership: "" }) do |button| %>
      <% button.with_leading_visual_icon(icon: :person) %>
      <%= pluralize number_with_delimiter(view.immediate_team_members_count), "member", "members" %>
    <% end %>

    <% unless view.team.business_team? %>
      <%= render Primer::Beta::Button.new(scheme: :invisible, color: (view.child_team_membership? ? nil : :muted), classes: "js-membership-tab #{'selected' if view.child_team_membership?}", data: { membership: "membership:child-team" }, test_selector: "child-team-members-tab") do |button| %>
        <% button.with_leading_visual_icon(icon: :people) %>
        <%= pluralize number_with_delimiter(view.child_team_members_count), "child team member", "child team members" %>
      <% end %>
    <% end %>
  </div>
</div>
