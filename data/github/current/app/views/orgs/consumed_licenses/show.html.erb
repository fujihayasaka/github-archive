<% page_info responsive: true, title: view.page_title, selected_link: view.selected_link %>

<%= render layout: "orgs/settings/layout" do %>
  <%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |component| %>
    <% component.with_item(href: organization_settings_licensing_index_path(view.organization)) do %>Licensing<% end %>
    <% component.with_item(href: request.path) do %>Consumed Licenses<% end %>
  <% end %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>
      Consumed Licenses
    <% end %>
  <% end %>
  <p><%= link_to "Learn who consumes licenses and why.", "https://docs.github.com/en/billing/reference/github-license-users" %></p>

  <p>This table includes each user/email that is currently consuming a license.</p>

  <%= render(Primer::Beta::BorderBox.new(classes: "tmp-my-4")) do |border_box| %>
    <% border_box.with_header(font_weight: :bold) do %>
      Handle or email
    <% end %>
    <% view.data_rows.each do |license_row| %>
      <% border_box.with_row do %>
        <div class="d-flex flex-items-center">
          <%= render(Primer::Beta::Avatar.new(src: license_row.avatar_url, size: 20, alt: license_row.display_name, classes: "mr-2")) %>
          <% if license_row.url.present? %>
            <%= render(Primer::Beta::Link.new(href: license_row.url)) { license_row.display_name } %>
          <% else %>
            <%= license_row.display_name %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <div class="paginate-container">
    <%= will_paginate view.data_rows %>
  </div>
<% end %>
