<% view.suggestions.each do |suggestion| %>
  <% if Apps::ManagementHelper.teams_enabled_for_apps_management?(on: view.organization) %>
    <% name = suggestion.is_a?(User) ? suggestion.display_login : suggestion.name %>
    <div
      class="js-manager-target-autocomplete-item"
      data-manager-type="<%= suggestion.class.name %>"
      data-manager-id="<%= suggestion.id %>"
    >
      <%= render Primer::Beta::AutoComplete::Item.new(
        value: name,
        label: suggestion.class.name,
        m: 2,
        test_selector: "manager-suggestion-#{suggestion.class.name}-#{suggestion.id}"
      ) do |item| %>
        <%= avatar_for(suggestion, 24, :class => "avatar") %>
        <strong class="ml-2"><%= name %></strong>
        <span class="color-fg-muted ml-1"><%= suggestion.class.name %></span>
      <% end %>
    </div>
  <% else %>
    <li class="member-suggestion typeahead-result" role="option" data-autocomplete-value="<%= suggestion.display_login %>">
      <%= avatar_for(suggestion, 24, :class => "avatar") %>
      <p class="member-suggestion-info">
        <strong class="member-login"><%= suggestion.display_login %></strong>
        <span class="member-name">
          <%= suggestion.profile_name %>
        </span>
      </p>
      <%= primer_octicon(:plus, float: :right) %>
    </li>
  <% end %>
<% end %>
