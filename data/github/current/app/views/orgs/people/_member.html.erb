<%# `view` is an instance of Orgs::People::MemberView %>

<% only_should_show_guest_collaborators ||= false %>

<% if view.enterprise_teams_org_assignment_enabled? %>
  <li class="d-flex flex-items-center flex-justify-end flex-no-wrap member-list-item js-bulk-actions-item border border-top-0 <%= "adminable" if view.show_admin_stuff? %>" data-bulk-actions-id="<%= view.member.id %>">
    <% if view.show_admin_stuff? %>
      <div class="py-3 pr-0 pl-3 flex-shrink-0">
        <input type="checkbox" name="members[]" value="<%= view.member %>" aria-labelledby="member-<%= view.member %>" class="js-bulk-actions-toggle"  data-check-all-item>
      </div>
    <% end %>

    <%= render(Organizations::Settings::MemberAvatarComponent.new(user: view.member, org: view.organization, show_admin_stuff: view.show_admin_stuff?)) %>

    <div class="flex-auto flex-wrap pl-3">
      <span class="d-flex flex-auto flex-wrap flex-justify-end flex-items-center">
        <%= render(Organizations::Settings::MemberProfileLinkComponent.new(user: view.member, org: view.organization, show_admin_stuff: view.show_admin_stuff?)) %>

        <%= render GitHub::BatchDeferredContentComponent.new(
          url: org_member_details_path(view.organization),
          inputs: {
            member_id: view.member.id,
            only_should_show_guest_collaborators: only_should_show_guest_collaborators
          }
        ) do %>
          <span class="Skeleton d-inline-block ml-1 Skeleton--text">Loading…</span>
        <% end %>
      </span>

      <% if view.show_membership_sources? %>
        <div class="pb-3">
          <%= render(BusinessUserAccounts::OrganizationMembership::MembershipSourcesComponent.new(
            user: view.member,
            organization: view.organization
          )) %>
        </div>
      <% end %>
    </div>
  </li>
<% else %>
<li class="d-flex flex-items-center flex-justify-end flex-wrap member-list-item js-bulk-actions-item border border-top-0 <%= "adminable" if view.show_admin_stuff? %>" data-bulk-actions-id="<%= view.member.id %>">
  <% if view.show_admin_stuff? %>
    <div class="py-3 pr-0 pl-3 flex-shrink-0">
      <input type="checkbox" name="members[]" value="<%= view.member %>" aria-labelledby="member-<%= view.member %>" class="js-bulk-actions-toggle"  data-check-all-item>
    </div>
  <% end %>

  <%= render(Organizations::Settings::MemberAvatarAndProfileLinkComponent.new(user: view.member, org: view.organization, show_admin_stuff: view.show_admin_stuff?)) %>

  <%= render GitHub::BatchDeferredContentComponent.new(
    url: org_member_details_path(view.organization),
    inputs: {
      member_id: view.member.id,
      only_should_show_guest_collaborators: only_should_show_guest_collaborators
    }
  ) do %>
    <span class="Skeleton d-inline-block ml-1 Skeleton--text">Loading…</span>
  <% end %>
</li>
<% end %>
