<%= render Primer::Alpha::ActionMenu.new(
  "data-filter-on": "visibility",
  select_variant: :single,
  anchor_align: :end,
  align_self: :center,
  mr: 1,
) do |menu| %>
  <% menu.with_show_button(scheme: :invisible) do |button|
      button.with_trailing_action_icon(icon: :"triangle-down")
      "Visibility"
  end %>
  <% menu.with_item(
      href: url_for(query: ""),
      label: "All",
      active: view.visibility.nil?,
      classes: "js-member-search-filter",
      "data-filter": ""
  ) %>
  <% menu.with_item(
    href: url_for(query: "visibility:public"),
    label: "Public",
    active: view.visibility == :public,
    classes: "js-member-search-filter",
    "data-filter": "visibility:public"
  ) %>
  <% menu.with_item(
    href: url_for(query: "visibility:private"),
    label: "Private",
    active: view.visibility == :private,
    classes: "js-member-search-filter",
    "data-filter": "visibility:private"
  ) %>
<% end %>
