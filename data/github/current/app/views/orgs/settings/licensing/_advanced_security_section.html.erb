<div class="business-content">
  <% if defined?(stafftools) && stafftools %>
    <% customer_flag_enabled = target.feature_flag_enabled?(:advanced_security_licensify_view, default: false) %>
    <h3>Turboghas</h3>
    <div style="<%= 'opacity: 0.5;' if customer_flag_enabled %>">
      <%= render_react_partial(
        name: "licensing-advanced-security-overview",
        props: {
          enterpriseContactUrl: ent_contact_url,
          ghas: teams_ghas_overview_react_payload(organization: target, viewer: current_user, use_licensify: false),
          slug: target.name,
          isTeams: true,
          isStafftools: true,
        }
      ) %>
    </div>
    <h3>Licensify</h3>
    <div style="<%= 'opacity: 0.5;' unless customer_flag_enabled %>">
      <%= render_react_partial(
        name: "licensing-advanced-security-overview",
        props: {
          enterpriseContactUrl: ent_contact_url,
          ghas: teams_ghas_overview_react_payload(organization: target, viewer: current_user, use_licensify: true),
          slug: target.name,
          isTeams: true,
          isStafftools: true,
        }
      ) %>
    </div>
  <% else %>
    <%= render_react_partial(
      name: "licensing-advanced-security-overview",
      props: {
        enterpriseContactUrl: ent_contact_url,
        ghas: teams_ghas_overview_react_payload(organization: target, viewer: current_user, use_licensify: target.feature_flag_enabled?(:advanced_security_licensify_view, default: false)),
        slug: target.name,
        isTeams: true,
        isStafftools: false,
      }
    ) %>
  <% end %>
</div>
