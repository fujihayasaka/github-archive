<div class="business-content">
  <% if defined?(stafftools) && stafftools %>
    <%= render_react_partial(
      name: "licensing-advanced-security-overview",
      props: {
        enterpriseContactUrl: ent_contact_url,
        ghas: teams_ghas_overview_react_payload(organization: target, viewer: current_user),
        slug: target.name,
        isTeams: true,
        isStafftools: true,
      }
    ) %>
  <% else %>
    <%= render_react_partial(
      name: "licensing-advanced-security-overview",
      props: {
        enterpriseContactUrl: ent_contact_url,
        ghas: teams_ghas_overview_react_payload(organization: target, viewer: current_user),
        slug: target.name,
        isTeams: true,
        isStafftools: false,
      }
    ) %>
  <% end %>
</div>
