<div class="my-4"></div>
<%= render(Primer::Alpha::Banner.new(scheme: :default)) do %>
  <div class="d-flex flex-justify-between">
    <span class="text-normal">
      Your
      <%= view.pending_cycle.changing_duration? ? "change" : "downgrade" %>
      to <%= view.pending_cycle.plan.display_name.humanize %> plan
      <% if view.is_pending_cycle_changing_seats? %>
        with <%= pluralize view.pending_cycle.seats, "seat" %>
      <% end %>
      will be effective on
      <strong><%= view.pending_cycle.active_on.strftime("%b %d, %Y") %></strong>.
      The new price will be
      <%= view.pending_cycle.discounted_plan_price.format(no_cents_if_whole: true) %> / <%= view.pending_cycle.plan_duration.downcase %>.
    </span>
    <%= form_tag update_pending_plan_change_path(view.account.display_login), class: "inline-form", method: :put do %>
      <%= hidden_field_tag :cancel_plan, true %>
      <%= hidden_field_tag :cancel_seats, true %>
      <%= render Primer::Beta::Button.new(type: :submit, scheme: :link, mr: 2, font_size: 6, "data-confirm": "Are you sure you want to cancel this pending plan change?") do %>
        Cancel
      <% end %>
    <% end %>
  </div>
<% end %>
<div class="my-4"></div>
