<% if show_code_quality_licensify_ui?([current_user, current_organization.licensed_customer]) %>
  <div class="tmp-mb-4" <%= test_selector("licensify-code-quality-overview") %>>
    <%= render_react_partial(
      name: "licensing-code-quality-overview",
      props: {
        codeQuality: licensify_code_quality_overview_react_payload_for_org(organization: current_organization),
        slug: current_organization.display_login,
      }
    ) %>
  </div>
<% end %>
