<% page_info title: "Licensing", selected_link: :licensing %>

<%= render layout: "orgs/settings/layout" do %>
  <%= render Primer::Beta::Subhead.new do |component| %>
    <% component.with_heading(tag: :h2) do %>
      Licensing
    <% end %>
  <% end %>

  <% if view.account.org_business_plan? %>
    <%= render partial: "orgs/settings/licensing/advanced_security_section", locals: { view: view, target: current_organization } %>
  <% end %>

  <%= render partial: "orgs/settings/licensing/copilot_section", locals: { view: view, current_organization: current_organization, target: current_organization } %>

  <%= render partial: "orgs/settings/licensing/current_plan_section", locals: { view: view } %>

  <% if view.pending_cycle.downgrading? && view.is_billing_platform_organization? %>
    <%= render partial: "orgs/settings/licensing/downgrade_info_banner", locals: { view: view } %>
  <% end %>

  <% if view.account_plan_subscription.on_free_trial? %>
    <%= render "billing_settings/enterprise_cloud_free_trial_section",
      organization: current_organization
    %>
  <% else %>
    <%= render "billing_settings/github_usage_section", view: view, target: current_organization, is_trial_expired: view.show_expired_cloud_trial?(current_organization) %>
  <% end %>
<% end %>
