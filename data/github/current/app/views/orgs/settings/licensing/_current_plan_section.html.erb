<%= render Primer::Beta::Subhead.new(hide_border: :true) do |component| %>
  <% component.with_heading(tag: :h2) do %>
    Current plan
  <% end %>
  <% if view.account_can_upgrade? %>
    <% component.with_actions do %>
      <%= render(Primer::Beta::Button.new(
        size: :small,
        tag: :a,
        href: view.compare_plans_link,
        data: safe_analytics_click_attributes(
          category: "#{analytics_account_prefix(view.account)} Compare all plans",
          action: "click to compare all plans",
          label: "ref_cta:Compare all plans;ref_loc:billing_settings"
        )
        )) do |_c|
        "Compare all plans"
        end %>
        <% if view.account.org_free_plan? %>
          <% click_attributes = analytics_click_attributes(
            category: "Upgrade to Team",
            action: "click to upgrade to team",
            label: "ref_cta:Upgrade to Team;ref_loc:free_plan_licensing_page"
          ) %>
          <%= render(Primer::Beta::Button.new(
            tag: :a,
            href: upgrade_path(plan: GitHub::Plan.business, target: "organization", source: "account compare plans", org: view.account),
            scheme: :primary,
            size: :small,
            ml: 2,
            data: click_attributes
          )) do %>
            Upgrade to Team
          <% end %>
        <% elsif view.account.personal_plan? %>
          <% click_attributes = analytics_click_attributes(
            category: "Upgrade to Pro",
            action: "click to upgrade to pro",
            label: "ref_cta:Upgrade to Pro;ref_loc:free_plan_licensing_page"
          ) %>
          <%= render(Primer::Beta::Button.new(
            tag: :a,
            href: upgrade_path(plan: GitHub::Plan.pro, source: "account compare plans"),
            scheme: :primary,
            size: :small,
            ml: 2,
            data: click_attributes
          )) do %>
            Upgrade to Pro
          <% end %>
        <% elsif view.account.org_business_plan? %>
          <% click_attributes = analytics_click_attributes(
            category: "Upgrade to Enterprise",
            action: "click to upgrade",
            label: "ref_cta:Upgrade;ref_loc:free_plan_licensing_page"
          ) %>
          <%= render(Primer::Beta::Button.new(
            scheme: :primary,
            size: :small,
            tag: :a,
            href: view.compare_plans_link,
            ml: 2,
            data: click_attributes
          )) do %>
            Upgrade to Enterprise
          <% end %>
        <% end %>
      <% end %>
  <% end %>
<% end %>
