<% component.with_item(label: "Billing & Licensing",
  data: test_selector_hash("billing_and_licensing")) do |item| %>
  <% item.with_leading_visual_icon(icon: :"credit-card") %>
  <% item.with_item(label: "Overview", href: organization_settings_billing_url(current_organization), selected_by_ids: :billing_vnext_overview) %>
  <% item.with_item(label: "Usage", href: organization_settings_billing_usage_url(current_organization), selected_by_ids: :billing_vnext_usage) %>
  <% item.with_item(label: "Budgets and alerts", href: organization_settings_billing_budgets_url(current_organization), selected_by_ids: :billing_vnext_budgets) %>
  <% item.with_item(label: "Licensing", href: organization_settings_licensing_index_path(current_organization), selected_by_ids: :licensing) %>
  <% item.with_item(label: "Payment information", href: settings_org_billing_tab_path(organization_id: current_organization.display_login, tab: "payment_information"), selected_by_ids: :payment_information) %>
  <% item.with_item(label: "Payment history", href: org_payment_history_path(organization_id: current_organization.display_login), selected_by_ids: :payment_history) %>
  <% item.with_item(label: "Additional billing details", href: settings_org_billing_tab_path(organization_id: current_organization.display_login, tab: "subscriptions"), selected_by_ids: :subscriptions) %>
  <% if show_lifecycle_label %>
    <% item.with_trailing_visual_label(
        scheme: :accent,
        title: "New",
        aria: { label: "Newly added feature" }) { "New" } %>
  <% end %>
<% end %>
