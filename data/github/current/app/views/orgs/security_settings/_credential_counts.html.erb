<%# Credential counts - loaded asynchronously %>

<% capped_count = number_to_human(Organization::CredentialAuthorizationDependency::COUNT_LIMIT, precision: 0, format: "%n%u", units: { thousand: "k", million: "M" }) %>

<%# Credential type display metadata %>
<% credential_types = [
  {
    key: :fine_grained_pats,
    title: "Fine-grained personal access tokens",
    description: "The fine-grained personal access tokens that have access to your organization.",
    unit: "token",
  },
  {
    key: :classic_pats,
    title: "Personal access tokens (classic)",
    description: "The personal access tokens (classic) that have access to your organization.",
    unit: "token",
  },
  {
    key: :ssh_keys,
    title: "SSH keys",
    description: "The user SSH keys that have access to your organization.",
    unit: "key",
  },
  {
    key: :oauth_tokens,
    title: "GitHub App and OAuth app user access tokens",
    description: "GitHub App and OAuth app user access tokens that have access to your organization.",
    unit: "token",
  },
] %>

<div class="border rounded-2 overflow-hidden">
  <% if timed_out %>
    <%# Show error state when query times out %>
    <div class="Box-row">
      <%= render(Primer::Alpha::Banner.new(scheme: :warning)) do %>
        Credential counts could not be loaded. This could be due to the large number of credentials in this organization. You can retrieve credential authorization data using the REST API credential authorizations endpoint.
      <% end %>
    </div>
  <% else %>
    <% credential_types.each do |cred_type| %>
      <% cred = counts[cred_type[:key]] %>
      <div class="Box-row d-flex flex-items-center flex-justify-between">
        <div class="flex-auto">
          <h4 class="h5 mb-1"><%= cred_type[:title] %></h4>
          <p class="color-fg-muted mb-0 f6">
            <%= cred_type[:description] %>
          </p>
        </div>
        <div class="tmp-ml-3">
          <span class="text-bold">
            <% if cred[:capped] %>
              <%= capped_count %>+ <%= cred_type[:unit].pluralize %>
            <% else %>
              <%= pluralize(cred[:count], cred_type[:unit]) %>
            <% end %>
          </span>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
