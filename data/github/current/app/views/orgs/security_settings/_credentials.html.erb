<%# Credentials section for organization security settings page %>
<%= render Primer::Beta::Subhead.new(spacious: true, test_selector: "org-credentials-section") do |component| %>
  <% component.with_heading(tag: :h2) do %>Credentials<% end %>
<% end %>

<%# Credential type display metadata %>
<% credential_types = [
  {
    title: "Fine-grained personal access tokens",
    description: "The fine-grained personal access tokens that have access to your organization.",
  },
  {
    title: "Personal access tokens (classic)",
    description: "The personal access tokens (classic) that have access to your organization.",
  },
  {
    title: "SSH keys",
    description: "The user SSH keys that have access to your organization.",
  },
  {
    title: "GitHub App and OAuth app user access tokens",
    description: "GitHub App and OAuth app user access tokens that have access to your organization.",
  },
] %>

<%# Credentials overview section %>
<div class="tmp-mb-4">
  <div class="d-flex flex-items-center flex-justify-between mb-2">
    <h3 class="h4 mb-0">Overview</h3>
  </div>
  <p class="color-fg-muted tmp-mb-3">
    An overview of <a href="https://docs.github.com/authentication/keeping-your-account-and-data-secure/about-authentication-to-github#githubs-token-formats" target="_blank" rel="noopener noreferrer" class="Link--inTextBlock">user credentials</a> with SSO authorization for this organization.
  </p>

  <%= render Primer::Alpha::IncludeFragment.new(
    src: settings_org_security_credential_counts_path(this_organization),
    loading: "lazy"
  ) do %>
    <div class="border rounded-2 overflow-hidden">
      <% credential_types.each do |cred_type| %>
        <div class="Box-row d-flex flex-items-center flex-justify-between">
          <div class="flex-auto">
            <h4 class="h5 mb-1"><%= cred_type[:title] %></h4>
            <p class="color-fg-muted mb-0 f6">
              <%= cred_type[:description] %>
            </p>
          </div>
          <div class="tmp-ml-3">
            <%= render Primer::Beta::Spinner.new(size: :small) %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
