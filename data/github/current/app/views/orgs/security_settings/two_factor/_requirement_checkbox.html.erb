<div class="<%= "color-fg-muted" if view.two_factor_requirement_checkbox_disabled? %>">
  <% if view.organization.enforcing_two_factor_requirement? %>
    <poll-include-fragment src="<%= settings_org_two_factor_enforcement_status_path(view.organization) %>" data-reload>
      <%= render(Primer::Beta::Spinner.new(size: :small, classes: "loading-spinner", mr: 2)) %>
      Require two-factor authentication for everyone in the
      <%= view.organization.safe_profile_name %> organization.
    </poll-include-fragment>
  <% else %>
    <label>
      <%# hidden input to provide value when checkbox is not checked/disabled %>
      <% if view.two_factor_requirement_checkbox_disabled? %>
        <input type="hidden"
              name="two_factor_required"
              value="enabled">
      <% else %>
        <input type="hidden"
              name="two_factor_required"
              value="no_policy">
      <% end %>
      <input type="checkbox"
            name="two_factor_required"
            class="js-org-enable-two-factor"
            value="enabled"
            <%= 'checked' if view.two_factor_requirement_enabled? %>
            <%= 'disabled' if view.two_factor_requirement_checkbox_disabled? %>>
      <input type="hidden"
            class="js-org-two-factor-currently-enabled"
            value="<%= view.two_factor_requirement_enabled? ? "1" : "0" %>">
        Require two-factor authentication for everyone in the <%= view.organization.safe_profile_name %> organization.
    </label>
  <% end %>
</div>
