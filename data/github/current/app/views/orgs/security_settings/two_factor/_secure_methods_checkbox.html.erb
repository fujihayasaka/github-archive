<label class="<%= "color-fg-muted" if view.two_factor_secure_methods_checkbox_disabled? %>">
  <% if view.organization.enforcing_two_factor_requirement? %>
    <poll-include-fragment src="<%= settings_org_two_factor_enforcement_status_path(view.organization, type: "secure") %>" data-reload>
      <%= render(Primer::Beta::Spinner.new(size: :small, classes: "loading-spinner", mr: 2)) %>
      Only allow secure two-factor methods
    </poll-include-fragment>
  <% else %>
    <%# hidden input to provide value when checkbox is not checked/disabled %>
    <% if view.two_factor_secure_methods_checkbox_disabled? %>
      <input type="hidden"
            name="two_factor_secure_methods_required"
            value="enabled">
    <% else %>
      <input type="hidden"
            name="two_factor_secure_methods_required"
            value="no_policy">
    <% end %>
    <input type="checkbox"
           name="two_factor_secure_methods_required"
           value="enabled"
           class="js-org-enable-two-factor-secure-methods"
           <%= 'checked' if view.two_factor_secure_methods_required? || !view.two_factor_requirement_enabled? %>
           <%= 'disabled' if view.two_factor_secure_methods_checkbox_disabled? %>>
    <input type="hidden"
           class="js-org-two-factor-secure-methods-currently-enabled"
           value="<%= view.two_factor_secure_methods_required? ? "1" : "0" %>">
    Only allow secure two-factor methods
    <% if !view.two_factor_secure_methods_required? %>
         <%= render(Primer::Beta::Label.new(scheme: :accent, ml: 1, vertical_align: :middle)) { "Recommended" } %>
    <% end %>
  <% end %>
</label>
