<%
  outside_collabs_without_2fa_count = view.tmp_collaborators_with_two_factor_disabled_count
%>

<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Two-factor authentication<% end %>
<% end %>

<p>
  Two-factor authentication adds another level of security for your organization.
  <%= link_to \
    "Learn more about requiring two-factor authentication in your organization.",
    docs_url("organizations/preparing-to-require-two-factor-authentication"),
    class: "Link--inTextBlock",
    :target => "_blank",
    :rel => "noopener noreferrer" %>
</p>

<%= form_tag settings_org_two_factor_enforcement_update_path(view.organization),
  :class => "mt-3 two-factor-enforcement-form", :method => :put do %>

  <div class="form-checkbox">
    <%= render "orgs/security_settings/two_factor/requirement_checkbox", view: view %>

    <p class="note">
      <%# add that we don't remove OCs after https://github.com/github/authorization/issues/4526 %>
      Organization members who do not have two-factor authentication enabled will be unable to access resources owned by the <strong><%= view.organization.safe_profile_name %></strong> organization, but will remain a member of <strong><%= view.organization.safe_profile_name %></strong> until they update their settings.

      Outside collaborators who do not have two-factor authentication enabled will be removed from the organization and notified.
      <%= link_to \
        "View organization membership",
        org_people_path(view.organization, "query": Orgs::People::OutsideCollaboratorsView::TWO_FACTOR_DISABLED_QUERY),
        class: "Link--inTextBlock",
        :target => "_blank",
        :rel => "noopener noreferrer" %> to see which users will be impacted.
    </p>

    <% if view.two_factor_requirement_checkbox_disabled? %>
      <span class="color-fg-muted note d-inline-block pt-1 mt-1 clearfix">
        <% reason = view.disabled_form_reason %>
        <%= primer_octicon(reason[:icon]) %>
        <%= reason[:reason] %>
      </span>
    <% end %>
  </div>

  <% if GitHub.two_factor_sms_enabled? %>
    <div class="form-checkbox ml-4 js-two-factor-secure-methods" <%= "hidden" unless view.two_factor_requirement_enabled? || view.organization.enforcing_two_factor_requirement? %>>
      <%= render "orgs/security_settings/two_factor/secure_methods_checkbox", view: view %>

      <p class="note">
        Users can only use secure two-factor methods: authenticator apps, passkeys, security keys, and the GitHub mobile app.
        <%= link_to \
          "Learn more about two-factor authentication",
          docs_url("authentication/about-two-factor"),
          class: "Link--inTextBlock",
          :target => "_blank",
          :rel => "noopener noreferrer"
        %>.
      </p>

      <% if view.two_factor_secure_methods_checkbox_disabled? %>
        <span class="color-fg-muted note d-inline-block pt-1 mt-1 clearfix">
          <% reason = view.disabled_form_reason %>
          <%= primer_octicon(reason[:icon]) %>
          <%= reason[:reason] %>
        </span>
      <% end %>
    </div>
  <% end %>

  <%
    all_other_users_without_2fa_count = view.users_with_two_factor_disabled_count - outside_collabs_without_2fa_count
    all_other_users_without_2fa_count = all_other_users_without_2fa_count < 0 ? 0 : all_other_users_without_2fa_count
    org_has_users = all_other_users_without_2fa_count > 0
    org_has_outside_collaborators = outside_collabs_without_2fa_count > 0
    members_link = link_to \
          "members",
          org_people_path(view.organization, "query": Orgs::People::OutsideCollaboratorsView::TWO_FACTOR_DISABLED_QUERY),
          class: "Link--inTextBlock",
          :target => "_blank",
          :rel => "noopener noreferrer"
    oc_link = link_to \
          "outside collaborators",
          org_outside_collaborators_path(view.organization, "query": Orgs::People::OutsideCollaboratorsView::TWO_FACTOR_DISABLED_QUERY),
          class: "Link--inTextBlock",
          :target => "_blank",
          :rel => "noopener noreferrer"
  %>

  <%= render(Primer::Alpha::Banner.new(
      scheme: org_has_outside_collaborators ? :danger : :warning,
      icon: org_has_outside_collaborators ? :stop : :alert,
      my: 2,
      hidden: true,
      classes: "js-org-two-factor-requirement-warning-banner",
      test_selector: "2fa-requirement-warning-banner",
    )) do %>
      <span class="text-normal">
        <% if org_has_users && org_has_outside_collaborators %>
          <b><%= all_other_users_without_2fa_count %> <%= "member".pluralize(all_other_users_without_2fa_count) %></b>
          and <b><%= outside_collabs_without_2fa_count %> <%= "outside collaborator".pluralize(outside_collabs_without_2fa_count) %></b>
          do not have two-factor authentication configured. Outside collaborators without two-factor authentication will be removed from the organization and notified.
          See which <%= members_link %> or <%= oc_link %> do not have two-factor authentication set up.
        <% elsif org_has_users && !org_has_outside_collaborators %>
          <b><%= all_other_users_without_2fa_count %> <%= "member".pluralize(all_other_users_without_2fa_count) %></b>
          <%= all_other_users_without_2fa_count > 1 ? "do" : "does" %> not have two-factor authentication configured.
          Members without two-factor authentication will be required to set it up to regain access to the organization.
          See which <%= members_link %> do not have two-factor authentication set up.
        <% elsif !org_has_users && org_has_outside_collaborators %>
          <b><%= outside_collabs_without_2fa_count %> <%= "outside collaborator".pluralize(outside_collabs_without_2fa_count) %></b>
          <%= outside_collabs_without_2fa_count > 1 ? "do" : "does" %> not have two-factor authentication configured.
          Outside collaborators without two-factor authentication will be removed from the organization and notified.
          See which <%= oc_link %> do not have two-factor authentication set up.
        <% else %>
          Existing members will lose access to organization resources if they disable two-factor authentication.
          Outside collaborators will be removed from the organization if they disable two-factor authentication.
        <% end %>
      </span>
    <% end %>

  <div class="clearfix">
    <% if !view.disable_submit_button? && view.two_factor_requirement_needs_confirmation? %>
      <%= render "orgs/security_settings/two_factor/requirement_confirmation",
      view: view,
      outside_collabs_without_2fa_count: outside_collabs_without_2fa_count %>
    <% else %>
      <%= render Primer::Beta::Button.new(
        type: :submit,
        ml: 3,
        mr: 4,
        disabled: view.two_factor_enforcement_form_disabled? || view.enforcing_two_factor_requirement?,
        "aria-label": "Save organization two factor requirement"
      ) do "Save" end %>
    <% end %>
  </div>
<% end %>
