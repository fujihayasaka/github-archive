<%
  copilot_perms = CopilotInsightsPermissions::PermissionCheck.new(organization: this_organization, user: current_user)
  show_copilot = copilot_perms.copilot_insights_org_dashboard_accessible?
  show_copilot_impact = copilot_perms.copilot_insights_impact_dashboard_accessible?
%>
<%= render_react_partial name: "insights-sidenav-partial", props: {
  selectedKey: selected,
  showDependencies: this_organization.dependency_insights_visible?(current_user),
  showActionsUsageMetrics: this_organization.actions_usage_metrics_enabled?(current_user),
  showApi: this_organization.api_insights_enabled?(current_user),
  showCopilotUsage: show_copilot,
  showCopilotCodeGeneration: show_copilot,
  showCopilotImpact: show_copilot_impact,
  urls: {
    dependency_insights: packages_dashboard_org_insights_path(this_organization),
    actions_usage_metrics: actions_usage_metrics_path(this_organization),
    actions_performance_metrics: actions_performance_metrics_path(this_organization),
    api: api_org_insights_path(this_organization),
    copilot_metrics_usage: show_copilot ? copilot_insights_usage_path(this_organization) : nil,
    copilot_metrics_code_generation: show_copilot ? copilot_insights_code_generation_path(this_organization) : nil,
    copilot_metrics_impact: show_copilot_impact ? copilot_insights_impact_path(this_organization) : nil
  }.compact
} %>
