<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% page_info title: "Initiating SAML single sign-on" %>

<div class="container-md tmp-px-3">
  <%= render Primer::BlankslateComponent.new(
    icon: "shield-lock",
    title: "You are being redirected to your identity provider in order to authenticate.",
    classes: "tmp-mt-5") do %>
    <p>
      If your browser does not redirect you back, please <%= link_to("click here to continue to your identity provider", redirect_url, id: "redirect", class: "Link--inTextBlock") %>.
    </p>
  <% end %>
</div>
