<%
experiment_id = "org_overview_roadmap_webinar_2025_q3_nudge"

variant = hawaii_experiment_variant(
  experiment_id: experiment_id,
  user_id: current_user.id,
  variant_count: 2
)

variant = 0 if variant < 0
variant = 0 if current_user.feature_flag_enabled?(:force_org_overview_roadmap_webinar_2025_q3_nudge_0, default: false)
variant = 1 if current_user.feature_flag_enabled?(:force_org_overview_roadmap_webinar_2025_q3_nudge_1, default: false)

render_variant_map = {
  0 => :roadmap_webinar_control,
  1 => :roadmap_webinar_treatment
}

render_variant = render_variant_map[variant] || :roadmap_webinar_control

experiment_html_element = "a"
experiment_category = "#{experiment_id}_#{variant}"
experiment_location = "dashboard_right_sidebar"
test_selector = experiment_id
notice_id = experiment_id
destination_key = "#{experiment_id}_pre_event"

%>
  <div class="js-notice" <%= test_selector(test_selector) %>>
    <% case render_variant %>
    <% when :roadmap_webinar_control %>
      <%= form_tag(
        dismiss_notice_path(notice_id),
        class: "github-roadmap-webinar-control js-notice-dismiss Box",
        data: analytics_visible_attributes(category: experiment_category)
      ) do %>
        <div>
          <%= render(Primer::Beta::CloseButton.new(
            type: :submit,
            color: :default,
            classes: "github-roadmap-webinar-control-dismiss",
            data: analytics_click_attributes(
              category: experiment_category,
              tag: experiment_html_element,
              action: "dismiss",
              location: experiment_location,
            ))) %>
        </div>

        <div class="d-flex flex-column">
          <div class="github-roadmap-webinar-control-date">
            Thursday, August 21
          </div>

          <div class="d-flex flex-row flex-items-start">
            <div class="flex-1">
              <h6 class="github-roadmap-webinar-control-header">
                Preview GitHub’s latest innovations - Q3 2025
              </h6>
              <div class="github-roadmap-webinar-control-subtext">
                <div>with Mario Rodriguez,</div>
                <div>GitHub’s Chief Product Officer</div>
              </div>
            </div>
            <img src="/static/images/modules/org_overview/promos/org_overview_roadmap_webinar_2025_q3_pre_event/mario_rodriguez.png"
                 alt="Mario Rodriguez" width="95" height="95"
                 class="github-roadmap-webinar-control-image circle">
          </div>

          <%= render Primer::Beta::Button.new(
            size: :medium,
            tag: :a,
            scheme: :primary,
            href: "/in-product-messaging/dismiss-and-redirect?notice=#{notice_id}&destination_key=#{destination_key}",
            block: true,
            classes: "github-roadmap-webinar-control-cta",
            data: analytics_click_attributes(
              category: experiment_category,
              tag: experiment_html_element,
              action: "register_for_the_webinar",
              location: experiment_location,
              )
          ) do %>
            Register for the webinar
          <% end %>
        </div>
      <% end %>
    <% when :roadmap_webinar_treatment %>
      <%= form_tag(
        dismiss_notice_path(notice_id),
        class: "github-roadmap-webinar-treatment js-notice-dismiss Box color-bg-subtle",
        data: analytics_visible_attributes(category: experiment_category)
      ) do %>
        <div>
          <%= render(Primer::Beta::CloseButton.new(
            type: :submit,
            color: :default,
            classes: "github-roadmap-webinar-treatment-dismiss",
            data: analytics_click_attributes(
              category: experiment_category,
              tag: experiment_html_element,
              action: "dismiss",
              location: experiment_location,
            ))) %>
        </div>

        <img class="github-roadmap-webinar-treatment-image dark" src="/static/images/modules/org_overview/promos/org_overview_roadmap_webinar_2025_q3_pre_event/product-preview-dark.png"
             alt="Spark Preview" width="100%" height="auto">
        <img class="github-roadmap-webinar-treatment-image light" src="/static/images/modules/org_overview/promos/org_overview_roadmap_webinar_2025_q3_pre_event/product-preview-light.png"
             alt="Spark Preview" width="100%" height="auto">

        <div class="github-roadmap-webinar-treatment-date">
          Thursday, August 21
        </div>

        <div class="github-roadmap-webinar-treatment-content">
          <h6 class="github-roadmap-webinar-treatment-header">
            Preview GitHub’s latest innovations - Q3 2025
          </h6>

          <ul class="github-roadmap-webinar-treatment-topics">
            <li class="github-roadmap-webinar-treatment-topic">Spark - build apps in natural language</li>
            <li class="github-roadmap-webinar-treatment-topic">Copilot coding agent and SDLC agents</li>
            <li class="github-roadmap-webinar-treatment-topic">End-to-end supply chain security</li>
          </ul>

          <%= render Primer::Beta::Button.new(
            size: :medium,
            tag: :a,
            scheme: :primary,
            href: "/in-product-messaging/dismiss-and-redirect?notice=#{notice_id}&destination_key=#{destination_key}",
            block: true,
            classes: "github-roadmap-webinar-treatment-cta",
            data: analytics_click_attributes(
              category: experiment_category,
              tag: experiment_html_element,
              action: "register_for_the_webinar",
              location: experiment_location,
              )
          ) do %>
            Register for the webinar
          <% end %>
        </div>
      <% end %>
    <% end %>
    <%# End A|B Test %>
  </div>
