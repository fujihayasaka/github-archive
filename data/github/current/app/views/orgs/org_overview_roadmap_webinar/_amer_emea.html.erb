<%
notice_id = "org_overview_roadmap_webinar_2025_q4_nudge_amer_emea"
html_element = "a"
category = notice_id
location = "org_overview_right_sidebar"
test_selector = notice_id
destination_key = notice_id

%>
<div class="js-notice" <%= test_selector(test_selector) %>>
  <%= form_tag(
    dismiss_notice_path(notice_id),
    class: "github-roadmap-webinar-treatment js-notice-dismiss Box color-bg-subtle",
    data: analytics_visible_attributes(category: category, organization: current_organization.id)
  ) do %>
    <div>
      <%= render(Primer::Beta::CloseButton.new(
        type: :submit,
        color: :default,
        classes: "github-roadmap-webinar-treatment-dismiss",
        data: analytics_click_attributes(
          category: category,
          organization: current_organization.id,
          tag: html_element,
          action: "dismiss",
          location: location,
        ))) %>
    </div>

    <img class="github-roadmap-webinar-treatment-image dark" src="/static/images/modules/org_overview/promos/org_overview_roadmap_webinar/q4-webinar-dark.png"
          alt="Q4 Roadmap webinar preview" width="100%" height="auto">
    <img class="github-roadmap-webinar-treatment-image light" src="/static/images/modules/org_overview/promos/org_overview_roadmap_webinar/q4-webinar-light.png"
          alt="Q4 Roadmap webinar preview" width="100%" height="auto">

    <div class="github-roadmap-webinar-treatment-date">
      Thursday, November 13
    </div>

    <div class="github-roadmap-webinar-treatment-content">
      <h6 class="github-roadmap-webinar-treatment-header">
        Future of Software Development - Q4 2025
      </h6>

      <ul class="github-roadmap-webinar-treatment-topics">
        <li class="github-roadmap-webinar-treatment-topic">Q4 roadmap: what it means for you</li>
        <li class="github-roadmap-webinar-treatment-topic">Key GitHub Universe announcements</li>
        <li class="github-roadmap-webinar-treatment-topic">Agent-powered dev experience updates</li>
      </ul>

      <%= render Primer::Beta::Button.new(
        size: :medium,
        tag: :a,
        scheme: :primary,
        href: "/in-product-messaging/dismiss-and-redirect?notice=#{notice_id}&destination_key=#{destination_key}",
        block: true,
        classes: "github-roadmap-webinar-treatment-cta",
        data: analytics_click_attributes(
          organization: current_organization.id,
          category: category,
          tag: html_element,
          action: "register_for_the_webinar",
          location: location,
          )
      ) do %>
        Register for the webinar
      <% end %>
    </div>
  <% end %>
</div>
