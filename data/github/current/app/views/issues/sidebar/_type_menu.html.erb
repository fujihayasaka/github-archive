<% menu_id = local_assigns.fetch(:menu_id, "issue-type-select-menu") %>
<details class="details-reset details-overlay select-menu hx_rsm type-select-menu"
  id="<%= menu_id %>">
  <summary class="text-bold discussion-sidebar-heading discussion-sidebar-toggle hx_rsm-trigger"
          aria-haspopup="menu">
    <%= primer_octicon(:gear) %>
    Type
  </summary>
  <details-menu class="select-menu-modal position-absolute right-0 hx_rsm-modal" style="z-index: 99;" role="menu"><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
    <div class="select-menu-header rounded-top-2">
      <span class="select-menu-title">Apply a type to this issue</span>
      <%= render Primer::Beta::CloseButton.new(classes: "hx_rsm-close-button btn-link", "data-toggle-for": menu_id, "aria-label": "Close menu") %>
    </div>
    <div class="hx_rsm-content" role="menu">
      <%= render "issues/sidebar/type_menu_content", template: template, issue_types: local_assigns[:issue_types], selected_issue_type: local_assigns[:selected_issue_type] %>
    </div>
  </details-menu>
</details>
