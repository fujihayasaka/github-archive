<%
  issue_types = current_repository.owner.issue_types.where(enabled: true).order(:name)
  selected_issue_type = issue_types.find { |it| it.name&.casecmp(template.type)&.zero? } if template.type.present?
  menu_id = local_assigns.fetch(:menu_id, "issue-type-select-menu")
%>
<div class="discussion-sidebar-item js-discussion-sidebar-item">
  <%= render "issues/sidebar/type_menu", template: template, issue_types: issue_types, selected_issue_type: selected_issue_type, menu_id: menu_id %>
  <div class="js-issue-template-type-display">
    <% if selected_issue_type %>
      <%= render(Issues::TypeComponent.new(issue_type: selected_issue_type)) %>
    <% else %>
      <span class="color-fg-muted">None yet</span>
    <% end %>
  </div>
</div>
