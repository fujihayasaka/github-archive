<span class="css-truncate">
  <% requests = pull_request.pending_review_requests.to_a %>
  <% requests += with_database_error_fallback(fallback: []) { pull_request.deferred_code_owner_review_requests(requests) } %>
  <% requests += with_database_error_fallback(fallback: []) { pull_request.deferred_copilot_review_requests(requests) } %>
  <% codeowners = with_database_error_fallback(fallback: []) { pull_request.codeowners } %>
  <% requests = pull_request.visible_sidebar_requests(current_user, requests) %>
  <% reviews = pull_request.visible_sidebar_reviews(current_user) %>
  <% can_request_review = issue_permissions(pull_request.issue, current_user, :review_requestable) && current_repository_writable? %>
  <%
    show_copilot_request_row = false
    copilot_deferred_requestable = false
    copilot_bot = nil

    if !local_assigns[:suggested_reviewers] && can_request_review &&
        FeatureFlag.vexi.enabled?(:copilot_request_button_in_reviewers_list, current_repository, default: false)
      copilot_access = PullRequests::Copilot::CodeReviewAccess.new(
        actor: current_user,
        pull_request: pull_request,
        current_repository: current_repository,
      )

      if copilot_access.can_create_review_request?
        copilot_bot = Apps::Privileged.integration(:copilot_pull_request_reviewer)&.bot
        if copilot_bot.present?
          copilot_request_pending = requests.any? { |request| request.reviewer == copilot_bot && !request.deferred_copilot? }
          copilot_deferred_pending = requests.any? { |request| request.reviewer == copilot_bot && request.deferred_copilot? }
          copilot_has_reviewed = reviews.any? { |review| review.user == copilot_bot && !review.pending? }

          unless copilot_request_pending || copilot_has_reviewed
            if copilot_deferred_pending
              copilot_deferred_requestable = true
            else
              show_copilot_request_row = true
            end
          end
        end
      end
    end
  %>

  <% if reviews.any? || requests.any? %>
    <%
    review_by_writer = {}

    Promise.all([
      Promise.all(reviews.map { |review|
        review.async_author_is_qualified_reviewer?.then { |made_by_writer|
          review_by_writer[review] = made_by_writer
        }
      }),

      Promise.all(reviews.map { |review|
        if review.commented?
          review.async_user.then { |user|
            if enforced_review = pull_request.latest_enforced_review_for(user)
              enforced_review.async_author_is_qualified_reviewer?.then { |made_by_writer|
                review_by_writer[enforced_review] = made_by_writer
              }
            end
          }
        end
      })
    ]).sync
    %>
    <% reviews_with_write_access_or_copilot, reviews_without_write_access = reviews.partition do |review|
        review_by_writer[review] || (review.user&.bot? && review.user&.slug == Apps::Privileged::CopilotPullRequestReviewer::SLUG)
        end
    %>
    <% reviews = reviews_with_write_access_or_copilot %>

    <% reviews.each do |review| %>
      <%= render "issues/sidebar/review_item",
        review: review,
        pull_request: pull_request,
        review_by_writer: review_by_writer,
        codeowners: codeowners,
        current_user: current_user,
        current_repository: current_repository %>
    <% end %>
    <% requests.each do |req| %>
    <% if req.reviewer.is_a?(BusinessTeam) %>
      <% next unless current_repository.organization&.business_team_pr_reviewers_enabled? %>
      <% req.reviewer.set_organization_context(current_repository.organization) %>
    <% end %>
    <% reviewer_display_name = req.reviewer.is_a?(Team) ? req.reviewer : req.reviewer.display_login %>
      <p class="d-flex">
        <% if req.reviewer.is_a?(Team) && current_repository.in_organization? %>
            <%= avatar_for req.reviewer, 20, :class => "avatar mr-2" %>
            <%= content_tag(:span,
              class: "flex-1 min-width-0 text-bold v-align-middle color-fg-muted js-team-mention js-reviewer-team tooltipped",
              "data-url": team_members_path(req.reviewer, current_repository.organization),
              "data-id": req.reviewer.id,
              "data-error-text": "Failed to load team members",
              "data-permission-text": "Team members are private",
              data: hovercard_data_attributes_for_team(req.reviewer)
            ) do %><%# erblint:disable Primer::Accessibility::TooltippedMigration %>
              <span class="css-truncate-target width-fit v-align-middle">
                <%= req.reviewer.name %>
              </span>
            <% end %>
        <% elsif req.reviewer.is_a?(User) %>
          <%= render "issues/sidebar/user", user: req.reviewer %>
        <% end %>

        <% unless req.deferred_copilot? && copilot_deferred_requestable %>
          <%= button_tag(id: "awaiting-review-#{reviewer_display_name}", type: "button", class: "btn-link flex-order-2") do %>
            <span class="reviewers-status-icon">
              <%= primer_octicon(:"dot-fill", classes: "hx_dot-fill-pending-icon") %>
            </span>
          <% end %>
          <%= render Primer::Alpha::Tooltip.new(for_id: "awaiting-review-#{reviewer_display_name}", text: "Awaiting requested review from #{reviewer_display_name}", type: :label, direction: :nw) %>
        <% end %>

        <% if req.deferred_code_owner? %>
          <%= button_tag(id: "deferred-code-owner-rr-for-#{reviewer_display_name}", type: "button", class: "mr-2 btn-link muted-icon") do %>
            <span class="reviewers-status-icon" <%= test_selector("deferred-code-owner-rr-for-#{reviewer_display_name}") %>>
              <%= primer_octicon(:moon) %>
            </span>
          <% end %>
          <%= render Primer::Alpha::Tooltip.new(for_id: "deferred-code-owner-rr-for-#{reviewer_display_name}", text: "#{reviewer_display_name} will be requested when the pull request is marked ready for review", type: :label, direction: :nw) %>
          <%= button_tag(id: "codeowner-#{reviewer_display_name}", type: "button", class: "mr-2 btn-link muted-icon") do %>
            <span class="reviewers-status-icon">
              <%= primer_octicon(:"shield-lock") %>
            </span>
          <% end %>
          <%= render Primer::Alpha::Tooltip.new(for_id: "codeowner-#{reviewer_display_name}", text: "#{reviewer_display_name} is a code owner", type: :label, direction: :nw) %>
        <% elsif req.deferred_copilot? %>
          <% if copilot_deferred_requestable %>
            <%# Group the deferred indicator and the manual request action so they stay vertically centered together. %>
            <span class="d-flex flex-items-center flex-order-2 position-relative">
              <%= render(Primer::Beta::Button.new(id: "request-deferred-copilot-rr-for-#{reviewer_display_name}", name: "suggested_reviewer_id", scheme: :link, value: req.reviewer.id, type: :submit, classes: "js-suggested-reviewer")) do %>
                Request
              <% end %>
              <%= render(Primer::Alpha::Tooltip.new(for_id: "request-deferred-copilot-rr-for-#{reviewer_display_name}", type: :description, text: "Request a review from #{reviewer_display_name} now", direction: :nw)) %>
              <%= button_tag(id: "deferred-copilot-rr-for-#{reviewer_display_name}", type: "button", class: "ml-2 btn-link muted-icon") do %>
                <span class="reviewers-status-icon" <%= test_selector("deferred-copilot-rr-for-#{reviewer_display_name}") %>>
                  <%= primer_octicon(:moon) %>
                </span>
              <% end %>
            </span>
          <% else %>
            <%= button_tag(id: "deferred-copilot-rr-for-#{reviewer_display_name}", type: "button", class: "mr-2 btn-link muted-icon") do %>
              <span class="reviewers-status-icon" <%= test_selector("deferred-copilot-rr-for-#{reviewer_display_name}") %>>
                <%= primer_octicon(:moon) %>
              </span>
            <% end %>
          <% end %>
          <%= render Primer::Alpha::Tooltip.new(for_id: "deferred-copilot-rr-for-#{reviewer_display_name}", text: "#{reviewer_display_name} will automatically review once the pull request is marked ready for review", type: :label, direction: :nw) %>
        <% elsif req.deferred? %>
          <%= button_tag(id: "deferred-code-owner-rr-for-#{reviewer_display_name}", type: "button", class: "mr-2 btn-link muted-icon") do %>
            <span class="reviewers-status-icon" <%= test_selector("deferred-code-owner-rr-for-#{reviewer_display_name}") %>>
              <%= primer_octicon(:moon) %>
            </span>
          <% end %>
          <%= render Primer::Alpha::Tooltip.new(for_id: "deferred-code-owner-rr-for-#{reviewer_display_name}", text: "#{reviewer_display_name} will be requested when the pull request is marked ready for review", type: :label, direction: :nw) %>
        <% elsif req.assigned_from_review_request.present? && codeowners.include?(req.assigned_from_review_request.reviewer) %>
          <%= button_tag(id: "assigned-codeowner-#{reviewer_display_name}", type: "button", class: "mr-2 btn-link muted-icon") do %>
            <span class="reviewers-status-icon">
              <%= primer_octicon(:"shield-lock") %>
            </span>
          <% end %>
          <%= render Primer::Alpha::Tooltip.new(for_id: "assigned-codeowner-#{reviewer_display_name}", text: "#{reviewer_display_name} is a code owner automatically assigned from #{req.assigned_from_review_request.reviewer}", type: :label, direction: :nw) %>
        <% elsif req.assigned_from_review_request.present? %>
          <%= button_tag(id: "assigned-review-#{reviewer_display_name}", type: "button", class: "mr-2 btn-link muted-icon") do %>
            <span class="reviewers-status-icon">
              <%= primer_octicon(:people) %>
            </span>
          <% end %>
          <%= render Primer::Alpha::Tooltip.new(for_id: "assigned-review-#{reviewer_display_name}", text: "#{reviewer_display_name} was automatically assigned from #{req.assigned_from_review_request.reviewer}", type: :label, direction: :nw) %>
        <% elsif codeowners.include?(req.reviewer) %>
          <%= button_tag(id: "codeowner-#{reviewer_display_name}", type: "button", class: "mr-2 btn-link muted-icon") do %>
            <span class="reviewers-status-icon">
              <%= primer_octicon(:"shield-lock") %>
            </span>
          <% end %>
          <%= render Primer::Alpha::Tooltip.new(for_id: "codeowner-#{reviewer_display_name}", text: "#{reviewer_display_name} is a code owner", type: :label, direction: :nw) %>
        <% end %>

        <%= render PullRequests::Copilot::IntroPopoverComponent.new(review_request: req, pull_request: pull_request, user: current_user, automatic: true) %>
      </p>
    <% end %>

    <% if reviews_without_write_access&.any? %>
      <details class="details-reset Details-element" open>
        <summary id="collapsible-reviewers-without-write" class="discussion-sidebar-heading color-fg-muted text-bold no-underline Link--onHover">
          <%= '+' if reviews_with_write_access_or_copilot.any? %><%= "#{reviews_without_write_access.length} more #{'reviewer'.pluralize(reviews_without_write_access.length)}"%>
          <span class="Details-content--open float-right"><%= primer_octicon(:"chevron-up") %></span>
          <span class="Details-content--closed float-right"><%= primer_octicon(:"chevron-down") %></span>
        </summary>
        <% reviews_without_write_access.each do |review| %>
          <div class="tmp-pl-3">
            <%= render "issues/sidebar/review_item",
              review: review,
              pull_request: pull_request,
              review_by_writer: review_by_writer,
              codeowners: codeowners,
              current_user: current_user,
              current_repository: current_repository %>
          </div>
        <% end %>
      </details>
      <%= render(Primer::Alpha::Tooltip.new(
        for_id: "collapsible-reviewers-without-write",
        text: "Reviewers whose approvals may not affect merge requirements",
        type: :description,
        direction: :ne,
      )) %>
    <% end %>
    <% if show_copilot_request_row %>
      <%= render partial: "pull_requests/copilot_suggested_reviewer", locals: {
        pull_request: pull_request,
        copilot: copilot_bot,
      } %>
    <% end %>

    <% if local_assigns[:suggested_reviewers] && pull_request.suggested_reviewers_available?(actor: current_user) %>
      <%= render partial: "pull_requests/suggested_reviewers", locals: {
        pull_request: pull_request,
        suggestions: suggested_reviewers
      } %>
    <%- else -%>
      <%= render "issues/sidebar/reviewers_hint", pull_request: pull_request %>
    <% end %>
  <% elsif can_request_review %>
    <% if show_copilot_request_row %>
      <%= render partial: "pull_requests/copilot_suggested_reviewer", locals: {
        pull_request: pull_request,
        copilot: copilot_bot,
      } %>
    <% end %>
    <% if pull_request.suggested_reviewers_available?(actor: current_user) %>
      <% suggested_reviewers_src = gh_suggested_reviewers_path(pull_request) %>
      <% suggested_reviewers_src += "?exclude_copilot=1" if show_copilot_request_row %>
      <%= render Primer::Alpha::IncludeFragment.new(src: suggested_reviewers_src) do %>
        Loading suggestions…
      <% end %>
    <% elsif !show_copilot_request_row %>
      <%= render "issues/sidebar/reviewers_none", pull_request: pull_request %>
    <% end %>
  <% else %>
    No reviews
  <% end %>
</span>
