<%
  issue_types = local_assigns[:issue_types] || current_repository.owner.issue_types.where(enabled: true).order(:name)
  selected_issue_type = local_assigns.key?(:selected_issue_type) ? local_assigns[:selected_issue_type] : (issue_types.find { |it| it.name&.casecmp(template.type)&.zero? } if template.type.present?)
%>
<div class="select-menu-list">
  <button type="button" value="" class="select-menu-item text-normal width-full" role="menuitemradio" aria-checked="<%= selected_issue_type.nil? %>" tabindex="0">
    <template class="js-type-pill-template"><span class="color-fg-muted">None yet</span></template>
    <%= primer_octicon(:check, classes: "select-menu-item-icon") %>
    <div class="select-menu-item-text d-flex flex-items-start">
      <svg class="mr-2 mt-1" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" style="flex-shrink: 0;">
        <circle cx="6" cy="6" r="5" stroke="var(--fgColor-muted)" stroke-width="2" fill="none"></circle>
      </svg>
      <span class="text-bold" style="font-size: var(--text-body-size-medium, .875rem);">No type</span>
    </div>
  </button>
  <% issue_types.each do |issue_type| %>
    <% fg_token = Issues::TypeComponent::COLOR_SCHEME_MAP.dig(issue_type.color.to_s.downcase, :fg) || "muted" %>
    <button type="button" value="<%= issue_type.name %>" class="select-menu-item text-normal width-full" role="menuitemradio" aria-checked="<%= selected_issue_type&.id == issue_type.id %>" tabindex="0">
      <template class="js-type-pill-template"><%= render(Issues::TypeComponent.new(issue_type: issue_type)) %></template>
      <%= primer_octicon(:check, classes: "select-menu-item-icon") %>
      <div class="select-menu-item-text d-flex flex-items-start">
        <svg class="mr-2 mt-1" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" style="flex-shrink: 0;">
          <circle cx="6" cy="6" r="5" stroke="var(--fgColor-<%= fg_token %>)" stroke-width="2" fill="none"></circle>
        </svg>
        <div>
          <span class="text-bold" style="font-size: var(--text-body-size-medium, .875rem);"><%= issue_type.name %></span>
          <% if issue_type.description.present? %>
            <div class="description d-block css-truncate-target m-0 color-fg-muted">
              <%= issue_type.description %>
            </div>
          <% end %>
        </div>
      </div>
    </button>
  <% end %>
</div>
