<%
  tags ||= []
  inline ||= nil
  should_do_live_update = issue.pull_request
  container_classes = ["discussion-sidebar-item", "sidebar-assignee", "js-discussion-sidebar-item"]
  container_classes += ["js-socket-channel", "js-updatable-content"] if should_do_live_update
%>
<div class="<%= container_classes.join(" ") %>"
  <% if should_do_live_update %>
    data-channel="<%= live_update_view_channel(GitHub::WebSocket::Channels.pull_request(issue.pull_request)) %>"
    data-gid="<%= issue.pull_request.global_relay_id %>"
    data-url="<%= show_partial_issue_path(:id => issue, :partial => "issues/sidebar/show/assignees") %>"
    data-channel-event-name="assignees_updated"
  <% end %>
>
  <%= form_tag assignees_path(id: issue.number, :inline => inline), :method => :put, :class => "js-issue-sidebar-form", "aria-label": "Select assignees" do %>

    <% track_render_partial("issues/sidebar/assignees_menu", tags) do %>
      <%= render :partial => "issues/sidebar/assignees_menu", :locals => { :issue => issue, :tags => tags, :inline => inline } %>
    <% end %>

    <% unless inline %>
      <% track_render_partial("issues/sidebar/assignees", tags) do %>
        <%= render :partial => "issues/sidebar/assignees", :locals => { :issue => issue } %>
      <% end %>
    <% end %>

  <% end %>
</div>
