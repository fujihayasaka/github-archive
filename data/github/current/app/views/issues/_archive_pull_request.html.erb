<% if issue.pull_request? && FeatureFlag.vexi.enabled?(:archive_pull_request, issue.repository, default: false) %>
  <% pull = issue.pull_request %>
  <% if pull.archivable_by?(current_user) %>
    <div class="discussion-sidebar-item border-top-0 mt-0">
      <details class="details-reset details-overlay details-overlay-dark js-archive-pull-request">
        <summary class="d-inline-block">
          <span class="text-bold Link--primary lock-toggle-link">
            <%= primer_octicon(:archive, mr: 1) %> <strong>Archive pull request</strong>
          </span>
        </summary>
        <details-dialog class="anim-fade-in fast Box Box--overlay color-fg-default f5" aria-labelledby="archive-pr-dialog-title"><%# erblint:disable A11yDetailsDialogMigration %>
          <%= form_tag archive_issue_path(issue.repository.owner, issue.repository, issue.number), method: :put do %>
            <div class="Box-header">
              <button class="Box-btn-octicon btn-octicon float-right" type="button" aria-label="Close dialog" data-close-dialog>
                <%= primer_octicon(:x) %>
              </button>
              <h3 id="archive-pr-dialog-title" class="Box-title">
                Archive this pull request
              </h3>
            </div>
            <div class="Box-body">
              <p class="text-bold">Are you sure you want to archive this pull request?</p>
              <ul class="tmp-ml-3">
                <li>The pull request will be <strong>closed</strong> and <strong>locked</strong>.</li>
                <li>Only repository administrators will be able to see it.</li>
                <li>A repository administrator can unarchive this pull request at any time.</li>
              </ul>
            </div>
            <div class="Box-footer">
              <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger, block: true) do %>
                Archive this pull request
              <% end %>
            </div>
          <% end %>
        </details-dialog>
      </details>
    </div>
  <% elsif pull.unarchivable_by?(current_user) %>
    <div class="discussion-sidebar-item border-top-0 mt-0">
      <details class="details-reset details-overlay details-overlay-dark js-unarchive-pull-request">
        <summary class="d-inline-block">
          <span class="text-bold Link--primary lock-toggle-link">
            <%= primer_octicon(:archive, mr: 1) %> <strong>Unarchive pull request</strong>
          </span>
        </summary>
        <details-dialog class="anim-fade-in fast Box Box--overlay color-fg-default f5" aria-labelledby="unarchive-pr-dialog-title"><%# erblint:disable A11yDetailsDialogMigration %>
          <%= form_tag unarchive_issue_path(issue.repository.owner, issue.repository, issue.number), method: :put do %>
            <div class="Box-header">
              <button class="Box-btn-octicon btn-octicon float-right" type="button" aria-label="Close dialog" data-close-dialog>
                <%= primer_octicon(:x) %>
              </button>
              <h3 id="unarchive-pr-dialog-title" class="Box-title">
                Unarchive this pull request
              </h3>
            </div>
            <div class="Box-body">
              <p class="text-bold">Are you sure you want to unarchive this pull request?</p>
              <ul class="tmp-ml-3">
                <li>The pull request will remain <strong>closed</strong> and <strong>locked</strong>.</li>
                <li>It will be visible to all users with repository access again.</li>
                <li>You can reopen and unlock it separately if needed.</li>
              </ul>
            </div>
            <div class="Box-footer">
              <%= render Primer::Beta::Button.new(type: :submit, block: true) do %>
                Unarchive this pull request
              <% end %>
            </div>
          <% end %>
        </details-dialog>
      </details>
    </div>
  <% end %>
<% end %>
