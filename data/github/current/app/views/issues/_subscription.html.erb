<% if logged_in? %>
  <div class="discussion-sidebar-item sidebar-notifications">
    <%= render(
      Notifications::ThreadSubscriptionComponent.new(
        thread: issue,
        list: issue.repository,
        display_explanation_text: true,
        deferred: deferred_content && FeatureFlag.vexi.enabled_or_raise?(:notifications_async_issues_subscription_button, current_user), # rubocop:disable GitHub/FeatureManagement/NoVexiEnabledOrRaiseUsage
      ),
    ) %>
  </div>
<% end %>
