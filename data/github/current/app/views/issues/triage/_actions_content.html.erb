<%= issues_triage_menu_hidden_fields(params[:issues]) %>

<div class="select-menu-list">
  <button type="button" role="menuitem" class="select-menu-item width-full" name="state" value="open">
    <div class="select-menu-item-text">Open</div>
  </button>
  <button type="button" role="menuitem" class="select-menu-item width-full" name="state" value="closed">
    <div class="select-menu-item-text">Closed</div>
  </button>
  <% if FeatureFlag.vexi.enabled?(:archive_pull_request, current_repository, default: false) %>
    <button type="button" role="menuitem" class="select-menu-item width-full" name="archive" value="true">
      <div class="select-menu-item-text">Archived</div>
    </button>
    <button type="button" role="menuitem" class="select-menu-item width-full" name="archive" value="false">
      <div class="select-menu-item-text">Unarchived</div>
    </button>
  <% end %>
</div>
