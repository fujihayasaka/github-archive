<%
  show_filter_bar = !view.new_repo?
  show_announcements = local_assigns.fetch(:show_announcements, false)
  show_archived = local_assigns.fetch(:show_archived, false)
  search_temporarily_unavailable = local_assigns.fetch(:search_temporarily_unavailable, false)
  repo_base_url = "/#{current_repository.owner.display_login}/#{current_repository.name}/issues"
%>

<% if show_archived %>
  <% track_render_partial("layouts/repository/default_container/archived_notice", partial_tags) do %>
    <% if current_repository&.archived? %>
      <%= render Repositories::ArchivedNoticeComponent.new(repository: current_repository) %>
    <% end %>
  <% end %>
<% end %>

<% if show_announcements %>
  <%= render(Site::EnterpriseBannersComponent.new) %>
<% end %>

<% track_render_partial("issues/issues_index_root", tags) do %>
  <h1 class='sr-only'><%= pulls_only ? "Pull requests" : "Issues" %>: <%= current_repository.name_with_display_owner %></h1>

  <% if view.show_pulls_es_degraded_banner? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :warning, classes: "tmp-mb-3", test_selector: "pulls-es-degraded-banner")) do %>
      Some pull requests may be missing due to an <a href="https://www.githubstatus.com/incidents/x69zbgdyfzg0" class="Link--inTextBlock">ongoing search incident</a>, but no data is lost. Use the <a href="https://docs.github.com/en/rest/pulls/pulls?apiVersion=2026-03-10#list-pull-requests" class="Link--inTextBlock">API</a> or <a href="https://docs.github.com/en/github-cli" class="Link--inTextBlock">GitHub CLI</a> (<code>gh pr list</code>) for complete pull request results.
    <% end %>
  <% end %>

  <% if search_temporarily_unavailable %>
    <%= render(Primer::Alpha::Banner.new(scheme: :warning, classes: "tmp-mb-3", test_selector: "pulls-search-temporarily-unavailable-banner")) do %>
      Pull request search is temporarily unavailable. Please try again later.
    <% end %>
  <% elsif view.show_mysql_only_mode? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :warning, classes: "tmp-mb-3", test_selector: "pulls-mysql-only-notice")) do %>
      Advanced search is temporarily unavailable. Showing open and closed pull requests only. Use the <a href="https://docs.github.com/en/rest/pulls/pulls?apiVersion=2026-03-10#list-pull-requests" class="Link--inTextBlock">API</a> or <a href="https://docs.github.com/en/github-cli" class="Link--inTextBlock">GitHub CLI</a> (<code>gh pr list</code>) for full search capabilities.
   <% end %>
  <% end %>

  <% if pulls_only %>
    <% pr_limit = current_user_pr_create_limit_info %>
    <% if pr_limit %>
      <% pr_cap_base = "Users without write access can have up to #{pr_limit[:limit]} #{"pull request".pluralize(pr_limit[:limit])} open at a time. " %>
      <% if pr_limit[:reached] %>
        <% pr_cap_pulls_url = "/#{current_repository.owner.display_login}/#{current_repository.name}/pulls/#{current_user.display_login}" %>
        <%= render(Primer::Alpha::Banner.new(
          icon: :info,
          scheme: :default,
          classes: "tmp-mb-3",
          description: safe_join([pr_cap_base, "Merge or close your ", link_to("open pull requests", pr_cap_pulls_url, class: "Link--inTextBlock"), " to submit a new one. Drafts don't count toward the limit."])
        )) do %>
          You've reached the open pull request limit for this repository
        <% end %>
      <% else %>
        <%= render(Primer::Alpha::Banner.new(
          icon: :info,
          scheme: :default,
          classes: "tmp-mb-3",
          description: safe_join([pr_cap_base, "Drafts don't count toward the limit."])
        )) do %>
          This repository limits pull requests
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# never show both banners. in the case where both banner would potentially show, prioritize maintainer label education banner %>
  <% if show_maintainer_label_education_banner? %>
    <% track_render_partial("issues/maintainer_label_education_banner", tags) do %>
      <%= render partial: "issues/maintainer_label_education_banner", locals: { view: view } %>
    <% end %>
  <% elsif view.show_first_time_contributor_banner?(is_pull_requests: pulls_only) %>
    <% if pulls_only %>
      <% track_render_partial("pull_requests/first_time_contributor_banner", tags) do %>
        <%= render partial: "pull_requests/first_time_contributor_banner", locals: { view: view } %>
      <% end %>
    <% else %>
      <% track_render_partial("issues/first_time_contributor_banner", tags) do %>
        <%= render partial: "issues/first_time_contributor_banner", locals: { view: view } %>
      <% end %>
    <% end  %>
  <% end %>

  <% if view.display_recently_touched_branches_list? %>
    <%= render Primer::Alpha::IncludeFragment.new(src: show_partial_tree_path(:partial => "tree/recently_touched_branches_list")) %>
  <% end %>

  <% if !view.pulls_only && view.pinned_issues.any? %>
    <div>
      <%
        can_pin_issues = current_repository.can_pin_issues?(current_user)
        track_render_partial("issues/pinned_issues", tags + ["can_pin_issues:#{can_pin_issues}"]) do
      %>
        <% if can_pin_issues %>
          <%= form_for current_repository, :url => prioritize_pinned_issue_path(current_repository.owner, current_repository),
            :html => {:class => "js-pinned-issues-reorder-form",
            :id => "user-#{current_repository.id}-pinned-issues-reorder-form"},
            :method => :put do |f| %>
              <%= render partial: "issues/pinned_issues", locals: { pinned_issues: view.pinned_issues, can_pin: true } %>
            <% end %>
        <% else %>
            <%= render partial: "issues/pinned_issues", locals: { pinned_issues: view.pinned_issues, can_pin: false } %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%
  if render_issue_react_opt_in
    url = "#{repo_base_url}?new_issues_experience=true"
  %>
  <%= form_with url: url do |f| %>
    <% if user_feature_enabled?(:lifecycle_label_name_updates) %>
      <%= render(Primer::Experimental::BetaLabel.new) %>
    <% else %>
      <%= render(Primer::Beta::Label.new(scheme: :success)) { "Beta" } %>
    <% end %>
    <%= render Primer::Beta::Button.new(scheme: :link, type: :submit, mt: 2, classes: "tmp-mb-3") do %>
      <%= emoji_tag(Emoji.find_by_alias("zap"), class: "emoji emoji-icon") %>Try the new experience
    <% end %>
  <% end %>
  <% end %>

  <% track_render_partial("issues/search_bar", tags) do %>
    <%= render partial: "issues/search_bar", locals: { pulls_only: pulls_only, query: query, milestones_count: milestones_count, labels_count: labels_count, mysql_only: view.show_mysql_only_mode? } %>
  <% end %>

  <div class="d-block d-lg-none no-wrap">
    <%= render partial: "issues/filters/states", locals: { issues: issues, pulls_only: pulls_only, open_count: open_count, closed_count: closed_count } %>
  </div>

  <div class="Box tmp-mt-3 Box--responsive hx_Box--firstRowRounded0">
    <% if show_filter_bar %>
      <% track_render_partial("issues/filter_bar", tags) do %>
        <%= render partial: "issues/filter_bar", locals: { issues: issues, pulls_only: pulls_only, query: query, open_count: open_count, closed_count: closed_count, mysql_only: view.show_mysql_only_mode? } %>
      <% end %>
    <% end %>

    <% if query_error %>
      <%= render "issues/issues_blankslate", icon: view.query_error_icon, title: view.query_error_title, copy: view.query_error_copy %>
    <% elsif issues.empty? %>
      <%= render "issues/issues_blankslate", icon: view.blankslate_icon, title: view.blankslate_title, copy: view.blankslate_copy %>
    <% else %>
      <h2 class='sr-only'><%= pulls_only ? "Pull requests" : "Issues" %> list</h2>
      <div aria-label="Issues" role="group" data-issue-and-pr-hovercards-enabled>
        <div class="js-navigation-container js-active-navigation-container" data-hpc>
          <% view.issues.each do |issue| %>
            <% track_render_partial("issues/issue_index_issue_item", tags) do %>
              <%= render "issues/issue", view: create_view_model(
                Issues::IssueListItem,
                issue: issue,
                repo: current_repository,
                reference_location: "REPO_ISSUES_INDEX",
                reaction_sort: reaction_sort,
                pulls_only: pulls_only,
                hide_checkbox: view.show_mysql_only_mode?
              ) %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if view.show_restricted_pull_results_message? %>
      <div class="p-2">
        <%= render(Primer::Alpha::Banner.new(icon: :info, full: true, test_selector: "pull-requests-search-results-restricted", classes: "border rounded-2 borderColor-accent-muted")) do %>
          Showing the first 10000 pull requests. To view additional pull requests, please refine your search.
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="paginate-container d-none d-sm-flex flex-sm-justify-center">
    <% if !issues.empty? %>
      <%= will_paginate issues, :params => { :q => query } %>
    <% end %>
  </div>

  <div class="paginate-container d-sm-none tmp-mb-5">
    <% if !issues.empty? %>
      <%= will_paginate issues, page_links: false, :params => { :q => query } %>
    <% end %>
  </div>

  <%= render(Issues::TipComponent.new(parsed_issues_query: parsed_issues_query, pulls_only: pulls_only, repo: current_repository)) %>
<% end %>
