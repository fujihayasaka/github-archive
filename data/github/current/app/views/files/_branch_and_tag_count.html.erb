<%= link_to branches_path(repository), class: "Link--secondary no-underline d-block mr-2", role: "listitem" do %>
  <%= render Primer::Beta::Octicon.new(icon: "git-branch", mr: 1) %>
  <% if local_assigns[:branch_count] %>
    <strong class="color-fg-default"><%= number_with_delimiter(branch_count) %></strong>
    <span class="color-fg-muted"><%= "Branch".pluralize(branch_count) %></span>
  <% else %>
    <span class="color-fg-muted">Branches</span>
  <% end %>
<% end %>
<%= link_to tags_path(repository.owner, repository), class: "Link--secondary no-underline d-block mr-2", role: "listitem" do %>
  <%= render Primer::Beta::Octicon.new(icon: "tag", mr: 1) %>
  <% if local_assigns[:tag_count] %>
    <strong class="color-fg-default"><%= number_with_delimiter(tag_count) %></strong>
    <span class="color-fg-muted"><%= "Tag".pluralize(tag_count) %></span>
  <% else %>
    <span class="color-fg-muted">Tags</span>
  <% end %>
<% end %>
