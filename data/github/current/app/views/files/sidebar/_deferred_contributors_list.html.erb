<%= cache sidebar_deferred_contributors_cache_key, skip_digest: true do %>
  <%= render Files::SidebarListComponent.new(
    title: "Contributor",
    href: gh_contributors_path(current_repository),
    max_count: 14,
    count: contributors_count
  ) do |component| %>
    <% if contributors_count == 0 %>
      <div class="text-small color-fg-muted">
        No contributors
      </div>
    <% else %>
      <%= render partial: "files/sidebar/contributors_list", locals: { contributors: top_contributors(limit: component.items_to_show), items_to_show: component.items_to_show } %>
    <% end %>
  <% end %>
<% end %>
