<%= include_cached_fragment(
  cache_key: sidebar_deferred_contributors_cache_key,
  src: contributors_list_path(current_repository: current_repository, deferred: true),
  "aria-busy": "true",
  "aria-label": "Loading contributors") do %>
  <h2 class="h4 tmp-mb-3">
    <%= render Primer::Beta::Link.new(href: gh_contributors_path(current_repository), classes: "Link--primary no-underline", display: :flex, align_items: :center) do %>
      Contributors
    <% end %>
  </h2>

  <ul class="list-style-none d-flex flex-wrap mb-n2">
    <% Array.new(3).each do %>
      <li class="mb-2">
        <div class="Skeleton avatar avatar-user mr-2" style="width:32px;height:32px;"></div>
      </li>
    <% end %>
  </ul>
<% end %>
