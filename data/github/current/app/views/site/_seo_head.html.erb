<% if robots_noindex_and_nofollow? %>
  <%= dont_index_or_follow %>
<% elsif robots_noindex? %>
  <%= dont_index %>
<% elsif seo_canonical_url.present? %>
  <link rel="canonical" href="<%= canonical_url_for(seo_canonical_url, user_defined_locale_enabled? ? I18n.locale.to_s.downcase : "en") %>" data-turbo-transient>
<% end %>
