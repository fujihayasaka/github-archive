<% page_info title: "GitHub Sitemap" %>

<div class="container-xl p-responsive py-6">
  <h1 class="h3-mktg mt-3 mb-9">Sitemap</h1>
  <h2 class="h4-mktg border-bottom pb-2 mb-2">Explore GitHub</h2>
  <div class="d-md-flex gutter-md mb-9">
    <div class="col-md-4">
      <h3 class="f3-mktg mt-5 mb-1"><%= link_to("Create GitHub Account", signup_path(source: "seo-sitelink")) %></h3>
      <h3 class="f3-mktg mt-5 mb-1"><%= link_to("GitHub Login", login_path) %></h3>
      <h3 class="f3-mktg mt-5 mb-1"><%= link_to("GitHub Pricing", pricing_path) %></h3>
      <h3 class="f3-mktg mt-5 mb-1"><%= link_to("What is Git?", git_guides_path) %></h3>
      <%= render "site/sitemap/section",
        heading: link_to("GitHub Teams", team_marketing_page_path),
        links: [
          link_to("Slack Integration", "https://slack.github.com"),
          link_to("CI/CD workflows - GitHub Actions", marketplace_search_path(type: "action")),
          link_to("GitHub Apps", marketplace_search_path(type: "apps")),
        ]
      %>
      <h3 class="f3-mktg mt-5 mb-1"><%= link_to("GitHub for Enterprise", enterprise_marketing_page_path) %></h3>
      <ul class="pl-4">
        <li class="mb-1"><%= link_to("Enterprise Advanced Security", "https://github.com/enterprise/advanced-security") %></li>
        <li class="mb-1"><%= link_to("Enterprise Premium Support", "https://github.com/enterprise/premium-support") %></li>
        <li class="mb-1"><%= link_to("Enterprise Startups", "https://github.com/enterprise/startups") %></li>
      </ul>
      <%= render "site/sitemap/section",
        heading: "GitHub Platform",
        links: [
          link_to("Developer API", "#{GitHub.developer_help_url}/get-started/exploring-integrations/about-building-integrations"),
          link_to("Partners", "https://partner.github.com/"),
          link_to("GitHub CLI", "https://cli.github.com/"),
          link_to("GitHub Desktop", "https://desktop.github.com/"),
          link_to("GitHub Mobile", "https://github.com/mobile"),
        ]
      %>
    </div>

    <div class="col-md-4">
      <h3 class="f3-mktg mt-5 mb-1"><%= link_to("Features", features_path) %></h3>
      <ul class="pl-4">
        <li class="mb-1"><%= link_to("Code Review", features_code_review_path) %></li>
        <li class="mb-1"><%= link_to("Code Search", "https://github.com/features/code-search") %></li>
        <li class="mb-1"><%= link_to("Codespaces", features_codespaces_path) %></li>
        <li class="mb-1">
          <%= link_to("Copilot", features_copilot_path) %>
          <ul class="pl-4 mt-2 mb-3">
            <li class="mb-1"><%= link_to("Copilot Business", "https://github.com/features/copilot/copilot-business") %></li>
            <li class="mb-1"><%= link_to("Copilot Extensions", "https://github.com/features/copilot/extensions") %></li>
            <li class="mb-1"><%= link_to("Copilot Plans", "https://github.com/features/copilot/plans") %></li>
            <li class="mb-1"><%= link_to("Copilot Tutorials", "https://github.com/features/copilot/tutorials") %></li>
            <li class="mb-1"><%= link_to("What's New in Copilot", "https://github.com/features/copilot/whats-new") %></li>
          </ul>
        </li>
        <li class="mb-1"><%= link_to("Discussions", features_discussions_path) %></li>
        <li class="mb-1"><%= link_to("Issues", features_issues_path) %></li>
        <li class="mb-1"><%= link_to("Actions - workflows", features_actions_path) %></li>
        <li class="mb-1">
          <%= link_to("Security", "https://github.com/security/advanced-security") %>
          <ul class="pl-4 mt-2 mb-3">
            <li class="mb-1"><%= link_to("Secure your code", "https://github.com/security/advanced-security/code-security") %></li>
            <li class="mb-1"><%= link_to("Software supply chain", "https://github.com/security/advanced-security/software-supply-chain") %></li>
          </ul>
        </li>
        <li class="mb-1"><%= link_to("Hosting", "https://pages.github.com") %></li>
      </ul>

      <% if GitHub.sponsors_enabled? %>
        <h3 class="f3-mktg mt-5 mb-1"><%= link_to("GitHub Sponsors", sponsors_path) %></h3>
      <% end %>
      <h3 class="f3-mktg mt-5 mb-1"><%= link_to("The ReadME Project", readme_index_path) %></h3>
    </div>

    <div class="col-md-4">
      <%= render "site/sitemap/section",
        heading: "Repositories",
        links: [
          link_to("Collections", "https://github.com/collections"),
          link_to("Topics", "https://github.com/topics"),
          link_to("Trending Repositories", "https://github.com/trending"),
        ]
      %>

      <h3 class="f3-mktg mt-5 mb-1">Resources</h3>
      <ul class="pl-4">
        <li class="mb-1">
          <%= link_to("Articles", "https://github.com/resources/articles") %>
          <ul class="pl-4 mt-2 mb-3">
            <li class="mb-1"><%= link_to("AI Articles", "https://github.com/resources/articles/ai") %></li>
            <li class="mb-1"><%= link_to("DevOps Articles", "https://github.com/resources/articles/devops") %></li>
            <li class="mb-1"><%= link_to("Security Articles", "https://github.com/resources/articles/security") %></li>
            <li class="mb-1"><%= link_to("Software Development Articles", "https://github.com/resources/articles/software-development") %></li>
          </ul>
        </li>
        <li class="mb-1">
          <%= link_to("Whitepapers", "https://github.com/resources/whitepapers") %>
        </li>
      </ul>

      <h3 class="f3-mktg mt-5 mb-1"><%= link_to("Solutions", solutions_path) %></h3>
      <ul class="pl-4">
        <li class="mb-1"><%= link_to("Executive Insights", "https://github.com/solutions/executive-insights") %></li>
        <li class="mb-1">
          <%= link_to("Industry Solutions", "https://github.com/solutions/industry") %>
          <ul class="pl-4 mt-2 mb-3">
            <li class="mb-1"><%= link_to("Financial Solutions", "https://github.com/solutions/industry/financial-services") %></li>
            <li class="mb-1"><%= link_to("Government Solutions", "https://github.com/solutions/industry/government") %></li>
            <li class="mb-1"><%= link_to("Healthcare Solutions", "https://github.com/solutions/industry/healthcare") %></li>
            <li class="mb-1"><%= link_to("Manufacturing Solutions", "https://github.com/solutions/industry/manufacturing") %></li>
            <li class="mb-1"><%= link_to("Nonprofit Solutions", "https://github.com/solutions/industry/nonprofits") %></li>
          </ul>
        </li>
        <li class="mb-1">
          <%= link_to("Use Cases", "https://github.com/solutions/use-case") %>
          <ul class="pl-4 mt-2 mb-3">
            <li class="mb-1"><%= link_to("CI CD Use Cases", "https://github.com/solutions/use-case/ci-cd") %></li>
            <li class="mb-1"><%= link_to("DevOps Use Cases", "https://github.com/solutions/use-case/devops") %></li>
            <li class="mb-1"><%= link_to("DevSecOps Use Cases", "https://github.com/solutions/use-case/devsecops") %></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>

  <h2 class="h4-mktg border-bottom pb-2 mb-2">Additional Resources</h2>

  <div class="d-md-flex flex-wrap gutter-md mb-9">
    <div class="col-md-4">
      <%= render "site/sitemap/section",
        heading: "Support",
        links: [
          link_to("Docs", GitHub.help_url),
          link_to("CodeQL Documentation", "https://codeql.github.com/docs/"),
          link_to("Advisories", "https://github.com/advisories"),
          link_to("Community Discussions", "https://github.com/orgs/community/discussions"),
          link_to("Skills", "https://skills.github.com"),
          link_to("Status", "https://www.githubstatus.com"),
          link_to("Contact GitHub", GitHub.contact_support_url(tags: "dotcom-sitemap")),
          link_to("Newsroom", "https://github.com/newsroom"),
        ]
      %>
    </div>
    <div class="col-md-4">
      <%= render "site/sitemap/section",
        heading: "GitHub",
        links: [
          link_to("About", about_path),
          link_to("Blog", "https://github.blog"),
          link_to("Careers", "https://www.github.careers/careers-home"),
          link_to("Press", about_press_path),
          link_to("Social Impact", "https://github.com/social-impact"),
          link_to("Diversity, Inclusion, and Belonging", about_diversity_path),
          link_to("Shop", "https://thegithubshop.com"),
          link_to("Customer Stories", "https://github.com/customer-stories"),
          link_to("Education", "https://github.com/education"),
          link_to("GitHub Roadmap", "https://github.com/github/roadmap"),
          link_to("FAQs", "https://resources.github.com/faq"),
        ]
      %>
    </div>
    <div class="col-md-4">
      <%= render "site/sitemap/section",
        heading: "Learn",
        links: [
          link_to("Resources", "https://resources.github.com/"),
          link_to("Compare GitHub to DevOps Tools", "https://resources.github.com/devops/tools/compare/"),
          link_to("Learning Pathways", "https://resources.github.com/learn/pathways/"),
          link_to("The State of the Octoverse", "https://octoverse.github.com"),
        ]
      %>
    </div>
  </div>
</div>
