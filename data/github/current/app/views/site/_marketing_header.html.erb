<%# locals: (is_search: false, user_can_create_organizations: false, account_switcher_helper: nil) %>
<% if FeatureFlag.vexi.enabled?(:site_marketing_header_react, current_user, default: false) %>
  <%= render_react_partial name: "marketing-header", props: {
    color_mode: marketing_page? ? "light" : "auto",
  } %>
<% else %>
<%
  is_responsive = responsive?
  tags ||= %W[from:header is_responsive:#{is_responsive}]
  color_theme = marketing_page? ? mktg_color_theme_attributes(mode: "light") : mktg_color_theme_attributes(mode: "auto")

  view = Site::HeaderView.new(
    current_user: current_user,
    current_repository: current_repository,
    current_organization: current_organization,
    current_copilot_user: current_copilot_user_v2,
    params: params
  )
%>

<%= javascript_bundle "sessions" %>

<style>
  /* Override primer focus outline color for marketing header dropdown links for better contrast */
  [data-color-mode="light"] .HeaderMenu-dropdown-link:focus-visible,
  [data-color-mode="light"] .HeaderMenu-trailing-link a:focus-visible {
    outline-color: var(--color-accent-fg);
  }
</style>

<header class="HeaderMktg header-logged-out js-details-container js-header Details f4 tmp-py-3" role="banner" data-is-top="true" <%= color_theme %>>
  <h2 class="sr-only">Navigation Menu</h2>

  <button type="button" class="HeaderMktg-backdrop d-lg-none border-0 position-fixed top-0 left-0 width-full height-full js-details-target" aria-label="Toggle navigation">
    <span class="d-none">Toggle navigation</span>
  </button>

  <div class="d-flex flex-column flex-lg-row flex-items-center tmp-px-3 tmp-px-md-4 tmp-px-lg-5 height-full position-relative z-1">
    <div class="d-flex flex-justify-between flex-items-center width-full width-lg-auto">
      <div class="flex-1">
        <%= render Primer::Beta::Button.new(
          scheme: :link,
          display: [nil, nil, nil, :none],
          classes: "js-details-target js-nav-padding-recalculate js-header-menu-toggle",
          color: :inherit,
          p: 1,
          "aria-label": "Toggle navigation",
          "aria-expanded": "false"
        ) do %>
          <% 3.times do %>
            <div class="HeaderMenu-toggle-bar rounded my-1"></div>
          <% end %>
        <% end %>
      </div>

      <a class="tmp-mr-lg-3 color-fg-inherit flex-order-2 js-prevent-focus-on-mobile-nav"
        href="<%= logged_in? ? "/home" : "/" %>"
        aria-label="Homepage"
        <%= safe_analytics_click_attributes(
          category: "Marketing nav",
          action: "click to go to homepage",
          label: "ref_page:Marketing;ref_cta:Logomark;ref_loc:Header"
        ) %>>
        <%= primer_octicon(:"mark-github", height: 32) %>
      </a>

      <div class="d-flex flex-1 flex-order-2 text-right d-lg-none gap-2 flex-justify-end">
        <% if !logged_in? %>
          <a
            href="<%= site_nav_login_path %>"
            class="HeaderMenu-link HeaderMenu-button d-inline-flex f5 no-underline border color-border-default rounded-2 px-2 py-1 color-fg-inherit js-prevent-focus-on-mobile-nav"
            <%= safe_data_attributes(sign_up_link_data_attributes(location_in_page: "site header menu")) %>
            <%= safe_analytics_click_attributes(
              category: "Marketing nav",
              action: "click to Sign in",
              label: "ref_page:Marketing;ref_cta:Sign in;ref_loc:Header"
            ) %>
          >
            <%= _("Sign in") %>
          </a>
          <% unless marketing_page? %>
            <%= render Site::Header::AppearanceSettingsComponent.new %>
          <% end %>
        <% else %>
          <a href="/"
            class="HeaderMenu-link HeaderMenu-button HeaderMenu-button-muted-outline flex-shrink-0 d-inline-flex d-lg-none no-underline border rounded px-2 py-1 color-fg-inherit js-prevent-focus-on-mobile-nav"
            <%= safe_data_attributes(sign_up_link_data_attributes(location_in_page: "site header menu")) %>
            <%= safe_analytics_click_attributes(
              category: "Dashboard",
              action: "click to go to Dashboard",
              label: "ref_page:#{analytics_location};ref_cta:Dashboard;ref_loc:header logged in"
            ) %>
          >
            <%= _("Dashboard") %>
          </a>
        <% end %>
      </div>
    </div>

    <% if block_given? && content_for?(:header_title) %>
      <div class="d-lg-none css-truncate css-truncate-target width-fit tmp-mt-3 Details-content--shown">
        <%= yield %>
      </div>
    <% end %>

    <div class="HeaderMenu js-header-menu height-fit position-lg-relative d-lg-flex flex-column flex-auto top-0">
      <div class="HeaderMenu-wrapper d-flex flex-column flex-self-start flex-lg-row flex-auto rounded rounded-lg-0">
        <% if show_search_and_nav? %>
          <%= render_react_partial name: "marketing-navigation", props: {
            should_use_dotcom_links: GitHub.enterprise? || GitHub.multi_tenant_enterprise? || GitHub.gist_domain?,
          } %>
        <% end %>

        <div class="d-flex flex-column flex-lg-row width-full flex-justify-end flex-lg-items-center text-center tmp-mt-3 tmp-mt-lg-0 text-lg-left tmp-ml-lg-3">
          <% unless hide_search? || GitHub.private_mode_enabled? %>
            <% if view.use_blackbird_monolith_integration? %>
              <% track_render_partial("site/header/blackbird_search", tags) do %>
                <%= render partial: "site/header/blackbird_search", locals: { view: view, logged_in: false, retain_scroll_position: true } %>
              <% end %>
            <% else %>
              <div class="d-lg-flex min-width-0 tmp-mb-3 tmp-mb-lg-0 tmp-ml-lg-2">
                <%= render partial: "site/header/search" %>
              </div>
            <% end %>
          <% end %>

          <% if logged_in? %>
            <div class="HeaderMenu-button-separator d-none d-lg-block"></div>
            <a href="/"
                class="HeaderMenu-link HeaderMenu-button HeaderMenu-button-muted-outline flex-shrink-0 d-none d-lg-inline-flex no-underline border rounded px-2 py-1 HeaderMenu-link-wrap mr-lg-0"
                <%= safe_data_attributes(sign_up_link_data_attributes(location_in_page: "site header menu")) %>
                <%= safe_analytics_click_attributes(
                  category: "Dashboard",
                  action: "click to go to Dashboard",
                  label: "ref_page:#{analytics_location};ref_cta:Dashboard;ref_loc:header logged in"
                ) %>
            >
                <%= _("Dashboard") %>
            </a>
          <% else %>
            <div class="position-relative HeaderMenu-link-wrap d-lg-inline-block">
              <a
                href="<%= site_nav_login_path %>"
                class="HeaderMenu-link HeaderMenu-link--sign-in HeaderMenu-button flex-shrink-0 no-underline <%= GitHub.signup_enabled? && params["controller"] != "signup" ? "d-none" : "d-block" %> d-lg-inline-flex border border-lg-0 rounded px-2 py-1"
                style="margin-left: 12px;"
                <%= safe_data_attributes(sign_up_link_data_attributes(location_in_page: "site header menu")) %>
                <%= safe_analytics_click_attributes(
                  category: "Marketing nav",
                  action: "click to go to homepage",
                  label: "ref_page:Marketing;ref_cta:Sign in;ref_loc:Header"
                ) %>
              >
                <%= _("Sign in") %>
              </a>
              <% if display_signin_popover? %>
                <% ldap ||= GitHub.auth_mode.to_sym == :ldap %>
                <%= render Primer::Beta::Popover.new(
                  position: :absolute,
                  left: true,
                  right: true,
                  style: "right: -30%; background-color: transparent; border: none",
                  classes: "auth-form-body",
                  display: [:none, :none, :none, :block],
                  **test_selector_data_hash("signin-popover")
                ) do |component| %>
                  <% component.with_heading(color: :default) do %>
                    <%= signin_subtitle(ldap) %>
                  <% end %>
                  <% component.with_body(caret: :top_right, style: "width: 300px", color: :default) do %>
                    <%= render partial: "sessions/password_sign_in_old", locals: {
                      login_field_label: signin_login_field_label(ldap),
                      login_scenario: :logged_out_404,
                      } %>
                  <% end %>
                <% end %>
              <% end %>
            </div>

            <% if GitHub.signup_enabled? && params["controller"] != "signup" %>
              <%
                source_label = current_repository ? "header-repo" : home_page? ? "header-home" : "header"
                source_repo = current_repository.name_with_display_owner if current_repository
                signup_link_params = {
                  source: source_label,
                  source_repo: source_repo,
                  ref_page: analytics_location,
                  ref_cta: "Sign up",
                  ref_loc: "header logged out"
                }
              %>
              <a href="<%= nux_signup_index_path(signup_link_params) %>"
                class="HeaderMenu-link HeaderMenu-link--sign-up HeaderMenu-button flex-shrink-0 d-flex d-lg-inline-flex no-underline border color-border-default rounded px-2 py-1"
                <%= safe_data_attributes(sign_up_link_data_attributes(location_in_page: "site header menu")) %>
                <%= safe_analytics_click_attributes(
                  category: "Sign up",
                  action: "click to sign up for account",
                  label: "ref_page:#{analytics_location};ref_cta:Sign up;ref_loc:header logged out"
                ) %>
              >
                <%= _("Sign up") %>
              </a>
            <% end %>

            <% unless marketing_page? %>
              <%= render Site::Header::AppearanceSettingsComponent.new %>
            <% end %>
          <% end %>
          <button type="button" class="sr-only js-header-menu-focus-trap d-block d-lg-none">Resetting focus</button>
        </div>
      </div>
    </div>
  </div>
</header>
<% end %>
