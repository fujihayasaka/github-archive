<div class="text-left">
  <div class="text-center my-7">
    <h2 class="h2-mktg col-lg-7 mx-auto">Additional add-ons</h2>
  </div>

  <% if feature_enabled_globally_or_for_current_user?(:site_msbuild_launch) %>
    <style>
      .card-container {
        flex-direction: column !important;
      }

      @media (min-width: 768px) {
        .card-container {
          display: grid !important;
          grid-template-columns: 1fr 1fr 1fr;
        }
      }

      .card {
        margin-bottom: 36px !important;
      }

      .card .Label--primary {
        --fgColor-default: var(--label-color-green, #1a7f37);
        --borderColor-neutral-emphasis: var(--label-color-green, #1a7f37);
      }
    </style>

    <%= render Site::HstackComponent.new(classes: "card-container") do %>
      <% [ # Additionally pass render: [feature flag] to hide/show cards
        # Valid colors :accent, :success, :attention, :severe, :danger, :open, :closed, :done, :sponsors, :on_emphasis, :inherit
        {
          header: "GitHub Copilot",
          text: "Get started for free with up to 2,000 completions and 50 chat requests per month.",
          octicon: :copilot,
          color: :done,
          url: "/features/copilot#pricing",
          cta: "Compare plans"
        },
        {
          header: "GitHub Models",
          text: "Bring industry-leading AI into your workflow, securely, scalably, and with full developer control.",
          octicon: "ai-model",
          color: :success,
          url: "/features/models",
          badge: "New",
        },
        {
          header: "GitHub Advanced Security",
          text: "Gain peace of mind with our security, privacy, and responsible AI policies.",
          octicon: "shield-lock",
          color: :accent,
          url: "/security/plans",
        },
        {
          header: "GitHub Codespaces",
          text: "Starting at $0.18 per hour of compute and $0.07 per GB of storage.",
          octicon: :codespaces,
          color: :sponsors,
          url: "/features/codespaces",
        },
        {
          header: "Premium support",
          text: "Get expert help for Enterprise Cloud and Enterprise—any hour your team needs it.",
          octicon: "comment-discussion",
          color: :severe,
          url: "/enterprise/premium-support",
        },
        {
          header: "Git Large File Storage",
          text: "Discover the latest in software development, insights, tutorials, and more.",
          octicon: :archive,
          color: :attention,
          url: "https://docs.github.com/repositories/working-with-files/managing-large-files/about-git-large-file-storage",
        },
      ].each do |card| %>
        <%= render Site::CardComponent.new(
          header: card[:header],
          text: card[:text],
          octicon: card[:octicon],
          color: card[:color],
          badge: card[:badge],
          url: card[:url],
          cta: card[:cta],
          analytics: { category: "Pricing add-ons" },
          classes: "mb-3 col-md-12 pb-0 card",
          render: card[:render].nil? ? true : card[:render]
        ) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render Site::HstackComponent.new do %>
      <% [ # Additionally pass render: [feature flag] to hide/show cards
        {
          header: "GitHub Copilot",
          text: "Get started for free with up to 2,000 completions and 50 chat requests per month.",
          octicon: :copilot,
          url: "/features/copilot#pricing",
          cta: "Compare plans"
        },
        {
          header: "GitHub Codespaces",
          text: "Starting at $0.18 per hour of compute and $0.07 per GB of storage.",
          octicon: :codespaces,
          url: "/features/codespaces",
          color: :done,
        },
        {
          header: "Git Large File Storage",
          text: "$5 per month for 50 GB bandwidth and 50 GB of storage.",
          octicon: :archive,
          color: :attention,
          url: "https://docs.github.com/repositories/working-with-files/managing-large-files/about-git-large-file-storage",
        },
        {
          header: "GitHub Advanced Security",
          text: "Secret Protection $19 per committer/ per month. Code Security $30 per committer/ per month",
          octicon: "shield-lock",
          color: :success,
          url: "/security/plans",
        }
      ].each do |card| %>
        <%= render Site::CardComponent.new(
          header: card[:header],
          text: card[:text],
          octicon: card[:octicon],
          color: card[:color],
          badge: card[:badge],
          url: card[:url],
          cta: card[:cta],
          analytics: { category: "Pricing add-ons" },
          classes: "col-12 col-md-3 mb-3 mb-md-0",
          render: card[:render].nil? ? true : card[:render]
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
