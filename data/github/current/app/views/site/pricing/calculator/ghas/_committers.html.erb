<div class="d-flex flex-column border-bottom border-dashed border-top-0 border-left-0 border-right-0 pb-4">
  <p class="f5-mktg color-fg-muted mb-3">
    Customers pay for unique committers (contributors) that work on Private repositories for which a GitHub Advanced Security product is enabled. Every committer who has contributed to a repository in the last 90 days counts towards the total committer count. Please specify how many committers you expect to be working on your private repositories:
  </p>

  <label for="ghas-code-security-committer-count" class="f5-mktg mb-1">
    <span class="text-bold">Code Security</span>
    <span class="color-fg-muted"><%= Money.new(Site::PricingCalculator.unit_prices[:ghas_code_security][:value], "USD").format %> USD/committer</span>
  </label>
  <%= number_field_tag("ghas-code-security-committer-count", nil, class: "d-block", min: 0, data: {
    target: "ghas-calculator.codeSecurityCommitterCountInput",
    action: "input:ghas-calculator#updateCommitterSeatCost",
  }) %>

  <label for="ghas-secret-protection-committer-count" class="f5-mktg mb-1 mt-3">
    <span class="text-bold">Secret Protection</span>
    <span class="color-fg-muted"><%= Money.new(Site::PricingCalculator.unit_prices[:ghas_secret_protection][:value], "USD").format %> USD/committer</span>
  </label>
  <%= number_field_tag("ghas-secret-protection-committer-count", nil, class: "d-block", min: 0, data: {
    target: "ghas-calculator.secretProtectionCommitterCountInput",
    action: "input:ghas-calculator#updateCommitterSeatCost",
  }) %>
</div>
