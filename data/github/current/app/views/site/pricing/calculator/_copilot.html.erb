<pricing-calculator-section id="copilot">
  <copilot-calculator
    class="d-block rounded-2 box-shadow-card-border-mktg px-4 flex-auto flex-column mb-5 color-bg-default"
    data-targets="pricing-calculator.calculatorSections"
    data-active="false">
    <%= render partial: "site/pricing/calculator/section_header", locals: {
      name: "copilot",
      heading: "GitHub Copilot",
      description: "Your AI pair programmer.",
      icon_name: "copilot",
    } %>

    <div class="calculator-section calculator-section--hidden mt-2" data-target="pricing-calculator-section.sectionContent">
      <div data-target="pricing-calculator-section.sectionInputs" class="calculator-section">
        <div class="mx-1">
          <div class="rounded-2 mb-4">
            <p class="f5-mktg text-bold px-3 pt-3">GitHub Copilot Plans</p>
            <p class="f5-mktg color-fg-muted px-3 mb-3">Select the GitHub Copilot plan that best suits your needs:</p>

            <% ::Site::PricingCalculator::COPILOT_PLANS.each do |plan| %>
              <label class="d-flex flex-row flex-items-start pl-2 pr-3 px-sm-3 py-3 mb-2 rounded-2 calculator-radio-label" data-targets="copilot-calculator.planLabels">
                <%= radio_button_tag(
                  "copilot-plan",
                  plan[:key],
                  false,
                  class: "mt-1 mr-2 position-relative",
                  "data-label": plan[:name],
                  data: {
                    targets: "copilot-calculator.plans",
                    action: "click:copilot-calculator#planUpdated",
                  }
                ) %>
                <div class="d-flex flex-row flex-justify-between flex-1 position-relative">
                  <div class="col-10 col-sm-11 pr-2">
                    <div class="d-block f5-mktg text-bold"><%= plan[:name] %></div>
                    <div class="f5-mktg color-fg-muted"><%= plan[:description] %></div>
                  </div>
                  <div class="col-2 col-sm-1 d-flex flex-column flex-items-end">
                    <span class="f5-mktg text-bold no-wrap"><%= Money.new(plan[:price_cents_usd], "USD").format %> USD</span>
                    <span class="f5-mktg color-fg-muted">/month</span>
                  </div>
                </div>
              </label>
            <% end %>
          </div>

          <div class="d-flex flex-column pb-4">
            <p class="f5-mktg color-fg-muted mb-3">
              How many developers will be using GitHub Copilot:
            </p>
            <label for="copilot-developer-count" class="f5-mktg mb-1">
              <span class="text-bold">Number of developers</span>
              <span class="color-fg-muted" data-target="copilot-calculator.pricePerDeveloperLabel"></span>
            </label>
            <%= number_field_tag(
              "copilot-developer-count",
              nil,
              class: "d-block",
              min: 1,
              data: {
                target: "copilot-calculator.developerCountInput",
                action: "input:copilot-calculator#developerCountChanged keyup:copilot-calculator#developerCountChanged change:copilot-calculator#developerCountChanged",
              }
            ) %>
          </div>
        </div>
      </div>
      <div class="d-flex flex-column rounded-2 color-bg-subtle p-3 mt-1 mb-4">
        <div class="d-flex flex-items-center mb-2">
          <span class="f5-mktg text-bold pr-2 mr-auto">Cost per month</span>
          <span class="f5-mktg text-bold text-right" data-target="copilot-calculator.costPerMonthDisplay">$0.00</span>
          <span class="f5-mktg text-bold ml-1">USD</span>
        </div>
      </div>
    </div>
    <%= render partial: "site/pricing/calculator/more_info", locals: {
      link_name: "GitHub Copilot",
      docs_href: "https://docs.github.com/copilot",
    } %>
  </copilot-calculator>
</pricing-calculator-section>
