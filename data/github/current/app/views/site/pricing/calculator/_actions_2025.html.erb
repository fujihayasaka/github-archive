<pricing-calculator-section id="actions">
  <actions-calculator  class="d-block rounded-2 box-shadow-card-border-mktg px-4 flex-auto flex-column mb-5 color-bg-default" data-targets="pricing-calculator.calculatorSections">
    <%= render partial: "site/pricing/calculator/section_header", locals: {
      name: "actions",
      heading: "GitHub Actions",
      description: "Automate your workflow from idea to production.",
      icon_name: "play",
    } %>

    <div class="calculator-section calculator-section--hidden mt-2" data-target="pricing-calculator-section.sectionContent">
      <div data-target="pricing-calculator-section.sectionInputs" class="calculator-section">
        <div class="border rounded-2 p-3 mb-2">
          <p class="f5-mktg color-fg-muted mb-3">For GitHub-hosted runners, pricing takes effect January 1, 2026.</p>

          <%# OS types %>
          <div data-target="actions-calculator.osTypesContainer" class="mt-2">
            <%= render partial: "site/pricing/calculator/actions_2025/os", locals: {
              calculator: "actions",
              data_targets: "actions-calculator.osTypes",
              data_action: "change:actions-calculator#osTypeChanged",
            } %>
          </div>

          <%# Runner types %>
          <div data-target="actions-calculator.runnerTypesContainer" class="mt-4">
            <%= render partial: "site/pricing/calculator/actions_2025/runner_type", locals: {
              heading: "Select the hardware",
              calculator: "actions",
              data_targets: "actions-calculator.runnerTypes",
              data_action: "change:actions-calculator#runnerTypeChanged",
            } %>
          </div>

          <%# Core sizes %>
          <div data-target="actions-calculator.coreSizesContainer" class="mt-4">
            <%= render partial: "site/pricing/calculator/actions_2025/core_size", locals: {
              heading: "Select a core size",
              calculator: "actions",
              data_targets: "actions-calculator.coreSizes",
              data_action: "change:actions-calculator#coreSizesChanged",
            } %>
          </div>

          <%# Inputs %>
          <div data-target="actions-calculator.inputsContainer" class="mt-4">
            <label class="d-block f4-mktg text-semibold mb-2" for="actions-jobs-duration">Enter total minutes per month</label>

            <%= render partial: "site/pricing/calculator/unit_input", locals: {
              name: "actions-jobs-duration",
              unit: "minutes",
              options: {
                placeholder: "E.g 10,000",
                data: {
                  target: "actions-calculator.jobDurationInput",
                  action: "input:actions-calculator#validateInputs",
                }
              }
            } %>

            <div class="f5-mktg color-fg-muted mt-2">
              Total minutes used across all GitHub Actions workflows
            </div>

            <%# Add button %>
            <button
              type="button"
              data-target="actions-calculator.addRunnerButton"
              data-action="click:actions-calculator#addRunnerButtonClicked"
              class="col-12 py-2 mt-4 mb-2 btn-mktg"
              disabled
            >
              <span class="f5-mktg text-semibold">Calculate runner cost</span>
            </button>
          </div>
        </div>

        <%# Runners list %>
        <div hidden data-target="actions-calculator.runnersContainer" class="mt-4">
          <div class="d-flex flex-column">
            <h4 class="d-block f5-mktg text-bold mb-2">Your Actions runners</h4>
            <div class="calculator-runners-list rounded-2 overflow-auto" data-target="actions-calculator.runnersList"></div>

            <template data-target="actions-calculator.runnerTemplate">
              <action-runner class="calculator-runners-list-item d-flex flex-justify-between flex-items-baseline color-bg-subtle p-3 anim-fade-in fast" data-targets="actions-calculator.runners">
                <button class="border-0 color-fg-subtle color-bg-subtle lh-condensed-ultra p-0 mr-2" type="button" data-action="click:action-runner#removeSelf">
                  <%= render(Primer::Beta::Octicon.new(:x, size: :small, classes: "v-align-top")) %>
                </button>

                <div class="flex-1">
                  <span data-target="action-runner.runnerDisplay" class="f5-mktg text-bold"></span>

                  <span class="f5-mktg color-fg-muted px-1">·</span>

                  <span class="f5-mktg color-fg-muted no-wrap">
                    <span data-target="action-runner.jobDurationDisplay"></span>
                    <span>min / month</span>
                  </span>
                </div>

                <div class="text-right ml-3">
                  <span data-target="action-runner.costDisplay" class="text-bold"></span> <span class="text-bold">USD</span>
                </div>
              </action-runner>
            </template>
          </div>
        </div>
      </div>

      <%# Total %>
      <div class="d-flex flex-column rounded-2 color-bg-subtle p-3 my-4">
        <div class="d-flex flex-items-center">
          <span class="f5-mktg text-bold pr-2 mr-auto">Cost per month</span>
          <span class="f5-mktg text-bold text-right" data-target="actions-calculator.costPerMonthDisplay"><%= Money.new(0, "USD").format %></span>
          <span class="f5-mktg text-bold ml-1">USD</span>
        </div>
      </div>
    </div>

    <%= render partial: "site/pricing/calculator/more_info", locals: {
      link_name: "Actions",
      docs_href: "https://docs.github.com/actions",
    } %>
  </actions-calculator>
</pricing-calculator-section>
