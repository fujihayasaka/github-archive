<pricing-calculator-section id="pro">
  <pro-calculator class="d-block rounded-2 box-shadow-card-border-mktg px-4 flex-auto flex-column mb-5 color-bg-default" data-targets="pricing-calculator.calculatorSections">
    <%= render partial: "site/pricing/calculator/section_header", locals: {
        name: "pro",
        heading: "GitHub Pro",
        description: "Advanced tools in private repos for an individual.",
        icon_name: "person",
    } %>

    <div class="calculator-section calculator-section--hidden mt-2" data-target="pricing-calculator-section.sectionContent">
      <div data-target="pricing-calculator-section.sectionInputs" class="calculator-section">
        <div class="mx-1 border rounded-2 p-3 mb-2">
          <p class="f5-mktg color-fg-muted m-0">Get advanced tools and insights for private repositories, plus expanded access to build, test, and ship faster.</p>
        </div>
      </div>

      <div class="d-flex flex-column rounded-2 color-bg-subtle p-3 mt-1 mb-4">
        <div class="d-flex flex-items-center">
          <span class="f5-mktg text-bold pr-2 mr-auto">Cost per month</span>
          <span class="f5-mktg text-right text-bold" data-target="pro-calculator.subtotalElement"><%= Money.new(0, "USD").format %></span>
          <span class="f5-mktg text-bold ml-1">USD</span>
        </div>
      </div>
    </div>
    <%= render partial: "site/pricing/calculator/more_info", locals: {
      link_name: "GitHub Pro",
      docs_href: "https://docs.github.com/get-started/learning-about-github/githubs-plans#github-pro",
    } %>
  </pro-calculator>
</pricing-calculator-section>
