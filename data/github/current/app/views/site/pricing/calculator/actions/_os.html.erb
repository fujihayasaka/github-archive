<div class="d-flex flex-column">
  <p class="f4-mktg text-semibold">Select an operating system</p>
  <p class="color-fg-muted">GitHub-hosted runners are based on Ubuntu Linux, Windows Server/Desktop, and macOS. Each job in a workflow runs on its own dedicated machine.</p>

  <div class="d-flex flex-row flex-wrap gap-3">
    <% Site::PricingCalculator::OPERATING_SYSTEMS.each_with_index do |os, index| %>
      <label class="d-inline-flex">
        <%= radio_button_tag("#{calculator}-os", os[:key], index == 0, class: "mr-2", "data-label": os[:label], data: {
          targets: local_assigns[:data_targets],
          action: local_assigns[:data_action],
        })%>

        <div>
          <span class="text-semibold"><%= os[:label] %></span>
        </div>
      </label>
    <% end %>
  </div>
</div>
