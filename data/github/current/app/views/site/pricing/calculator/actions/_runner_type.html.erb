<div class="d-flex flex-column">
  <p class="f4-mktg text-semibold">
    <%= heading %>
  </p>

  <div class="d-flex flex-row flex-wrap gap-3">
    <% Site::PricingCalculator::RUNNER_TYPES.each_with_index do |runner_type, index| %>
      <label class="d-inline-flex" data-runner-type="<%= runner_type[:key] %>">
        <%= radio_button_tag("#{calculator}-runner-type", runner_type[:key], index == 0, class: "mr-2", "data-label": runner_type[:label], data: {
          targets: local_assigns[:data_targets],
          action: local_assigns[:data_action],
        }) %>

        <div>
          <span class="text-semibold"><%= runner_type[:label] %></span>
        </div>
      </label>
    <% end %>
  </div>
</div>
