<div class="d-flex flex-column">
  <p class="f4-mktg text-semibold">
    <%= heading %>
  </p>

  <div class="d-flex flex-row mb-1">
    <span class="flex-1 f5-mktg text-semibold color-fg-muted">Name</span>
    <span class="flex-1 f5-mktg text-semibold color-fg-muted">Price / min</span>
  </div>

  <%# Linux x64 %>
  <%= render "site/pricing/calculator/actions_2025/core_size_list",
    core_sizes: Site::PricingCalculator::CORE_SIZES_LINUX_X64_2025,
    os: "action_runners_linux",
    runner_type: "action_runners_x64",
    calculator: calculator,
    data_targets: local_assigns[:data_targets],
    data_action: local_assigns[:data_action] %>

  <%# Linux ARM64 %>
  <%= render "site/pricing/calculator/actions_2025/core_size_list",
    core_sizes: Site::PricingCalculator::CORE_SIZES_LINUX_ARM64_2025,
    os: "action_runners_linux",
    runner_type: "action_runners_arm64",
    calculator: calculator,
    data_targets: local_assigns[:data_targets],
    data_action: local_assigns[:data_action] %>

  <%# Linux GPU %>
  <%= render "site/pricing/calculator/actions_2025/core_size_list",
    core_sizes: Site::PricingCalculator::CORE_SIZES_LINUX_GPU_2025,
    os: "action_runners_linux",
    runner_type: "action_runners_gpu",
    calculator: calculator,
    data_targets: local_assigns[:data_targets],
    data_action: local_assigns[:data_action] %>

  <%# Windows x64 %>
  <%= render "site/pricing/calculator/actions_2025/core_size_list",
    core_sizes: Site::PricingCalculator::CORE_SIZES_WINDOWS_X64_2025,
    os: "action_runners_windows",
    runner_type: "action_runners_x64",
    calculator: calculator,
    data_targets: local_assigns[:data_targets],
    data_action: local_assigns[:data_action] %>

  <%# Windows ARM64 %>
  <%= render "site/pricing/calculator/actions_2025/core_size_list",
    core_sizes: Site::PricingCalculator::CORE_SIZES_WINDOWS_ARM64_2025,
    os: "action_runners_windows",
    runner_type: "action_runners_arm64",
    calculator: calculator,
    data_targets: local_assigns[:data_targets],
    data_action: local_assigns[:data_action] %>

  <%# Windows GPU %>
  <%= render "site/pricing/calculator/actions_2025/core_size_list",
    core_sizes: Site::PricingCalculator::CORE_SIZES_WINDOWS_GPU_2025,
    os: "action_runners_windows",
    runner_type: "action_runners_gpu",
    calculator: calculator,
    data_targets: local_assigns[:data_targets],
    data_action: local_assigns[:data_action] %>

  <%# macOS x64 %>
  <%= render "site/pricing/calculator/actions_2025/core_size_list",
    core_sizes: Site::PricingCalculator::CORE_SIZES_MACOS_X64_2025,
    os: "action_runners_macos",
    runner_type: "action_runners_x64",
    calculator: calculator,
    data_targets: local_assigns[:data_targets],
    data_action: local_assigns[:data_action] %>

  <%# macOS ARM64 %>
  <%= render "site/pricing/calculator/actions_2025/core_size_list",
    core_sizes: Site::PricingCalculator::CORE_SIZES_MACOS_ARM64_2025,
    os: "action_runners_macos",
    runner_type: "action_runners_arm64",
    calculator: calculator,
    data_targets: local_assigns[:data_targets],
    data_action: local_assigns[:data_action] %>
</div>
