<div data-os="<%= os %>" data-runner-type="<%= runner_type %>" hidden>
  <% core_sizes.each do |core_size| %>
    <label class="d-flex flex-row">
      <div class="flex-1 d-inline-flex flex-items-center">
        <%= radio_button_tag("#{calculator}-core-size-#{os}-#{runner_type}", core_size[:key], false, class: "mr-2", "data-label": core_size[:label], "data-runner": core_size[:runner], data: {
          targets: local_assigns[:data_targets],
          action: local_assigns[:data_action],
        })%>
        <span class="mr-2 text-semibold"><%= core_size[:label] %></span>
      </div>

      <span class="flex-1 f6-mktg color-fg-muted text-mono">$<%= sprintf("%.3f", core_size[:price_cents_usd_per_min] / 100.0) %> USD / min</span>
    </label>
  <% end %>
</div>
