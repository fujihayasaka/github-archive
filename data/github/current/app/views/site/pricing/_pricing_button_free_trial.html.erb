<% if !logged_in? || !emu? %>
  <% if local_assigns[:context] == "pricing" %>
    <% with_param = local_assigns[:with_param] %>
    <% ghec_trial_url = if local_assigns[:move_work]
        trial_params = organization_referral_params(additional_params: {
          plan: GitHub::Plan.business_plus,
          move_work: true,
          ref_page: "/move_work/organization/plans",
          ref_cta: url_encode("Start a free trial"),
          ref_loc: "card",
        })
        trial_params[:with] = with_param if with_param.present?
        new_organization_path(trial_params)
      else
        enterprise_params = {
          "ref_page": "pricing",
          "ref_cta": url_encode("Start a free trial"),
          "ref_loc": "card"
        }
        enterprise_params[:with] = with_param if with_param.present?
        org_enterprise_plan_path(enterprise_params)
       end
    %>
    <%= link_to(
      "Start a free trial",
      ghec_trial_url,
      class: "#{classes} btn-free-trial px-2",
      data: analytics_click_attributes(
        category: "start_a_free_trial",
        action: "click_to_set_up_enterprise_trial",
        label: "ref_page:#{request.fullpath};ref_cta:start_a_free_trial;ref_loc:pricing"
      )
    ) %>
  <% end %>
<% end %>
