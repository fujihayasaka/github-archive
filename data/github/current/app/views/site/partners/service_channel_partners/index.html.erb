<% content_for :partners_content do %>
  <%= render template: "site/partners/templates/hero", locals: {
  header:         "Services and Channel Partners",
  text:           "Customers depend on you to help them navigate their unique business challenges. GitHub is here to help you grow your capabilities to grow with your customers. Expand your team's expertise and take advantage of go-to-market programs as an official GitHub Partner.",
  role:           'service',
  button_text:    "Apply to be a Services and Channel Partners",
  button_link:    "https://portal.github.partners/#/page/become-a-partner",
  additional_buttons: [
    {
      text:  "Services and Channel Partner Directory",
      link:  "https://portal.github.partners/#/page/directory",
      class: "btn-mktg ml-3"
    }
  ],
  showConfetti:   "false"
} %>

  <div class="position-relative overflow-hidden">

    <img alt="background lines graphic" src="<%= image_path '/static/images/modules/site/technology-partners/images/patterns/lines-left.svg' %>" class="position-absolute" style="top: -75px; left: 0; z-index: 0">
    <img alt="background lines graphic" src="<%= image_path '/static/images/modules/site/technology-partners/images/patterns/lines-right.svg' %>" class="position-absolute d-none d-sm-block" style="top: -70px; right: 0; z-index: 0">

      <div class="container-xl pt-8 pt-lg-9 position-relative pb-12" style="z-index: 1">
        <h2 class="h0-mktg text-center mx-auto col-12 col-sm-9 col-lg-12 lh-condensed">Two tracks to grow your&nbsp;business</h2>

        <div class="d-flex flex-wrap flex-md-nowrap">
          <div class="col-md-6 col-12 text-center background-white color-shadow-large pb-7 pl-3 pl-md-7 pr-3 pr-md-7 mx-3 rounded-2 mt-8">
            <h2 class="h0-mktg text-bold  mt-6">Services Partners</h2>
            <p class="f3 mt-3">You're already helping customers implement changes to their software development process, culture, and so much more. Help teams unlock more of their potential as a Services Partner.</p>
          </div>
          <div class="col-md-6 col-12 text-center background-white color-shadow-large pb-7 pl-3 pl-md-7 pr-3 pr-md-7 mx-3 rounded-2 mt-8">
            <h2 class="h0-mktg text-bold  mt-6">Channel Partners</h2>
            <p class="f3 mt-3">Whether you're selling customized solutions or reducing the complexity of software license management, help your customers access tools their developers love as a Channel Partner.</p>
          </div>
        </div>
      </div>
  </div>
<% end %>

<%= render template: "site/partners/templates/layout_wrapper" %>

