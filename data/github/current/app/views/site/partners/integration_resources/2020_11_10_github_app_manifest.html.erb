<%
  post_title = "Creating a GitHub App from a manifest"
  post_date = "2020-11-10"
  post_categories = ["Integration-Resources"]
  post_tags = ["GitHub_Enterprise", "API", "OAuth", "Rate_Limiting"]
  post_type = "Documentation"
  post_featured_image = nil
  post_preview = "A GitHub App Manifest is a preconfigured GitHub App you can share with anyone who wants to use your app in their personal repositories."
  post_priority = 2
  post_sections = ["resources"]
  post_video_url = nil
  post_video_title = nil

  post_content = <<-HTML
    <p>A GitHub App Manifest is a preconfigured GitHub App you can share with anyone who wants to use your app in their personal repositories. The manifest flow allows someone to quickly create, install, and start extending a GitHub App without needing to register the app or connect the registration to the hosted app code.</p>
    <p><strong>Documentation:</strong> <a href="https://docs.github.com/en/free-pro-team@latest/developers/apps/creating-a-github-app-from-a-manifest" class="text-underline">Creating a GitHub App from a manifest</a></p>
  HTML
%>

<% content_for :partners_content do %>
  <%= render template: "site/partners/templates/post_content", locals: {
    post_title: post_title,
    post_date: post_date,
    post_categories: post_categories,
    post_tags: post_tags,
    post_type: post_type,
    post_featured_image: post_featured_image,
    post_preview: post_preview,
    post_priority: post_priority,
    post_sections: post_sections,
    post_video_url: post_video_url,
    post_video_title: post_video_title,
    post_content: post_content
  } %>
<% end %>

