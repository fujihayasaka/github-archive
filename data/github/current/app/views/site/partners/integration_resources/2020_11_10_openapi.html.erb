  post_preview = "This repository contains OpenAPI descriptions for GitHub's REST API."
  post_priority = 2
  post_sections = ["resources"]
  post_video_url = nil
  post_video_title = nil

  post_content = <<-HTML
    <p>This repository contains OpenAPI descriptions for GitHub's REST API.</p>
    <p><strong>Repo:</strong> <a href="https://github.com/github/rest-api-description" class="text-underline">GitHub's REST API OpenAPI Description</a></p>
