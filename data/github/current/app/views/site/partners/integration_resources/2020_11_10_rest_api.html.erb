<%
  post_title = "REST API"
  post_date = "2020-11-10"
  post_categories = ["Integration-Resources"]
  post_tags = ["REST_API", "API"]
  post_type = "Documentation"
  post_featured_image = nil
  post_preview = "Learn about resources, libraries, previews and troubleshooting for GitHub's REST API."
  post_priority = 2
  post_sections = ["resources"]
  post_video_url = nil
  post_video_title = nil

  post_content = <<-HTML
    <p>Learn about resources, libraries, previews and troubleshooting for GitHub's REST API.</p>
    <p><strong>Documentation:</strong> <a href="https://docs.github.com/en/free-pro-team@latest/rest" class="text-underline">GitHub REST API</a></p>
  HTML
%>

<% content_for :partners_content do %>
  <%= render template: "site/partners/templates/post_content", locals: {
    post_title: post_title,
    post_date: post_date,
    post_categories: post_categories,
    post_tags: post_tags,
    post_type: post_type,
    post_featured_image: post_featured_image,
    post_preview: post_preview,
    post_priority: post_priority,
    post_sections: post_sections,
    post_video_url: post_video_url,
    post_video_title: post_video_title,
    post_content: post_content
  } %>
<% end %>

<%= render template: "site/partners/templates/layout_wrapper" %>
