<% content_for :partners_content do %>
  <% view_mode = params[:view] == "stack" ? "stack" : "list" %>

  <%= render template: "site/partners/templates/hero", locals: {
        header:             page_title,
        text:               hero_text,
        role:               "resources",
        button_text:        nil,
        additional_buttons: nil,
        showConfetti:       false
      } %>

  <div class="container-xl clearfix pl-4 pr-4 pt-0">
    <p class="f4 mb-3">
      If in doubt, let the open source
      <a href="https://docs.github.com" class="text-underline">GitHub Documentation</a>
      be your guide!
    </p>

    <%# Bookmarks panel %>
    <div class="markdown-body">
      <h2>Bookmarks</h2>
      <ul class="bookmarks-list">
        <li class="bookmarks-item"><a href="https://github.blog/changelog/" class="text-underline">Product Changelog</a></li>
        <li class="bookmarks-item"><a href="https://www.githubstatus.com/" class="text-underline">Status</a></li>
        <li class="bookmarks-item"><a href="https://resources.github.com/" class="text-underline">Resources</a></li>
        <li class="bookmarks-item"><a href="https://docs.github.com/" class="text-underline">Docs</a></li>
        <li class="bookmarks-item"><a href="https://github.blog/" class="text-underline">Blog</a></li>
        <li class="bookmarks-item"><a href="https://support.github.com/" class="text-underline">Support</a></li>
        <li class="bookmarks-item"><a href="https://github.com/orgs/github/projects/4247/views/1" class="text-underline">Public Roadmap</a></li>
        <li class="bookmarks-item"><a href="https://event-sponsorship.github.com/" class="text-underline">Event Sponsorship</a></li>
        <li class="bookmarks-item"><a href="https://docs.github.com/en/developers/overview/secret-scanning-partner-program#joining-the-secret-scanning-program-on-github" class="text-underline">Secret Scanning</a></li>
        <li class="bookmarks-item"><a href="https://resources.github.com/security/integrating-github-advanced-security-with-third-party-platforms" class="text-underline">GHAS Third Party Reporting</a></li>
      </ul>
    </div>

    <hr>

    <div class="clearfix">
      <%# Sidebar filters %>
      <div class="col-md-4 float-left pr-4 pl-0 pt-4 clearfix filter--container position-sticky top-10">
        <div class="col-12 d-flex flex-justify-between flex-items-baseline">
          <h2 class="h2">Filters</h2>
          <div class="filter--results">
            <p><%= posts.size %> results</p>
          </div>
          <div class="filter--clear-link">
            <%= render Primer::Beta::Button.new(scheme: :secondary, classes: "clear-filters") do %>
              Clear all
            <% end %>
          </div>
        </div>

        <%# List/Stack toggle %>
        <div class="mb-4 text-right">
          <%= render Primer::Beta::Button.new(
                scheme:  :secondary,
                as:      :a,
                href:    url_for(only_path: true, view: "list"),
                classes: ["btn-link", "btn-sm", "btn-list", "list", ("active" if view_mode == "list")].compact.join(" ")
              ) do %>
            List
          <% end %>
          <%= render Primer::Beta::Button.new(
                scheme:  :secondary,
                as:      :a,
                href:    url_for(only_path: true, view: "stack"),
                classes: ["btn-link", "btn-sm", "btn-list", "stack", ("active" if view_mode == "stack")].compact.join(" ")
              ) do %>
            Stack
          <% end %>
        </div>

        <%# Category filters %>
        <div>
          <% categories.each do |category| %>
            <div class="filter--category <%= "is-active" if category==categories.first %>">
              <div class="filter--category-label">
                <%= category=="Integration-Resources" ? category.tr("-", " ") : category %>
                <%= render Primer::Beta::Octicon.new(:"chevron-up",   size: :xsmall, classes: "dropdown-chevron-up") %>
                <%= render Primer::Beta::Octicon.new(:"chevron-down", size: :xsmall, classes: "dropdown-chevron-down") %>
              </div>
              <% (category_tags_map[category]||[]).each do |tag| %>
                <% next if tag.blank? %>
                <label class="filter--input">
                  <input type="checkbox" value="<%= tag %>" <%= category.downcase %>>
                  <span class="filter--input-label"><%= tag.tr('_', ' ') %></span>
                </label>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Main content: list of posts %>
      <div class="col-md-8 float-left pl-md-4 pt-4 clearfix gutter-condensed">
        <%
          sorted_posts    = posts.sort_by    { |p| p[:priority] || 999 }
          resources_posts = sorted_posts.select { |p| p[:sections].include?("resources") }
        %>

        <% if resources_posts.any? %>
          <% resources_posts.each do |post| %>
            <%= render template: "site/partners/templates/post",
                       locals:   { post: post, stack: (view_mode=="stack") } %>
          <% end %>
        <% else %>
          <div class="blankslate blankslate-narrow">
            <h3 class="mb-1">No resources found in the resources section.</h3>
            <p>Make sure your post files have "resources" in their sections array.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%= render template: "site/partners/templates/layout_wrapper" %>
