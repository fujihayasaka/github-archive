<% content_for :partners_content do %>
  <!-- Hero Section -->
  <%= render template: "site/partners/templates/hero", locals: {
    header: "Build with GitHub",
    text: "No two customers are built the same. That's why we help our Technology Partners extend GitHub in ways unique to them. Regardless of industry, use case, or implementation, we work with partners to help them achieve their goals.",
    role: 'technology',
    button_text: "Apply to be a Technology Partner",
    button_link: "/partners/apply?partnershipType=Technology+Partner",
    additional_buttons: nil,
    showConfetti: "false"
  } %>
  <div class="position-relative overflow-hidden">

    <img alt='graphic with lines' src="<%= image_path '/static/images/modules/site/technology-partners/images/patterns/lines-left.svg' %>" class="position-absolute" style="top: -75px; left: 0; z-index: 0">
    <img alt='graphic with lines' src="<%= image_path '/static/images/modules/site/technology-partners/images/patterns/lines-right.svg' %>" class="position-absolute d-none d-sm-block" style="top: -70px; right: 0; z-index: 0">
    <div class="container-xl pt-lg-5 position-relative" style="z-index: 1">
      <div class="d-flex flex-wrap flex-md-nowrap flex-justify-center">
        <div class="col-md-6 col-12 text-center background-white color-shadow-large pb-7 pl-3 pl-md-7 pr-3 pr-md-7 mx-3 rounded-2">
          <div class="d-flex flex-column flex-justify-between height-full">
            <h2 class="h0-mktg text-bold  lh-condensed mt-4">Partner showcase</h2>
            <p class="f3 mt-3 px-3">Organizations and developers all over the world use GitHub Copilot to code faster, drive impact, and focus on doing what matters most: building great software.</p>
            <div>
              <a class="btn-mktg f4 mt-5" href="/partners/partnerships">Explore Partner Solutions</a>
            </div>
          </div>
        </div>
      </div>
      <!-- What We Offer Section -->
      <div class="text-center mt-7 pt-4 col-12 col-md-6 mx-auto">
        <h2 class="h0-mktg text-bold ">What we offer</h2>
      </div>
      <div class="text-left d-flex flex-wrap flex-md-nowrap flex-justify-center mt-6">
        <div class="col-12 col-md-4 m-6 text-center">
          <h2 class="h2-mktg text-bold mb-2 ">Marketplace</h2>
          <p class="f4 px-4">Create and distribute apps and actions on the <a href="https://github.com/marketplace" class="text-bold text-underline">GitHub Marketplace</a>, extending your workflow capabilities.</p>
        </div>
        <div class="col-12 col-md-4 m-6 text-center">
          <h2 class="h2-mktg text-bold mb-2 ">AI</h2>
          <p class="f4 px-4">Learn more about how to <a href="https://resources.github.com/learn/pathways/copilot/extensions/essentials-of-github-copilot-extensions/" target="_blank" class="text-bold text-underline">integrate AI</a> into your development process.</p>
        </div>
        <div class="col-12 col-md-4 m-6 text-center">
          <h2 class="h2-mktg text-bold mb-2 ">GitHub Advanced Security</h2>
          <p class="f4 px-4">Leverage the <a href="https://resources.github.com/learn/pathways/security/" class="text-bold text-underline">secret scanning program</a> and integrate with vulnerability management and SIEM platforms.</p>
        </div>
        <div class="col-12 col-md-4 m-6 text-center">
          <h2 class="h2-mktg text-bold mb-2 ">Platform</h2>
          <p class="f4 px-4">Utilize GitHub's <a href="https://github.blog/news-insights/product-news/arm64-on-github-actions-powering-faster-more-efficient-build-systems/" class="text-bold text-underline">hosted runners</a> and <a href ="https://github.blog/developer-skills/github/unleashing-github-codespaces-templates-to-ignite-your-development/" class="text-bold text-underline">Codespaces</a> for streamlined development and deployment.</p>
        </div>
      </div>
      <!-- Benefits Section -->
      <div class="mt-7 col-11 col-md-6 mx-auto text-center">
        <h2 class="h0-mktg text-bold  mb-6">Benefits</h2>
      </div>
      <div class="position-relative pb-6">
        <div class="dot-bg-big-gray position-absolute d-none d-md-block" style="height: 300px; width: 300px; top: 40px; right: 4vw; z-index: -1;"></div>
        <div class="d-flex flex-row flex-wrap mx-auto benefits-table">
          <h4 class="text-center width-full mb-2 show-mobile">Benefits of becoming a technology partner</h4>
          <div class="d-flex width-full f4">
            <div class="feature-table-column1 sm feature-table-header1 dot-bg-small-gray hidden-mobile"></div>
            <div class="feature-table-column2 col-sm-6 feature-table-header-text py-3 border-bottom benefits-column">
              <span class="d-block">Technical support</span>
            </div>
            <div class="feature-table-column4 feature-table-header-text p-3 border-bottom">
              <span class="d-block">Future opportunities</span>
            </div>
          </div>
          <!-- Benefits Table Row -->
          <div class="d-flex width-full">
            <div class="p-3 feature-table-column1 sm text-bold pl-3 pr-4 rounded-left-1 hidden-mobile">Benefits of becoming a technology partner</div>
            <div class="p-3 feature-table-column2 text-left benefits-column">
              <ul class="pl-2">
                <li>Access to 5 GHES development licenses.</li>
                <li>Business development support with the <a href="mailto:partnerships@github.com" class="text-bold text-underline">partnerships team</a>.</li>
                <li>Direct technical support for integration issues.</li>
              </ul>
            </div>
            <div class="p-3 feature-table-column4">
              <ul>
                <li>Early access to GitHub Universe/Galaxy events as a sponsor.</li>
                <li>Special consideration for speaking roles at GitHub Universe/Galaxy events.</li>
                <li>Access to GitHub Technology Partner Repos.</li>
                <li>Higher visibility and promotion on the GitHub Marketplace and the GitHub Technology Partners' newsfeed and blog pages.</li>
                <li>Promotion at all partner events where GitHub is a sponsor or speaker.</li>
                <li>Participation in GitHub "partnerships" webinars.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Terms Link -->
  <div class="flex-justify-center d-flex my-6">
    <a href="/partners/technology-partners-terms" class="Bump-link no-underline f4 text-bold text-underline">GITHUB TECHNOLOGY PARTNER PROGRAM TERMS AND CONDITIONS<span class="Bump-link-symbol">→</span></a>
  </div>
  <div id="form-signUp" class="mt-9 mt-12">
    <div class="form-signUp-container position-relative mx-auto pb-12">
      <h2 class="h0-mktg text-center form-signUp-header text-bold pt-11">Become a GitHub Technology Partner today</h2>
      <p class="f3-light mt-2 text-center form-signUp-subheader mb-7">Tell us about your business to&nbsp;apply.</p>
      <div class="px-3 p-md-0">
        <div class="bg-transparent rounded-2  f4 form-signUp mx-auto text-center">
          <div class="flex-wrap">
            <a href="/partners/apply?partnershipType=Technology+Partner" class="btn-mktg f4 mx-2" type="submit">Apply now</a>
            <a href="/partners/partnerships" class="btn-mktg background-white f4 mx-2" type="submit">Explore Partner Solutions</a>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
<%= render template: "site/partners/templates/layout_wrapper" %>
