<div class="text-center py-8 position-relative overflow-hidden">
  <div class="container-xl position-relative <%= 'pb-5' unless defined?(text) && text.present? %>" style="z-index: 1">
    <h1 class="h0-mktg text-bold mb-3"><%= header if defined?(header) %></h1>
    <% if defined?(text) && text.present? %>
      <p class="col-11 col-md-7 px-4 mx-auto f3"><%= text %></p>
    <% end %>
    <% if defined?(button_text) && button_text.present? %>
    <div class="text-center width-full mt-7">
      <% if defined?(button_link) && button_link.present? %>
        <a href="<%= button_link %>" class="btn-mktg f4 d-inline-block mb-3 mb-md-0"><%= button_text %></a>
      <% else %>
        <a href="#form-signUp" class="js-smoothscroll-anchor btn-mktg f4 d-inline-block mb-3 mb-md-0"><%= button_text %></a>
      <% end %>
      <% if defined?(additional_buttons) && additional_buttons.present? %>
        <% additional_buttons.each do |button| %>
          <a href="<%= button[:link] %>" class="btn-mktg f4 d-inline-block mb-3 mb-md-0 <%= button[:class] %>"><%= button[:text] %></a>
        <% end %>
      <% end %>
    </div>
    <% end %>
  </div>
</div>
