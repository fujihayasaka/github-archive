<a href="/partners/resources" class="d-block mb-4">See all Resources</a>

<header class="d-block mb-6">
  <h1 class="my-2 f00-light lh-condensed"><%= title %></h1>
  <div class="clearfix">
    <div class="float-left offset-md-4">
      <% if defined?(tags) && tags.present? && tags.any? %>
        <ul class="post--item-tags d-flex flex-row flex-wrap mb-3 list-style-none float-right">
          <% tags.each_with_index do |tag, index| %>
            <li class="ml-2"><%= tag.gsub('_', ' ') %><%= index < tags.size - 1 ? ',' : '' %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</header>
