<%= stylesheet_bundle :technology_partners %>
<div class="background-white border-bottom" <% unless request.path.include?('/partners/directory') %> style="position: sticky; position: -webkit-sticky; top: 0; z-index: 5;" <% end %>>
  <nav aria-label="Partner site navigation" class="d-flex container-xl mx-auto px-md-4">
    <div class="d-flex flex-auto flex-items-center flex-wrap flex-md-nowrap flex-justify-center flex-md-justify-start">
      <a class="h5-mktg no-underline site-nav-logo" href="/partners" >Partner with GitHub</a>
      <a href="/partners/service-channel-partners" class="mr-3 mr-md-4 py-3 no-underline site-nav-item <%= 'site-nav-item-active' if request.path.include?('/partners/service-channel-partners') %>">Services & Channel<span class="site-nav-optional"> Partners</span></a>
      <a href="/partners/technology-partners" class="mr-3 mr-md-4 py-3 no-underline site-nav-item <%= 'site-nav-item-active' if request.path.include?('/partners/technology-partners') %>">Technology<span class="site-nav-optional"> Partners</span></a>
      <a href="/partners/resources" class="mr-3 mr-md-4 py-3 mt-0 py-3 no-underline site-nav-item <%= 'site-nav-item-active' if request.path.include?('/partners/resources') %>">Resources</a>
    </div>
    <div class="d-none d-md-flex flex-auto flex-items-center flex-justify-end">
      <% if request.path == '/partners/service-channel-partners' %>
        <a href="https://portal.github.partners/" class="btn-mktg py-2 ml-3 f5 my-2">Partner Portal Login</a>
      <% end %>
    </div>
  </nav>
</div>
