<article
  class="post--item post-card <%= local_assigns[:stack] ? 'stack' : 'list' %>"
  resource-tags="<%= post[:tags].join(',') if post[:tags].any? %>"
  <%= post[:categories].map(&:downcase).join(',') if post[:categories].any? %>
>
  <div class="post--item-content color-shadow-medium">
    <div class="clearfix">
      <div class="col-md-2 post--item-header-col">
        <p class="post--item-subtitle mb-0">
          <%= post[:type].presence || "Article" %>
        </p>
      </div>
      <div class="col-md-10 post--item-header-col">
        <% if post[:tags].any? %>
          <ul class="post--item-tags d-flex flex-row flex-wrap list-style-none mb-0">
            <%= safe_join(
                  post[:tags].each_with_index.map { |tag, idx|
                    content_tag(:li, data: { tag: tag }) do
                      safe_join([
                        tag.gsub("_", " "),
                        (idx < post[:tags].size - 1 ? ", " : "")
                      ])
                    end
                  }
                )
            %>
          </ul>
        <% end %>
      </div>
    </div>

    <%
      slug       = post[:slug]
      date_match = slug.match(/^(\d{4})_(\d{2})_(\d{2})_(.+)$/)
      resource_url =
        if date_match
          y, m, d, name = date_match.captures
          "/partners/integration-resources/#{y}/#{m}/#{d}/#{name.parameterize}"
        else
          "/partners/integration-resources/#{slug.parameterize}"
        end
    %>

    <h3>
      <%= link_to post[:title], resource_url, class: "post--item-title-link" %>
    </h3>

    <div class="mb-3">
      <%= post[:preview] %>
    </div>

    <div class="clearfix">
      <%= link_to resource_url do %>
        Learn More
        <%= render Primer::Beta::Octicon.new(:"arrow-right", size: :small, classes: "ml-1") %>
      <% end %>
    </div>
  </div>
</article>
