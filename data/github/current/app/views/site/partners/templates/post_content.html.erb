<%# rubocop:disable Rails/OutputSafety %>
<div class="container-xl p-responsive my-5">
  <article class="px-3">
    <% if defined?(post_sections) && post_sections.include?("newsfeed") %>
      <%= link_to "Go to the Newsfeed", "/partners/newsfeed", class: "d-block mb-4" %>
    <% else %>
      <%= link_to "See all Resources", "/partners/resources", class: "d-block mb-4" %>
    <% end %>

    <% if defined?(post_featured_image) && post_featured_image.present? %>
      <div class="mb-4">
        <%= image_tag post_featured_image, alt: post_title %>
      </div>
    <% end %>

    <header class="d-block mb-6">
      <h1 class=" my-2 f00-light lh-condensed"><%= post_title %></h1>
      <div class="clearfix">
        <div class="col-md-8 float-left offset-md-4">
          <% if defined?(post_tags) && post_tags.any? %>
            <ul class="post--item-tags d-flex flex-row flex-wrap mb-3 list-style-none float-right">
              <% post_tags.each_with_index do |tag, index| %>
                <li class="ml-2">
                  <%= tag.tr("_", " ") %><%= index < post_tags.size - 1 ? "," : "" %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>
    </header>

    <div class="markdown-body col-12 col-md-12 mb-2 mb-md-4">
      <% if defined?(post_content) && post_content.present? %>
        <%# post_content is trusted (developer-written), so it’s safe to raw(...) %>
        <%= raw(post_content) %>
      <% end %>
    </div>
  </article>
</div>
