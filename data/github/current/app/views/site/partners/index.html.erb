<% content_for :partners_content do %>
  <!-- Hero Section -->
  <div class="text-center py-8 position-relative">
    <div class="container-xl position-relative" style="z-index: 1">
      <h1 class="h0-mktg text-bold mb-3">Why partner with GitHub?</h1>
      <p class="col-12 col-md-7 px-4 mx-auto f3">Discover a variety of partnership opportunities with GitHub that cater to different aspects of business growth and technical collaboration. Whether you're looking to integrate your technology with GitHub's platform, enhance educational initiatives, support startups, or engage in channel services, we offer tailored programs to meet your needs. Explore how you can leverage GitHub's resources, network, and expertise to achieve your goals.</p>
    </div>
  </div>

  <!-- Partnership Cards - First Row -->
  <div class="container-xl">
    <div class="d-flex flex-wrap flex-md-nowrap mt-5">
      <!-- Technology Partnership Card -->
      <div class="my-8 my-md-0 col-12 col-md-6 text-center color-shadow-large pb-7 px-3 px-md-6 mx-3 rounded-2">
        <div class="d-flex flex-column flex-justify-between height-full">
          <div>
            <span class="d-inline-block  circle custom-circle background-white color-shadow-large p-6">
              <img class="d-block" alt="a logo representing connection" width="80" height="80"  src="<%= image_path "modules/site/technology-partners/images/icons/technology-partners.png" %>">
            </span>
          </div>
          <h2 class="h0-mktg text-bold  lh-condensed mt-3">Technology Partnership</h2>
          <p class="f3 mt-3 px-3">Transform the way software is built, deployed, and maintained. Partner with us to deliver innovative user experiences within your product and on GitHub.</p>
          <div>
            <a class="btn-mktg f4 mt-5" href="/partners/technology-partners">Learn more and Apply</a>
          </div>
        </div>
      </div>

      <!-- Channel and Services Partnership Card -->
      <div class="my-8 my-md-0 col-12 col-md-6 text-center color-shadow-large pb-7 px-3 px-md-6 mx-3 rounded-2">
        <div class="d-flex flex-column flex-justify-between height-full">
          <div>
            <span class="d-inline-block circle custom-circle background-white color-shadow-large p-6">
              <img class="d-block" alt="a logo representing services" width="80" height="80" src="<%= image_path "modules/site/technology-partners/images/icons/services-and-partners.png" %>">

            </span>
          </div>
          <h2 class="h0-mktg text-bold  lh-condensed mt-3">Channel and Services Partnership</h2>
          <p class="f3 mt-3 px-3">Partner with GitHub to expand your team's capabilities, grow your pipeline, and become a trusted advisor for your customers. Get sales, technical, and marketing resources along with tailored enablement from our experienced teams to help you grow your business.</p>
          <div>
            <a class="btn-mktg f4 mt-5" href="/partners/service-channel-partners">Learn more and Apply</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Partnership Cards - Second Row -->
    <div class="d-flex flex-wrap flex-md-nowrap mt-12">
      <!-- Education Partnership Card -->
      <div class="my-8 my-md-0 col-12 col-md-6 text-center color-shadow-large pb-7 px-3 px-md-6 mx-3 rounded-2">
        <div class="d-flex flex-column flex-justify-between height-full">
          <div>
            <span class="d-inline-block circle custom-circle background-white color-shadow-large p-6">
              <img class="d-block" alt="icon of a training session" width="80" height="80" src="<%= image_path "modules/site/technology-partners/images/icons/training.png" %>">
            </span>
          </div>
          <h2 class="h0-mktg text-bold  lh-condensed mt-3">Education Partnership</h2>
          <p class="f3 mt-3 px-3">Partner with us to shape the next generation of developers. Through innovative collaborations, resource sharing, product integrations, and engaging events, we create opportunities that inspire and educate learners worldwide. Discover how you can get involved and make a lasting impact.</p>
          <div>
            <a class="btn-mktg f4 mt-5" href="https://github.com/education/partners">Learn more and Apply</a>
          </div>
        </div>
      </div>

      <!-- Startup Partnership Card -->
      <div class="my-8 my-md-0 col-12 col-md-6 text-center color-shadow-large pb-7 px-3 px-md-6 mx-3 rounded-2">
        <div class="d-flex flex-column flex-justify-between height-full">
          <div>
            <span class="d-inline-block  circle custom-circle background-white color-shadow-large p-6">
              <img class="d-block" width="80" alt="icon representing a connection" height="80" src="<%= image_path "modules/site/technology-partners/images/icons/technology-partners.png" %>">
            </span>
          </div>
          <h2 class="h0-mktg text-bold  lh-condensed mt-3">Startup Partnership</h2>
          <p class="f3 mt-3 px-3">Support and resources to scale your startup with GitHub's secure AI-powered developer platform.</p>
          <div>
            <a class="btn-mktg f4 mt-5" href="https://github.com/enterprise/startups">Learn more and Apply</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Benefits Section -->
    <div class="text-center mt-10 col-11 col-md-6 mx-auto">
      <h2 class="h0-mktg text-bold partners-benefits-title">Benefits of partnering with GitHub</h2>
      <p class="f3 mt-3 mb-5 px-4">The GitHub Partner Programs give you exclusive benefits to scale your services</p>
    </div>
    <div class="text-left d-flex flex-wrap flex-justify-center mt-7 pb-7">
      <!-- Marketing and Enablement Benefit -->
      <div class="col-12 col-sm-5 col-md-4 px-3">
        <img alt="a logo representing a connection" src="<%= image_path "modules/site/technology-partners/images/icons/marketing-support.png" %>" width="102" class="d-block mb-2">
        <h2 class="h2-mktg text-bold mb-2 ">Marketing and Enablement</h2>
        <p class="f4">Enhance your customer story and expand your team's skills with marketing assets, sales training, and technical resources from GitHub.</p>
      </div>

      <!-- Technical Support Benefit -->
      <div class="col-12 col-sm-5 col-md-4 px-3">
        <img alt="a logo representing a person speaking" src="<%= image_path "modules/site/technology-partners/images/icons/support.png" %>" width="102" class="d-block mb-2">
        <h2 class="h2-mktg text-bold mb-2 ">Technical support</h2>
        <p class="f4">Access technical support from GitHub to support your integrations and customer projects.</p>
      </div>

      <!-- GitHub Enterprise Licenses Benefit -->
      <div class="col-12 col-sm-5 col-md-4 px-3">
        <img alt="a logo representing a person speaking in front of an audience" src="<%= image_path "modules/site/technology-partners/images/icons/training.png" %>" width="102" class="d-block mb-2">
        <h2 class="h2-mktg text-bold mb-2 ">GitHub Enterprise licenses</h2>
        <p class="f4">Get free GitHub Enterprise Server licenses to deliver better results to your customers.</p>
      </div>
    </div>
  </div>
<% end %>

<%= render template: "site/partners/templates/layout_wrapper" %>
