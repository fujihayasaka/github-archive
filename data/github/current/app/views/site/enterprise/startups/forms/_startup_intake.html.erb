<%= render Primer::Alpha::Dialog.new(
  title: "GitHub for Startups Sign-up Form",
  size: :xlarge,
  visually_hide_title: true,
  id: "startup-intake-dialog",
) do |d| %>
  <% d.with_body do %>
    <div class="position-relative text-left">
      <%= form_with url: "https://s88570519.t.eloqua.com/e/f2", id: "eloquaForm", name: "startups-form", method: :post, class: "js-form-validator" do |f| %>
          <input value="startups-form" type="hidden" name="elqFormName">
          <input value="88570519" type="hidden" name="elqSiteId">
          <input name="elqCampaignId" type="hidden">

          <div class="form-group">
            <div class="h4-mktg">GitHub for Startups Sign-up Form</div>
          </div>
          <div class="form-group f6-mktg text-bold">
            Eligibility
          </div>
          <div class="form-group f6-mktg">
              <ul>
                <li class="f6 ml-3"><strong>Funding Stage:</strong> Must have received outside funding (up to Series B or earlier).</li>
                <li class="f6 ml-3"><strong>New to GitHub Plans & Credits:</strong> Must be new to GitHub Enterprise or Advanced Security, or have not been on an Enterprise plan within the past 6 months, including not having received credits for either plan.</li>
              </ul>
          </div>

          <p class="form-group f6-mktg">
            Want to add an extra year of savings on Enterprise and Advanced Security? Refer your investor, accelerator, or incubator to become an approved <a class="Link--inTextBlock" href="https://github.com/enterprise/startups#join-partners">GitHub for Startups partner</a> and apply with their unique application link!
          </p>

          <p class="form-group f6-mktg">
            If you’re accepted, you’ll receive an email with further instructions within 2-4 business days. If you have any questions, please <a class="Link--inTextBlock" href="https://support.github.com/contact?tags=hh-github-for-startups">reach out</a> to our team.
          </p>

          <p class="form-group f6-mktg">
              <span style="color: var(--fgColor-danger, var(--color-danger-emphasis));">*</span> - required field
          </p>

          <fieldset>
            <dl class="form-group my-0">
              <dt class="input-label">
                <%= f.label :company_name, _("Company Name"), class: "required error-label-transition f5 text-bold", for: :companyName %>
              </dt>
              <dd>
                <%= f.text_field :company_name,
                  id: :companyName,
                  required: true,
                  class: "required form-control input-block error-border-transition js-validity-check",
                  placeholder: _("Acme, Inc.")
                %>
              </dd>
            </dl>

            <div class="d-md-flex gutter-md-condensed">
              <dl class="col-md-6 form-group mb-0">
                <dt>
                  <%= f.label :first_name, _("First Name"), class: "required error-label-transition f5 text-bold", for: :firstName %>
                </dt>
                <dd>
                  <%= f.text_field :first_name,
                    id: :firstName,
                    required: true,
                    class: "required form-control input-block error-border-transition js-validity-check"
                  %>
                </dd>
              </dl>

              <dl class="col-md-6 form-group mb-0">
                <dt>
                  <%= f.label :last_name, _("Last Name"), class: "required error-label-transition f5 text-bold", for: :lastName %>
                </dt>
                <dd>
                  <%= f.text_field :last_name,
                    id: :lastName,
                    required: true,
                    class: "required form-control input-block error-border-transition js-validity-check"
                  %>
                </dd>
              </dl>
            </div>

            <div class="d-md-flex gutter-md-condensed">
              <dl class="col-md-6 form-group mb-0">
                <dt>
                  <%= f.label :emailAddress, _("Email Address"), class: "required error-label-transition f5 text-bold", for: :email %>
                </dt>
                <dd>
                  <%= f.email_field :emailAddress,
                    id: :email,
                    required: true,
                    class: "required form-control input-block error-border-transition js-validity-check",
                    placeholder: "you@example.com"
                  %>
                  <span class="f5 text-italic">
                    Please use an email with your company domain. Personal emails or emails that do not match the GitHub Account owner will be rejected. GitHub sends all important communications to the primary email of the admin - if you need to update your primary email address, please follow these <a class="Link--inTextBlock" href="https://docs.github.com/enterprise-cloud@latest/account-and-profile/setting-up-and-managing-your-personal-account-on-github/managing-email-preferences/changing-your-primary-email-address" target="_blank">instructions</a> before submitting your application.
                  </span>
                </dd>
              </dl>

              <dl class="col-md-6 form-group mb-0">
                <dt>
                  <%= f.label :role, _("Role in Company"), class: "required error-label-transition f5 text-bold", for: :roleInCompany %>
                </dt>
                <dd>
                  <% roles = [
                      ["Cofounder CEO", "ceo"],
                      ["Cofounder/CTO", "cto"],
                      ["Technical Lead", "tech-lead"],
                      ["Cofounder (other)", "cofounder-other"],
                    ]
                  %>
                  <%= f.select :role,
                    roles,
                    { selected: "Please select", include_blank: "Please select" },
                    { id: :roleInCompany, class: "required input-block form-select error-border-transition js-validity-check", required: true }
                  %>
                </dd>
              </dl>
            </div>

            <dl class="form-group">
              <dt>
                <%= f.label :company_website, _("Company Website"), class: "required error-label-transition f5 text-bold", for: :companyWebsite %>
              </dt>
              <dd>
                <%= f.text_field :company_website,
                    id: :companyWebsite,
                    required: true,
                    class: "required form-control input-block error-border-transition js-validity-check",
                    placeholder: "https://website.com"
                  %>
                <span class="f5 text-italic">Applications with invalid websites and/or websites with inappropriate content will be rejected.</span>
              </dd>
            </dl>

            <dl class="form-group">
              <dt>
                <%= f.label :company_overview, _("Company overview"), class: "f5 required text-bold", for: :companyOverview %>
              </dt>
              <dd>
                <%= f.text_field :company_overview,
                    id: :companyOverview,
                    required: true,
                    class: "required form-control input-block error-border-transition js-validity-check"
                  %>
                <span class="f5 text-italic">In a few sentences, please share a bit more about your company.</span>
              </dd>
            </dl>

            <div class="d-md-flex gutter-md-condensed">
              <dl class="col-md-6 form-group mb-0">
                <dt>
                  <%= f.label :industry, _("Industry"), class: "required error-label-transition f5 text-bold", for: :startupIndustry %>
                </dt>
                <dd>
                  <% industry = [
                      ["Agriculture & Mining", "agriculture-mining"],
                      ["Business Services", "business-services"],
                      ["Computers & Electronics", "computers-electronics"],
                      ["Consumer Services", "consumer-services"],
                      ["Education", "education"],
                      ["Energy & Utilities", "energy-utilities"],
                      ["Financial Services", "financial-services"],
                      ["Food & Beverage", "food-beverage"],
                      ["Government", "government"],
                      ["Healthcare", "healthcare"],
                      ["Manufacturing", "manufacturing"],
                      ["Media & Entertainment", "media-entertainment"],
                      ["Not for Profit", "not-for-profit"],
                      ["Real Estate & Construction", "real-estate-construction"],
                      ["Retail", "retail"],
                      ["Software & Internet", "software-internet"],
                      ["Telecommunications", "telecommunications"],
                      ["Transportation & Storage", "transportation-storage"],
                      ["Travel, Recreation, and Leisure", "travel-recreation-leisure"],
                      ["Whole & Distribution", "whole-distribution"],
                      ["Other", "other"]
                    ]
                  %>
                  <%= f.select :industry,
                    industry,
                    { selected: "Please select", include_blank: "Please select" },
                    { id: :startupIndustry, class: "required input-block form-select error-border-transition js-validity-check", required: true }
                  %>
                </dd>
              </dl>

              <dl class="col-md-6 form-group mb-0">
                <dt>
                  <%= f.label :latest_funding_round, _("Latest Funding Round"), class: "required error-label-transition f5 text-bold", for: :startupFunding %>
                </dt>
                <dd>
                  <% funding = [
                      ["Bootstrap", "bootstrap"],
                      ["Pre-Seed", "pre-seed"],
                      ["Seed", "seed"],
                      ["Series A", "series-a"],
                      ["Series B", "series-b"],
                      ["Series C or later", "series-c-or-later"]
                    ]
                  %>
                  <%= f.select :latest_funding_round,
                    funding,
                    { selected: "Please select", include_blank: "Please select" },
                    { id: :startupFunding, class: "required input-block form-select error-border-transition js-validity-check", required: true }
                  %>
                </dd>
              </dl>
            </div>

            <div class="d-md-flex gutter-md-condensed">
              <dl class="col-md-6 form-group mb-0">
                <dt>
                  <%= f.label :funding_raised, _("Total Funding Raised"), class: "required error-label-transition f5 text-bold", for: :totalFundingRaised %>
                </dt>
                <dd>
                  <% funding_raised_options = [
                      ["<$1M USD", "less-than-1M"],
                      ["$1M-$2M USD", "1M-2M"],
                      ["$2M-$5M USD", "2M-5M"],
                      ["$5M-$10M USD", "5M-10M"],
                      ["$10M-$25M USD", "10M-25M"],
                      ["$25M+ USD", "25M-and-more"]
                    ]
                  %>
                  <%= f.select :funding_raised,
                    funding_raised_options,
                    { selected: "Please select", include_blank: "Please select" },
                    { id: :totalFundingRaised, class: "required input-block form-select error-border-transition js-validity-check", required: true }
                  %>
                </dd>
              </dl>
            </div>

            <dl class="form-group">
              <dt>
                <%= f.label :crunchbase_link, _("Proof of Funding"), class: "required error-label-transition f5 text-bold", for: :crunchbaseLink %>
              </dt>
              <dd>
                <%= f.text_field :crunchbase_link,
                  id: :crunchbaseLink,
                  required: true,
                  class: "required form-control input-block error-border-transition js-validity-check"
                %>
                  <span class="f5 text-italic">Provide links from credible sources such as third-party news, startup investment platforms (e.g. Crunchbase), or investor portfolio pages or blog posts. Self-published content will not be accepted. If you are a stealth startup, please apply through your approved <a class="Link--inTextBlock" href="https://github.com/enterprise/startups/partners">GitHub for Startups partner page</a>.</span>
              </dd>
            </dl>

            <hr>

            <div class="form-group">
              <div class="h4-mktg">Account Information</div>
              <span class="f5">You will not be billed at this time. This information will be used for any paid add-ons or upgrades you choose to add (beyond the 20 seat offer) during or after the program.</span>
            </div>

            <div class="d-md-flex gutter-md-condensed">
              <%= render Site::CountrySelectComponent.new(
                label: _("Country"),
                id: :billingCountry,
                name: :billing_country,
                country_list: "startups",
                form_group_classes: "col-md-6",
              ) %>
            </div>

            <hr>

            <div class="d-md-flex gutter-md-condensed">
              <dl class="d-none col-md-12 form-group mb-0">
                <dt>
                  <%= f.label :startups_partner, _("GitHub for Startups Partner"), class: "required error-label-transition f5 text-bold", for: :startupsPartner %>
                </dt>
                <dd>
                  <%= f.text_field :startups_partner,
                    id: :startupsPartner,
                    class: "required form-control input-block error-border-transition js-validity-check"
                  %>
                  <span class="f5 text-italic">Please provide the name of the accelerator/incubator/VC fund through which you are applying for GitHub for Startups benefits. If you were referred by a GitHub employee, please list their email here.</span>
                </dd>
              </dl>
            </div>

            <dl class="form-group">
              <dt>
                <%= f.label :org_url, _("GitHub Enterprise Slug"), class: "required error-label-transition f5 text-bold", for: :orgUrl %>
              </dt>
              <dd>
                <%= f.text_field :org_url,
                  id: :orgUrl,
                  required: true,
                  class: "required form-control input-block error-border-transition js-validity-check"
                %>
                <span class="f5 text-italic">Please provide your startup’s GitHub Enterprise account in the format github.com/enterprises/SLUG. You can sign up for an <a class="Link--inTextBlock" href="https://docs.github.com/en/enterprise-cloud@latest/admin/overview/setting-up-a-trial-of-github-enterprise-cloud">Enterprise trial</a>. Ensure you sign up for the trial using personal accounts. Applications with invalid, organization, or managed user accounts will be rejected. See <a class="Link--inTextBlock" href="https://docs.github.com/en/get-started/learning-about-github/types-of-github-accounts">details on account types</a> to learn more.</span>
              </dd>
            </dl>

            <hr>

            <div class="required form-checkbox f5 mb-3 form-group">
              <label>
                <input id="optincheckbox" name="opt_in_checkbox" type="checkbox" value="True" class="required error-border-transition js-validity-check" required>
                    I hereby accept the <a class="Link--inTextBlock" href="<%= customer_term_index_url %>">GitHub Customer Agreement</a> on behalf of my organization and confirm that I have the authority to do so. For more information about GitHub's privacy practices, see the <a class="Link--inTextBlock" href="https://github.com/site/privacy">GitHub Privacy Statement</a>.
              </label>
            </div>

            <div class="required form-checkbox f5 mb-3 form-group">
              <label>
                <input id="termscheckbox" name="terms_checkbox" type="checkbox" value="True" class="required error-border-transition js-validity-check" required>
                    I agree to the <a class="Link--inTextBlock" href="https://github.com/enterprise/startups#faq">GitHub for Startups Terms and Conditions</a>.
              </label>
            </div>

            <input type="hidden" name="startup_form_type" value="new">
            <input type="hidden" name="elqCustomerGUID" value="">
            <input type="hidden" name="elqCookieWrite" value="0">
            <input type="hidden" name="ip_address" value="">
            <input type="hidden" name="partner_id" value="<%= params[:pid] if params.key?(:pid) %>">
            <input id="sfcampaignidStudy" type="hidden" name="sfcampaignid" value="7013o000002Cdg3AAC">
            <input id="sourceStudy" type="hidden" name="source" value="2022q3-site-ww-Startups-Signup">

            <%= f.button _("Sign up for GitHub for Startups"),
              type: :submit,
              class: "btn-mktg js-form-validator-submit f3-mktg mt-4 width-full" %>
          </fieldset>
        <% end %>
    </div>
  <% end %>
<% end %>

<%= render Site::ButtonComponent.new(text: "Apply now", classes: "mt-4", data: {"show-dialog-id": "startup-intake-dialog"}) %>
