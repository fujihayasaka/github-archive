<div class="container-xl p-responsive tmp-mt-9 tmp-mb-9 position-relative">
  <div class="d-flex flex-wrap position-relative z-1 gutter-spacious">

    <div class="col-lg-6 d-lg-flex flex-justify-center flex-column">
      <h3 class="h5-mktg text-semibold mb-2">GitHub's Special Events Support</h3>

      <p class="f4-mktg mb-0 color-fg-muted">Dedicated senior support engineer coverage for high-traffic or high-risk events. Support is available in 24-hour increments, with the most common packages offering 24- or 48-hour coverage.</p>

      <ul class="list-style-none f4-mktg color-fg-muted p-0 tmp-py-3 tmp-py-md-4">
        <% [
          "Pre-event system checks and readiness planning",
          "Real-time support via a dedicated channel",
          "Post-event debriefs with actionable recommendations",
        ].each do |item| %>
          <li class="position-relative tmp-pl-4 mb-2">
            <%= render Primer::Beta::Octicon.new(icon: :check, color: :success, size: :small, position: :absolute, left: 0, style: "top: 2px") %>
            <%= item %>
          </li>
        <% end %>
      </ul>

      <div class="d-flex flex-items-center mt-2">
        <%= render Site::ButtonComponent.new(
          text: "Get a quote",
          url: enterprise_contact_path(
            utm_source: "github",
            utm_medium: "referral",
            utm_campaign: "2023q3-site-ww-PremiumSupport",
            utm_content: "Premium Support",
            scid: ""
          ),
          analytics: {
            ref_loc: "events section"
          },
          arrow: true,
        ) %>

        <%= render Site::LinkComponent.new(
          text: "Learn more",
          url: 'https://docs.github.com/en/enterprise-server@3.19/support/learning-about-github-support/about-github-special-events-support',
          size: :medium,
          arrow: false,
          classes: "tmp-ml-4",
          analytics: {
            ref_loc: "events section"
          }
        ) %>
      </div>
    </div>

    <div class="col-lg-6 d-lg-flex flex-justify-end flex-items-center tmp-mt-6 tmp-mt-lg-0">
      <%= render Site::ImageComponent.new(
        src: image_path("modules/site/premium-support/events.webp"),
        width: 1200,
        height: 752,
        classes: "d-block width-fit height-auto rounded-3",
        alt: "A smiling GitHub Support Engineer wearing headphones and a branded hoodie, monitoring the enterprise-premium-support Slack channel on a large desktop monitor.",
        sizes: "600px"
      ) %>
    </div>

  </div>
</div>
