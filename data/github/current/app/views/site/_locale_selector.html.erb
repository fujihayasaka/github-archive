<% locale_links = [
  { text: _("English"), locale: "en-us", analytics_label: "locale:en-us" },
  { text: _("Português (Brasil)"), locale: "pt-br", analytics_label: "locale:pt-br" },
  { text: _("Español (América Latina)"), locale: "es-419", analytics_label: "locale:es-419" },
  { text: _("日本語"), locale: "ja", analytics_label: "locale:ja" },
  { text: _("한국어"), locale: "ko-kr", analytics_label: "locale:ko-kr" }
] %>

<% if FeatureFlag.vexi.enabled?(:marketing_localization_experiment, current_user, default: false) %>
  <% locale = local_assigns[:locale] || 'en-us' %>
  <% current_locale = locale_links.find { |link| link[:locale].start_with?(locale[0, 2]) } %>

  <locale-selector>
    <%= render Primer::Experimental::ActionMenu.new(menu_id: "locale-selector", anchor_align: :start, classes: "footer-social-icon") do |menu| %>
      <% menu.with_trigger("aria-label": "#{current_locale[:text]} - Select language", classes: "d-flex flex-items-center border-0 color-bg-transparent p-0 locale-trigger") do %>
        <span class="locale-selector-trigger">
          <%= primer_octicon "globe", height: 16, classes: "mr-1 color-fg-muted locale-icon" %>
          <span class="color-fg-muted Link--secondary f6"><%= current_locale[:text] %></span>
          <%= primer_octicon "chevron-down", height: 16, classes: "ml-1 color-fg-muted locale-icon" %>
        </span>
      <% end %>

      <% locale_links.each do |link| %>
        <% is_selected = link[:locale] == current_locale[:locale] %>
        <% menu.with_item(
          tag: :a,
          href: "",
          selected: is_selected,
          classes: "footer-social-locale",
          style: "white-space: normal;",
          data: {
            action: "click:locale-selector#handleSelectLocale",
            locale: link[:locale]
          }
        ) do %>
          <div style="width: 16px; display: inline-block; text-align: center; margin-right: 8px; flex-shrink: 0;">
            <%= is_selected ? primer_octicon("check", height: 16) : "" %>
          </div>
          <span><%= link[:text] %></span>
        <% end %>
      <% end %>
    <% end %>
  </locale-selector>
<% end %>
