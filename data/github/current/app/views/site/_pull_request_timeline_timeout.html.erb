<%# erblint:counter DeprecatedComponentsCounter 1 %>
<div class="border rounded-2 borderColor-default">
  <%= render Primer::BlankslateComponent.new(
    icon: "hourglass",
    title: "Timeline cannot be loaded",
    classes: "tmp-mt-3 tmp-pt-4 tmp-mb-3"
  ) do %>
    <p class="mt-2">Try reloading the page, or if the problem persists <a class="Link--inTextBlock fgColor-muted" href="<%= GitHub.contact_support_url %>">
      <u>contact support</u>
    </a>.</p>
    <a class="f4" href="<%= GitHub.status_url %>">GitHub status</a>
  <% end %>
</div>
