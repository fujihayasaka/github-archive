<%
state ||= :unknown
range ||= params[:range]
%>

<% if state == :unknown %>
  <%= render GitHub::PollIncludeFragmentComponent.new(src: pre_mergeable_path(current_repository, range)) do %>
    <strong class="color-fg-attention">Checking mergeability&hellip;</strong>
    Don’t worry, you can still create the pull request.
  <% end %>
<% elsif state == :error %>
    <strong class="color-fg-danger">Error checking merge status.</strong>
    Don’t worry, you can still create the pull request.
<% elsif state == :clean %>
    <strong class="color-fg-success">
      <%= render(Primer::Beta::Octicon.new(icon: "check")) %>
      Able to merge.
    </strong>
    These branches can be automatically merged.
<% elsif state == :dirty %>
    <strong class="color-fg-danger">
      <%= render(Primer::Beta::Octicon.new(icon: "x")) %>
      Can’t automatically merge.
    </strong>
    Don’t worry, you can still create the pull request.
<% end %>
