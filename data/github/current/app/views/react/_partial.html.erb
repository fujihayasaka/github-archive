<%= javascript_bundle name, styles_only: true %>

<react-partial
  partial-name="<%= name %>"
  data-ssr="<%= ssr %>"
  data-attempted-ssr="<%= attempted_ssr %>"
  data-react-profiling="<%= profiling_mode_enabled %>"
<% if class_name.present? -%>
  class="<%= class_name %>"
<% end -%>
>
  <%= ssr_error_script_tag %>
  <%= data_script_tag %>
  <%= react_root_tag %>
</react-partial>

