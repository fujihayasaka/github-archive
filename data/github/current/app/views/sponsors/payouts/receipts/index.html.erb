<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% content = capture do %>
  <% if stripe_payouts_sorted_by_created.empty? %>
    <%= render Primer::Beta::Blankslate.new(test_selector: "no-payouts") do |c| %>
      <% c.with_heading(tag: :h2) do %>
        No payouts
      <% end %>

      <% c.with_description do %>
        When you have received a GitHub Sponsors payout, it will appear here.
      <% end %>
    <% end %>
  <% else %>
    <%= form_tag sponsorable_dashboard_payout_receipts_path(sponsors_listing.sponsorable_login), class: "js-sponsors-payout-receipt-form" do %>
      <input type="hidden" name="stripe_account_id" class="js-sponsors-stripe-id">
      <input type="hidden" name="payout_start_date_unix" class="js-sponsors-payout-start-date-unix">
      <input type="hidden" name="payout_id">
      <input type="hidden" name="payout_year">

      <div class="form-group">
        <div class="form-group-header">
          <label for="choose-a-payout" id="payout-selector-label">Generate a statement for:</label>
        </div>
        <div class="form-group-body">
          <%= render Primer::Alpha::Overlay.new(
            title: "Choose a payout or year",
            id: "payout-overlay",
            classes: "js-sponsors-payout-overlay",
            size: :auto,
            padding: :none,
            visually_hide_title: true,
            anchor_align: :start,
            anchor_side: :outside_bottom,
          ) do |overlay| %>
            <% overlay.with_show_button(
              id: "choose-a-payout-button",
              classes: "js-sponsors-chosen-payout",
              aria: { labelledby: "payout-selector-label choose-a-payout-button" },
              data: { "default-text": "Choose a payout" },
            ) do |button| %>
              <% button.with_trailing_action_icon(icon: :"triangle-down") %>
              Choose a payout or year
            <% end %>

            <% overlay.with_body(padding: :none) do %>
              <%= render Primer::Alpha::TabPanels.new(label: "Payout type") do |tabs| %>
                <% tabs.with_tab(id: "tab-payouts", selected: true) do |tab| %>
                  <% tab.with_text { "Payouts" } %>
                  <% tab.with_panel do %>
                    <%= render Primer::Alpha::ActionList.new(
                      select_variant: :single,
                      aria: { label: "Payouts" },
                    ) do |list| %>
                      <% stripe_payouts_sorted_by_created.each_with_index do |stripe_payout, i| %>
                        <%
                          stripe_account_id = stripe_payout.stripe_account_id
                          destination = stripe_payout.destination
                          prev_stripe_payout = stripe_payouts_sorted_by_created[i + 1]

                          description_parts = []
                          if destination
                            if destination.respond_to?(:bank_name)
                              description_parts << destination.bank_name
                            elsif destination.respond_to?(:brand)
                              description_parts << destination.brand
                            end
                            if destination.respond_to?(:last4)
                              description_parts << "····#{destination.last4}"
                            end
                          end
                        %>

                        <% list.with_item(
                          label: stripe_payout.created_at.strftime("%B %-d, %Y"),
                          content_arguments: {
                            tag: :button,
                            type: "button",
                            classes: "js-sponsors-stripe-payout-item",
                            data: {
                              "payout-id": stripe_payout.id,
                              "stripe-account-id": stripe_account_id,
                              "payout-text": stripe_payout.created_at.strftime("%B %-d, %Y"),
                              **(prev_stripe_payout ? { "payout-start-date-unix": prev_stripe_payout.created } : {}),
                            },
                          },
                          test_selector: "#{i}-#{stripe_payout.id}",
                        ) do |item| %>
                          <% if description_parts.any? %>
                            <% item.with_description.with_content(description_parts.join(" ")) %>
                          <% end %>
                        <% end %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>

                <% tabs.with_tab(id: "tab-years") do |tab| %>
                  <% tab.with_text { "Years" } %>
                  <% tab.with_panel do %>
                    <%= render Primer::Alpha::ActionList.new(
                      select_variant: :single,
                      aria: { label: "Years" },
                    ) do |list| %>
                      <% total_paid_out_by_year.each do |year, payout_total| %>
                        <% list.with_item(
                          label: "#{year} · #{payout_total.format}",
                          content_arguments: {
                            tag: :button,
                            type: "button",
                            classes: "js-sponsors-payout-year-item",
                            data: {
                              "payout-year": year,
                              "payout-text": "#{year} · #{payout_total.format}",
                            },
                          },
                        ) %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="form-group">
        <div class="form-group-header">
          <label for="tax_id">Tax ID (optional):</label>
        </div>
        <div class="form-group-body">
          <input class="form-control" type="text" name="tax_id" id="tax_id" value="<%= tax_id %>" aria-describedby="tax_id_note">
          <div class="note" id="tax_id_note">
            You can specify a VAT (Value-added tax), GST (Goods and services tax), or other tax ID for display in your
            statement.
          </div>
        </div>
      </div>

      <div class="form-group">
        <div class="form-group-header">
          <label for="address1">Your address, line 1 (optional):</label>
        </div>
        <div class="form-group-body">
          <input class="form-control" placeholder="123 Main St" type="text" name="address1" id="address1" aria-describedby="address1_note">
          <div class="note" id="address1_note">
            You can specify your address for display in the statement.
          </div>
        </div>
      </div>

      <div class="form-group">
        <div class="form-group-header">
          <label for="address2">Your address, line 2 (optional):</label>
        </div>
        <div class="form-group-body">
          <input class="form-control" placeholder="Anywhere, USA" type="text" name="address2" id="address2">
        </div>
      </div>

      <div class="form-actions">
        <%= render Primer::ButtonComponent.new(
          type: :submit,
          disabled: true,
          classes: "js-sponsors-generate-receipt-button"
        ) do %>
          Generate statement
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if include_layout %>
  <%= render layout: "sponsors/dashboards/layout", locals: { sponsors_listing: sponsors_listing, selected_tab: :payouts } do %>
    <%= content %>
  <% end %>
<% else %>
  <%= content %>
<% end %>
