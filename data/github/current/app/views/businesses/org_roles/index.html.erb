<% page_info title: "Organization roles · #{business.name}", sidebar: :people, selected_link: :business_organization_roles, stafftools: stafftools_enterprise_path(business) %>

<%= render layout: "businesses/layout", locals: { business: business, title: "Organization roles" } do %>
  <%= render(Primer::Beta::Text.new(color: :subtle, mb: 3, test_selector: "description-text")) do %>
    Organization roles are used to grant access to subsets of organization settings to enterprise teams.
    <%= render(Primer::Beta::Link.new(href: org_roles_docs_url, target: "_blank", rel: "noopener", classes: "Link--inTextBlock")) { "Learn more about organization roles." } %>
  <% end %>

  <%= render(Businesses::CustomRoles::OrgRolesListComponent.new(business: business, viewer_permissions: viewer_permissions)) %>

  <%= render(Primer::Beta::Heading.new(tag: :h3, mt: 3, mb: 2)) { "Pre-defined roles" } %>
  <%= render(OrgRoles::SystemRolesComponent.new(owner: business)) %>
<% end %>
