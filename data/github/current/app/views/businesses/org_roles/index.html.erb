<% page_info title: "Organization roles · #{business.name}", sidebar: :people, selected_link: :business_organization_roles, stafftools: stafftools_enterprise_path(business) %>

<%= render layout: "businesses/layout", locals: { business: } do %>
  <div class="d-flex flex-column gap-3">
    <div>
      <%= render Primer::Beta::Subhead.new(mb: 2) do |component| %>
        <% component.with_heading(size: :medium, tag: :h1) { "Organization roles" } %>
      <% end %>

      <%= render partial: 'businesses/org_roles/info', locals: { role_limit: OrganizationRole.custom_role_limit_for_owner(business), org_roles_docs_url: org_roles_docs_url } %>
    </div>

    <%= render(Businesses::CustomRoles::OrgRolesListComponent.new(business:, viewer_permissions:)) %>

    <div>
      <div class="d-flex flex-items-end gap-3 mb-3">
          <%= render(Primer::Beta::Subhead.new(hide_border: true, flex: 1, mt: 2, mb: 0, pb: 0)) do |component| %>
            <% component.with_heading(size: :medium, tag: :h2) { "Pre-defined roles" } %>
          <% end %>
      </div>
      <%= render(OrgRoles::SystemRolesComponent.new(owner: business)) %>
    </div>
  </div>
<% end %>
