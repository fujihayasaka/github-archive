<%
  page_info title: "Your enterprise is being set up!", full_height: true
%>
<div class="dfd-trial__container-form position-relative d-flex flex-column" data-color-mode="light" data-light-theme="light" data-dark-theme="dark">
  <div class="d-flex flex-justify-center dfd-trial__container-inner dfd-new__container-box">
    <div class="d-flex flex-column mt-6 mx-auto" <%= test_selector("multi-tenant-enterprise-provisioning-ongoing") %>>
      <div>
        <%= render(Primer::Beta::Octicon.new(:hourglass, size: :medium, color: :muted)) %>
        <%= render(Primer::Beta::Heading.new(
          tag: :h2,
          classes: "dfd-trial__container-h2",
          width: :medium,
          display: :inline,
        )) { "Get to know Enterprise while you wait with these guides" } %>
      </div>
      <p class="mt-2 fgColor-muted">What you can expect to complete once your account is set up.</p>

      <div class="mt-4 flex-1">
        <div class="border rounded-3 p-4">
          <div class="d-flex dfd-circle-icon done">
            <%= render(Primer::Beta::Octicon.new(:key, size: :small, color: :done)) %>
          </div>
          <h3 class="dfd-trial__container-h3 my-2"> How to generate SCIM tokens</h3>
          <p class="fgColor-muted">You will need this token to configure provisioning on your identity provider.</p>
          <%= render(Primer::Beta::Button.new(
            tag: :a,
            size: :large,
            href: "#{GitHub.help_url}/admin/managing-iam/understanding-iam-for-enterprises/getting-started-with-enterprise-managed-users#create-a-personal-access-token",
            target: "_blank",
            mt: 2
          )) do %>
            Read more on personal access tokens
          <% end %>
        </div>
      </div>
      <div class="mt-4 flex-1">
        <div class="border rounded-3 p-4">
          <div class="d-flex dfd-circle-icon done">
            <%= render(Primer::Beta::Octicon.new(:people, size: :small, color: :done)) %>
          </div>
          <h3 class="dfd-trial__container-h3 my-2">How to enable single sign-on</h3>
          <p class="fgColor-muted">You will have to configure your identity provider so members can authenticate to access organizations.</p>
          <%= render(Primer::Beta::Button.new(
            tag: :a,
            size: :large,
            href: "#{GitHub.help_url}/admin/managing-iam/configuring-authentication-for-enterprise-managed-users/configuring-saml-single-sign-on-for-enterprise-managed-users",
            target: "_blank",
            mt: 2
          )) do %>
            Read about single-sign on
          <% end %>
        </div>
      </div>
      <div class="mt-4 flex-1">
        <div class="border rounded-3 p-4">
          <div class="d-flex dfd-circle-icon done">
            <%= render(Primer::Beta::Octicon.new(:gear, size: :small, color: :done)) %>
          </div>
          <h3 class="dfd-trial__container-h3 my-2">How to configure provisioning</h3>
          <p class="fgColor-muted">You'll need to configure SCIM to automatically provision user accounts after you enable single sign-on.</p>
          <%= render(Primer::Beta::Button.new(
            tag: :a,
            size: :large,
            href: "#{GitHub.help_url}/admin/managing-iam/provisioning-user-accounts-with-scim",
            target: "_blank",
            mt: 2
          )) do %>
            Learn about user provisioning
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
