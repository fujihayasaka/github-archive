<% subtitle = "We're provisioning your account and will email you when it's done. This may take anywhere up to 3 days.
Here's what you can expect after it has been set up:" %>

<%# Rendered for a larger screen (> 1012 px)%>
<div class="trial-info-large">
  <span class="mt-2 h4 dfd-trial__proxima-header-text"><strong><%= subtitle %></strong></span>
  <%= render partial: "businesses/multi_tenant_provisioning_requests/multi_tenant_provisioning_steps_list" %>
</div>

<%# Rendered for a smaller screen, where the information can be collapsed (< 1012 px)%>
<details class="dfd-trial__details color-fg-on-emphasis py-3">
  <summary class="dfd-trial__details-summary text-semibold">
    <span class="mt-2 h4 dfd-trial__text-background"><strong><%= subtitle %></strong></span>
    <span class="dfd-trial__details-icon">
      <%= render(Primer::Beta::Octicon.new(:"chevron-down")) %>
    </span>
  </summary>
  <%= render partial: "businesses/multi_tenant_provisioning_requests/multi_tenant_provisioning_steps_list" %>
</details>
