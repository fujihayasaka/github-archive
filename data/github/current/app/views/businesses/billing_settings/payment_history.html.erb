<% page_info title: "Payment History", selected_link: :business_billing_vnext_payment_history, sidebar: :billing_and_licensing, stafftools: stafftools_enterprise_path(this_business) %>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    container_attributes: "itemscope itemtype='http://schema.org/Enterprise'"
  } do %>

  <%= render Primer::Beta::Text.new(tag: :h1, color: :default, border: :bottom, classes: "tmp-pb-3") do %>
    Payment history
  <% end %>

  <% if payment_records.present? %>
    <%= render Billing::Settings::PaymentHistoryComponent.new(
      payment_records: payment_records, target: this_business) %>
      <% if payment_records.total_pages > 1 %>
        <nav class="paginate-container" aria-label="Pagination">
          <%= will_paginate(payment_records) %>
        </nav>
      <% end %>
  <% else %>
    <%= render Primer::Beta::Blankslate.new(classes: "tmp-mb-3") do |c| %>
      <% c.with_visual_icon(icon: "credit-card") %>
      <% c.with_heading(tag: :h2) do %>
        You have not made any payments.
      <% end %>
    <% end %>
  <% end %>
<% end %>
