<%# erblint:counter DeprecatedComponentsCounter 1 %>
<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% page_info title: "Upgrade", selected_link: :business_billing_settings,
  stafftools: stafftools_enterprise_path(this_business) %>
<% if params[:volume_to_metered].present? %>
  <div class="container-lg p-responsive mt-4">
    <div class="d-inline-flex flex-items-center mb-3">
      <%= render(Primer::Beta::Octicon.new(:"arrow-left", size: :small, mr: 2)) %>
      <%= link_to "Licensing", enterprise_licensing_path(this_business), class: "Link--inTextBlock no-underline f4" %>
    </div>
  </div>
<% end %>

<% if this_business.autopay_disabled_by_india_rbi? %>
  <div <%= test_selector("upgrade-rbi-payment") %>>
    <%= render template: "billing_settings/payments/separate", locals: {
      target: this_business,
      trade_screening_needed: true,
      manual_payment: Billing::ManualPayment.new(target: this_business)
    } %>
  </div>
<% else %>
  <div class="container-lg p-responsive mt-4">
    <%= render partial: "settings/header", locals: {
      current_context: this_business,
      hide_profile_link: true
    } %>
  </div>

  <div class="my-5" <%= test_selector("multi-checkout") %>>
    <div class="container-lg p-responsive">
      <div class="border-bottom pb-3 mb-5">
        <%= render(Primer::Beta::Heading.new(tag: :h1, test_selector: "billing-upgrade-header")) do %>
          <% if params[:volume_to_metered].present? %>
            Switch to Metered Billing
          <% else %>
            <%= buy_enterprise_flavor %>
          <% end %>
        <% end %>
      </div>

      <% completed_billing_information = this_business.has_saved_billing_contact_with_information? %>
      <% completed_payment_method = this_business.has_credit_card? || this_business.has_paypal_account? %>
      <% can_complete_purchase = this_business.trial? && completed_billing_information && completed_payment_method %>
      <% total_consumed_licenses = [this_business.total_consumed_licenses, 1].max %>
      <% default_seats = total_consumed_licenses %>

      <div class="d-md-flex gutter-md">
        <div class="col-md-7" <%= test_selector("duration-summary") %>>
          <% if params[:volume_to_metered].blank? %>
            <% if current_user.feature_flag_enabled?(:banner_migration, default: false) %>
              <%= render(Primer::Alpha::Banner.new(mb: 5)) do |component| %>
                If you require invoices, or are interested in Enterprise Managed Users, <%= link_to "contact our sales team", ent_contact_url, class: "Link--inTextBlock" %>.
              <% end %>
            <% else %>
              <%= render(Primer::Beta::Flash.new(mb: 5)) do |component| %>
                If you require invoices, or are interested in Enterprise Managed Users, <%= link_to "contact our sales team", ent_contact_url, class: "Link--inTextBlock" %>.
              <% end %>
            <% end %>
          <% end %>

          <% if params[:volume_to_metered].present? %>
            <%= render(Billing::Settings::Upgrade::SectionComponent.new(
              title: "Account",
              icon: :organization
            )) do |component| %>
              <% component.with_body(pt: 4) do %>
                <%= render Primer::Box.new(border: true, border_radius: 2, p: 3, mb: 3) do %>
                  <div class="d-flex align-items-center">
                    <div class="mr-3">
                      <%= render Primer::Beta::Avatar.new(
                        src: this_business.primary_avatar_url,
                        alt: this_business.name,
                        size: 48,
                        shape: :square
                      ) %>
                    </div>
                    <div>
                      <h4 class="mb-1"><%= this_business.name %></h4>
                      <p class="color-fg-muted f6 mb-0">Enterprise Cloud</p>
                    </div>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          <% end %>

          <% if params[:volume_to_metered].blank? %>
            <%= render(Billing::Settings::Upgrade::SectionComponent.new(
              title: "Included Seats",
              icon: :people
            )) do |component| %>
              <% component.with_body do %>
                <%= render(Growth::SeatsPricingCardComponent.new(seat_price: price_per_seat, seat_label: "seat", per: selected_duration, mt: 3)) do |card| %>
                  <% card.with_title { "Enterprise" } %>
                  <% card.with_description do %>
                    Security, compliance, and flexible deployment
                  <% end %>
                  <% card.with_stepper_component(
                    type: :plan_upgrade,
                    seats: params[:seats] || default_seats,
                    param_name: "seats",
                    name: "seats",
                    min: total_consumed_licenses,
                    max: this_business.seat_limit_for_upgrades,
                    form: "upgrade-business-trial",
                    current_url: edit_multi_checkout_enterprise_path(this_business),
                    min_error_message: "You need at least #{pluralize(total_consumed_licenses, 'seat')} to support your #{pluralize(total_consumed_licenses, 'existing member')}",
                    max_error_message: "Please contact us at https://github.com/enterprise/contact for pricing and purchasing information."
                  ) do |stepper| %>
                    <% stepper.with_remove_seat_control(
                      data: analytics_click_attributes(
                        category: "business_multi_checkout",
                        action: "click_to_decrease_enterprise_seats",
                        label: "ref_cta:remove_seat;ref_loc:account_upgrade"
                      )
                    ) %>
                    <% stepper.with_input(
                      data: analytics_click_attributes(
                        category: "business_multi_checkout",
                        action: "click_on_enterprise_seats_input",
                        label: "ref_cta:seats_input;ref_loc:account_upgrade"
                      )
                    ) %>
                    <% stepper.with_add_seat_control(
                      data: analytics_click_attributes(
                        category: "business_multi_checkout",
                        action: "click_to_add_enterprise_seats",
                        label: "ref_cta:add_seat;ref_loc:account_upgrade"
                      )
                    ) %>
                  <% end %>
                <% end %>
                <%= render(Primer::Beta::Heading.new(tag: :h3, mt: 5)) { "Add-ons" } %>
                <%= render(Growth::SeatsPricingCardComponent.new(seat_price: advanced_security_price_per_seat, seat_label: "committer", per: selected_duration, mt: 3)) do |card| %>
                  <% card.with_title { "Advanced Security" } %>
                  <% card.with_description do %>
                    Secure software from the start.
                  <% end %>
                  <% if suggested_advanced_security_seats > 0 %>
                    <% card.with_notice(test_selector: "recommended-committers") { "Based on your trial activity, we recommend #{pluralize(suggested_advanced_security_seats, "committer")}." } %>
                  <% end %>
                  <% card.with_stepper_component(
                    type: :plan_upgrade,
                    seats: params[:committers] || suggested_advanced_security_seats,
                    label: "committer",
                    param_name: "committers",
                    name: "committers",
                    min: 0,
                    max: this_business.seat_limit_for_advanced_security_upgrade,
                    form: "upgrade-business-trial",
                    current_url: edit_multi_checkout_enterprise_path(this_business),
                    min_error_message: "You must have at least #{pluralize(0, "committer")}.",
                    max_error_message: "Please contact us at https://github.com/enterprise/contact for pricing and purchasing information."
                  ) do |stepper| %>
                    <% stepper.with_remove_seat_control(
                      data: analytics_click_attributes(
                        category: "business_multi_checkout",
                        action: "click_to_decrease_advanced_security_seats",
                        label: "ref_cta:remove_committer;ref_loc:account_upgrade"
                      )
                    ) %>
                    <% stepper.with_input(
                      test_selector: "advanced-security-input",
                      data: analytics_click_attributes(
                        category: "business_multi_checkout",
                        action: "click_on_advanced_security_seats_input",
                        label: "ref_cta:committer_input;ref_loc:account_upgrade"
                      )
                    ) %>
                    <% stepper.with_add_seat_control(
                      data: analytics_click_attributes(
                        category: "business_multi_checkout",
                        action: "click_to_add_advanced_security_seats",
                        label: "ref_cta:add_committer;ref_loc:account_upgrade"
                      )
                    ) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% else %>
            <%= render(Billing::Settings::Upgrade::SectionComponent.new(
              title: "Total Licenses",
              icon: :people,
            )) do |component| %>
              <% component.with_body do %>
                <%= render(Growth::SeatsPricingCardComponent.new(seat_price: price_per_seat, seat_label: "license", per: selected_duration, mt: 3)) do |card| %>
                  <% card.with_title { "Enterprise" } %>
                  <% card.with_description do %>
                    Security, compliance, and flexible deployment
                    <br><br>
                    <div style="margin-bottom: -20px;">
                      <strong style="color: black;"><%= pluralize(consumed_enterprise_seats, 'license') %></strong> currently in use
                    </div>
                  <% end %>
                <% end %>
                <%= render(Primer::Beta::Heading.new(tag: :h3, mt: 5)) { "Add-ons" } %>
                <%= render(Growth::SeatsPricingCardComponent.new(seat_price: secret_protection_price_per_seat, seat_label: "committer", per: selected_duration, mt: 3)) do |card| %>
                  <% card.with_title { "Secret Protection" } %>
                  <% card.with_description do %>
                    Secure software from the start.
                    <br>
                    <%= link_to "Learn more about Secret Protection", "https://docs.github.com/en/enterprise-cloud@latest/billing/concepts/product-billing/github-advanced-security#understanding-usage", class: "Link--inTextBlock" %>
                    <br><br>
                    <div style="margin-bottom: -20px;">
                      <strong style="color: black;"><%= pluralize(consumed_secret_protection_seats, 'committer') %></strong> currently in use
                    </div>
                  <% end %>
                  <% if suggested_advanced_security_seats > 0 %>
                    <% card.with_notice(test_selector: "recommended-committers") { "Based on your trial activity, we recommend #{pluralize(suggested_advanced_security_seats, "committer")}." } %>
                  <% end %>
                <% end %>
                <%= render(Growth::SeatsPricingCardComponent.new(seat_price: code_security_price_per_seat, seat_label: "committer", per: selected_duration, mt: 3)) do |card| %>
                  <% card.with_title { "Code Security" } %>
                  <% card.with_description do %>
                    Secure software from the start.
                    <br>
                    <%= link_to "Learn more about Code Security", "https://docs.github.com/en/enterprise-cloud@latest/billing/concepts/product-billing/github-advanced-security#understanding-usage", class: "Link--inTextBlock" %>
                    <br><br>
                    <div style="margin-bottom: -20px;">
                      <strong style="color: black;"><%= pluralize(consumed_code_security_seats, 'committer') %></strong> currently in use
                    </div>
                  <% end %>
                  <% if suggested_advanced_security_seats > 0 %>
                    <% card.with_notice(test_selector: "recommended-committers") { "Based on your trial activity, we recommend #{pluralize(suggested_advanced_security_seats, "committer")}." } %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>

          <%= render "businesses/billing_settings/checkout/billing_information_section", completed_billing_information: completed_billing_information, return_to: edit_multi_checkout_enterprise_path(this_business) %>

          <%= render(Billing::Settings::Upgrade::SectionComponent.new(title: "Payment method", icon: completed_payment_method ? :"check-circle-fill" : :"credit-card")) do |section| %>
            <% section.with_body(pt: 3) do %>
              <% if completed_billing_information %>
                <%= render(TradeCompliance::TradeScreeningRestrictionNoticeComponent.new(
                  target: this_business,
                  title: "You can't proceed with your payment",
                  check_for_current_user: true,
                  class_name: "container-sm mx-0",
                )) %>
                <%= render(Growth::PaymentMethodComponent.new(target: this_business, return_to: edit_multi_checkout_enterprise_path(this_business))) %>
              <% else %>
                <p class="mt-2">
                  You have not added billing information for your account.
                </p>
              <% end %>
            <% end %>
          <% end %>

          <% if params[:volume_to_metered].present? %>
            <%= render(Billing::Settings::Upgrade::SectionComponent.new(title: "Accept new terms", icon: :"shield-check", mb: 5)) do |section| %>
              <% section.with_body(pt: 1) do %>
                <%= render Primer::Box.new(border: true, border_radius: 2, border_color: :default, style: "padding: 4px 16px 16px 16px; border-color: #d1d9e0; position: relative;") do %>
                  <div class="form-group mb-0" style="position: relative;">
                    <div style="max-width: 500px;">
                      <label class="text-normal d-flex align-items-start" style="position: relative;">
                        <%= check_box_tag "agreed_to_terms", "yes", false, {
                          "data-test-selector" => "accept-terms-checkbox",
                          class: "flex-shrink-0",
                          style: "accent-color: #24292f; border: 2px solid #000000; margin-top: 2px; margin-right: 12px; position: relative;",
                          form: "upgrade-business-trial"
                        } %>
                        <div style="flex: 1; min-width: 0; position: relative;">
                          <div class="mb-1">I have read and agreed to the terms of service</div>
                          <p class="note mb-1 color-fg-muted">
                            If my organization does not already have a customer agreement for GitHub services, I hereby accept the GitHub Customer Agreement and confirm that I have the authority to do so on behalf of my organization.
                          </p>
                          <%= link_to "View terms of service", "https://github.com/customer-terms", class: "Link--inTextBlock" %>
                        </div>
                      </label>
                    </div>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <% if params[:volume_to_metered].blank? %>
          <div class='col-md-5'>
          <%= render Primer::Box.new(classes: "js-stepper-show-with-value", p: 3, mb: 3, border: true, border_radius: 2) do %>
            <%= form_tag settings_billing_multi_checkout_enterprise_path(this_business), method: :put, id: 'upgrade-business-trial' do %>
              <%= hidden_field_tag :plan_duration, selected_duration, {class: "js-bus-duration-input"} %>
              <%= render(Growth::PricingSummaryComponent.new(
                test_selector: "yearly-summary",
                hidden: yearly_is_hidden,
              )) do |summary| %>
                <% summary.with_title { "Yearly summary" } %>
                <% summary.with_line_item do |item| %>
                  <% item.with_title { "Enterprise" } %>
                  <% item.with_description(classes: "multi-checkout-yearly-enterprise-description") {
                    yearly_summary.dig(:line_items, 0, :description) || ""
                  } %>
                  <% item.with_cost(classes: "multi-checkout-yearly-enterprise-cost") {
                    yearly_summary.dig(:line_items, 0, :cost) || ""
                  } %>
                <% end %>
              <% end %>

              <%= render(Growth::PricingSummaryComponent.new(
                test_selector: "monthly-summary",
                classes: "js-stepper-show-with-value",
                hidden: monthly_is_hidden,
              )) do |summary| %>
                <% summary.with_title { "Monthly summary" } %>
                <% summary.with_line_item(hidden: monthly_enterprise_line_item.nil?) do |item| %>
                  <% item.with_title { "Enterprise" } %>
                  <% item.with_description(classes: "multi-checkout-monthly-enterprise-description") {
                    monthly_enterprise_line_item&.fetch(:description) || ""
                  } %>
                  <% item.with_cost(classes: "multi-checkout-monthly-enterprise-cost") {
                    monthly_enterprise_line_item&.fetch(:cost) || ""
                  } %>
                <% end %>
                <% summary.with_line_item(classes: "js-stepper-show-with-value", hidden: monthly_advanced_security_line_item.nil?) do |item| %>
                  <% item.with_title { "Advanced Security" } %>
                  <% item.with_description(classes: "multi-checkout-monthly-advanced-security-description") {
                    monthly_advanced_security_line_item&.fetch(:description) || ""
                  } %>
                  <% item.with_cost(classes: "multi-checkout-monthly-advanced-security-cost") {
                    monthly_advanced_security_line_item&.fetch(:cost) || ""
                  } %>
                <% end %>
                <% summary.with_total do |total| %>
                  <% total.with_title { "Recurring total" } %>
                  <% total.with_cost(classes: "multi-checkout-monthly-total") {
                    monthly_summary&.fetch(:recurring_total) || ""
                  } %>
                <% end %>
              <% end %>

              <%= render(Growth::PricingSummaryComponent.new) do |summary| %>
                <% summary.with_line_item do |item| %>
                  <% item.with_title(tag: :h3) { "Due today" } %>
                  <% item.with_cost(classes: "multi-checkout-due-today") { due_today } %>
                <% end %>
                <% summary.with_sales_tax do |total| %>
                  <% if this_business.display_sales_tax_on_checkout? %>
                    <% total.with_title(test_selector: "sales-tax-label") { "Sales tax" } %>
                    <% total.with_cost(test_selector: "sales-tax-value") { "(applied to your invoice)" } %>
                  <% end %>
                <% end %>
              <% end %>


              <% submit_btn_text = "Complete GitHub Enterprise purchase" %>
              <%= render "businesses/billing_settings/checkout/terms_of_service", button_text: submit_btn_text %>

              <%= render Primer::Beta::Button.new(
                scheme: :primary,
                block: true,
                type: :submit,
                size: :large,
                disabled: !can_complete_purchase || this_business.has_trade_screening_restriction? || current_user.has_trade_screening_restriction?,
                test_selector: "complete-purchase-button",
                data: analytics_click_attributes(
                  category: "business_multi_checkout",
                  action: "click_to_complete_enterprise_purchase",
                  label: "ref_cta:complete_github_enterprise_purchase;ref_loc:account_upgrade;enterprise_id:#{this_business.id}",
                )
              ) do %>
                <%= submit_btn_text %>
              <% end %>
              <%= render Primer::Beta::Button.new(
                href: enterprise_path(this_business), block: true, tag: :a, mt: 2,
                data: analytics_click_attributes(
                  category: "business_multi_checkout",
                  action: "cancel_github_enterprise_purchase",
                  label: "enterprise_id:#{this_business.id}"
                ),
              ) do %>
                Cancel purchase
              <% end %>
            <% end %>
          <% end %>

          <% unless can_complete_purchase %>
            <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: :alert, mt: 3)) do |component| %>
              You have not added
              <% missing_items = [] %>
              <% missing_items << "billing information" unless completed_billing_information %>
              <% missing_items << "a payment method" unless completed_payment_method %>
              <%= missing_items.join(" and ") %>
              to your account
            <% end %>
          <% end %>
        </div>

        <% else %>
          <div class='col-md-5'>
            <%= render Primer::Box.new(classes: "js-stepper-show-with-value", p: 3, mb: 3, border: true, border_radius: 2) do %>
              <%= form_tag settings_billing_multi_checkout_enterprise_path(this_business), method: :put, id: 'upgrade-business-trial' do %>
                <%= hidden_field_tag :volume_to_metered, "true" %>
                <%= render(Growth::PricingSummaryComponent.new(
                  test_selector: "monthly-summary",
                  classes: "js-stepper-show-with-value",
                  hidden: monthly_is_hidden,
                )) do |summary| %>
                  <% summary.with_title { "Monthly summary" } %>
                  <% summary.with_line_item(hidden: monthly_enterprise_line_item.nil?) do |item| %>
                    <% item.with_title { "Enterprise Cloud" } %>
                    <% item.with_description(classes: "multi-checkout-monthly-enterprise-description") {
                      monthly_enterprise_line_item&.fetch(:description) || ""
                    } %>
                    <% item.with_cost(classes: "multi-checkout-monthly-enterprise-cost") {
                      monthly_enterprise_line_item&.fetch(:cost) || ""
                    } %>
                  <% end %>
                  <% summary.with_line_item(classes: "js-stepper-show-with-value", hidden: monthly_secret_protection_line_item.nil?) do |item| %>
                    <% item.with_title { "Secret Protection" } %>
                    <% item.with_description(classes: "multi-checkout-monthly-secret-protection-description") {
                      monthly_secret_protection_line_item&.fetch(:description) || ""
                    } %>
                    <% item.with_cost(classes: "multi-checkout-monthly-secret-protection-cost") {
                      monthly_secret_protection_line_item&.fetch(:cost) || ""
                    } %>
                  <% end %>
                  <% summary.with_line_item(classes: "js-stepper-show-with-value", hidden: monthly_code_security_line_item.nil?) do |item| %>
                    <% item.with_title { "Code Security" } %>
                    <% item.with_description(classes: "multi-checkout-monthly-code-security-description") {
                      monthly_code_security_line_item&.fetch(:description) || ""
                    } %>
                    <% item.with_cost(classes: "multi-checkout-monthly-code-security-cost") {
                      monthly_code_security_line_item&.fetch(:cost) || ""
                    } %>
                  <% end %>
                <% end %>

                <% if this_business.display_sales_tax_on_checkout? %>
                  <%= render(Growth::PricingSummaryComponent.new) do |summary| %>
                    <% summary.with_sales_tax do |total| %>
                      <% total.with_title(test_selector: "sales-tax-label") { "Sales tax" } %>
                      <% total.with_cost(test_selector: "sales-tax-value") { "(applied to your invoice)" } %>
                    <% end %>
                  <% end %>
                <% end %>

                <%= render(Growth::PricingSummaryComponent.new) do |summary| %>
                  <% summary.with_line_item do |item| %>
                    <% payment_frequency = selected_duration == "month" ? "Monthly" : "Yearly" %>
                    <% item.with_title(tag: :h3) { "Estimated #{payment_frequency} Payment" } %>
                    <% item.with_cost(classes: "multi-checkout-monthly-payment") {
                      monthly_summary&.fetch(:recurring_total) || Billing::Money.zero.format
                    } %>
                  <% end %>
                  <% summary.with_line_item do |item| %>
                    <% item.with_title(tag: :h3) { "Due today" } %>
                    <% item.with_cost(classes: "multi-checkout-due-today") { "$0.00" } %>
                  <% end %>
                <% end %>

                <% if params[:volume_to_metered].present? %>
                  Estimated cost starting on <b><%= volume_to_metered_transition_date.strftime('%B %d, %Y') %></b>.
                  If your transition occurs before the start of the month, your first bill will be prorated for the days you use.
                  <br>
                  <br>
                <% end %>
                <%= render Primer::Beta::Button.new(
                  scheme: :primary,
                  block: true,
                  type: :submit,
                  size: :large,
                  disabled: false,
                  id: "schedule-transition-button",
                  test_selector: "complete-metered-transition-button",
                  data: analytics_click_attributes(
                    category: "business_multi_checkout",
                    action: "click_to_complete_metered_transition",
                    label: "ref_cta:complete_metered_transition;ref_loc:account_upgrade;enterprise_id:#{this_business.id}",
                  )
                ) do %>
                  Schedule transition
                <% end %>

                <%= render Primer::Beta::Button.new(
                  href: enterprise_path(this_business), block: true, tag: :a, mt: 2,
                  data: analytics_click_attributes(
                    category: "business_multi_checkout",
                    action: "cancel_metered_transition",
                    label: "enterprise_id:#{this_business.id}"
                  ),
                ) do %>
                  Cancel
                <% end %>
                <div class="mt-3 text-center">
                  <p class="color-fg-muted f6">
                    By clicking Schedule transition you agree to our
                    <%= link_to "Terms of Service", "https://github.com/customer-terms", class: "Link--inTextBlock" %> and
                    <%= link_to "Privacy", "https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement", class: "Link--inTextBlock" %>.
                  </p>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
