<div class="Box tmp-mb-4 tmp-mt-4 wb-break-all">
  <div class="Box-header d-flex flex-items-center">
    <div class="Box-title flex-auto ml-1 pl-2">
    <div>Email contacts</div>
    </div>
    <div class="d-flex flex-justify-end">
      <%= form_tag enterprise_billing_emails_path(business), method: :post do %>
        <%= render(Primer::Alpha::Dialog.new(title: "Add billing contact")) do |dialog| %>
          <% dialog.with_show_button(font_size: :small, "aria-label": "Add billing contact email") { "Add" } %>
          <% dialog.with_header(show_divider: true, font_weight: :bold) { "Add billing contact" } %>
          <% dialog.with_body(my: 3) do %>
            <input
              type="text"
              name="billing_external_email"
              aria-label="Add billing contact email"
              class="form-control input-block input-contrast auto-search-input new-member-field"
              autofocus
              required
              placeholder="Add billing contact email">
          <% end %>
          <% dialog.with_footer do %>
            <%= render Primer::Beta::Button.new(type: :submit, block: true, "data-disable-with": "") do %>
              Add
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if business.billing_email.present? || business.billing_external_emails.any? %>
    <% if business.billing_email.present? %>
      <div>
        <div class="Box-row flex-items-center d-flex color-fg-muted">
          <div class="my-1">
            <%= primer_octicon(:person, size: :medium, color: :default) %>
          </div>
          <div class="tmp-ml-4">
            <%= business.billing_email %>
          </div>
          <div class="ml-1">
            <%= render Primer::Beta::Label.new(scheme: :secondary, title: "Label: Primary", classes: "tmp-ml-4") do %>
              Primary
            <% end %>
          </div>
          <div class="d-flex flex-justify-end ml-auto">
            <%= form_for business, url: update_primary_enterprise_billing_emails_path(business), method: :put do |f| %>
              <%= render(Primer::Alpha::Dialog.new(id: "edit-primary-email-dialog", title: "Edit billing email address")) do |dialog| %>
                <% dialog.with_show_button(icon: :pencil, scheme: :invisible, size: :small, "aria-label": "Edit primary email address", show_tooltip: true) %>
                <% dialog.with_header(show_divider: true, font_weight: :bold) { "Edit billing email address" } %>
                <% dialog.with_body(my: 3) do %>
                  <dl class="form-group mt-0">
                    <% label_html = content_tag(:small, "Billing email (primary)") %>
                    <dt><%= f.label :billing_email, label_html %></dt>
                    <dd><%= f.text_field :billing_email, autofocus: true %></dd>
                  </dl>
                <% end %>
                <% dialog.with_footer do %>
                  <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary, block: true, "data-disable-with": "") do %>Update<% end %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <% business.billing_external_emails.each do |line| %>
      <div class="Box-row flex-items-center d-flex color-fg-muted">
        <div class="d-flex my-1">
          <%= primer_octicon(:person, size: :medium, color: :default) %>
        </div>
        <div class="tmp-ml-4 d-flex flex-1">
          <%= line.email %>
        </div>

        <%= render(Primer::Alpha::ActionMenu.new) do |menu| %>
          <% menu.with_show_button(size: :small, icon: 'kebab-horizontal', aria: { label: "Show options for #{line.email}" }, scheme: :invisible) %>
          <% menu.with_item(
            label: "Mark as primary",
            href: mark_primary_enterprise_billing_emails_path(business, line.id),
            form_arguments: {
              method: :put,
            }
          ) %>
          <% menu.with_item(
            label: "Remove",
            scheme: :danger,
            content_arguments: { "data-show-dialog-id": "delete-contact-dialog-#{line.id}" },
          ) %>
        <% end %>

        <%= render(Primer::Alpha::Dialog.new(id: "delete-contact-dialog-#{line.id}", title: "Remove email contact")) do |dialog| %>
          <% dialog.with_header(show_divider: true, font_weight: :bold) { "Remove email contact" } %>
          <% dialog.with_body(my: 3) do %>
            Are you sure you want to remove (<%= line.email %>) from the billing contacts?
          <% end %>
          <% dialog.with_footer do %>
            <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "delete-contact-dialog-#{line.id}" })) { "Cancel" } %>
            <%= form_tag enterprise_billing_email_path(business, line.id), :method => :delete do %>
              <%= render Primer::Beta::Button.new(type: :submit, scheme: :danger) do %>
                  Delete
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%= render Primer::Beta::Blankslate.new do |component| %>
      <% component.with_heading(tag: :h2).with_content("No email contacts") %>
    <% end %>
  <% end %>
</div>
