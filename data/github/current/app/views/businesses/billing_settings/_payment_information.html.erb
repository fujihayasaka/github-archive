<% show_form ||= !!flash[:address_validation_error] %>
<% return_to ||= nil %>
<div>
  <div class="js-billing-settings-billing-information-form-container js-name-address-collection" <%= "hidden" unless show_form %>>
    <%= render Billing::Settings::BusinessEditPaymentInformationComponent.new(business: this_business, return_to: return_to, show_form: show_form) %>
  </div>
  <div class="js-billing-settings-billing-information" <%= "hidden" if show_form %>>
    <% if this_business.has_saved_billing_contact_with_information? %>
      <div <%= test_selector("billing-address") %>>
        <%= render Primer::Beta::Text.new(color: :muted) do %>
          <%= this_business.billing_contact.entity_name %>
        <% end %>
        <div class="color-fg-muted mt-2">
          <p class="mb-0"><%= this_business.billing_contact.address1 %></p>
          <% unless this_business.billing_contact.address2.blank? %>
            <p class="mb-0"><%= this_business.billing_contact.address2 %></p>
          <% end %>
          <p class="mb-0">
            <%= this_business.billing_contact.city %><%= "," unless this_business.billing_contact.region.blank? %>
            <%= this_business.billing_contact.region %>
            <%= this_business.billing_contact.postal_code %>
          </p>
          <p class="mb-0"><%= this_business.billing_contact.country_code %></p>
          <% unless this_business.billing_contact.vat_code.blank? %>
            <p class="mt-2 mb-0">VAT/GST: <%= this_business.billing_contact.vat_code %></p>
          <% end %>
        </div>
      </div>
    <% else %>
      You have not added billing information for your account.
    <% end %>
  </div>
</div>
