<% if GitHub.terms_of_service_enabled? %>
  <%= render Primer::Alpha::CheckBox.new(
    name: "agreed_to_terms",
    value: "1",
    required: true,
    # No user input is used to generate this text, but the generated link has HTML that can't be escaped otherwise using the
    # Primer component.
    # rubocop:disable Rails/OutputSafety
    label: "By clicking \"#{button_text}\", you are accepting the
    #{link_to "GitHub Customer Agreement", customer_term_index_path, target: :_blank, rel: "noopener noreferrer", class: "Link--inTextBlock"}
    and confirming that you have the authority to do so on behalf of your organization.".html_safe,
    label_arguments: { mb: 3, font_size: 6, font_weight: :normal, color: :muted }
  ) %>
  <%= render Primer::Beta::Text.new(tag: :p, mb: 3, ml: 4, font_size: 6, color: :muted) do %>
    For more information about GitHub's privacy practices, see the
    <%= link_to "GitHub Privacy Statement", site_privacy_path, target: :_blank, rel: "noopener noreferrer", class: "Link--inTextBlock" %>
  <% end %>
<% end %>
