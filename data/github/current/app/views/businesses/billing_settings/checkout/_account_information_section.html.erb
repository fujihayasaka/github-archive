<%= render(Billing::Settings::Upgrade::SectionComponent.new(title: "Account", icon: :"mark-github")) do |component| %>
  <% component.with_body do %>
    <%= render Primer::Box.new(border: true, border_radius: 2, classes: "tmp-p-3 tmp-mt-3") do %>
      <%= render Primer::Box.new(display: :flex, justify_content: :space_between) do %>
        <%= render Primer::Box.new(display: :flex, align_items: :center) do %>
          <%= render(GitHub::AvatarComponent.new(actor: this_business, size: 40, classes: "tmp-mr-3")) %>
          <%= render Primer::Box.new(flex: :auto) do %>
            <%= render Primer::Beta::Heading.new(tag: :h3) do %>
              <%= link_to settings_account_path(this_business), target: :_blank, class: "color-fg-default" do %>
                <%= this_business.name %>
                <span class="sr-only">settings</span>
              <% end %>
            <% end %>
            <%= render Primer::Beta::Text.new(color: :muted) do %>
              <%= this_business.billing_contact.entity_name %>
            <% end %>
          <% end %>
        <% end %>

        <% if this_business.invoiced? %>
          <%= render Primer::Box.new(display: :flex, direction: :column, align_items: :flex_end, text_align: :right, classes: "tmp-ml-3") do %>
            <%= render(Primer::Beta::Text.new(color: :muted, font_size: 6, classes: "no-wrap")) do %>
              <% if this_business.billing_term_expired? %>
                Your contract expired on
              <% else %>
                Contract valid until
              <% end %>
            <% end %>
            <%= render(Primer::Beta::Text.new(font_size: 6, font_weight: :bold)) { this_business.billing_term_ends_on.strftime("%b %d, %Y") }%>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
