<%= render(Billing::Settings::Upgrade::SectionComponent.new(
  title: "Billing information",
  icon: completed_billing_information ? :"check-circle-fill" : :mail,
  test_selector: "billing_information"
)) do |component| %>
  <% component.with_button(
    size: :medium,
    px: 3,
    font_size: 6,
    test_selector: "edit-billing-info-button",
    classes: "js-billing-settings-billing-information-edit-button",
    hidden: !completed_billing_information || !this_business.is_allowed_to_edit_trade_screening_information?
  ) do %>
    Edit<span class="sr-only">&nbsp;billing information</span>
  <% end %>
  <% component.with_body(p: 3, mt: 3, border: true, border_radius: 2) do %>
    <%= render "businesses/billing_settings/payment_information",
      business: this_business,
      show_form: !completed_billing_information,
      return_to: return_to
    %>
  <% end %>
<% end %>
