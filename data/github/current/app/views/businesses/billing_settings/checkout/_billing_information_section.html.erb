<%= render(Billing::Settings::Upgrade::SectionComponent.new(
  title: "Billing information",
  icon: completed_billing_information ? :"check-circle-fill" : :mail,
  test_selector: "billing_information"
)) do |component| %>
  <% component.with_button(
    size: :medium,
    px: 3,
    font_size: 6,
    test_selector: "edit-billing-info-button",
    classes: "js-billing-settings-billing-information-edit-button",
    hidden: !completed_billing_information || !this_business.is_allowed_to_edit_billing_information?
  ) do %>
    Edit<span class="sr-only">&nbsp;billing information</span>
  <% end %>
  <% component.with_body(p: 3, mt: 3, border: true, border_radius: 2) do %>
    <% if params[:volume_to_metered].blank? %>
      <%= render "businesses/billing_settings/payment_information",
        business: this_business,
        show_form: !completed_billing_information,
        return_to: return_to
      %>
    <% else %>
      <div class="d-flex">
        <div class="col-5 pr-3 border-right d-flex align-items-start justify-content-start" style="overflow: hidden;">
          <div class="d-flex align-items-center" style="min-width: 0; width: 100%;">
            <%= render Primer::Beta::Avatar.new(
              src: this_business.primary_avatar_url,
              alt: this_business.name,
              size: 48,
              shape: :circle,
              classes: "mr-3 flex-shrink-0"
            ) %>
            <div style="min-width: 0; overflow: hidden;">
              <div class="text-bold mb-1 text-truncate"><%= this_business.name %></div>
              <div class="text-small color-fg-muted">Enterprise Account</div>
            </div>
          </div>
        </div>
        <div class="col-7 pl-3" style="overflow: hidden; min-width: 0;">
          <%= render "businesses/billing_settings/payment_information",
            business: this_business,
            show_form: !completed_billing_information,
            return_to: return_to,
            constrained_layout: true
          %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
