<%# locals: (options:, menu_id:, label:) %>

<%= render Primer::Alpha::SelectPanel::ItemList.new(
  id: menu_id,
  aria: { label: },
  select_variant: :multiple,
  test_selector: ::SecurityCenter::SelectPanelComponent::DROPDOWN_TEST_SELECTOR,
) do |list| %>
  <% options.each do |option| %>
    <% list.with_item(
      label: option.text,
      href: option.href,
      active: option.selected,
      test_selector: ::SecurityCenter::SelectPanelComponent::ITEM_TEST_SELECTOR,
    ) do |item| %>
      <% item.with_description(option.description) %>
    <% end %>
  <% end %>
<% end %>
