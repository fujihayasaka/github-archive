<% page_info title: "Security · Code Scanning · #{this_business}", selected_link: :business_security_center_alerts_code_scanning, sidebar: :code_security %>

<%= render Primer::Box.new(mb: 3, test_selector: "code-scanning-new-sso-banner") do %>
  <%= render_react_partial name: "single-sign-on-dropdown-partial", props: sso_payload, disable_ssr: true %>
<% end %>

<%= render(SecurityCenter::SubheadComponent.new(
  actor: current_user,
  scope: this_business,
  heading: "Code scanning alerts",
)) do |c|
  c.with_phase_label
  c.with_feedback_link
end %>

<% if show_code_scanning_getting_started_info %>
  <%= render(Primer::Beta::BorderBox.new) do |border_box_component| %>
    <% border_box_component.with_body do %>
      <%= render(
          Primer::Beta::Blankslate.new(
            spacious: false,
            test_selector: "security-center-code-scanning-getting-started-info",
          )
        ) do |component| %>
          <% component.with_visual_icon(icon: :codescan, size: :medium) %>
          <% component.with_heading(tag: :h2) do %>
            Add a repository with code <%= "to an organization" unless business.organizations.empty? %> to see code
            scanning alerts.
          <% end %>
          <% component.with_description do %>
            <%= render Primer::Beta::Text.new(tag: :p) do %>
              Start by
              <% if business.organizations.empty? %>
                creating an organization, adding a repository,
              <% else %>
                adding a repository to an organization
              <% end %>
              and pushing code. Code scanning will automatically check for security vulnerabilities and help you find
              and fix issues early.
            <% end %>
          <% end %>
          <% if business.organizations.empty? %>
            <% component.with_primary_action(href: new_enterprise_onboarding_organization_path(business)) do %>
              Create an organization
            <% end %>
            <% component.with_secondary_action(href: new_enterprise_organization_invitation_path(business)) do %>
              Invite an organization
            <% end %>
          <% else %>
            <% component.with_primary_action(href: enterprise_organizations_path(business)) do %>
              Add a repository to an organization
            <% end %>
            <% component.with_secondary_action(href: DocsUrlConfig.url_for("code-security/about-code-scanning")) do %>
              Read more on code scanning
            <% end %>
          <% end %>
        <% end %>
    <% end %>
  <% end %>
<% else %>
  <% if authorized_orgs.any? %>
    <%= render Primer::Box.new(mb: 3, display: :flex, justify_content: :space_between, style: "gap: 1em;") do %>
      <%= render Primer::Box.new(flex: 1) do %>
        <%= render CodeScanning::AlertFilterComponent.new(
          user: current_user,
          business: business,
          query: query,
          autofix_generated_filter_enabled: current_user.feature_flag_enabled?(:autofix_alert_filter, default: false),
          autofix_accepted_filter_enabled: current_user.feature_flag_enabled?(:autofix_alert_filter, default: false),
          autofix_allowed_by_entity: CodeScanning::Autofix.any_allowed_by_business?(business),
        ) %>
      <% end %>

      <% if menu_data_list.present? %>
        <%= render Primer::Box.new(display: :flex, align_items: :center, style: "height: 32px;") do %>
          <% menu_data_list.each do |menu_data| %>
            <%= render SecurityCenter::SelectPanelComponent.new(menu_data) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render CodeScanning::TableComponent.new(
      business: business,
      open_count: open_count,
      closed_count: closed_count,
      query: query,
      user: current_user,
      alerts_code_scanning_index_path_method: alerts_code_scanning_index_path_method,
      fixed_result_numbers: [],
      alert_results: alert_results,
      alert_number_plus_repository_id_to_assignees:,
    ) %>
  <% end %>

  <% if blankslate_text %>
    <% icon = error_occurred ? "alert" : nil %>
    <% box_options = authorized_orgs.any? ? { border_top: 0, classes: "rounded-top-0" } : {} %>
    <%= render(Primer::Beta::BorderBox.new(**box_options)) do |border_box_component| %>
      <% border_box_component.with_body do %>
        <%= render(
          Primer::Beta::Blankslate.new(
            spacious: true,
            test_selector: "security-center-alert-centric-views-code-scanning-blankslate",
          )
        ) do |c| %>
          <% if icon.present?
              c.with_visual_icon(icon: icon) # Icon takes precedence over the image
            else
              c.with_visual_image(src: "modules/site/icons/security.svg", alt: "Security icon")
            end %>
          <% c.with_heading(tag: :h3) do %>
            <%= blankslate_text %>
          <% end %>
          <% c.with_description do %>
            <% if authorized_orgs.empty? %>
              <%= render(Primer::Beta::Text.new(tag: :p).with_content("Repositories are shown only for organizations where you are an owner or security manager.")) %>
            <% elsif error_occurred %>
              <% if GitHub.enterprise? %>
                <p>If the problem persists <%= contact_support_snippet(true) %>.</p>
              <% else %>
                <%= render(Primer::Beta::Text.new(tag: :p)) do %>
                  We track these errors automatically, but if the problem persists feel free to
                  <%= render(Primer::Beta::Link.new(href: contact_path, classes: "Link--inTextBlock")) { "contact us" } %>.
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if alert_results.total_pages > 1 %>
    <div class="paginate-container" <%= test_selector("paginate-container") %>>
      <%= will_paginate alert_results %>
    </div>
  <% end %>
<% end %>
