<% page_info title: "Security · Secret Scanning · #{this_business}", selected_link: :business_security_center_alerts_secret_scanning, sidebar: :code_security %>

<%= render Primer::Box.new(mb: 3, test_selector: "secret-scanning-new-sso-banner") do %>
  <%= render_react_partial name: "single-sign-on-dropdown-partial", props: sso_payload, disable_ssr: true %>
<% end %>

<%= render(SecurityCenter::SubheadComponent.new(
  actor: current_user,
  scope: this_business,
  heading: "Secret scanning alerts",
)) do |c|
  c.with_phase_label
  c.with_feedback_link
end %>

<%= main_section %>
