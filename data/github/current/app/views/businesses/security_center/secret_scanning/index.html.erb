<% page_info title: "Security · Secret Scanning · #{this_business}", selected_link: :business_security_center_alerts_secret_scanning, sidebar: :code_security %>

<%= render Primer::Box.new(mb: 3, test_selector: "secret-scanning-new-sso-banner") do %>
  <%= render_react_partial name: "single-sign-on-dropdown-partial", props: sso_payload, disable_ssr: true %>
<% end %>

<% slug = "secret-protection-feedback-survey" %>
<% if Copilot::FeedbackSurvey.show_survey_for_user(current_user, slug) %>
  <div class="clearfix mb-3 mt-3">
    <% banner = Copilot::FeedbackSurvey.self_serve_banner(slug) %>
    <%= render_react_partial name: "copilot-survey", props: {
      bannerText: banner&.body,
      bannerTitle: banner&.title,
      ctaUrl: banner&.cta_url,
      ctaText: banner&.cta_text,
      bannerSlug: banner&.slug,
      surveyOpenCallbackPath: copilot_feedback_survey_open_path,
      surveyDismissCallbackPath: copilot_feedback_survey_dismiss_path,
      icon: "shield",
    } %>
  </div>
<% end %>

<%= render(SecurityCenter::SubheadComponent.new(
  actor: current_user,
  scope: this_business,
  heading: "Secret scanning alerts",
)) do |c|
  c.with_phase_label
  c.with_feedback_link
end %>

<% if show_secret_scanning_getting_started_info %>
  <%= render(Primer::Beta::BorderBox.new) do |border_box_component| %>
    <% border_box_component.with_body do %>
      <%= render(
        Primer::Beta::Blankslate.new(
          spacious: false,
          test_selector: "security-center-secret-scanning-getting-started-info",
        )
      ) do |component| %>
        <% component.with_visual_icon(icon: :codescan, size: :medium) %>
        <% component.with_heading(tag: :h2) do %>
          Add a repository with code <%= "to an organization" unless this_business.organizations.empty? %> to see
          secret scanning alerts.
        <% end %>
        <% component.with_description do %>
          <%= render Primer::Beta::Text.new(tag: :p) do %>
            Start by
            <% if this_business.organizations.empty? %>
              creating an organization, adding a repository,
            <% else %>
              adding a repository to an organization
            <% end %>
            and pushing code. Secret scanning will automatically check for security vulnerabilities and help you find
            and fix issues early.
          <% end %>
        <% end %>
        <% if this_business.organizations.empty? %>
          <% component.with_primary_action(href: new_enterprise_onboarding_organization_path(this_business)) do %>
            Create an organization
          <% end %>
          <% component.with_secondary_action(href: new_enterprise_organization_invitation_path(this_business)) do %>
            Invite an organization
          <% end %>
        <% else %>
          <% component.with_primary_action(href: enterprise_organizations_path(this_business)) do %>
            Add a repository to an organization
          <% end %>
          <% component.with_secondary_action(href: DocsUrlConfig.url_for("code-security/about-secret-scanning")) do %>
            Read more on secret scanning
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= main_section %>
<% end %>
