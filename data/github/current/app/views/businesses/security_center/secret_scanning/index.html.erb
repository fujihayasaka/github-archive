<% page_info title: "Security · Secret Scanning · #{this_business}", selected_link: :business_security_center_alerts_secret_scanning, sidebar: :code_security %>

<%= render Primer::Box.new(mb: 3, test_selector: "secret-scanning-new-sso-banner") do %>
  <%= render_react_partial name: "single-sign-on-dropdown-partial", props: sso_payload, disable_ssr: true %>
<% end %>

<% slug = "secret-protection-feedback-survey" %>
<% if Copilot::FeedbackSurvey.show_survey_for_user(current_user, slug) %>
  <div class="clearfix mb-3 mt-3">
    <% banner = Copilot::FeedbackSurvey.self_serve_banner(slug) %>
    <%= render_react_partial name: "copilot-survey", props: {
      bannerText: banner&.body,
      bannerTitle: banner&.title,
      ctaUrl: banner&.cta_url,
      ctaText: banner&.cta_text,
      bannerSlug: banner&.slug,
      surveyOpenCallbackPath: copilot_feedback_survey_open_path,
      surveyDismissCallbackPath: copilot_feedback_survey_dismiss_path,
      icon: "shield",
    } %>
  </div>
<% end %>

<%= render(SecurityCenter::SubheadComponent.new(
  actor: current_user,
  scope: this_business,
  heading: "Secret scanning alerts",
)) do |c|
  c.with_phase_label
  c.with_feedback_link
end %>

<%= main_section %>
