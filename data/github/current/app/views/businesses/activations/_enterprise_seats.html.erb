<%= render(Primer::Alpha::Dialog.new(title: "#{billed_item[:label]}")) do |d| %>
  <% d.with_show_button(
    scheme: :invisible,
    color: :muted,
    icon: :info,
    size: :small,
    p: 0,
    show_tooltip: false,
    aria: { label: "Learn more about how to modify #{billed_item[:label]} usage" },
    test_selector: "info-#{billed_item[:id]}"
    ) %>

  <% d.with_body do %>
    <%= render(Primer::Beta::Text.new(tag: :div, classes: "color-fg-muted mb-2")) do %>
      Organization members and outside collaborators consume Enterprise Cloud seats.
      Remove all organizations from <%= business.name %> if you don’t want to upgrade with Enterprise Cloud seats.
    <% end %>

    <%= render(Primer::Beta::Link.new(href: "#", classes: "mt-2")) do |link| %>
      <% link.with_leading_visual_icon(icon: "link-external") %>
      Removing an organization from your enterprise
    <% end %>
    <br>
    <%= render(Primer::Beta::Link.new(href: "#")) do |link| %>
      <% link.with_leading_visual_icon(icon: "link-external") %>
      Transferring an organization between enterprise accounts
    <% end %>

  <% end %>
  <% d.with_footer do %>
    <%= render Primer::Beta::Button.new(scheme: :primary, type: :button, data: { "close-dialog-id": d.id }) do %>Got it<% end %>
  <% end %>
<% end %>
