<div class="col-6 d-flex flex-items-center">
  <% if two_factor_policy == "enabled" %>
    <%= render Primer::Beta::Octicon.new(icon: "shield-lock", color: :muted, aria: { label: "2FA:" }, test_selector: "enterprise-org-#{organization.id}-2fa-state-icon", classes: "mr-1") %>
    <span class="mr-1 color-fg-muted" <%= test_selector "enterprise-org-#{organization.id}-2fa-policy-enforced" %>>
      Enforced
    </span>
  <% end %>
</div>
<div class="col-4 d-flex flex-items-center">
  <% if !members_count.nil? && members_count > 0 %>
    <%= render Primer::Beta::Octicon.new(icon: "person", color: :muted, aria: { label: "Members:" }, classes: "mr-1") %>
    <span class="mr-1 color-fg-muted" <%= test_selector "enterprise-org-#{organization.id}-members-counter" %>>
      <%= number_with_delimiter(members_count) %>
    </span>
  <% end %>
</div>
<div class="col-4 d-flex flex-items-center">
  <% if !repos_count.nil? && repos_count > 0 %>
    <%= render Primer::Beta::Octicon.new(icon: "repo", color: :muted, aria: { label: "Repositories:" }, classes: "mr-1") %>
    <span class="mr-1 color-fg-muted" <%= test_selector "enterprise-org-#{organization.id}-repos-counter" %>>
      <%= number_with_delimiter(repos_count) %>
    </span>
  <% end %>
</div>
<div class="col-4 d-flex flex-items-center">
  <% if deploy_key_count && deploy_key_count > 0 %>
    <%= render Primer::Beta::Octicon.new(icon: "key", color: :muted, aria: { label: "Deploy keys:" }, test_selector: "enterprise-org-#{organization.id}-deploy-keys-counter-icon", classes: "mr-1") %>
    <span class="mr-1 color-fg-muted" <%= test_selector "enterprise-org-#{organization.id}-deploy-keys-counter-#{deploy_key_count}" %>>
      <%= number_with_delimiter(deploy_key_count) %>
    </span>
  <% end %>
</div>
