<div class="col-4">
  <% if two_factor_policy == "enabled" %>
    <%= render Primer::Beta::Octicon.new(icon: "shield-lock", aria: { label: "2FA:" }, test_selector: "enterprise-org-#{organization.id}-2fa-state-icon") %>
    <span class="mr-1" <%= test_selector "enterprise-org-#{organization.id}-2fa-policy-enforced" %>>
      Enforced
    </span>
  <% end %>
</div>
<div class="col-4">
  <% if !members_count.nil? && members_count > 0 %>
    <%= render Primer::Beta::Octicon.new(icon: "person", aria: { label: "Members:" }) %>
    <span class="mr-1" <%= test_selector "enterprise-org-#{organization.id}-members-counter" %>>
      <%= number_with_delimiter(members_count) %>
    </span>
  <% end %>
</div>
<div class="col-4">
  <% if !repos_count.nil? && repos_count > 0 %>
    <%= render Primer::Beta::Octicon.new(icon: "repo", aria: { label: "Repositories:" }) %>
    <span class="mr-1" <%= test_selector "enterprise-org-#{organization.id}-repos-counter" %>>
      <%= number_with_delimiter(repos_count) %>
    </span>
  <% end %>
</div>
<div class="col-4">
  <% if deploy_key_count && deploy_key_count > 0 %>
    <%= render Primer::Beta::Octicon.new(icon: "key", aria: { label: "Deploy keys:" }, test_selector: "enterprise-org-#{organization.id}-deploy-keys-counter-icon") %>
    <span class="mr-1" <%= test_selector "enterprise-org-#{organization.id}-deploy-keys-counter-#{deploy_key_count}" %>>
      <%= number_with_delimiter(deploy_key_count) %>
    </span>
  <% end %>
</div>
