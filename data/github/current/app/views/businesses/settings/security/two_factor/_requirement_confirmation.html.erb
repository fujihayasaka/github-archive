<%
  users_with_two_factor_disabled = business.affiliated_users_with_two_factor_disabled
  users_with_two_factor_disabled_to_display = users_with_two_factor_disabled.first(100)
  affiliated_users_with_two_factor_disabled = business.affiliated_users_with_two_factor_disabled
  outside_collaborators_with_two_factor_disabled = business.outside_collaborators_with_two_factor_disabled
  members_owners_admins_with_two_factor_disabled = affiliated_users_with_two_factor_disabled - outside_collaborators_with_two_factor_disabled
  users_with_two_factor_disabled_to_display = members_owners_admins_with_two_factor_disabled.first(100)
  outside_collaborators_with_two_factor_disabled_to_display = outside_collaborators_with_two_factor_disabled.first(100)
%>

<input id="two-factor-business-name" type="hidden" name="business_name" value="<%= business.name %>">

<%
  if business.two_factor_requirement_enabled?
    dialog_title = "Are you sure you want to remove the two-factor authentication for all organizations in #{business.name}?"
    button_scheme = :danger
  else
    dialog_title = "Are you sure you want to require two-factor authentication for all organizations in #{business.name}?"
    button_scheme = :primary
  end
%>

<%= render layout: "shared/details_dialog", locals: {
    button_text: "Save",
    button_class: "btn js-business-two-factor-submit-button float-left mr-4",
    disabled: true,
    details_class: "d-inline-block js-business-two-factor-confirmation-dialog",
    title: dialog_title,
  } do %>
    <div class="m-2">
      <div class="ml-2 my-2 js-business-two-factor-confirmation-dialog-body">
        <%#
          Based on the changes the current state and the user has made to the checkboxes, we need to dyamically
          update the contents of the confirmation dialog.  So we render all of them as hidden spans and dynamically
          unhide then prior to showing the dialog with JS.

          The title of the dialog in updated directly in the Typescript code because it is a string, not HTML content.
        %>

        <%# disabling requirement entirely (default if require enabled) %>
        <span id="tfrc-disabling-requirement" <%= "hidden" unless business.two_factor_requirement_enabled? %>>
          <p>Two-factor authentication will no longer be required to access any organization's resources in the <%= business.name %> enterprise.</p>
          <p>Organizations that previous had set two-factor authentication requirements will keep those requirements.</p>
          <p>Users' two-factor authentication methods will not be affected.</p>
        </span>

        <%# enabling requirement w/ secure methods %>
        <span id="tfrc-enabling-requirement-with-secure-methods" hidden>
          <p>Users will be required to set up two-factor authentication using a secure method in order to access organizations.</p>
        </span>

        <%# enabling requirement w/o secure methods (default if requirement disabled) %>
        <span id="tfrc-enabling-requirement-without-secure-methods" <%= "hidden" if business.two_factor_requirement_enabled? %>>
          <p>Users will be required to set up two-factor authentication in order to access organizations.</p>
        </span>

        <%# disabling secure methods for existing requirement %>
        <span id="tfrc-disabling-secure-methods-only" hidden>
          <p>Secure methods of two-factor authentication will no longer be required to access any organization's resources in the <%= business.name %> enterprise.</p>
          <p>Organizations that previous required secure two-factor authentication methods will keep those requirements.</p>
          <p>Users' two-factor authentication methods will not be affected.</p>
        </span>

        <%# enabling secure methods for existing requirement %>
        <span id="tfrc-enabling-secure-methods-only" hidden>
          <p>Users will be required to set up two-factor authentication using a secure method in order to access organizations.</p>
        </span>
      </div>

      <%= render Primer::Beta::Button.new(
        type: :submit,
        block: true,
        scheme: button_scheme,
        mt: 2,
        w: :auto,
        float: :right,
        classes: "js-business-two-factor-confirmation-dialog-button",
        "data-disable-invalid": "",
        "data-disable-with": ""
      ) do %>
        Confirm
      <% end %>
    </div>
  <% end %>
