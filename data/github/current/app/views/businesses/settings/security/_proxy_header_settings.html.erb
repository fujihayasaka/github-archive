<div <%= test_selector("proxy-header-settings") %>>
  <%= render Primer::Beta::Subhead.new(spacious: true) do |component| %>
    <% component.with_heading(tag: :h2, display: :flex, align_items: :center) do %>Enterprise access restrictions<% end %>
  <% end %>
  <div class="saml-settings-form">
    <p>
      Proxy Header: <code><%= view.proxy_header_value %></code>
    </p>
    <p class="note color-fg-muted">
      Your enterprise can enforce enterprise access restrictions using your network proxy. Using your network proxy, inject the header shown above into every request to *.github.com/*. In addition, ensure that port 22 (SSH) is blocked on your network. For more details, contact your account manager.
    </p>
    <% if FeatureFlag.vexi.enabled?(:enterprise_access_verification_ga, this_business, default: false) %>
      <%= form_tag enterprise_proxy_security_header_path(this_business), method: :patch do |f| %>
        <div class="form-checkbox">
          <input id="enable_enterprise_access_restrictions" type="checkbox" name="enable_enterprise_access_restrictions" <%= "checked" if this_business.proxy_security_header_enabled? %> >
          <label for="enable_enterprise_access_restrictions">Enable enterprise access restriction</label>
          <p class="note color-fg-muted">
            Enabling will allow you to restrict access by proxy header using the network proxy owned by this enterprise.
          </p>
        </div>
        <%= render Primer::Beta::Button.new(type: :submit) do %>Save<% end %>
      <% end %>
    <% end %>
  </div>
</div>
