<% view ||= Businesses::Settings::SecurityView.new(business: business, current_user: current_user) %>

<label class="<%= "color-fg-muted" if view.two_factor_requirement_form_disabled? %>">
  <% if business.updating_two_factor_requirement? %>
    <%= render GitHub::PollIncludeFragmentComponent.new(src: two_factor_secure_methods_requirement_enterprise_path(business, page: "secure_methods"), "data-reload": "") do %>
      <%= render(Primer::Beta::Spinner.new(size: :small, classes: "loading-spinner")) %>
      Only allow secure two-factor methods
    <% end %>
  <% else %>
    <input type="hidden"
           name="two_factor_secure_methods_required"
           value="no_policy">
    <input type="checkbox"
           name="two_factor_secure_methods_required"
           value="enabled"
           class="js-business-enable-two-factor-secure-methods"
           <%= 'checked' if view.two_factor_secure_methods_required? || !view.two_factor_requirement_enabled? %>
           <%= 'disabled' if view.two_factor_requirement_form_disabled? %>>
    <input type="hidden"
           class="js-business-two-factor-secure-methods-currently-enabled"
           value="<%= view.two_factor_secure_methods_required? ? "1" : "0" %>">
    Only allow secure two-factor methods
    <% if !view.two_factor_secure_methods_required? %>
         <%= render(Primer::Beta::Label.new(scheme: :accent, ml: 1, vertical_align: :middle)) { "Recommended" } %>
    <% end %>
  <% end %>
</label>
