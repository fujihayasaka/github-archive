<%# erblint:counter DeprecatedComponentsCounter 1 %>
<div <%= test_selector("scim-configuration") %>>
  <%= render Primer::Beta::Subhead.new(spacious: true) do |component| %>
    <% component.with_heading(tag: :h2, display: :flex, align_items: :center) do %>
      SCIM Configuration
    <% end %>
  <% end %>
  <div class="saml-settings-form">
    <%= form_tag enterprise_scim_configuration_path(this_business), method: :patch do |f| %>
      <div class="form-checkbox">
        <input id="scim_configuration" type="checkbox" name="scim_configuration"
                <%= "checked" if this_business.saml_sso_enabled? && this_business.open_scim_enabled? %>>
        <label for="scim_configuration">Enable SCIM configuration</label>
        <p class="note color-fg-muted">
          If enabled, your enterprise's SCIM API endpoints will permit reads and writes from any authorized personal access token.
          All SCIM calls should be backed by a single source of truth in your identity system.
          Please note that enabling SCIM provisioning will disable SAML Just-In-Time provisioning of users.
          <%= render(Primer::Beta::Link.new(href: DocsUrlConfig.url_for("enterprise-admin/scim"), classes: "Link--inTextBlock")) { "Learn more." } %>
        </p>
      </div>
      <%= render Primer::ButtonComponent.new(
        type: :submit,
        ml: 3,
        classes: "js-scim-configuration-submit",
        test_selector: "scim-configuration-submit",
        disabled: true,
      ) do %>Save<% end %>

      <% dialog_id = "disable-scim-dialog" %>
      <%= render Primer::Alpha::Dialog.new(
        id: dialog_id,
        title: "Are you sure you want to disable SCIM?",
        test_selector: "disable_scim_confirmation"
      ) do |d| %>
        <% d.with_body(mt: 3) do %>
          <p>
            You are disabling SCIM provisioning on this appliance.
            Review <%= render(Primer::Beta::Link.new(href: DocsUrlConfig.url_for("enterprise-admin/disabling-scim"), classes: "Link--inTextBlock")) { "this article" } %> for more details about the impact of this change, and select Save if you would like to proceed.
          </p>
        <% end %>

        <% d.with_footer do %>
          <%= render Primer::Beta::Button.new(type: :button, data: { "close-dialog-id": dialog_id }) do %>
            Cancel
          <% end %>
            <%= render Primer::Beta::Button.new(scheme: :danger, type: :submit) do %>
              Save
            <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
