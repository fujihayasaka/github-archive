<% page_title = "Advanced Security" %>

<% page_info title: "#{page_title} policies",
  selected_link: :business_code_security_and_analysis,
  sidebar: :policies,
  stafftools: stafftools_enterprise_path(business)
%>

<%= render layout: "businesses/layout", locals: {
  business: business,
  title: page_title,
  container_attributes: "itemscope itemtype='http://schema.org/Business'"
} do %>

  <% if show_secret_scanning %>
    <%= render Primer::Alpha::UnderlineNav.new(label: "Code security policies", mb: 3) do |component| %>
      <% component.with_tab(
        href: settings_security_analysis_policies_enterprise_path,
        id: :policies,
        selected: true,
        test_selector: "code-security-policies-tab"
      ) { "Policies" } %>

      <% component.with_tab(
        href: settings_security_analysis_policies_security_features_enterprise_path,
        id: :security_features,
        test_selector: "code-security-security-features-tab"
      ) { "Security features" } %>
    <% end %>
  <% end %>

  <% if show_advanced_security %>
    <h2 class="mb-3">General</h2>
    <% if business.advanced_security_products_bundled? %>
      <%= render Primer::Box.new(mb: 6) do %>
        <%= render Businesses::Policies::SecurityAnalysis::GhasAvailabilityComponent.new(business: business) %>
        <% if is_advanced_security_available_on_selected_org %>
          <%= render Businesses::Policies::SecurityAnalysis::GhasAvailabilityOrgListComponent.new(
            business: business,
            query: query,
            page: current_page
          ) %>
        <% end %>
      <% end %>
    <% else %>
      <%= render Primer::Box.new(mb: 6) do %>
        <%= render Businesses::Policies::SecurityAnalysis::GhasAvailabilityComponent.new(business: business) %>
        <% if is_advanced_security_available_on_selected_org %>
          <%= render Businesses::Policies::SecurityAnalysis::GhasSKUAvailabilityOrgListComponent.new(
            business: business,
            query: query,
            page: current_page
          ) %>
        <% end %>
      <% end %>
    <% end %>

    <% if business.advanced_security_products_bundled? %>
      <%= render Businesses::Policies::SecurityAnalysis::GhasEnablementComponent.new(business: business, mb: 6) %>
    <% end %>

  <% end %>

  <% code_security_heading_rendered = false %>
  <% if show_advanced_security %>
    <% if show_secret_scanning || show_generic_secrets %>
      <h2 class="mb-3">Secret Protection</h2>

      <% if show_secret_scanning %>
        <%= render Businesses::Policies::SecurityAnalysis::SecretScanningSettingsComponent.new(business: business, mb: 6) %>
      <% end %>

      <% if show_generic_secrets %>
        <%= render Businesses::Policies::SecurityAnalysis::GenericSecretsSettingsComponent.new(business: business, mb: 6) %>
      <% end %>
    <% end %>

    <% if !business.advanced_security_products_bundled? || show_code_scanning_autofix || show_code_scanning_autofix_third_party_tools %>
      <% code_security_heading_rendered = true %>
      <h2 class="mb-3">Code Security</h2>

      <% if !business.advanced_security_products_bundled? %>
        <%= render Businesses::Policies::SecurityAnalysis::GhasCodeSecurityEnablementComponent.new(business: business, mb: 6) %>
      <% end %>

      <% if show_code_scanning_autofix %>
        <%= render Businesses::Policies::SecurityAnalysis::CodeScanningAutofixSettingsComponent.new(business: business, mb: 6) %>
      <% end %>

      <% if show_code_scanning_autofix_third_party_tools %>
        <%= render Businesses::Policies::SecurityAnalysis::CodeScanningAutofixThirdPartyToolsSettingsComponent.new(business: business, mb: 6) %>
      <% end %>
    <% end %>
  <% end %>

  <%#
    The items below are also part of Code Security, but they're not part of Advanced Security.
    Therefore, a heading might not have been output for them yet if the enterprise doesn't have
    Advanced Security. In that case, output the heading now.
  %>
  <% if !code_security_heading_rendered && (show_dependabot_alerts || (!GitHub.single_business_environment? && business.owner?(current_user))) %>
    <h2 class="mb-3">Code Security</h2>
  <% end %>

  <% if show_dependabot_alerts %>
    <%= render Businesses::Policies::SecurityAnalysis::DependabotAlertsEnablementComponent.new(business: business, mb: 6) %>
  <% end %>

  <% if !GitHub.single_business_environment? && business.owner?(current_user) %>
    <%= render Businesses::Policies::SecurityAnalysis::DependencyInsightsComponent.new(business: business, mb: 6) %>
  <% end %>
<% end %>
