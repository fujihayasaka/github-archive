<% if this_business.actor_can_read_sso?(current_user) %>
  <%= render Primer::Box.new(border_radius: 2, border: true, test_selector: "business_saml_configuration") do %>
    <%= render Primer::Box.new(p: 3) do %>
      <%= render "businesses/settings/identity_provider/sso_configuration_heading", sso_label: "SAML" %>
      <%= render "businesses/settings/identity_provider/sso_configuration_self_help", view: view, sso_type: :saml %>

      <%= render Primer::Beta::Button.new(scheme: :default, tag: :a, type: :button, align_self: :start, mt: 3, href: edit_enterprise_saml_provider_path(this_business)) do %>
        Edit SAML configuration
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render "businesses/settings/identity_provider/single_sign_on_settings" %>

<% if this_business.is_first_emu_owner?(user: current_user) %>
  <%= render "businesses/settings/identity_provider/saml_to_oidc_migration_setting" %>
<% end %>
