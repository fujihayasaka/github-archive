<% view = Businesses::Settings::SecurityView.new \
  business: this_business, current_user: current_user, params: params %>

<% page_info title: "Single sign-on configuration",
             selected_link: :single_sign_on_configuration,
             sidebar: :identity_provider,
             stafftools: enterprise_single_sign_on_configuration_path(this_business) %>

<%= render Primer::Box.new(col: 12) do %>
  <%= render layout: "businesses/layout",
    locals: {
      business: this_business,
      title: "Single sign-on configuration",
      container_attributes: "itemscope itemtype='http://schema.org/Business'"
    } do %>

  <%= render Primer::Box.new(col: 11) do %>
      <%= render Primer::Box.new(mb: 3, test_selector: "sso_configuration_description") do %>
        If you centrally manage your users' identities and applications with an identity provider (IdP), you can configure OIDC or SAML to protect your enterprise's resources on GitHub. After you require OIDC or SAML authentication, members of the <%= this_business.name %> enterprise must single sign-on with your identity provider (IdP) to access any of the enterprise's organizations.
      <% end %>

      <% if view.show_configure_new_sso? %>
        <%= render "businesses/settings/identity_provider/new_single_sign_on_configuration", view: view %>
      <% end %>

      <% if view.show_oidc_configuration? %>
        <%= render "businesses/settings/identity_provider/oidc_configuration", view: view %>
      <% end %>

      <% if view.show_saml_configuration? %>
        <%= render "businesses/settings/identity_provider/saml_configuration", view: view %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
