<%= render Primer::Box.new(p: 3, display: :flex, align_items: :center, test_selector: "oidc_switch_to_saml") do %>
  <%= render Primer::Box.new(w: :full, mr: 3) do %>
    <%= render Primer::Beta::Heading.new(tag: :h4) do %>
      SAML single sign-on
    <% end %>

    <%= render Primer::Box.new(mt: 1, color: :subtle) do %>
      Supported IdPs include Azure, Okta, OneLogin, Ping Identity, or a custom SAML 2.0 provider.
      <%= render(Primer::Beta::Link.new(
          underline: true,
          href: "#{GitHub.help_url}/admin/managing-iam/using-saml-for-enterprise-iam/configuring-saml-single-sign-on-for-your-enterprise"
        )) { "Learn more about SAML single sign-on" }
      %>.
    <% end %>
  <% end %>

  <div>
    <% dialog_id = "oidc-configuration-switch-to-saml" %>
    <%= render Primer::Alpha::Dialog.new(
      id: dialog_id,
      header_variant: :medium,
      width: :medium,
      title: "Switch to SAML",
      style: "margin-top: 10vh;"
    ) do |d| %>
      <% d.with_header(
        show_divider: false,
        font_size: 4,
        font_weight: :emphasized,
        mb: 3
      ) { "Switch to SAML" } %>

      <% d.with_show_button do %>
        Switch to SAML
      <% end %>

      <% d.with_body do %>
        <p>
          If you currently use OIDC SSO for authentication and would prefer to use SAML, you can disable OIDC or follow a migration path.
        </p>

        <p>
          For more information, see
          "<%= render(Primer::Beta::Link.new(
              underline: true,
              href: "#{GitHub.help_url}/admin/managing-iam/reconfiguring-iam-for-enterprise-managed-users/migrating-from-oidc-to-saml"
            )) { "Migrating from OIDC to SAML" }
          %>."
        </p>
      <% end %>

      <% d.with_footer do %>
        <%= render Primer::Beta::Button.new(scheme: :primary, type: :button, data: { "close-dialog-id": dialog_id }) do %>
            Ok, got it
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
