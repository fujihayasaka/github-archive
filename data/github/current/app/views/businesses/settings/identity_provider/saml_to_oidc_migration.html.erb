<% page_info title: "Migrate to OIDC single sign-on",
             selected_link: :saml_to_oidc_migration,
             stafftools: enterprise_saml_to_oidc_migration_path(this_business) %>

<%= render Primer::Box.new(col: 12, test_selector: "saml_to_oidc_migration") do %>
  <%= render layout: "businesses/layout",
    locals: {
      business: this_business,
      title: "Migrate to OIDC single sign-on",
      container_attributes: "itemscope itemtype='http://schema.org/Business'"
  } do %>
    <div class="mb-3">
      <a href="<%= enterprise_single_sign_on_configuration_path(this_business) %>"> &larr; Back to single sign-on configuration</a>
    </div>

    <p>
      OpenID Connect (OIDC) uses your Microsoft Entra ID (previously known as Azure AD) account's Conditional Access Policy (CAP) to validate interactions with GitHub when members change IP addresses.
    </p>

    <p>
      <%= render(Primer::Beta::Text.new(font_weight: :bold)) { "Prerequisites" } %>
      <ul class="ml-4">
        <li>Your enterprise must be configured to use SAML using Entra ID as your identity provider (IdP)</li>
        <li>Access to your tenant on Entra ID</li>
        <li>Your Entra ID provided GitHub admin login (looks like acme_admin, where acme is your enterprise namespace)</li>
        <li>
          You have read the
          <%= render(Primer::Beta::Link.new(
            underline: true,
            href: "#{GitHub.help_url}/admin/managing-iam/reconfiguring-iam-for-enterprise-managed-users/migrating-from-saml-to-oidc"
          )) { "SAML to OIDC migration guide" } %>
        </li>
      </ul>
    </p>

    <p>
      <%= render(Primer::Beta::Text.new(font_weight: :bold)) { "What to expect" } %>
    </p>
    <p>
      The migration to OIDC will take roughly an hour, during which, users will not be able to access your enterprise's resources.
      <ol class="ml-4">
        <li>You will disable your existing GitHub Enterprise Managed User application on Entra ID</li>
        <li>Prepare and begin the migration as the setup user for your enterprise on GitHub</li>
        <li>Install and configure the new application for OIDC on Entra ID</li>
      </ol>
    </p>
    <p>
      After the migration, if you no longer want to use OIDC, you can migrate back to SAML single-sign on.
    </p>


    <p>
      <%= render Primer::Box.new(border_radius: 2, border: true, bg: :danger, border_color: :danger, p: 3) do %>
        <%= render Primer::Beta::Octicon.new(icon: :stop, size: :small, color: :danger) %> If you use team sync to manage access to organizations or licenses, migrating to OIDC will delete all custom connections between GitHub teams and IdP groups and must be re-configured after the migration. This cannot be undone.
      <% end %>
    </p>

    <div class="mt-3">
      <% dialog_id = "cancel-migration-dialog" %>
      <%= render Primer::Alpha::Dialog.new(
        id: dialog_id,
        header_variant: :medium,
        width: :small,
        title: "Migrate to OIDC single sign-on",
        style: "margin-top: 10vh;",
        test_selector: "migrate_to_oidc_confirmation"
      ) do |d| %>
        <% d.with_show_button(scheme: :danger, mr: 2) { "Migrate to OIDC" } %>

        <% d.with_body(mt: 2) do %>
          <p>
            Are you sure you want to migrate to OIDC single sign-on?
          </p>
        <% end %>

        <% d.with_footer do %>
          <%= render Primer::Beta::Button.new(type: :button, data: { "close-dialog-id": dialog_id }) do %>
            Cancel
          <% end %>
          <%= form_tag settings_oidc_provider_enterprise_path(this_business.slug), method: :post do %>
            <input type="hidden" name="oidc[oidc_provider]" value="azure">
            <input type="hidden" name="oidc[migrate_to_oidc]" value=true>
            <%= render Primer::Beta::Button.new(scheme: :danger, type: :submit, data: { disable_with: "Begin OIDC migration" }) do %>
              Begin OIDC migration
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= render Primer::Beta::Button.new(type: :button, tag: :a, href: enterprise_single_sign_on_configuration_path(this_business)) do %>
        Cancel
      <% end %>
    </div>
  <% end %>
<% end %>

