<%= render Primer::Box.new(border_radius: 2, border: true, bg: :subtle, color: :subtle, mt: 4) do %>
  <%= render Primer::Box.new(
    border: :bottom,
    p: 3,
    display: :flex,
  ) do %>
    <div>
      <%= primer_octicon :"shield-lock", color: :muted, mr: 2, vertical_align: :middle %>
    </div>
    <div>
      <%= render(Primer::Beta::Link.new(
          underline: true,
          href: sso_type == :oidc ? settings_oidc_provider_recovery_codes_enterprise_path(this_business.slug) : settings_saml_provider_recovery_codes_enterprise_path(this_business.slug),
        )) { "Save your recovery codes" }
      %> in a safe place. If your IdP is unavailable you can use a recovery code to skip single sign-on and access the <%= this_business.name %> enterprise.
    </div>
  <% end %>

  <% if sso_type == :saml %>
    <%= render Primer::Box.new(p: 3, display: :flex, border: :bottom) do %>
      <div>
        <%= primer_octicon(:link, color: :muted, mr: 2) %>
      </div>
      <div>
        The assertion consumer service URL is
        <%= render(Primer::Beta::Link.new(
            underline: true,
            href: view.saml_consume_path
          )) { view.saml_consume_url }
        %>.
      </div>
    <% end %>
  <% end %>

  <%= render Primer::Box.new(p: 3, display: :flex) do %>
    <div>
      <%= primer_octicon(:link, color: :muted, mr: 2) %>
    </div>
    <div>
      The <%= this_business.name %> enterprise single sign-on URL is
      <%= render(Primer::Beta::Link.new(
          underline: true,
          href: view.sso_path
        )) { view.sso_url }
      %>.
    </div>
  <% end %>
<% end %>
