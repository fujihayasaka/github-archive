<%= render Primer::Beta::Heading.new(tag: :h3, mb: 2, font_size: 4, classes: "tmp-mt-5") do %>
  Additional options
<% end %>
<%= render Primer::Box.new(border_radius: 2, border: true, test_selector: "saml-to-oidc-migration-setting") do %>
  <%= render Primer::Box.new(classes: "tmp-py-3 tmp-pl-3") do %>
    <%= render Primer::Box.new(display: :flex) do %>
      <%= render Primer::Box.new(w: :full) do %>
        <%= render Primer::Beta::Heading.new(tag: :h4, font_size: 5) do %>
          Migrate to OIDC single sign-on
        <% end %>
        <%= render Primer::Box.new(mt: 1, color: :subtle) do %>
          OpenID Connect (OIDC) uses your Microsoft Entra ID (previously known as Azure AD) account's Conditional Access Policy (CAP) to validate interactions with GitHub when members change IP addresses.
          <%= render(Primer::Beta::Link.new(
            underline: true,
            href: "#{GitHub.help_url}/admin/managing-iam/reconfiguring-iam-for-enterprise-managed-users/migrating-from-saml-to-oidc")) { "Read more about migrating to ODIC" }
          %>.
        <% end %>
      <% end %>

      <div>
        <%= render(Primer::Beta::Link.new(
            aria: { label: "migrate from saml to oidc link" },
            scheme: :secondary,
            href: enterprise_saml_to_oidc_migration_path(this_business),
            classes: "tmp-p-3")) { render Primer::Beta::Octicon.new(icon: "chevron-right", size: :medium) }
          %>
      </div>
    <% end %>
  <% end %>
<% end %>
