<%= render Primer::Box.new(border_radius: 2, border: true, display: :flex, test_selector: "new_single_sign_on_configuration") do %>
  <%= render Primer::Box.new(border: :right, col: 6, p: 3, display: :flex, direction: :column, justify_content: :space_between) do %>
    <div class="mb-3">
      <%= render Primer::Beta::Heading.new(tag: :h2, mb: 1, font_size: 4) do %>
        OIDC single sign-on
      <% end %>
      <%= render Primer::Beta::Text.new(tag: :p) do %>
        Supported IdPs include Microsoft Entra ID (previously known as Azure AD).
        <%= render(Primer::Beta::Link.new(
          underline: true,
          href: "#{GitHub.help_url}/admin/managing-iam/configuring-authentication-for-enterprise-managed-users/configuring-oidc-for-enterprise-managed-users")) { "Learn more about OpenID Connect (OIDC)" }
        %>.
      <% end %>
    </div>
    <%= form_for(:oidc, url: settings_oidc_provider_enterprise_path(this_business.slug),
      method: :post, html: { novalidate: true }) do |f| %>
        <input type="hidden" name="oidc[oidc_provider]" value="azure">
        <%= render Primer::Beta::Button.new(
          scheme: :default,
          tag: :button,
          type: :submit,
          align_self: :start,
          data: { disable_with: "Enable OIDC configuration" },
          test_selector: "enable-oidc-configuration-button",
          disabled: view.configure_new_sso_disabled?
        ) do %>
          Enable OIDC configuration
        <% end %>
    <% end %>
    <% if view.configure_new_sso_disabled? %>
      <%= render Primer::Box.new(mt: 2, test_selector: "external-provider-being-removed-oidc-warning") do %>
        <%= render(Primer::Beta::Octicon.new(icon: :"alert-fill", size: :xsmall, color: :attention)) %>
        <%= render(Primer::Beta::Text.new(vertical_align: :middle)) { view.external_provider_being_removed_text } %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Primer::Box.new(border: false, col: 6, p: 3, display: :flex, direction: :column, justify_content: :space_between) do %>
    <div class="mb-3">
      <%= render Primer::Beta::Heading.new(tag: :h2, mb: 1) do %>
        SAML single sign-on
      <% end %>
      <%= render Primer::Beta::Text.new(tag: :p) do %>
        Supported IdPs include Azure, Okta, OneLogin, Ping Identity, or a custom SAML 2.0 provider.
        <%= render(Primer::Beta::Link.new(
          underline: true,
          href: "#{GitHub.help_url}/admin/managing-iam/configuring-authentication-for-enterprise-managed-users/configuring-saml-single-sign-on-for-enterprise-managed-users")) { "Learn more about SAML single sign-on" }
        %>.
      <% end %>
    </div>
    <%= render Primer::Beta::Button.new(
      scheme: :default,
      tag: :a,
      type: :button,
      disabled: view.configure_new_sso_disabled?,
      align_self: :start,
      test_selector: "add-saml-configuration-button",
      href: edit_enterprise_saml_provider_path(this_business)) do %>
        Add SAML configuration
    <% end %>
    <% if view.configure_new_sso_disabled? %>
      <%= render Primer::Box.new(mt: 2, test_selector: "external-provider-being-removed-saml-warning") do %>
        <%= render(Primer::Beta::Octicon.new(icon: :"alert-fill", size: :xsmall, color: :attention)) %>
        <%= render(Primer::Beta::Text.new(vertical_align: :middle)) { view.external_provider_being_removed_text } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
