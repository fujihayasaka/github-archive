<div <%= test_selector "single-sign-on-settings" %>>
  <%= render("businesses/settings/identity_provider/single_sign_on_setting",
    heading_text: "Single sign-on settings",
    toggle_label: "Automatically redirect users to sign in",
    toggle_description: "If enabled, visitors to resources owned by your enterprise will be redirected to your identity provider to sign in, if they're not already signed in to your enterprise.",
    toggle_aria_label: "sso redirect enabled",
    toggle_checked: this_business.sso_redirect_enabled?,
    toggle_path: enterprise_sso_redirect_enabled_path(this_business),
    test_selector_text: "sso-redirect",
  ) %>

  <% if this_business.eligible_for_open_scim? %>
    <%= render("businesses/settings/identity_provider/single_sign_on_setting",
      heading_text: "Open SCIM Configuration",
      toggle_label: "Enable open SCIM configuration",
      toggle_description: safe_join([
        "If enabled, your enterprise's SCIM API endpoints will allow writes from any authorized personal access token. ",
        "We recommend disabling this capability while using a paved-path identity management application. ",
        "All SCIM calls should be backed by a single source of truth in your identity system. ",
        ActionController::Base.helpers.link_to("Learn more", "#{GitHub.help_url}/admin/identity-and-access-management/provisioning-user-accounts-for-enterprise-managed-users/provisioning-users-with-scim-using-the-rest-api", class: "Link Link--underline"),
        ".",
      ]),
      toggle_aria_label: "open scim enabled",
      toggle_checked: this_business.open_scim_enabled?,
      toggle_path: enterprise_open_scim_configuration_path(this_business),
      test_selector_text: "open-scim",
    ) %>
  <% end %>
</div>
