<% page_info title: "Models",
             selected_link: :models_settings,
             sidebar: :policies,
             stafftools: stafftools_enterprise_path(business) %>
<%= render(
  layout: "businesses/layout",
  locals: {
    business: business,
    title: "Models",
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  },
) do %>

  <div class="width-full" style="max-width: 100%;">
    <%= render(Primer::Beta::BorderBox.new) do |component| %>
      <% component.with_body do %>
        <h2 class="mb-2">
          Models in your enterprise
        </h2>
        <p class="col-10 color-fg-muted" <%= test_selector("models-setting-summary") %>>
          Enable GitHub Models for your enterprise to allow users to interact with models using their code. This suite
          of AI development features is available at the repository level.
          <a class="Link--inTextBlock" href="https://gh.io/models-org-learn-more">Learn more about Models.</a>
        </p>

        <div>
          <%= render(Primer::Alpha::ActionMenu.new(
            select_variant: :single,
            dynamic_label: true,
            dynamic_label_prefix: "All organizations")
          ) do |menu| %>
            <% menu.with_show_button do |button| %>
              <% button.with_trailing_action_icon(icon: :"triangle-down") %>
            <% end %>
            <% menu.with_item(
              label: "No policy",
              active: business.models_access_label == Business::GitHubModelsDependency::ModelsAccessPolicy::NO_POLICY,
              href: settings_models_enterprise_path(business),
              form_arguments: {
                method: :put,
                name: "enable_models",
                value: Business::GitHubModelsDependency::ModelsAccessPolicy::NO_POLICY.serialize
              }
            ) do |item| %>
                <% item.with_description.with_content("Organization administrators choose whether to allow GitHub Models.") %>
            <% end %>
            <% menu.with_divider %>
            <% menu.with_item(
              label: "Enabled",
              active: business.models_access_label == Business::GitHubModelsDependency::ModelsAccessPolicy::FORCE_ON,
              href: settings_models_enterprise_path(business),
              form_arguments: {
                method: :put,
                name: "enable_models",
                value: Business::GitHubModelsDependency::ModelsAccessPolicy::FORCE_ON.serialize
              }
            ) do |item| %>
                <% item.with_description.with_content("All organizations will have GitHub Models turned on.") %>
            <% end %>
            <% menu.with_divider %>
            <% menu.with_item(
              label: "Disabled",
              active: business.models_access_label == Business::GitHubModelsDependency::ModelsAccessPolicy::FORCE_OFF,
              href: settings_models_enterprise_path(business),
              form_arguments: {
                method: :put,
                name: "enable_models",
                value: Business::GitHubModelsDependency::ModelsAccessPolicy::FORCE_OFF.serialize
              }
            ) do |item| %>
                <% item.with_description.with_content("Organizations cannot turn GitHub Models on.") %>
            <% end %>
          <% end %>

          <% if business.enterprise_managed? %>
            <p class="note color-fg-muted" <%= test_selector("models-toggle-note") %>>
              Enable Models SDK and playground access for enterprise members.
            </p>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <p class="col-10 fgColor-muted mt-3" <%= test_selector("models-terms") %>>
      If enabled, users can send code and interact with third-party AI models hosted on Microsoft Azure and subject to Microsoft's
      <a class="Link--inTextBlock" href="https://www.microsoft.com/licensing/terms/productoffering/MicrosoftAzure/MCA">Product Terms</a> &amp;
      <a class="Link--inTextBlock" href="https://www.microsoft.com/licensing/terms/product/PrivacyandSecurityTerms/MCA">Privacy Statement</a>.
      Use of Models is subject to the <a class="Link--inTextBlock" href="<%= docs_url("site-policy/github-pre-release-license-terms") %>">GitHub Pre-release terms</a>.
    </p>

    <%= render GitHubModels::Businesses::BillingUsageComponent.new(business: business) %>

    <%= render GitHubModels::Businesses::CustomModelsComponent.new(business: business) %>
  </div>
<% end %>
