<% page_info title: "Models",
             selected_link: :models_settings,
             sidebar: :policies,
             stafftools: stafftools_enterprise_path(business) %>
<%= render(
  layout: "businesses/layout",
  locals: {
    business: business,
    title: "Models",
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  },
) do %>

  <div class="width-full" style="max-width: 720px;">
    <p class="col-10">
      If enabled, enterprise members will be able to use the GitHub Models SDK and playground.
    </p>

    <div>
      <%= form_tag settings_models_enterprise_path(this_business), method: :put, class: "d-block" do |f| %>
        <div class="form-checkbox">
          <input id="enable_models_checkbox" type="checkbox" name="enable_models"
            <%= "checked" if this_business.models_access_enabled? %>>
          <label for="enable_models_checkbox">Models access</label>
          <p class="note color-fg-muted">
            Enable Models SDK and playground access for enterprise members.
          </p>
        </div>
        <%= render Primer::Beta::Button.new(type: :submit, ml: 3) do %>Save<% end %>
      <% end %>
    </div>
  </div>
<% end %>
