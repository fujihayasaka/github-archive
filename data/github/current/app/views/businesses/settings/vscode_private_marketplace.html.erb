<% page_info title: "VS Code Private Marketplace",
             selected_link: :vscode_private_marketplace_settings,
             sidebar: :settings,
             stafftools: stafftools_enterprise_path(business) %>
<%= render(
  layout: "businesses/layout",
  locals: {
    business: business,
    title: "Visual Studio Code Private Marketplace",
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  },
) do %>
  <p>
    Configure a Visual Studio Code Private Marketplace URL for your enterprise. VS Code will use your Private
    Marketplace for users signed in with GitHub Enterprise instead of the public Visual Studio Marketplace.
    <%= link_to "Learn more about Visual Studio Code Private Marketplace", "https://aka.ms/vspm/docs", class: "Link--inTextBlock" %>
    or <%= link_to "contact Microsoft support", "https://aka.ms/vspm/support", class: "Link--inTextBlock" %> for further assistance.
  </p>
  <%= form_with(url: settings_vscode_private_marketplace_enterprise_path(business), method: :patch) do |form| %>
    <div class="mt-3" <%= test_selector("vscode-private-marketplace-setting-form") %>>
      <%= render(Primer::Alpha::TextField.new(
        name: "vscode_private_marketplace_url",
        label: "Private Marketplace URL",
        value: business.vscode_private_marketplace_url,
        placeholder: "https://<private marketplace container host name>/api/v1",
        full_width: true,
        type: :url,
        show_clear_button: true,
        auto_check_src: validate_vscode_private_marketplace_url_enterprise_path(business),
        validation_message: error_for(business, :vscode_private_marketplace_url),
        classes: "js-prevent-default-behavior"
      )) %>
    </div>

    <div class="mt-3">
      <%= render(Primer::Beta::Button.new(type: :submit)) do %>
        Save changes
      <% end %>
    </div>
  <% end %>
<% end %>
