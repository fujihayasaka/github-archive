<% title ||= nil  %>
<% back_to_link_path ||= nil  %>
<% back_to_link_text ||= nil  %>
<% container_attributes ||= nil %>
<% back_to_link_present = back_to_link_path && back_to_link_text %>
<% hide_header ||= false %>
<% header_description ||= nil %>
<% business_test_selector ||= nil %>
<% header_component_action ||= nil %>
<% banner_component ||= nil %>
<% has_intro ||= false %>

<%
  amount_saved = business.metered_amount_saved
  transition = business.future_metered_transition
%>

<% page_info class: "full-width full-width-p-0" %>

<%# rubocop:disable GitHub/ContentFor %>
<% content_for :site_banner do %>
  <%= render Billing::SalesTaxBannerComponent.new(account: business, current_user: current_user) %>
<% end %>

<% if show_onboarding_experience_banner?(business) %>
  <% if business.dfd_trial? && FeatureFlag.vexi.enabled?(:digital_front_door_getting_started, business, default: false) %>
    <%= render Businesses::EnterpriseCloudTrialBannerComponent.new(
      business: business,
      on_dashboard: current_page?(enterprise_path(business))
    ) %>
  <% else %>
    <%= render Businesses::EnterpriseCloudTrialBannerComponent.new(
      business: business,
      on_dashboard: current_page?(enterprise_getting_started_path(business))
    ) %>
  <% end %>
<% end %>

<%= render Businesses::EnterpriseUpcomingMeteredConversionBannerComponent.new(business: business, current_user: current_user) %>

<%= render AdvancedSecurity::TrialBannerComponent.new(billable_entity: business, user: current_user) %>

<%= render Businesses::DunningBannerComponent.new(business: business, current_user: current_user) %>

<%= render Businesses::DowngradedFromCouponExpirationBannerComponent.new(business: business, current_user: current_user) %>

<%= render Businesses::NeedToSignCorporateTosBannerComponent.new(business: business, current_user: current_user) %>

<%= render Businesses::RBIFailedPaymentTrialAccountBannerComponent.new(business: business, current_user: current_user) %>

<%= render(Site::EnterpriseBannersComponent.new) %>

<%= render_nothing_if_database_fails do %>
  <% new_payment_info_banner = Businesses::MissingPaymentInfoBannerComponent.new(business: business, user: current_user) %>
  <%= render Businesses::MissingPaymentInfoBannerComponent.new(business: business, user: current_user) %>
  <%= render Businesses::EnterprisePaymentInfoReminderBannerComponent.new(business) unless new_payment_info_banner.render? %>
<% end %>
<% if responsive? %>
  <% business_container_classes = "d-md-flex flex-md-items-stretch border-bottom" %>
<% else %>
  <% business_container_classes = "d-flex flex-items-stretch border-bottom pr-4" %>
<% end %>
<div
  class="<%= business_container_classes %>"
  style="min-height: 80vh"
  <%= container_attributes if container_attributes %>
  >
  <% if hide_header %>
    <% unless responsive? %>
      <div class="d-flex flex-column mr-4" style="min-width: 278px"></div>
    <% end %>
  <% else %>
    <%= render_nothing_on_error do %>
      <%= render Businesses::GlobalSidebarComponent.new(
        business: business,
        user: current_user,
        selected_link: selected_link,
        sidebar_section: sidebar,
      ) %>
    <% end %>
  <% end %>

  <div class="<% if responsive? %>width-full<% else %>flex-auto container-xl p-6<% end %> min-width-0" <%= test_selector(business_test_selector) unless business_test_selector.blank? %>>
    <div class="business-content">
    <% if responsive? %>
      <div class="pt-4 px-3 px-md-4 pb-6 d-flex flex-auto flex-justify-center">

        <div class="col-12 col-lg-10 container-lg">
          <% if back_to_link_present %>
            <% if responsive? %>
              <%= link_to back_to_link_path, class: "btn-link d-inline-flex flex-items-center mb-3" do %>
                <%= render(Primer::Beta::Octicon.new(:"arrow-left", size: :small)) %>
                <span class="ml-2">Back to <%= back_to_link_text %></span>
              <% end %>
            <% else %>
              <%= link_to back_to_link_path, class: "btn-link ml-n3 d-inline-flex flex-items-center mb-3" do %>
                <%= render(Primer::Beta::Octicon.new(:"arrow-left", size: :small)) %>
                <span class="ml-2">Back to <%= back_to_link_text %></span>
              <% end %>
            <% end %>
          <% end %>

          <%= render Businesses::MeteredLicensingDiscoveryBannerComponent.new(
            business: business,
            current_user: current_user
          ) %>
          <% if title %>
            <%= render Primer::Beta::Subhead.new do |component| %>
              <% component.with_heading(tag: :h1, test_selector: "business_layouts_title") do %>
                <%= title %>
              <% end %>
              <% if header_component_action %>
                <% component.with_actions do %>
                  <%= header_component_action %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
          <% if banner_component %>
            <%= banner_component %>
          <% end %>

          <% if header_description %>
            <p class="mt-3 mb-4"><%= header_description %></p>
          <% end %>

          <%= yield %>
        </div>
      </div>
    <% else %>
      <% if title || header_description %>
        <div class="pb-4">
          <% if title %>
            <h1 class="h1"><%= title %></h1>
          <% end %>
          <% if header_description %>
            <p class="color-fg-muted"><%= header_description %></p>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    <% end %>
    </div>
  </div>
</div>

<% if business.render_getting_started_widget?(current_user) %>
  <% items = [
    { label: 'Create an organization', isCompleted: business.trial_with_organization?, url: new_enterprise_onboarding_organization_path(business) },
    { label: 'Add owners to Enterprise', isCompleted: business.trial_with_invited_owner?, url: enterprise_admins_path(business, show_onboarding_guide_tip: true) },
    { label: 'Verify identity to use Copilot', isCompleted: business.trial_with_verified_identity_for_copilot?, url: enterprise_trial_activations_path(business) },
    { label: 'Add members to Copilot', isCompleted: business.trial_with_two_copilot_seats_assigned?, isLocked: !business.trial_with_verified_identity_for_copilot?, url: settings_copilot_enterprise_path(business) },
    { label: 'Try Secret Scanning', isCompleted: business.trial_with_secret_scanning?, url: security_center_alerts_secret_scanning_enterprise_path(business) },
    { label: 'Try Code Security', isCompleted: business.trial_with_code_scanning?, url: security_center_alerts_code_scanning_enterprise_path(business) },
    { label: 'Enable SAML Single Sign-On', isCompleted: business.trial_with_saml_sso?, url: settings_security_enterprise_path(business) }
  ]

  items.insert(2,
    { label: 'Add members to Enterprise', isCompleted: business.trial_with_invited_member?, url: people_enterprise_path(business, show_onboarding_guide_tip: true) },
  ) if FeatureFlag.vexi.enabled?(:enterprise_copilot_licensing, business, default: false)
  %>

  <%= render_react_partial(
    name: 'getting-started-todo-list',
    props: {
      title: 'Explore Enterprise',
      isFloating: false,
      hasIntro: has_intro,
      currentUrl: request.path,
      businessId: business.id,
      userId: current_user.id,
      items: items,
        bottomElement: {
              default: {
                label: "Go back to {link}",
                link: {
                    label: "Enterprise Dashboard",
                    href: enterprise_path(business),
                  },
              },
              completed: {
                label: "If you're ready, {link}",
                link: {
                    label: "activate your paid enterprise",
                    href: billing_upgrade_enterprise_path(business)
                  },
              },
            },
      aria: {
        completedItem: "completedItem",
        lockedItem: "lockedItem"
      }
    }
  ) %>
<% end %>
