<%#
  Turbo Stream response for enterprise trial creation with email verification
  Show only the verification component, not the success summary
%>

<turbo-stream action="replace" target="trial-form-container">
  <template>
    <%# Empty - hide the trial form content %>
  </template>
</turbo-stream>

<turbo-stream action="replace" target="business-type-info-container">
  <template>
    <%# Empty - hide the business type info %>
  </template>
</turbo-stream>

<turbo-stream action="replace" target="verification-container">
  <template>
    <% unless email_sent %>
      <%= render Primer::Alpha::Banner.new(scheme: :danger, icon: :alert, classes: "tmp-mb-3") do %>
        Enterprise trial created, but we couldn't send the verification email. Please try resending it.
      <% end %>
    <% end %>
    <%= render Businesses::TrialAccounts::InlineEmailVerificationComponent.new(business: business, with_param: with_param) %>
  </template>
</turbo-stream>
