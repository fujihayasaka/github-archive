<%
  page_info title: "Set up your GitHub Enterprise Cloud trial"

  error ||= nil
  data_hosting ||= nil
  maximum_seat_count ||= nil
  organization ||= nil
  organization_id ||= nil
  company_info ||= {}
  billing_contact_fields ||= {}
  employee ||= false

  title = "Try GitHub’s Copilot-powered platform"
  enterprise_trial_label = "30 day free trial"
%>

<% if current_user.feature_enabled?(:digital_front_door_ui_revamp) %>
  <div class="dfd-trial__container-form position-relative d-flex flex-column mb-2">
    <div class="d-flex flex-justify-center dfd-trial__container-inner dfd-new__container-box">
      <div class="flex-column">
        <%= render Businesses::TrialAccounts::BusinessTypeFormInfoComponent.new(
          business_type: business_type&.to_sym
        ) %>
        <div class="mt-3">
          <business-trial-accounts-form>
            <%= render partial: "businesses/trial_accounts/dfd_form", locals: {
              error: error,
              entity: entity,
              data_hosting: data_hosting,
              maximum_seat_count: maximum_seat_count,
              organizations: organizations,
              organization: organization,
              organization_id: organization_id,
              company_info: company_info,
              metered_trial: metered_trial,
              business_type: business_type,
              emu_enterprise: emu_enterprise,
              employee: employee,
              billing_contact_fields: billing_contact_fields,
              show_organization_selection_dropdown: show_organization_selection_dropdown,
              show_org_upgrade_not_possible_for_emu_banner: show_org_upgrade_not_possible_for_emu_banner
            } %>
          </business-trial-accounts-form>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <%= render layout: "signup/container",
    locals: {
      title: title,
      description: "Sign up for your Enterprise #{emu_enterprise ? "Managed Users" : "Cloud" } account",
      enterprise_trial_label: enterprise_trial_label,
      container_class: "container-md",
      yield_container_class: "container-xl",
    } do %>
    <div class="d-md-flex gutter-md flex-sm-row-reverse flex-justify-start">
      <div class="col-md-3">
        <%= render(Primer::Box.new(
          bg: :default,
          border: true,
          border_radius: 2,
          p: 4,
          classes: "my-3"
        )) do %>
          <% if emu_enterprise %>
            <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4)) { "Enterprise Managed Users" } %>
              <div class="mt-2 color-fg-muted">
                <p>
                  For private, internal work only, with member accounts provisioned from your identity provider.
                </p>
                <p>
                  To bring your organization along or allow members to use their personal GitHub accounts, we recommend
                  <%= render(Primer::Beta::Link.new(href: "/account/enterprises/new#{"/upgrade-org" if organization.present?}?users_type=metered_ghe", underline: true)) { "Enterprise Cloud" } %>
                </p>
                <p>
                  <%= render(Primer::Beta::Link.new(href: "#{GitHub.help_url}/admin/managing-iam/understanding-iam-for-enterprises/about-enterprise-managed-users", underline: true)) { "Learn more about Enterprise Managed Users" } %>
                </p>
              </div>
          <% else %>
            <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4)) { "Enterprise Cloud" } %>
            <div class="mt-2 color-fg-muted">
              <p>
                For public, open source and private work, that allows members to access your repositories with their personal GitHub accounts.
              </p>
              <p>
                For only private, internal work and provisioned accounts, we recommend
                <%= render(Primer::Beta::Link.new(href: "/account/enterprises/new#{"/upgrade-org" if organization.present?}?users_type=enterprise_managed", underline: true)) { "Enterprise with managed users" } %>
              </p>
              <p>
                <%= render(Primer::Beta::Link.new(href: "#{GitHub.help_url}/admin/overview/about-github-enterprise-cloud", underline: true)) { "Learn more about Enterprise Cloud" } %>
              </p>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="col-md-6">
        <%= render partial: "businesses/trial_accounts/form", locals: {
          business: business,
          maximum_seat_count: maximum_seat_count,
          organizations: organizations,
          organization: organization,
          organization_id: organization_id,
          company_info: company_info,
          metered_trial: metered_trial,
          business_type: business_type,
          emu_enterprise: emu_enterprise,
          employee: employee,
          billing_contact_fields: billing_contact_fields,
          show_organization_selection_dropdown: show_organization_selection_dropdown,
          show_org_upgrade_not_possible_for_emu_banner: show_org_upgrade_not_possible_for_emu_banner
        } %>
      </div>
    </div>
  <% end %>
<% end %>
