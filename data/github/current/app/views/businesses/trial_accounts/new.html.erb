<%
  page_info title: "Set up your GitHub Enterprise Cloud trial"

  error ||= nil
  data_hosting_required ||= nil
  maximum_seat_count ||= nil
  organization ||= nil
  organization_id ||= nil
  captcha_error ||= false
  company_info ||= {}
  billing_contact_fields ||= {}
  employee ||= false

  title = "Try GitHub’s Copilot-powered platform"
  enterprise_trial_label = "30 day free trial"
%>

<div class="dfd-trial__container-form position-relative d-flex flex-column">
  <div class="d-flex flex-justify-center dfd-trial__container-inner dfd-new__container-box">
    <div class="flex-column">
      <%= render Businesses::TrialAccounts::BusinessTypeFormInfoComponent.new(
        business_type: business_type&.to_sym
      ) %>
      <div class="mt-3">
        <business-trial-accounts-form>
          <%= render partial: "businesses/trial_accounts/dfd_form", locals: {
            error: error,
            entity: entity,
            data_hosting_required: data_hosting_required,
            maximum_seat_count: maximum_seat_count,
            organizations: organizations,
            organization: organization,
            organization_id: organization_id,
            company_info: company_info,
            metered_trial: metered_trial,
            business_type: business_type,
            emu_enterprise: emu_enterprise,
            captcha_error: captcha_error,
            employee: employee,
            billing_contact_fields: billing_contact_fields,
            show_organization_selection_dropdown: show_organization_selection_dropdown,
            show_org_upgrade_not_possible_for_emu_banner: show_org_upgrade_not_possible_for_emu_banner
          } %>
        </business-trial-accounts-form>
      </div>
    </div>
  </div>
</div>
