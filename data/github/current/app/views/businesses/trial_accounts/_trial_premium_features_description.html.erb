<%# Below is the div that will be rendered for a larger screen (> 1012 px)%>
<div class="trial-info-large">
  <span class="mt-2 h4 dfd-trial__text-background" ><strong>What you get in your premium free trial:</strong></span>
  <div class="dfd-trial__details-content mt-4">
    <ul class="list-style-none dfd-trial__text">
      <li class="mb-2 ml-4">
        <span class="ml-n4"><%= primer_octicon(:check, classes: "dfd-trial__text-background", mr: 1) %></span>
        <span class="text-bold">Enterprise:</span> Seamlessly plan, build, and ship great software with an extensible DevOps platform
      </li>
      <li class="mb-2 ml-4">
        <span class="ml-n4"><%= primer_octicon(:check, classes: "dfd-trial__text-background", mr: 1) %></span>
        <span class="text-bold">Copilot Business:</span> Improve the developer experience with contextualized, AI-powered coding assistance
      </li>
      <li class="ml-4">
        <span class="ml-n4"><%= primer_octicon(:check, classes: "dfd-trial__text-background", mr: 1) %></span>
        <span class="text-bold">Advanced Security:</span> Spend less time fixing security vulnerabilities with AI-powered AppSec tools
      </li>
    </ul>
  </div>
</div>

<%# Below is the container that will be rendered for a smaller screen, where the information can be collapsed (< 1012 px)%>
