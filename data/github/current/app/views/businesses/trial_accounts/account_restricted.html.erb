<% content_for :head do %>
  <%= stylesheet_bundle :site %>
  <%= stylesheet_bundle "business-trial" %>
  <%= javascript_bundle :businesses %>
  <%= javascript_bundle :signup %>
<% end %>

<div class="dfd-trial__container-form position-relative d-flex flex-column" data-hpc>
  <div class="d-flex flex-justify-center dfd-trial__container-inner dfd-new__container-box">
    <div class="d-flex flex-column mx-auto" <%= test_selector("account-restricted") %>>
      <%= render(Primer::Beta::Heading.new(
        tag: :h2,
        classes: "dfd-trial__container-h2",
        width: :medium
      )) { reason_header } %>
      <p class="mt-2 fgColor-muted">
        <%= reason_body %>
      </p>
    </div>
  </div>
</div>
