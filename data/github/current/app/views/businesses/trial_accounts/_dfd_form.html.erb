<%
  show_captcha = show_captcha?(session, current_user)
  form_class = show_captcha ? "js-octocaptcha-parent" : ""
  submit_class = show_captcha ? "js-octocaptcha-form-submit" : ""
%>

<% if show_org_upgrade_not_possible_for_emu_banner %>
  <div class="mb-3">
    <%= render Primer::Alpha::Banner.new(
      scheme: :warning,
      icon: :alert,
      dismiss_scheme: :none,
      mt: 3,
      test_selector: "org-upgrade-not-possible-for-emu-banner"
    ) do %>
      The <%= organization.display_login %> organization will not be upgraded because existing organizations
      cannot be added to enterprises with Enterprise Managed Users. To bring your organization along, we recommend
      <%= link_to "Enterprise Cloud", "#{GitHub.help_url}/admin/overview/about-github-enterprise-cloud", class: "Link--inTextBlock", target: "_blank" %>.
    <% end %>
  </div>
<% end %>

<div <%= test_selector("new-business-trial-form")%>>
  <%= form_with url: enterprise_trial_accounts_create_path, method: :post, html: { id: "new-enterprise-form", class: form_class, data: { turbo: true } } do |form| %>
    <%= hidden_field_tag "metered_plan", metered_trial, "data-test-selector": "new-business-trial-metered-plan" %>
    <%= hidden_field_tag "business_type", business_type, "data-test-selector": "new-business-trial-business-type" %>
    <% if employee %>
      <%= hidden_field_tag "staff_owned", true %>
    <% end %>

    <% if entity.errors.present? || error.present? %>
      <%= render Primer::Alpha::Banner.new(scheme: :danger, test_selector: "banner-error-message") do %>
        <% if entity.errors.present? %>
          <strong>The following fields have errors:</strong> <%= humanized_dfd_trial_fields_with_errors(entity) %>.
        <% else %>
          <%= error %>
        <% end %>
      <% end %>
    <% end %>

    <% if emu_enterprise && current_user&.feature_enabled?(:digital_front_door_proxima) %>
      <div class="width-full" <%= test_selector("emu-business-data-hosting-option")%>>
        <div class="form-group">
          <div class="form-group-header">
            <label>Data hosting</label>
          </div>
          <div class="form-group-body">
            <input
              type="checkbox"
              autocomplete="off"
              class="form-checkbox-details-trigger"
              id="data_hosting"
              name="data_hosting"
              data-target="business-trial-accounts-form.dataHostingCheckbox"
              <%= "checked" if data_hosting %>>
            <label for="data_hosting" class="text-normal f5">
              I need to choose which geographical location to host my data.
            </label>
            <p class="note">
              With GitHub Enterprise Cloud with Data Residency, you can choose where your company’s code and data are
              stored. Your enterprise will be hosted on a dedicated subdomain of GHE.com.
            </p>
          </div>
        </div>
      </div>

      <div class="width-full" data-target="business-trial-accounts-form.dataHostingRegionFieldContainer" <%= "hidden" unless data_hosting %>>
        <div class="form-group required">
          <div class="form-group-header">
            <label for="multi_tenant_data_hosting_region" >Region for data hosting</label>
          </div>
          <div class="form-group-body">
            <%= select_tag(
              "multi_tenant[data_hosting_region]",
              options_for_select(
                Businesses::TrialAccountsHelper::MULTI_TENANT_DATA_HOSTING_REGIONS,
                entity.is_a?(MultiTenantProvisioningRequest) ? entity.data_hosting_region : nil
              ), {
                class: "width-full form-control py-1",
                id: "multi_tenant_data_hosting_region",
                data: { target: "business-trial-accounts-form.dataHostingRegionField" }
              }
            ) %>
            <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :data_hosting_region) %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="width-full">
      <div class="form-group required">
        <div class="form-group-header"><%= label_tag "business[name]", "Enterprise name" %></div>
        <div class="form-group-body">
          <%= text_field_tag "business[name]",
            entity.name,
            class: "js-business-name width-full py-1",
            placeholder: "e.g. Acme, Inc.",
            autofocus: true,
            data: { target: "business-trial-accounts-form.nameField" } %>
            <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :name) %>
        </div>
      </div>
    </div>

    <div class="width-full" data-target="business-trial-accounts-form.slugFieldContainer" <%= "hidden" if data_hosting %>>
      <auto-check src="<%= enterprise_trial_accounts_check_slug_path %>" only-validate-on-blur="<%= user_feature_enabled?(:only_validate_on_blur_migration) %>">
        <div class="form-group required">
          <div class="form-group-header"><%= label_tag "business[slug]", "Enterprise URL slug" %></div>
          <div class="form-group-body">
            <%
              current_slug = entity.is_a?(Business) ? entity.slug : nil
              update_slug_from_name = current_slug.to_s.empty?
              slug_field_properties = {
                value: current_slug,
                class: "js-business-slug width-full py-1",
                placeholder: "e.g. acme-inc.",
                data: { target: "business-trial-accounts-form.slugField" }
              }
              slug_field_properties["data-auto-update"] = true if update_slug_from_name
            %>
            <%= text_field_tag "business[slug]", current_slug, slug_field_properties %>
            <p class="note">This will be your enterprise profile URL.</p>
            <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :slug) %>
          </div>
        </div>
        <%= csrf_hidden_input_for enterprise_trial_accounts_check_slug_path %>
      </auto-check>
    </div>

    <% if emu_enterprise %>
      <div
        class="width-full"
        data-target="business-trial-accounts-form.shortcodeFieldContainer"
        <%= test_selector("new-business-trial-emu-shortcode") %>
        <%= "hidden" if data_hosting %>>
        <auto-check src="<%= enterprise_trial_accounts_check_shortcode_path %>" only-validate-on-blur="<%= user_feature_enabled?(:only_validate_on_blur_migration) %>">
          <div class="form-group required">
            <div class="form-group-header">
              <%= label_tag "business[shortcode]", "Username shortcode (cannot be edited later)" %>
            </div>
            <div class="form-group-body">
              <%
                current_shortcode = entity.is_a?(Business) ? entity.shortcode : nil
                shortcode_field_properties = {
                  value: current_shortcode,
                  placeholder: "e.g. usc for University of Southern California",
                  class: "js-business-shortcode width-full py-1",
                  data: { target: "business-trial-accounts-form.shortcodeField" }
                }
              %>
              <%= text_field_tag "business[shortcode]", current_shortcode, shortcode_field_properties %>
              <p class="note"><%= link_to "What is a username shortcode?", "#{GitHub.help_url}/admin/managing-iam/iam-configuration-reference/username-considerations-for-external-authentication#about-usernames-for-managed-user-accounts", target: "_blank" %></p>
              <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :shortcode) %>
            </div>
          </div>
          <%= csrf_hidden_input_for enterprise_trial_accounts_check_shortcode_path %>
        </auto-check>
      </div>

      <% if current_user&.feature_enabled?(:digital_front_door_proxima) %>
        <div class="width-full" data-target="business-trial-accounts-form.subdomainFieldContainer" <%= "hidden" unless data_hosting %>>
          <div class="form-group required">
            <div class="form-group-header">
              <%= label_tag "multi_tenant[subdomain]", "Subdomain" %>
            </div>
            <div class="form-group-body">
              <%= text_field_tag "multi_tenant[subdomain]",
                entity.is_a?(MultiTenantProvisioningRequest) ? entity.subdomain : nil,
                class: "width-full py-1",
                placeholder: "acme-inc",
                data: { target: "business-trial-accounts-form.subdomainField" } %>
                <p class="note">This will be your enterprise profile subdomain  e.g. acme-inc.github.com</p>
                <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :subdomain) %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <div class="container-lg clearfix">
      <div class="form-group required col-6 float-left pr-2 mt-0">
        <div class="form-group-header"><label class="text-bold" for="industry-select" >Industry</label></div>
        <div class="form-group-body">
          <%= select_tag(
            "company_info[industry]",
            options_for_select(Businesses::TrialAccountsHelper::INDUSTRY_OPTIONS, company_info[:industry]),
            {
              class: "width-full js-enterprise-trial-industry form-control py-1",
              id: "industry-select",
              data: { target: "business-trial-accounts-form.industryField" }
            }
          ) %>
          <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :industry) %>
        </div>
      </div>
      <div class="form-group dfd-trial__form-fields js-enterprise-trial-other-industry-field" data-trigger-option-value="Other" hidden>
        <div class="form-group-header">
          <label class="text-bold" for="other-industry-trial" >Specify your industry</label>
        </div>
        <div class="form-group-body">
          <input
            class="width-full form-control py-1"
            name="company_info[other_industry]"
            id="other-industry-trial"
            value="<%= company_info[:other_industry] %>">
        </div>
      </div>
      <div class="form-group required col-6 float-left pl-2 mt-0">
        <div class="form-group-header">
          <label class="text-bold" for="employees-size-select" >Number of employees</label>
        </div>
        <div class="form-group-body">
          <%= select_tag(
            "company_info[employees_size]",
            options_for_select(Businesses::TrialAccountsHelper::EMPLOYEE_SIZE, company_info[:employees_size]),
            {
              class: "width-full form-control py-1",
              id: "employees-size-select",
              data: { target: "business-trial-accounts-form.employeesSizeField" }
            }
          ) %>
          <%= render Businesses::TrialAccounts::ErrorComponent.new(
            entity: entity,
            field: data_hosting ? :number_of_seats : :employees_size
          ) %>
        </div>
      </div>
      <% if emu_enterprise %>
        <div class="form-group dfd-trial__form-fields required">
          <div class="form-group-header"><label for="billing_contact_country_code">Country</label></div>
          <div class="form-group-body">
            <select
              id="billing_contact_country_code"
              class="form-select form-control select-country width-full py-1 js-consent-experience-country-select"
              name="billing_contact[country_code]"
              data-target="business-trial-accounts-form.countryCodeField"
            >
              <option value selected>Choose your country</option>
              <% ::TradeControls::Countries.marketing_targeted_countries.each do |(country_name, country_alpha2, _, _)| %>
                <option value="<%= country_alpha2 %>"<%= " selected" if country_alpha2 == billing_contact_fields[:country_code] %>>
                  <%= country_name %>
                </option>
              <% end %>
            </select>
            <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :country_code) %>
          </div>
        </div>
        <div class="form-group required mb-0">
          <div class="form-group-header"><%= label_tag "emu_idp", "Identity Provider" %></div>
          <div class="form-group-body">
            <p class="clearfix note">
              Select which identity provider you will use to manage your enterprise's user accounts.
            </p>
            <div class="col-6 float-left pr-2">
              <label class="d-block mb-2">
                <%= radio_button_tag "emu_idp", "microsoft-entra-id", :checked => params[:emu_idp] == "microsoft-entra-id", data: { target: "business-trial-accounts-form.emuIdpField" } %>
                Microsoft Entra ID
              </label>
              <label>
                <%= radio_button_tag "emu_idp", "okta", :checked => params[:emu_idp] == "okta", data: { target: "business-trial-accounts-form.emuIdpField" } %>
                Okta
              </label>
            </div>
            <div class="col-6 float-left pl-2">
              <label class="d-block mb-2">
                <%= radio_button_tag "emu_idp", "pingfederate", :checked => params[:emu_idp] == "pingfederate", data: { target: "business-trial-accounts-form.emuIdpField" } %>
                PingFederate
              </label>
              <label>
                <%= radio_button_tag "emu_idp", "custom", :checked => params[:emu_idp] == "custom", data: { target: "business-trial-accounts-form.emuIdpField" } %>
                Custom or other
              </label>
            </div>
            <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :emu_idp) %>
          </div>
        </div>
      <% end %>
    </div>

    <% if show_organization_selection_dropdown %>
      <%# Show a multi-selection of any org available to the user. Auto select an org if passed in via parameter. %>
      <div class="width-full">
        <div class="form-group mt-0 pb-1">
          <div class="form-group-header"><label for="organization_id">Organization</label></div>
          <div class="form-group-body">
            <select
              id="organization_id"
              class="form-select form-control width-full py-1 js-enterprise-trial-org-selection"
              name="organization_id"
              <%= test_selector("new-business-trial-organization-selection-dropdown") %>
              <%= safe_analytics_click_attributes(category: "enterprise_trial_account", action: "select_org", label: "location:new_enterprise_trial_account") %>
            >
              <option value disabled selected>Choose an existing organization to include in the new Enterprise account</option>
              <% organizations.each do |org| %>
                <option value="<%= org.display_login %>"<%= " selected" if (organization.present? && org.id == organization.id && entity.has_sufficient_licenses_for_organization?(organization) && org.active_marketplace_listing_subscription_items.none?) || organization_id.present? %>>
                  <%= org.name %>
                </option>
              <% end %>
              <option value>Create without an organization</option>
            </select>
            <p class="note">
              Note: Billing for any selected organization will be delegated to the enterprise account.
              <%= link_to "Learn about changes to your billing during trial", "#{GitHub.help_url}/get-started/signing-up-for-github/setting-up-a-trial-of-github-enterprise-cloud#during-the-trial", class: "Link--inTextBlock", target: "_blank" %>.
            </p>
          </div>
        </div>
        <% if organization.present? %>
          <% if !entity.has_sufficient_licenses_for_organization?(organization) %>
            <%= render Businesses::TrialAccounts::OrganizationErrorComponent.new(
              organization: organization,
              any_organizations: organizations.any?,
              max_seat_count: maximum_seat_count,
            ) %>
          <% end %>
          <% if organization.active_marketplace_listing_subscription_items.any? %>
            <%= render Businesses::TrialAccounts::OrganizationErrorComponent.new(
              organization: organization,
              any_organizations: organizations.any?
            ) %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-3 width-full clearfix border-top border-bottom pt-3 pb-2">
      <% if emu_enterprise %>
        <h2 class="f3 text-bold lh-condensed">Admin information</h2>
        <div class="f6 color-fg-muted" >
          This contact will be the first and only admin account responsible to configure the identity provider
          to provision user accounts and has unique recovery access in the event of an outage.
        </div>
        <div class="f4 mt-3">
          <div class="f5 text-bold">
            Your setup admin username will be: <strong class="fgColor-open js-business-first-admin-name"></strong>
          </div>
          <div class="f6 color-fg-muted">You will set the password for this user in the next step.</div>
        </div>
      <% else %>
        <h2 class="f3 text-bold lh-condensed">Contact information</h2>
      <% end %>
      <div class="form-group required col-6 float-left pr-2">
        <div class="form-group-header">
          <label class="text-bold" for="full-name-trial" >Admin name</label>
        </div>
        <div class="form-group-body">
          <input
            class="width-full form-control py-1"
            name="company_info[full_name]"
            id="full-name-trial"
            value="<%= company_info[:full_name] %>"
            data-target="business-trial-accounts-form.billingFullNameField">
          <%= render Businesses::TrialAccounts::ErrorComponent.new(
            entity: entity,
            field: data_hosting ? :admin_name : :billing_full_name
          ) %>
        </div>
      </div>
      <auto-check src="<%= enterprise_trial_accounts_check_billing_email_path %>" only-validate-on-blur="<%= user_feature_enabled?(:only_validate_on_blur_migration) %>">
        <div class="form-group required col-6 float-left pl-2">
          <div class="form-group-header">
            <%= label_tag "business[billing_email]", "Admin work email" %>
          </div>
          <div class="form-group-body">
            <%= text_field_tag "business[billing_email]",
              entity.billing_email,
              class: "width-full py-1",
              data: { target: "business-trial-accounts-form.billingEmailField" } %>
            <%= render Businesses::TrialAccounts::ErrorComponent.new(
              entity: entity,
              field: data_hosting ? :admin_work_email : :billing_email
            ) %>
          </div>
        </div>
        <%= csrf_hidden_input_for enterprise_trial_accounts_check_billing_email_path %>
      </auto-check>
      <% unless emu_enterprise %>
        <div class="form-group required country-form mb-3">
          <div class="form-group-header">
            <label for="billing_contact_country_code">Country</label>
          </div>
          <div class="form-group-body">
            <select
              id="billing_contact_country_code"
              class="form-select form-control select-country width-full py-1 js-consent-experience-country-select"
              name="billing_contact[country_code]"
              data-target="business-trial-accounts-form.countryCodeField"
            >
              <option value selected>Choose your country</option>
              <% ::TradeControls::Countries.marketing_targeted_countries.each do |(country_name, country_alpha2, _, _)| %>
                <option value="<%= country_alpha2 %>"<%= " selected" if country_alpha2 == billing_contact_fields[:country_code] %>>
                  <%= country_name %>
                </option>
              <% end %>
            </select>
            <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :country_code) %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="my-3 width-full">
      <% if show_captcha %>
        <noscript>
          <p class="flash flash-error f5">
            GitHub requires JavaScript enabled during trial enterprise creation, for our captcha.
            Please enable JavaScript during org creation.
          </p>
        </noscript>
        <%= render partial: "shared/octocaptcha", locals: {
          origin_page: "github_enterprise_trial_create",
          octocaptcha_timeout: Octocaptcha::HIGHER_BROWSER_LOAD_TIMEOUT
        } %>
      <% end %>
    </div>

    <div class="form-group required">
      <div class="form-group-header">
        <label>Trial terms</label>
      </div>
      <div class="form-group-body">
        <div class="form-checkbox my-2" aria-live="polite" <%= test_selector("new-trial-features_disabled_warning")%>>
          <input
            type="checkbox"
            class="form-checkbox-details-trigger"
            id="features_disabled_warning"
            name="features_disabled_warning"
            data-target="business-trial-accounts-form.featuresDisabledWarningCheckbox">
          <label for="features_disabled_warning" class="text-normal f5">
            I understand that
            <a class="Link--inTextBlock" href="<%= "#{GitHub.help_url}/enterprise-cloud@latest/get-started/signing-up-for-github/setting-up-a-trial-of-github-enterprise-cloud#features-not-included-in-the-trial" %>"
              target="_blank" rel="noopener noreferrer">
              certain features
            </a>
            are unavailable during the trial experience.
          </label>
        </div>
        <div class="form-checkbox my-2" aria-live="polite" <%= test_selector("new-business-trial-business-owned")%>>
          <input
            type="checkbox"
            class="form-checkbox-details-trigger"
            id="business_owned"
            name="business_owned"
            data-target="business-trial-accounts-form.businessOwnedCheckbox">
          <label for="business_owned" class="text-normal f5">
            If my organization does not already have a customer agreement for GitHub services, I hereby accept the
            <a class="Link--inTextBlock" href="<%= customer_term_index_path %>" target="_blank" rel="noopener noreferrer">GitHub Customer Agreement</a>
            and confirm that I have the authority to do so on behalf of my organization.
          </label>
        </div>
        <%= render Businesses::TrialAccounts::ErrorComponent.new(entity: entity, field: :trial_terms) %>
      </div>
    </div>

    <% if current_user.feature_enabled?(:marketing_forms_api_integration_enterprise_trial) %>
      <div>
        <div class="form-group-header">
          <label>Communication preferences</label>
        </div>
        <%= render_react_partial name: "consent-experience", props: {
          fieldName: :marketing_email_opt_in,
          countryFieldSelector: ".js-consent-experience-country-select",
          privacyStatementHref: GitHub.privacy_statement_url,
          emailSubscriptionSettingsLinkHref: new_settings_link_request_path,
          exampleFields: ["full name", "company", "email"],
          labelClass: "text-normal",
          formControlClass: "form-checkbox mb-0",
          noticeClass: "color-fg-muted"
        } %>
        <p class="form-group-body form-checkbox mt-2">
          If you change your mind, you can <a class="Link--inTextBlock" href="<%= settings_email_preferences_path %>" target="_blank">unsubscribe</a> at any time.
        </p>
      </div>
    <% end %>

    <%= render Primer::Beta::Button.new(
      scheme: :primary,
      size: :large,
      block: true,
      type: :submit,
      mt: 3,
      test_selector: "new-business-trial-submit"
    ) do |_c|
      "Create enterprise"
    end %>
  <% end %>
</div>
