<%
  page_info title: "Choose an Enterprise plan", full_height: true
%>
<div class="dfd-trial__container-form position-relative d-flex flex-column">
  <div class="d-flex flex-justify-center dfd-trial__container-inner dfd-new__container-box">
    <div class="d-flex flex-column mx-auto" <%= test_selector("user-type-selector-dfd") %>>
      <%= render(Primer::Beta::Heading.new(
        tag: :h2,
        classes: "dfd-trial__container-h2",
        width: :medium
      )) { "Start your premium free trial by choosing an enterprise type" } %>
      <p class="mt-2 fgColor-muted">Your enterprise type determines whether members can contribute to public repositories and if they can use their personal GitHub accounts.
        <%= render(Primer::Beta::Link.new(
          href: "#{GitHub.help_url}/admin/managing-iam/understanding-iam-for-enterprises/choosing-an-enterprise-type-for-github-enterprise-cloud",
          classes: "Link--inTextBlock",
          target: "_blank"
        )) { "Learn more about enterprise types" } %>.
      </p>

      <div class="mt-4 flex-1">
        <div class="border rounded-3 p-4">
          <%= render(Primer::Beta::Label.new(tag: :span, size: :large, scheme: :default)) { "Recommended for public and private work" } %>
          <h3 class="dfd-trial__container-h3 my-2">Enterprise with personal accounts</h3>
          <p class="fgColor-muted">
            Recommended for public, open source and private work, that allows members to access your repositories with
            their personal GitHub accounts.
          </p>
          <% params = { users_type: 'metered_ghe' } %>
          <%= render(Primer::Beta::Button.new(
            tag: :a,
            scheme: :primary,
            size: :large,
            href: enterprise_trial_signup_path(organization, params: params),
            mt: 2
          )) do %>
            Get started with personal accounts
          <% end %>
        </div>
      </div>
      <div class="mt-4 flex-1">
        <div class="border rounded-3 p-4">
          <%= render(Primer::Beta::Label.new(tag: :span, size: :large, scheme: :default)) { "Recommended for internal work" } %>
          <h3 class="dfd-trial__container-h3 my-2">Enterprise with managed users</h3>
          <p class="fgColor-muted my-2">
            Recommended for private, internal work only, with member accounts provisioned from your identity provider.
          </p>
          <p class="my-2 text-bold">
            <%= render(Primer::Beta::Octicon.new(icon: :globe, "aria-label": "Enterprise icon", mr: 1)) %>
            <% if current_user&.feature_enabled?(:digital_front_door_proxima) %>
              Choose which geographical location to store your data
            <% else %>
              For data residency,
              <%= render(
                Primer::Beta::Link.new(
                  href: "#{ent_contact_url}/data-residency",
                  classes: "Link--inTextBlock",
                  test_selector: "contact-sales-for-data-residency-link"
                )
              ) { "contact sales" } %>
            <% end %>
          </p>
          <% params = { users_type: 'enterprise_managed' } %>
          <%= render(Primer::Beta::Button.new(
            tag: :a,
            href: enterprise_trial_signup_path(organization, params: params),
            size: :large,
            mt: 2
          )) do %>
            Get started with managed users
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
