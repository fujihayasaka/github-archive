<%
  page_info title: "Choose an Enterprise plan"
%>

<div class="container-lg mt-md-8">
  <div class="d-md-flex flex-row-reverse flex-items-center gap-4 mx-4">
    <div class="col-md-6 col-lg-5 py-4 py-md-0" style="overflow:hidden;">
      <img src="<%= image_path "modules/enterprise/dfd-trial.png" %>" class="rounded-2" style="max-width:100%;height:auto;" alt="GitHub Enterprise">
    </div>
    <div class="col-md-6 col-lg-7">
      <%= render(Primer::Beta::Label.new(tag: :span, size: :large, scheme: :done, mb: 3)) { "30 day free trial" } %>
      <h1 style="font-weight:550;">Unlock GitHub's Premium Features</h1>
      <h2 class="mt-2 mb-2 h4 fgColor-done"><strong>What you get in your premium free trial:</strong></h2>
      <ul class="list-style-none">
        <li class="mb-2 ml-4">
          <span class="ml-n4"><%= primer_octicon(:check, color: :done, mr: 1) %></span>
          <span class="text-bold">Enterprise:</span> Seamlessly plan, build, and ship great software with an extensible DevOps platform
        </li>
        <li class="mb-2 ml-4">
          <span class="ml-n4"><%= primer_octicon(:check, color: :done, mr: 1) %></span>
          <span class="text-bold">Copilot Business:</span> Improve the developer experience with contextualized, AI-powered coding assistance
        </li>
        <li class="ml-4">
          <span class="ml-n4"><%= primer_octicon(:check, color: :done, mr: 1) %></span>
          <span class="text-bold">Advanced Security:</span> Spend less time fixing security vulnerabilities with AI-powered AppSec tools
        </li>
      </ul>
    </div>
  </div>
  <div class="pt-1 mt-1 mx-4">
    <div class="d-flex flex-wrap gap-4 mt-6">
      <div class="flex-1">
        <div class="border rounded-3 p-4">
          <%= render(Primer::Beta::Label.new(tag: :span, size: :large, scheme: :default)) { "Recommended for public and private work" } %>
          <h3 class="my-2">Enterprise with personal accounts</h3>
          <p class="fgColor-muted">Recommended for public, open source and private work, that allows members to access your repositories with their <%= render(Primer::Beta::Link.new(href: "#{GitHub.help_url}/admin/overview/about-github-enterprise-cloud", classes: "Link--inTextBlock")) { "personal GitHub accounts" } %>.</p>
          <% params = { users_type: 'metered_ghe' } %>
          <%= render(Primer::Beta::Button.new(
            tag: :a,
            scheme: :primary,
            href: enterprise_trial_signup_path(organization, params: params),
            mt: 2
          )) do %>
            Get started
          <% end %>
        </div>
      </div>
      <div class="flex-1">
        <div class="border rounded-3 p-4">
          <%= render(Primer::Beta::Label.new(tag: :span, size: :large, scheme: :default)) { "Recommended for internal work" } %>
          <h3 class="my-2">Enterprise with managed users</h3>
          <p class="fgColor-muted" style="min-height:63px;">Recommended for private, internal work only, with <%= render(Primer::Beta::Link.new(href: "#{GitHub.help_url}/admin/managing-iam/understanding-iam-for-enterprises/about-enterprise-managed-users", classes: "Link--inTextBlock")) { "company-provided accounts" } %> provisioned from your identity provider.</p>

          <% params = { users_type: 'enterprise_managed' } %>
          <%= render(Primer::Beta::Button.new(
            tag: :a,
            href: enterprise_trial_signup_path(organization, params: params),
            mt: 2
          )) do %>
            Get started
          <% end %>
          <p class="mt-3 mt-lg-0 mb-0 ml-lg-2 text-bold d-lg-inline">
            <%= render(Primer::Beta::Octicon.new(icon: :globe, "aria-label": "Enterprise icon", mr: 1)) %>For data residency, <%= render(Primer::Beta::Link.new(href: "#{ent_contact_url}/data-residency", classes: "Link--inTextBlock")) { "contact sales" } %>
          </p>
        </div>
      </div>
    </div>
  </div>
  <div class="f5 color-fg-muted text-center container-md mt-6">
    <div>
      Need more information? Contact your partner or seller.
      If you don't have one, <%= link_to "get in touch with sales", ent_contact_url, class: "Link--inTextBlock pt-4" %>.
    </div>
  </div>
</div>
