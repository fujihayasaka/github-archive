<div class="mt-2">
  <%= form_tag view.grant_path, class: "js-app-manager-permission-grant-form" do %>
    <%= hidden_field_tag :manager_id, nil, id: "manager_id" %>
    <%= hidden_field_tag :manager_type, nil, id: "manager_type" %>
    <div class="d-flex flex-items-start flex-column flex-sm-row flex-sm-items-end" style="gap: .5rem">
      <%= render(
        Primer::Beta::AutoComplete.new(
          label_text: "Search for teams or users by login or full name",
          input_id: "user_login_input",
          list_id: "user-permission-suggestions-list",
          src: view.suggestions_path,
          placeholder: "Search by team, username or full name",
          input_name: "user_login",
          full_width: true,
          data: {
            autocomplete_target: "input"
          }
      )) do |component| %>
        <% component.with_leading_visual_icon(icon: :search) %>
      <% end %>
      <%= render(Primer::Beta::Button.new(
        type: :submit,
        scheme: :primary,
        "aria-label": "Grant App Management permission"
      )) { "Grant" } %>
    </div>
  <% end %>
</div>
