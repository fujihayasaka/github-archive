<% page_info title: "Enterprise teams · #{this_business.name}",
  selected_link: :business_teams,
  sidebar: :people,
  stafftools: stafftools_enterprise_path(this_business) %>

<%= render layout: "businesses/layout", locals: {
    business: this_business,
    title: "Enterprise teams"
  } do %>

  <%= render_react_partial name: "enterprise-teams-table-view", props: {
    business_name: this_business.name,
    business_slug: this_business.slug,
    enterprise_teams:,
    readonly:,
    cannot_create_multiple_teams:,
    can_remove_teams:,
    search_param:,
  } %>
  <div class="paginate-container">
    <%= will_paginate paginated_teams %>
  </div>
<% end %>
