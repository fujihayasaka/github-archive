<% dialog_action = params[:bulk_action] %>
<% dialog_term = dialog_action == "add" ? "to" : "from" %>
<% improved_ui = FeatureFlag.vexi.enabled?("orgs_bulk_action_dialog_improvements", view.business, default: false) %>

<% if improved_ui %>
  <%= form_tag enterprise_people_bulk_actions_path(view.business), class: "d-flex flex-column", style: "height: 100%; min-height: 0;" do %>
    <div class="tmp-pt-4 tmp-px-4 flex-1 overflow-y-auto" style="min-height: 0;">
      <% if dialog_action == "remove" && BusinessTeam.enabled_for_enterprise?(business: view.business) %>
        <%= render(Primer::Alpha::Banner.new(
          scheme: :warning,
          test_selector: "business-teams-warning-banner",
          classes: "tmp-mb-4")) { BusinessTeam.remove_indirect_organization_membership_notice(actor: view.business) } %>
      <% end %>

      <p class="text-bold tmp-mb-2">
        Users to be <%= dialog_action %><%= "e" unless dialog_action == "remove" %>d <%= dialog_term %> selected organizations:
      </p>

      <div class="tmp-mb-4">
        <% view.selected_users.each do |user| %>
          <div class="d-inline-block bgColor-muted borderColor-muted border tmp-mr-2 tmp-mb-2 circle pl-1 pr-2 pb-1">
            <%= linked_avatar_for(user, 20, img_class: "avatar tmp-mr-1") %>
            <span class="text-bold"><%= profile_link(user) %></span>
          </div>
        <% end %>
      </div>

      <% if dialog_action == "remove" && view.all_organizations_team_users.any? %>
        <p class="text-bold tmp-mb-2">
          Users with team access to all organizations:
        </p>
        <div class="tmp-mb-4">
          <% view.all_organizations_team_users.each do |user| %>
            <div class="d-inline-block bgColor-muted borderColor-muted border tmp-mr-2 tmp-mb-2 circle pl-1 pr-2 pb-1">
              <%= linked_avatar_for(user, 20, img_class: "avatar tmp-mr-1") %>
              <span class="text-bold"><%= profile_link(user) %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <input type="hidden" name="bulk_action" value="<%= dialog_action %>">
      <p class="text-bold tmp-mb-2">Please select organizations to <%= dialog_action %> the selected users <%= dialog_term %>.</p>

      <div class="tmp-mb-2">
        <ul class="list-style-none border rounded-2">
          <% first = true %>
          <% view.business.organizations.each do |org| %>
            <% if org.adminable_by?(current_user) && (view.business.enterprise_managed_user_enabled? || !org.saml_sso_enforced?) %>
              <li class="d-flex flex-items-center flex-1 tmp-py-2 <%= "border-top" if !first %>">
                <div class="table-list-cell-checkbox v-align-middle tmp-pr-3 pl-2">
                  <input type="checkbox" name="organization_ids[]"
                    value="<%= org.id %>" aria-labelledby="org-<%= org.id %>"
                    <%= test_selector "actions-dialog-org-checkbox" %>>
                </div>
                <div class="d-flex flex-items-center">
                  <%= link_to user_path(org), id: "org-#{org.id}", class: "d-flex flex-items-center text-bold" do %>
                    <%= render GitHub::AvatarComponent.new actor: org, size: 20, mr: 2 %>
                    <%= org.safe_profile_name %>
                  <% end %>
                </div>
              </li>
              <% if first %>
                <% first = false %>
              <% end %>
            <% end %>
          <% end %>
        </ul>
      </div>

      <p class="note tmp-mb-3">Only organizations where you are an owner and without SAML SSO enforced can be selected.</p>
    </div>

    <div class="border-top tmp-px-4 tmp-py-3 flex-shrink-0 bgColor-default">
      <% users_count = view.selected_users.size %>
      <% view.selected_users.each do |user| %>
        <input type="hidden" name="user_ids[]" value="<%= user.id %>" <%= test_selector "actions-dialog-selected-user" %>>
      <% end %>

      <div class="d-flex flex-justify-end" style="gap: 8px;">
        <%= render Primer::Beta::Button.new(
          type: :reset,
          "data-close-dialog-id": dialog_action == "add" ? "bulk-add-dialog" : "bulk-remove-dialog",
          test_selector: "bulk-action-dialog-cancel-btn"
        ).with_content("Cancel") %>

        <%= render Primer::Beta::Button.new(
          type: :submit,
          scheme: dialog_action == "add" ? :primary : :danger,
          data: { disable_with: "" },
          test_selector: "bulk-action-dialog-submit-btn"
        ) do %>
          <%= dialog_action.capitalize %> <%= "user".pluralize(users_count) %>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <%= form_tag enterprise_people_bulk_actions_path(view.business) do %>
    <%= render(Primer::Alpha::Dialog::Body.new(classes: "tmp-mt-3")) do %>
      <% if dialog_action == "remove" && BusinessTeam.enabled_for_enterprise?(business: view.business) %>
        <%= render(Primer::Alpha::Banner.new(
          scheme: :warning,
          test_selector: "business-teams-warning-banner",
          classes: "tmp-mb-4")) { BusinessTeam.remove_indirect_organization_membership_notice } %>
      <% end %>

      <p>
        Users to be <%= dialog_action %><%= "e" unless dialog_action == "remove" %>d <%= dialog_term %> selected organizations:
      </p>

      <div class="mb-0">
        <% view.selected_users.each do |user| %>
          <div class="d-inline-block bgColor-muted borderColor-muted border tmp-mr-3 tmp-mb-3 circle pl-1 pr-2 pb-1">
            <%= linked_avatar_for(user, 16, img_class: "avatar mr-1") %>
            <%= profile_link(user) %>
          </div>
        <% end %>
      </div>

      <% if dialog_action == "remove" && view.all_organizations_team_users.any? %>
        <p class="tmp-mt-4">
          Users with team access to all organizations:
        </p>
        <div class="mb-0">
          <% view.all_organizations_team_users.each do |user| %>
            <div class="d-inline-block bgColor-muted borderColor-muted border tmp-mr-3 tmp-mb-3 circle pl-1 pr-2 pb-1">
              <%= linked_avatar_for(user, 16, img_class: "avatar mr-1") %>
              <%= profile_link(user) %>
            </div>
          <% end %>
        </div>
      <% end %>

      <input type="hidden" name="bulk_action" value="<%= dialog_action %>">
      <p class="mt-2">Please select organizations to <%= dialog_action %> the selected users <%= dialog_term %>.</p>

      <div class="mb-0">
        <ul class="list-style-none border rounded-2">
          <% first = true %>
          <% view.business.organizations.each do |org| %>
            <% if org.adminable_by?(current_user) && (view.business.enterprise_managed_user_enabled? || !org.saml_sso_enforced?) %>
              <li class="d-flex flex-items-start flex-1 pb-1 pt-1 <%= "border-top" if !first %>">
                <div class="table-list-cell-checkbox py-1 v-align-middle tmp-pr-3 pl-2">
                  <input type="checkbox" name="organization_ids[]"
                    value="<%= org.id %>" aria-labelledby="org-<%= org.id %>"
                    <%= test_selector "actions-dialog-org-checkbox" %>>
                </div>
                <div class="d-flex flex-items-center">
                  <div>
                    <%= link_to user_path(org), id: "org-#{org.id}" do %>
                      <%= render GitHub::AvatarComponent.new actor: org, size: 16, mr: 2 %>
                      <%= org.safe_profile_name %>
                    <% end %>
                  </div>
                </div>
              </li>
              <% if first %>
                <% first = false %>
              <% end %>
            <% end %>
          <% end %>
        </ul>
      </div>

      <p class="note">Only organizations where you are an owner and without SAML SSO enforced can be selected.</p>
    <% end %>

    <%= render(Primer::Alpha::Dialog::Footer.new) do %>
      <% users_count = view.selected_users.size %>
      <% view.selected_users.each do |user| %>
        <input type="hidden" name="user_ids[]" value="<%= user.id %>" <%= test_selector "actions-dialog-selected-user" %>>
      <% end %>
      <%= render Primer::Beta::Button.new(
        type: :submit,
        scheme: :danger,
        data: { disable_with: "" }
      ) do %>
        <%= dialog_action.capitalize %> <%= "user".pluralize(users_count) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
