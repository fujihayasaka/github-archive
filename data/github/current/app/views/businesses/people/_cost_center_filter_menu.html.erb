<%= render Primer::Alpha::ActionMenu.new(
  test_selector: "cost-center-filter-button",
  menu_id: "cost-center-filter-menu",
  select_variant: :single,
  anchor_align: :end,
) do |menu| %>
  <% menu.with_show_button do |button| %>
    <% button.with_trailing_action_icon(icon: :"triangle-down") %>
    Cost center
  <% end %>

  <% current_value = view.cost_center %>

  <% menu.with_item(
    label: "Everyone",
    href: people_enterprise_path(this_business.slug, query: view.apply_query_filters(cost_center: nil)),
    active: current_value.nil?
  ) %>

  <% value = Business::FILTER_VALUE_NO_COST_CENTER %>
  <% menu.with_item(
    label: "No cost center",
    href: people_enterprise_path(this_business.slug, query: view.apply_query_filters(cost_center: value)),
    active: current_value == value
  ) %>

  <% unless this_business.cost_centers.nil? %>
    <% this_business.cost_centers.each do |cost_center| %>
      <% value = filter_value_for_cost_center(this_business, cost_center) %>
      <% menu.with_item(
        label: cost_center.dig(:name),
        href: people_enterprise_path(this_business.slug, query: view.apply_query_filters(cost_center: value)),
        active: current_value == value
      ) %>
    <% end %>
  <% end %>
<% end %>

