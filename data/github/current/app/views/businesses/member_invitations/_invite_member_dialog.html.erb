<%= render Primer::Alpha::Dialog.new(
  title: "Invite user to #{business.safe_profile_name}",
  id: "invite-unaffiliated-member-dialog",
  size: :medium,
  test_selector: "invite-unaffiliated-member") do |d| %>
  <% d.with_header(show_divider: false, visually_hide_title: true) do |h| %>
    <h1 class="Overlay-title">Invite user to <%= business.safe_profile_name %>
      <%= render(Primer::Beta::Label.new(tag: :span, size: :medium, inline: true, scheme: :success)) { "Preview" } %>
    </h1>
  <% end %>
  <% d.with_show_button(
    scheme: :primary,
    size: :medium,
    type: :button, "aria-label": "Invite someone",
    test_selector: "invite-member") do %>
    Invite member
  <% end %>
  <%= form_tag enterprise_member_invitation_path(business), method: :post do %>
    <%= render(Primer::Alpha::Dialog::Body.new(pt: 0)) do %>
      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted)) do %>
        You can invite a member to this enterprise account as an unaffiliated user.
        An unaffiliated user is not a member of any of your organizations.
        You can assign a Copilot license to unaffiliated users or add them to an organization later.
      <% end %>
      <%= render Primer::Beta::AutoComplete.new(
        label_text: "Search by username, full name or email address",
        src: enterprise_member_invitee_suggestions_path(business),
        list_id: "enterprise-invite-complete-results",
        input_id: "identifier",
        full_width: true,
      ) do |c| %>
        <% c.with_leading_visual_icon(icon: :search) %>
      <% end %>
    <% end %>
    <%= render(Primer::Alpha::Dialog::Footer.new) do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "invite-unaffiliated-member-dialog" })) { "Cancel" } %>
      <%= render(Primer::Beta::Button.new(
        type: :submit,
        scheme: :primary,
        "data-disable-with": "",
      )) do %>
        Invite
      <% end %>
    <% end %>
  <% end %>
<% end %>



