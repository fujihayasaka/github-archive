<%= render(Primer::Alpha::SelectPanel::ItemList.new(
  aria: { label: "enterprise members" },
)) do |list| %>
  <% users.each do |user| %>
    <% list.with_item(
      label: user.display_login,
      size: :medium,
      content_arguments: { data: { value: user.display_login } }
    ) do |item| %>
      <% item.with_leading_visual_raw_content do %>
        <%= render(Primer::Beta::Avatar.new(src: user.primary_avatar_url, alt: "", size: 20, shape: :circle)) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
