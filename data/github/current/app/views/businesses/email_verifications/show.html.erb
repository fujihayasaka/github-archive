<%
  page_info title: "Verify your email"
%>

<div class="d-flex flex-items-start flex-justify-center min-height-full tmp-p-3 tmp-p-md-6">
  <div class="d-flex flex-column flex-auto tmp-px-4 tmp-pt-3 tmp-pb-6" style="max-width: 956px;">
    <div class="dfd-trial__form-container" data-hpc>
      <div class="dfd-trial__form-wrapper">
        <div class="dfd-trial__form-header">
          <h1 class="f2-light lh-condensed-ultra color-fg-default">
            Verify your email
          </h1>
          <p class="f4 color-fg-muted tmp-mt-3 mb-0 tmp-pb-3">
            We've sent a 6-digit verification code to <strong><%= current_user.email %></strong>
            for <%= business.name %>. Please enter the code below to continue.
          </p>
        </div>

        <div class="email-verification-form-container">
          <% form_url = with_param.present? ? business_email_verification_path(business, with: with_param) : business_email_verification_path(business) %>
          <%= form_with url: form_url, method: :patch, local: true, class: "dfd-trial__form d-flex flex-column", id: "email_verification_form" do |form| %>
            <% if with_param.present? %>
              <%= form.hidden_field :with, value: with_param %>
            <% end %>
            <div class="form-group d-flex flex-column">
              <%= form.label :code, "Verification code", class: "form-label f5 color-fg-default" %>
              <%= form.text_field :code,
                class: "form-control input-lg color-fg-subtle f5",
                placeholder: "Enter 6-digit code",
                maxlength: 6,
                pattern: "[0-9]{6}",
                required: true,
                autocomplete: "one-time-code" %>
              <p class="f6 color-fg-subtle mt-1">Your code will expire in 2 hours</p>
            </div>

            <div class="form-actions d-flex tmp-pb-3">
              <%= form.submit "Verify Email", class: "btn btn-primary btn-medium" %>
            </div>
          <% end %>
        </div>

        <div class="resend-email-form-container tmp-mt-4 d-flex flex-justify-left">
          <p class="f6 color-fg-subtle">
            Didn't receive the code?
            <% resend_url = with_param.present? ? business_email_verification_path(business, with: with_param) : business_email_verification_path(business) %>
            <%= form_with url: resend_url, method: :post, local: true, class: "d-inline ml-2", id: "resend_email_form" do |form| %>
              <% if with_param.present? %>
                <%= form.hidden_field :with, value: with_param %>
              <% end %>
              <%= form.submit "Resend verification email", class: "btn-link color-fg-accent", style: "background: none; border: none; padding: 0; text-decoration: underline; cursor: pointer; font-size: inherit;" %>
            <% end %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
