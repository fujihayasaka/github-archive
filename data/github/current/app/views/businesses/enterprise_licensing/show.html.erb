<%
  title = "Licensing"
  selected_link = :business_licensing
  sidebar = :billing_and_licensing
%>

<% page_info title: title,
    selected_link: selected_link,
    sidebar: sidebar,
    stafftools: stafftools_enterprise_licensing_path(this_business)
%>
<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    title: title,
    header_component_action: this_business.eligible_for_self_serve_metered_transition?(user: current_user) ?
      link_to("Switch to metered billing", edit_multi_checkout_enterprise_path(this_business, volume_to_metered: true)) : nil
  } do %>

  <% view = Businesses::EnterpriseLicensing::ShowView.new(business: this_business, viewer: current_user) %>
  <% is_copilot_only = this_business.copilot_licensing_enabled? && this_business.seats_plan_basic? %>
  <% hide_copilot_overview = this_business.trial? && this_business.copilot_trial_activation_blocked? && !Copilot::Business.new(this_business).copilot_enabled? %>

  <%= render Billing::Settings::EnterpriseWithOutstandingInvoicesPleasePayComponent.new(business: this_business, current_user: current_user) %>

  <% if !Billing::Settings::EnterpriseContractGlobalExpirationBannerComponent.new(business: this_business, current_user: current_user).render? %>
    <%= render Billing::Settings::EnterpriseContractEarlyExpirationBannerComponent.new(business: this_business, current_user: current_user) %>
    <%= render Billing::Settings::EnterpriseContractStatusBannerComponent.new(business: this_business, current_user: current_user) %>
  <% end %>

  <div data-hpc>
    <%= render "businesses/enterprise_licensing/copilot_standalone_licenses", view: view if enterprise_copilot_licensing_enabled?(this_business) %>

    <% if !is_copilot_only %>
      <%= render_fallback_on_error(fallback: render("businesses/enterprise_licensing/error_fallback", message: "Could not load Enterprise Cloud data.")) do %>
        <%= render_react_partial(
          name: "licensing-enterprise-overview",
          props: {
            enterpriseContactUrl: ent_contact_url,
            ghe: ghe_overview_react_payload(business: this_business, preopen_seat_management: params[:manage_seats] == 'true', current_user:),
            slug: this_business.slug,
          }
        ) %>
      <% end %>
    <% end %>

    <%= render_fallback_on_error(fallback: render("businesses/enterprise_licensing/error_fallback", message: "Could not load Advanced Security data.")) do %>
      <%= render_react_partial(
        name: "licensing-advanced-security-overview",
        props: {
          enterpriseContactUrl: ent_contact_url,
          ghas: ghas_overview_react_payload(
            business: this_business,
            viewer: current_user,
            preopen_seat_management: params[:manage_committers_view] == 'true',
          ),
          tradeScreeningResult: trade_screening_banner_react_payload(
            target: this_business,
            check_for_current_user: true,
            title: "We are unable to provide this feature"
          ),
          slug: this_business.slug,
        }
      ) %>
    <% end %>

    <% if show_code_quality_licensify_ui?([current_user, this_business.customer]) %>
      <%= render_fallback_on_error(fallback: render("businesses/enterprise_licensing/error_fallback", message: "Could not load Code Quality data.")) do %>
        <div <%= test_selector("licensify-code-quality-overview") %>>
          <%= render_react_partial(
            name: "licensing-code-quality-overview",
            props: {
              codeQuality: licensify_code_quality_overview_react_payload(business: this_business, enterprise_contact_url: ent_contact_url),
              slug: this_business.slug,
            }
          ) %>
        </div>
      <% end %>
    <% end %>

    <% if !enterprise_copilot_licensing_enabled?(this_business) && !hide_copilot_overview %>
      <% if show_licensify_copilot_ui?([current_user, this_business.customer], business: this_business) %>
        <%= render_fallback_on_error(fallback: render("businesses/enterprise_licensing/error_fallback", message: "Could not load Copilot data.")) do %>
          <div <%= test_selector("licensify-copilot-overview") %>>
            <%= render_react_partial(
              name: "licensing-copilot-overview",
              props: {
                enterpriseContactUrl: ent_contact_url,
                copilot: licensify_copilot_overview_react_payload(business: this_business, current_user:),
                slug: this_business.slug,
              }
            ) %>
          </div>
        <% end %>
      <% else %>
        <%= render_fallback_on_error(fallback: render("businesses/enterprise_licensing/error_fallback", message: "Could not load Copilot data.")) do %>
          <%= render_react_partial(
            name: "licensing-copilot-overview",
            props: {
              enterpriseContactUrl: ent_contact_url,
              copilot: copilot_overview_react_payload(business: this_business, current_user:),
              slug: this_business.slug,
            }
          ) %>
        <% end %>
      <% end %>
    <% end %>

    <% if !is_copilot_only && (this_business.metered_ghes_eligible? || this_business.advanced_security_products_metered?)  %>
      <%= render_fallback_on_error(fallback: render("businesses/enterprise_licensing/error_fallback", message: "Could not load Enterprise Server data.")) do %>
        <%= render_react_partial(
          name: "licensing-enterprise-server-overview",
          props: {
            ghesUsage: ghes_overview_react_payload(
              business: this_business
            )
          }
        ) %>
      <% end %>
    <% end %>

    <% if !is_copilot_only && (this_business.metered_ghes_eligible? || !this_business.metered_plan?) %>
      <%= render "businesses/enterprise_licensing/enterprise_server_licenses", view: view %>
      <%= render "businesses/enterprise_licensing/enterprise_server_instances", view: view %>
    <% end %>
  </div>

<% end %>
