<% error ||= nil %>

<%
  if this_business.customer&.billed_via_billing_platform?
    selected_link = :business_licensing
    sidebar = :billing_and_licensing
  else
    selected_link = :enterprise_licensing
    sidebar = :settings
  end

  page_info title: title,
    selected_link: selected_link,
    sidebar: sidebar,
    stafftools: stafftools_enterprise_licensing_path(this_business)
%>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    # title: title,
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  } do %>

  <% if !copilot_business.copilot_billable? && !copilot_business.has_trial_organization? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: "credit-card", mb: 3)) do |component| %>
      <% component.with_action_content do %>
        <%= render(Primer::Button.new(tag: :a, href: settings_billing_tab_enterprise_path(this_business, tab: :payment_information))) do %>
          Add payment method
        <% end %>
      <% end %>
      <%= render(Primer::Beta::Text.new) do %>
        You must add a payment method in order to use Copilot.
      <% end %>
    <% end %>
  <% end %>

  <% if error.present? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: :stop, mb: 3)) do %>
      <%= error %>
    <% end %>
  <% end %>

  <%= render_react_partial(
    name: "licensing-copilot-details",
    props: {
      slug: this_business.slug,
      copilotDetails: copilot_details_react_payload(business: this_business),
      organizations: copilot_organization_react_payload(business: this_business),
      users: copilot_users_react_payload(business: this_business),
      isCopilotUserFlagEnabled: this_business.feature_enabled?(:copilot_business_user_assignment),
      isCopilotEnterpriseTeamsFlagEnabled: this_business.feature_enabled?(:copilot_business_enterprise_team_assignment),
    }
  )%>
<% end %>
