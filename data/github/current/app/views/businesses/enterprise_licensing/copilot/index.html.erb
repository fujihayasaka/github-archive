<% error ||= nil %>

<%
  selected_link = :business_licensing
  sidebar = :billing_and_licensing

  page_info title: title,
    selected_link: selected_link,
    sidebar: sidebar,
    stafftools: stafftools_enterprise_licensing_path(this_business)
%>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    # title: title,
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  } do %>

  <% if !copilot_business.copilot_billable? && !copilot_business.has_trial_organization? && !this_business.digital_front_door? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: "credit-card", classes: "tmp-mb-3")) do |component| %>
      <% component.with_action_content do %>
        <%= render(Primer::Beta::Button.new(tag: :a, href: enterprise_billing_payment_information_path(this_business))) do %>
          Add payment method
        <% end %>
      <% end %>
      <%= render(Primer::Beta::Text.new) do %>
        You must add a payment method in order to use Copilot.
      <% end %>
    <% end %>
  <% end %>

  <% if error.present? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: :stop, classes: "tmp-mb-3")) do %>
      <%= error %>
    <% end %>
  <% end %>

  <div data-hpc>
    <%= render_fallback_on_error(fallback: render("businesses/enterprise_licensing/error_fallback", message: "Could not load Enterprise Cloud data.")) do %>
      <%= render_react_partial(
        name: "licensing-copilot-details",
        props: {
          slug: this_business.slug,
          copilotDetails: copilot_details_react_payload(business: this_business),
          isCopilotBusinessTeamFlagEnabled: business_has_copilot_business_team_assignment_flags_enabled?(business: this_business),
          policiesPath: policies_path,
        }
      )%>
    <% end %>
  </div>
<% end %>
