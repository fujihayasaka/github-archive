<% if view.business.has_active_advanced_security_trial? %>
  <%= render Businesses::Billing::AdvancedSecurity::TrialComponent.new(
      business: view.business
    )
  %>
<% elsif view.business.has_self_serve_advanced_security? %>
  <%= render Businesses::Billing::AdvancedSecurity::SelfServeLicensingComponent.new(business: view.business, user: current_user) %>
<% elsif view.advanced_security_purchased_for_entity? %>
  <% if view.invoiced_self_serve_eligible? %>
    <% if view.business.eligible_for_renewal? %>
      <% description =
        render(Primer::Beta::Button.new(scheme: :primary, tag: :a, href: billing_renew_enterprise_path(view.business))) do
          "Renew GitHub Advanced Security"
        end
      %>
    <% elsif view.business.eligible_for_upgrade? %>
      <% description =
        render(Primer::Beta::Button.new(scheme: :primary, tag: :a, href: billing_add_seats_enterprise_path(view.business))) do
          "Add committers"
        end
      %>
    <% else %>
      <% description = view.valid_until_text %>
    <% end %>
  <% else %>
    <% description = view.valid_until_text %>
  <% end %>
  <%= render Businesses::Billing::AdvancedSecurity::LicensingComponent.new(
    description: description,
    test_selector: "advanced-security-license-sales-serve",
  ) do |info| %>
    <% seat_usage = AdvancedSecurity::SeatUsageComponent.new(
        **AdvancedSecurity::SeatUsageComponent.kwargs_for(view.business)
      )
    %>
    <% info.with_control do %>
      <%= render(Billing::DownloadReportComponent.new(tag: :a, ml: 3, variant: :small, href: download_active_committers_enterprise_licensing_path(view.business))) %>
    <% end %>
    <% if view.business.advanced_security_metered_for_entity? %>
      <%= info.with_banner do %>
        This account is using metered billing.
      <% end %>
    <% elsif seat_usage.banner_required? %>
      <%= info.with_banner(**seat_usage.banner_arguments) do %>
        <%= seat_usage.banner_message %>
      <% end %>
    <% end %>
    <% info.with_body do %>
      <%= render(seat_usage) %>
      <%= render(Billing::ValidUntilComponent.new(
        expiration_date: view.business.billing_term_ends_on,
        renewal_scheduled_start_datetime: view.business.renewal_scheduled_start_datetime,
        has_renewal: view.business.ghas_renewal?
      )) %>
    <% end %>

    <% if view.business.feature_enabled?(:ghe_sales_serve_renewals) %>
      <% if view.business.has_any_failed_ghas_change_requests? %>
        <% info.with_status(scheme: :failure) do %>
          Your GitHub Advanced Security upgrade failed, please contact sales.
        <% end %>
      <% elsif view.business.has_any_pending_renewal_requests? && view.business.renewal_change_request.github_advanced_security_change? %>
        <% if view.business.ghas_renewal_seat_quantity_difference.positive? %>
          <% info.with_status(scheme: :success) do %>
            Your GitHub Advanced Security renewal is being processed.
          <% end %>
        <% end %>
      <% elsif view.business.has_any_pending_update_requests? && view.business.update_change_request.github_advanced_security_change? %>
        <% ghas_seats_difference = view.business.ghas_update_seat_quantity_difference %>

        <% info.with_status(scheme: :success) do %>
          <% if ghas_seats_difference&.positive? %>
            Your upgrade of <%= pluralize( view.business.ghas_update_seat_quantity_difference, "GitHub Advanced Security committer") %> is being processed.
          <% else %>
            Your GitHub Advanced Security upgrade is being processed.
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% elsif view.business.potentially_trial_or_purchase_advanced_security? && (view.business.eligible_for_self_serve_advanced_security_trial?(skip_shared_checks: true) || view.business.eligible_for_self_serve_advanced_security?(skip_shared_checks: true)) %>
  <%= render Businesses::Billing::AdvancedSecurity::LicensingComponent.new(
    test_selector: "advanced-security-license-promo",
  ) do |promo| %>
    <% promo.with_control do %>
      <%# rubocop:disable GitHub/RailsViewRenderLiteral %>
      <%# this ^ incorrectly flags the render call below as problematic %>
      <% advanced_security_trial_eligible = view.business.eligible_for_self_serve_advanced_security_trial? %>
        <%= render Businesses::Billing::AdvancedSecurity::StartFreeTrialComponent.new(
          business: view.business,
          user: current_user
        )
        %>
    <% end %>
    <% promo.with_body(direction: :column, align_items: :flex_start) do %>
      <%= render partial: "billing_settings/benefits/subscription_advanced_security" %>
      <%= render(Hydro::TrackViewComponent.new(name: "advanced-security-license-promo")) %>
    <% end %>
  <% end %>
<% end %>
