<% page_info title: "Enterprise roles · #{business.name}", selected_link: :enterprise_role_management, sidebar: :people, stafftools: stafftools_enterprise_path(business) %>

<%= render layout: "businesses/layout", locals: { business: business} do %>
  <%= render(CustomRoles::BannerComponent.new(mb: 3)) %>

  <%= render(Primer::Beta::Breadcrumbs.new(mb: 3)) do |component| %>
    <% component.with_item(href: enterprise_roles_path) { "Role management" } %>
    <% component.with_item(href: edit_enterprise_role_path(business, role)) { "Edit custom role" } %>
  <% end %>
  <%= render(EnterpriseRoles::FormComponent.new(owner: business, role: role, assignment_counts: assignment_counts)) %>
<% end %>
