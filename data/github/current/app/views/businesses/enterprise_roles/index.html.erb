<% page_info title: "Enterprise roles · #{business.name}", selected_link: :enterprise_role_management, sidebar: :people, stafftools: stafftools_enterprise_path(business) %>
<% custom_role_limit = EnterpriseRole.custom_role_limit_for_enterprise(business) %>

<%= render layout: "businesses/layout", locals: { business: business } do %>
  <div class="d-flex flex-column gap-3">
    <%= render(CustomRoles::BannerComponent.new) %>

    <div class="pb-2">
      <%= render(Primer::Beta::Subhead.new(mb: 2)) do |component| %>
        <% component.with_heading(size: :medium, tag: :h1) do  %>
          Enterprise role management
        <% end %>
      <% end %>

      <%= render(Primer::Beta::Text.new(color: :subtle)) do %>
        Enterprise roles give users and enterprise teams access to specific parts of your enterprise settings.
      <% end %>
    </div>

    <div class="d-flex flex-column gap-1 pt-1">
      <div class="d-flex gap-3">
        <%= render(Primer::Beta::Subhead.new(hide_border: true, mb: 1, flex: 1)) do |component| %>
          <% component.with_heading(size: :medium, tag: :h2) do  %>
            Custom enterprise roles
          <% end %>
          <% component.with_description(test_selector: "subheading-text") do %>
            Create a role and add permissions to it. You can create up to <%= pluralize(custom_role_limit, "custom role") %> to fit your needs.
          <% end %>
        <% end %>
        <div class="pt-1">
          <% if viewer_permissions[:write] %>
            <% if EnterpriseRole.custom_roles_for_enterprise(this_business).size < custom_role_limit %>
              <%= render(Primer::Beta::Button.new(
                scheme: :primary,
                tag: :a,
                href: new_enterprise_role_path(business),
                test_selector: "create-role-button",
              )) do |button| %>
                Create custom role
              <% end %>
            <% else %>
              <%= render(Primer::Beta::Button.new(
                id: "create-role-button",
                inactive: true,
                test_selector: "create-role-button-inactive",
              )) do |button| %>
                <% button.with_tooltip(text: "Reached max of #{custom_role_limit} custom #{"role".pluralize(custom_role_limit)}. Remove existing roles to create new ones", direction: :n) %>
                Create custom role
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
      <%= render(Businesses::CustomRoles::EnterpriseRolesListComponent.new(business: business, viewer_permissions: viewer_permissions)) %>
    </div>
  </div>
<% end %>
