<% page_info title: "Audit log", sidebar: :settings, selected_link: :business_audit_log_stream_settings,
  stafftools: stafftools_enterprise_path(business) %>

<%= render layout: "businesses/layout",
  locals: {
    business: business,
    title: "Audit log",
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  } do %>
  <%= render "businesses/audit_log/tabs", business: business %>
  <%= render Primer::Beta::Subhead.new(spacious: false) do |component| %>
    <% component.with_heading(tag: :h3, font_size: 3, font_weight: :bold, pb: 2) do %>Microsoft Purview stream configuration<% end %>
    <% component.with_description do %>
      This stream was authorized via Microsoft Entra admin consent. There are no
      customer-supplied credentials to update. To change the tenant or re-authorize,
      delete this stream and create a new one.
    <% end %>
  <% end %>
  <div class="gutter clearfix d-flex flex-shrink-0">
    <div class="col-8">
      <dl class="form-group">
        <dt><%= label_tag :tenant_id, "Tenant ID" %></dt>
        <dd><%= text_field_tag :tenant_id, stream.sink.tenant_id, disabled: true %></dd>
      </dl>
      <div class="tmp-mt-3">
        <%= render Primer::Beta::Button.new(tag: :a, href: show_settings_audit_log_streams_enterprise_path(business)) do %>
          Back to streams
        <% end %>
      </div>
    </div>
  </div>
<% end %>
