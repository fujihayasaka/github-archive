<% page_info title: "Audit log", sidebar: :settings, selected_link: :business_audit_log_stream_settings,
  stafftools: stafftools_enterprise_path(business) %>

<%= render layout: "businesses/layout",
  locals: {
    business: business,
    title: "Audit log",
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  } do %>
  <%= render "businesses/audit_log/tabs", business: business %>
  <%= render Primer::Beta::Subhead.new(spacious: false) do |component| %>
    <% component.with_heading(tag: :h3, font_size: 3, font_weight: :bold, pb: 2) do %>Configure Audit log streaming to Microsoft Purview<% end %>
    <% component.with_description do %>
      Stream audit logs to Microsoft Purview. GitHub will request admin consent from your
      Microsoft Entra tenant to authorize the connection.
      <a class="Link--inTextBlock" href="https://learn.microsoft.com/en-us/purview/purview-portal" aria-label="Learn more about audit log streaming" target="_blank" rel="noopener noreferrer">Learn more.</a>
    <% end %>
  <% end %>
  <%= form_tag microsoft_purview_initiate_settings_audit_log_streams_enterprise_path(business), method: :post do %>
    <div class="gutter clearfix d-flex flex-shrink-0">
      <div class="col-8">
        <p class="color-fg-muted">Clicking the button below will redirect you to Microsoft to grant admin consent for your Entra tenant. You will be redirected back to GitHub when authorization is complete.</p>
        <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary) do %>
          Authorize with Microsoft Entra
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
