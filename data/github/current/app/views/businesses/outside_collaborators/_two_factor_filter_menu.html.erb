<%# erblint:counter DeprecatedComponentsCounter 1 %>
<% view = Businesses::OutsideCollaboratorsView.new(query: query) %>

<details class="details-reset details-overlay select-menu d-inline-block" <%= test_selector("two-factor-filter") %>>
  <%= render Primer::ButtonComponent.new(tag: :summary, classes: "select-menu-button") do %>
    Two-factor authentication
  <% end %>

  <details-menu class="select-menu-modal position-absolute mr-n2 right-0" style="z-index: 99;"><%# erblint:disable Primer::Accessibility::DetailsMenuMigration %>
    <div class="select-menu-header">
      <span class="select-menu-title">Filter by two-factor authentication method</span>
    </div>
    <div class="select-menu-list">
      <a href="<%= enterprise_outside_collaborators_path(this_business, query: view.apply_query_filters(two_factor_status: nil)) %>"
          class="select-menu-item" aria-checked="<%= view.two_factor_status.nil? %>" role="menuitemradio">
        <%= primer_octicon(:check, classes: "select-menu-item-icon") %>
        <div class="select-menu-item-text">Everyone</div>
      </a>
      <% value = BusinessesHelper::TWO_FACTOR_STATUS["SECURE"] %>
      <a href="<%= enterprise_outside_collaborators_path(this_business, query: view.apply_query_filters(two_factor_status: value)) %>"
          class="select-menu-item" aria-checked="<%= view.two_factor_status == value %>" role="menuitemradio">
        <%= primer_octicon(:check, classes: "select-menu-item-icon") %>
        <div class="select-menu-item-text">Secure</div>
      </a>
      <% if GitHub.two_factor_sms_enabled? %>
        <% value = BusinessesHelper::TWO_FACTOR_STATUS["INSECURE"] %>
        <a href="<%= enterprise_outside_collaborators_path(this_business, query: view.apply_query_filters(two_factor_status: value)) %>"
            class="select-menu-item" aria-checked="<%= view.two_factor_status == value %>" role="menuitemradio">
          <%= primer_octicon(:check, classes: "select-menu-item-icon") %>
          <div class="select-menu-item-text">Insecure</div>
        </a>
      <% end %>
      <% value = BusinessesHelper::TWO_FACTOR_STATUS["DISABLED"] %>
      <a href="<%= enterprise_outside_collaborators_path(this_business, query: view.apply_query_filters(two_factor_status: value)) %>"
          class="select-menu-item" aria-checked="<%= view.two_factor_status == value %>" role="menuitemradio">
        <%= primer_octicon(:check, classes: "select-menu-item-icon") %>
        <div class="select-menu-item-text">Disabled</div>
      </a>
    </div>
  </details-menu>
</details>
