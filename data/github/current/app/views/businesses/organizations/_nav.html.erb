<% view = Businesses::OrganizationsView.new(query: query) %>
<% user_can_view_org_details = this_business.owner?(current_user) %>

<div class="d-flex flex-items-center flex-justify-between mb-3">
  <div class="d-flex flex-justify-between flex-column-reverse width-full mb-0">
    <%= form_tag enterprise_organizations_path(this_business),
      method: :get,
      "data-autosearch-results-container": "business-organizations-list" do %>
      <div class="auto-search-group">
        <input class="form-control width-full auto-search-input js-member-filter-field"
          type="text"
          name="query"
          value="<%= params[:query] %>"
          placeholder="Find an organization…"
          aria-label="Find an organization…"
          autocomplete="off"
          data-throttled-autosubmit>
        <%= render Primer::Beta::Octicon.new(icon: "search") %>
        <%= render(Primer::Beta::Spinner.new(size: :small, classes: "spinner")) %>
      </div>
    <% end %>
  </div>
  <div class="d-flex width-full flex-justify-end">
    <% if user_can_view_org_details %>
      <div>
        <%= render Primer::Alpha::ActionMenu.new(
          select_variant: :single,
          anchor_align: :end
        ) do |menu| %>
          <% menu.with_show_button(scheme: :invisible, border: true, color: :muted, text: :normal, font_weight: :normal) do |button|
            button.with_trailing_action_icon(icon: :"triangle-down")
            "Two-factor authentication"
          end %>
          <% menu.with_item(
              href: enterprise_organizations_path(this_business, query: view.apply_query_filters(two_factor_policy: nil)),
              label: "All organization",
              active: view.two_factor_policy.nil?,
          ) %>
          <% menu.with_item(
              href: enterprise_organizations_path(this_business, query: view.apply_query_filters(two_factor_policy: "enabled")),
              label: "2FA Required",
              active: view.two_factor_policy == "enabled",
          ) %>
          <% menu.with_item(
            href: enterprise_organizations_path(this_business, query: view.apply_query_filters(two_factor_policy: "disabled")),
            label: "2FA Not Required",
            active: view.two_factor_policy == "disabled",
          ) %>
        <% end %>
      </div>
      <div class="ml-2">
        <%= render Primer::Alpha::ActionMenu.new(
          select_variant: :single,
          anchor_align: :end
        ) do |menu| %>
          <% menu.with_show_button(scheme: :invisible, border: true, color: :muted, text: :normal, font_weight: :normal) do |button|
            button.with_trailing_action_icon(icon: :"triangle-down")
            "Deploy keys"
          end %>
          <% menu.with_item(
              href: enterprise_organizations_path(this_business, query: view.apply_query_filters(has_deploy_keys: nil)),
              label: "All organization",
              active: view.has_deploy_keys.nil?,
          ) %>
          <% menu.with_item(
            href: enterprise_organizations_path(this_business, query: view.apply_query_filters(has_deploy_keys: "true")),
            label: "Has deploy keys",
            active: view.has_deploy_keys == "true",
          ) %>
          <% menu.with_item(
            href: enterprise_organizations_path(this_business, query: view.apply_query_filters(has_deploy_keys: "false")),
            label: "No deploy keys",
            active: view.has_deploy_keys == "false",
          ) %>
        <% end %>
      </div>
    <% end %>
    <div class="ml-2">
      <%= render Primer::Alpha::ActionMenu.new(
        select_variant: :single,
        anchor_align: :end
      ) do |menu| %>
        <% menu.with_show_button(scheme: :invisible, border: true, color: :muted, text: :normal, font_weight: :normal) do |button|
          button.with_trailing_action_icon(icon: :"triangle-down")
          "Your role"
        end %>
        <% menu.with_item(
            href: enterprise_organizations_path(this_business, query: view.apply_query_filters(viewer_role: nil)),
            label: "All organization",
            active: view.viewer_role.nil?,
        ) %>
        <% menu.with_item(
          href: enterprise_organizations_path(this_business, query: view.apply_query_filters(viewer_role: "owner")),
          label: "I'm an owner",
          active: view.viewer_role == "owner",
        ) %>
        <% menu.with_item(
          href: enterprise_organizations_path(this_business, query: view.apply_query_filters(viewer_role: "member")),
          label: "I'm a member",
          active: view.viewer_role == "member",
        ) %>
        <% menu.with_item(
          href: enterprise_organizations_path(this_business, query: view.apply_query_filters(viewer_role: "unaffiliated")),
          label: "Not a member",
          active: view.viewer_role == "unaffiliated",
        ) %>
      <% end %>
    </div>
  </div>
</div>
