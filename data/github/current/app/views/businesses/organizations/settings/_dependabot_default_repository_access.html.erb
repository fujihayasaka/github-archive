<% header = capture do %>
  <% if this_business.config.get(Configurable::DependabotDefaultRepositoryAccess::DEPENDABOT_DEFAULT_ACCESS_KEY).nil? %>
    Your organizations' current settings are shown below. If you change this setting
    to <span class="text-bold">Public</span> or <span class="text-bold">Public + Internal</span>
    the enterprise policy will override these values.
  <% else %>
    Your organizations' settings without the enterprise policy are shown below.
    If you adjust this setting with <span class="text-bold">No policy</span>,
    then the organizations will use the configuration outlined below.
  <% end %>
<% end %>

<% counts = this_business.dependabot_default_repository_access_setting_organization_counts %>

<%= render layout: "businesses/organizations/settings/layout",
  locals: { header: header } do %>
  <%= render partial: "businesses/organizations/settings/row", locals: {
    organizations: this_business.dependabot_default_repository_access_setting_organizations(value: "public"),
    total_count: counts["public"],
    label: "Public",
    description: "Dependabot can only access public repositories."
  } %>
  <%= render partial: "businesses/organizations/settings/row", locals: {
    organizations: this_business.dependabot_default_repository_access_setting_organizations(value: "internal"),
    total_count: counts["internal"],
    label: "Public + Internal",
    description: "Dependabot can access public and internal repositories."
  } %>
<% end %>
