<%# Shared form fields for private server dialogs.
    Locals:
      name_value - pre-filled server name (String, default "")
  version_value - pre-filled version value (String, default "")
      name_id - HTML id for name field (String, optional)
  version_id - HTML id for version field (String, optional)
  name_test_selector - test selector for name (String, default "private-server-name-input")
  version_test_selector - test selector for version (String, default "private-server-version-input") %>
<% name_value = local_assigns.fetch(:name_value, "") %>
<% version_value = local_assigns.fetch(:version_value, "") %>
<% name_test_selector = local_assigns.fetch(:name_test_selector, "private-server-name-input") %>
<% version_test_selector = local_assigns.fetch(:version_test_selector, "private-server-version-input") %>
<% toggle_id_prefix = local_assigns.fetch(:toggle_id_prefix, "private-server-input-mode") %>
<% input_mode_field_name = local_assigns.fetch(:input_mode_field_name, "private_server[input_mode]") %>
<% raw_json_field_name = local_assigns.fetch(:raw_json_field_name, "private_server[raw_json]") %>
<% raw_json_value = local_assigns.fetch(:raw_json_value, "") %>
<% initial_mode = local_assigns.fetch(:initial_mode, "form") %>
<% form_panel_id = "#{toggle_id_prefix}-panel-form" %>
<% json_panel_id = "#{toggle_id_prefix}-panel-json" %>

<input
  type="hidden"
  id="<%= "#{toggle_id_prefix}-input-mode-hidden" %>"
  class="js-private-server-input-mode"
  name="<%= input_mode_field_name %>"
  value="<%= initial_mode %>"
>

<div id="<%= form_panel_id %>" class="tmp-mt-3 d-flex flex-column gap-3" data-private-server-panel="form" <%= "hidden" unless initial_mode == "form" %>>
  <%= render(Primer::Alpha::TextField.new(
    id: local_assigns[:name_id],
    name: "private_server[name]",
    label: "Name",
    value: name_value,
    placeholder: "acme-corp/internal-search",
    caption: "Must be in namespace/server-name format (e.g. org-name/server-name)",
    required: true,
    full_width: true,
    test_selector: name_test_selector,
    data: {
      private_server_form_field: "name",
      private_server_root_field: "name",
    },
  )) %>

  <%= render(Primer::Alpha::TextField.new(
    id: "#{toggle_id_prefix}-title",
    name: "private_server[title]",
    label: "Title",
    value: local_assigns.fetch(:title_value, ""),
    placeholder: "My Server (optional display name)",
    caption: "Optional human-readable display name (max 100 chars)",
    full_width: true,
    test_selector: "private-server-title-input",
    data: {
      private_server_form_field: "title",
      private_server_root_field: "title",
    },
  )) %>

  <%= render(Primer::Alpha::TextField.new(
    id: "#{toggle_id_prefix}-description",
    name: "private_server[description]",
    label: "Description",
    value: local_assigns.fetch(:description_value, ""),
    placeholder: "Brief description of server capabilities",
    required: true,
    full_width: true,
    test_selector: "private-server-description-input",
    data: {
      private_server_form_field: "description",
      private_server_root_field: "description",
    },
  )) %>

  <%= render(Primer::Alpha::TextField.new(
    id: local_assigns[:version_id],
    name: "private_server[version]",
    label: "Version",
    value: version_value,
    placeholder: "1.0.0",
    full_width: true,
    test_selector: version_test_selector,
    data: {
      private_server_form_field: "version",
      private_server_root_field: "version",
    },
  )) %>

  <%= render(Primer::Alpha::TextField.new(
    id: "#{toggle_id_prefix}-website-url",
    name: "private_server[website_url]",
    label: "Website URL",
    value: local_assigns.fetch(:website_url_value, ""),
    placeholder: "https://example.com/docs",
    caption: "Optional link to server homepage or documentation",
    full_width: true,
    test_selector: "private-server-website-url-input",
    data: {
      private_server_form_field: "websiteUrl",
      private_server_root_field: "websiteUrl",
    },
  )) %>

  <%# Packages section — table + dialog %>
  <div class="tmp-mt-3" data-private-server-section="packages">
    <div class="d-flex flex-items-center flex-justify-between tmp-mb-2">
      <div>
        <%= render(Primer::Beta::Text.new(font_weight: :semibold)) do %><span data-private-server-packages-count>0</span> Packages<% end %>
        <p class="color-fg-muted text-small tmp-mb-0">Define how clients can install and run this server. At least one package or remote is required.</p>
      </div>
      <%= render(Primer::Beta::Button.new(size: :small, data: { show_dialog_id: "package-form-dialog", private_server_add_package: "" })) do |c| %>
        <% c.with_leading_visual_icon(icon: :plus) %>
        Add package
      <% end %>
    </div>
    <div class="Box" data-private-server-packages-container>
      <div class="Box-header tmp-py-2 tmp-px-3">
        <div class="d-flex flex-row width-full">
          <div class="col-2">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Registry" } %>
          </div>
          <div class="col-3">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Identifier" } %>
          </div>
          <div class="col-2">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Version" } %>
          </div>
          <div class="col-2">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Transport" } %>
          </div>
          <div class="col-2">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Runtime" } %>
          </div>
          <div class="col-1">
            <span class="sr-only">Actions</span>
          </div>
        </div>
      </div>
      <div data-private-server-packages-list></div>
      <div class="Box-row tmp-py-3 tmp-px-3 color-fg-muted text-small text-center" data-private-server-packages-empty>No packages added</div>
    </div>
  </div>

  <%# Package dialog %>
  <%= render(Primer::Alpha::Dialog.new(title: "Add package", id: "package-form-dialog", position: :center, size: :medium)) do |dialog| %>
    <% dialog.with_header(show_divider: true) do %>
      <span data-private-server-package-dialog-title>Add package</span>
    <% end %>
    <% dialog.with_body do %>
      <div data-private-server-package-dialog>
        <div class="tmp-mb-3">
          <label class="text-bold d-block mb-1" for="pkg-dialog-registryType">Registry type</label>
          <select id="pkg-dialog-registryType" class="form-select width-full" data-private-server-package-dialog-field="registryType">
            <option value="npm">npm</option>
            <option value="pypi">PyPI</option>
            <option value="oci">OCI (Docker)</option>
            <option value="nuget">NuGet</option>
            <option value="mcpb">MCPB</option>
          </select>
        </div>
        <div class="tmp-mb-3">
          <label class="text-bold d-block mb-1" for="pkg-dialog-identifier">Identifier</label>
          <input id="pkg-dialog-identifier" type="text" class="form-control width-full" data-private-server-package-dialog-field="identifier" placeholder="@org/package-name">
        </div>
        <div class="tmp-mb-3">
          <label class="text-bold d-block mb-1" for="pkg-dialog-version">Version</label>
          <input id="pkg-dialog-version" type="text" class="form-control width-full" data-private-server-package-dialog-field="version" placeholder="1.0.0">
        </div>
        <div class="tmp-mb-3">
          <label class="text-bold d-block mb-1" for="pkg-dialog-transport-type">Transport type</label>
          <select id="pkg-dialog-transport-type" class="form-select width-full" data-private-server-package-dialog-field="transport.type">
            <option value="stdio">stdio</option>
            <option value="streamable-http">Streamable HTTP</option>
            <option value="sse">SSE</option>
          </select>
        </div>
        <div class="tmp-mb-3" data-private-server-package-dialog-transport-url hidden>
          <label class="text-bold d-block mb-1" for="pkg-dialog-transport-url">Transport URL</label>
          <input id="pkg-dialog-transport-url" type="text" class="form-control width-full" data-private-server-package-dialog-field="transport.url" placeholder="https://api.example.com/mcp">
        </div>
        <div class="tmp-mb-3">
          <label class="text-bold d-block mb-1" for="pkg-dialog-runtimeHint">Runtime hint (optional)</label>
          <select id="pkg-dialog-runtimeHint" class="form-select width-full" data-private-server-package-dialog-field="runtimeHint">
            <option value="">None</option>
            <option value="npx">npx</option>
            <option value="uvx">uvx</option>
            <option value="docker">docker</option>
            <option value="dnx">dnx</option>
          </select>
        </div>
      </div>
    <% end %>
    <% dialog.with_footer(show_divider: true) do %>
      <div class="d-flex flex-justify-end gap-2">
        <%= render(Primer::Beta::Button.new(scheme: :default, data: { "close-dialog-id": "package-form-dialog" })) { "Cancel" } %>
        <%= render(Primer::Beta::Button.new(scheme: :primary, data: { private_server_package_dialog_save: "" })) { "Save" } %>
      </div>
    <% end %>
  <% end %>

  <%# Remotes section — table + dialog %>
  <div class="tmp-mt-3" data-private-server-section="remotes">
    <div class="d-flex flex-items-center flex-justify-between tmp-mb-2">
      <div>
        <%= render(Primer::Beta::Text.new(font_weight: :semibold)) do %><span data-private-server-remotes-count>0</span> Remotes<% end %>
        <p class="color-fg-muted text-small tmp-mb-0">Remote transport endpoints for this server.</p>
      </div>
      <%= render(Primer::Beta::Button.new(size: :small, data: { show_dialog_id: "remote-form-dialog", private_server_add_remote: "" })) do |c| %>
        <% c.with_leading_visual_icon(icon: :plus) %>
        Add remote
      <% end %>
    </div>
    <div class="Box" data-private-server-remotes-container>
      <div class="Box-header tmp-py-2 tmp-px-3">
        <div class="d-flex flex-row width-full">
          <div class="col-3">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Type" } %>
          </div>
          <div class="col-8">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "URL" } %>
          </div>
          <div class="col-1">
            <span class="sr-only">Actions</span>
          </div>
        </div>
      </div>
      <div data-private-server-remotes-list></div>
      <div class="Box-row tmp-py-3 tmp-px-3 color-fg-muted text-small text-center" data-private-server-remotes-empty>No remotes added</div>
    </div>
  </div>

  <%# Remote dialog %>
  <%= render(Primer::Alpha::Dialog.new(title: "Add remote", id: "remote-form-dialog", position: :center, size: :medium)) do |dialog| %>
    <% dialog.with_header(show_divider: true) do %>
      <span data-private-server-remote-dialog-title>Add remote</span>
    <% end %>
    <% dialog.with_body do %>
      <div data-private-server-remote-dialog>
        <div class="tmp-mb-3">
          <label class="text-bold d-block mb-1" for="remote-dialog-type">Transport type</label>
          <select id="remote-dialog-type" class="form-select width-full" data-private-server-remote-dialog-field="type">
            <option value="streamable-http">Streamable HTTP</option>
            <option value="sse">SSE</option>
          </select>
        </div>
        <div class="tmp-mb-3">
          <label class="text-bold d-block mb-1" for="remote-dialog-url">URL</label>
          <input id="remote-dialog-url" type="text" class="form-control width-full" data-private-server-remote-dialog-field="url" placeholder="https://api.example.com/mcp">
        </div>
      </div>
    <% end %>
    <% dialog.with_footer(show_divider: true) do %>
      <div class="d-flex flex-justify-end gap-2">
        <%= render(Primer::Beta::Button.new(scheme: :default, data: { "close-dialog-id": "remote-form-dialog" })) { "Cancel" } %>
        <%= render(Primer::Beta::Button.new(scheme: :primary, data: { private_server_remote_dialog_save: "" })) { "Save" } %>
      </div>
    <% end %>
  <% end %>

  <%# Repository section (collapsible) %>
  <details class="tmp-mt-3" data-private-server-section="repository">
    <summary class="Link--primary text-bold">Repository (optional)</summary>
    <div class="Box tmp-p-3 tmp-mt-2">
      <%= render(Primer::Alpha::TextField.new(
        id: "#{toggle_id_prefix}-repository-url",
        name: "private_server[repository_url]",
        label: "Repository URL",
        placeholder: "https://github.com/org/repo",
        full_width: true,
        test_selector: "private-server-repository-url-input",
        data: { private_server_nested_field: "repository.url" },
      )) %>
      <div class="tmp-mt-2">
        <label class="text-bold d-block mb-1" for="<%= "#{toggle_id_prefix}-repo-source" %>">Source</label>
        <select
          id="<%= "#{toggle_id_prefix}-repo-source" %>"
          class="form-select width-full"
          name="private_server[repository_source]"
          data-private-server-nested-field="repository.source"
          <%= test_selector("private-server-repository-source-input") %>
        >
          <option value="">Select source...</option>
          <option value="github">GitHub</option>
          <option value="gitlab">GitLab</option>
          <option value="other">Other</option>
        </select>
      </div>
      <%= render(Primer::Alpha::TextField.new(
        id: "#{toggle_id_prefix}-repository-id",
        name: "private_server[repository_id]",
        label: "Repository ID",
        placeholder: "Repository identifier (optional)",
        caption: "Stable ID from the hosting service, used to detect renames",
        full_width: true,
        test_selector: "private-server-repository-id-input",
        data: { private_server_nested_field: "repository.id" },
      )) %>
      <%= render(Primer::Alpha::TextField.new(
        id: "#{toggle_id_prefix}-repository-subfolder",
        name: "private_server[repository_subfolder]",
        label: "Subfolder",
        placeholder: "src/server (optional)",
        caption: "Relative path to server within a monorepo",
        full_width: true,
        test_selector: "private-server-repository-subfolder-input",
        data: { private_server_nested_field: "repository.subfolder" },
      )) %>
    </div>
  </details>

  <%# Advanced JSON section for complex fields %>
  <details class="tmp-mt-3" data-private-server-section="advanced">
    <summary class="Link--primary text-bold">Advanced configuration (JSON)</summary>
    <div class="Box tmp-p-3 tmp-mt-2">
      <p class="color-fg-muted text-small mb-2">Additional properties like <code>_meta</code>, <code>environmentVariables</code>, <code>runtimeArguments</code>, and <code>packageArguments</code> can be specified here as JSON. These will be merged with the fields above.</p>
      <label class="text-bold d-block mb-1" for="<%= "#{toggle_id_prefix}-advanced-json" %>">Advanced JSON</label>
      <textarea
        id="<%= "#{toggle_id_prefix}-advanced-json" %>"
        class="form-control width-full"
        data-private-server-advanced-json="true"
        rows="6"
        placeholder='{"_meta": {}}'
        <%= test_selector("private-server-advanced-json-input") %>
      ></textarea>
      <p class="color-fg-danger text-small mt-2" hidden data-private-server-advanced-json-error></p>
    </div>
  </details>

</div>

<div id="<%= json_panel_id %>" class="tmp-mt-3" data-private-server-panel="json" <%= "hidden" unless initial_mode == "json" %>>
  <label class="text-bold" for="<%= "#{toggle_id_prefix}-raw-json" %>">Raw JSON</label>
  <textarea
    id="<%= "#{toggle_id_prefix}-raw-json" %>"
    class="form-control width-full"
    name="<%= raw_json_field_name %>"
    data-private-server-json-field="true"
    rows="14"
    <%= test_selector("private-server-raw-json-input") %>
    placeholder='{"name":"acme-corp/internal-search","description":"MCP server for internal search","version":"1.0.0"}'
  ><%= raw_json_value %></textarea>
  <p class="color-fg-danger text-small mt-2" hidden data-private-server-json-error></p>
</div>
