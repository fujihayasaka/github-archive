<% page_info(title: title, selected_link: :businesses_ai_controls_mcp, sidebar: :ai_controls) %>

<% toggle_id_prefix = "private-server" %>
<% form_panel_id = "#{toggle_id_prefix}-panel-form" %>
<% json_panel_id = "#{toggle_id_prefix}-panel-json" %>
<% initial_mode = "form" %>

<%= render(Primer::Box.new(mt: 2)) do %>
  <%= render(Primer::Beta::Link.new(href: mcp_private_servers_enterprise_ai_controls_enterprise_path(business), test_selector: "private-server-form-back-link")) do |component| %>
    <% component.with_leading_visual_icon(icon: :"arrow-left") %>
    Private MCP servers
  <% end %>

  <header class="tmp-mb-3">
    <div class="d-flex gap-2 flex-items-center flex-justify-between border-bottom pb-2 tmp-mt-3">
      <%= render(Primer::Beta::Heading.new(tag: :h1)) { title } %>
      <div data-private-server-toggle="true" class="js-mcp-toggle-test">
        <%= render(Primer::Alpha::SegmentedControl.new(
          aria: { label: "Private server input format" },
        )) do |component| %>
          <% component.with_item(
            tag: :a,
            href: "##{form_panel_id}",
            label: "Form",
            selected: initial_mode == "form",
          ) %>
          <% component.with_item(
            tag: :a,
            href: "##{json_panel_id}",
            label: "Raw JSON",
            selected: initial_mode == "json",
          ) %>
        <% end %>
      </div>
    </div>
    <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, pt: 2, color: :muted)) do %>
      <%= server.nil? ? "Publish a new private MCP server for your enterprise." : "Edit the configuration of this private server." %>
    <% end %>
  </header>

  <%= form_with url: mcp_private_servers_enterprise_ai_controls_enterprise_path(business), method: :get, local: true, id: "private-server-form", data: { private_server_form: true, fetch_server_json_path: mcp_private_servers_fetch_server_json_enterprise_ai_controls_enterprise_path(business) } do %>
    <%= render partial: "businesses/ai_controls/mcp/server_form_fields", locals: {
      name_value: server&.dig(:name) || "",
      version_value: server&.dig(:version) || "",
      name_id: "private-server-name",
      version_id: "private-server-version",
      toggle_id_prefix: "private-server",
      input_mode_field_name: "private_server[input_mode]",
      raw_json_field_name: "private_server[raw_json]",
      raw_json_value: local_assigns.fetch(:raw_json_value, ""),
      initial_mode: "form",
    } %>
  <% end %>

  <div class="d-flex flex-justify-between flex-items-center gap-2 width-full tmp-mt-4 border-top tmp-pt-3">
    <div
      class="d-flex flex-items-center text-small"
      hidden
      data-private-server-validation-status
      data-private-server-form-id="private-server-form"
      aria-live="polite"
    >
      <span hidden data-private-server-validation-icon-success>
        <%= render(Primer::Beta::Octicon.new(icon: :check, color: :success, mr: 1)) %>
      </span>
      <span hidden data-private-server-validation-icon-warning>
        <%= render(Primer::Beta::Octicon.new(icon: :alert, color: :attention, mr: 1)) %>
      </span>
      <span data-private-server-validation-text></span>
    </div>

    <div class="d-flex flex-justify-end gap-2">
      <%= render(Primer::Beta::Button.new(
        tag: :a,
        href: mcp_private_servers_enterprise_ai_controls_enterprise_path(business),
        scheme: :default,
      )) { "Cancel" } %>
      <%= render(Primer::Beta::Button.new(
        scheme: :primary,
        type: :button,
        data: {
          private_server_save_button: true,
          private_server_form_id: "private-server-form",
        },
        test_selector: "private-server-save-button",
      )) { save_label } %>
    </div>
  </div>
<% end %>

