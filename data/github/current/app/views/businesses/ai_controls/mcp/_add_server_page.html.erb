<%# Shared add-server sub-page used by both create and edit allowlist dialogs.
    Expects locals: business, panel_id (unique ID for the SelectPanel) %>
<div data-allowlist-dialog-target="addServerPage" hidden style="max-height: 60vh; display: flex; flex-direction: column;">
  <div class="d-flex flex-column gap-3" style="flex: 1; min-height: 0;"
       data-servers-url="<%= mcp_allowlist_servers_enterprise_ai_controls_enterprise_path(business) %>"
       data-connection-methods-url="<%= mcp_allowlist_connection_methods_enterprise_ai_controls_enterprise_path(business) %>"
       data-allowlist-dialog-target="addServerContainer">

    <%# Server selection via SelectPanel %>
    <div>
      <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :semibold, display: :block, mb: 2, id: "#{panel_id}-label")) do %>
        Select server <span class="color-fg-danger">*</span>
      <% end %>
      <%= render(Primer::Alpha::SelectPanel.new(
        title: "Select server",
        dynamic_label: true,
        src: mcp_allowlist_servers_enterprise_ai_controls_enterprise_path(business),
        no_results_label: "No servers found.",
        id: panel_id,
        data: {
          allowlist_dialog_target: "serverSelectPanel",
          test_selector: "server-select-panel"
        }
      )) do |panel| %>
        <% panel.with_show_button(aria: { labelledby: "#{panel_id}-label" }) do |button| %>
          <% button.with_trailing_action_icon(icon: :"triangle-down") %>
          Select server name
        <% end %>
      <% end %>
      <input type="hidden" data-allowlist-dialog-target="selectedServerId" name="new_server[id]" value="">
      <input type="hidden" data-allowlist-dialog-target="selectedServerName" name="new_server[name]" value="">
      <input type="hidden" data-allowlist-dialog-target="selectedServerUrl" name="new_server[url]" value="">
    </div>

    <%# Connection methods (server-rendered CheckBoxGroup, loaded via fetch after server selection) %>
    <%= render(Primer::Box.new(classes: "tmp-mt-3", data: { allowlist_dialog_target: "connectionMethods" }, hidden: true)) do %>
      <div data-allowlist-dialog-target="connectionMethodsList" aria-busy="true">
        <%# Default loading spinner, replaced by HTML fragment fetch after server selection %>
        <div class="d-flex flex-justify-center tmp-py-4" data-allowlist-dialog-target="connectionMethodsLoading" role="status" aria-live="polite">
          <%= render(Primer::Beta::Spinner.new(size: :medium, "aria-label": "Loading connection methods")) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
