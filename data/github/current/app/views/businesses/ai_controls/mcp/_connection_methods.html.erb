<%# Server-rendered connection methods checkboxes for the Add Server page.
    Shared by both create and edit allowlist dialogs.
    Locals:
      entries - Array of hashes: [{ "id" => 101, "type" => "remote", "display_name" => "sse: ...", "selected" => true }, ...]
%>
<% entries = local_assigns.fetch(:entries, []) %>
<% remotes = entries.select { |e| e["type"] == "remote" } %>
<% packages = entries.select { |e| e["type"] == "package" } %>

<%= render(Primer::Box.new(style: "max-height: 200px; overflow-y: auto;")) do %>
  <%= render(Primer::Alpha::CheckBoxGroup.new(
    name: "server_entries",
    label: "Remote endpoints",
    caption: remotes.any? ? nil : "No remote endpoints available for this server",
  )) do |group| %>
    <% remotes.each do |entry| %>
      <% checkbox_value = { type: entry["type"], display_name: entry["display_name"] }
         if entry["remote_url"].present?
           checkbox_value[:remote_url] = entry["remote_url"]
           checkbox_value[:remote_transport_type] = entry["remote_transport_type"] if entry["remote_transport_type"].present?
         elsif entry["id"].to_i > 0
           checkbox_value[:transport_id] = entry["id"]
         end %>
      <% group.check_box(
        label: entry["display_name"],
        value: checkbox_value.to_json,
        checked: entry["selected"] == true,
      ) %>
    <% end %>
  <% end %>

  <%= render(Primer::Alpha::CheckBoxGroup.new(
    name: "server_entries",
    label: "Packages",
    caption: packages.any? ? nil : "No packages available for this server",
  )) do |group| %>
    <% packages.each do |entry| %>
      <% group.check_box(
        label: entry["display_name"],
        value: { type: entry["type"], package_id: entry["id"], display_name: entry["display_name"] }.to_json,
        checked: entry["selected"] == true,
      ) %>
    <% end %>
  <% end %>
<% end %>
