<%# Shared header for allowlist dialogs.
    Locals: back_label (String), title (String) %>
<div class="d-flex flex-items-center gap-2 width-full" data-allowlist-dialog-target="dialogHeader">
  <%= render(Primer::Beta::IconButton.new(
    icon: :"arrow-left",
    "aria-label": back_label,
    scheme: :invisible,
    size: :medium,
    data: { allowlist_action: "showMainPage", allowlist_dialog_target: "backButton" },
    hidden: true,
  )) %>
  <span data-allowlist-dialog-target="dialogTitle" class="Overlay-title"><%= title %></span>
</div>
