<%# Renders assigned organization avatars with names inline, comma-separated.
    Locals:
      assigned_orgs - Array of Organization objects assigned to this allowlist
      max_visible   - Maximum orgs to show before collapsing (Integer, default 2)
%>
<% max_visible = local_assigns.fetch(:max_visible, 2) %>

<% if assigned_orgs.any? %>
  <div class="d-flex flex-items-center flex-wrap" style="gap: 4px;" <%= test_selector("assigned-orgs") %>>
    <% visible = assigned_orgs.first(max_visible) %>
    <% visible.each_with_index do |org, i| %>
      <div class="d-flex flex-items-center" style="gap: 4px;">
        <%= render(Primer::Beta::Avatar.new(
          src: org.primary_avatar_url(16),
          alt: org.display_login,
          size: 16,
          shape: :square,
        )) %>
        <%= render(Primer::Beta::Text.new(font_size: :small)) { org.display_login } %><% if i < visible.length - 1 %><%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { "," } %><% end %>
      </div>
    <% end %>
    <% overflow = assigned_orgs.length - max_visible %>
    <% if overflow > 0 %>
      <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { "+ #{overflow} more" } %>
    <% end %>
  </div>
<% else %>
  <%= render(Primer::Beta::Text.new(color: :muted)) { "Unassigned" } %>
<% end %>
