<% page_info(title: title, selected_link: :businesses_ai_controls_mcp, sidebar: :ai_controls) %>

<%# Build assignment lookup: allowlist_id => array of namespace IDs %>
<%# Build org lookup: org database ID => Organization object %>
<% org_by_id = {}
   organizations.each do |org|
     org_by_id[org.id] = org
     org_by_id[org.id.to_s] = org
   end
   assignment_lookup = {}
   assignments.each do |a|
     aid = a.dig("allowlist", "public_id") || a["allowlist_id"] || a["allowlist_public_id"]
     next unless aid
     ns_id = a["namespace_id"]
     assignment_lookup[aid] ||= []
     assignment_lookup[aid] << ns_id
   end
%>

<%= render(Businesses::AiControls::ReadOnlyBannerComponent.new(is_admin: is_admin)) %>

<%= render(Primer::Box.new(mt: 2)) do %>
  <% flash_rendered! %>
  <%# Success banner - shown via flash %>
  <% if flash[:success] %>
    <%= render(Primer::Alpha::Banner.new(
      scheme: :success,
      icon: :"check-circle",
      dismiss_scheme: :remove,
      data: { test_selector: "allowlist-success-banner" },
      id: "allowlist-success-banner",
      classes: "tmp-mb-3",
    )) do %>
      <%= flash[:success] %>
    <% end %>
  <% end %>

  <%# Error banner - shown via flash %>
  <% if flash[:error] %>
    <%= render(Primer::Alpha::Banner.new(
      scheme: :danger,
      icon: :"alert",
      dismiss_scheme: :remove,
      data: { test_selector: "allowlist-error-banner" },
      id: "allowlist-error-banner",
      classes: "tmp-mb-3",
    )) do %>
      <%= flash[:error] %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::Link.new(href: mcp_enterprise_ai_controls_enterprise_path(business), test_selector: "mcp-settings-back-link")) do |component| %>
    <% component.with_leading_visual_icon(icon: :"arrow-left") %>
    MCP
  <% end %>

  <header class="tmp-mb-6">
    <div class="d-flex gap-2 flex-items-center flex-justify-between border-bottom pb-2 tmp-mt-3">
      <%= render(Primer::Beta::Heading.new(tag: :h1)) { title } %>
      <% if can_write %>
        <%= render(Primer::Box.new(ml: :auto)) do %>
          <%# Create Allowlist Dialog %>
          <% content_for :head do %>
            <style data-turbo-track="reload">
              .allowlist-dialog-overflow,
              .allowlist-dialog-overflow * {
                overflow: visible !important;
                max-height: none !important;
              }
              .allowlist-dialog-overflow .Overlay-footer,
              .allowlist-dialog-overflow .Overlay-header {
                overflow: hidden !important;
              }
              /* Restore scroll on the SelectPanel list container so long server lists are scrollable */
              .allowlist-dialog-overflow select-panel .Overlay-body {
                overflow: auto !important;
                max-height: 50vh !important;
              }
              /* Wrap long package identifiers and remote URLs within the dialog */
              .allowlist-dialog-overflow .FormControl-label {
                overflow-wrap: anywhere;
              }
            </style>
          <% end %>
          <%= render(Primer::Alpha::Dialog.new(
            title: "Create allowlist",
            id: "create-allowlist-dialog",
            position: :center,
            size: :medium_portrait,
            classes: "allowlist-dialog-overflow",
          )) do |dialog| %>
            <% dialog.with_show_button(
              scheme: :primary,
              test_selector: "create-allowlist-button",
            ) { "Create allowlist" } %>
            <% dialog.with_header(show_divider: true) do %>
              <%= render partial: "businesses/ai_controls/mcp/dialog_header", locals: { back_label: "Back to create allowlist", title: "Create allowlist" } %>
            <% end %>
            <% dialog.with_body do %>
              <%= form_with url: create_mcp_allowlist_enterprise_ai_controls_enterprise_path(business), method: :post, local: true, id: "create-allowlist-form" do %>
              <div data-controller="allowlist-dialog"<% if require_name_validation %> data-require-name-validation="true"<% end %>>
                <%# Main page - Create allowlist form %>
                <div data-allowlist-dialog-target="mainPage" class="d-flex flex-column gap-3">
                <%= render partial: "businesses/ai_controls/mcp/form_fields", locals: {
                  organizations: organizations,
                } %>

                <%# Servers section %>
                <%= render partial: "businesses/ai_controls/mcp/servers_section" %>
              </div>
              <%# End of main page %>

              <%# Add server sub-page %>
              <%= render partial: "businesses/ai_controls/mcp/add_server_page", locals: { business: business, panel_id: "server-select-panel-create" } %>
              <%# End of add server sub-page %>
              </div>
              <% end %><%# end form_with %>
            <% end %>
            <% dialog.with_footer(show_divider: true) do %>
              <%= render partial: "businesses/ai_controls/mcp/dialog_footer", locals: { dialog_id: "create-allowlist-dialog", form_id: "create-allowlist-form", save_label: "Save", save_disabled: require_name_validation } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, pt: 2, color: :muted)) do %>
      Create and manage allowlists to control which MCP servers can be used by Copilot in your enterprise.
    <% end %>
  </header>

  <% if allowlists.any? %>
    <%# Search input %>
    <%= render(Primer::Box.new(classes: "tmp-mb-3")) do %>
      <%= render(Primer::Alpha::TextField.new(
        name: "mcp_allowlist_search",
        label: "Search allowlists",
        visually_hide_label: true,
        placeholder: "Search allowlists",
        leading_visual: { icon: :search },
        full_width: true,
        test_selector: "mcp-allowlist-search",
      )) %>
    <% end %>

    <%# Allowlists table %>
    <div aria-live="polite">
    <%= render(Primer::Beta::BorderBox.new(test_selector: "mcp-allowlists-table", data: { "mcp-target": "allowlists-table" })) do |component| %>
      <%# Table header %>
      <% component.with_header(py: 2, px: 3) do %>
        <div class="d-flex flex-row width-full">
          <div class="col-3">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Name" } %>
          </div>
          <div class="col-3">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Assigned to" } %>
          </div>
          <div class="col-2">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Last updated" } %>
          </div>
          <div class="col-3">
            <%= render(Primer::Beta::Text.new(font_weight: :semibold, font_size: :small)) { "Updated by" } %>
          </div>
          <div class="col-1"></div>
        </div>
      <% end %>

      <%# Allowlist rows %>
      <% allowlists.each do |allowlist| %>
        <% allowlist_id = allowlist["public_id"] || allowlist["id"] %>
        <% allowlist_name = allowlist["name"] %>
        <% allowlist_description = allowlist["description"] %>
        <% allowlist_servers = allowlist["servers"] || [] %>
        <% allowlist_updated_at = allowlist["updated_at"] %>
        <% allowlist_updated_by = allowlist["updated_by"] || {} %>
        <% assigned_ns_ids = assignment_lookup[allowlist_id] || [] %>
        <% assigned_orgs = assigned_ns_ids.filter_map { |ns_id| org_by_id[ns_id] } %>
        <% component.with_row(py: 3, px: 3, test_selector: "mcp-allowlist-row", data: { allowlist_id: allowlist_id }) do %>
          <div class="d-flex flex-row width-full flex-items-center">
            <div class="col-3">
              <%= render(Primer::Beta::Text.new(font_weight: :semibold)) { allowlist_name } %>
              <%= render(Primer::Beta::Text.new(tag: :div, color: :muted, font_size: :small)) { allowlist_description } %>
              <% if allowlist_servers.any? %>
                <%= render(Primer::Beta::Text.new(tag: :div, color: :muted, font_size: :small, mt: 1)) do %>
                  <%= render(Primer::Beta::Octicon.new(icon: :server, mr: 1)) %>
                  <%= pluralize(allowlist_servers.length, "server") %>
                <% end %>
              <% end %>
            </div>
            <div class="col-3">
              <%= render partial: "businesses/ai_controls/mcp/assigned_orgs", locals: { assigned_orgs: assigned_orgs, max_visible: 2 } %>
            </div>
            <div class="col-2">
              <% if allowlist_updated_at.present? %>
                <%= render(Primer::Beta::RelativeTime.new(datetime: allowlist_updated_at, tense: :past)) %>
              <% end %>
            </div>
            <div class="col-3">
              <% if allowlist_updated_by.present? && allowlist_updated_by["login"].present? %>
                <div class="d-flex flex-items-center">
                  <% if allowlist_updated_by["avatar_url"].present? %>
                    <%= render(Primer::Beta::Avatar.new(
                      src: allowlist_updated_by["avatar_url"],
                      alt: allowlist_updated_by["login"],
                      size: 20
                    )) %>
                  <% end %>
                  <%= render(Primer::Beta::Text.new(ml: 2)) { allowlist_updated_by["login"] } %>
                </div>
              <% end %>
            </div>
            <div class="col-1 d-flex flex-justify-end">
              <% if can_write %>
                <%= render(Primer::Alpha::ActionMenu.new(test_selector: "allowlist-actions-menu")) do |menu| %>
                  <% menu.with_show_button(
                    icon: :"kebab-horizontal",
                    scheme: :invisible,
                    size: :small,
                    "aria-label": "More options for #{allowlist_name}"
                  ) %>
                  <%# Edit action - triggers edit dialog %>
                  <% menu.with_item(
                    label: "Edit",
                    content_arguments: {
                      data: {
                        show_dialog_id: "edit-allowlist-dialog-#{allowlist_id}"
                      }
                    }
                  ) do |item| %>
                    <% item.with_leading_visual_icon(icon: :pencil) %>
                  <% end %>
                  <%# Delete action - triggers delete confirmation %>
                  <% menu.with_item(
                    label: "Delete",
                    scheme: :danger,
                    content_arguments: {
                      data: {
                        show_dialog_id: "delete-allowlist-dialog-#{allowlist_id}"
                      }
                    }
                  ) do |item| %>
                    <% item.with_leading_visual_icon(icon: :trash) %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%# Search empty state - shown via JS when search filters all rows %>
    <div <%= test_selector("mcp-allowlist-search-empty") %> hidden>
      <%= render(Primer::Beta::Blankslate.new) do |component| %>
        <% component.with_visual_icon(icon: :search) %>
        <% component.with_heading(tag: :h3) { "No allowlists found" } %>
        <% component.with_description { "No allowlists match your search. Try a different search term." } %>
      <% end %>
    </div>
    </div>

    <% if can_write %>
      <%# Edit Dialogs - One per allowlist, reusing same components as create %>
      <% allowlists.each do |allowlist| %>
        <% allowlist_id = allowlist["public_id"] || allowlist["id"] %>
        <% allowlist_name = allowlist["name"] %>
        <% allowlist_description = allowlist["description"] %>
        <% allowlist_servers = allowlist["servers"] || [] %>
        <% edit_dialog_id = "edit-allowlist-dialog-#{allowlist_id}" %>
        <% edit_form_id = "edit-allowlist-form-#{allowlist_id}" %>
        <%= render(Primer::Alpha::Dialog.new(
          title: "Edit allowlist",
          id: edit_dialog_id,
          position: :center,
          size: :medium_portrait,
          classes: "allowlist-dialog-overflow",
          data: { allowlist_id: allowlist_id },
        )) do |dialog| %>
          <% dialog.with_header(show_divider: true) do %>
            <%= render partial: "businesses/ai_controls/mcp/dialog_header", locals: { back_label: "Back to edit allowlist", title: "Edit allowlist" } %>
          <% end %>
          <% dialog.with_body do %>
            <%= form_with url: update_mcp_allowlist_enterprise_ai_controls_enterprise_path(business, allowlist_id), method: :patch, local: true, id: edit_form_id do %>
            <% edit_assigned_ns_ids = assignment_lookup[allowlist_id] || [] %>
            <% edit_assigned_orgs = edit_assigned_ns_ids.filter_map { |ns_id| org_by_id[ns_id] } %>
            <% edit_assigned_names = edit_assigned_orgs.map(&:display_login) %>
            <div data-controller="allowlist-dialog" data-allowlist-dialog-current-page-value="main" data-servers="<%= allowlist_servers.to_json %>" data-assigned-org-ids="<%= edit_assigned_orgs.map(&:id).to_json %>"<% if require_name_validation %> data-require-name-validation="true"<% end %>>
              <%# Main page - Edit allowlist form %>
              <div data-allowlist-dialog-target="mainPage" class="d-flex flex-column gap-3">
                <%= render partial: "businesses/ai_controls/mcp/form_fields", locals: {
                  name_value: allowlist_name,
                  description_value: allowlist_description,
                  name_id: "edit-allowlist-name-#{allowlist_id}",
                  description_id: "edit-allowlist-description-#{allowlist_id}",
                  name_test_selector: "edit-allowlist-name-input",
                  description_test_selector: "edit-allowlist-description-input",
                  assign_label_id: "edit-assign-allowlist-label-#{allowlist_id}",
                  assigned_names: edit_assigned_names,
                  organizations: organizations,
                  select_panel_id: "edit-allowlist-org-select-panel-#{allowlist_id}",
                  org_select_test_selector: "edit-allowlist-org-select",
                } %>

                <%# Servers section %>
                <%= render partial: "businesses/ai_controls/mcp/servers_section", locals: { servers: allowlist_servers, search_field_id: "edit-find-server-#{allowlist_id}" } %>
                </div>
              <%# End of main page %>

              <%# Add server sub-page %>
              <%= render partial: "businesses/ai_controls/mcp/add_server_page", locals: { business: business, panel_id: "server-select-panel-edit-#{allowlist_id}" } %>
              <%# End of add server sub-page %>
            </div>
            <% end %><%# end form_with %>
          <% end %>
          <% dialog.with_footer(show_divider: true) do %>
            <%= render partial: "businesses/ai_controls/mcp/dialog_footer", locals: { dialog_id: edit_dialog_id, form_id: edit_form_id, save_label: "Save changes" } %>
          <% end %>
        <% end %>
      <% end %>

      <%# Delete Confirmation Dialogs - One per allowlist %>
      <% allowlists.each do |allowlist| %>
        <% allowlist_id = allowlist["public_id"] || allowlist["id"] %>
        <% allowlist_name = allowlist["name"] %>
        <% allowlist_servers = allowlist["servers"] || [] %>
        <% del_assigned_ns_ids = assignment_lookup[allowlist_id] || [] %>
        <% del_assigned_orgs = del_assigned_ns_ids.filter_map { |ns_id| org_by_id[ns_id] } %>
        <% del_assigned_names = del_assigned_orgs.map(&:display_login) %>
        <% delete_form_id = "delete-allowlist-form-#{allowlist_id}" %>
        <%= render(Primer::Alpha::Dialog.new(
          title: "Delete allowlist",
          id: "delete-allowlist-dialog-#{allowlist_id}",
          position: :center,
          size: :small,
        )) do |dialog| %>
          <% dialog.with_header(show_divider: true) %>
          <% dialog.with_body do %>
            <div class="d-flex flex-column gap-3">
              <%= render(Primer::Beta::Text.new) do %>
                Are you sure you want to delete <strong><%= allowlist_name %></strong>?
              <% end %>
              <%= render(Primer::Beta::Text.new(color: :muted)) do %>
                This action cannot be undone. <%= allowlist_servers.any? ? "#{pluralize(allowlist_servers.length, 'server')} in this allowlist will no longer be available." : "" %>
              <% end %>
              <% if del_assigned_names.any? %>
                <%= render(Primer::Alpha::Banner.new(scheme: :warning, icon: :"alert")) do %>
                  This allowlist is currently assigned to <strong><%= del_assigned_names.join(", ") %></strong>. Deleting it will remove access to these MCP servers for that organization.
                <% end %>
              <% end %>
            </div>
          <% end %>
          <% dialog.with_footer(show_divider: true) do %>
            <%= form_with url: destroy_mcp_allowlist_enterprise_ai_controls_enterprise_path(business, allowlist_id), method: :delete, local: true, id: delete_form_id do %>
            <% end %>
            <div class="d-flex flex-justify-end gap-2">
              <%= render(Primer::Beta::Button.new(
                scheme: :default,
                data: { "close-dialog-id": "delete-allowlist-dialog-#{allowlist_id}" },
                test_selector: "cancel-delete-button",
              )) { "Cancel" } %>
              <%= render(Primer::Beta::Button.new(
                scheme: :danger,
                type: :submit,
                form: delete_form_id,
                test_selector: "confirm-delete-button",
                "data-disable-with": "Deleting...",
              )) { "Delete allowlist" } %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

  <% else %>
    <%# Empty state — distinguish API error from genuinely empty %>
    <% if allowlists_load_failed %>
      <%= render(Primer::Beta::Blankslate.new(test_selector: "mcp-allowlists-error-state")) do |component| %>
        <% component.with_visual_icon(icon: :alert) %>
        <% component.with_heading(tag: :h2) { "Unable to load allowlists" } %>
        <% component.with_description { "Something went wrong while loading your allowlists. Please try refreshing the page." } %>
      <% end %>
    <% else %>
      <%= render(Primer::Beta::Blankslate.new(test_selector: "mcp-allowlists-empty-state", data: { "mcp-target": "allowlists-empty-state" })) do |component| %>
        <% component.with_visual_icon(icon: :server) %>
        <% component.with_heading(tag: :h2) { "No allowlists yet" } %>
        <% component.with_description { "Create an allowlist to control which MCP servers can be used by Copilot in your enterprise." } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
