<% page_info(title: title, selected_link: :businesses_ai_controls_mcp, sidebar: :ai_controls) %>

<%= render(Businesses::AiControls::ReadOnlyBannerComponent.new(is_admin: is_admin)) %>

<header class="tmp-mb-6">
  <div class="d-flex gap-2 flex-items-center border-bottom pb-2">
    <%= render(Primer::Beta::Heading.new(tag: :h1)) { title } %>
  </div>
  <%= render(Primer::Beta::Text.new(tag: :p, mb: 0, pt: 2, color: :muted)) do %>
      Configure and enable MCP options for your organizations.
  <% end %>
</header>

<%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
  <%= component.with_row(scheme: :default, test_selector: "mcp_policy_form") do %>
    <%= render(Copilot::Policies::BusinessFormComponent.new(
      policy_class: Copilot::Policies::Mcp,
      configurable: business,
      can_write: can_write,
      tab: "mcp",
      )) do |component| %>
        <%= component.with_description do %>
          Users can configure Model Context Protocol (MCP) servers for Copilot in all Copilot editors and Copilot cloud agent. <% unless current_user&.feature_flag_enabled?(:copilot_coding_agent_ga, default: false) %>Note that Copilot cloud agent is in public preview.<% end %>
          See MCP docs for <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/copilot/customizing-copilot/extending-copilot-chat-with-mcp", classes: "Link--inTextBlock")) { "Copilot Chat" } %> and <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/copilot/customizing-copilot/extending-copilot-coding-agent-with-mcp", classes: "Link--inTextBlock")) { "Copilot cloud agent" } %>.
        <% end %>
    <% end %>
  <% end %>
<% end %>

<% if allowlist_ui_enabled %>
<%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
  <%= component.with_row(scheme: :default, test_selector: "mcp_allowlist_section") do %>
    <%= render(Copilot::Policies::McpAllowlistComponent.new(
      display_name: Copilot::COPILOT_MCP_ALLOWLIST,
      configurable: business,
      can_write: can_write,
    )) do |component| %>
      <%= component.with_description do %>
        Manage the list of allowed MCP servers for your enterprise (only works with GitHub MCP Registry).
      <% end %>
    <% end %>
  <% end %>
  <%= component.with_row(scheme: :default, test_selector: "mcp_registry_configuration_collapsed") do %>
    <%= render(Copilot::Policies::McpRegistryConfigurationComponent.new(
      display_name: Copilot::COPILOT_MCP_REGISTRY_CONFIGURATION,
      configurable: business,
      can_write: can_write,
    )) %>
  <% end %>
<% end %>

<% if private_servers_ui_enabled %>
<%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
  <%= component.with_row(scheme: :default, test_selector: "mcp_private_servers_section") do %>
    <%= render(Copilot::Policies::McpPrivateServersComponent.new(
      display_name: Copilot::COPILOT_MCP_PRIVATE_SERVERS,
      configurable: business,
      can_write: can_write,
    )) do |component| %>
      <%= component.with_description do %>
        Publish and manage private MCP servers that appear in the GitHub Registry only for members of your enterprise.
      <% end %>
    <% end %>
  <% end %>
<% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
  <%= component.with_row(scheme: :default, test_selector: "mcp_local_server_block_toggle") do %>
    <%= render(Copilot::Policies::McpLocalServerBlockToggleComponent.new(
      display_name: Copilot::COPILOT_MCP_LOCAL_SERVER_BLOCK,
      configurable: business,
      can_write: can_write,
    )) do |component| %>
      <%= component.with_description do %>
        Recommended for strict security. When enabled, only remote (hosted) MCP servers are allowed.<br>
        Local servers cannot be used even if listed in the registry.
      <% end %>
    <% end %>
  <% end %>
<% end %>
<% else %>
<%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
  <%# MCP Registry URL Section %>
  <%= component.with_row(scheme: :default, test_selector: "mcp_registry_url") do %>
    <%= render partial: "businesses/copilot_settings/mcp_registry_url", locals: {
      business: business,
      copilot_business: copilot_business,
      mcp_registry: Copilot::McpRegistry.for_business(business).first || Copilot::McpRegistry.new(entity: business),
        can_write: can_write,
    } %>
  <% end %>
  <%= component.with_row(scheme: :default, test_selector: "mcp_registry_allowlist_form") do %>
    <%= render(Copilot::Policies::McpRegistryAllowlistFormComponent.new(
      display_name: Copilot::COPILOT_MCP_REGISTRY_ACCESS,
      configurable: business,
        can_write: can_write,
      current_value: copilot_business.mcp_registry_access,
    )) do |component|%>
      <%= component.with_description do %>
      Control which MCP servers are allowed based on your registry configuration. View docs on <%= render(Primer::Beta::Link.new(href: "https://gh.io/mcp-registry-allow-lists", classes: "Link--inTextBlock")) { "MCP registry allow lists" } %>.
      <% end %>
    <% end %>
  <% end %>
<% end %>
<% end %>
