<%# locals: (servers:) %>
<%= render(Primer::Alpha::SelectPanel::ItemList.new(
  aria: { label: "MCP servers" },
  select_variant: :single
)) do |list| %>
  <% servers.each do |server_wrapper| %>
    <% server = server_wrapper["server"] || server_wrapper[:server] || server_wrapper %>
    <% name = server["name"] || server[:name] || "" %>
    <% description = server["description"] || server[:description] || "" %>
    <%# public_id may be on the wrapper or on the server object %>
    <% id = server_wrapper["public_id"] || server_wrapper[:public_id] || server["public_id"] || server[:public_id] || server["id"] || server[:id] || name %>
    <% url = server["url"] || server[:url] || "" %>
    <% remotes = server["remotes"] || server[:remotes] || [] %>
    <% packages = server["packages"] || server[:packages] || [] %>

    <% next if name.blank? %>

    <% list.with_item(
      label: name,
      value: id,
      content_arguments: {
        data: {
          server_name: name,
          server_url: url,
          server_id: id,
          server_remotes: remotes.to_json,
          server_packages: packages.to_json
        }
      }
    ) do |item| %>
      <% if description.present? %>
        <% item.with_description(description) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
