<%# Shared footer for allowlist dialogs.
    Locals:
      dialog_id    - ID of the dialog (for close button)
      form_id      - ID of the form (for submit button)
      save_label   - Text for the save button (e.g. "Save" or "Save changes")
      save_disabled - Whether the save button starts disabled (Boolean, default false) %>
<% save_disabled = local_assigns.fetch(:save_disabled, false) %>
<%# Main page footer %>
<div class="d-flex flex-justify-end gap-2" data-allowlist-dialog-target="mainFooter">
  <%= render(Primer::Beta::Button.new(
    scheme: :default,
    data: { "close-dialog-id": dialog_id },
  )) { "Cancel" } %>
  <% save_button_args = {
    scheme: :primary,
    type: :submit,
    form: form_id,
    "data-disable-with": "Saving...",
    data: { allowlist_dialog_target: "saveButton" },
  } %>
  <% save_button_args[:disabled] = true if save_disabled %>
  <%= render(Primer::Beta::Button.new(**save_button_args)) { save_label } %>
</div>
<%# Add server sub-page footer %>
<div class="d-flex flex-justify-end gap-2" data-allowlist-dialog-target="addServerFooter" hidden>
  <%= render(Primer::Beta::Button.new(
    scheme: :default,
    data: { allowlist_action: "showMainPage" },
  )) { "Cancel" } %>
  <%= render(Primer::Beta::Button.new(
    scheme: :primary,
    disabled: true,
    data: { allowlist_action: "addSelectedServer" },
    "data-disable-with": "Adding...",
  )) { "Add" } %>
</div>
