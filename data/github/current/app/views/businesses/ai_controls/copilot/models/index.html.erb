<% error ||= nil %>

<% page_info(selected_link: :businesses_ai_controls_copilot, sidebar: :ai_controls) %>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    container_attributes: "itemscope itemtype='http://schema.org/Business'",
  } do %>

  <% if error.present? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: :stop, mb: 3)) do %>
      <%= error %>
    <% end %>
  <% end %>
  <%= render(Businesses::AiControls::ReadOnlyBannerComponent.new(is_admin: is_admin)) %>
  <%= render(Primer::Beta::Breadcrumbs.new) do |component| %>
    <% component.with_item(href: copilot_enterprise_ai_controls_enterprise_path(this_business)) do %>Copilot<% end %>
    <% component.with_item(href: request.path) { title } %>
  <% end %>
  <%= render(Primer::Beta::Subhead.new(my: 2, hide_border: true)) do |component| %>
    <% component.with_heading(tag: :h1) { title } %>
  <% end %>

  <%= render partial: "businesses/copilot_settings/models/model_settings", locals: {
    this_business: this_business,
    copilot_business: copilot_business,
    copilot_custom_models: copilot_custom_models,
    features_for_data_retention: features_for_data_retention,
    available_models: available_models,
    can_write: can_write
  } %>
<% end %>
