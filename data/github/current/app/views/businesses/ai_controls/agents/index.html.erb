<% page_info(selected_link: :businesses_ai_controls_agents, sidebar: :ai_controls) %>

  <%= render(Businesses::AiControls::ReadOnlyBannerComponent.new(is_admin: is_admin)) %>

  <%= render(Primer::Box.new(mt: 2, test_selector: "agents-policy-box")) do %>
    <%= render(Primer::Beta::Link.new(href: agents_enterprise_ai_controls_enterprise_path(this_business), test_selector: "agents-link")) do |component| %>
      <% component.with_leading_visual_icon(icon: :"arrow-left") %>
      Agents
    <% end %>

    <%= render(Primer::Beta::Subhead.new(mt: 1, classes: "tmp-mb-4")) do |component| %>
      <% component.with_heading(tag: :h1) { "Copilot Agents" } %>
    <% end %>

    <% if render_copilot_swe_agent_settings %>
      <%= render(Primer::Beta::Subhead.new(mb: 1, hide_border: true)) do |component| %>
        <% component.with_heading(tag: :h2, font_size: 4) { "Copilot cloud agent" } %>
      <% end %>

      <%= render(Primer::Beta::BorderBox.new(padding: :default, my: 0, classes: "tmp-mb-4")) do |component| %>
        <%= component.with_row(scheme: :default) do %>
          <%= render(Copilot::Policies::BusinessFormComponent.new(
            policy_class: Copilot::Policies::CodingAgent,
            configurable: business,
            menu_items: Copilot::Policies::Menus::CODING_AGENT,
            can_write: can_write,
            return_to: agents_policy_enterprise_ai_controls_enterprise_path(business)
            )) do |component| %>
              <%= component.with_description do %>
                If enabled, users assigned a Copilot license from this enterprise will have access to <%= Copilot::Policies::CodingAgent.display_name %>
                in repositories where it is enabled. This feature may use models which are not enabled on your "Models" settings page.
                <%= render(Primer::Beta::Link.new(href: Copilot::Policies::CodingAgent.documentation_url, classes: "Link--inTextBlock")) { "Learn more." } %>
              <% end %>
          <% end %>

          <%= render(Copilot::Policies::MemberRequestsComponent.new(
            entity: business,
            feature: MemberFeatureRequest::Feature::CopilotCodingAgent
          )) %>
        <% end %>

        <% if copilot_business.coding_agent_enterprise_management_enabled? %>
          <%= component.with_row(scheme: :default, ml: 5) do %>
            <%= render(Copilot::Policies::CodingAgentPolicySelectOrganizationsComponent.new(
              business: business,
              can_write: can_write,
            )) %>
          <% end %>
        <% end %>

        <% if render_cca_direct_org_billing_settings %>
          <%= component.with_row(scheme: :default, ml: 5) do %>
            <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
              policy_class: Copilot::Policies::CcaDirectOrgBilling,
              configurable: business,
              display_name: "Allow use of Copilot cloud agent billed to the organization",
              return_to: agents_policy_enterprise_ai_controls_enterprise_path(business),
              can_write: can_write && Copilot::Policies::CcaDirectOrgBilling.editable_by?(Copilot::Business.new(business))
            )) do |component| %>
              <%= component.with_description do %>
                Allow use of the Copilot cloud agent for automations and other uses not linked to a specific user. Premium requests used will be billed as paid usage directly to the organization.
              <% end %>
            <% end %>
            <% unless Copilot::Policies::CcaDirectOrgBilling.editable_by?(Copilot::Business.new(business)) %>
              <%= render(Primer::Beta::Text.new(tag: :p, mt: 2, color: :muted, font_size: :small, display: :flex)) do %>
                <%= render(Primer::Beta::Octicon.new(icon: :"info", mr: 1)) %>
                <%= render(Primer::Beta::Link.new(href: copilot_enterprise_ai_controls_enterprise_path(this_business), classes: "Link--inTextBlock")) { "Premium request paid usage" } %>&nbsp;needs to be enabled in order to use this feature.
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <%= component.with_row(scheme: :default) do %>
          <%= render(Copilot::Policies::SweAgentRepositoryAccessFormComponent.new(configurable: business, return_to: agents_policy_enterprise_ai_controls_enterprise_path(business), can_write: can_write)) %>
        <% end %>
      <% end %>
    <% end %>

    <% if render_copilot_code_review_settings %>
      <%= render(Primer::Beta::Subhead.new(mb: 0, hide_border: true)) do |component| %>
        <% component.with_heading(tag: :h2, font_size: 4) { "Copilot code review" } %>
      <% end %>
      <%= render(Primer::Beta::BorderBox.new(padding: :default, my: 0, classes: "tmp-mb-4")) do |component| %>
        <%= component.with_row(scheme: :default) do %>
          <%= render(Copilot::Policies::BusinessFormComponent.new(
            policy_class: Copilot::Policies::CodeReview,
            configurable: business,
            can_write: can_write,
            return_to: agents_policy_enterprise_ai_controls_enterprise_path(business)
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, members who are licensed through organizations within this enterprise can use <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_CODE_REVIEW_DOCUMENTATION, classes: "Link--inTextBlock")) { Copilot::Policies::CodeReview.display_name } %> and <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_FOR_PRS_DOCUMENTATION, classes: "Link--inTextBlock")) { "Copilot for pull requests" } %> in any repository they belong to.
            <% end %>
          <% end %>
        <% end %>

        <% if render_ccr_direct_org_billing_settings %>
          <%= component.with_row(scheme: :default, ml: 5) do %>
            <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
              policy_class: Copilot::Policies::CcrDirectOrgBilling,
              configurable: business,
              display_name: "Allow members without a Copilot license to use Copilot code review in github.com",
              return_to: agents_policy_enterprise_ai_controls_enterprise_path(business),
              can_write: can_write && Copilot::Policies::CcrDirectOrgBilling.editable_by?(Copilot::Business.new(business))
            )) do |component| %>
              <%= component.with_description do %>
                All members in this enterprise can use Copilot code review on their pull requests in github.com. If configured, <%= render(Primer::Beta::Link.new(href: Copilot::CODE_REVIEW_CONFIGURING_AUTO_DOCS_URL, classes: "Link--inTextBlock")) { "Automatic code review" } %> will run for all pull requests in this enterprise. Premium requests consumed will be billed as paid usage directly to your enterprise.
              <% end %>
            <% end %>
            <% unless Copilot::Policies::CcrDirectOrgBilling.editable_by?(Copilot::Business.new(business)) %>
              <%= render(Primer::Beta::Text.new(tag: :p, mt: 2, color: :muted, font_size: :small, display: :flex)) do %>
                <%= render(Primer::Beta::Octicon.new(icon: :"info", mr: 1)) %>
                <%= render(Primer::Beta::Link.new(href: copilot_enterprise_ai_controls_enterprise_path(this_business), classes: "Link--inTextBlock")) { "Premium request paid usage" } %>&nbsp;needs to be enabled in order to use this feature.
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <% if render_copilot_code_review_beta_features_settings %>
          <%= component.with_row(scheme: :default, ml: 5) do %>
            <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
              configurable: business,
              policy_class: Copilot::Policies::CodeReviewBetaFeatures,
              display_name: "Opt in for access to Copilot code review preview features",
              can_write: can_write,
              return_to: agents_policy_enterprise_ai_controls_enterprise_path(business)
            )) do |component| %>
              <%= component.with_description do %>
                If enabled, members licensed through organizations within this enterprise can access previews of new Copilot code review features. Use of previews is subject to
                <%= render(Primer::Beta::Link.new(href: Copilot::Policies::CodeReviewBetaFeatures.documentation_url, classes: "Link--inTextBlock")) { "GitHub's pre-release terms" } %>.
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <%= component.with_row(scheme: :default) do %>
          <%= render(Copilot::Policies::CodeReviewRepositoryAccessFormComponent.new(configurable: business, return_to: agents_policy_enterprise_ai_controls_enterprise_path(business), can_write: can_write)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
