<% page_info title: "Sandboxes",
             selected_link: :business_sandbox_settings,
             sidebar: :policies %>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    title: "Sandboxes",
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  } do %>

  <%= render(Primer::Beta::Subhead.new) do |component| %>
    <% component.with_heading(tag: :h2) do %>
      Cloud sandbox access
    <% end %>
  <% end %>

  <%= render Primer::Box.new(display: :flex, direction: :column, classes: "tmp-mt-2") do %>
    <%= render Primer::Beta::Text.new do %>
      Manage cloud sandbox access for organizations in your enterprise. When disabled, no organizations can enable cloud sandbox access for their members.
    <% end %>

    <%= render Primer::Beta::Text.new(color: :muted, mt: 1) do %>
      If preview features are enabled, you agree to the <%= link_to "Pre-Release Terms", "https://docs.github.com/en/site-policy/github-terms/github-pre-release-license-terms", class: "Link--inTextBlock" %>.
    <% end %>
  <% end %>

  <% all_orgs_mode_available = business.feature_flag_enabled?(:actions_sandboxes_all_orgs_mode_available, default: false) %>
  <%= form_tag update_settings_sandbox_enablement_enterprise_path(business), method: :put do %>
    <%= render Primer::Box.new(display: :flex, direction: :column, classes: "tmp-mt-3") do %>
      <div class="form-checkbox">
        <label>
          <input
            type="radio"
            name="github_sandbox_enabled"
            value="<%= Configurable::GithubSandboxEnabled::DISABLED %>"
            <%= "checked" if business.github_sandbox_disabled? %>
          >
          <strong>Disabled</strong>
          <p class="note">Cloud sandbox access is not available for any organizations in this enterprise.</p>
        </label>
      </div>

      <div class="form-checkbox">
        <label>
          <input
            type="radio"
            name="github_sandbox_enabled"
            value="<%= Configurable::GithubSandboxEnabled::ALL_MEMBERS %>"
            <%= "checked" if business.github_sandbox_enabled? && (!all_orgs_mode_available || !business.github_sandbox_all_orgs_mode?) %>
          >
          <strong>Let organizations enable (opt-in)</strong>
          <p class="note">Organization admins can choose to enable cloud sandbox access for their members. New organizations default to disabled.</p>
        </label>
      </div>

      <% if all_orgs_mode_available %>
        <div class="form-checkbox">
          <label>
            <input
              type="radio"
              name="github_sandbox_enabled"
              value="all_organizations"
              <%= "checked" if business.github_sandbox_all_orgs_mode? %>
            >
            <strong>Enabled by default for all organizations (opt-out)</strong>
            <p class="note">
              Cloud sandbox access is enabled for all organizations.
              Organization admins can still disable access for their organization if needed.
            </p>
          </label>
        </div>
      <% end %>

      <%= render Primer::Box.new(classes: "tmp-mt-3") do %>
        <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary, test_selector: "sandbox-enterprise-save") do %>
          Save
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
