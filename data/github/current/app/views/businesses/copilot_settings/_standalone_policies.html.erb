<%# ============== START OF BILLING POLICIES SECTION ============== %>
<%# The box and title for this are inside the policy component. Those will need to move back to this %>
<%# page if there are additional Billing section components in the future. %>
<%= render(Billing::OveragePolicyComponent.new(
  entity: business,
  overage_policy_type: "sku",
  name: "copilot_premium_request",
)) %>

<%# ============== END OF BILLING POLICIES SECTION ============== %>

  <%# ============== START OF FEATURES POLICIES SECTION ============== %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
    <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Features" } %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Dotcom,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, members of this enterprise can use
          <% links = [render(Primer::Beta::Link.new(href: Copilot::COPILOT_DOTCOM_CHAT_DOCUMENTATION, classes: "Link--inTextBlock")) { "Copilot Chat in GitHub.com" }] %>
          <% links << render(Primer::Beta::Link.new(href: Copilot::COPILOT_DOCSET_MANAGEMENT, classes: "Link--inTextBlock")) { "knowledge base search" } %>
          <%= to_sentence(links) %>.
        <% end %>
        <%= component.with_note do %>
          Note that knowledge base search is available only for organizations on Copilot Enterprise plan (<%= pluralize(copilot_business.number_of_enterprise_organizations, "organization") %>).
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::EditorChat,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, members of this enterprise can use
          <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_CHAT_EDITOR_DOCS, classes: "Link--inTextBlock")) { "Copilot Chat for code editors" } %>.
        <% end %>
      <% end %>
    <% end %>

    <% if this_business.feature_flag_enabled?(:copilot_next_edit_suggestions, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::EditorPreviewFeatures,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, members of this enterprise will have access to editor preview features.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if this_business.feature_flag_enabled?(:copilot_agent_mode_show_policy, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::AgentMode,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, you may use Agent Mode within your IDE to interact with Copilot for the purpose of reasoning through requests, planning tasks, and making changes to the codebase.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::AgentModeAutoApprove.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::AgentModeAutoApprove,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, members of this enterprise may use <%= Copilot::Policies::AgentModeAutoApprove.display_name %> (currently supported by JetBrains plugin only).
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::CodeReview,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, members of this enterprise can use <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_CODE_REVIEW_DOCUMENTATION, classes: "Link--inTextBlock")) { Copilot::COPILOT_CODE_REVIEW } %> and <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_FOR_PRS_DOCUMENTATION, classes: "Link--inTextBlock")) { "Copilot for pull requests" } %>.
        <% end %>
      <% end %>
    <% end %>
    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::CodeReviewRepositoryAccessFormComponent.new(configurable: business)) %>
    <% end %>

    <% if Copilot::Policies::Spark.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Spark,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, members of your enterprise will have access to <%= Copilot::SPARK_NAME %>.
              <%= render(Primer::Beta::Link.new(href: "https://gh.io/responsible-use-of-github-spark", classes: "Link--inTextBlock")) { "Learn more about #{Copilot::SPARK_NAME}" } %>.
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::MobileChat,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, members of this enterprise can use
          <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_CHAT_MOBILE_DOCS, classes: "Link--inTextBlock")) { "Copilot Chat in GitHub Mobile" } %> personalized to a codebase.
        <% end %>
      <% end %>
    <% end %>

    <% if business.feature_flag_enabled?(:copilot_memory_enablement_policy_with_orgs, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Memory,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            <%= render_policy_description(Copilot::Policies::Memory.business_setting_description(copilot_business)) %>
            <% if Copilot::Policies::Memory.preview?(copilot_business) %>
              <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "memory_pre_release_terms" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Cli,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, members of this enterprise can use GitHub Copilot CLI as an assistant in the terminal.
          <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Cli.documentation_url, classes: "Link--inTextBlock")) { "Learn more about #{Copilot::Policies::Cli.display_name}" } %>.
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::Desktop.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Desktop,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations can use GitHub Copilot for assistance in GitHub Desktop.
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Desktop.documentation_url, classes: "Link--inTextBlock")) { "Learn more about #{Copilot::Policies::Desktop.display_name}" } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::MetricsApi,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, administrators of this enterprise can query the <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_USAGE_METRICS_API_DOCS, classes: "Link--inTextBlock")) { Copilot::COPILOT_METRICS_API_NAME } %> for insights into Copilot usage.
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Insights,
        configurable: business,
        display_name: "Copilot usage metrics",
        menu_items: Copilot::Policies::Menus::COPILOT_INSIGHTS,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, enterprise admins, billing managers, and authorized users can view Copilot usage metrics in a
          <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Insights.documentation_url, classes: "Link--inTextBlock")) { "dashboard" } %>
          and access the
          <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Insights::API_URL, classes: "Link--inTextBlock")) { "Copilot Usage API" } %>.
          <% if Copilot::Policies::Insights.preview?(copilot_business) %>
            <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "insights_pre_release_terms" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Bing,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          Copilot can answer questions about new trends and give improved answers, via Bing. See
          <%= render(Primer::Beta::Link.new(href: Copilot::MICROSOFT_PRIVACY_STATEMENT_URL, classes: "Link--inTextBlock")) { "Microsoft Privacy Statement" } %>.
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::ModelNativeSearch.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::ModelNativeSearch,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            <%= render_policy_description(Copilot::Policies::ModelNativeSearch.business_setting_description(copilot_business)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Mcp,
        configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, users can configure Model Context Protocol (MCP) servers (including third-party servers) for Copilot in all Copilot editors.
            See MCP docs for <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/copilot/customizing-copilot/extending-copilot-chat-with-mcp", classes: "Link--inTextBlock")) { "Copilot Chat" } %>.
          <% end %>
      <% end %>
    <% end %>

    <%# MCP Registry URL Section %>
    <%= component.with_row(scheme: :default) do %>
      <%= render partial: "businesses/copilot_settings/mcp_registry_url", locals: {
        business: business,
        copilot_business: copilot_business,
        mcp_registry: Copilot::McpRegistry.for_business(business).first || Copilot::McpRegistry.new(entity: business),
        can_write: can_write
      } %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::McpRegistryAllowlistFormComponent.new(
          display_name: Copilot::COPILOT_MCP_REGISTRY_ACCESS,
          configurable: business,
          current_value: copilot_business.mcp_registry_access,
        )) do |component|%>
         <%= component.with_description do %>
          Control which MCP servers are allowed based on your registry configuration. View docs on <%= render(Primer::Beta::Link.new(href: "https://gh.io/mcp-registry-allow-lists", classes: "Link--inTextBlock")) { "MCP registry allow lists" } %>.
         <% end %>
        <% end %>
      <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::GeneratedCommitMessage,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, Copilot will suggest commit messages for changes made on GitHub.com. Learn more about <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_GENERATED_COMMIT_MESSAGE_DOCUMENTATION, classes: "Link--inTextBlock")) { Copilot::COPILOT_GENERATED_COMMIT_MESSAGE }  %>.
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::Spaces.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Spaces,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members can view and create
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Spaces.documentation_url, classes: "Link--inTextBlock")) { "Copilot Spaces" } %>.
            When disabled, users cannot view or create any Copilot Spaces.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::SpacesIndividualAccess.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default, ml: 3, mr: 3, pr: 0) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::SpacesIndividualAccess,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members can create individually owned
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::SpacesIndividualAccess.documentation_url, classes: "Link--inTextBlock")) { "Copilot Spaces" } %>.
            When disabled, users cannot create individual spaces.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::SpacesIndividualSharing.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default, ml: 3, mr: 3, pr: 0) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::SpacesIndividualSharing,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members can share individually owned
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::SpacesIndividualSharing.documentation_url, classes: "Link--inTextBlock")) { "Copilot Spaces" } %>
            that do not contain enterprise data. When disabled, users cannot share individual spaces.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::RestrictToAzure.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::RestrictToAzure,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              <%= Copilot::Policies::RestrictToAzure.description %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::RestrictToFedramp.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::RestrictToFedramp,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              <%= Copilot::Policies::RestrictToFedramp.description %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::ByokFormComponent.new(business: business,
        return_to: settings_copilot_enterprise_path(business))) %>
    <% end %>
  <% end %>
  <%# ============== END OF FEATURES POLICIES SECTION ============== %>

  <%# ============== START OF PRIVACY POLICIES SECTION ============== %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
    <%= render(Primer::Beta::Text.new(tag: :h3, font_size: 4, font_weight: :bold)) { "Privacy" } %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Snippy,
        configurable: business,
        menu_items: Copilot::Policies::Menus::ALLOW_OR_BLOCK,
        disabled: !(copilot_business.copilot_billable? || copilot_business.has_trial_organization? || business.digital_front_door?),
      )) do |component| %>
        <%= component.with_description do %>
          Control whether GitHub Copilot blocks code suggestions matching public code, where available.
          <%= render(Primer::Beta::Link.new(href: Copilot::CFB_PUBLIC_CODE_SUGGESTIONS_DOCS, classes: "Link--inTextBlock")) { "Learn more" } %>.
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%# ============== END OF PRIVACY POLICIES SECTION ============== %>

<%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, classes: "tmp-mt-3")) do %>
  <% unless features_for_data_retention.empty? %>
    <%= features_for_data_retention %> and updated <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_SPECIFIC_TERMS, classes: "Link--inTextBlock")) { "Product Terms" } %> apply.
  <% end %>
    If preview features are enabled, you agree to <%= render(Primer::Beta::Link.new(href: Copilot::PRE_RELEASE_TERMS, classes: "Link--inTextBlock")) { "pre-release terms" } %>. For more information about the data your organization receives regarding your use of GitHub Copilot, please review <%= render(Primer::Beta::Link.new(href: Copilot::github_general_privacy_statement_url, classes: "Link--inTextBlock")) { "GitHub's Privacy Statement" } %>.
<% end %>
