<% if this_business.feature_flag_enabled?(:copilot_model_settings_react, default: false) %>
  <%= render_react_partial(name: "copilot-model-settings", props: {
    paths: {
      modelsPath: settings_copilot_models_models_enterprise_path,
      settingsPath: settings_copilot_models_settings_enterprise_path,
      organizationsPath: settings_copilot_models_organizations_enterprise_path,
    },
    enabledFeatures: {
      isUnconfiguredSeparate: !this_business.feature_flag_enabled?(:copilot_unconfigured_is_inherited, default: false),
    },
    canWrite: can_write,
  }) %>
<% else %>
  <%= render partial: "businesses/copilot_settings/models", locals: {
    business: this_business,
    copilot_business: copilot_business,
    copilot_custom_models: copilot_custom_models,
    features_for_data_retention: features_for_data_retention,
    available_models: available_models,
    can_write: can_write
  } %>
<% end %>
