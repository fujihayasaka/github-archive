<% error ||= nil %>

<% page_info title: title,
             selected_link: :business_copilot_settings,
             sidebar: :policies %>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    container_attributes: "itemscope itemtype='http://schema.org/Business'",
  } do %>

  <% if error.present? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: :stop, mb: 3)) do %>
      <%= error %>
    <% end %>
  <% end %>
  <%= render(Primer::Beta::Breadcrumbs.new) do |component| %>
    <% component.with_item(href: settings_code_rules_enterprise_path(this_business)) do %>Policies<% end %>
    <% component.with_item(href: settings_copilot_enterprise_path(this_business)) do %>Copilot<% end %>
    <% component.with_item(href: request.path) { title } %>
  <% end %>
  <%= render(Primer::Beta::Subhead.new(my: 2)) do |component| %>
    <% component.with_heading(tag: :h1) { title } %>
  <% end %>

  <% if this_business.feature_flag_enabled?(:copilot_business_settings_refactor, default: false) %>
    <%= render partial: "businesses/copilot_settings/models_candidate", locals: {
      business: this_business,
      copilot_business: copilot_business,
      copilot_custom_models: copilot_custom_models,
      features_for_data_retention: features_for_data_retention
    } %>
  <% else %>
    <%= render partial: "businesses/copilot_settings/models", locals: {
      business: this_business,
      copilot_business: copilot_business,
      copilot_custom_models: copilot_custom_models,
      features_for_data_retention: features_for_data_retention
    } %>
  <% end %>
<% end %>
