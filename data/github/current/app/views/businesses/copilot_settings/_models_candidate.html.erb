<% cfe_not_accessible = copilot_business.feature_flag_enabled?(:cfe_accessible_models, default: false) && !copilot_business.can_access_copilot_enterprise_models? %>

<% if !copilot_business.copilot_enabled? %>
  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% component.with_header { "There are no models to manage at the moment." } %>
    <% component.with_body do %>
      <%= render(Primer::Beta::Text.new(tag: :p, mt: 3, font_size: 3, font_weight: :bold, text_align: :center)) { "GitHub Copilot models" } %>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 3, text_align: :center, pr: 6, pl: 6, ml: 6, mr: 6)) { "Once you enable access to Copilot you'll have the ability to manage model access for GitHub Copilot inside your enterprise account." } %>
      <p class="mb-3 text-center">
        <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_LEARN_MORE_PAGE, classes: "Link--inTextBlock")) { "Explore Copilot features" } %>
      </p>
    <% end %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessModelFormComponent.new(
        policy_class: Copilot::Policies::Models::AChat,
        configurable: business
      )) %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessModelFormComponent.new(
        policy_class: Copilot::Policies::Models::Af,
        configurable: business
      )) %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessModelFormComponent.new(
        policy_class: Copilot::Policies::Models::Afos,
        configurable: business
      )) %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessModelFormComponent.new(
        policy_class: Copilot::Policies::Models::Al,
        configurable: business,
        not_accessible: cfe_not_accessible
      )) %>
    <% end %>

    <% if copilot_business.feature_flag_enabled?(:copilot_aofo, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessModelFormComponent.new(
          policy_class: Copilot::Policies::Models::Aofo,
          configurable: business,
          not_accessible: cfe_not_accessible
        )) %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessModelFormComponent.new(
        policy_class: Copilot::Policies::Models::GChat,
        configurable: business
      )) %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessModelFormComponent.new(
        policy_class: Copilot::Policies::Models::Gtf,
        configurable: business
      )) %>
    <% end %>

    <% if copilot_business.feature_flag_enabled?(:copilot_gtff, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessModelFormComponent.new(
          policy_class: Copilot::Policies::Models::Gtff,
          configurable: business
          )) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_flag_enabled?(:copilot_o_t, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessModelFormComponent.new(
          policy_class: Copilot::Policies::Models::Ot,
          configurable: business,
          not_accessible: cfe_not_accessible
        )) %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessModelFormComponent.new(
        policy_class: Copilot::Policies::Models::O3,
        configurable: business
        )) %>
    <% end %>

    <% if copilot_business.feature_flag_enabled?(:copilot_o_fm, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessModelFormComponent.new(
          policy_class: Copilot::Policies::Models::Ofm,
          configurable: business
          )) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_flag_enabled?(:copilot_ofct, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessModelFormComponent.new(
          policy_class: Copilot::Policies::Models::Ofct,
          configurable: business,
          # you should see it as inaccessible if no cfe orgs until we roll out to pro
          not_accessible: !(copilot_business.feature_flag_enabled?(:copilot_ofct_pro, default: false) || copilot_business.can_access_copilot_enterprise_models?)
          )) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_flag_enabled?(:copilot_api_force_legacy_base_chat_model, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessModelFormComponent.new(
          policy_class: Copilot::Policies::Models::Ofo,
          configurable: business
          )) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_flag_enabled?(:copilot_obmb, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessModelFormComponent.new(
          policy_class: Copilot::Policies::Models::Obmb,
          configurable: business
          )) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_flag_enabled?(:copilot_obmw, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessModelFormComponent.new(
          policy_class: Copilot::Policies::Models::Obmw,
          configurable: business
          )) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_flag_enabled?(:copilot_grok_code, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessModelFormComponent.new(
          policy_class: Copilot::Policies::Models::GrokCode,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, your organizations will be permitted to access and send data to <%= Copilot::COPILOT_GROK_CODE %>.
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_GROK_CODE_DOCS, classes: "Link--inTextBlock")) { "Learn more." } if Copilot::COPILOT_GROK_CODE_DOCS.present? %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>


  <%= render(Primer::Beta::Text.new(tag: :p, mt: 3, color: :muted, font_size: :small)) do %>
    <% unless features_for_data_retention.empty? %>
      <%= features_for_data_retention %> and updated <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_SPECIFIC_TERMS, classes: "Link--inTextBlock")) { "Product Terms" } %> apply.
    <% end %>
    For more information about the data your enterprise receives regarding your use of GitHub Copilot, please review <%= render(Primer::Beta::Link.new(href: Copilot::github_general_privacy_statement_url, classes: "Link--inTextBlock")) { "GitHub's Privacy Statement" } %>.
  <% end %>
<% end %>
