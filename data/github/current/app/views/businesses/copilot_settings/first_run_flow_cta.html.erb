<% page_info title: "GitHub Copilot",
             selected_link: :business_copilot_settings,
             sidebar: :policies %>
<% is_standalone = this_business.copilot_licensing_enabled? %>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  } do %>
  <div data-hpc>
    <%= render "businesses/copilot_settings/first_run_flow_cta_content",
      this_business: this_business,
      is_standalone: is_standalone %>
  </div>
<% end %>
