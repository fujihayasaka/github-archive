<% page_info title: "GitHub Copilot",
             selected_link: :business_copilot_settings,
             sidebar: :policies %>
<% is_standalone = this_business.copilot_licensing_enabled? %>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  } do %>
  <%= render(Primer::Box.new(text_align: :center, container: :md)) do %>
    <%= render(Primer::Box.new(position: :relative, mx: :auto, mb: 3, style: "width: fit-content")) do %>
      <%= render(Primer::Alpha::Image.new(src: "modules/copilot/copilot-enterprise-avatar2x.png", alt: "copilot avatar", width: 40, z_index: 1)) %>
      <%= render(Primer::Beta::Avatar.new(src: avatar_url_for(this_business, 20), alt: "@#{this_business.slug}", z_index: 2, position: :absolute, bottom: false, style: "right: -12%")) %>
    <% end %>

    <%= render(Primer::Beta::Heading.new(tag: :h1, mb: 2, test_selector: "copilot-first-run-title")) { "GitHub Copilot for your enterprise" } %>

    <%= render(Primer::Beta::Text.new(tag: :p, mb: 4)) do %>
      Infuse AI into GitHub to accelerate every step of the software development lifecycle.
      Enable Copilot to offer members <%= "of organizations" unless is_standalone %> in your enterprise access to Copilot.
    <% end %>
    <%= render(Primer::Beta::Button.new(scheme: :primary, tag: :a, href: copilot_plan_purchase_path(enterprise: this_business), mb: 4)) { "Enable GitHub Copilot" } %>
  <% end %>

  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, col: 12, style: "grid-gap: 16px")) do %>
    <%= render(Primer::Beta::BorderBox.new(col: 6, mx: is_standalone ? :auto : 0)) do |component| %>
      <% component.with_body do %>
        <%= render(Primer::Beta::Heading.new(tag: :h2, mb: 2, test_selector: "copilot-business-title")) { "GitHub Copilot Business" } %>
        <%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) do %>
          <%= render(Primer::Beta::Text.new(font_size: 2)) { "$19" } %>
          <%= render(Primer::Beta::Text.new(color: :subtle, font_size: 6)) { "per seat / per month" } %>
        <% end %>
        <%= render(Primer::Beta::Text.new(tag: :p, font_weight: :bold, mb: 3)) { "For #{is_standalone ? 'companies' : 'organizations'} ready to improve engineering velocity, code quality, and developer experience." } %>
        <%= render(Primer::Beta::Text.new(tag: :p, font_weight: :bold, mb: 0)) { "What's included:" } %>
        <ul style="list-style: none">
          <li>
            <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1)) %>
            <%= render(Primer::Beta::Text.new) { "Code completions and chat in IDE" } %>
          </li>
          <li>
            <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1)) %>
            <%= render(Primer::Beta::Text.new) { "Security vulnerability filter" } %>
          </li>
          <li>
            <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1)) %>
            <%= render(Primer::Beta::Text.new) { "Code referencing" } %>
          </li>
          <li>
            <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1)) %>
            <%= render(Primer::Beta::Text.new) { "CLI assistance" } %>
          </li>
        </ul>
        <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_FOR_BUSINESS_DOCUMENTATION, display: :block, mt: 2)) { "See all features on Business plan" } %>
      <% end %>
    <% end %>
    <% if !is_standalone %>
      <%= render(Primer::Beta::BorderBox.new(col: 6)) do |component| %>
        <% component.with_body(border_bottom: 0) do %>
          <%= render(Primer::Beta::Heading.new(tag: :h2, mb: 2, test_selector: "copilot-enterprise-title")) { "GitHub Copilot Enterprise" } %>
          <%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) do %>
            <%= render(Primer::Beta::Text.new(font_size: 2)) { "$39" } %>
            <%= render(Primer::Beta::Text.new(color: :subtle, font_size: 6)) { "per seat / per month" } %>
          <% end %>
          <%= render(Primer::Beta::Text.new(tag: :p, font_weight: :bold, mb: 3)) { "For companies looking to customize Copilot to their organizations and infuse AI across the developer workflow." } %>
          <%= render(Primer::Beta::Text.new(tag: :p, font_weight: :bold, mb: 0)) { "Everything in Copilot Business, plus..." } %>
          <ul style="list-style: none">
            <li>
              <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1)) %>
              <%= render(Primer::Beta::Text.new) { "Copilot in the entire GitHub Platform" } %>
            </li>
            <li>
              <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1)) %>
              <%= render(Primer::Beta::Text.new) { "Conversational documentation search" } %>
            </li>
            <li>
              <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1)) %>
              <%= render(Primer::Beta::Text.new) { "Summarization skills for pull requests" } %>
            </li>
            <li>
              <%= render(Primer::Beta::Octicon.new(:check, size: :small, mr: 1)) %>
              <%= render(Primer::Beta::Text.new) { "Fine-tuned models (coming soon)" } %>
            </li>
          </ul>
          <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_FOR_ENTERPRISE_DOCUMENTATION, display: :block, mt: 2)) { "See all features on Business plan" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
