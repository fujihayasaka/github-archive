<% if !copilot_business.copilot_enabled? %>
  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% component.with_header { "There are no policies to manage at the moment." } %>
    <% component.with_body do %>
      <%= render(Primer::Beta::Text.new(tag: :p, font_size: 3, font_weight: :bold, text_align: :center, classes: "tmp-mt-3")) { "GitHub Copilot policies" } %>
      <%= render(Primer::Beta::Text.new(tag: :p, text_align: :center, classes: "tmp-mb-3 tmp-pr-6 tmp-pl-6 tmp-ml-6 tmp-mr-6")) { "Once you enable access to Copilot you'll have the ability to manage policies and feature access for GitHub Copilot inside your enterprise account." } %>
      <p class="tmp-mb-3 text-center">
        <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_LEARN_MORE_PAGE, classes: "Link--inTextBlock")) { "Explore Copilot features" } %>
      </p>
    <% end %>
  <% end %>
<% else %>

  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::EaUserFallback,
          configurable: business,
          menu_items: Copilot::Policies::Menus::EA_USER_FALLBACK,
          )) do |component| %>
          <%= component.with_description do %>
            If enabled, enterprise-assigned users default to enabled for any policies set to "No policy."
            Enterprise-assigned users receive licenses directly from enterprise, not through organizations.
          <% end %>
        <% end %>
    <% end %>
  <% end %>

  <%# ============== START OF BILLING POLICIES SECTION ============== %>
  <%# The box and title for this are inside the policy component. Those will need to move back to this %>
  <%# page if there are additional Billing section components in the future. %>
  <%= render(Billing::OveragePolicyComponent.new(
    entity: business,
    overage_policy_type: "sku",
    name: "copilot_premium_request",
  )) %>
  <%# ============== END OF BILLING POLICIES SECTION ============== %>

  <%# ============== START OF FEATURES POLICIES SECTION ============== %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
    <%= render(Primer::Beta::Text.new(tag: :h2, font_size: 4, font_weight: :bold)) { "Features" } %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Dotcom,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, the organizations can use
          <% links = [render(Primer::Beta::Link.new(href: Copilot::COPILOT_DOTCOM_CHAT_DOCUMENTATION, classes: "Link--inTextBlock")) { "Copilot Chat in GitHub.com" }] %>
          <% unless render_copilot_code_review_settings %>
            <% links += [render(Primer::Beta::Link.new(href: Copilot::COPILOT_FOR_PRS_DOCUMENTATION, classes: "Link--inTextBlock")) { "Copilot for pull requests" },
                        render(Primer::Beta::Link.new(href: Copilot::COPILOT_CODE_REVIEW_DOCUMENTATION, classes: "Link--inTextBlock")) { "Copilot code review" }] %>
          <% end %>
          <% links << render(Primer::Beta::Link.new(href: Copilot::COPILOT_DOCSET_MANAGEMENT, classes: "Link--inTextBlock")) { "knowledge base search" } %>
          <%= to_sentence(links) %>.
        <% end %>
        <%= component.with_note do %>
          Note that knowledge base search is available only for organizations on Copilot Enterprise plan (<%= pluralize(copilot_business.number_of_enterprise_organizations, "organization") %>).
        <% end %>
      <% end %>
    <% end %>

    <% if render_copilot_feedback_opt_in_settings %>
      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          configurable: business,
          policy_class: Copilot::Policies::UserFeedback,
          display_name: "Opt in to free text user feedback collection"
        )) do |component| %>
          <%= component.with_description do %>
            Enables user feedback collection on Copilot features in github.com. This feedback may include sensitive information.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if render_copilot_beta_features_opt_in_settings %>
      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          configurable: business,
          policy_class: Copilot::Policies::DotcomBetaFeatures,
          display_name: "Opt in for access to Copilot preview features"
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, members licensed through organizations within this enterprise can access previews of new Copilot in GitHub.com features. Use of previews is subject to
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::DotcomBetaFeatures.documentation_url, classes: "Link--inTextBlock")) { "GitHub's pre-release terms" } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::Spark.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Spark,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, members of your enterprise will have access to <%= Copilot::Policies::Spark.display_name %>.
              <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Spark.documentation_url, classes: "Link--inTextBlock")) { "Learn more about #{Copilot::Policies::Spark.display_name}" } %>.
              Use of previews is subject to <%= render(Primer::Beta::Link.new(href: Copilot::PRE_RELEASE_TERMS, classes: "Link--inTextBlock")) { "GitHub's pre-release terms" } %>.
            <% end %>
        <% end %>
      <% end %>

      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          configurable: business,
          policy_class: Copilot::Policies::SparkForceOrg,
          display_name: "Force Spark repo creation within the organization"
        )) do |component| %>
          <%= component.with_description do %>
            When a user creates a repository from their Spark, force it to be in the organization instead of the user account.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Cli,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, organizations can use GitHub Copilot CLI as an assistant in the terminal.
          <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Cli.documentation_url, classes: "Link--inTextBlock")) { "Learn more about #{Copilot::Policies::Cli.display_name}" } %>.
        <% end %>
      <% end %>
    <% end %>

    <% if render_cli_direct_org_billing_settings %>
      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          configurable: business,
          policy_class: Copilot::Policies::CliDirectOrgBilling,
          display_name: "Allow use of Copilot CLI billed to the organization",
          can_write: Copilot::Policies::CliDirectOrgBilling.editable_by?(Copilot::Business.new(business))
        )) do |component| %>
          <%= component.with_description do %>
            Allow use of the Copilot CLI for automations and other uses not linked to a specific user. Premium requests used will be billed as paid usage directly to the organization.
          <% end %>
        <% end %>
        <% unless Copilot::Policies::CliDirectOrgBilling.editable_by?(Copilot::Business.new(business)) %>
          <%= render(Primer::Beta::Text.new(tag: :p, mt: 2, color: :muted, font_size: :small, display: :flex)) do %>
            <%= render(Primer::Beta::Octicon.new(icon: :"info", mr: 1)) %>
            <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_MANAGE_REQUEST_ALLOWANCES_DOCS, classes: "Link--inTextBlock")) { "Premium request paid usage" } %>&nbsp;needs to be enabled in order to use this feature.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::Desktop.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Desktop,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations can use GitHub Copilot for assistance in GitHub Desktop.
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Desktop.documentation_url, classes: "Link--inTextBlock")) { "Learn more about #{Copilot::Policies::Desktop.display_name}" } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::EditorChat,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, organizations can use
          <%= render(Primer::Beta::Link.new(href: Copilot::Policies::EditorChat.documentation_url, classes: "Link--inTextBlock")) { "Copilot Chat for code editors" } %>.
        <% end %>
      <% end %>
    <% end %>

    <% if business.feature_flag_enabled?(:copilot_next_edit_suggestions, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::EditorPreviewFeatures,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members will have access to editor preview features, including MCP servers.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if business.feature_flag_enabled?(:copilot_agent_mode_show_policy, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::AgentMode,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations may use Agent Mode within their IDE to interact with Copilot for the purpose of
            reasoning through requests, planning tasks, and making changes to the codebase.
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::AgentMode.documentation_url, classes: "Link--inTextBlock")) { "Learn more" } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::AgentModeAutoApprove.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::AgentModeAutoApprove,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, users in the organization may use <%= Copilot::Policies::AgentModeAutoApprove.display_name %> (currently supported by JetBrains plugin only).
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::CcaAgenticGitHubApps.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::CcaAgenticGitHubApps,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            <%= render_policy_description(Copilot::Policies::CcaAgenticGitHubApps.business_setting_description(copilot_business)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::MobileChat,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, organizations can use
          <%= render(Primer::Beta::Link.new(href: Copilot::Policies::MobileChat.documentation_url, classes: "Link--inTextBlock")) { "Copilot Chat in GitHub Mobile" } %> personalized to a codebase.
        <% end %>
      <% end %>
    <% end %>

    <% if business.feature_flag_enabled?(:copilot_memory_enablement_policy_with_orgs, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Memory,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            <%= render_policy_description(Copilot::Policies::Memory.business_setting_description(copilot_business)) %>
            <% if Copilot::Policies::Memory.preview?(copilot_business) %>
              <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "memory_pre_release_terms" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::BlackbirdExternalIndexing.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::BlackbirdExternalIndexing,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            <%
              # Semantic-search indexing for non-GitHub repositories
            %>
            If enabled, organizations can use
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::BlackbirdExternalIndexing.documentation_url, classes: "Link--inTextBlock")) { Copilot::Policies::BlackbirdExternalIndexing.display_name } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if render_cli_cloud_session_storage_settings %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::CliCloudSessionStorage,
          configurable: business,
          current_value: Copilot::Policies::CliCloudSessionStorage.combined_value(copilot_business),
          menu_items: Copilot::Policies::Menus::CLOUD_SESSION_STORAGE,
        )) do |component| %>
          <%= component.with_description do %>
            Control how CLI and VS Code sessions are stored and accessed from the cloud.
            <% if Copilot::Policies::CliCloudSessionStorage.preview?(copilot_business) %>
              <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "cli_cloud_session_storage_pre_release_terms" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% elsif render_cli_remote_control_settings %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::CliRemoteControl,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            <%= render_policy_description(Copilot::Policies::CliRemoteControl.business_setting_description(copilot_business)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if copilot_custom_models %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::CustomModels,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations can create and fine-tune custom models.
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::CustomModels.documentation_url, classes: "Link--inTextBlock")) { "Learn more about Copilot fine-tuning" } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Bing,
        configurable: business,
      )) do |component| %>
        <%= component.with_description do %>
          Copilot can answer questions about new trends and give improved answers, via Bing. See
          <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Bing.documentation_url, classes: "Link--inTextBlock")) { "Microsoft Privacy Statement" } %>.
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::ModelNativeSearch.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::ModelNativeSearch,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            <%= helpers.render_policy_description(Copilot::Policies::ModelNativeSearch.business_setting_description(copilot_business)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if !GitHub.multi_tenant_enterprise? %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::MetricsApi,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, enterprise and organization administrators can query the <%= render(Primer::Beta::Link.new(href: Copilot::Policies::MetricsApi.documentation_url, classes: "Link--inTextBlock")) { Copilot::Policies::MetricsApi.display_name } %> for insights into Copilot usage.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if business.feature_flag_enabled?(:copilot_insights, default: false) && !GitHub.multi_tenant_enterprise? %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Insights,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organization admins can view Copilot metrics within the organization-level insights.
              <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Insights.documentation_url, classes: "Link--inTextBlock")) do
                "Learn more about the available insights and how to interpret them."
              end %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if business.enterprise_managed? && !GitHub.multi_tenant_enterprise? %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::WorkspaceForEmu,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations can access Copilot Workspace. By enabling this feature you agree to
            <%= render(Primer::Beta::Link.new(href: Copilot::GITHUB_NEXT_TERMS, classes: "Link--inTextBlock")) { "GitHub Next's Terms of Service" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if render_copilot_code_review_settings %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::CodeReview,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, members who are licensed through organizations within this enterprise can use <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_CODE_REVIEW_DOCUMENTATION, classes: "Link--inTextBlock")) { Copilot::Policies::CodeReview.display_name } %> and <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_FOR_PRS_DOCUMENTATION, classes: "Link--inTextBlock")) { "Copilot for pull requests" } %> in any repository they belong to.
          <% end %>
        <% end %>
      <% end %>

    <% if render_ccr_direct_org_billing_settings %>
      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          configurable: business,
          policy_class: Copilot::Policies::CcrDirectOrgBilling,
          display_name: "Allow members without a Copilot license to use Copilot code review in github.com",
          can_write: Copilot::Policies::CcrDirectOrgBilling.editable_by?(Copilot::Business.new(business))
        )) do |component| %>
          <%= component.with_description do %>
            All members in this enterprise can use Copilot code review on their pull requests in github.com. If configured, <%= render(Primer::Beta::Link.new(href: Copilot::CODE_REVIEW_CONFIGURING_AUTO_DOCS_URL, classes: "Link--inTextBlock")) { "Automatic code review" } %> will run for all pull requests in this enterprise. Premium requests consumed will be billed as paid usage directly to your enterprise.
          <% end %>
        <% end %>
        <% unless Copilot::Policies::CcrDirectOrgBilling.editable_by?(Copilot::Business.new(business)) %>
          <%= render(Primer::Beta::Text.new(tag: :p, mt: 2, color: :muted, font_size: :small, display: :flex)) do %>
            <%= render(Primer::Beta::Octicon.new(icon: :"info", mr: 1)) %>
            <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_MANAGE_REQUEST_ALLOWANCES_DOCS, classes: "Link--inTextBlock")) { "Premium request paid usage" } %>&nbsp;needs to be enabled in order to use this feature.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if render_copilot_code_review_beta_features_settings %>
      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          configurable: business,
          policy_class: Copilot::Policies::CodeReviewBetaFeatures,
          display_name: "Opt in for access to Copilot code review preview features"
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, members licensed through organizations within this enterprise can access previews of new Copilot code review features. Use of previews is subject to
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::CodeReviewBetaFeatures.documentation_url, classes: "Link--inTextBlock")) { "GitHub's pre-release terms" } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::CodeReviewRepositoryAccessFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if render_copilot_swe_agent_settings %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::CodingAgent,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, users assigned a Copilot license from this enterprise will have access to <%= Copilot::Policies::CodingAgent.display_name %>
          in repositories where it is enabled. This feature may use models which are not enabled on your "Models" settings page.
              <%= render(Primer::Beta::Link.new(href: Copilot::Policies::CodingAgent.documentation_url, classes: "Link--inTextBlock")) { "Learn more." } %>
            <% end %>
        <% end %>

        <%= render(Copilot::Policies::MemberRequestsComponent.new(
          entity: business,
          feature: MemberFeatureRequest::Feature::CopilotCodingAgent
        )) %>
      <% end %>

      <% if render_cca_direct_org_billing_settings %>
        <%= component.with_row(scheme: :default, ml: 5) do %>
          <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
            configurable: business,
            policy_class: Copilot::Policies::CcaDirectOrgBilling,
            display_name: "Allow use of Copilot cloud agent billed to the organization",
            can_write: Copilot::Policies::CcaDirectOrgBilling.editable_by?(Copilot::Business.new(business))
          )) do |component| %>
            <%= component.with_description do %>
              Allow use of the Copilot cloud agent for automations and other uses not linked to a specific user. Premium requests used will be billed as paid usage directly to the organization.
            <% end %>
          <% end %>
          <% unless Copilot::Policies::CcaDirectOrgBilling.editable_by?(Copilot::Business.new(business)) %>
            <%= render(Primer::Beta::Text.new(tag: :p, mt: 2, color: :muted, font_size: :small, display: :flex)) do %>
              <%= render(Primer::Beta::Octicon.new(icon: :"info", mr: 1)) %>
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_MANAGE_REQUEST_ALLOWANCES_DOCS, classes: "Link--inTextBlock")) { "Premium request paid usage" } %>&nbsp;needs to be enabled in order to use this feature.
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::SweAgentRepositoryAccessFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>
    <% if !GitHub.multi_tenant_enterprise? %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Mcp,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, users can configure Model Context Protocol (MCP) servers (including third-party servers) for Copilot in all Copilot editors and Copilot cloud agent.
              See MCP docs for <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/copilot/customizing-copilot/extending-copilot-chat-with-mcp", classes: "Link--inTextBlock")) { "Copilot Chat" } %> and <%= render(Primer::Beta::Link.new(href: "https://docs.github.com/en/copilot/customizing-copilot/extending-copilot-coding-agent-with-mcp", classes: "Link--inTextBlock")) { "Copilot cloud agent" } %>.
            <% end %>
        <% end %>
      <% end %>

      <%# MCP Registry URL Section %>
      <%= component.with_row(scheme: :default) do %>
        <%= render partial: "businesses/copilot_settings/mcp_registry_url", locals: {
          business: business,
          copilot_business: copilot_business,
          mcp_registry: Copilot::McpRegistry.for_business(business).first || Copilot::McpRegistry.new(entity: business),
          can_write: can_write
        } %>
      <% end %>

      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::McpRegistryAllowlistFormComponent.new(
          display_name: Copilot::COPILOT_MCP_REGISTRY_ACCESS,
          configurable: business,
          current_value: copilot_business.mcp_registry_access,
        )) do |component|%>
          <%= component.with_description do %>
          Control which MCP servers are allowed based on your registry configuration. View docs on <%= render(Primer::Beta::Link.new(href: "https://gh.io/mcp-registry-allow-lists", classes: "Link--inTextBlock")) { "MCP registry allow lists" } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::GeneratedCommitMessage.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::GeneratedCommitMessage,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, Copilot will suggest commit messages for changes made on GitHub.com. Learn more about <%= render(Primer::Beta::Link.new(href: Copilot::Policies::GeneratedCommitMessage.documentation_url, classes: "Link--inTextBlock")) { Copilot::Policies::GeneratedCommitMessage.display_name }  %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::Spaces.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Spaces,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members can view and create
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Spaces.documentation_url, classes: "Link--inTextBlock")) { "Copilot Spaces" } %>.
            When disabled, users cannot view or create any Copilot Spaces.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::SpacesIndividualAccess.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default, ml: 3, mr: 3, pr: 0) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::SpacesIndividualAccess,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members can create individually owned
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::SpacesIndividualAccess.documentation_url, classes: "Link--inTextBlock")) { "Copilot Spaces" } %>.
            When disabled, users cannot create individual spaces.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::SpacesIndividualSharing.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default, ml: 3, mr: 3, pr: 0) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::SpacesIndividualSharing,
          configurable: business,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members can share individually owned
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::SpacesIndividualSharing.documentation_url, classes: "Link--inTextBlock")) { "Copilot Spaces" } %>
            that do not contain enterprise data. When disabled, users cannot share individual spaces.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::RestrictToAzure.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::RestrictToAzure,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              <%= Copilot::Policies::RestrictToAzure.description %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::RestrictToFedramp.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::RestrictToFedramp,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              <%= Copilot::Policies::RestrictToFedramp.description %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::RestrictToDataResidency.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::RestrictToDataResidency,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              <%= Copilot::Policies::RestrictToDataResidency.description %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::ByokFormComponent.new(business: business,
        return_to: settings_copilot_enterprise_path(business))) %>
    <% end %>

    <% if Copilot::Policies::ClientByok.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::ClientByok,
          configurable: business,
          )) do |component| %>
            <%= component.with_description do %>
              <%= render_policy_description(Copilot::Policies::ClientByok.business_setting_description(copilot_business)) %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%# ============== END OF FEATURES POLICIES SECTION ============== %>

  <%# ============== START OF PRIVACY POLICIES SECTION ============== %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
    <%= render(Primer::Beta::Text.new(tag: :h2, font_size: 4, font_weight: :bold)) { "Duplicate Detection Filter" } %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <% if Copilot::Policies::DuplicateDetectionFilter.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::DuplicateDetectionFilter,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            <%= render_policy_description(Copilot::Policies::DuplicateDetectionFilter.business_setting_description(copilot_business)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%
      duplicate_detection_filter_available = Copilot::Policies::DuplicateDetectionFilter.available_for?(copilot_business)
      duplicate_detection_filter_ml = duplicate_detection_filter_available ? 3 : 0
    %>
    <%= component.with_row(scheme: :default, ml: duplicate_detection_filter_ml) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Snippy,
        configurable: business,
        menu_items: Copilot::Policies::Menus::ALLOW_OR_BLOCK,
        disabled: !(copilot_business.copilot_billable? || copilot_business.has_trial_organization? || business.digital_front_door?),
      )) do |component| %>
        <%= component.with_description do %>
          Control whether GitHub Copilot blocks code suggestions matching public code, where available.
          <%= render(Primer::Beta::Link.new(href: Copilot::CFB_PUBLIC_CODE_SUGGESTIONS_DOCS, classes: "Link--inTextBlock")) { "Learn more" } %>.
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%# ============== END OF PRIVACY POLICIES SECTION ============== %>

  <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, classes: "tmp-mt-3")) do %>
    <% unless features_for_data_retention.empty? %>
      <%= features_for_data_retention %> and updated <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_SPECIFIC_TERMS, classes: "Link--inTextBlock")) { "Product Terms" } %> apply.
    <% end %>
    If preview features are enabled, you agree to <%= render(Primer::Beta::Link.new(href: Copilot::PRE_RELEASE_TERMS, classes: "Link--inTextBlock")) { "pre-release terms" } %>. For more information about the data your organization receives regarding your use of GitHub Copilot, please review <%= render(Primer::Beta::Link.new(href: Copilot::github_general_privacy_statement_url, classes: "Link--inTextBlock")) { "GitHub's Privacy Statement" } %>.
  <% end %>
<% end %>
