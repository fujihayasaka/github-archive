<% error ||= nil %>

<% page_info title: title,
             selected_link: :business_copilot_settings,
             sidebar: :policies %>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    container_attributes: "itemscope itemtype='http://schema.org/Business'",
  } do %>

  <% if error.present? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: :stop, mb: 3)) do %>
      <%= error %>
    <% end %>
  <% end %>
  <%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |component| %>
    <% component.with_item(href: settings_code_rules_enterprise_path(this_business)) do %>Policies<% end %>
    <% component.with_item(href: settings_copilot_enterprise_path(this_business)) do %>Copilot<% end %>
    <% component.with_item(href: request.path) { title } %>
  <% end %>

  <%= render_react_partial(name: "copilot-content-exclusion", disable_ssr: true, props: { initialPayload: content_exclusions_partial_payload }) %>
<% end %>
