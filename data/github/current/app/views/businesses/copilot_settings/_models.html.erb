    test_selector: "byok-tabs",
    label: "Model type navigation",
    classes: "mb-3",
  ) do |underline_nav| %>
    <% underline_nav.with_tab(href: settings_copilot_models_settings_enterprise_path(business), selected: true) do |tab| %>
      <% tab.with_text { "Default models" } %>
    <% end %>
    <% underline_nav.with_tab(href: enterprise_copilot_byok_custom_models_settings_path(business)) do |tab| %>
      <% tab.with_text do %>
        Custom models
        <%= render Primer::Beta::Label.new(scheme: :success, classes: "ml-2").with_content("Preview") %>
      <% end %>
    <% end %>
  <% end %>

