<%
  use_general_form = current_user.feature_enabled?(:copilot_policy_form_refactor)
  cfe_orgs = copilot_business.copilot_enabled_organizations.select(&:copilot_plan_enterprise?)
  cfb_orgs = copilot_business.copilot_enabled_organizations.select(&:copilot_plan_business?)
%>

<% if !copilot_business.copilot_enabled? %>
  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% component.with_header { "There are no models to manage at the moment." } %>
    <% component.with_body do %>
      <%= render(Primer::Beta::Text.new(tag: :p, mt: 3, font_size: 3, font_weight: :bold, text_align: :center)) { "GitHub Copilot models" } %>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 3, text_align: :center, pr: 6, pl: 6, ml: 6, mr: 6)) { "Once you enable access to Copilot you'll have the ability to manage model access for GitHub Copilot inside your enterprise account." } %>
      <p class="mb-3 text-center">
        <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_LEARN_MORE_PAGE, classes: "Link--inTextBlock")) { "Explore Copilot features" } %>
      </p>
    <% end %>
  <% end %>
<% else %>
  <% unless business.feature_enabled?(:enterprise_copilot_policies_refresh) %>
    <%= render(Primer::Beta::Text.new(tag: :h2, font_size: 4, classes: "text-normal pb-2 mb-0")) do %>
      Copilot models
    <% end %>
    <%= render(Primer::Beta::Text.new(tag: :p, mb: 3, color: :muted)) do %>
      You can manage model access for all organizations with Copilot access.<br>
      If preview features are enabled, you agree to
      <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_CHAT_TERMS, classes: "Link--inTextBlock")) { "pre-release terms" } %>.
    <% end %>
  <% end %>
  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <%= component.with_row(scheme: :default) do %>
      <% if use_general_form %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_A_CHAT} in Copilot",
          configurable: business,
          policy_name: "a_chat",
          current_value: copilot_business.a_chat,
          tab: "models",
          preview: !current_user.feature_enabled?(:a_chat_ga),
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access the latest <%= Copilot::COPILOT_A_CHAT %> model.
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_A_CHAT_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_A_CHAT}" } %>.
            <% end %>
        <% end %>
      <% else %>
        <%= render(Copilot::Policies::AChatFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <% if use_general_form %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_A_F} in Copilot",
          configurable: business,
          policy_name: "a_f",
          current_value: copilot_business.a_f,
          tab: "models",
          preview: !current_user.feature_enabled?(:af_ga),
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations can access the latest <%= Copilot::COPILOT_A_F %> model.
            <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_A_CHAT_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_A_F}" } %>.
          <% end %>
        <% end %>
      <% else %>
        <%= render(Copilot::Policies::AfFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_enabled?(:copilot_afos) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_AFOS} in Copilot",
          configurable: business,
          policy_name: "afos",
          current_value: copilot_business.afos,
          tab: "models",
          preview: true,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access the latest <%= Copilot::COPILOT_AFOS %> model in Copilot.
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_AFOS_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_AFOS}." } if Copilot::COPILOT_AFOS_DOCS.present? %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_enabled?(:copilot_al) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_AL} in Copilot",
          configurable: business,
          policy_name: "al",
          current_value: copilot_business.al,
          tab: "models",
          preview: true,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access the latest <%= Copilot::COPILOT_AL %> model in Copilot.
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_AL_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_AL}." } if Copilot::COPILOT_AL_DOCS.present? %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <% if use_general_form %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_G_CHAT} in Copilot",
          configurable: business,
          policy_name: "g_chat",
          current_value: copilot_business.g_chat,
          tab: "models",
          preview: !current_user.feature_enabled?(:g_chat_ga),
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations can access the latest <%= Copilot::COPILOT_G_CHAT %> model.
            <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_G_CHAT_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_G_CHAT}" } %>.
          <% end %>
        <% end %>
      <% else %>
        <%= render(Copilot::Policies::GChatFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_enabled?(:copilot_g_tf) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_G_TF} in Copilot",
          configurable: business,
          policy_name: "g_tf",
          current_value: copilot_business.g_tf,
          tab: "models",
          preview: true,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access the latest <%= Copilot::COPILOT_G_TF %> model in Copilot.
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_G_TF_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_G_TF}." } if Copilot::COPILOT_G_TF_DOCS.present? %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_enabled?(:copilot_gtff) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_GTFF} in Copilot",
          configurable: business,
          policy_name: "gtff",
          current_value: copilot_business.gtff,
          tab: "models",
          preview: true,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access the latest <%= Copilot::COPILOT_GTFF %> model in Copilot.
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_GTFF_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_GTFF}." } if Copilot::COPILOT_GTFF_DOCS.present? %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <% if use_general_form %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_O1} in Copilot",
          configurable: business,
          policy_name: "o1",
          current_value: copilot_business.o1,
          tab: "models",
          preview: true,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations can access the latest <%= Copilot::COPILOT_O1 %> in Copilot Chat.
          <% end %>
        <% end %>
      <% else %>
        <%= render(Copilot::Policies::O1FormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_enabled?(:copilot_o_t) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_O_T} in Copilot",
          configurable: business,
          policy_name: "o_t",
          current_value: copilot_business.o_t,
          tab: "models",
          preview: true,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access the latest <%= Copilot::COPILOT_O_T %> model in Copilot.
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_O_T_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_O_T}." } if Copilot::COPILOT_O_T_DOCS.present? %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <% if use_general_form %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_O3} in Copilot",
          configurable: business,
          policy_name: "o3",
          current_value: copilot_business.o3,
          tab: "models",
          preview: !current_user.feature_enabled?(:o3_mini_ga),
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations can access the latest <%= Copilot::COPILOT_O3 %> model in Copilot.
          <% end %>
        <% end %>
      <% else %>
        <%= render(Copilot::Policies::O3FormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_enabled?(:copilot_o_fm) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_O_FM} in Copilot",
          configurable: business,
          policy_name: "o_fm",
          current_value: copilot_business.o_fm,
          tab: "models",
          preview: true,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access the latest <%= Copilot::COPILOT_O_FM %> model in Copilot.
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_O_FM_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_O_FM}." } if Copilot::COPILOT_O_FM_DOCS.present? %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_enabled?(:copilot_api_force_legacy_base_chat_model) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::GeneralFormComponent.new(
          display_name: "#{Copilot::COPILOT_OFO} in Copilot",
          configurable: business,
          policy_name: "ofo",
          current_value: copilot_business.ofo,
          tab: "models",
          preview: true,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access the latest <%= Copilot::COPILOT_OFO %> model in Copilot.
              <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_OFO_DOCS, classes: "Link--inTextBlock")) { "Learn more about how GitHub Copilot serves #{Copilot::COPILOT_OFO}." } if Copilot::COPILOT_OFO_DOCS.present? %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%
      render_o_ff = cfe_orgs.any? { |org| org.feature_enabled?(:copilot_o_ff_enterprise) } ||
                     cfb_orgs.any? { |org| org.feature_enabled?(:copilot_o_ff_business) }
    %>

    <% if render_o_ff && (copilot_business.feature_enabled?(:copilot_o_ff_business) || copilot_business.feature_enabled?(:copilot_o_ff_enterprise)) %>
      <%= component.with_row(scheme: :default) do %>
        <% if use_general_form %>
          <%= render(Copilot::Policies::GeneralFormComponent.new(
            display_name: "#{Copilot::COPILOT_O_FF} in Copilot",
            configurable: business,
            policy_name: "o_ff",
            current_value: copilot_business.o_ff,
            tab: "models",
            preview: true,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access the latest <%= Copilot::COPILOT_O_FF %> in Copilot.
            <% end %>
          <% end %>
        <% else %>
          <%= render(Copilot::Policies::OffFormComponent.new(configurable: business)) %>
        <% end %>
      <% end %>
    <% end %>

    <% if copilot_business.feature_enabled?(:copilot_o_f) %>
      <%= component.with_row(scheme: :default) do %>
        <% if use_general_form %>
          <%= render(Copilot::Policies::GeneralFormComponent.new(
            display_name: "#{Copilot::COPILOT_O_F} in Copilot",
            configurable: business,
            policy_name: "o_f",
            current_value: copilot_business.o_f,
            tab: "models",
            preview: true,
          )) do |component| %>
            <%= component.with_description do %>
              If enabled, organizations can access <%= Copilot::COPILOT_O_F %> in Copilot.
            <% end %>
          <% end %>
        <% else %>
          <%= render(Copilot::Policies::OfFormComponent.new(configurable: business)) %>
        <% end %>
      <% end %>
    <% end %>

  <% end %>


  <%= render(Primer::Beta::Text.new(tag: :p, mt: 3, color: :muted, font_size: :small)) do %>
    <% unless features_for_data_retention.empty? %>
      <%= features_for_data_retention %> and updated <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_SPECIFIC_TERMS, classes: "Link--inTextBlock")) { "Product Terms" } %> apply.
    <% end %>
    For more information about the data your enterprise receives regarding your use of GitHub Copilot, please review <%= render(Primer::Beta::Link.new(href: Copilot::github_general_privacy_statement_url, classes: "Link--inTextBlock")) { "GitHub's Privacy Statement" } %>.
  <% end %>
<% end %>
