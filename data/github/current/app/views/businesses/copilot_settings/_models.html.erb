<% if !copilot_business.copilot_enabled? %>
  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% component.with_header { "There are no models to manage at the moment." } %>
    <% component.with_body do %>
      <%= render(Primer::Beta::Text.new(tag: :p, mt: 3, font_size: 3, font_weight: :bold, text_align: :center)) { "GitHub Copilot models" } %>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 3, text_align: :center, pr: 6, pl: 6, ml: 6, mr: 6)) { "Once you enable access to Copilot you'll have the ability to manage model access for GitHub Copilot inside your enterprise account." } %>
      <p class="mb-3 text-center">
        <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_LEARN_MORE_PAGE, classes: "Link--inTextBlock")) { "Explore Copilot features" } %>
      </p>
    <% end %>
  <% end %>
<% else %>
  <h3 class="text-normal pb-2">
    Copilot models
  </h3>
  <%= render(Primer::Beta::Text.new(tag: :p, mb: 3, color: :muted)) do %>
    You can manage model access for all organizations with Copilot access.<br>
    If preview features are enabled, you agree to
    <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_CHAT_TERMS, classes: "Link--inTextBlock")) { "pre-release terms" } %>.
  <% end %>
  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% if !GitHub.multi_tenant_enterprise? %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::AChatFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if !GitHub.multi_tenant_enterprise? && copilot_business.feature_enabled?(:copilot_a_f) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::AfFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if !GitHub.multi_tenant_enterprise? %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::GChatFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if !GitHub.multi_tenant_enterprise? %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::O1FormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if !GitHub.multi_tenant_enterprise? %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::O3FormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if !GitHub.multi_tenant_enterprise?  && (copilot_business.feature_enabled?(:copilot_o_ff_business) || copilot_business.feature_enabled?(:copilot_o_ff_enterprise)) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::OffFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>

    <% if !GitHub.multi_tenant_enterprise?  && copilot_business.feature_enabled?(:copilot_o_f) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::OfFormComponent.new(configurable: business)) %>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::Text.new(tag: :p, mt: 3, color: :muted, font_size: :small)) do %>
    <% unless features_for_data_retention.empty? %>
      <%= features_for_data_retention %> and updated <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_SPECIFIC_TERMS, classes: "Link--inTextBlock")) { "Product Terms" } %> apply.
    <% end %>
    For more information about the data your enterprise receives regarding your use of GitHub Copilot, please review <%= render(Primer::Beta::Link.new(href: Copilot::github_general_privacy_statement_url, classes: "Link--inTextBlock")) { "GitHub's Privacy Statement" } %>.
  <% end %>
<% end %>
