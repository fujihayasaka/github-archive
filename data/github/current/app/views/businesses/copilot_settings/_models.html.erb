<% cfe_not_accessible = !copilot_business.can_access_copilot_enterprise_models? %>
<% available_models = local_assigns.fetch(:available_models, nil) %>
<% available_model = ->(policy) { available_models.nil? || available_models.include?(policy) } %>
<% can_write = local_assigns.fetch(:can_write, true) %>
<% is_disabled = !can_write %>

