<% if !copilot_business.copilot_enabled? %>
  <%= render(Primer::Beta::BorderBox.new) do |component| %>
    <% component.with_header { "There are no policies to manage at the moment." } %>
    <% component.with_body do %>
      <%= render(Primer::Beta::Text.new(tag: :p, font_size: 3, font_weight: :bold, text_align: :center, classes: "tmp-mt-3")) { "GitHub Copilot policies" } %>
      <%= render(Primer::Beta::Text.new(tag: :p, text_align: :center, classes: "tmp-mb-3 tmp-pr-6 tmp-pl-6 tmp-ml-6 tmp-mr-6")) { "Once you enable access to Copilot you'll have the ability to manage policies and feature access for GitHub Copilot inside your enterprise account." } %>
      <p class="tmp-mb-3 text-center">
        <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_LEARN_MORE_PAGE, classes: "Link--inTextBlock")) { "Explore Copilot features" } %>
      </p>
    <% end %>
  <% end %>
<% else %>
  <%# ============== START OF PRIVACY POLICIES SECTION ============== %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
    <%= render(Primer::Beta::Text.new(tag: :h2, font_size: 4, font_weight: :bold, test_selector: "copilot-privacy-title")) { "Privacy" } %>
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Snippy,
        configurable: business,
        can_write: can_write,
        menu_items: Copilot::Policies::Menus::ALLOW_OR_BLOCK,
        disabled: !(copilot_business.copilot_billable? || copilot_business.has_trial_organization? || business.digital_front_door?),
      )) do |component| %>
        <%= component.with_description do %>
          GitHub Copilot can allow or block <%= render(Primer::Beta::Link.new(href: Copilot::CFB_PUBLIC_CODE_SUGGESTIONS_DOCS, classes: "Link--inTextBlock")) { "code suggestions" } %> matching public code.
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%# ============== END OF PRIVACY POLICIES SECTION ============== %>

  <%# ============== START OF FEATURES POLICIES SECTION ============== %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
    <%= render(Primer::Beta::Text.new(tag: :h2, font_size: 4, font_weight: :bold, test_selector: "copilot-features-title")) { "Features" } %>
  <% end %>
  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::EaUserFallback,
        configurable: business,
        can_write: can_write,
        menu_items: Copilot::Policies::Menus::EA_USER_FALLBACK,
      )) do |component| %>
        <%= component.with_description do %>
          <%= render_policy_description(Copilot::Policies::EaUserFallback.business_setting_description(copilot_business)) %>
          <% if Copilot::Policies::EaUserFallback.preview?(copilot_business) %>
            <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "ea_user_fallback_pre_release_terms" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <% if Copilot::Policies::Spark.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Spark,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            Organizations can have access to <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Spark.documentation_url, classes: "Link--inTextBlock")) { "GitHub #{Copilot::Policies::Spark.display_name}" } %>.
            <% if Copilot::Policies::Spark.preview?(copilot_business) %>
              <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "spark_pre_release_terms" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          configurable: business,
          policy_class: Copilot::Policies::SparkForceOrg,
          display_name: "Force Spark repo creation within the organization",
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            When a user creates a repository from their Spark, force it to be in the organization instead of the user account.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if business.feature_flag_enabled?(:copilot_next_edit_suggestions, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::EditorPreviewFeatures,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            Organizations can have access to editor preview features.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Bing,
        configurable: business,
        can_write: can_write,
      )) do |component| %>
        <%= component.with_description do %>
          Copilot can answer questions about new trends and give improved answers, via Bing. See
          <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Bing.documentation_url, classes: "Link--inTextBlock")) { "Microsoft Privacy Statement" } %>.
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::ModelNativeSearch.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::ModelNativeSearch,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            <%= render_policy_description(Copilot::Policies::ModelNativeSearch.business_setting_description(copilot_business)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::GeneratedCommitMessage.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::GeneratedCommitMessage,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, Copilot will <%= render(Primer::Beta::Link.new(href: Copilot::Policies::GeneratedCommitMessage.documentation_url, classes: "Link--inTextBlock")) { "suggest commit messages" } %> for changes made on GitHub.com.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::Spaces.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Spaces,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members can view and create
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Spaces.documentation_url, classes: "Link--inTextBlock")) { "Copilot Spaces" } %>.
            When disabled, users cannot view or create any Copilot Spaces.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::SpacesIndividualAccess.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default, ml: 3, mr: 3, pr: 0) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::SpacesIndividualAccess,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members can create individually owned
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::SpacesIndividualAccess.documentation_url, classes: "Link--inTextBlock")) { "Copilot Spaces" } %>.
            When disabled, users cannot create individual spaces.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::SpacesIndividualSharing.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default, ml: 3, mr: 3, pr: 0) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::SpacesIndividualSharing,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organization members can share individually owned
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::SpacesIndividualSharing.documentation_url, classes: "Link--inTextBlock")) { "Copilot Spaces" } %>
            that do not contain enterprise data. When disabled, users cannot share individual spaces.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::RestrictToAzure.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::RestrictToAzure,
          configurable: business,
          can_write: can_write,
          )) do |component| %>
            <%= component.with_description do %>
              <%= Copilot::Policies::RestrictToAzure.description %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::RestrictToFedramp.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::RestrictToFedramp,
          configurable: business,
          can_write: can_write,
          )) do |component| %>
            <%= component.with_description do %>
              <%= Copilot::Policies::RestrictToFedramp.description %>
            <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::Memory.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Memory,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            <%= render_policy_description(Copilot::Policies::Memory.business_setting_description(copilot_business)) %>
            <% if Copilot::Policies::Memory.preview?(copilot_business) %>
              <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "memory_pre_release_terms" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::ByokFormComponent.new(business: business,
        return_to: copilot_enterprise_ai_controls_enterprise_path(business), can_write: can_write)) %>
    <% end %>
  <% end %>
  <%# ============== END OF FEATURES POLICIES SECTION ============== %>

  <%# ============== START OF BILLING POLICIES SECTION ============== %>
  <%# The box and title for this are inside the policy component. Those will need to move back to this %>
  <%# page if there are additional Billing section components in the future. %>
  <%= render(Billing::OveragePolicyComponent.new(
    entity: business,
    overage_policy_type: "sku",
    name: "copilot_premium_request",
  )) %>
  <%# ============== END OF BILLING POLICIES SECTION ============== %>

  <%# ============== START OF METRICS POLICIES SECTION ============== %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
    <%= render(Primer::Beta::Text.new(tag: :h2, font_size: 4, font_weight: :bold, test_selector: "copilot-metrics-title", id: "metrics")) { "Metrics" } %>
  <% end %>
  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <% if !GitHub.multi_tenant_enterprise? %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::MetricsApi,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, enterprise and organization administrators can query the <%= render(Primer::Beta::Link.new(href: Copilot::Policies::MetricsApi.documentation_url, classes: "Link--inTextBlock")) { Copilot::Policies::MetricsApi.display_name } %> for insights into Copilot usage.
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <% if !GitHub.multi_tenant_enterprise? || business.feature_flag_enabled?(:copilot_insights_multi_tenant_enterprise, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Insights,
          configurable: business,
          can_write: can_write,
          display_name: "Copilot usage metrics",
          menu_items: Copilot::Policies::Menus::COPILOT_INSIGHTS,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, enterprise admins, billing managers, and authorized users can view Copilot usage metrics in a
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Insights.documentation_url, classes: "Link--inTextBlock")) { "dashboard" } %>
            and access the
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::Insights::API_URL, classes: "Link--inTextBlock")) { "Copilot Usage API" } %>.
            <% if Copilot::Policies::Insights.preview?(copilot_business) %>
              <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "insights_pre_release_terms" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%# ============== END OF METRICS POLICIES SECTION ============== %>
  <%# ============== START OF COPILOT CLIENTS SECTION ============== %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, direction: :row, align_items: :center, classes: "tmp-mb-3")) do %>
    <%= render(Primer::Beta::Text.new(tag: :h2, font_size: 4, font_weight: :bold)) { "Copilot Clients" } %>
  <% end %>
  <%= render(Primer::Beta::BorderBox.new(padding: :default, classes: "tmp-mb-3")) do |component| %>
    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Dotcom,
        configurable: business,
        can_write: can_write,
      )) do |component| %>
        <%= component.with_description do %>
          Organizations can use
          <% text_items = ["Copilot Chat in GitHub.com"] %>
          <% unless render_copilot_code_review_settings %>
            <% text_items += ["Copilot for pull requests", "Copilot code review"] %>
          <% end %>
          <% text_items << "knowledge base search" %>
          <%= to_sentence(text_items) %>.
        <% end %>
      <% end %>
    <% end %>

    <% if render_copilot_feedback_opt_in_settings %>
      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          configurable: business,
          policy_class: Copilot::Policies::UserFeedback,
          display_name: "Opt in to free text user feedback collection",
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            Enables user feedback collection on Copilot features in github.com. This feedback may include sensitive information.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if render_copilot_beta_features_opt_in_settings %>
      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          configurable: business,
          policy_class: Copilot::Policies::DotcomBetaFeatures,
          display_name: "Opt in for access to Copilot preview features",
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations can use previews of new Copilot in GitHub.com features. Use of previews is subject to <%= render(Primer::Beta::Link.new(href: Copilot::Policies::DotcomBetaFeatures.documentation_url, classes: "Link--inTextBlock")) { "GitHub's pre-release terms" } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::Cli,
        configurable: business,
        can_write: can_write,
      )) do |component| %>
        <%= component.with_description do %>
          Organizations can use GitHub Copilot for assistance in terminal.
          <% if Copilot::Policies::Cli.preview?(copilot_business) %>
            <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "cli_pre_release_terms" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if render_cli_direct_org_billing_settings %>
      <%= component.with_row(scheme: :default, ml: 5) do %>
        <%= render(Copilot::Policies::BusinessOptInFormComponent.new(
          policy_class: Copilot::Policies::CliDirectOrgBilling,
          configurable: business,
          display_name: "Allow use of Copilot CLI billed to the organization",
          can_write: can_write && Copilot::Policies::CliDirectOrgBilling.editable_by?(Copilot::Business.new(business))
        )) do |component| %>
          <%= component.with_description do %>
            Allow use of the Copilot CLI for automations and other uses not linked to a specific user. Premium requests used will be billed as paid usage directly to the organization.
          <% end %>
        <% end %>
        <% unless Copilot::Policies::CliDirectOrgBilling.editable_by?(Copilot::Business.new(business)) %>
          <%= render(Primer::Beta::Text.new(tag: :p, mt: 2, color: :muted, font_size: :small, display: :flex)) do %>
            <%= render(Primer::Beta::Octicon.new(icon: :"info", mr: 1)) %>
            <%= render(Primer::Beta::Link.new(href: copilot_enterprise_ai_controls_enterprise_path(this_business), classes: "Link--inTextBlock")) { "Premium request paid usage" } %>&nbsp;needs to be enabled in order to use this feature.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::Desktop.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::Desktop,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            Organizations can use GitHub Copilot for assistance in GitHub Desktop.
            <% if Copilot::Policies::Desktop.preview?(copilot_business) %>
              <%= render partial: "businesses/copilot_settings/preview_terms", locals: { test_selector: "desktop_pre_release_terms" } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::EditorChat,
        configurable: business,
        can_write: can_write,
      )) do |component| %>
        <%= component.with_description do %>
          Organizations can use Copilot Chat for code editors.
        <% end %>
      <% end %>
    <% end %>

    <%= component.with_row(scheme: :default) do %>
      <%= render(Copilot::Policies::BusinessFormComponent.new(
        policy_class: Copilot::Policies::MobileChat,
        configurable: business,
        can_write: can_write,
      )) do |component| %>
        <%= component.with_description do %>
          If enabled, organizations can use GitHub Copilot Chat in GitHub Mobile personalized to a codebase.
        <% end %>
      <% end %>
    <% end %>

    <% if business.feature_flag_enabled?(:copilot_agent_mode_show_policy, default: false) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::AgentMode,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
            If enabled, organizations may use Agent Mode within their IDE to interact with Copilot for the purpose of
            reasoning through requests, planning tasks, and making changes to the codebase.
            <%= render(Primer::Beta::Link.new(href: Copilot::Policies::AgentMode.documentation_url, classes: "Link--inTextBlock")) { "Learn more" } %>.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if Copilot::Policies::AgentModeAutoApprove.available_for?(copilot_business) %>
      <%= component.with_row(scheme: :default) do %>
        <%= render(Copilot::Policies::BusinessFormComponent.new(
          policy_class: Copilot::Policies::AgentModeAutoApprove,
          configurable: business,
          can_write: can_write,
        )) do |component| %>
          <%= component.with_description do %>
             If enabled, users in the organization may use <%= Copilot::Policies::AgentModeAutoApprove.display_name %> (currently supported by JetBrains plugin only).
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%# ============== END OF COPILOT CLIENTS SECTION ============== %>

  <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, classes: "tmp-mt-3")) do %>
    <% unless features_for_data_retention.empty? %>
      <%= features_for_data_retention %> and updated <%= render(Primer::Beta::Link.new(href: Copilot::COPILOT_SPECIFIC_TERMS, classes: "Link--inTextBlock")) { "Product Terms" } %> apply.
    <% end %>
      If preview features are enabled, you agree to <%= render(Primer::Beta::Link.new(href: Copilot::PRE_RELEASE_TERMS, classes: "Link--inTextBlock")) { "pre-release terms" } %>. For more information about the data your organization receives regarding your use of GitHub Copilot, please review <%= render(Primer::Beta::Link.new(href: Copilot::github_general_privacy_statement_url, classes: "Link--inTextBlock")) { "GitHub's Privacy Statement" } %>.
  <% end %>
<% end %>
