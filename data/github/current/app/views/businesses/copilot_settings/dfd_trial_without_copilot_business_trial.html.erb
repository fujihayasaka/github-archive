<% page_info title: "GitHub Copilot", selected_link: :business_copilot_settings, sidebar: :policies %>

<%= render layout: "businesses/layout",
  locals: {
    business: this_business,
    title: "GitHub Copilot",
    container_attributes: "itemscope itemtype='http://schema.org/Business'"
  } do %>
  <%= render(Primer::Beta::BorderBox.new) do |border_box_component| %>
    <% border_box_component.with_body do %>
      <%= render(
        Primer::Beta::Blankslate.new(
          spacious: false,
          test_selector: "dfd-trial-without-copilot-business-trial",
        )
      ) do |component| %>
        <% component.with_visual_icon(icon: :copilot, size: :medium) %>
        <% if this_business.authenticated_through_digital_front_door? %>
          <% component.with_heading(tag: :h2, test_selector: "dfd-trial-create-first-org") do %>
            Create your first organization, give it access to Copilot
          <% end %>
          <% component.with_description do %>
            <%= render Primer::Beta::Text.new(tag: :p) do %>
              You can assign Copilot seats to organization members free for the duration of your trial.
            <% end %>
          <% end %>
          <% component.with_primary_action(href: new_enterprise_onboarding_organization_path(this_business)) do %>
            Create your first organization
          <% end %>
        <% else %>
          <% component.with_heading(tag: :h2, test_selector: "dfd-trial-verify-identity") do %>
            Try GitHub Copilot Business risk-free
          <% end %>
          <% component.with_description do %>
            <%= render Primer::Beta::Text.new(tag: :p) do %>
              You can activate Copilot Business free for the duration of your trial by verifying your identity with a
              payment method, which will not be charged automatically at the end of the trial.
            <% end %>
          <% end %>
          <% component.with_primary_action(href: enterprise_trial_activations_path(this_business)) do %>
            Verify your identity
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
