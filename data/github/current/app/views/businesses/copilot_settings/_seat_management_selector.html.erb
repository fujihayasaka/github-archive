<%
  business_caption = "For organizations ready to improve engineering velocity, code quality, and developer experience. #{link_to('See all features on Business plan', Copilot::COPILOT_FOR_BUSINESS_DOCUMENTATION)}.".html_safe # rubocop:disable Rails/OutputSafety
  enterprise_caption = "For companies looking to customize Copilot to their organization and infuse AI across the developer workflow. #{link_to('See all features on Enterprise plan', Copilot::COPILOT_FOR_ENTERPRISE_DOCUMENTATION)}.".html_safe # rubocop:disable Rails/OutputSafety
%>

<%= render(Primer::Beta::BorderBox.new) do |component| %>
  <% component.with_body do %>
    <%= render(Primer::Box.new(text_align: :center)) do %>
      <%= render(Primer::Beta::Text.new(tag: :p, mt: 3, font_size: 3, font_weight: :bold)) { "Enable Copilot for organizations" } %>
      <% if feature_requests[:requests_count] > 0 %>
        <%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) { "Members in #{feature_requests[:requests_count]} #{"organization".pluralize(feature_requests[:requests_count])} have requested access to GitHub Copilot" } %>
      <% else %>
        <%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) { "No organizations are using GitHub Copilot in this enterprise." } %>
      <% end %>
      <%= render(Primer::Alpha::ActionMenu.new(
        select_variant: :single,
        dynamic_label: true,
        overlay_arguments: { size: :small })
      ) do |menu| %>
        <% menu.with_show_button do |button| %>
          <% button.with_trailing_action_icon(icon: :"triangle-down") %>
          Configure access permissions
        <% end %>
        <% menu.with_item(
          label: "Enable for all organizations (#{copilot_business.copilot_organizations.size})",
          tag: :button,
          content_arguments: { "data-show-dialog-id": "all-organizations-copilot-plan-select-dialog" }
        ) do |item| %>
          <% item.with_description { "Allow access to GitHub Copilot for all organizations, including any created in the future." } %>
        <% end %>
        <% menu.with_divider %>
        <% menu.with_item(
          label: "Enable for selected organizations",
          href: update_settings_copilot_enablement_enterprise_path(copilot_business.business_object),
          form_arguments: {
            method: :put,
            inputs: [
              name: "copilot_enabled",
              value: "selected_organizations"
            ]
          }
        ) do |item| %>
          <% item.with_description { "Only specifically-selected organizations may use GitHub Copilot." } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<copilot-plan-select-dialog>
  <%= form_tag(
    update_settings_copilot_enablement_enterprise_path(copilot_business.business_object),
    method: :put,
    data: { target: "copilot-plan-select-dialog.formEl" }
  ) do %>
    <input type="hidden" name="copilot_enabled" value="all_organizations">
    <%= render(Primer::Alpha::Dialog.new(
      title: "Select Copilot plan to enable for all organizations",
      size: :medium_portrait,
      position: :center,
      id: "all-organizations-copilot-plan-select-dialog",
    )) do |dialog| %>
      <% dialog.with_header(show_divider: true) %>
      <% dialog.with_body(pt: 3) do %>
        <%= render(Primer::Beta::BorderBox.new(mb: 2)) do |component| %>
          <% component.with_body do %>
            <%= render(Primer::Alpha::RadioButton.new(
              name: "enablement",
              label: "Copilot Business",
              value: "business",
              caption: business_caption
            )) %>
          <% end %>
        <% end %>
        <%= render(Primer::Beta::BorderBox.new) do |component| %>
          <% component.with_body do %>
            <%= render(Primer::Alpha::RadioButton.new(
              name: "enablement",
              label: "Copilot Enterprise",
              value: "enterprise",
              caption: enterprise_caption
            )) %>
          <% end %>
        <% end %>
      <% end %>
      <% dialog.with_footer(show_divider: true, px: 0) do %>
        <%= render(Primer::Alpha::Dialog::Footer.new(pb: 0)) do %>
          <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": "all-organizations-copilot-plan-select-dialog" })) { "Cancel" } %>
          <%= render(Primer::Beta::Button.new(
            scheme: :primary,
            type: :submit,
            inactive: true,
            data: { "target": "copilot-plan-select-dialog.submitBtn" }
          )) { "Confirm and enable Copilot" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</copilot-plan-select-dialog>
