# typed: true
# frozen_string_literal: true

FactoryBot.define do
  T.bind(self, T.untyped)

  factory :<%= target_class_name.underscore %>_custom_property_definition, class: "<%= definition_class_name %>" do
    custom_property_definition_base

    # Update this line if this implementation uses values_editable_by
    values_editable_by { "not_configured" }

    trait :string do
      value_type { :string }
      property_name { "version" }
      allowed_values { nil }
    end

    trait :single_select do
      value_type { :single_select }
      property_name { "env" }
      allowed_values { %w[test prod] }
    end

    trait :true_false do
      value_type { :true_false }
      property_name { "is_legacy" }
      allowed_values { nil }
    end

    trait :multi_select do
      value_type { :multi_select }
      property_name { "platform" }
      allowed_values { %w[ios web android] }
    end
  end

  factory :<%= target_class_name.underscore %>_custom_property_value, class: "<%= value_class_name %>" do
    custom_property_value_base
  end
end
