# typed: strict
# frozen_string_literal: true

class <%= value_class_name %> < <%= application_record_domain %>
  # definition_class_name needs to be defined prior to including CustomProperties::ValueBase
  #
  # This is the class name of the Custom Property Definition model that these values are associated with
  # This is used to define the association between the value and the definition
  # This should be a string, not a class name, as it will be used in the context of the ORM
  # and not in the context of the class itself
  #
  # @see <%= definition_class_name %>
  # @see CustomProperties::ValueBase
  sig { returns(String) }
  def self.definition_class_name
    T.must(<%= definition_class_name %>.name)
  end

  # target_class_name needs to be defined prior to including CustomProperties::ValueBase
  #
  # This is the class name of the model that these values target, or that the value is defined for.
  # This is used to define the active record association between the value and its target.
  # This should be a string, not a class name, as it will be used in the context of the ORM
  # and not in the context of the class itself
  #
  # @see <%= target_class_name %>
  # @see CustomProperties::ValueBase
  sig { returns(String) }
  def self.target_class_name
    T.must(<%= target_class_name %>.name)
  end

  # TODO: Uncomment if you need to add a target_scope
  # target_scope needs to be defined prior to including CustomProperties::ValueBase
  #
  # This scope is used when querying target objects for things like properties usage checks
  # before removal. It is useful when your domain object can be soft deleted and you don't
  # want properties assigned to those objects to be considered when deleting a definition
  # or updating allowed values.
  #
  # Below is an example of a scope that would exclude soft deleted objects
  #
  # @see <%= target_class_name %>
  # @see CustomProperties::ValueBase
  # sig { returns(T.proc.returns(T.untyped)) }
  # def self.target_scope
  #   -> { where(deleted: false) }
  # end

  # TODO: Uncomment and add any additional event payload key value pairs.
  #
  # The below lines are there as an example of possible additional payload information.
  #
  # Generates the event payload for custom property value events.
  # sig { params(target: T.nilable(<%= target_class_name %>)).returns(T::Hash[Symbol, T.untyped]) }
  # def self.event_payload_extension(target)
  #   {
  #     org: target,
  #     business: target&.business,
  #   }
  # end

  include CustomProperties::ValueBase
end
