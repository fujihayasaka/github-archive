# typed: true
# frozen_string_literal: true

require "test_helper"
require "<%= file_without_lib_or_extension %>"

class Encrypt<%= transition_model_name %>Test < GitHub::TestCase
  include GitHub::DatabaseHelpers

  sig do
    params(args: T::Hash[Symbol, T.untyped]).
    returns(GitHub::Transitions::Encrypt<%= transition_model_name %>)
  end
  def new_transition(args = {})
    arguments = GitHub::Transitions::Arguments.new(args)

    transition = GitHub::Transitions::Encrypt<%= transition_model_name %>.new(arguments)
    transition.stubs(:parallel?).returns(false)
    transition
  end

  test "does nothing on a dry run", skip_enterprise: true do
    transition = new_transition(dry_run: true)
    plaintext_model = ActiveRecord::Encryption.without_encryption do

      # Create an instance of your model with the attribute which has encryption enabled
      # Note: Additional required attributes may need to be passed in
      create(:<%= model_name_underscored %>)
    end

    # Add one assertion per encrypted attribute on the model
    assert_equal false, plaintext_model.reload.encrypted_attribute?(:<%= attribute_name %>)

    assert_no_query_warnings { transition.run }

    # Add one assertion per encrypted attribute on the model
    assert_equal false, plaintext_model.reload.encrypted_attribute?(:<%= attribute_name %>)
  end

  test "transition encrypts data", skip_enterprise: true do
    transition = new_transition(dry_run: false)
    plaintext_model = ActiveRecord::Encryption.without_encryption do

      # Create an instance of your model with the attribute which has encryption enabled
      # Note: Additional required attributes may need to be passed in
      create(:<%= model_name_underscored %>)
    end

    # Create an instance of your model with the attribute which has encryption enabled
    # Note: Additional required attributes may need to be passed in
    encrypted_model = create(:<%= model_name_underscored %>)

    # Account for all features tests
    if GitHub.flipper["encrypt_as_plaintext_<%= model_name_underscored %>_<%= attribute_name %>"].enabled?
      # Add one assertion per encrypted attribute on the model
      assert_equal false, plaintext_model.reload.encrypted_attribute?(:<%= attribute_name %>)

      # Add one assertion per encrypted attribute on the model
      assert_equal false, encrypted_model.reload.encrypted_attribute?(:<%= attribute_name %>)
    else
      # Add one assertion per encrypted attribute on the model
      assert_equal false, plaintext_model.reload.encrypted_attribute?(:<%= attribute_name %>)

      # Add one assertion per encrypted attribute on the model
      assert_equal true, encrypted_model.reload.encrypted_attribute?(:<%= attribute_name %>)
    end

    assert_no_query_warnings { transition.run }

    # Account for all features tests
    if GitHub.flipper["encrypt_as_plaintext_<%= model_name_underscored %>_<%= attribute_name %>"].enabled?
      # Add one assertion per encrypted attribute on the model
      assert_equal false, plaintext_model.reload.encrypted_attribute?(:<%= attribute_name %>)

      # Add one assertion per encrypted attribute on the model
      assert_equal false, encrypted_model.reload.encrypted_attribute?(:<%= attribute_name %>)
    else
      # Add one assertion per encrypted attribute on the model
      assert_equal true, plaintext_model.reload.encrypted_attribute?(:<%= attribute_name %>)

      # Add one assertion per encrypted attribute on the model
      assert_equal true, encrypted_model.reload.encrypted_attribute?(:<%= attribute_name %>)
    end
  end
end
