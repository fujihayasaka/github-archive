#!/bin/bash

set -e

PULLSD_VENDOR_PATH="vendor/pullsd"

if [ ! -d "$PULLSD_VENDOR_PATH" ]; then
    echo "ERROR: $PULLSD_VENDOR_PATH not found. Run script/build-subproject pullsd first."
    exit 1
fi

cd "$PULLSD_VENDOR_PATH"

if [ ! -f "Makefile" ]; then
    echo "ERROR: No Makefile found in $PULLSD_VENDOR_PATH"
    exit 1
fi

make build

if [ ! -f "bin/pullsd" ]; then
    echo "ERROR: Build failed - binary not created at $PULLSD_VENDOR_PATH/bin/pullsd"
    exit 1
fi

echo "Pullsd binary built successfully"
