#!/usr/bin/env safe-ruby
# frozen_string_literal: true

require_relative "../script/seeds/runners/issues_react"
require_relative "../script/seeds/runners/issue_fields"
require_relative "../config/environment"

unless Rails.env.development?
  raise "This is a dev-only script"
end

# puts "Seeding issues react..."
Seeds::Runner::IssuesReact.execute({ minimal: true })

# puts "Seeding issue fields..."
Seeds::Runner::IssueFields.execute

puts "Setting up feature flags..."

github_org = Organization.find_by(login: "github")
monalisa = User.find_by(login: "monalisa")

FeatureFlag.vexi_management.add_feature_flag_actors(:issue_fields, [github_org])
FeatureFlag.vexi_management.add_feature_flag_actors(:issue_fields_multi_select, [github_org])
FeatureFlag.vexi_management.add_feature_flag_actors(:issue_fields_in_public_projects, [github_org])
FeatureFlag.vexi_management.add_feature_flag_actors(:repo_issue_fields, [github_org, monalisa])
FeatureFlag.vexi_management.add_feature_flag_actors(:issue_fields_index_pills, [monalisa])
FeatureFlag.vexi_management.add_feature_flag_actors(:issue_fields_visible_via_issues_permission, [github_org])
FeatureFlag.vexi_management.enable_feature_flag(:issue_fields_report_usage)

puts "Issues Fields are setup!"
