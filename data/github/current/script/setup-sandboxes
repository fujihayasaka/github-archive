#!/bin/bash
# Enable all feature flags required for Sandbox development
set -e

# Required: gates the sandbox TWIRP API routes in dotcom
bin/toggle-feature-flag enable actions_sandboxes_twirp_api

# Required: gates the sandbox REST API endpoints in dotcom
bin/toggle-feature-flag enable actions_sandboxes_api

# Optional: gates the sandbox settings UI
bin/toggle-feature-flag enable actions_sandboxes_ui

# Optional: gates ConfigsD-backed access policy enforcement in launch-deployer
bin/toggle-feature-flag enable actions_sandbox_access_control_enabled

# Optional: gates the "Enabled for all organizations" enterprise policy radio button
bin/toggle-feature-flag enable actions_sandboxes_all_orgs_mode_available
