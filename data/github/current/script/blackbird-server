#!/bin/bash
#/ Usage: blackbird-server
#/
#/ Runs all blackbird services.

set -e

if test -d /workspaces/blackbird; then
  echo "/workspaces/blackbird exists, will start the real blackbird server..."
  if lsof -Pi :4003 -sTCP:LISTEN >/dev/null; then
    echo "Port 4003 is already in use; is an instance of blackbird already running?"
    sleep infinity
  else
    cd /workspaces/blackbird && cargo run --bin blackbird-local -- serve --listen 0.0.0.0:4003
  fi
else
  echo "/workspaces/blackbird not found, sleeping indefinitely..."
  sleep infinity
fi
