#!/bin/bash

# This is used to generate a Contentful GraphQL schema JSON file. We check this in to version control to avoid needing
# to make a network request on deploys or in CI.
# Usage:
# ./script/site/generate_contentful_schema
# It will prompt you for the Contentful space name and the method call to fetch data from that space.
read -p "Enter the name of the Contentful space (e.g., marketing): " SPACE_NAME

{
  rails runner """
    path = Site::Contentful::GraphQL::ClientBuilder.new(space: :$SPACE_NAME).dump_schema
    puts \"Schema dumped to: #{path}\"
  """
  echo "Schema JSON file generated successfully."
} || {
  echo "An error occurred while generating the JSON file."
}
