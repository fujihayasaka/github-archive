#!/bin/bash
set -e

# This script sets up the github/copilot-code-review-agent repository for a github/github codespace.

RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
NC='\033[0m' # No Color
SCRIPT_DIR="$(dirname "$0")"

# Function to print help message
help() {
   echo "Sets up the github/copilot-code-review-agent repository for a github/github codespace."
   echo ""
   echo "If Copilot API hasn't been set up in your codespace, or Copilot Chat hasn't been turned on,"
   echo "this will be done automatically."
   echo
   echo "Usage: setup-codespaces-copilot-code-review-agent [-b branch] [-w|d|h] "
   echo "Options:"
   echo "-b     Specify the copilot-code-review-agent branch to clone. Defaults to main if not provided."
   echo "-d     Before starting, delete the existing copilot-code-review-agent directory in the codespace."
   echo "-w     Add the copilot-code-review-agent repo as a workspace in VS Code."
   echo "-h     Print this help message."
   echo
}

# Set the branch as main. If a branch is provided as an argument, it will be set to that when we parse the provided options.
BRANCH=main

# Get the options
while getopts ":b:hdw" opt; do
   case $opt in
      h) # display help message
         help
         exit;;
      b) # If a branch was provided, re-set the variable
         BRANCH=$OPTARG;;
      d) # Delete the repository if it exists
         DELETE_REPO=true;;
      w) # Add the repository as a workspace in VS Code
         ADD_TO_WORKSPACE=true;;
     :)
      echo "Error: Option -$OPTARG requires an argument."
      exit 1;;
     \?) # Invalid option
         echo "Error: Invalid option -$OPTARG"
         exit 1;;
   esac
done

echo -e "\n${GREEN}➡️ Checking if copilot-api has been set up...\n${NC}"

# If the /workspaces/copilot-api directory doesn't exist, run the script to set up Copilot API
if [[ ! -d "/workspaces/copilot-api" ]]; then
  echo -e "${ORANGE}It appears that copilot-api has not been set up yet. Running script/setup-codespaces-copilot-api...${NC}"
  ./$SCRIPT_DIR/setup-codespaces-copilot-api
fi

# If the copilot-code-review-agent repo already exists and the delete argument hasn't been specified, echo a warning and exit.
if [[ -d "/workspaces/copilot-code-review-agent" && -z "$DELETE_REPO" ]]; then
  echo -e "${RED}The copilot-code-review-agent directory already exists in this codespace.${NC} \nYou can rerun the setup script with the -d argument to force the deletion of the existing repository."
  exit 1
fi

if [ "$DELETE_REPO" = true ]; then
  echo -e "\n${GREEN}➡️ Deleting the existing copilot-code-review-agent repo...\n${NC}"
  rm -rf /workspaces/copilot-code-review-agent
fi

# Do a shallow clone of copilot-code-review-agent to the same dir as the github/github repo.
# If a branch was supplied, use that branch for the clone.
echo -e "\n${GREEN}➡️ Cloning copilot-code-review-agent repo branch $BRANCH...\n${NC}"
git clone https://github.com/github/copilot-code-review-agent /workspaces/copilot-code-review-agent --branch $BRANCH

# Add the copilot-code-review-agent repo as a workspace in VS Code
if [ "$ADD_TO_WORKSPACE" = true ]; then
   echo -e "\n${GREEN}➡️ Adding copilot-code-review-agent to VS Code workspace...\n${NC}"
   code --add /workspaces/copilot-code-review-agent
fi

echo -e ""
echo -e "${GREEN}🎉🎉 FINISHED! The copilot-code-review-agent repo has been set up! 🎉🎉"
echo -e ""
