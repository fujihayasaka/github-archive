#!/usr/bin/env ruby
# frozen_string_literal: true

# ELM Schema Validator
# Detects data drift between database schema and ELM import API protobuf definitions
# Used in CI to catch schema compatibility issues before they reach production
#
# This validator loads the Rails environment and compares actual model definitions
# with the imported protobuf message structures to detect breaking changes.

require "pathname"
require "set"
require "yaml"

class ElmSchemaValidator
  attr_accessor :errors, :warnings

  def initialize(quiet: false, strict: false)
    @workspace_root = Pathname.new(__dir__).parent.parent  # Go up two levels from script/elm to workspace root
    @errors = []
    @warnings = []
    @quiet = quiet
    @strict = strict  # When true, ignore all suppression configurations
    @config = load_configuration
    @skipped_known_gaps = 0
    @skipped_missing_fields = 0
    @skipped_dag_fields = 0
  end

  def validate!
    log "🔍 ELM Schema Validator: validating protobuf ↔ database schema alignment"

    # Load Rails environment to access models
    load_rails_environment

    # Check for ELM import and export APIs
    import_apis = find_elm_import_apis
    export_apis = find_elm_export_apis

    if import_apis.empty? && export_apis.empty?
      @errors << "validator: No ELM APIs found - this indicates a configuration issue with gem loading or search patterns"
      return report_validation_results
    end

    log "📁 Found #{import_apis.length} import APIs, #{export_apis.length} export APIs"
    log ""

    # Validate each import API against database schema (existing functionality)
    import_apis.each do |api_info|
      validate_api_against_database(api_info)
    end

    # Validate each export API against database schema (same as import validation)
    export_apis.each do |api_info|
      validate_export_api_against_database(api_info)
    end

    # Validate export → import flow compatibility
    validate_export_import_compatibility(export_apis, import_apis)

    # Validate that all discovered API types have model mappings
    validate_model_mappings(import_apis + export_apis)

    # Report results
    report_validation_results
  end

  private

  def log(message)
    puts message unless @quiet
  end

  def load_rails_environment
    log "=> Loading Rails environment..."
    require_relative "../../config/environment"

    # Load ELM gem modules
    Gem::Specification.each do |spec|
      require spec.name if spec.name.start_with?("monolith-twirp-elm-")
    end
  rescue => e
    @errors << "Failed to load Rails environment: #{e.message}"
  end

  def find_elm_import_apis
    import_apis = []

    # Find ELM import API protobuf files
    elm_import_pattern = @workspace_root / "vendor" / "gems" / "**" / "monolith-twirp-elm-*" / "lib" / "**" / "import_*_api_pb.rb"

    # Use a Set to avoid duplicates
    found_files = Set.new

    Dir.glob(elm_import_pattern.to_s).each do |file|
      relative_path = Pathname.new(file).relative_path_from(@workspace_root)
      filename = relative_path.basename.to_s      # Skip if we've already seen this filename (avoid duplicates from different gem versions)
      next if found_files.include?(filename)
      found_files.add(filename)

      # Extract API type from filename (e.g., "import_commit_status_check_api_pb.rb" -> "commit_status_check")
      if filename =~ /import_(.+)_api_pb\.rb$/
        api_type = $1
        import_apis << {
          path: relative_path,
          filename: filename,
          api_type: api_type,
          full_path: file
        }
      end
    end

    import_apis
  end

  def find_elm_export_apis
    export_apis = []

    # Find ELM export API protobuf files in the same gem structure as imports
    elm_export_pattern = @workspace_root / "vendor" / "gems" / "**" / "monolith-twirp-elm-*" / "lib" / "**" / "export_*_api_pb.rb"

    # Use a Set to avoid duplicates
    found_files = Set.new

    Dir.glob(elm_export_pattern.to_s).each do |file|
      relative_path = Pathname.new(file).relative_path_from(@workspace_root)
      filename = relative_path.basename.to_s

      # Skip if we've already seen this filename (avoid duplicates from different gem versions)
      next if found_files.include?(filename)
      found_files.add(filename)

      # Extract API type from filename (e.g., "export_commit_status_check_api_pb.rb" -> "commit_status_check")
      if filename =~ /export_(.+)_api_pb\.rb$/
        api_type = $1
        export_apis << {
          path: relative_path,
          filename: filename,
          api_type: api_type,
          full_path: file
        }
      end
    end

    export_apis
  end

  def validate_api_against_database(api_info)
    # Load the protobuf file to understand the expected structure
    content = File.read(api_info[:full_path])

    # Extract protobuf message definitions
    import_fields = extract_import_message_fields(content, api_info[:api_type], api_info)

    if import_fields.empty?
      @warnings << "#{api_info[:filename]}: Could not extract import message fields"
      return
    end

    # Map API type to ActiveRecord model
    model_class = map_api_type_to_model(api_info[:api_type])

    if model_class.nil?
      @warnings << "#{api_info[:filename]}: Skipping validation - no corresponding ActiveRecord model found for '#{api_info[:api_type]}' (will be reported in model mapping validation)"
      return
    end

    log "� #{api_info[:api_type]} (import) → #{model_class.name}"
    validate_model_field_compatibility(api_info, model_class, import_fields)
  end

  def validate_export_api_against_database(api_info)
    # Load the protobuf file to understand the expected structure
    content = File.read(api_info[:full_path])

    # Extract protobuf message definitions (using export version)
    export_fields = extract_export_message_fields(content, api_info[:api_type], api_info)

    if export_fields.empty?
      @warnings << "#{api_info[:filename]}: Could not extract export message fields"
      return
    end

    # Map API type to ActiveRecord model (same as import)
    model_class = map_api_type_to_model(api_info[:api_type])

    if model_class.nil?
      @warnings << "#{api_info[:filename]}: Skipping validation - no corresponding ActiveRecord model found for '#{api_info[:api_type]}' (will be reported in model mapping validation)"
      return
    end

    log "� #{api_info[:api_type]} (export) → #{model_class.name}"
    validate_model_field_compatibility(api_info, model_class, export_fields)
  end

  def extract_import_message_fields(content, api_type, api_info = nil)
    fields = []

    # Generate both singular and plural message names from the API type using proper inflection
    api_base = api_type.split("_").map(&:capitalize).join("")
    singular_message_name = api_base.singularize
    plural_message_name = api_base.pluralize

    # Try both singular and plural patterns without preference
    patterns = [
      /add_message "elm\.\w+\.v\d+\.Import#{singular_message_name}" do(.*?)end/m,
      /add_message "elm\.\w+\.v\d+\.Import#{plural_message_name}" do(.*?)end/m
    ]

    patterns.each do |pattern|
      match = content.match(pattern)
      if match
        message_body = match[1]
        # Extract field definitions: optional :field_name, :type, number
        field_matches = message_body.scan(/optional\s+:(\w+),\s+:\w+,\s+\d+/)
        fields.concat(field_matches.flatten)
        # Also extract repeated fields: repeated :field_name, :type, number
        repeated_matches = message_body.scan(/repeated\s+:(\w+),\s+:\w+,\s+\d+/)
        fields.concat(repeated_matches.flatten)
        break # Found a match, no need to try other patterns
      end
    end

    # If no specific patterns matched, try a generic fallback
    if fields.empty?
      generic_pattern = /add_message.*Import.*#{api_type.gsub('_', '.*')}.*do(.*?)end/mi
      generic_match = content.match(generic_pattern)

      if generic_match
        message_body = generic_match[1]
        field_matches = message_body.scan(/(?:optional|repeated)\s+:(\w+),/)
        fields = field_matches.flatten.map(&:to_s)
      else
        filename = api_info ? api_info[:filename] : "unknown_file"
        @warnings << "#{filename}: Could not find matching import message pattern for #{api_type}"
      end
    end

    fields.map(&:to_s).uniq
  end

