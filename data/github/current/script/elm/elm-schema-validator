    # If no specific patterns matched, try a generic fallback
    if fields.empty?
      generic_pattern = /add_message.*Export.*#{api_type.gsub('_', '.*')}.*do(.*?)end/mi
      generic_match = content.match(generic_pattern)

      if generic_match
        message_body = generic_match[1]
        field_matches = message_body.scan(/(?:optional|repeated)\s+:(\w+),/)
        fields = field_matches.flatten.map(&:to_s)
