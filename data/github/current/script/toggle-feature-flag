#!/usr/bin/env ruby
# typed: true
# frozen_string_literal: true

require "optparse"
require_relative "./vexi_setup"
require_relative "../lib/feature_flag/vexi"
require_relative "../lib/feature_flag/rollout_preference"

LOG_PREFIX = "=>"
DEBUG_PREFIX = "==>"
MODES = %w[silent normal verbose]
PROXIMA_WARNING = <<~RUBY

WARNING: This utility is not a supported path for enabling/disabling feature flags in production because
         it does not result in synchronization to Proxima stamps. Use the devtools user interface to make
         sure your changes are synchronized.

RUBY
class FeatureFlagToggler
  # Example actor strings shown to the user when we refuse a global toggle.
  # Keyed by the scope symbols used in FeatureFlag::RolloutPreference.
  SCOPE_EXAMPLES = T.let({
    organization: "<org>           # e.g. github",
    repository:   "<org>/<repo>    # e.g. github/github",
    user:         "<user>          # e.g. monalisa",
    business:     "business:<slug> # e.g. business:my-business",
  }.freeze, T::Hash[Symbol, String])

  def initialize(opts = {})
    @options = opts
    @feature_names = opts[:flags].push(opts[:feature_name]).compact
    @action = normalize_action(opts[:action])
    @actor_names = opts[:actor_names]
    @allow_global = opts[:allow_global]
    @features = []

    $stderr.sync = true
  end

  sig { params(action: String).returns(String) }
  def normalize_action(action)
    return "enable" if action == "e"
    return "disable" if action == "d"
    action
  end

  def call
    if @action != "enable" && @action != "disable"
      raise ArgumentError, "Invalid action '#{@action}'. Must be 'enable' or 'disable'"
    end

    if @actor_names.empty?
      guard_rollout_preference! unless @allow_global
      return act_globally
    end

    # Load up rails only if we are executing the command, i.e. we don't need to
    # load rails for the help message.
    safe_warn "Loading rails environment..."
    require File.expand_path("../../config/basic", __FILE__)
    require_relative "../config/environment"

    @actor_names.each do |actor_name|
      actor = if actor_name.start_with?("business:")
        Business.find_by(slug: actor_name.gsub("business:", ""))
      elsif actor_name.start_with?("role:")
        GitHub::FlipperRole::new(actor_name.gsub("role:", ""))
      else
        GitHub::Resources.find_by_uri(actor_name)
      end
      unless actor
        safe_warn "Couldn't find the actor #{actor_name}"
        exit(1)
      end

      @feature_names.each do |feature_name|
        debug("#{@action} #{feature_name} for #{actor_name}")
        case @action
        when "enable"
          FeatureFlag.vexi_management.add_feature_flag_actors(feature_name, [actor])
        when "disable"
          FeatureFlag.vexi_management.remove_feature_flag_actors(feature_name, [actor])
        end
        safe_warn "#{feature_name} #{@action}d for #{actor_name}"
      end
    end
  end

  private def verbose? = @options[:mode] == "verbose"
  private def silent? = @options[:mode] == "silent"

  private def debug(msg)
    puts "#{DEBUG_PREFIX} #{msg}" if verbose?
  end

  private def safe_warn(msg)
    warn "#{LOG_PREFIX} #{msg}" unless silent?
  end

  private def act_globally # think locally ;)
    debug("globally enabling features")
    @feature_names.each do |feature_name|
      case @action
      when "enable"
        FeatureFlag.vexi_management.enable_feature_flag(feature_name)
      when "disable"
        FeatureFlag.vexi_management.disable_feature_flag(feature_name)
      end
      safe_warn "#{feature_name} globally #{@action}d"
    end
    exit(0)
  end

  # Refuse to toggle a flag globally if it's registered in
  # FeatureFlag::RolloutPreference. Prints actor-scoped example commands in the
  # order the scopes were registered (i.e. recommended scope first), then exits.
  private def guard_rollout_preference!
    flagged = @feature_names
      .map { |name| [name, FeatureFlag::RolloutPreference.recommended_scopes(name.to_sym)] }
      .select { |_, scopes| scopes }
    return if flagged.empty?

    flagged.each do |name, scopes|
      $stderr.puts
      $stderr.puts "ERROR: '#{name}' is registered in FeatureFlag::RolloutPreference".yellow
      $stderr.puts "as a flag that should be toggled per-actor, not globally.".yellow
      $stderr.puts
      $stderr.puts "Toggling per-actor catches rollout-only regressions early"
      $stderr.puts "(e.g. an org-scoping bug that's invisible when the flag is fully on)."
      $stderr.puts
      $stderr.puts "Try one of these instead:"
      scopes.each do |scope|
        example = SCOPE_EXAMPLES[scope] or next
        $stderr.puts "  bin/toggle-feature-flag #{@action} #{name} #{example}"
      end
      $stderr.puts
      $stderr.puts "If you really mean to #{@action} this globally, re-run with --global."
    end
    exit(1)
  end
end

class String
  def yellow;         "\e[33m#{self}\e[0m" end
end

# Run as a single process if this script is run directly
if $0 == __FILE__
  options = {
    flags: []
  }

  # If no arguments or passed (`ff`) or the first word is just "help" (`ff help`), print the help text
  ARGV << "--help" if ARGV.empty? || ARGV[0] == "help"

  OptionParser.new do |opts|
    opts.banner = <<~RUBY
Usage: #{$0} e[nable]/d[isable] flag actor(s) [options]

Examples:
bin/toggle-feature-flag enable feature-name monalisa defunkt business:my-business
bin/toggle-feature-flag enable feature-name --mode=verbose
bin/toggle-feature-flag enable feature-name org/repo
bin/toggle-feature-flag disable feature-name monalisa --mode silent -F other_feature -F yet_another

Example with aliases:
ff e some_feature monalisa
ff d some_feature defunkt

Note: Some flags are registered in FeatureFlag::RolloutPreference
(lib/feature_flag/rollout_preference.rb) because they're primarily meaningful per-actor
(e.g. flags rolling out org-by-org). This script will refuse to toggle those
globally unless `--global` is passed.

    RUBY

    opts.on("-F=FLAG", "--flag=FLAG", "Name of a flag to enable/disable") do |v|
      options[:flags] << v
    end

    opts.on("-m=MODE", "--mode=MODE", MODES, "") do |v|
      options[:mode] = v || :normal
    end

    opts.on("--global", "Allow toggling a flag globally even if it's registered in FeatureFlag::RolloutPreference") do
      options[:allow_global] = true
    end

    opts.on("-h", "--help", "Prints this message") do
      puts opts
      puts PROXIMA_WARNING.yellow
      exit
    end
  end.parse!

  action, feature_name, *actor_names = ARGV
  options.merge!(
    feature_name: feature_name,
    action: action,
    actor_names: actor_names,
  )
  puts "#{DEBUG_PREFIX} ARGV: #{ARGV}" if options[:mode] == "verbose"
  puts "#{DEBUG_PREFIX} Options: #{options}" if options[:mode] == "verbose"
  puts "#{PROXIMA_WARNING}".yellow unless options[:mode] == "silent" || (ENV["CODESPACES"] || "false") == "true"
  FeatureFlagToggler.new(options).call
end
