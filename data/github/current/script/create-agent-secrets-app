#!/usr/bin/env safe-ruby
# typed: true
# frozen_string_literal: true

puts "=> Loading the environment..."

require_relative "../config/environment"

unless Rails.env.development?
  puts "=> This script is only intended for development."
  exit 1
end

class CreateAgentSecretsApp
  def call
    if Apps::Privileged.integration(:agent_secrets).present?
      puts "=> The Agent Secrets GitHub app already exists."
    else
      puts "=> Creating the Agent Secrets GitHub app..."
      integration = Apps::Privileged::AgentSecrets.seed_database!
      create_dot_env_file(integration)
    end
  end

  private

  def create_dot_env_file(integration)
    File.open(dotenv_path, "w") do |file|
      file.puts "AGENT_SECRETS_APP_NEXT_GLOBAL_ID=\"#{integration.next_global_id}\""
    end
  end

  def dotenv_path
    dotenv_path = "tmp/agent-secrets.env.local"

    puts "Saving Agent Secrets envvars to `#{dotenv_path}`"
    dotenv_path
  end
end

if __FILE__ == $0
  CreateAgentSecretsApp.new.call
  puts "=> Done!"
end
