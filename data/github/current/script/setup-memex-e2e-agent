#!/bin/bash
# Setup script for Memex end-to-end Copilot Coding Agent testing
#
# This script sets up a github/github codespace with all components needed
# to test the Copilot coding agent (assign Copilot to an issue → agent works → PR created).
#
# Prerequisites:
#   - github/github codespace with the Coding Agent devcontainer (32-core, 256GB)
#   - 1Password CLI available (set up automatically by setup-codespaces-copilot-swe-agent-v2)
#
# Services started:
#   1. Copilot API (CAPI) on port 2206
#   2. github/github (Rails + React) on port 3000
#   3. sweagentd on ports 2208 (http) + 2209 (twirp)
#   4. Elasticsearch on port 9400 (already running from devcontainer)
#
# Usage:
#   script/setup-memex-e2e-agent          # Full setup + start services
#   script/setup-memex-e2e-agent --setup  # Setup only (configure DB, flags, ES)
#   script/setup-memex-e2e-agent --start  # Start services only (assumes setup done)

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

GITHUB_DIR="/workspaces/github"
CAPI_DIR="/workspaces/copilot-api"
SWEAGENTD_DIR="/workspaces/sweagentd"
MC_DIR="/workspaces/copilot-mission-control"

# --- Utility functions ---

log_step() {
  echo -e "\n${BLUE}➡️  $1${NC}"
}

log_success() {
  echo -e "${GREEN}✅ $1${NC}"
}

log_warn() {
  echo -e "${YELLOW}⚠️  $1${NC}"
}

log_error() {
  echo -e "${RED}❌ $1${NC}"
}

wait_for_port() {
  local port=$1
  local name=$2
  local timeout=${3:-120}
  local elapsed=0

  echo -n "   Waiting for $name (port $port)..."
  while ! lsof -Pi ":$port" -sTCP:LISTEN -t >/dev/null 2>&1; do
    sleep 2
    elapsed=$((elapsed + 2))
    if [ "$elapsed" -ge "$timeout" ]; then
      echo ""
      log_error "$name did not start within ${timeout}s"
      return 1
    fi
    echo -n "."
  done
  echo ""
  log_success "$name is ready"
}

wait_for_url() {
  local url=$1
  local name=$2
  local timeout=${3:-120}
  local elapsed=0

  echo -n "   Waiting for $name ($url)..."
  while ! curl -sf "$url" >/dev/null 2>&1; do
    sleep 2
    elapsed=$((elapsed + 2))
    if [ "$elapsed" -ge "$timeout" ]; then
      echo ""
      log_error "$name did not respond within ${timeout}s"
      return 1
    fi
    echo -n "."
  done
  echo ""
  log_success "$name is ready"
}

is_port_listening() {
  lsof -Pi ":$1" -sTCP:LISTEN -t >/dev/null 2>&1
}

# Verify a CAPI-compatible server is responding on port 2206.
verify_capi_health() {
  local status
  status=$(curl -sf -o /dev/null -w "%{http_code}" "http://localhost:2206/models" 2>/dev/null || echo "000")
  if [ "$status" = "200" ]; then
    log_success "CAPI health check passed (GET /models → $status)"
    return 0
  else
    log_error "CAPI health check failed (GET /models → $status)"
    return 1
  fi
}

# --- Parse arguments ---

MODE="all"
if [ "${1:-}" = "--setup" ]; then
  MODE="setup"
elif [ "${1:-}" = "--start" ]; then
  MODE="start"
fi

# =============================================================================
# PHASE 1: SETUP (configure database, feature flags, Elasticsearch)
# =============================================================================

run_setup() {
  log_step "Phase 1: Setup & Configuration"

  # --- 1a. Ensure github/github server is running (needed for setup scripts) ---
  log_step "Ensuring github/github server is running"
  if is_port_listening 3000; then
    log_success "Rails server already running"
  else
    log_step "Starting Rails server (daemonized, with local github-ui)"
    cd "$GITHUB_DIR"
    script/dx/server-start --ui
    wait_for_port 3000 "Rails web server" 180
  fi

  # --- 1b. Run the SWE agent setup (seeds app, policies, flags, clones sweagentd) ---
  # NOTE: This calls enable-copilot-chat → toggle-global-flags --enable which
  # mirrors ALL production global flags locally. Any flag overrides below MUST
  # come AFTER this step to avoid being overwritten by production state.
  log_step "Running Copilot SWE Agent setup (this takes a few minutes)"
  cd "$GITHUB_DIR"
  script/setup-codespaces-copilot-swe-agent-v2 --capi

  # --- 1c. Setup Elasticsearch (inference endpoint) ---
  log_step "Setting up Elasticsearch (inference endpoint + Kibana)"
  cd "$GITHUB_DIR"
  script/elasticsearch/dev-setup

  # --- 1d. Setup Memex feature flags ---
  log_step "Enabling Memex feature flags"
  cd "$GITHUB_DIR"
  script/setup-memex

  # ==========================================================================
  # IMPORTANT: All flag overrides below MUST come AFTER step 1b.
  # The SWE agent setup mirrors production flags, which can re-enable flags
  # that break local development (e.g. copilot_mission_control_service_proxy).
  # Every flag set below intentionally overrides production state.
  # ==========================================================================

  # --- 1e. Fix Copilot agent routing flags ---
  # The code in issues/domain/copilot.rb uses issue_cca_visualization to decide
  # between create_task (mission control tasks API) and create_swe_agent_job.
  # Enable issue_cca_visualization so we consistently use the tasks API path,
  # which is what CAPI's real server expects.
  log_step "Configuring Copilot agent routing flags"
  cd "$GITHUB_DIR"
  bin/toggle-feature-flag disable issues_copilot_use_twirp_api
  bin/toggle-feature-flag enable issue_cca_visualization                         # Routes to create_task API

  # Enable Hydro-based PR→issue close reference linking.
  # Without this, agent PRs won't be linked back to the source issue.
  bin/toggle-feature-flag enable copilot_swe_agent_close_reference

  # --- 1f. Enable Projects Agent experience flags ---
  log_step "Enabling Projects Agent experience flags"
  cd "$GITHUB_DIR"
  bin/toggle-feature-flag enable memex_agent_tasks              # Agent Tasks as memex project item type
  bin/toggle-feature-flag enable projects_copilot_tasks_status  # Copilot task status in projects
  bin/toggle-feature-flag enable memex_multi_agent_assignments  # Multi-agent assignments in project assignee field

  # --- 1g. Additional flags from e2e guide ---
  log_step "Configuring additional development flags"
  cd "$GITHUB_DIR"
  bin/toggle-feature-flag disable copilot_api_combined_usage_store 2>/dev/null || true
  bin/toggle-feature-flag enable copilot_swe_agent_skip_agent_job_concurrency_limit 2>/dev/null || true

  # --- 1h. Disable flags that break local dev when mirrored from production ---
  # copilot_mission_control_service_proxy proxies to real mission control (not running locally)
  log_step "Disabling flags that break local development"
  cd "$GITHUB_DIR"
  bin/toggle-feature-flag disable copilot_mission_control_service_proxy 2>/dev/null || true

  # --- 1i. Restart background workers to pick up flag changes (after all flag changes) ---
  log_step "Restarting background workers (resqued)"
  cd "$GITHUB_DIR"
  overmind restart resqued
  sleep 5
  log_success "Workers restarted"

  # --- 1j. Stop the server (will be restarted in Phase 2) ---
  if [ "$MODE" = "all" ]; then
    log_step "Stopping github/github server (will restart in Phase 2)"
    cd "$GITHUB_DIR"
    script/dx/server-stop 2>/dev/null || true
    sleep 3
  fi

  log_success "Setup complete!"
  echo ""
}

# =============================================================================
# PHASE 2: START SERVICES (in dependency order)
# =============================================================================

run_start() {
  log_step "Phase 2: Starting Services"
  echo ""
  echo "   Services will start in separate terminals."
  echo "   Order: CAPI → github/github → sweagentd"
  echo ""

  # --- 2a. Stop fauxpilot (conflicts with real CAPI) ---
  log_step "Stopping fauxpilot API server (if running)"
  if is_port_listening 2206; then
    lsof -t -i:2206 2>/dev/null | xargs -r kill -15 2>/dev/null || true
    sleep 2
    lsof -t -i:2206 2>/dev/null | xargs -r kill -9 2>/dev/null || true
    sleep 1
  fi
  if [ -f "$CAPI_DIR/script/manage-overmind-capi" ]; then
    cd "$CAPI_DIR"
    script/manage-overmind-capi stop 2>/dev/null || true
  fi
  # Also stop the overmind copilot-api process (fauxpilot) which auto-starts
  cd "$GITHUB_DIR"
  overmind stop copilot-api 2>/dev/null || true

  # --- 2b. Start CAPI ---
  # 1Password was already set up during Phase 1 (setup-codespaces-copilot-swe-agent-v2).
  # CAPI's script/server re-authenticates using ONEP_PASSWORD from the environment.
  log_step "Starting Copilot API (CAPI) in background terminal"
  if is_port_listening 2206; then
    log_warn "CAPI already running on port 2206"
  else
    cd "$CAPI_DIR"
    nohup script/server > /tmp/capi.log 2>&1 &
    wait_for_port 2206 "CAPI" 120
  fi

  # --- 2b2. Verify CAPI is healthy ---
  log_step "Verifying CAPI health"
  sleep 3
  if ! verify_capi_health; then
    log_warn "CAPI on port 2206 is not responding — check /tmp/capi.log"
  fi

  # --- 2c. Start github/github ---
  log_step "Starting github/github"
  if is_port_listening 3000; then
    log_warn "github/github already running on port 3000"
  else
    cd "$GITHUB_DIR"
    script/dx/server-start --ui
    wait_for_port 3000 "github/github" 180
  fi

  # --- 2d. Restart resqued (fresh workers with all services up) ---
  log_step "Restarting background workers"
  cd "$GITHUB_DIR"
  overmind restart resqued
  sleep 3

  # --- 2e. Start sweagentd ---
  log_step "Starting sweagentd"
  if is_port_listening 2209; then
    log_warn "sweagentd already running on port 2209"
  else
    cd "$SWEAGENTD_DIR"
    nohup script/server > /tmp/sweagentd.log 2>&1 &
    wait_for_port 2209 "sweagentd (twirp)" 120
  fi

  # --- 2f. Start Mission Control (optional) ---
  if [ -d "$MC_DIR" ]; then
    log_step "Starting Copilot Mission Control"
    cd "$MC_DIR"
    nohup make run > /tmp/mission-control.log 2>&1 &
    sleep 5
    log_success "Mission Control started"
  fi

  echo ""
  log_success "All services are running!"
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "  Services:"
  echo "    GitHub:     http://github.localhost  (port 3000)"
  echo "    CAPI:       http://localhost:2206"
  echo "    sweagentd:  http://localhost:2208 (http) / :2209 (twirp)"
  echo ""
  echo "  Logs:"
  echo "    CAPI:           tail -f /tmp/capi.log"
  echo "    sweagentd:      tail -f /tmp/sweagentd.log"
  echo "    github/github:  cd $GITHUB_DIR && script/dx/server-logs"
  if [ -d "$MC_DIR" ]; then
    echo "    Mission Ctrl:   tail -f /tmp/mission-control.log"
  fi
  echo ""
  echo "  Test:"
  echo "    1. Go to http://github.localhost/github/private-server/issues/new"
  echo "    2. Create an issue (e.g. 'Add a hello.py that prints Hello World')"
  echo "    3. Assign 'copilot-swe-agent[bot]' to the issue"
  echo "    4. Watch for 👀 reaction and a PR being created"
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

# =============================================================================
# MAIN
# =============================================================================

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Memex E2E Agent Setup"
echo "  Mode: $MODE"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

case "$MODE" in
  setup)
    run_setup
    echo ""
    echo "Setup complete. Run with --start to start services."
    ;;
  start)
    run_start
    ;;
  all)
    run_setup
    run_start
    ;;
esac
