#!/bin/bash

cleanup() {
  kill $(jobs -p) 2>/dev/null
  wait
}

trap cleanup SIGTERM SIGINT

if [[ "$PROJECTS" = true || "$PROJECTS" = 1 ]]; then
  echo "Starting Projects processors..."
  echo "Run \`overmind connect projects\` to view logs."
  bin/projects-denormalization-processor &
  bin/projects-denormalization-processor-column-changes &
  bin/projects-denormalization-processor-content-changes-issue &
  bin/projects-denormalization-processor-content-changes-pull-request &
  bin/projects-denormalization-processor-low-priority &
  bin/memex-events-processor &
  bin/memex-live-updates-processor &
  bin/sub-issue-list-recalculation-processor &
  bin/issue-project-events-processor &
  wait
else
  echo "Projects processors disabled. Run with PROJECTS=1 to enable."
  sleep infinity
fi
