#!/bin/bash

if [[ "$UI" = true || "$UI" = 1 ]]; then
  if ! cd ../github-ui; then
    echo "ERROR: ../github-ui not found. Please ensure github-ui is cloned next to this repo." >&2
    exit 1
  fi
  exec script/serve-js-assets
else
  echo "Ignoring JS UI assets since UI=1 is not set"
  sleep infinity
  exit 0
fi
