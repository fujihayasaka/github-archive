#!/bin/bash

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
GITHUB_ROOT="${SCRIPT_DIR}/.."

source $SCRIPT_DIR/dx/lib/subproject-containers

# Note: If this directory doesn't exist or is empty, run `./script/build-subproject configsd`
CONFIGSD_VENDOR_PATH="${GITHUB_ROOT}/vendor/configsd"
CONFIGSD_BIN="${CONFIGSD_VENDOR_PATH}/bin/server"

if [ ! -d "$CONFIGSD_VENDOR_PATH" ]; then
    echo "Directory $CONFIGSD_VENDOR_PATH does not exist, you need to clone configsd"
    exit 1
fi

export GITHUB_TELEMETRY_LOGS_LEVEL=debug
export APP_HMAC_KEY_PRIMARY="primary_secret_key"
export APP_HMAC_KEY_SECONDARY="secondary_secret_key"
export CONFIGURATIONS_DB_RO_PASS=${CONFIGURATIONS_DB_RO_PASS:-""}
export CONFIGURATIONS_DB_RO_USER=${CONFIGURATIONS_DB_RO_USER:-"root"}
export CONFIGURATIONS_DB_HOST_WITH_PORT=${CONFIGURATIONS_DB_HOST_WITH_PORT:-"127.0.0.1"}
export CONFIGURATIONS_DB_TLS_CONFIG="false"

# notably not test env so that configsd does not load .env files
export RUNTIME_ENV="DOTCOM_CI"

# use different ports in test and dev to allow two instances of the server running at the same time
DEFAULT_APP_PORT="1344"

# decides which database to use: dev or test
case "$1" in
  --test)
    echo "configsd will use dotcom test databases"
    export CONFIGURATIONS_DB_NAME=${CONFIGURATIONS_DB_NAME:-"github_test_configurations"}
    DEFAULT_APP_PORT="3674"

    shift ;;
  *)
    echo "configsd will use dotcom development databases"
    export CONFIGURATIONS_DB_NAME=${CONFIGURATIONS_DB_NAME:-"github_development_configurations"}
esac

export APP_PORT=${APP_PORT:-$DEFAULT_APP_PORT}

# Environment variables to pass to the container
env_vars=(
  GITHUB_TELEMETRY_LOGS_LEVEL
  APP_HMAC_KEY_PRIMARY
  APP_HMAC_KEY_SECONDARY
  APP_PORT
  RUNTIME_ENV
  CONFIGURATIONS_DB_NAME
  CONFIGURATIONS_DB_RO_PASS
  CONFIGURATIONS_DB_RO_USER
  CONFIGURATIONS_DB_HOST_WITH_PORT
)

# Write environment variables to a temporary file to be used by the container
ENV_FILE=$(mktemp)

for var in "${env_vars[@]}"; do
  if [ "${!var+x}" ]; then
    echo "$var=${!var}" >> "$ENV_FILE"
  fi
done

start_configsd() {
  cd "$CONFIGSD_VENDOR_PATH" || exit 1

  # Build if binary doesn't exist
  if [ ! -f "$CONFIGSD_BIN" ]; then
    echo "No configsd binary found at $CONFIGSD_BIN, building..."
    make build || exit 1
  fi

  source "${CONFIGSD_VENDOR_PATH}/script/setup-env"
  exec "$CONFIGSD_BIN"
}

start_configsd_docker() {
  # Run the service as a container using an image published via GitHub Actions for PRs or merges to main
  # Images can be found at https://github.com/github/configsd/pkgs/container/configsd%2Fdev
  # The commit sha is defined in /config/configsd-version
  SUBPROJECT_VERSION=$(subproject_version "configsd")
  CONTAINER_NAME="configsd-${APP_PORT}"

  start_subproject --name=$CONTAINER_NAME \
    --entrypoint /app/bin/server \
    --env-file "$ENV_FILE" \
    --volume $(pwd)/tmp/$CONTAINER_NAME:/tmp/ \
    "ghcr.io/github/configsd/dev:$SUBPROJECT_VERSION"
}

if [[ "$DX_EDGE" = true ]] && [[ "$DX_FEATURE_SUBPROJECT_CONTAINERS" = true ]]; then
  start_configsd_docker
elif [ "$GITHUB_CI" = "1" ] || [ "$GITHUB_USE_DOCKER" = "1" ]; then
  if [[ "$DX_FEATURE_SUBPROJECT_CONTAINERS" = true ]]; then
    start_configsd_docker
  else
    start_configsd
  fi
else
  if [ ! -x "${CONFIGSD_BIN}" ]; then
  cat << EOF
The configsd server is not built and could not be started, this could lead to:
 - requests not working as expected in dotcom
 - some tests will fail

In order to address the above problems:
 - install and start docker - this only used to build configsd, can be stopped afterwards
 - build configsd: run script/build-subproject configsd
 - test configsd works: run script/configsd-server to check the server is working as expected. If you see a long log message and you don't see this message anymore, then you are done!

This script will block indefinitely in order to avoid breaking bin/server

If you keep seeing this message, please contact #configsd
EOF
  fi
  until [ -x "${CONFIGSD_BIN}" ]; do sleep 60; done
  start_configsd
fi
