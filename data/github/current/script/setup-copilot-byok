#!/usr/bin/env safe-ruby
# frozen_string_literal: true

puts "=> Loading the environment..."

require_relative "#{Rails.root}/config/environment"
require_relative "#{Rails.root}/script/seeds/objects"
require_relative "#{Rails.root}/script/seeds/runner"
require_relative "#{Rails.root}/script/seeds/runners/copilot_byok"

unless Rails.env.development?
  raise "This is a dev-only script"
end

class SetupCopilotByok
  def call
    puts "============================================================"
    puts "Starting Copilot BYOK (Bring Your Own Key) setup"
    puts "============================================================\n\n"

    run_seeds

    puts "\n\nCopilot BYOK setup completed. 🎉 Go forth and build cool things!"
  end

  private

  def run_seeds
    puts "Running seeds..."
    Seeds::Runner::CopilotByok.execute
  end
end

SetupCopilotByok.new.call
