  # ============================================
  # Helper Methods
  # ============================================

  def human_readable_org_name(org_login)
    HUMAN_READABLE_ORG_NAMES.fetch(org_login)
  end

  def human_readable_business_name(business_slug)
    HUMAN_READABLE_BUSINESS_NAMES.fetch(business_slug)
  end

  def ensure_organization_profile_name(organization, profile_name)
    return if organization.nil?
    return if organization.profile_name == profile_name

    organization.profile_name = profile_name
    organization.save!
    log("  -> Organization name: #{profile_name}")
  end

  def ensure_business_name(business, name)
    return if business.name == name

    business.update!(name: name)
    log("  -> Enterprise name: #{name}")
  end

  def ensure_recent_copilot_cli_access_for_team_org(organization:, admin:, member_login:, copilot_cli:)
    return if member_login.nil?

    member = find_or_create_user(member_login)
    organization.add_member(member, adder: admin)
    log("  -> Member: #{user_style(member.login)}")
    return unless copilot_cli

    enable_copilot_business_for_standalone_org(organization)
    copilot_org = Copilot::Organization.new(organization)
    Copilot::Policies::Cli.update_org(copilot_org, "disabled", send_email: false) if copilot_org.cli_enabled?
    Copilot::Policies::Cli.update_org(copilot_org, "enabled", send_email: false)
    log("  -> Copilot CLI access: enabled")
  end

  def ensure_recent_copilot_cli_access_for_enterprise_org(business:, organization:, owner:, member_login:, copilot_cli:)
    return if member_login.nil?

    member = find_or_create_user(member_login)
    organization.add_member(member, adder: owner)
    log("  -> Member: #{user_style(member.login)}")
    return unless copilot_cli

    enable_copilot_business_for_enterprise(business)
    copilot_business = Copilot::Business.new(business)
    Copilot::Policies::Cli.update_business(copilot_business, "disabled") if copilot_business.cli_enabled?
    Copilot::Policies::Cli.update_business(copilot_business, "enabled")
    log("  -> Copilot CLI access: enabled")
  end

  def find_or_create_user(login)
    user = User.find_by(login: login)
    return user if user

    user = User.create!(
      login: login,
      password: DEFAULT_PASSWORD,
      email: "#{login}@github.test.com",
      require_email_verification: false,
      billing_attempts: 0,
      plan: "medium"
    )
    user.emails.map(&:verify!)
    user
  end

  def enable_copilot_business_for_standalone_org(org)
    # For standalone orgs (free/team without enterprise), enable Copilot
    # Enable the feature flag to allow Copilot for business on free orgs
    Seeds::Objects::FeatureFlag.enable(feature_flag: :copilot_for_business_free, actor: org)

    copilot_org = Copilot::Organization.new(org)
    copilot_org.enable_copilot!
    copilot_org.seat_management_allow_all!
  end

  def enable_copilot_business_for_enterprise(business)
    # For enterprise-linked orgs, enable Copilot at the business level
    copilot_business = Copilot::Business.new(business)
    copilot_business.enable_copilot_for_all_organizations!
  end

  def ensure_enterprise_copilot_disabled(business:, actor: nil)
    copilot_business = Copilot::Business.new(business)
    return if copilot_business.copilot_disabled?

    copilot_business.disable_copilot!(actor)
  end

  def ensure_active_dfd_trial(business:)
    updates = {}
    updates[:dfd_trial] = true unless business.dfd_trial?
    if business.trial_expires_at.nil? || business.trial_expires_at < Time.current
      updates[:trial_expires_at] = TRIAL_REMAINING_DAYS.days.from_now
    end
    business.update!(updates) if updates.any?
  end

  def create_org_repository(org, committer)
    GH::Context.enabled do
      repo_name = "test-repo"

      # Check if repo already exists
      repo = Repository.nwo("#{org.login}/#{repo_name}")
      if repo&.active?
        return repo
      end
      Repository.where(id: repo.id).delete_all if repo

      result = Repository.handle_creation(
        committer,
        org.login,
        {
          name: repo_name,
          description: "Test repository for in-product messaging",
          public: false
        },
        synchronous: true
      )
      repo = result.repository

      unless repo&.persisted?
        raise "Repository not created for #{org.login}: #{result.error_message}"
      end

      repo = wait_for_active_repository(repo.id)
      repo.setup_git_repository

      # Set created_at for repository age
      repo.update_column(:created_at, REPO_AGE_DAYS.days.ago)

      # Create README.md with "Hello World" content
      Seeds::Objects::Commit.create(
        repo: repo,
        message: "Initial commit - add README",
        committer: committer,
        branch_name: repo.default_branch,
        files: { "README.md" => "Hello World" }
      )

      repo
    end
  end

  def create_pull_request(repo, committer)
    GH::Context.enabled do
      repo = wait_for_active_repository(repo.id)

      # Create a branch with a change
      branch_name = "feature-branch"

      Seeds::Objects::Commit.create(
        repo: repo,
        message: "Add feature file",
        committer: committer,
        branch_name: branch_name,
        files: { "feature.md" => "This is a feature file" }
      )

      # Create the pull request
      pr = ::PullRequest.create_for!(
        repo,
        user: committer,
        title: "Add feature",
        body: "This pull request adds a new feature.",
        head: branch_name,
        base: repo.default_branch,
        draft: false
      )

      raise "Pull request not created for #{repo.nwo}" unless pr&.persisted?

      # Set created_at for pull request age
      pr.update_column(:created_at, PULL_REQUEST_AGE_DAYS.days.ago)
      pr.issue.update_column(:created_at, PULL_REQUEST_AGE_DAYS.days.ago) if pr.issue

      pr
    end
  end

  def wait_for_active_repository(repo_id, attempts: 10, delay: 0.2)
    attempts.times do
      repo = Repositories::Public.find_active(repo_id)
      return repo if repo

      sleep(delay)
    end

    raise "Repository #{repo_id} did not become active after creation"
  end

  # ============================================
  # Logging Helpers
  # ============================================

  def bold_white(string)
    LOGGER.info colorize(string, "white", style: :bold)
  end

  def org_style(login)
    colorize(login, "green", style: :underline)
  end

  def user_style(login)
    colorize(login, "cyan", style: :underline)
  end

  def enterprise_style(slug)
    colorize(slug, "red", style: :underline)
  end

  def repo_style(name)
    colorize(name, "magenta")
  end

end

class DestroyInProductMessaging
  include LoggingHelpers
  def call
    yellow("Destroying In-Product Messaging seed data")
    log("")

    destroy_businesses
    destroy_organizations
    destroy_users
    cleanup_reserved_logins

    green("In-Product Messaging seed data destroyed!")
  end

  private

  def destroy_businesses
    title("Destroying Enterprise Accounts")
    ALL_BUSINESS_SLUGS.each do |slug|
      business = Business.find_by(slug: slug)
      if business
        # Delete associated orgs first (they'll be handled by org deletion)
        business.delete
        log("  -> Destroyed: #{slug}")
      else
        log("  -> Not found: #{slug}")
      end
    end
    log("")
  end

  def destroy_organizations
    title("Destroying Organizations")
    ALL_ORG_LOGINS.each do |login|
      org = Organization.find_by(login: login)
      if org
        # Get all repository IDs for this org
        repo_ids = Repository.where(owner_id: org.id).pluck(:id)

        if repo_ids.any?
          # Delete pull requests and issues at the database level
          pr_ids = PullRequest.where(repository_id: repo_ids).pluck(:id)
          if pr_ids.any?
            # Delete issues associated with pull requests
            Issue.where(pull_request_id: pr_ids).delete_all
            # Delete the pull requests themselves
            PullRequest.where(id: pr_ids).delete_all
          end

          # Delete any remaining issues for these repos
          Issue.where(repository_id: repo_ids).delete_all

          # Delete repositories
          Repository.where(id: repo_ids).delete_all
        end

        org.delete
        log("  -> Destroyed: #{login}")
      else
        log("  -> Not found: #{login}")
      end
    end
    log("")
  end

  def destroy_users
    title("Destroying Users")
    ALL_USER_LOGINS.each do |login|
      user = User.find_by(login: login)
      if user
        # Delete any Copilot subscription items for this user
        Billing::SubscriptionItem.for_account(user).delete_all
        # Delete user's emails first, then the user
        UserEmail.where(user_id: user.id).delete_all
        user.delete
        log("  -> Destroyed: #{login}")
      else
        log("  -> Not found: #{login}")
        # Clean up any orphaned emails with this pattern
        UserEmail.where(email: "#{login}@github.test.com").delete_all
      end
    end
    log("")
  end

  def cleanup_reserved_logins
    title("Cleaning up Reserved Logins")
    all_logins = ALL_ORG_LOGINS + ALL_USER_LOGINS + ALL_BUSINESS_SLUGS
    count = ReservedLogin.where(login: all_logins).delete_all
    log("  -> Removed #{count} reserved logins")
    log("")
  end
end

$stdout.reopen(File.new("/dev/null", "w")) # ONLY LOGGER EXISTS!
$VERBOSE = nil

if ARGV.include?("--destroy")
  DestroyInProductMessaging.new.call
else
  SetupInProductMessaging.new.call
end
