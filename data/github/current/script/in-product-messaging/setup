  # ============================================
  # Helper Methods
  # ============================================

  def human_readable_org_name(org_login)
    HUMAN_READABLE_ORG_NAMES.fetch(org_login)
  end

  def human_readable_business_name(business_slug)
    HUMAN_READABLE_BUSINESS_NAMES.fetch(business_slug)
  end

  def ensure_organization_display_name(organization, display_name)
    return if organization.nil?
    return if organization.display_name == display_name

    organization.update!(display_name: display_name)
    log("  -> Organization name: #{display_name}")
  end

  def ensure_business_name(business, name)
    return if business.name == name

    business.update!(name: name)
    log("  -> Enterprise name: #{name}")
  end

  def ensure_recent_copilot_cli_access_for_team_org(organization:, admin:, member_login:, copilot_cli:)
    return if member_login.nil?

    member = find_or_create_user(member_login)
    organization.add_member(member, adder: admin)
    log("  -> Member: #{user_style(member.login)}")

    # Explicitly create a Copilot seat for the member.
    # In production, the OrganizationMemberJob creates seats asynchronously
    # when a member is added to an "allow all" org, but that job doesn't
    # run during script execution. Both the NUCBS and CLI dashboard nudges
    # require a Copilot::Seat record to exist.
    ensure_copilot_seat_for_member(organization: organization, member: member)

    # For CCA-onboarding-modal QA accounts only, refresh seat age and clear
    # any prior dismissal so the modal is eligible to render on every setup run.
    refresh_welcome_modal_state(member: member, organization: organization)

    # For dashboard-CLI QA accounts, backdate the Copilot Business seat past
    # the welcome-modal eligibility window so it doesn't obscure the dashboard
    # CLI nudge. CLI access is granted/refreshed below regardless.
    backdate_copilot_business_seat(member: member, organization: organization)

    return unless copilot_cli

    enable_copilot_business_for_standalone_org(organization)
    copilot_org = Copilot::Organization.new(organization)
    Copilot::Policies::Cli.update_org(copilot_org, "disabled", send_email: false) if copilot_org.cli_enabled?
    Copilot::Policies::Cli.update_org(copilot_org, "enabled", send_email: false)
    log("  -> Copilot CLI access: enabled")
  end

  def ensure_recent_copilot_cli_access_for_enterprise_org(business:, organization:, owner:, member_login:, copilot_cli:)
    if member_login
      member = find_or_create_user(member_login)
      organization.add_member(member, adder: owner)
      log("  -> Member: #{user_style(member.login)}")

      # Explicitly create a Copilot seat for the member.
      # In production, the OrganizationMemberJob creates seats asynchronously
      # when a member is added to an "allow all" org, but that job doesn't
      # run during script execution.
      ensure_copilot_seat_for_member(organization: organization, member: member)

      # For CCA-onboarding-modal QA accounts only, refresh seat age and clear
      # any prior dismissal so the modal is eligible to render on every setup run.
      refresh_welcome_modal_state(member: member, organization: organization)
    end

    return unless copilot_cli

    enable_copilot_business_for_enterprise(business)
    copilot_business = Copilot::Business.new(business)
    Copilot::Policies::Cli.update_business(copilot_business, "disabled") if copilot_business.cli_enabled?
    Copilot::Policies::Cli.update_business(copilot_business, "enabled")
    log("  -> Copilot CLI access: enabled")
  end

  def find_or_create_user(login)
    user = User.find_by(login: login)
    return user if user

    user = User.create!(
      login: login,
      password: DEFAULT_PASSWORD,
      email: "#{login}@github.test.com",
      require_email_verification: false,
      billing_attempts: 0,
      plan: "medium"
    )
    user.emails.map(&:verify!)
    user
  end

  # Creates N copies of a user with suffix -0 through -(n-1), inheriting the
  # same access and characteristics. Called after the primary user is created
  # when --multiples is specified. Truncates the base login if needed to stay
  # within GitHub's 39-character username limit.
  MAX_LOGIN_LENGTH = 39

  def create_user_multiples(login:, plan: nil, org: nil, role: :admin, business: nil)
    # Track this user for the end-of-run summary
    @created_users << { login: login, multiples: @multiples }

    return unless @multiples

    yellow("  -> Creating #{@multiples} multiples of #{user_style(login)}")
    @multiples.times do |i|
      suffix = "-#{i}"
      max_base = MAX_LOGIN_LENGTH - suffix.length
      base = login.length > max_base ? login[0, max_base] : login
      clone_login = "#{base}#{suffix}"

      if plan
        create_individual_copilot_user(login: clone_login, plan: plan)
      else
        user = find_or_create_user(clone_login)

        # Add to org with the same role as the primary user
        if org
          organization = Organization.find_by!(login: org)
          unless organization.direct_or_team_member?(user)
            if role == :admin
              organization.add_admin(user)
            else
              organization.add_member(user)
            end
          end
        end

        # Add as enterprise owner
        if business
          biz = Business.find_by!(slug: business)
          biz.add_owner(user, actor: user) unless biz.owner?(user)
        end

        log("    -> Created #{user_style(clone_login)}")
      end
    end
  end

  def enable_copilot_business_for_standalone_org(org)
    # For standalone orgs (free/team without enterprise), enable Copilot
    # Enable the feature flag to allow Copilot for business on free orgs
    Seeds::Objects::FeatureFlag.enable(feature_flag: :copilot_for_business_free, actor: org)

    copilot_org = Copilot::Organization.new(org)
    copilot_org.enable_copilot!
    copilot_org.seat_management_allow_all!
  end

  def enable_copilot_business_for_enterprise(business)
    # For enterprise-linked orgs, enable Copilot at the business level
    copilot_business = Copilot::Business.new(business)
    copilot_business.enable_copilot_for_all_organizations!
  end

  # Enable Copilot Business on a standalone org but in *selected*
  # teams-and-users seat management mode. Used by the raf_cb-with-CB fixture
  # so members can submit a `MemberFeatureRequest` for CopilotForBusiness
  # (the validator forbids requests when the org is in `allow_all` mode and
  # would also fail if the requester already has a seat).
  #
  # Compared with `enable_copilot_business_for_standalone_org`, this skips
  # the `seat_management_allow_all!` step entirely — that step would create
  # an org seat assignment and queue a converter job that we'd then have to
  # mark pending-cancellation by flipping to selected mode.
  def enable_copilot_business_in_selected_mode_for_standalone_org(org)
    Seeds::Objects::FeatureFlag.enable(feature_flag: :copilot_for_business_free, actor: org)

    copilot_org = Copilot::Organization.new(org)
    copilot_org.enable_copilot!
    copilot_org.seat_management_selected_teams_and_users!
  end

  # Seed `MemberFeatureRequest` rows for the
  # `organization_new_tasks_raf_cb_nudge` (issue #262). Idempotent: safe to
  # call on existing-org reruns of setup.
  #
  # Adds `count` member users (login `<org_login>-mem<i>`) to the org and
  # has each submit a request for `Feature::CopilotForBusiness`. Members are
  # *not* assigned Copilot seats (the validator
  # `copilot_seat_enabled_for_member` would otherwise reject the request).
  #
  # `seat_management:` of `:selected` indicates the caller already flipped
  # the org to `seat_management_selected_teams_and_users!` (or has CB
  # disabled), so member-add will not auto-assign seats.
  def create_member_cb_feature_requests(organization:, admin:, count:, seat_management: nil)
    members = (1..count).map do |i|
      member_login = "#{organization.login}-mem#{i}"
      member = find_or_create_user(member_login)
      organization.add_member(member, adder: admin) unless organization.direct_or_team_member?(member)
      member
    end

    members.each do |member|
      next if MemberFeatureRequest.already_requested?(
        member,
        organization,
        MemberFeatureRequest::Feature::CopilotForBusiness,
        organization
      )

      MemberFeatureRequest.create!(
        feature: MemberFeatureRequest::Feature::CopilotForBusiness,
        requester: member,
        request_entity: organization,
        billing_entity: organization
      )
    end

    log("  -> Member CB feature requests: #{count} (seat_management: #{seat_management || :default})")
  end

  # Seed the member-driven "Request a feature" entry points for a Free org so a
  # member (`<org>-mem1`) can reproduce them after a plain setup + login.
  # Idempotent: safe on existing-org reruns.
  #
  # Sets up:
  #   - mem1 as a repo ADMIN on test-repo. This unlocks the custom repository
  #     roles upsell (/{org}/test-repo/settings/access) and lets mem1 view the
  #     branch protection settings page.
  #   - a classic branch protection rule on test-repo's default branch, which
  #     makes the "won't be enforced on this private repository" warning render
  #     on /{org}/test-repo/settings/branches with an "Ask admin for access" CTA.
  #   - an empty repo (`empty-demo`) with mem1 as a WRITE member, which renders
  #     the empty-repo Copilot onboarding prompt ("Ask admin for access").
  #
  # NOTE: Two member request entry points cannot be seeded here and require
  # manual steps (documented in the script header): the Draft PRs upgrade dialog
  # (A3 — needs a temporary config/plans.yml change) and the code-editor Copilot
  # popover (A5 — gated entirely in the github-ui frontend, not reproducible in
  # the monolith dev environment).
  def seed_request_feature_surfaces(organization:, admin:)
    mem1 = User.find_by(login: "#{organization.login}-mem1")
    unless mem1
      log("  -> Request-a-feature surfaces: skipped (no #{organization.login}-mem1)")
      return
    end

    repo = Repository.nwo("#{organization.login}/test-repo")
    if repo
      with_retries do
        GH::Context.enabled do
          if repo.direct_member_ids.include?(mem1.id)
            unless repo.direct_member_ids(min_action: :admin).include?(mem1.id)
              repo.update_member(mem1, action: :admin, actor: admin)
            end
          else
            repo.add_member(mem1, admin, action: :admin)
          end
        end
      end

      Seeds::Objects::ProtectedBranch.create!(repo: repo, creator: admin)
      log("  -> Request-a-feature surfaces: mem1 repo-admin + branch protection on #{repo_style(repo.nwo)}")
    end

    # Empty repo for the empty-repo Copilot onboarding prompt.
    empty_repo = Repository.nwo("#{organization.login}/empty-demo")
    empty_repo ||= with_retries do
      GH::Context.enabled do
        r = Seeds::Objects::Repository.create(
          owner_name: organization.login,
          repo_name: "empty-demo",
          setup_master: false,
          description: "Empty repo for Copilot onboarding prompt (request-a-feature)"
        )
        r.update_column(:created_at, REPO_AGE_DAYS.days.ago)
        r
      end
    end
    with_retries do
      GH::Context.enabled do
        if empty_repo.direct_member_ids.include?(mem1.id)
          unless empty_repo.direct_member_ids(min_action: :write).include?(mem1.id)
            empty_repo.update_member(mem1, action: :write, actor: admin)
          end
        else
          empty_repo.add_member(mem1, admin, action: :write)
        end
      end
    end
    log("  -> Request-a-feature surfaces: empty repo #{repo_style(empty_repo.nwo)} with mem1 write")
  end

  # Seed enterprise-billed Copilot coding-agent member requests so the
  # "member requests" card renders on the AI Controls Agents policies page:
  #   /enterprises/<business_slug>/ai-controls/agents/policies
  # Idempotent: safe on existing-enterprise reruns.
  #
  # The card only renders when (1) the swe_agent policy is DISABLED at the
  # business level (not enabled, not no_policy), and (2) there are pending
  # CopilotCodingAgent requests billed to the enterprise. Such requests are
  # only valid when the requester is an ORG ADMIN (the MemberFeatureRequest
  # validator requires `org.role_of(requester).admin?` for Business-billed
  # requests), so we create `count` org admins and have each submit one.
  def seed_coding_agent_member_requests(business:, organization:, owner:, count:)
    copilot_business = Copilot::Business.new(business)
    copilot_business.swe_agent_disabled! unless copilot_business.swe_agent_disabled?

    admins = (1..count).map do |i|
      admin_login = "#{organization.login}-admin#{i}"
      admin = find_or_create_user(admin_login)
      if organization.direct_or_team_member?(admin)
        organization.update_member(admin, action: :admin, updater: owner) unless organization.role_of(admin).admin?
      else
        organization.add_admin(admin, adder: owner)
      end
      admin
    end

    admins.each do |admin|
      next if MemberFeatureRequest.already_requested?(
        admin,
        organization,
        MemberFeatureRequest::Feature::CopilotCodingAgent,
        business
      )

      MemberFeatureRequest.create!(
        feature: MemberFeatureRequest::Feature::CopilotCodingAgent,
        requester: admin,
        request_entity: organization,
        billing_entity: business
      )
    end

    log("  -> Coding-agent member requests: #{count} (swe_agent disabled, enterprise-billed)")
  end

  # Reset the global dismissal of the raf_cb nudge for the given admin/org.
  # The no-CB raf_cb flow has a one-shot Dismiss control, so without this
  # reset the nudge stops rendering after the first QA dismiss until the
  # org buys CB — which would make every subsequent setup rerun fail to
  # restore the test fixture. Mirrors the welcome-modal dismissal-reset
  # documented in qa/34-cca-modal-dismiss.md.
  def reset_raf_cb_nudge_dismissal(admin:, organization:)
    admin.reset_organization_notice(RAF_CB_NUDGE_ID, organization)
    log("  -> Reset raf_cb nudge dismissal for #{user_style(admin.login)}")
  end

  # Reset the "Remind me later" snooze for the code-security flash test admin.
  # The secondary CTA records a 7-day snooze (dismiss POST) when clicked, which
  # would hide the banner — and therefore the ephemeral confirmation flash —
  # on every subsequent QA rerun. Resetting it keeps the flash re-testable.
  def reset_remind_me_later_snooze(admin:, organization:)
    admin.reset_organization_notice(REMIND_ME_LATER_NUDGE_ID, organization)
    log("  -> Reset Remind me later snooze for #{user_style(admin.login)}")
  end

  def ensure_copilot_seat_for_member(organization:, member:)
    copilot_org = Copilot::Organization.new(organization)
    org_seat_assignment = copilot_org.organization_seat_assignment
    return unless org_seat_assignment

    existing = Copilot::Seat.where(organization_id: organization.id, assigned_user_id: member.id).first
    if existing
      log("  -> Copilot seat: already exists for #{user_style(member.login)}")
      return
    end

    # Also check for a seat in any org (unique constraint on assigned_user_id)
    any_seat = Copilot::Seat.where(assigned_user_id: member.id).first
    if any_seat
      log("  -> Copilot seat: already exists for #{user_style(member.login)} (org_id=#{any_seat.organization_id})")
      return
    end

    Copilot::Seat.create!(
      seat_assignment: org_seat_assignment,
      organization: organization,
      assigned_user: member,
    )
    log("  -> Copilot seat: created for #{user_style(member.login)}")
  rescue ActiveRecord::RecordInvalid => e
    if e.message.include?("has already been taken")
      log("  -> Copilot seat: already exists for #{user_style(member.login)} (caught validation)")
    else
      raise
    end
  end

  # No-op for non-allowlisted users. For accounts seeded specifically to test
  # the CCA onboarding modal, this:
  #   1. Refreshes the user's `Copilot::Seat.created_at` in this organization
  #      to `Time.now`, so the
  #      `copilot_seats.created_at >= 7.days.ago` eligibility check still
  #      passes when setup is re-run on a long-lived codespace.
  #   2. Clears the dismissed-notice KV entry for the modal, so a previous CTA
  #      or X-close test run doesn't permanently hide the modal for that user.
  # See WELCOME_MODAL_MEMBER_LOGINS for the allowlist.
  def refresh_welcome_modal_state(member:, organization:)
    return unless WELCOME_MODAL_MEMBER_LOGINS.include?(member.login)

    seat = Copilot::Seat.where(organization_id: organization.id, assigned_user_id: member.id).first
    if seat
      # Use update_column to bypass timestamp-touching callbacks; the eligibility
      # check reads created_at directly.
      seat.update_column(:created_at, Time.now)
    end

    member.reset_notice(WELCOME_MODAL_NUDGE_ID)
    log("  -> Refreshed welcome-modal state for #{user_style(member.login)} (seat age + dismissal)")
  end

  # No-op for non-allowlisted users. For dashboard-CLI QA accounts, backdates
  # `Copilot::Seat.created_at` past the
  # `accelerate_ipm_copilot_business_onboarding_modal` 7-day eligibility window
  # so the welcome modal does NOT render and block the dashboard CLI nudge
  # under test. Copilot CLI access (granted via team policy in
  # `ensure_recent_copilot_cli_access_for_team_org`) is intentionally left
  # untouched so the CLI nudge eligibility (recent CLI grant) still holds.
  # See BACKDATED_BUSINESS_SEAT_LOGINS for the allowlist.
  def backdate_copilot_business_seat(member:, organization:)
    return unless BACKDATED_BUSINESS_SEAT_LOGINS.include?(member.login)

    seat = Copilot::Seat.where(organization_id: organization.id, assigned_user_id: member.id).first
    return unless seat

    # Use update_column to bypass timestamp-touching callbacks; the modal
    # eligibility check reads created_at directly.
    seat.update_column(:created_at, BACKDATED_BUSINESS_SEAT_AGE_DAYS.days.ago)
    log("  -> Backdated Copilot Business seat for #{user_style(member.login)} to #{BACKDATED_BUSINESS_SEAT_AGE_DAYS} days ago")
  end

  def ensure_enterprise_copilot_disabled(business:, actor: nil)
    copilot_business = Copilot::Business.new(business)
    return if copilot_business.copilot_disabled?

    copilot_business.disable_copilot!(actor)
  end

  def ensure_code_review_setting(business:, org:, owner:, copilot_code_review:)
    copilot_biz = Copilot::Business.new(business)
    copilot_org = Copilot::Organization.new(org)
    if copilot_code_review
      business.enable_code_review_repository_access(actor: owner)
      copilot_biz.code_review_enabled!
      copilot_org.code_review_enabled!(force: true)
      log("  -> Copilot Code Review: ensured enabled")
    else
      business.disable_code_review_repository_access(actor: owner, force: true)
      copilot_biz.code_review_no_policy!
      copilot_org.code_review_disabled!(force: true)
      log("  -> Copilot Code Review: ensured disabled")
    end
  end

  def ensure_active_dfd_trial(business:)
    updates = {}
    updates[:dfd_trial] = true unless business.dfd_trial?
    if business.trial_expires_at.nil? || business.trial_expires_at < Time.current
      updates[:trial_expires_at] = TRIAL_REMAINING_DAYS.days.from_now
    end
    business.update!(updates) if updates.any?

    # DFD trials require metered_plan for metered_ghec_trial? to return true
    if business.customer && !business.customer.metered_plan?
      business.customer.update!(metered_plan: true)
    end
  end

  def create_org_repository(org, committer)
    with_retries do
      GH::Context.enabled do
        repo_name = "test-repo"

        # Use Seeds::Objects::Repository.create which handles all edge cases
        repo = Seeds::Objects::Repository.create(
          owner_name: org.login,
          repo_name: repo_name,
          setup_master: true,
          description: "Test repository for in-product messaging"
        )

        # Set created_at for repository age
        repo.update_column(:created_at, REPO_AGE_DAYS.days.ago)

        # Create README.md with "Hello World" content
        Seeds::Objects::Commit.create(
          repo: repo,
          message: "Initial commit - add README",
          committer: committer,
          branch_name: repo.default_branch,
          files: { "README.md" => "Hello World" }
        )

        repo
      end
    end
  end

  def create_empty_org_repository(org, committer)
    with_retries do
      GH::Context.enabled do
        repo_name = "test-repo"

        # Use Seeds::Objects::Repository.create which handles all edge cases
        repo = Seeds::Objects::Repository.create(
          owner_name: org.login,
          repo_name: repo_name,
          setup_master: false,
          description: "Test repository for in-product messaging"
        )

        # Set created_at for repository age (no commits — repo remains empty)
        repo.update_column(:created_at, REPO_AGE_DAYS.days.ago)

        repo
      end
    end
  end

  def create_pull_request(repo, committer)
    with_retries do
      GH::Context.enabled do
        repo = wait_for_active_repository(repo.id)

        # Create a branch with a change
        branch_name = "feature-branch"

        Seeds::Objects::Commit.create(
          repo: repo,
          message: "Add feature file",
          committer: committer,
          branch_name: branch_name,
          files: { "feature.md" => "This is a feature file" }
        )

        # Create the pull request
        pr = ::PullRequest.create_for!(
          repo,
          user: committer,
          title: "Add feature",
          body: "This pull request adds a new feature.",
          head: branch_name,
          base: repo.default_branch,
          draft: false
        )

        raise "Pull request not created for #{repo.nwo}" unless pr&.persisted?

        # Set created_at for pull request age
        pr.update_column(:created_at, PULL_REQUEST_AGE_DAYS.days.ago)
        pr.issue.update_column(:created_at, PULL_REQUEST_AGE_DAYS.days.ago) if pr.issue

        pr
      end
    end
  end

  def create_issue(repo, author)
    issue = repo.issues.create!(
      user: author,
      title: "Test issue",
      body: "This is a test issue for in-product messaging."
    )

    raise "Issue not created for #{repo.nwo}" unless issue.persisted?

    issue
  end

  def wait_for_active_repository(repo_id, attempts: 10, delay: 0.2)
    attempts.times do
      repo = Repositories::Public.find_active(repo_id)
      return repo if repo

      sleep(delay)
    end

    raise "Repository #{repo_id} did not become active after creation"
  end

  # ============================================
  # Logging Helpers
  # ============================================

  def bold_white(string)
    LOGGER.info colorize(string, "white", style: :bold)
  end

  def org_style(login)
    colorize(login, "green", style: :underline)
  end

  def user_style(login)
    colorize(login, "cyan", style: :underline)
  end

  def enterprise_style(slug)
    colorize(slug, "red", style: :underline)
  end

  def repo_style(name)
    colorize(name, "magenta")
  end
end

class DestroyInProductMessaging
  include LoggingHelpers
  def call(individual: nil)
    if individual
      prefix = individual.start_with?("ipm-") ? individual : "ipm-#{individual}"
      yellow("Destroying In-Product Messaging seed data (individual: #{prefix})")
    else
      yellow("Destroying In-Product Messaging seed data")
    end
    log("")

    if individual
      prefix = individual.start_with?("ipm-") ? individual : "ipm-#{individual}"
      scoped_business_slugs = (
        ENTITY_CONFIG[:enterprises].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:business] } +
        ENTITY_CONFIG[:enterprise_trials].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:business] } +
        CQ_UPCOMING_CHARGES_CONFIG[:enterprises].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:business] }
      )
      scoped_org_logins = (
        ENTITY_CONFIG[:team_orgs].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:org] } +
        ENTITY_CONFIG[:enterprises].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:org] } +
        CQ_UPCOMING_CHARGES_CONFIG[:enterprises].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:org] } +
        CQ_UPCOMING_CHARGES_CONFIG[:organizations].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:org] }
      ).compact
      scoped_user_logins = (
        ENTITY_CONFIG[:team_orgs].select { |c| entity_matches_individual?(c, prefix) }.flat_map { |c| [c[:admin], c[:member]] } +
        ENTITY_CONFIG[:enterprises].select { |c| entity_matches_individual?(c, prefix) }.flat_map { |c| [c[:owner], c[:member]] } +
        ENTITY_CONFIG[:enterprise_trials].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:owner] } +
        ENTITY_CONFIG[:individual_users].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:login] } +
        CQ_UPCOMING_CHARGES_CONFIG[:enterprises].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:owner] } +
        CQ_UPCOMING_CHARGES_CONFIG[:organizations].select { |c| entity_matches_individual?(c, prefix) }.map { |c| c[:admin] }
      ).compact

      destroy_businesses(scoped_business_slugs) if scoped_business_slugs.any?
      destroy_organizations(scoped_org_logins) if scoped_org_logins.any?
      destroy_users(scoped_user_logins) if scoped_user_logins.any?
      cleanup_reserved_logins(scoped_org_logins + scoped_user_logins + scoped_business_slugs)
    else
      destroy_businesses(ALL_BUSINESS_SLUGS)
      destroy_organizations(ALL_ORG_LOGINS)
      destroy_users(ALL_USER_LOGINS)
      cleanup_reserved_logins(ALL_ORG_LOGINS + ALL_USER_LOGINS + ALL_BUSINESS_SLUGS)
    end

    green("In-Product Messaging seed data destroyed!")
  end

  private

  def destroy_businesses(slugs)
    title("Destroying Enterprise Accounts")
    slugs.each do |slug|
      business = Business.find_by(slug: slug)
      if business
        # Delete associated orgs first (they'll be handled by org deletion)
        business.delete
        log("  -> Destroyed: #{slug}")
      else
        log("  -> Not found: #{slug}")
      end
    end
    log("")
  end

  def destroy_organizations(logins)
    title("Destroying Organizations")
    logins.each do |login|
      org = Organization.find_by(login: login)
      if org
        # Get all repository IDs for this org
        repo_ids = Repository.where(owner_id: org.id).pluck(:id)

        if repo_ids.any?
          # Delete pull requests and issues at the database level
          pr_ids = PullRequest.where(repository_id: repo_ids).pluck(:id)
          if pr_ids.any?
            # Delete issues associated with pull requests
            Issue.where(pull_request_id: pr_ids).delete_all
            # Delete the pull requests themselves
            PullRequest.where(id: pr_ids).delete_all
          end

          # Delete any remaining issues for these repos
          Issue.where(repository_id: repo_ids).delete_all

          # Delete repositories
          Repository.where(id: repo_ids).delete_all
        end

        # Explicitly delete member feature request rows for this org. The
        # association on Organization is `delete_dependents_in_background`,
        # which enqueues a background job rather than synchronously deleting
        # rows, and we use `org.delete` (not `destroy`) below, which bypasses
        # that callback entirely. Without this, raf_cb seed requests would be
        # orphaned across `--destroy` runs. `dual_write_entities` sets
        # `organization_id = request_entity_id` for every row, so this single
        # filter covers both polymorphic columns for our seed data.
        MemberFeatureRequest.where(organization: org).delete_all

        org.delete
        log("  -> Destroyed: #{login}")
      else
        log("  -> Not found: #{login}")
      end
    end
    log("")
  end

  def destroy_users(logins)
    title("Destroying Users")
    logins.each do |login|
      user = User.find_by(login: login)
      if user
        # Delete any Copilot subscription items for this user
        Billing::SubscriptionItem.for_account(user).delete_all
        # Explicitly delete any remaining member feature requests by this
        # requester (user.delete bypasses `dependent: :delete_all`). Most
        # rows are already deleted above by destroy_organizations; this
        # catches any whose org was already gone or owned by a non-seeded
        # entity.
        MemberFeatureRequest.where(requester: user).delete_all
        # Delete user's emails first, then the user
        UserEmail.where(user_id: user.id).delete_all
        user.delete
        log("  -> Destroyed: #{login}")
      else
        log("  -> Not found: #{login}")
        # Clean up any orphaned emails with this pattern
        UserEmail.where(email: "#{login}@github.test.com").delete_all
      end
    end
    log("")
  end

  def cleanup_reserved_logins(all_logins)
    title("Cleaning up Reserved Logins")
    count = ReservedLogin.where(login: all_logins).delete_all
    log("  -> Removed #{count} reserved logins")
    log("")
  end
end

$stdout.reopen(File.new("/dev/null", "w")) # ONLY LOGGER EXISTS!
$VERBOSE = nil

with_billing = ARGV.include?("--with-billing")
with_cq_banners = ARGV.include?("--with-cq-banners")

individual_idx = ARGV.index("--individual")
individuals = individual_idx ? ARGV[individual_idx + 1]&.split(",") : nil

multiples_idx = ARGV.index("--multiples")
multiples = multiples_idx ? ARGV[multiples_idx + 1]&.to_i : nil

if individuals
  individuals.each do |individual|
    if ARGV.include?("--destroy")
      DestroyInProductMessaging.new.call(individual: individual)
    else
      DestroyInProductMessaging.new.call(individual: individual)
      SetupInProductMessaging.new.call(with_billing: with_billing, with_cq_banners: with_cq_banners, individual: individual, multiples: multiples)
    end
  end
else
  if ARGV.include?("--destroy")
    DestroyInProductMessaging.new.call(individual: nil)
  else
    DestroyInProductMessaging.new.call(individual: nil)
    SetupInProductMessaging.new.call(with_billing: with_billing, with_cq_banners: with_cq_banners, individual: nil, multiples: multiples)
  end
end
