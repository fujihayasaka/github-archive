# Logins of users seeded for the CCA onboarding modal QA tests.
# `refresh_welcome_modal_state` re-runs eligibility-resetting work for these
# users on every setup invocation:
#   1. Refresh `Copilot::Seat.created_at` to `Time.now` so the
#      `copilot_seats.created_at >= 7.days.ago` eligibility check still passes
#      on long-lived codespaces.
#   2. Reset the dismissed-notice KV entry for
#      `accelerate_ipm_copilot_business_onboarding_modal` so a previous CTA or
#      X-close test run does not permanently hide the modal for that user.
# Scope is intentionally narrow so other fixtures aren't perturbed.
WELCOME_MODAL_MEMBER_LOGINS = %w[
  ipm-team-welcome-modal
  ipm-team-welcome-modal-cta-agents
  ipm-team-welcome-modal-features
  ipm-team-welcome-modal-dismiss
  ipm-ent-welcome-modal
  ipm-ent-welcome-modal-dismiss
].freeze

WELCOME_MODAL_NUDGE_ID = "accelerate_ipm_copilot_business_onboarding_modal"

# Notice ID for the raf_cb nudge (`organization_new_tasks_raf_cb_nudge`).
# Reset on every setup run for the no-CB raf_cb test admins — that flow's
# one-shot Dismiss control would otherwise persist across QA reruns. See
# https://github.com/github/in-product-messaging/issues/262.
RAF_CB_NUDGE_ID = "organization_new_tasks_raf_cb_nudge"

# Notice ID for the code-security "Remind me later" secondary-CTA snooze.
# Clicking the secondary CTA fires a dismiss POST that snoozes the upsell
# banner for 7 days. Reset on every setup run for the flash test admin so the
# ephemeral confirmation flash can be re-exercised on each QA pass without
# waiting out the snooze window.
REMIND_ME_LATER_NUDGE_ID = "secure_ipm_security_risk_assessment_v2_remind_me_later_cta"

# Logins whose Copilot Business seat must be backdated past the
# `accelerate_ipm_copilot_business_onboarding_modal` 7-day eligibility window
# so the welcome modal does NOT render and obscure the dashboard nudges these
# accounts exist to test (e.g., the dashboard "Get started with Copilot CLI"
# card on `10-dashboard-cli`). The Copilot CLI access date is left untouched
# so the CLI nudge eligibility (recent CLI grant) still holds.
BACKDATED_BUSINESS_SEAT_LOGINS = %w[
  ipm-dashboard-cli
  ipm-dashboard-cli-dismiss
].freeze

BACKDATED_BUSINESS_SEAT_AGE_DAYS = 90

COPILOT_CLI_USAGE_COHORT = "2026_05_copilot_cli_usage_past_60d"
COPILOT_CLI_USAGE_SNAPSHOT_DAY = "2026-06-04"
RECENT_COPILOT_CLI_USAGE_LOGINS = %w[
  ipm-copilot-cli-dashboard-recent-usage
].freeze

class SetupInProductMessaging
  include GitHub::UserTestHelpers
  include LoggingHelpers

  # Age constants for seeded entities (in days)
  # These values represent how old each entity should appear for testing purposes

  # Standalone organizations (free/team) are created 60 days ago to simulate established orgs
  ORG_AGE_DAYS = 60

  # Enterprise accounts are created 60 days ago to simulate established enterprises
  ENTERPRISE_AGE_DAYS = 60

  # Organizations under enterprises and repositories are created 30 days ago
  ENTERPRISE_ORG_AGE_DAYS = 30
  REPO_AGE_DAYS = 30

  # Trial enterprises and their organizations are created 21 days ago (partially through trial)
  TRIAL_ELAPSED_DAYS = 21

  # Pull requests are created 14 days ago to simulate active PRs awaiting review
  PULL_REQUEST_AGE_DAYS = 14

  # Trial remaining days: 30 day trial - 21 days elapsed = 9 days remaining
  TRIAL_REMAINING_DAYS = 9

  def call(with_billing: false, with_cq_banners: false, individual: nil, multiples: nil)
    @multiples = multiples
    @created_users = [] # tracks [{login:, multiples: nil|N}]

    label_parts = []
    label_parts << "individual: #{individual}" if individual
    label_parts << "multiples: #{multiples}" if multiples
    if label_parts.any?
      yellow("Starting In-Product Messaging setup (#{label_parts.join(', ')})")
    else
      yellow("Starting In-Product Messaging setup")
    end
    log("")

    create_feature_flags

    if individual
      prefix = individual.start_with?("ipm-") ? individual : "ipm-#{individual}"
      matched = false

      matching_free_orgs = ENTITY_CONFIG[:free_orgs].select { |c| entity_matches_individual?(c, prefix) }
      if matching_free_orgs.any?
        matched = true
        yellow("Creating Free Organizations (#{matching_free_orgs.size} matching)")
        log("")
        matching_free_orgs.each do |config|
          create_free_org(
            org_login: config[:org],
            admin_login: config[:admin],
            copilot_business: config[:copilot_business],
            copilot_code_review: config[:copilot_code_review],
            cb_member_requests: config[:cb_member_requests],
            request_feature_surfaces: config[:request_feature_surfaces]
          )

          create_user_multiples(login: config[:admin], org: config[:org])

          if config[:reset_raf_cb_dismissal]
            admin = User.find_by!(login: config[:admin])
            org = Organization.find_by!(login: config[:org])
            reset_raf_cb_nudge_dismissal(admin: admin, organization: org)
          end
        end
      end

      matching_team_orgs = ENTITY_CONFIG[:team_orgs].select { |c| entity_matches_individual?(c, prefix) }
      if matching_team_orgs.any?
        matched = true
        yellow("Creating Team Organizations (#{matching_team_orgs.size} matching)")
        log("")
        matching_team_orgs.each do |config|
          create_team_org(
            org_login: config[:org],
            admin_login: config[:admin],
            member_login: config[:member],
            copilot_business: config[:copilot_business],
            copilot_code_review: config[:copilot_code_review],
            copilot_cli: config[:copilot_cli],
            has_issue: config[:has_issue],
            advanced_security: config[:advanced_security]
          )

          create_user_multiples(login: config[:admin], org: config[:org])
          create_user_multiples(login: config[:member], org: config[:org], role: :member) if config[:member]

          if config[:dismiss_global_nudges]
            admin = User.find_by!(login: config[:admin])
            dismiss_global_transactional_nudges(admin)
          end

          if config[:reset_remind_me_later_snooze]
            admin = User.find_by!(login: config[:admin])
            org = Organization.find_by!(login: config[:org])
            reset_remind_me_later_snooze(admin: admin, organization: org)
          end
        end
      end

      matching_enterprises = ENTITY_CONFIG[:enterprises].select { |c| entity_matches_individual?(c, prefix) }
      if matching_enterprises.any?
        matched = true
        yellow("Creating Enterprise Accounts (#{matching_enterprises.size} matching)")
        log("")
        matching_enterprises.each do |config|
          create_enterprise_account(
            business_slug: config[:business],
            owner_login: config[:owner],
            org_login: config[:org],
            member_login: config[:member],
            copilot_business: config[:copilot_business],
            copilot_code_review: config[:copilot_code_review],
            copilot_cli: config[:copilot_cli],
            advanced_security: config[:advanced_security],
            nudge_stack: config[:nudge_stack],
            coding_agent_member_requests: config[:coding_agent_member_requests]
          )

          create_user_multiples(login: config[:owner], org: config[:org], business: config[:business])
          create_user_multiples(login: config[:member], org: config[:org], role: :member) if config[:member]

          if config[:dismiss_global_nudges]
            owner = User.find_by!(login: config[:owner])
            dismiss_global_transactional_nudges(owner)
          end
        end
      end

      matching_trials = ENTITY_CONFIG[:enterprise_trials].select { |c| entity_matches_individual?(c, prefix) }
      if matching_trials.any?
        matched = true
        yellow("Creating Enterprise Trial Accounts (#{matching_trials.size} matching)")
        log("")
        matching_trials.each do |config|
          create_enterprise_trial(
            business_slug: config[:business],
            owner_login: config[:owner],
            org_login: config[:org],
            has_repository: config[:has_repository],
            has_code: config.fetch(:has_code, true),
            age_days: config[:age_days],
            dismiss_cb_nudge: config.fetch(:dismiss_cb_nudge, false)
          )

          create_user_multiples(login: config[:owner], org: config[:org], business: config[:business])
        end
      end

      matching_individuals = ENTITY_CONFIG[:individual_users].select { |c| entity_matches_individual?(c, prefix) }
      if matching_individuals.any?
        matched = true
        yellow("Creating Individual Copilot Users (#{matching_individuals.size} matching)")
        log("")
        ensure_copilot_product_uuids_exist
        matching_individuals.each do |config|
          create_individual_copilot_user(login: config[:login], plan: config[:plan])

          seed_recent_copilot_cli_usage_if_needed(config[:login])

          create_user_multiples(login: config[:login], plan: config[:plan])

          if config[:dismiss_global_nudges]
            user = User.find_by!(login: config[:login])
            dismiss_global_transactional_nudges(user)
          end
        end
      end

      if with_cq_banners
        matching_cq_enterprises = CQ_UPCOMING_CHARGES_CONFIG[:enterprises].select { |c| entity_matches_individual?(c, prefix) }
        if matching_cq_enterprises.any?
          matched = true
          yellow("Creating CQ Banner Enterprise Accounts (#{matching_cq_enterprises.size} matching)")
          log("")
          matching_cq_enterprises.each do |config|
            create_enterprise_account(
              business_slug: config[:business],
              owner_login: config[:owner],
              org_login: config[:org],
              copilot_business: false,
              copilot_code_review: false
            )
            create_user_multiples(login: config[:owner], org: config[:org], business: config[:business])

            owner = User.find_by!(login: config[:owner])
            safe_dismiss_notice(owner, "ipm_test_transactional_banner_enterprise")

            org = Organization.find_by!(login: config[:org])
            Rails.cache.write("ipm550_cq_org_has_active_repo/#{org.id}", true, expires_in: 30.days)
            log("  -> Pre-warmed cq_org_has_active_repo cache for #{user_style(org.login)}")
          end
        end

        matching_cq_orgs = CQ_UPCOMING_CHARGES_CONFIG[:organizations].select { |c| entity_matches_individual?(c, prefix) }
        if matching_cq_orgs.any?
          matched = true
          yellow("Creating CQ Banner Team Org Accounts (#{matching_cq_orgs.size} matching)")
          log("")
          matching_cq_orgs.each do |config|
            create_team_org(
              org_login: config[:org],
              admin_login: config[:admin],
              copilot_business: false,
              copilot_code_review: false
            )
            create_user_multiples(login: config[:admin], org: config[:org])

            admin = User.find_by!(login: config[:admin])
            safe_dismiss_notice(admin, "ipm_test_transactional_banner_org")

            org = Organization.find_by!(login: config[:org])
            Rails.cache.write("ipm550_cq_org_has_active_repo/#{org.id}", true, expires_in: 30.days)
            log("  -> Pre-warmed cq_org_has_active_repo cache for #{user_style(org.login)}")
          end
        end
      end

      unless matched
        yellow("No entities found matching '#{prefix}'. Available prefixes include:")
        all_logins = ENTITY_CONFIG[:free_orgs].map { |c| c[:admin] }.compact +
                     ENTITY_CONFIG[:team_orgs].flat_map { |c| [c[:admin], c[:member]] }.compact +
                     ENTITY_CONFIG[:enterprises].flat_map { |c| [c[:owner], c[:member]] }.compact +
                     ENTITY_CONFIG[:enterprise_trials].map { |c| c[:owner] } +
                     ENTITY_CONFIG[:individual_users].map { |c| c[:login] } +
                     CQ_UPCOMING_CHARGES_CONFIG[:enterprises].map { |c| c[:owner] } +
                     CQ_UPCOMING_CHARGES_CONFIG[:organizations].map { |c| c[:admin] }
        all_logins.sort.uniq.each { |l| log("  #{l}") }
      end
    else
      yellow("Creating Free Organizations")
      log("")
      create_free_organizations

      yellow("Creating Team Organizations")
      log("")
      create_team_organizations

      yellow("Creating Enterprise Accounts")
      log("")
      create_enterprise_accounts

      yellow("Creating Enterprise Trial Accounts")
      log("")
      create_enterprise_trial_accounts

      yellow("Creating Individual Copilot Users")
      log("")
      create_individual_copilot_users

      if with_billing
        yellow("Creating Budget Alert Accounts (--with-billing)")
        log("")
        create_budget_alert_accounts
      end

      if with_cq_banners
        yellow("Creating Code Quality Upcoming Charges Banner Accounts (--with-cq-banners)")
        log("")
        create_cq_upcoming_charges_accounts
      end
    end

    green("In-Product Messaging setup complete!")
    log("")

    output_user_summary
  end

  private

  def output_user_summary
    return if @created_users.empty?

    title("Generated User Accounts")
    log("Password for all accounts: #{DEFAULT_PASSWORD}")
    log("")

    # Multiple ENTITY_CONFIG rows can share the same admin/owner login (e.g.
    # the `ipm-ent-nudge-stack` owner is reused across the `-1`/`-2`/`-3`
    # enterprise variants, and `ipm-org-nudge-stack` is reused across the
    # org-side variants) so QA can sign in once and see every variant.
    # Dedupe by login here so each account is listed once, keeping the
    # entry with multiples info if any variant set it.
    @created_users
      .group_by { |entry| entry[:login] }
      .each_value do |entries|
        entry = entries.max_by { |e| e[:multiples] || 0 }
        login = entry[:login]
        n = entry[:multiples]
        if n
          suffix_max = n - 1
          max_base = MAX_LOGIN_LENGTH - "-#{suffix_max}".length
          base = login.length > max_base ? login[0, max_base] : login
          log("  #{user_style(login)}  (+ multiples #{user_style("#{base}-0")} through #{user_style("#{base}-#{suffix_max}")})")
        else
          log("  #{user_style(login)}")
        end
      end
    log("")
  end

  def create_feature_flags
    title("Creating feature flags")
    # Ensure copilot-related feature flags exist
    Copilot::FeatureFlags::ALL_FLAGS.each do |flag|
      Seeds::Objects::FeatureFlag.ensure_feature_flag_exists(flag)
    end
    Copilot::FeatureFlags::DEV_ENABLED.each do |flag|
      Seeds::Objects::FeatureFlag.enable(feature_flag: flag)
    end
    ipm_newly_enabled_flags = []
    ipm_already_enabled_flags = []
    IN_PRODUCT_MESSAGING_DEV_ENABLED_FLAGS.each do |flag|
      Seeds::Objects::FeatureFlag.ensure_feature_flag_exists(flag)
      if FeatureFlag.vexi.enabled?(flag, default: false)
        ipm_already_enabled_flags << flag
      else
        Seeds::Objects::FeatureFlag.enable(feature_flag: flag)
        ipm_newly_enabled_flags << flag
      end
    end
    ipm_disabled_flags = IN_PRODUCT_MESSAGING_DEV_ENABLED_FLAGS.reject do |flag|
      FeatureFlag.vexi.enabled?(flag, default: false)
    end

    log("-> In-product messaging dev flags: #{IN_PRODUCT_MESSAGING_DEV_ENABLED_FLAGS.size}")
    log("-> Newly enabled: #{ipm_newly_enabled_flags.size}; already enabled: #{ipm_already_enabled_flags.size}")
    if ipm_newly_enabled_flags.any?
      log("-> Newly enabled flags: #{ipm_newly_enabled_flags.join(", ")}")
    end
    if ipm_disabled_flags.any?
      log("-> Failed to enable flags: #{ipm_disabled_flags.join(", ")}")
    else
      log("-> Verified all in-product messaging dev flags are enabled")
    end

    # Enable the Copilot Chat App
    Apps::Privileged::CopilotChat.seed_database!

    log("")
  end

  # ============================================
  # Free Organizations
  # ============================================

  def create_free_organizations
    ENTITY_CONFIG[:free_orgs].each do |config|
      create_free_org(
        org_login: config[:org],
        admin_login: config[:admin],
        copilot_business: config[:copilot_business],
        copilot_code_review: config[:copilot_code_review],
        cb_member_requests: config[:cb_member_requests],
        request_feature_surfaces: config[:request_feature_surfaces]
      )

      create_user_multiples(login: config[:admin], org: config[:org])

      if config[:reset_raf_cb_dismissal]
        admin = User.find_by!(login: config[:admin])
        org = Organization.find_by!(login: config[:org])
        reset_raf_cb_nudge_dismissal(admin: admin, organization: org)
      end
    end
  end

  def create_free_org(org_login:, admin_login:, copilot_business:, copilot_code_review:, cb_member_requests: nil, request_feature_surfaces: false)
    log("-> Creating Free organization #{org_style(org_login)}")
    org_name = human_readable_org_name(org_login)

    # Check if org already exists
    existing_org = Organization.find_by(login: org_login)
    if existing_org
      admin = find_or_create_user(admin_login)
      ensure_organization_display_name(existing_org, org_name)
      # Check if repo exists, create if missing
      repo = Repository.nwo("#{org_login}/test-repo")
      if repo
        log("  -> Already exists, skipping")
      else
        log("  -> Organization exists, creating missing repository")
        repo = create_org_repository(existing_org, admin)
        log("  -> Repository: #{repo_style(repo.nwo)} (#{REPO_AGE_DAYS} days old)")
        pr = create_pull_request(repo, admin)
        log("  -> Pull Request: ##{pr.number} (#{PULL_REQUEST_AGE_DAYS} days old)")
      end

      # Idempotently top up raf_cb fixtures even on existing orgs so reruns
      # restore any deleted members or feature requests.
      if cb_member_requests
        create_member_cb_feature_requests(
          organization: existing_org,
          admin: admin,
          count: cb_member_requests[:count],
          seat_management: cb_member_requests[:seat_management]
        )
      end

      seed_request_feature_surfaces(organization: existing_org, admin: admin) if request_feature_surfaces

      log("")
      return
    end

    # Create admin user
    admin = find_or_create_user(admin_login)
    log("  -> Admin: #{user_style(admin.login)}")

    # Create the free organization with credit card billing enabled for Copilot
    # We use credit_card_organization to enable proper billing for Copilot
    org = FactoryBot.create(:credit_card_organization, login: org_login, plan: "free", admin: admin)
    raise "Organization #{org_login} not created" unless org.persisted?
    ensure_organization_display_name(org, org_name)

    # Set created_at to appear as an established organization
    org.update_column(:created_at, ORG_AGE_DAYS.days.ago)
    log("  -> Organization age: #{ORG_AGE_DAYS} days old")

    # Enable Copilot Business if requested
    if copilot_business
      enable_copilot_business_for_standalone_org(org)
      log("  -> Copilot Business: enabled")
    end

    # Enable/Disable Copilot Code Review
    copilot_org = Copilot::Organization.new(org)
    if copilot_code_review
      copilot_org.code_review_enabled!(force: true)
      log("  -> Copilot Code Review: enabled")
    else
      copilot_org.code_review_disabled!(force: true)
      log("  -> Copilot Code Review: disabled")
    end

    # Create repository with README.md
    repo = create_org_repository(org, admin)
    log("  -> Repository: #{repo_style(repo.nwo)} (#{REPO_AGE_DAYS} days old)")

    # Create pull request
    pr = create_pull_request(repo, admin)
    log("  -> Pull Request: ##{pr.number} (#{PULL_REQUEST_AGE_DAYS} days old)")

    # Seed CopilotForBusiness MemberFeatureRequest rows for the
    # `organization_new_tasks_raf_cb_nudge` (no-CB orgs only — with-CB Free
    # orgs aren't in the issue #262 targeting; this fixture is for
    # GitHub Free admins specifically).
    if cb_member_requests
      create_member_cb_feature_requests(
        organization: org,
        admin: admin,
        count: cb_member_requests[:count],
        seat_management: cb_member_requests[:seat_management]
      )
    end

    seed_request_feature_surfaces(organization: org, admin: admin) if request_feature_surfaces

    log("")
  end

  # ============================================
  # Team Organizations
  # ============================================

  def create_team_organizations
    ENTITY_CONFIG[:team_orgs].each do |config|
      create_team_org(
        org_login: config[:org],
        admin_login: config[:admin],
        member_login: config[:member],
        copilot_business: config[:copilot_business],
        copilot_code_review: config[:copilot_code_review],
        copilot_cli: config[:copilot_cli],
        has_issue: config[:has_issue],
        advanced_security: config[:advanced_security],
        cb_member_requests: config[:cb_member_requests],
        nudge_stack: config[:nudge_stack]
      )

      create_user_multiples(login: config[:admin], org: config[:org])
      create_user_multiples(login: config[:member], org: config[:org], role: :member) if config[:member]

      if config[:dismiss_global_nudges]
        admin = User.find_by!(login: config[:admin])
        dismiss_global_transactional_nudges(admin)
      end

      if config[:reset_remind_me_later_snooze]
        admin = User.find_by!(login: config[:admin])
        org = Organization.find_by!(login: config[:org])
        reset_remind_me_later_snooze(admin: admin, organization: org)
      end
    end
  end

  def create_team_org(org_login:, admin_login:, copilot_business:, copilot_code_review:, member_login: nil, copilot_cli: nil, has_issue: false, advanced_security: nil, cb_member_requests: nil, nudge_stack: nil)
    log("-> Creating Team organization #{org_style(org_login)}")
    org_name = human_readable_org_name(org_login)

    # Check if org already exists
    existing_org = Organization.find_by(login: org_login)
    if existing_org
      admin = find_or_create_user(admin_login)
      existing_org.add_member(admin, action: :admin, adder: admin) unless existing_org.member?(admin)
      ensure_organization_display_name(existing_org, org_name)
      ensure_recent_copilot_cli_access_for_team_org(
        organization: existing_org,
        admin: admin,
        member_login: member_login,
        copilot_cli: copilot_cli
      )
      # Check if repo exists, create if missing
      repo = Repository.nwo("#{org_login}/test-repo")
      if repo
        if has_issue && !repo.issues.exists?
          issue = create_issue(repo, admin)
          log("  -> Issue: ##{issue.number} (created)")
        end
        log("  -> Already exists, skipping")
      else
        log("  -> Organization exists, creating missing repository")
        repo = create_org_repository(existing_org, admin)
        log("  -> Repository: #{repo_style(repo.nwo)} (#{REPO_AGE_DAYS} days old)")
        pr = create_pull_request(repo, admin)
        log("  -> Pull Request: ##{pr.number} (#{PULL_REQUEST_AGE_DAYS} days old)")
        if has_issue
          issue = create_issue(repo, admin)
          log("  -> Issue: ##{issue.number}")
        end
      end

      # Idempotently top up raf_cb fixtures even on existing orgs.
      if cb_member_requests
        create_member_cb_feature_requests(
          organization: existing_org,
          admin: admin,
          count: cb_member_requests[:count],
          seat_management: cb_member_requests[:seat_management]
        )
      end

      log_org_nudge_stack_state(existing_org, admin: admin, count: nudge_stack) if nudge_stack

      log("")
      return
    end

    # Create admin user
    admin = find_or_create_user(admin_login)
    log("  -> Admin: #{user_style(admin.login)}")

    # Create the team organization (business plan) with credit card billing for Copilot
    org = FactoryBot.create(:credit_card_organization, login: org_login, plan: "business", admin: admin)
    raise "Organization #{org_login} not created" unless org.persisted?
    ensure_organization_display_name(org, org_name)

    # Set created_at to appear as an established organization
    org.update_column(:created_at, ORG_AGE_DAYS.days.ago)
    log("  -> Organization age: #{ORG_AGE_DAYS} days old")

    # Enable Advanced Security if requested (for security risk assessment banner)
    if advanced_security
      org.billable_owner.mark_advanced_security_as_purchased_for_entity(actor: admin)
      org.billable_owner.mark_advanced_security_as_metered_for_entity(actor: admin)
      org.billable_owner.mark_secret_protection_as_purchased_for_entity_as_volume(actor: admin)
      log("  -> Advanced Security: purchased (metered, with secret protection)")
    end

    # Enable Copilot Business if requested. The raf_cb-with-CB fixture
    # (cb_member_requests: { seat_management: :selected }) needs CB enabled
    # in *selected* seat-management mode so members can submit a
    # CopilotForBusiness MemberFeatureRequest without being auto-assigned a
    # seat (which would invalidate the request).
    if copilot_business
      if cb_member_requests && cb_member_requests[:seat_management] == :selected
        enable_copilot_business_in_selected_mode_for_standalone_org(org)
        log("  -> Copilot Business: enabled (selected seat management)")
      else
        enable_copilot_business_for_standalone_org(org)
        log("  -> Copilot Business: enabled")
      end
    end

    # Enable/Disable Copilot Code Review
    copilot_org = Copilot::Organization.new(org)
    if copilot_code_review
      copilot_org.code_review_enabled!(force: true)
      log("  -> Copilot Code Review: enabled")
    else
      copilot_org.code_review_disabled!(force: true)
      log("  -> Copilot Code Review: disabled")
    end

    ensure_recent_copilot_cli_access_for_team_org(
      organization: org,
      admin: admin,
      member_login: member_login,
      copilot_cli: copilot_cli
    )

    # Create repository with README.md
    repo = create_org_repository(org, admin)
    log("  -> Repository: #{repo_style(repo.nwo)} (#{REPO_AGE_DAYS} days old)")

    # Create pull request
    pr = create_pull_request(repo, admin)
    log("  -> Pull Request: ##{pr.number} (#{PULL_REQUEST_AGE_DAYS} days old)")

    # Create issue if requested
    if has_issue
      issue = create_issue(repo, admin)
      log("  -> Issue: ##{issue.number}")
    end

    # Seed CopilotForBusiness MemberFeatureRequest rows for the
    # `organization_new_tasks_raf_cb_nudge`. For with-CB orgs, CB was
    # enabled in selected-seat-management mode above so members aren't
    # auto-assigned seats.
    if cb_member_requests
      create_member_cb_feature_requests(
        organization: org,
        admin: admin,
        count: cb_member_requests[:count],
        seat_management: cb_member_requests[:seat_management]
      )
    end

    log_org_nudge_stack_state(org, admin: admin, count: nudge_stack) if nudge_stack

    log("")
  end

  # Org-side counterpart to `ensure_nudge_stack_policies`: the
  # OrganizationStackableNudgeComponent eligibility checks are driven by the
  # underlying config (CB enablement, presence of `cb_member_requests:`
  # → `raf_cb`; CLI defaults to not-enabled at the org level
  # → `copilot_cli_enablement`). For `count >= 3` this helper additionally
  # seeds the winback twirp cohort metadata + pre-dismisses the
  # `offer_to_accept` notice so the `win_cb_users_back_credit_assign_seats`
  # card becomes eligible (the only `win_cb_users_back_credit_*` variant
  # compatible with CB on + 0 assigned seats).
  #
  # `count` mirrors the `nudge_stack:` integer in ENTITY_CONFIG:
  #   1 → `copilot_cli_enablement` (set CB on, omit cb_member_requests).
  #   2 → `copilot_cli_enablement` + `raf_cb` (set cb_member_requests).
  #   3 → adds `win_cb_users_back_credit_assign_seats` via seeded cohort +
  #       dismissal. This is the maximum the stackable component can render
  #       in production (other `win_cb_*` variants require CB off, so they're
  #       mutually exclusive with the CLI card).
  # `true` is treated as 2 for backward compatibility.
  def log_org_nudge_stack_state(organization, admin:, count: 2)
    count = 2 if count == true
    log("  -> Nudge stack: organization configured for stacked settings nudges")
    log("  -> Nudge stack: expect `copilot_cli_enablement` card")
    if count >= 2
      log("  -> Nudge stack: expect `raf_cb` (with-CB \"Assign seats\" variant) card")
    end
    if count >= 3
      seed_org_winback_assign_seats_cohort(organization: organization, admin: admin)
      log("  -> Nudge stack: expect `win_cb_users_back_credit_assign_seats` card")
    end
  end

  # Seeds the twirp cohort row + pre-dismisses the `offer_to_accept` notice
  # so `eligible_for_win_cb_users_back_credit_assign_seats_nudge?` returns
  # true for the given admin on the given organization. Called by
  # `log_org_nudge_stack_state` for `count >= 3`.
  def seed_org_winback_assign_seats_cohort(organization:, admin:)
    ::InProductTargeting.domain.bulk_create_matches(matches: [{
      organization_id: organization.id,
      cohort: :nov_2025_copilot_digital_offer_for_organizations.to_s,
      day: "2025-11-12",
      metadata: { "feature" => "win_cb_users_back_credit_assign_seats", "variant" => "treatment" }
    }])
    # The `_assign_seats` and `_credit` variants both gate on the user
    # having dismissed the `_offer_to_accept` notice first, so we mark it
    # dismissed up front to skip the click-through step in QA.
    admin.dismiss_organization_notice(:nudge_organization_win_cb_users_back_credit_offer_to_accept, organization)
  end

  # ============================================
  # Enterprise Accounts
  # ============================================

  def create_enterprise_accounts
    ENTITY_CONFIG[:enterprises].each do |config|
      create_enterprise_account(
        business_slug: config[:business],
        owner_login: config[:owner],
        org_login: config[:org],
        member_login: config[:member],
        copilot_business: config[:copilot_business],
        copilot_code_review: config[:copilot_code_review],
        copilot_cli: config[:copilot_cli],
        advanced_security: config[:advanced_security],
        nudge_stack: config[:nudge_stack],
        coding_agent_member_requests: config[:coding_agent_member_requests]
      )

      create_user_multiples(login: config[:owner], org: config[:org], business: config[:business])
      create_user_multiples(login: config[:member], org: config[:org], role: :member) if config[:member]

      if config[:dismiss_global_nudges]
        owner = User.find_by!(login: config[:owner])
        dismiss_global_transactional_nudges(owner)
      end
    end
  end

  def create_enterprise_account(business_slug:, owner_login:, org_login:, copilot_business:, copilot_code_review:, member_login: nil, copilot_cli: nil, advanced_security: nil, nudge_stack: nil, coding_agent_member_requests: nil)
    log("-> Creating Enterprise account #{enterprise_style(business_slug)}")
    business_name = human_readable_business_name(business_slug)
    org_name = human_readable_org_name(org_login)

    # Check if business already exists
    existing_business = Business.find_by(slug: business_slug)
    if existing_business
      owner = find_or_create_user(owner_login)
      ensure_business_name(existing_business, business_name)
      existing_org = Organization.find_by(login: org_login)
      if existing_org
        ensure_organization_display_name(existing_org, org_name)
        ensure_recent_copilot_cli_access_for_enterprise_org(
          business: existing_business,
          organization: existing_org,
          owner: owner,
          member_login: member_login,
          copilot_cli: copilot_cli
        )

        # Re-apply code review settings on existing enterprises (idempotent)
        ensure_code_review_setting(
          business: existing_business,
          org: existing_org,
          owner: owner,
          copilot_code_review: copilot_code_review
        )

        ensure_nudge_stack_policies(business: existing_business, count: nudge_stack) if nudge_stack

        # Check if repo exists, create if missing
        repo = Repository.nwo("#{org_login}/test-repo")
        if repo
          log("  -> Already exists, skipping")
        else
          log("  -> Enterprise exists, creating missing repository")
          # Ensure the owner is an admin of the existing org so Seeds::Objects::Repository.create
          # can find an admin via org.admins.first (user may have been destroyed and recreated).
          existing_org.add_member(owner, action: :admin, adder: owner) unless existing_org.direct_member?(owner, include_indirect_abilities: false)
          repo = create_org_repository(existing_org, owner)
          log("  -> Repository: #{repo_style(repo.nwo)} (#{REPO_AGE_DAYS} days old)")
          pr = create_pull_request(repo, owner)
          log("  -> Pull Request: ##{pr.number} (#{PULL_REQUEST_AGE_DAYS} days old)")
        end

        if coding_agent_member_requests
          seed_coding_agent_member_requests(
            business: existing_business,
            organization: existing_org,
            owner: owner,
            count: coding_agent_member_requests[:count]
          )
        end
      else
        log("  -> Already exists, skipping")
      end
      log("")
      return
    end

    # Create owner user
    owner = find_or_create_user(owner_login)
    log("  -> Owner: #{user_style(owner.login)}")

    # Create the business (enterprise account)
    business = FactoryBot.create(:business, :with_github_subscription, slug: business_slug, name: business_name, owners: [owner])
    raise "Business #{business_slug} not created" unless business.persisted?

    # Set created_at to appear as an established enterprise
    business.update_column(:created_at, ENTERPRISE_AGE_DAYS.days.ago)
    log("  -> Enterprise age: #{ENTERPRISE_AGE_DAYS} days old")

    # Create organization under the enterprise
    org = FactoryBot.create(:enterprise_linked_organization, login: org_login, business: business, admin: owner)
    raise "Organization #{org_login} not created" unless org.persisted?
    ensure_organization_display_name(org, org_name)

    # Set org created_at for enterprise-linked org
    org.update_column(:created_at, ENTERPRISE_ORG_AGE_DAYS.days.ago)
    log("  -> Organization: #{org_style(org_login)} (#{ENTERPRISE_ORG_AGE_DAYS} days old)")

    # Enable Advanced Security if requested (for security risk assessment banner)
    if advanced_security
      org.billable_owner.mark_advanced_security_as_purchased_for_entity(actor: owner)
      org.billable_owner.mark_advanced_security_as_metered_for_entity(actor: owner)
      log("  -> Advanced Security: purchased (metered)")
    end

    # Enable Copilot Business for all organizations if requested
    if copilot_business
      enable_copilot_business_for_enterprise(business)
      log("  -> Copilot Business: enabled for all organizations")

      # Also explicitly enable Copilot at the org level so that org-level checks
      # (e.g. Copilot::Organization#has_copilot_for_business?) are satisfied.
      # Enterprise-level enablement sets the business policy, but some components
      # check org-level state directly.
      copilot_org = Copilot::Organization.new(org)
      copilot_org.enable_copilot!
      copilot_org.seat_management_allow_all!
      log("  -> Copilot Business: also enabled at org level")
    end

    # Enable/Disable Copilot Code Review at enterprise level
    # NOTE: enable_copilot_for_all_organizations! propagates the business's
    # default "enabled" code_review policy to all orgs with force: true.
    # To disable code review, we must set the business to "no_policy" (breaking
    # the inheritance chain) AND disable at the org level with force: true.
    copilot_business = Copilot::Business.new(business)
    if copilot_code_review
      business.enable_code_review_repository_access(actor: owner)
      copilot_business.code_review_enabled!
      log("  -> Copilot Code Review: enabled")
    else
      business.disable_code_review_repository_access(actor: owner, force: true)
      copilot_business.code_review_no_policy!
      log("  -> Copilot Code Review: disabled (business set to no_policy)")
    end

    # Also explicitly set code review at the org level.
    # Use force: true to bypass the inheritance early-return in code_review_disabled!
    copilot_org = Copilot::Organization.new(org)
    if copilot_code_review
      copilot_org.code_review_enabled!(force: true)
      log("  -> Copilot Code Review: also enabled at org level")
    else
      copilot_org.code_review_disabled!(force: true)
      log("  -> Copilot Code Review: also disabled at org level")
    end

    ensure_recent_copilot_cli_access_for_enterprise_org(
      business: business,
      organization: org,
      owner: owner,
      member_login: member_login,
      copilot_cli: copilot_cli
    )

    ensure_nudge_stack_policies(business: business, count: nudge_stack) if nudge_stack

    # Create repository with README.md
    repo = create_org_repository(org, owner)
    log("  -> Repository: #{repo_style(repo.nwo)} (#{REPO_AGE_DAYS} days old)")

    # Create pull request
    pr = create_pull_request(repo, owner)
    log("  -> Pull Request: ##{pr.number} (#{PULL_REQUEST_AGE_DAYS} days old)")

    if coding_agent_member_requests
      seed_coding_agent_member_requests(
        business: business,
        organization: org,
        owner: owner,
        count: coding_agent_member_requests[:count]
      )
    end

    log("")
  end

  # Flip the enterprise-level CLI and (optionally) Copilot coding-agent
  # policies off `no_policy` so the `EnterpriseStackableNudgesComponent`
  # cards become eligible. `EnterpriseNudgeConcern#eligible_for_copilot_cli_nudge?`
  # and `eligible_for_copilot_coding_agent_nudge?` both gate the nudges off
  # when the underlying business setting is `no_policy` (the post-CB-enable
  # default), so we have to explicitly mark them as `disabled`.
  #
  # `count` controls how many cards are made eligible (mapping to the
  # nudge_stack: integer used in ENTITY_CONFIG):
  #   1 → flip CLI only (renders `copilot_cli_enablement`).
  #   2 → flip CLI + coding-agent (renders both that key plus
  #         `copilot_coding_agent_enablement`).
  #   3 → same flips as 2, plus seeded winback twirp cohort row
  #         (`nov_2025_copilot_digital_offer_for_enterprises`) which
  #         unlocks the `win_cb_users_back_credit` enterprise card → 3
  #         cards. This is the maximum the EnterpriseStackableNudgesComponent
  #         can render today (`ENTERPRISE_PREVIEW_NUDGE_KEYS` enumerates
  #         3 distinct cards).
  # `true` is treated as 2 for backward compatibility with any legacy
  # `nudge_stack: true` callers.
  #
  # NOTE: Rendering the stack still requires `show_ai_controls?(business)` to
  # return true, which calls into billing-platform. Run the script with
  # `--with-billing` (or otherwise have billing-platform reachable) when
  # validating these accounts.
  def ensure_nudge_stack_policies(business:, count: 2)
    count = 2 if count == true # legacy `nudge_stack: true` callers
    copilot_business = Copilot::Business.new(business)
    copilot_business.cli_disabled!
    log("  -> Nudge stack: CLI policy set to disabled (off no_policy)")
    if count >= 2
      copilot_business.swe_agent_disabled!
      log("  -> Nudge stack: Copilot coding-agent policy set to disabled (off no_policy)")
    end
    if count >= 3
      seed_enterprise_winback_cohort(business: business)
      log("  -> Nudge stack: expect `win_cb_users_back_credit` enterprise card")
    end
  end

  # Seeds the twirp cohort row so
  # `eligible_for_win_cb_users_back_credit_nudge?` returns true for the
  # given business. Called by `ensure_nudge_stack_policies` for
  # `count >= 3`.
  #
  # In addition to the cohort row, this method clears any auto-assigned
  # Copilot seats under the enterprise. `eligible_for_win_cb_users_back_credit_nudge?`
  # gates the nudge on (when Copilot is enabled) `copilot_seat_count == 0`
  # OR `copilot_accessible_organization_count == 0` — and enabling CB on
  # the linked org auto-assigns the owner a seat (count=1) and registers
  # the org as accessible (count=1), failing both branches. We delete the
  # seat rows via raw SQL (bypassing notification/audit callbacks) so the
  # seat-count branch is satisfied for the nudge-stack QA accounts. The
  # `copilot_accessible_organization_count` stays > 0, which is the
  # production-realistic state for the winback cohort.
  def seed_enterprise_winback_cohort(business:)
    ::InProductTargeting.domain.bulk_create_matches(matches: [{
      enterprise_id: business.id,
      cohort: :nov_2025_copilot_digital_offer_for_enterprises.to_s,
      day: "2025-11-12",
      metadata: { "feature" => "win_cb_users_back_credit", "variant" => "treatment" }
    }])

    seats = Copilot::Seat.for_business(business)
    seat_ids = seats.map(&:id)
    assignment_ids = seats.map(&:copilot_seat_assignment_id).uniq.compact
    deleted = seat_ids.any? ? Copilot::Seat.where(id: seat_ids).delete_all : 0
    Copilot::SeatAssignment.where(id: assignment_ids).delete_all if assignment_ids.any?
    if deleted > 0
      log("  -> Nudge stack: cleared #{deleted} auto-assigned Copilot seat(s) so win_cb eligibility (seat_count == 0) holds")
    end
  end

  # ============================================
  # Budget Alert Accounts (--with-billing)
  # ============================================

  def create_budget_alert_accounts
    verify_billing_platform_reachable!

    # Phase 1: create all entities (orgs and enterprises) first.
    # We need every Customer record to exist before we sync them to the
    # billing-platform so that budget seeding doesn't fail with
    # "customer not found when upserting budget".
    BUDGET_ALERT_CONFIG[:organizations].each do |config|
      create_team_org(
        org_login: config[:org],
        admin_login: config[:admin],
        copilot_business: false,
        copilot_code_review: false
      )
      @created_users << { login: config[:admin], multiples: nil }
    end

    BUDGET_ALERT_CONFIG[:enterprises].each do |config|
      create_enterprise_account(
        business_slug: config[:business],
        owner_login: config[:owner],
        org_login: config[:org],
        copilot_business: false,
        copilot_code_review: false
      )
      @created_users << { login: config[:owner], multiples: nil }
    end

    BUDGET_ALERT_CONFIG[:cost_centers].each do |config|
      create_enterprise_account(
        business_slug: config[:business],
        owner_login: config[:owner],
        org_login: config[:org],
        copilot_business: false,
        copilot_code_review: false
      )
      @created_users << { login: config[:owner], multiples: nil }
    end

    # Budget request CTA accounts — Copilot Business enabled with members
    BUDGET_ALERT_CONFIG[:budget_request_orgs].each do |config|
      create_team_org(
        org_login: config[:org],
        admin_login: config[:admin],
        member_login: config[:member],
        copilot_business: true,
        copilot_code_review: false
      )
    end

    BUDGET_ALERT_CONFIG[:budget_request_enterprises].each do |config|
      create_enterprise_account(
        business_slug: config[:business],
        owner_login: config[:owner],
        org_login: config[:org],
        member_login: config[:member],
        copilot_business: true,
        copilot_code_review: false
      )
    end

    BUDGET_ALERT_CONFIG[:budget_request_cost_centers].each do |config|
      create_enterprise_account(
        business_slug: config[:business],
        owner_login: config[:owner],
        org_login: config[:org],
        member_login: config[:member],
        copilot_business: true,
        copilot_code_review: false
      )
    end

    # Phase 2: sync every Customer in the database to billing-platform
    # synchronously. The after_commit hook on Customer enqueues
    # UpdateCustomerInBillingPlatformJob asynchronously, but we can't rely on
    # Aqueduct having drained the queue before we try to seed budgets.
    sync_all_customers_to_billing_platform

    # Phase 3: seed budgets and usage for each configured entity now that
    # billing-platform knows about every customer.
    BUDGET_ALERT_CONFIG[:organizations].each do |config|
      org = Organization.find_by!(login: config[:org])
      admin = User.find_by!(login: config[:admin])

      # Ensure the org has a customer record in billing-platform
      ensure_customer_for_entity(org)

      seed_budget_for_entity(
        entity: org,
        actor: admin,
        threshold: config[:threshold],
        budget_type: :organization
      )
    end

    BUDGET_ALERT_CONFIG[:enterprises].each do |config|
      business = Business.find_by!(slug: config[:business])
      owner = User.find_by!(login: config[:owner])

      # Ensure the enterprise has a customer record in billing-platform
      ensure_customer_for_entity(business)

      seed_budget_for_entity(
        entity: business,
        actor: owner,
        threshold: config[:threshold],
        budget_type: :enterprise
      )
    end

    BUDGET_ALERT_CONFIG[:cost_centers].each do |config|
      business = Business.find_by!(slug: config[:business])
      owner = User.find_by!(login: config[:owner])

      # Ensure the enterprise has a customer record in billing-platform
      ensure_customer_for_entity(business)

      seed_budget_for_entity(
        entity: business,
        actor: owner,
        threshold: config[:threshold],
        budget_type: :cost_center
      )
    end

    # Budget request CTA accounts — seed exhausted budgets (100% threshold)
    # so the "Request additional budget" banner renders for the member user.
    BUDGET_ALERT_CONFIG[:budget_request_orgs].each do |config|
      org = Organization.find_by!(login: config[:org])
      admin = User.find_by!(login: config[:admin])

      ensure_customer_for_entity(org)

      seed_budget_for_entity(
        entity: org,
        actor: admin,
        threshold: config[:threshold],
        budget_type: :organization
      )

      populate_budget_request_banner_cache(org: org, member_login: config[:member])
    end

    BUDGET_ALERT_CONFIG[:budget_request_enterprises].each do |config|
      business = Business.find_by!(slug: config[:business])
      owner = User.find_by!(login: config[:owner])

      ensure_customer_for_entity(business)

      seed_budget_for_entity(
        entity: business,
        actor: owner,
        threshold: config[:threshold],
        budget_type: :enterprise
      )

      org = Organization.find_by!(login: config[:org])
      populate_budget_request_banner_cache(org: org, member_login: config[:member])
    end

    BUDGET_ALERT_CONFIG[:budget_request_cost_centers].each do |config|
      business = Business.find_by!(slug: config[:business])
      owner = User.find_by!(login: config[:owner])

      ensure_customer_for_entity(business)

      seed_budget_for_entity(
        entity: business,
        actor: owner,
        threshold: config[:threshold],
        budget_type: :cost_center
      )

      org = Organization.find_by!(login: config[:org])
      populate_budget_request_banner_cache(org: org, member_login: config[:member])
    end
  end

  def sync_all_customers_to_billing_platform
    log("Syncing all customers to billing-platform...")
    count = 0
    Customer.find_each do |customer|
      Billing::UpdateCustomerInBillingPlatformJob.perform_now(customer)
      count += 1
    rescue => e
      log("  -> WARNING: Failed to sync customer #{customer.id}: #{e.message}")
    end
    log("  -> Synced #{count} customer(s)")
  end

