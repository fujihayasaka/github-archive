      )
      create_user_multiples(login: config[:admin], org: config[:org])

      # Pre-dismiss the org-page test fixture so it doesn't render
      # alongside the upcoming-charges banner during QA.
      admin = User.find_by!(login: config[:admin])
      admin.dismiss_notice("ipm_test_transactional_banner_org")
      log("  -> Pre-dismissed ipm_test_transactional_banner_org for #{user_style(admin.login)}")

      # Pre-warm the cq_org_has_active_repo? cache so the org banner renders
      # without requiring Turboscan (CodeQuality.enabled? has no seed primitive).
      org = Organization.find_by!(login: config[:org])
      Rails.cache.write("ipm550_cq_org_has_active_repo/#{org.id}", true, expires_in: 30.days)
      log("  -> Pre-warmed cq_org_has_active_repo cache for #{user_style(org.login)}")
    end
  end

  def verify_billing_platform_reachable!
    # GitHub.billing_platform_host is unset in development; BillingPlatform::Client
    # falls back to http://localhost:8989, so we mirror that default here.
    host = GitHub.billing_platform_host
    host = "http://localhost:8989" if host.nil? || host.empty?
    # If a host was configured without a scheme (e.g. "localhost:8989"), URI.parse
    # returns a URI::Generic which lacks #request_uri. Prepend http:// so we get
    # a URI::HTTP and a usable request path.
    host = "http://#{host}" unless host.match?(%r{\Ahttps?://})

    uri = URI.parse(host)
    http = Net::HTTP.new(uri.host, uri.port)
    http.open_timeout = 3
    http.read_timeout = 3
    http.use_ssl = uri.scheme == "https"
    # billing-platform is a Twirp service and doesn't expose /health, so any HTTP
    # response (including 404) means the service is reachable. Only connection
    # failures (refused, timeout, DNS) indicate it's not running.
    http.get("/")
    log("-> Billing platform reachable at #{host}")
  rescue Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ENETUNREACH,
         SocketError, Net::OpenTimeout, Net::ReadTimeout => e
    abort <<~MSG
      ERROR: Billing platform is not reachable at #{host} (#{e.class}: #{e.message}).

      The --with-billing flag requires the billing-platform service to be running.
      Set it up with:

        script/setup-codespaces-billing-platform && cd ../billing-platform && script/server

      Then re-run this script with --with-billing.
    MSG
  end

  def ensure_customer_for_entity(entity)
    if entity.customer&.persisted?
      log("  -> Customer record exists (ID: #{entity.customer.id})")
      return
    end

    log("  -> Creating customer record in billing-platform...")
    ActiveRecord::Base.connected_to(role: :writing) do
      Billing::CreateCustomer.perform(entity, details: {})
    end

    # Reload to pick up the new association
    entity.reload
    if entity.customer&.persisted?
      log("  -> Customer created (ID: #{entity.customer.id})")
    else
      log("  -> WARNING: Failed to create customer record")
    end
  end

  def seed_budget_for_entity(entity:, actor:, threshold:, budget_type:)
    customer = entity.respond_to?(:customer) ? entity.customer : entity.billable_owner&.customer
    unless customer
      log("  -> WARNING: No customer found for #{entity.class}##{entity.id}, skipping budget seed")
      return
    end

    target_amount = 100.0
    # Always use AlertingOnly. The billing-platform rejects PreventFurtherUsage
    # for high-watermark / user-months SKUs (Copilot, GHEC) with the error
    # "High watermark products cannot have PreventFurtherUsage budget alerting
    # except for GHAS SKUs". `copilot_enterprise` is high-watermark so we'd be
    # rejected at 100%. The banner UI/UX is testable from AlertingOnly budgets;
    # only the :critical (red) variant requires PreventFurtherUsage at 100%.
    budget_limit_type = "AlertingOnly"

    if budget_type == :cost_center
      target_type = "CostCenterResource"
      org = entity.organizations.first
      cost_center_name = "IPM Budget Alert #{threshold}% Cost Center"
      cost_center_uuid = create_cost_center_for_budget(customer: customer, name: cost_center_name, org: org)
      unless cost_center_uuid
        log("  -> WARNING: Could not create cost center, skipping budget seed")
        return
      end
      target_id = cost_center_uuid
    else
      target_type = "CustomerResource"
      target_id = customer.id.to_s
    end

    budget_payload = {
      key: {
        customerId: customer.id.to_s,
        targetType: target_type,
        targetId: target_id,
        pricingTargetType: "SkuPricing",
        pricingTargetId: "copilot_enterprise",
      },
      targetAmount: target_amount,
      budgetLimitType: budget_limit_type,
      budgetAlerting: {
        willAlert: true,
        recipientUserIds: [actor.id.to_s],
      },
    }

    client = Billing::Platform::Api::Client.new(timeout: 5)
    response = client.create_or_update_budget(budget: budget_payload)

    if response.is_a?(Billing::Platform::Api::Error)
      log("  -> WARNING: Failed to create budget: #{response.message}")
      return
    end

    log("  -> Budget created: $#{target_amount} limit (#{budget_limit_type})")

    # Generate usage to trigger the threshold alert.
    # The billing platform computes budget state (currentAmount, thresholdMet)
    # from accumulated usage events. We pass the dollar `amount` (e.g. 76 for
    # 75% of a $100 budget); billing-platform divides by the SKU price to get
    # a quantity and emits a usage event. Do NOT also pass `quantity` (the
    # validator rejects requests that set both), and do NOT pre-multiply the
    # amount by 10^9 — `nano.NewFromFloat` already does that internally and
    # passing a pre-scaled value overflows int64 (gross_quantity becomes
    # MinInt64), which silently produces zero BilledAmount and no budget state
    # update (so currentAmount stays at 0 and the threshold banner never
    # fires).
    #
    # We add $1 over the exact threshold to absorb nano-precision rounding
    # (e.g. injecting exactly $75 for the 75% threshold lands at
    # $74.999999997 once divided by the $39 SKU price and re-multiplied,
    # which truncates to 74% and misses the threshold). Adding $1 ensures
    # the threshold percentage is always crossed.
    usage_amount = threshold.to_f + 1.0
    org = budget_type == :organization ? entity : entity.organizations.first
    usage_response = client.admin_generate_usage(
      customer_id: customer.id.to_s,
      sku: "copilot_enterprise",
      org_id: org&.id.to_i,
      amount: usage_amount
    )

    if usage_response.is_a?(Billing::Platform::Api::Error)
      log("  -> WARNING: Failed to generate usage: #{usage_response.message}")
      return
    end

    log("  -> Usage generated: $#{usage_amount} of $#{target_amount} (#{threshold}% threshold, #{budget_type})")

    # Trigger watermark workflow to force threshold evaluation in billing-platform.
    now = Time.now.utc
    watermark_response = client.admin_trigger_watermark_workflow(
      customer_id: customer.id.to_s,
      sku: "copilot_enterprise",
      year: now.year,
      month: now.month,
      day: now.day,
      hour: now.hour
    )

    if watermark_response.is_a?(Billing::Platform::Api::Error)
      log("  -> WARNING: Failed to trigger watermark workflow: #{watermark_response.message}")
    else
      log("  -> Watermark workflow triggered (threshold evaluation)")
    end
  end

  def create_cost_center_for_budget(customer:, name:, org:)
    client = Billing::Platform::Api::Client.new(timeout: 5)
    response = client.create_cost_center(
      customer_id: customer.id.to_s,
      name: name,
      target_type: "AzureSubscription",
      target_id: "1",
      resources: [{ id: org.id.to_s, type: "Org" }]
    )

    if response.is_a?(Billing::Platform::Api::Error)
      log("  -> WARNING: Failed to create cost center: #{response.message}")
      nil
    else
      # The CreateCostCenterResponse proto wraps the cost center under a
      # `costCenter` key, with the UUID nested at `costCenter.costCenterKey.uuid`.
      uuid = response.dig(:costCenter, :costCenterKey, :uuid)
      log("  -> Cost center created: #{name} (#{uuid})")
      uuid
    end
  end

  # Pre-warm the BudgetExhaustedClient cache for the member user so the
  # "Request additional budget" banner renders without waiting for the
  # BudgetThresholdNotificationProcessor stream processor to fire.
  def populate_budget_request_banner_cache(org:, member_login:)
    member = User.find_by!(login: member_login)
    reset_date = (Date.today.end_of_month + 1.day).strftime("%B %-d, %Y")

    entry = {
      org_id: org.id,
      org_login: org.display_login,
      reset_date: reset_date,
      personal_budget: false,
    }

    client = Copilot::Cache::BudgetExhaustedClient.new(user_id: member.id)
    client.upsert_entry(entry)
    log("  -> Pre-warmed budget-exhausted cache for #{user_style(member_login)} (org: #{user_style(org.login)})")
  end

