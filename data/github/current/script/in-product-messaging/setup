#!/usr/bin/env safe-ruby
# frozen_string_literal: true

# This script sets up seed data for in-product messaging testing.
# It creates various organizations, enterprises, and repositories with
# different configurations for Copilot Business and Copilot Code Review,
# as well as individual users with Copilot Pro, Copilot Pro+, and Copilot Max plans.
#
# See script/in-product-messaging/README.md for the full setup guide,
# including how to run with --with-billing against a local billing-platform.
#
# Usage:
#   script/in-product-messaging/setup                              # Destroy then recreate all seed data
#   script/in-product-messaging/setup --destroy                    # Only destroy seed data (no recreate)
#   script/in-product-messaging/setup --with-billing               # Also create budget alert test accounts
#   script/in-product-messaging/setup --with-cq-banners            # Also create Code Quality upcoming-charges test accounts (temporary; campaign ends 2026-07-20)
#   script/in-product-messaging/setup --individual dashboard-cli   # Only recreate entities for a specific test user
#   script/in-product-messaging/setup --individual user-1,user-2   # Recreate entities for multiple test users
#   script/in-product-messaging/setup --multiples 5                # Create 5 copies of each user (username-0..username-4)
#   script/in-product-messaging/setup --individual dashboard-cli --multiples 3  # Create 3 copies of matching users
#   script/in-product-messaging/setup --with-cq-banners --individual ipm-cq-ent-owner,ipm-cq-org-admin  # CQ banners for specific users
#
# Prerequisites:
#   - script/server must be running (authzd, spokesd, etc. are required)
#   - For --with-billing: billing-platform must be running. In another tab:
#       script/setup-codespaces-billing-platform   # one-time per codespace
#       cd ../billing-platform && script/server
#
# This is a development-only script and should never be used in production.
#
# ----------------------------------------------------------------------------
# Member "Request a feature" surfaces (issue github/in-product-messaging#604)
# ----------------------------------------------------------------------------
# After a plain `script/in-product-messaging/setup`, these surfaces are seeded
# and reproducible by signing in (password: passworD1):
#
#   * Member request entry points — sign in as ipm-org-raf-cb-no-cb-org-mem1:
#       - Copilot from an org:       /settings/copilot
#       - Custom repo roles upsell:  /ipm-org-raf-cb-no-cb-org/test-repo/settings/access
#       - Branch protection warning: /ipm-org-raf-cb-no-cb-org/test-repo/settings/branches
#       - Empty-repo Copilot prompt: /ipm-org-raf-cb-no-cb-org/empty-demo
#   * Org admin manage surfaces — sign in as ipm-org-raf-cb-no-cb:
#       - Member requests hub:       /organizations/ipm-org-raf-cb-no-cb-org/settings/member_feature_requests
#       - Personal review nudge:     /settings/organizations
#   * Org seat-management requests — sign in as ipm-org-raf-cb-with-cb:
#       - /organizations/ipm-org-raf-cb-with-cb-org/settings/copilot/seat_management
#   * Enterprise coding-agent requests card — sign in as ipm-ent-cloud-agent:
#       - /enterprises/ipm-ent-cloud-agent-biz/ai-controls/agents/policies
#   * Stafftools opt-out — sign in as a site admin (e.g. monalisa):
#       - /stafftools/enterprises/ipm-ent-cloud-agent-biz
#
# Two member entry points CANNOT be auto-seeded and need manual steps:
#   * Draft PRs upgrade dialog (A3): temporarily add `draft_prs.private: false`
#     to the `free` plan's FREE_FEATURES block in config/plans.yml and restart
#     web (the default seed entitles draft_prs to all plans, so the upsell never
#     fires). Then, as mem1, open a compare view and pick "Create a draft pull
#     request". Revert config/plans.yml afterward.
#   * Code-editor Copilot popover (A5): gated entirely in the github-ui frontend
#     and not reproducible from the monolith dev environment.


require_relative "#{Rails.root}/config/environment"
# Force ActiveRecord::Base to load before FactoryBot. In development mode,
# the on_load(:active_record) hook in config/application.rb needs to resolve
# ApplicationRecord::Mysql1 before any autoloading chain references it,
# otherwise a circular dependency causes a NameError.
ActiveRecord::Base
require_relative "#{Rails.root}/script/seeds/objects"
require "#{Rails.root}/test/test_helpers/user_test_helpers"
require_relative "../seeds/factory_bot_loader"
require "logger"
require "securerandom"
require "net/http"
require "uri"

# Pre-load rbnacl to prevent NameError deep in the autoload chain when
# enabling Copilot Business (Copilot → PlaygroundDependency → RbNaCl::SimpleBox).
begin
  require "rbnacl"
rescue LoadError
  abort <<~MSG
    ERROR: rbnacl gem not available. This gem is required for Copilot Business setup.
    Try: gem install rbnacl
  MSG
end

LOGGER = Logger.new(STDERR)

# Verify that authzd and spokesd are reachable before doing any work.
# These services are started by script/server and are required for
# repository creation and authorization checks.
require "socket"
%w[8091 28081].each do |port|
  service = port == "8091" ? "authzd" : "spokesd"
  begin
    TCPSocket.new("127.0.0.1", port.to_i).close
  rescue Errno::ECONNREFUSED, Errno::EADDRNOTAVAIL
    abort <<~MSG
      ERROR: #{service} is not running on port #{port}.
      Please start script/server before running this script.
    MSG
  end
end

DEFAULT_PASSWORD = "passworD1"

module LoggingHelpers
  def title(string)
    LOGGER.info colorize(string, "yellow", style: :underline)
  end

  def yellow(string)
    LOGGER.info colorize(string, "yellow")
  end

  def green(string)
    LOGGER.info colorize(string, "green")
  end

  def log(string)
    LOGGER.info string
  end

  def colorize(string, color, options = {})
    background = options[:background] || options[:bg] || false
    style = options[:style]
    offsets = %w[gray red green yellow blue magenta cyan white]
    styles = %w[normal bold dark italic underline xx xx underline xx strikethrough]
    start = background ? 40 : 30
    color_code = start + (offsets.index(color) || 8)
    style_code = styles.index(style) || 0
    "\e[#{style_code};#{color_code}m#{string}\e[0m"
  end
end

unless Rails.env.development?
  raise "This script can only be run in the development environment"
end

# Retry helper for transient infrastructure timeouts (spokesd, authzd, gitrpc).
# Codespace services can lag under heavy seed data creation.
def with_retries(max_attempts: 5, base_delay: 10, on: [GitRPC::Timeout, GitRPC::NetworkError, Faraday::TimeoutError, RuntimeError, GitHub::Spokes::ClientError])
  attempts = 0
  begin
    attempts += 1
    yield
  rescue *on => e
    retryable = e.message.match?(/timed out|Timeout|INDETERMINATE|unavailable|502|Bad Gateway|connection refused/i)
    raise unless retryable
    raise if attempts >= max_attempts
    delay = base_delay * attempts # linear backoff: 10, 20, 30, 40s
    LOGGER.info "  -> Transient error (attempt #{attempts}/#{max_attempts}), retrying in #{delay}s... [#{e.class}: #{e.message.truncate(80)}]"
    sleep delay
    retry
  end
end

