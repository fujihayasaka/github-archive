      # alongside the upcoming-charges banner during QA.
      owner = User.find_by!(login: config[:owner])
      owner.dismiss_notice("ipm_test_transactional_banner_enterprise")
      log("  -> Pre-dismissed ipm_test_transactional_banner_enterprise for #{user_style(owner.login)}")

