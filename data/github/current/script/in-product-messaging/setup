# Dynamically populate entity identifier arrays from configuration
ALL_ORG_LOGINS = (
  ENTITY_CONFIG[:free_orgs].map { |e| e[:org] } +
  ENTITY_CONFIG[:team_orgs].map { |e| e[:org] } +
  ENTITY_CONFIG[:enterprises].map { |e| e[:org] } +
  ENTITY_CONFIG[:enterprise_trials].map { |e| e[:org] }.compact +
  BUDGET_ALERT_CONFIG[:organizations].map { |e| e[:org] } +
  BUDGET_ALERT_CONFIG[:enterprises].map { |e| e[:org] } +
  BUDGET_ALERT_CONFIG[:cost_centers].map { |e| e[:org] } +
  BUDGET_ALERT_CONFIG[:budget_request_orgs].map { |e| e[:org] } +
  BUDGET_ALERT_CONFIG[:budget_request_enterprises].map { |e| e[:org] } +
  BUDGET_ALERT_CONFIG[:budget_request_cost_centers].map { |e| e[:org] } +
  CQ_UPCOMING_CHARGES_CONFIG[:enterprises].map { |e| e[:org] } +
  CQ_UPCOMING_CHARGES_CONFIG[:organizations].map { |e| e[:org] }
).freeze

# Member logins derived from `cb_member_requests:` configs. These users
# never appear directly in ENTITY_CONFIG (they're computed as
# `<org_login>-mem<i>`), so they have to be enumerated explicitly so
# `destroy_seed_data` can clean them up on rerun.
raf_cb_free_members = ENTITY_CONFIG[:free_orgs].flat_map do |e|
  next [] unless e[:cb_member_requests]
  (1..e[:cb_member_requests][:count]).map { |i| "#{e[:org]}-mem#{i}" }
end
raf_cb_team_members = ENTITY_CONFIG[:team_orgs].flat_map do |e|
  next [] unless e[:cb_member_requests]
  (1..e[:cb_member_requests][:count]).map { |i| "#{e[:org]}-mem#{i}" }
end
RAF_CB_MEMBER_LOGINS = (raf_cb_free_members + raf_cb_team_members).freeze

# Admin logins derived from `coding_agent_member_requests:` configs. These
# org admins (login `<org_login>-admin<i>`) submit enterprise-billed
# CopilotCodingAgent requests and never appear directly in ENTITY_CONFIG,
# so enumerate them for `destroy_seed_data` cleanup on rerun.
CODING_AGENT_ADMIN_LOGINS = ENTITY_CONFIG[:enterprises].flat_map do |e|
  next [] unless e[:coding_agent_member_requests]
  (1..e[:coding_agent_member_requests][:count]).map { |i| "#{e[:org]}-admin#{i}" }
end
CODING_AGENT_ADMIN_LOGINS.freeze

ALL_USER_LOGINS = (
  ENTITY_CONFIG[:free_orgs].map { |e| e[:admin] } +
  ENTITY_CONFIG[:team_orgs].map { |e| e[:admin] } +
  ENTITY_CONFIG[:team_orgs].map { |e| e[:member] }.compact +
  ENTITY_CONFIG[:enterprises].map { |e| e[:owner] } +
  ENTITY_CONFIG[:enterprises].map { |e| e[:member] }.compact +
  ENTITY_CONFIG[:enterprise_trials].map { |e| e[:owner] } +
  ENTITY_CONFIG[:individual_users].map { |e| e[:login] } +
  BUDGET_ALERT_CONFIG[:organizations].map { |e| e[:admin] } +
  BUDGET_ALERT_CONFIG[:enterprises].map { |e| e[:owner] } +
  BUDGET_ALERT_CONFIG[:cost_centers].map { |e| e[:owner] } +
  BUDGET_ALERT_CONFIG[:budget_request_orgs].flat_map { |e| [e[:admin], e[:member]] } +
  BUDGET_ALERT_CONFIG[:budget_request_enterprises].flat_map { |e| [e[:owner], e[:member]] } +
  BUDGET_ALERT_CONFIG[:budget_request_cost_centers].flat_map { |e| [e[:owner], e[:member]] } +
  CQ_UPCOMING_CHARGES_CONFIG[:enterprises].map { |e| e[:owner] } +
  CQ_UPCOMING_CHARGES_CONFIG[:organizations].map { |e| e[:admin] } +
  RAF_CB_MEMBER_LOGINS +
  CODING_AGENT_ADMIN_LOGINS
).freeze

ALL_BUSINESS_SLUGS = (
  ENTITY_CONFIG[:enterprises].map { |e| e[:business] } +
  ENTITY_CONFIG[:enterprise_trials].map { |e| e[:business] } +
  BUDGET_ALERT_CONFIG[:enterprises].map { |e| e[:business] } +
  BUDGET_ALERT_CONFIG[:cost_centers].map { |e| e[:business] } +
  BUDGET_ALERT_CONFIG[:budget_request_enterprises].map { |e| e[:business] } +
  BUDGET_ALERT_CONFIG[:budget_request_cost_centers].map { |e| e[:business] } +
  CQ_UPCOMING_CHARGES_CONFIG[:enterprises].map { |e| e[:business] }
).freeze

# Returns true if any user-login field in a config hash starts with the given
# prefix. Used by --individual to select only entities belonging to a specific
# test user (e.g. "ipm-dashboard-cli" matches the CTA, dismiss, and setup
# accounts for the dashboard-cli test).
def entity_matches_individual?(config, prefix)
  %i[admin member owner login].any? { |key| config[key]&.start_with?(prefix) }
end

