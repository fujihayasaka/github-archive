  # ============================================

  def create_individual_copilot_users
    ensure_copilot_product_uuids_exist

    ENTITY_CONFIG[:individual_users].each do |config|
      create_individual_copilot_user(
        login: config[:login],
        plan: config[:plan]
      )

      seed_recent_copilot_cli_usage_if_needed(config[:login])

      create_user_multiples(login: config[:login], plan: config[:plan])

      if config[:dismiss_global_nudges]
        user = User.find_by!(login: config[:login])
        dismiss_global_transactional_nudges(user)
      end
    end
  end

  def seed_recent_copilot_cli_usage_if_needed(login)
    return unless RECENT_COPILOT_CLI_USAGE_LOGINS.include?(login)

    user = User.find_by(login: login)
    return if user.nil?

    ::InProductTargeting.domain.bulk_create_matches(matches: [
      {
        user_id: user.id,
        cohort: COPILOT_CLI_USAGE_COHORT,
        day: COPILOT_CLI_USAGE_SNAPSHOT_DAY,
        metadata: {},
      }
    ])

    log("  -> Seeded Copilot CLI recent-usage cohort for #{user_style(login)}")
  end

  def create_individual_copilot_user(login:, plan:)
    plan_label = case plan
    when :pro_plus then "Copilot Pro+"
    when :max then "Copilot Max"
    else "Copilot Pro"
    end
    log("-> Creating individual user #{user_style(login)} with #{plan_label}")

    user = User.find_by(login: login)
    if user
      ensure_user_has_billing_plan_subscription(user)

      # User exists - verify they have the correct plan
      copilot_user = Copilot::User.new(user)
      has_correct_plan = case plan
      when :pro then copilot_user.has_pro_subscription?
      when :pro_plus then copilot_user.has_pro_plus_subscription?
      when :max then copilot_user.has_max_subscription?
      end

      if has_correct_plan
        log("  -> Already exists with correct plan, skipping")
        log("")
        return
      end

      log("  -> User exists but needs correct plan, subscribing...")
      subscribe_to_copilot_plan(copilot_user, login, plan)
      ensure_active_copilot_plan(user, plan)
      log("")
      return
    end

    # Prefer a credit-card-backed factory when available, but fall back to a
    # regular verified user in environments where billing factories are absent.
    user = begin
      FactoryBot.create(:credit_card_user,
        login: login,
        password: DEFAULT_PASSWORD,
        email: "#{login}@github.test.com",
      )
    rescue KeyError
      existing_user = User.find_by(login: login)
      if existing_user
        existing_user
      else
        User.create!(
          login: login,
          password: DEFAULT_PASSWORD,
          email: "#{login}@github.test.com",
          require_email_verification: false,
          billing_attempts: 0,
          plan: "medium",
        )
      end
    end
    user.emails.map(&:verify!)
    log("  -> User: #{user_style(user.login)}")

    # Create billing plan subscription (required for Copilot subscriptions)
    FactoryBot.create(:billing_plan_subscription, :zuora, user: user)
    log("  -> Billing plan subscription: created")

    # Subscribe to the appropriate Copilot plan
    copilot_user = Copilot::User.new(user)
    subscribe_to_copilot_plan(copilot_user, login, plan)
    ensure_active_copilot_plan(user, plan)

    log("")
  end

  def subscribe_to_copilot_plan(copilot_user, login, plan)
    case plan
    when :pro
      # subscribe(:month) can intermittently leave a cancelled subscription item
      # (quantity = 0) in this environment — the same flakiness documented for
      # :pro_plus below — which leaves the user on plan `free` without Copilot Pro
      # access. Enforce a direct active Pro subscription item for deterministic
      # seed data instead.
      ensure_active_copilot_plan(copilot_user.user_object, :pro)
      log("  -> Copilot Pro: subscribed (monthly)")
    when :pro_plus
      # subscribe_pro_plus can leave a cancelled item in this environment (quantity = 0),
      # so enforce a direct active Pro+ subscription item for deterministic seed data.
      ensure_active_copilot_plan(copilot_user.user_object, :pro_plus)
      log("  -> Copilot Pro+: subscribed (monthly)")
    when :max
      ensure_active_copilot_plan(copilot_user.user_object, :max)
      log("  -> Copilot Max: subscribed (monthly)")
    end
  end

  def ensure_user_has_billing_plan_subscription(user)
    return if user.plan_subscription

    FactoryBot.create(:billing_plan_subscription, :zuora, user: user)
    log("  -> Billing plan subscription: created")
  end

  def ensure_active_copilot_plan(user, plan)
    expected_product_key = case plan
    when :pro then Copilot::INDIVIDUAL_PRO_PRODUCT_KEY
    when :pro_plus then Copilot::INDIVIDUAL_PRO_PLUS_PRODUCT_KEY
    when :max then Copilot::INDIVIDUAL_MAX_PRODUCT_KEY
    end

    active_subscription_item = Copilot::User.new(user.reload).copilot_active_subscription_item
    return if active_subscription_item&.product_identifier&.product_key == expected_product_key

    product_uuid = Billing::ProductUUID.find_by!(
      product_type: Copilot::PRODUCT_TYPE,
      product_key: expected_product_key,
      billing_cycle: "month",
    )
    copilot_product_uuid_ids = Billing::ProductUUID.where(
      product_type: Copilot::PRODUCT_TYPE,
      product_key: Copilot::INDIVIDUAL_PRODUCT_KEYS,
    ).pluck(:id)

    Billing::SubscriptionItem.for_account(user).where(
      subscribable_type: "Billing::ProductUUID",
      subscribable_id: copilot_product_uuid_ids,
    ).update_all(quantity: 0)

    expected_subscription_item = Billing::SubscriptionItem.for_account(user).find_by(
      subscribable_type: "Billing::ProductUUID",
      subscribable_id: product_uuid.id,
    )

    if expected_subscription_item
      expected_subscription_item.update_columns(quantity: 1, free_trial_ends_on: nil)
    else
      Billing::SubscriptionItem.create!(
        plan_subscription: user.plan_subscription,
        subscribable: product_uuid,
        quantity: 1,
      )
    end

    log("  -> Copilot plan corrected to #{expected_product_key} (monthly)")
  end

  # Dismiss all global transactional message nudges for a user so that
  # page-specific test banners are not suppressed by global banners.
  # This iterates over TRANSACTIONAL_MESSAGES dynamically so new global
  # nudges are automatically dismissed on the next setup run.
  def dismiss_global_transactional_nudges(user)
    global_nudges = InProductTargeting::TransactionalMessageConcern::TRANSACTIONAL_MESSAGES.select(&:global)
    global_nudges.each do |msg|
      user.dismiss_notice(msg.nudge_id.to_s)
    end
    log("  -> Dismissed #{global_nudges.size} global transactional nudge(s) for #{user_style(user.login)}")
  end

  def safe_dismiss_notice(user, notice_name)
    user.dismiss_notice(notice_name)
    log("  -> Pre-dismissed #{notice_name} for #{user_style(user.login)}")
  rescue ArgumentError
    # Notice not registered (e.g., running --individual without full setup);
    # safe to skip since the banner won't render anyway.
  end

  def ensure_copilot_product_uuids_exist
    # Ensure Copilot product UUIDs exist for individual subscriptions.
    # Create all copilot product UUIDs, individually rescuing duplicates
    # so that missing ones are still created even if some already exist.
    created = 0
    copilot_product_uuid_definitions.each do |attrs|
      Billing::ProductUUID.create!(attrs)
      created += 1
    rescue ActiveRecord::RecordInvalid => e
      raise unless e.message =~ /has already been taken/
    end
    log("  -> Copilot product UUIDs: #{created > 0 ? "created #{created} new" : "all exist"}")
  end

