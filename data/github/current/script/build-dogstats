#!/bin/bash
#/ Usage: build-dogstats
#/
#/ Build and install the version specified in config/dogstats-version.
#/ This is run automatically by script/bootstrap for all development environments.
#/
set -e
unset CDPATH

# show usage
if [ "$1" = "--help" ]; then
    grep ^#/ <"$0" |cut -c4-
    exit
fi

# change into root project dir
cd "$(dirname "$0")/.."

# revision where we should build
pinned=$(grep -v ^# config/dogstats-version)
revision="${1:-$pinned}"
short_revision="$(echo $revision | cut -c1-10)"

# dogstats repository URL to clone from. this assumes that SSH is setup properly for
# the current user.
giturl="$(./script/gh-clone-url github/dogstats)"

# build path locations
builddir="vendor/dogstats"
installdir="script/ci/bin"
logfile="log/dogstats-build.log"

# fetch the remote repository into the builddir
fetch() {
    progress=
    [ -t 1 ] && progress="--progress"
    git --git-dir="$builddir/.git" \
        fetch -u -q $progress --prune --force "$giturl" "+refs/heads/*:refs/heads/*"
}

check_dogstats() {
    if [ "$revision" = "$(cat "$installdir/dogstats-version" 2>/dev/null)" ] && [ -x "$installdir/dogstats" ]; then
        return 0
    else
        return 1
    fi
}

# bail if the already built revision is up-to-date
if check_dogstats; then
    echo "dogstats build $short_revision is up-to-date."
    exit 0
fi

# clone or fetch the git repo if needed
if [ ! -d "$builddir/.git" ]; then
    echo "Fetching $giturl for the first time. This may take a while." 2>&1
    git init -q "$builddir"
    fetch
elif [ "$pinned" != "$revision" ]; then
    echo "Fetching $giturl for update ..." 2>&1
    fetch
elif ! git --git-dir="$builddir/.git" cat-file -e "$revision" 2>/dev/null; then
    echo "Fetching $giturl for update ..." 2>&1
    fetch
fi

# resolve requested revision to commit oid.
commit=$(git --git-dir="$builddir/.git" rev-parse --verify -q "$revision" || true)
if ! git --git-dir="$builddir/.git" cat-file -e "$commit" 2>/dev/null ; then
    echo "ERROR: Revision not found: $revision" 2>&1
    exit 1
fi

# prep install dir
mkdir -p "$installdir"
prefix=$(cd "$installdir" && pwd)

# change in and build some stuff
echo "dogstats build at $(echo $commit | cut -c1-10) commencing (see $logfile) ..."
set +e
(
    set -ex
    echo "Building dogstats at $(echo $commit | cut -c1-10) ..."
    cd "$builddir"
    # [ ! -e ssh_host_key.dev ] && ssh-keygen -N "" -m PEM -t rsa -f ssh_host_key.dev
    # [ ! -e dss_host_key.dev ] && ssh-keygen -N "" -m PEM -t ssh-dss -f dss_host_key.dev
    time git --git-dir=".git" --work-tree="." reset --hard "$commit"
    time go mod vendor
    time go build -o "$prefix/dogstats" -v -ldflags "-s -w" ./cmd/dogstats/main.go
) 1> "$logfile" 2>&1
res=$?
set -e

# check for failure
if [ $res -ne 0 ]; then
    echo "!! dogstats build failed oh no. The last lines of output follow:" 2>&1
    tail -n 100 "$logfile"
    echo "** See $logfile for more ..." 2>&1
    exit $res
fi

# write the current build version file
echo "$commit" > "$installdir/dogstats-version"

# if a <branch> was given, and it resolves
cat <<-EOF > config/dogstats-version
# dogstats version built into development environments.
# See 'script/build-dogstats --help' for info on changing this file.
$commit
EOF

echo "$installdir/dogstats installed at $installdir."
true
