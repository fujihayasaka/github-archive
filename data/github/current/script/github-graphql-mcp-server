# this is a temporary solution until the official github mcp server gets graphql support
# https://github.com/github/github-mcp-server/issues/338

npm install -g mcp-graphql

export ENDPOINT=https://api.github.com/graphql
export HEADERS='{"Authorization":"Bearer '"$GITHUB_TOKEN"'"}'
export NAME="GitHub GraphQl"
export ALLOW_MUTATIONS=false

npx mcp-graphql
