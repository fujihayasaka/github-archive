#!/bin/bash
set -e

GREEN='\033[0;32m'
NC='\033[0m' # No Color

if [[ ${CODESPACES} != "true" ]]; then
  echo -e "This is a dev-only script"
  exit 1
fi

echo -e "\n${GREEN}Enabling Copilot chat agent sessions feature flags...\n${NC}"

bin/toggle-feature-flag enable \
  copilot_immersive_agent_sessions

echo -e "\n${GREEN}Done!\n${NC}"
