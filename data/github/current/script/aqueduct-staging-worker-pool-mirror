#!/usr/bin/env safe-ruby
# frozen_string_literal: true

#
# Usage: ./script/aqueduct-staging-worker-pool-mirror

require "optparse"
require_relative "../config/environment"
require_relative "../lib/background_job_queues"
require "yaml"

DEFAULT_AQUEDUCT_STAGING_CONFIG = "config/background_job_queues/aqueduct_staging.yml"

options = {
  environment: :dotcom,
  worker_role: :fakeworker,
  machine_type: :kube,
  prefix_queue_name: "aqs_",
  file_path: DEFAULT_AQUEDUCT_STAGING_CONFIG
}

OptionParser.new do |opts|
  opts.banner = "Usage: script/aqueduct-staging-worker-pool-mirror [options]"

  opts.on("--save", "Save the output to a file") do
    options[:save] = true
  end

  opts.on("--queues-env ENV", "Specify the queues environment") do |env|
    options[:queues_env] = env.to_sym
  end

  opts.on("--worker-role ROLE", "Specify the worker role to mirror") do |role|
    options[:worker_role] = role.to_sym
  end

  opts.on("--worker-type TYPE", "Specify the worker type") do |type|
    options[:worker_type] = type.to_sym
  end

  opts.on("--file-path", "Save the output to a specific file") do |file_path|
    options[:file_path] = file_path
  end

  opts.on("--prefix-queue-name", "Prefix of all queue names generated") do |prefix|
    options[:prefix_queue_name] = prefix
  end
end.parse!

# This script mirrors the worker pool queues from a specified environment to the Aqueduct Staging environment.
# This function deals with the transformation of the queue configurations associated to a specific environment,
# worker pool and machine type so that we run these queues in the staging worker pools with the same setup.
# These queues will not take production jobs, just staging jobs mostly generated by the pipeline-monitor.
def mirror_worker_pool_queues(environment: :dotcom, worker_role:, machine_type: :kube, prefix_queue_name: "")
  allowed_environments = BackgroundJobQueues.allowed_environments
  result = []
  if !allowed_environments.include?(environment)
    # All queue configurations for a specific environment, worker pool and machine type
    queue_configurations = BackgroundJobQueues.queue_configurations_for_worker_pool_and_type(environment: environment, worker_role: worker_role, machine_type: machine_type)

    # We need to trim the worker types that are not the ones we are asking for
    # This is a transformation of the queue configurations associated to a specific environment,
    # worker pool and machine type so that we run these queues in the staging worker pools with the # same setup
    result = queue_configurations.map do |queue_name, queue_configuration|
      new_queue_name = "#{prefix_queue_name}#{queue_name}"

      transformed_queue_config = {
        "#{new_queue_name}" => {
          dotcom: false,
          enterprise: false,
          proxima: false,
          staging: {
            stagingworker: {
              "#{machine_type}": queue_configuration[environment][worker_role][machine_type],
            }
          },
          staff: false,
          development: false,
        }
      }

      # Only add scheduling_hints if it is present and not empty
      scheduling_hints = queue_configuration[:scheduling_hints].reject { |k, _| k == :should_start_within_secs } if queue_configuration[:scheduling_hints]

      unless scheduling_hints.nil? || scheduling_hints.empty?
        # Insert scheduling_hints as the first child key in the hash, just to keep consistency with
        # the rest of the configs. This is suboptimal but it is a one-time operation and keeps
        # consistency visually.
        transformed_queue_config["#{new_queue_name}"] = { scheduling_hints: scheduling_hints }.merge(transformed_queue_config["#{new_queue_name}"])
      end

      transformed_queue_config
    end
  else
    puts "Wrong environment. Try one of these: #{allowed_environments.join(",")}"
    exit(0)
  end
end

# Convert array of single-key hashes to a single hash.
# This is a transformation to keep consistent our staging config with the rest.
def stringify_result(queue_configs)
  # Convert array of single-key hashes to a single hash
  final_result = queue_configs.reduce({}) { |acc, h| acc.merge(h) }

  # Recursively convert all symbol keys to strings
  def deep_stringify_keys(obj)
    case obj
    when Hash
      obj.each_with_object({}) do |(k, v), h|
        h[k.to_s] = deep_stringify_keys(v)
      end
    when Array
      obj.map { |v| deep_stringify_keys(v) }
    else
      obj
    end
  end

  deep_stringify_keys(final_result)
end

# Saves the queue configurations to a YAML file
# This function does not do pre-treatment of the information, it just dumps the data into a specific file path
def save_to_disk(file_path, data)
  File.open(file_path, "w") do |file|
    file.write(data.to_yaml(line_width: -1))
  end
end

# Runtime execution
new_queue_configs = mirror_worker_pool_queues(
  environment: options[:queues_env],
  worker_role: options[:worker_role],
  machine_type: options[:worker_type],
  prefix_queue_name: options[:prefix_queue_name],
)

data = stringify_result(new_queue_configs)

if options[:save]
  file_path = options[:file_path] || DEFAULT_AQUEDUCT_STAGING_CONFIG
  save_to_disk(file_path, data)
  puts "Generated queue configurations on config file: #{file_path}"
else
  puts data.to_yaml(line_width: -1)
end
