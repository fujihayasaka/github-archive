#!/usr/bin/env ruby
# typed: true
# frozen_string_literal: true

require_relative "dx/telemetry/telemetry"

settings = [DX::Telemetry::USER_TAG, DX::Telemetry::RESILIENT]
elapsed_time = ARGV[0]
result = ARGV[1] || "success"
DX::Telemetry.monitor_script_runtime_with_value("dx.monolith.bootstrap.time", elapsed_time.to_f, tags: ["result:#{result}"], settings: settings)
