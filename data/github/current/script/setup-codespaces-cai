#!/bin/bash
set -e

# This script sets up the github/coding-agent-integrations repository for a github/github codespace.

#=============================================================================
# CONSTANTS AND CONFIGURATION
#=============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default settings. If the user provides options, these will be updated accordingly.
BRANCH=main
DELETE_REPO=false
ADD_WORKSPACE=false

#=============================================================================
# HELPER FUNCTIONS
#=============================================================================

# Prints a help menu describing the script and its options.
help() {
   echo "Sets up the github/coding-agent-integrations repository for a github/github codespace."
   echo
   echo "Usage: setup-codespaces-cai [-b branch] [-d|h|w] "
   echo
   echo "Options:"
  echo " -b     Specify the coding-agent-integrations branch to clone. Defaults to main if not provided."
   echo "  -d     Before starting, delete the existing coding-agent-integrations and copilot-api directories in the codespace."
   echo "  -w     Add the coding-agent-integrations repo as a workspace in VS Code."
   echo "  -h     Print this help message."
   echo
}

# Prints the script banner.
banner() {
  echo -e "${GREEN}"
cat << 'EOF'

   ██████╗ ██████╗ ██████╗ ██╗███╗   ██╗ ██████╗
  ██╔════╝██╔═══██╗██╔══██╗██║████╗  ██║██╔════╝
  ██║     ██║   ██║██║  ██║██║██╔██╗ ██║██║  ███╗
  ██║     ██║   ██║██║  ██║██║██║╚██╗██║██║   ██║
  ╚██████╗╚██████╔╝██████╔╝██║██║ ╚████║╚██████╔╝
   ╚═════╝ ╚═════╝ ╚═════╝ ╚═╝╚═╝  ╚═══╝ ╚═════╝

   █████╗  ██████╗ ███████╗███╗   ██╗████████╗
  ██╔══██╗██╔════╝ ██╔════╝████╗  ██║╚══██╔══╝
