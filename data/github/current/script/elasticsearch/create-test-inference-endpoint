#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/utils"
source "$SCRIPT_DIR/inference-helpers"

apply_license

endpoint_name="${1:-test-endpoint}"
model_id="${2:-${ES_TEST_MODEL_ID:-.multilingual-e5-small}}"

echo "Ensuring semantic inference endpoint '${endpoint_name}' is available for tests"
create_inference_endpoint "$endpoint_name" "$model_id"
