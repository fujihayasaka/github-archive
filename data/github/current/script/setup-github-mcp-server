#!/bin/bash
set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "\n${GREEN}➡️ Setting up GitHub MCP Server...\n${NC}"

# Check if the MCP server repository already exists
if [ ! -d "/workspaces/github-mcp-server-remote" ]; then
  echo -e "${GREEN}➡️ Cloning github-mcp-server-remote repository...\n${NC}"
  cd /workspaces
  gh repo clone github/github-mcp-server-remote
else
  echo -e "${GREEN}➡️ MCP server repository already exists, skipping clone...\n${NC}"
fi

echo -e "\n${GREEN}➡️ Enabling copilot_api_dotcom_chat_use_github_mcp_server feature flag...\n${NC}"
cd /workspaces/github
./bin/toggle-feature-flag enable copilot_api_dotcom_chat_use_github_mcp_server

echo -e "\n${GREEN}➡️ Enabling copilot-api-github-write-skill feature flag...\n${NC}"
cd /workspaces/github
./bin/toggle-feature-flag enable copilot-api-github-write-skill

echo -e "\n${GREEN}➡️ Start the server through overmind or manually with 'script/github-mcp-server-remote'...\n${NC}"

