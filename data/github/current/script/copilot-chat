#!/bin/bash

# Usage: script/copilot-chat
# Start the github/copilot-chat web server if the repository has been cloned in the Codespace, or no-op otherwise.

set -e

if test -f /workspaces/copilot-chat/Makefile; then
  echo "Starting Copilot Chat server..."
  cd /workspaces/copilot-chat

  make rest run
else
  echo "github/copilot-chat repository has not been cloned, sleeping."
  echo "If you want to run the Copilot Chat server, first run 'script/setup-copilot-chat-service',"
  echo "then 'overmind restart copilot-chat'."
  sleep infinity
fi
