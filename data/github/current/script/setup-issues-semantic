#!/bin/bash
#
# Setup script for local semantic search on issues and pull requests development
# See: https://github.com/github/copilot-indexing-issues-prs/blob/main/docs/local-development-setup.md
#
# Prerequisites:
#   - Access to a GitHub Codespace in github/github
#   - API key from the team (reach out on #copilot-semantic-indexing if needed)
#
# Usage:
#   export ISSUES_SEMANTIC_API_KEY='your-api-key'
#   script/setup-issues-semantic              # Setup only
#   script/setup-issues-semantic --seed       # Setup + seed test data (issues & PRs)

set -e

SEED_DATA=false
for arg in "$@"; do
  case "$arg" in
    --seed) SEED_DATA=true ;;
  esac
done

echo "=== Setting up Semantic Issues & PR Search Local Development ==="
echo

# Step 1: Enable feature flags
echo "Step 1: Enabling feature flags..."
bin/toggle-feature-flag enable issues_semantic_available
bin/toggle-feature-flag enable copilot_semantic_indexing_source_fields
bin/toggle-feature-flag enable copilot_semantic_indexing_source_fields_prs
bin/toggle-feature-flag enable semantic_search_prs_rollout
bin/toggle-feature-flag enable semantic_search_prs
bin/toggle-feature-flag enable issues_normalize_query_embedding_vectors

echo
echo
echo "=== Setup Complete! ==="
echo "You can now create issues and test semantic search locally."

# Step 2: Optionally seed test data with semantic issues and PRs
if [ "$SEED_DATA" = true ]; then
  echo
  echo "Step 2: Seeding test data (issues and PRs with semantic content)..."
  bin/seed semantic_retrieval --repos 2
  echo "Seed data created. Issues and PRs have been indexed with semantic vectors."
else
  echo
  echo "To seed test data with semantically rich issues and PRs, re-run with --seed:"
  echo "  script/setup-issues-semantic --seed"
fi
