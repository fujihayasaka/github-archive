#!/bin/bash

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
GITHUB_ROOT="${SCRIPT_DIR}/.."

source $SCRIPT_DIR/dx/lib/subproject-containers

# Note: If this directory doesn't exist or is empty, run `./script/build-subproject usersd`
USERSD_VENDOR_PATH="${GITHUB_ROOT}/vendor/usersd"
USERSD_BIN="${USERSD_VENDOR_PATH}/bin/usersd"

if [ ! -d "$USERSD_VENDOR_PATH" ]; then
    echo "Directory $USERSD_VENDOR_PATH does not exist, you need to clone usersd"
    exit 1
fi

export PORT=1346
export GITHUB_TELEMETRY_LOGS_LEVEL=debug
export APP_NAME="usersd"
export DD_SERVICE="usersd"
export CATALOG_SERVICE="github/usersd"
export IS_ENTERPRISE_SERVER="false"
export USERS_MYSQL_AVAILABLE="true"
export USERS_COSMOS_AVAILABLE="false"

# decides which database to use: dev or test
case "$1" in
  --test)
    echo "usersd will use dotcom test databases"
    export DATABASE_CONFIG_PATH=${DATABASE_CONFIG_PATH:-./config/db.test.yaml}

    shift ;;
  *)
    echo "usersd will use dotcom development databases"
    export DATABASE_CONFIG_PATH=${DATABASE_CONFIG_PATH:-./config/db.development.yaml}
esac

# Environment variables to pass to the container
env_vars=(
  GITHUB_TELEMETRY_LOGS_LEVEL
  APP_NAME
  DD_SERVICE
  CATALOG_SERVICE
  PORT
  DATABASE_CONFIG_PATH
  IS_ENTERPRISE_SERVER
  USERS_MYSQL_AVAILABLE
  USERS_COSMOS_AVAILABLE
)

# Write environment variables to a temporary file to be used by the container
ENV_FILE=$(mktemp)

for var in "${env_vars[@]}"; do
  if [ "${!var+x}" ]; then
    echo "$var=${!var}" >> "$ENV_FILE"
  fi
done

start_usersd() {
  cd "$USERSD_VENDOR_PATH" || exit 1

  # Build if binary doesn't exist
  if [ ! -f "$USERSD_BIN" ]; then
    echo "No usersd binary found at $USERSD_BIN, building..."
    make build || exit 1
  fi

  exec "$USERSD_BIN"
}

start_usersd_docker() {
  # Run the service as a container using an image published via GitHub Actions for PRs or merges to main
  # The commit sha is defined in /config/usersd-version
  SUBPROJECT_VERSION=$(subproject_version "usersd")
  CONTAINER_NAME="usersd-${PORT}"

  start_subproject --name=$CONTAINER_NAME \
    --entrypoint /app/bin/usersd \
    --env-file "$ENV_FILE" \
    --volume $(pwd)/tmp/$CONTAINER_NAME:/tmp/ \
    "ghcr.io/github/usersd/dev:$SUBPROJECT_VERSION"
}

if [[ "$DX_EDGE" = true ]] && [[ "$DX_FEATURE_SUBPROJECT_CONTAINERS" = true ]]; then
  start_usersd_docker
elif [ "$GITHUB_CI" = "1" ] || [ "$GITHUB_USE_DOCKER" = "1" ]; then
  if [[ "$DX_FEATURE_SUBPROJECT_CONTAINERS" = true ]]; then
    start_usersd_docker
  else
    start_usersd
  fi
else
  if [ ! -x "${USERSD_BIN}" ]; then
  cat << EOF
The usersd server is not built and could not be started.

In order to address this:
 - build usersd: run script/build-subproject usersd
 - test usersd works: run script/usersd-server to check the server is working as expected.

This script will block indefinitely in order to avoid breaking bin/server

If you keep seeing this message, please contact #usersd
EOF
  fi
  until [ -x "${USERSD_BIN}" ]; do sleep 60; done
  start_usersd
fi
