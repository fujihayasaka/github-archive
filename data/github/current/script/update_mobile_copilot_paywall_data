#!/usr/bin/env ruby
# typed: false
# frozen_string_literal: true

# Script to fetch Contentful paywall data and update data.json
# Run with: bin/rails runner script/update_mobile_copilot_paywall_data
#
# This script fetches the latest paywall data from Contentful and updates
# the JSON data file used by Mobile::Copilot::Paywall::Data.

DATA_JSON_PATH = "packages/mobile/app/models/mobile/copilot/paywall/data.json"

puts "Fetching paywall data from Contentful..."
raw_data = Mobile::Copilot::Paywall::Contentful::Fetcher.fetch

if raw_data.nil?
  puts "ERROR: Could not fetch data from Contentful."
  puts "Make sure the Contentful credentials are configured."
  exit 1
end

puts "Mapping Contentful data to paywall models..."
paywall = Mobile::Copilot::Paywall::Contentful::Mapper.map(raw_data)

puts "Writing updated data.json..."
File.write(DATA_JSON_PATH, JSON.pretty_generate(paywall.to_hash) + "\n")

puts "Done! Updated #{DATA_JSON_PATH}"
