#!/bin/bash
set -euo pipefail

GREEN='\033[0;32m'
NC='\033[0m' # No Color

FLAGS=(
  copilot_code_review_findings_ui
  prx_files
  copilot_code_review_batch_apply_suggestions
)

echo -e "\n${GREEN}➡️ Enabling Copilot Findings feature flags...${NC}\n"

for flag in "${FLAGS[@]}"; do
  echo -e "${GREEN}➡️ Enabling ${flag}...${NC}"
  ./bin/toggle-feature-flag enable "$flag"
done

echo -e "\n${GREEN}✅ Setup complete. All feature flags enabled.${NC}\n"
