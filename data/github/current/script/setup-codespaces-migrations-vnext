#!/bin/bash
set -e

# This script sets up the github/migrations-vnext repository for a github/github codespace.

RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Install git-lfs if needed
install_git_lfs() {
   echo -e "\n${GREEN}➡️ Checking for git-lfs installation...\n${NC}"

   if command -v git-lfs >/dev/null 2>&1; then
      echo -e "${GREEN}INFO: git-lfs is already installed${NC}"
      return 0
   fi

   echo -e "${GREEN}INFO: Installing latest git-lfs${NC}"

   TEMP_DIR=$(mktemp -d)
   if [ $? -ne 0 ]; then
      echo -e "${RED}ERROR: Failed to create temporary directory${NC}"
      return 1
   fi

   trap "rm -rf '$TEMP_DIR'" EXIT

   echo -e "${BLUE}Fetching latest git-lfs version...${NC}"
   GIT_LFS_VERSION=$(curl -s https://api.github.com/repos/git-lfs/git-lfs/releases/latest | grep '"tag_name":' | sed -E 's/.*"v([^"]+)".*/\1/')

   if [ -z "$GIT_LFS_VERSION" ]; then
      echo -e "${RED}ERROR: Failed to fetch latest git-lfs version${NC}"
      return 1
   fi

   echo -e "${GREEN}INFO: Latest git-lfs version is $GIT_LFS_VERSION${NC}"

   DOWNLOAD_URL="https://github.com/git-lfs/git-lfs/releases/latest/download/git-lfs-linux-amd64-v${GIT_LFS_VERSION}.tar.gz"
   DOWNLOAD_PATH="$TEMP_DIR/git-lfs.tar.gz"

   echo -e "${BLUE}Downloading git-lfs from $DOWNLOAD_URL${NC}"
   if ! curl -L "$DOWNLOAD_URL" -o "$DOWNLOAD_PATH"; then
      echo -e "${RED}ERROR: Failed to download git-lfs${NC}"
      return 1
   fi

   echo -e "${BLUE}Extracting git-lfs archive${NC}"
   if ! tar -xzf "$DOWNLOAD_PATH" -C "$TEMP_DIR"; then
      echo -e "${RED}ERROR: Failed to extract git-lfs archive${NC}"
      return 1
   fi

   GIT_LFS_BINARY="$TEMP_DIR/git-lfs-$GIT_LFS_VERSION/git-lfs"
   if [ ! -f "$GIT_LFS_BINARY" ]; then
      echo -e "${RED}ERROR: git-lfs binary not found at $GIT_LFS_BINARY${NC}"
      return 1
   fi

   echo -e "${BLUE}Installing git-lfs binary to /usr/local/bin${NC}"
   if ! sudo cp "$GIT_LFS_BINARY" /usr/local/bin/git-lfs; then
      echo -e "${RED}ERROR: Failed to install git-lfs binary${NC}"
      return 1
   fi

   sudo chmod +x /usr/local/bin/git-lfs

   echo -e "${GREEN}INFO: git-lfs binary installed successfully${NC}"
   return 0
}

# Function to print help message
help() {
   echo "Sets up the github/migrations-vnext and github/elm-exporter repositories for a github/github codespace."
   echo
   echo "Usage: setup-codespaces-migrations-vnext [--branch BRANCH] [--delete] [--exporter-branch BRANCH] [--help]"
   echo "Options:"
   echo "-b, --branch BRANCH              Specify the migrations-vnext branch to clone. Defaults to main if not provided."
   echo "-d, --delete                     Before starting, delete the existing migrations-vnext directory in the codespace."
   echo "    --exporter-branch BRANCH     Specify the elm-exporter branch to clone. Defaults to main if not provided."
   echo "-h, --help                       Print this help message."
   echo
}

# Set the branch as main. If a branch is provided as an argument, it will be set to that when we parse the provided options.
BRANCH=main
EXPORTER_BRANCH=main

# Parse command line arguments
while [[ $# -gt 0 ]]; do
   case $1 in
   -h|--help)
      help
      exit 0
      ;;
   -b|--branch)
      if [ -z "$2" ] || [[ "$2" == -* ]]; then
         echo "Error: --branch requires a branch name argument"
         help
         exit 1
      fi
      BRANCH="$2"
      shift 2
      ;;
   -d|--delete)
      DELETE_REPO=true
      shift
      ;;
   --exporter-branch)
      if [ -z "$2" ] || [[ "$2" == -* ]]; then
         echo "Error: --exporter-branch requires a branch name argument"
         help
         exit 1
      fi
      EXPORTER_BRANCH="$2"
      shift 2
      ;;
   *)
      echo "Error: Unknown option $1"
      help
      exit 1
      ;;
   esac
done

if [ "$DELETE_REPO" = true ]; then
   echo -e "\n${GREEN}➡️ Deleting the existing migrations-vnext repo...\n${NC}"
   sudo rm -rf /workspaces/migrations-vnext
fi

# Install git-lfs before cloning since the repo uses it
install_git_lfs

# Do a clone of migrations-vnext to the same dir as the github/github repo.
# If a branch was supplied, use that branch for the clone.
echo -e "\n${GREEN}➡️ Cloning migrations-vnext repo at branch $BRANCH...\n${NC}"
git clone https://github.com/github/migrations-vnext /workspaces/migrations-vnext --branch $BRANCH

# Set up git-lfs for the migrations-vnext repository
echo -e "\n${GREEN}➡️ Setting up git-lfs for migrations-vnext repo...\n${NC}"
git -C /workspaces/migrations-vnext lfs install
git -C /workspaces/migrations-vnext lfs pull

echo -e "\n${GREEN}➡️ Installing deps...\n${NC}"

# install 'mise' to manage go and other tool versions.
if ! command -v mise >/dev/null 2>&1; then
   echo -e "${GREEN}➡️ Installing mise...\n${NC}"
   curl https://mise.run | sh

   # ensure mise is set in bash and zsh profiles for future sessions
   MISE_PATH=$HOME/.local/bin/mise
   echo 'eval "$('$MISE_PATH' activate bash)"' >>~/.bashrc
   echo 'eval "$('$MISE_PATH' activate zsh)"' >>~/.zshrc

   # also activate it in the current shell
   eval "$($MISE_PATH activate bash)"

   echo -e "${GREEN}➡️ Mise installed! Either open a new shell to enable it, or run 'eval \"\$($MISE_PATH activate bash)\"' in your current shell \n${NC}"
fi

# enable the idiomatic version file support in mise for node and ruby; this lets dotcom
# versions work too.
mise settings add idiomatic_version_file_enable_tools node

# Install a specific version of pandoc for consistency
mise settings experimental=true
mise --cd /workspaces/migrations-vnext trust
mise --cd /workspaces/migrations-vnext install

# activate mise for the current shell session
#   so the go tools are installed under the bin of the managed go version
eval "$(mise activate bash)"

# Install Go tools using the tools.go pattern
echo -e "\n${GREEN}➡️ Installing Go development tools...\n${NC}"
cd /workspaces/migrations-vnext && make install-tools

echo -e "\n${GREEN}➡️ Adding /workspaces/migrations-vnext folder to workspace...\n${NC}"
code --add /workspaces/migrations-vnext

echo -e "\n${GREEN}➡️ Setting up elm-exporter repository...\n${NC}"

if [ "$DELETE_REPO" = true ]; then
   echo -e "\n${GREEN}➡️ Deleting the existing elm-exporter repo...\n${NC}"
   sudo rm -rf /workspaces/elm-exporter
fi

# Clone elm-exporter to the same dir as the github/github repo.
echo -e "\n${GREEN}➡️ Cloning elm-exporter repo at branch $EXPORTER_BRANCH...\n${NC}"
git clone https://github.com/github/elm-exporter /workspaces/elm-exporter --branch "$EXPORTER_BRANCH"

# Set up git-lfs for the elm-exporter repository
echo -e "\n${GREEN}➡️ Setting up git-lfs for elm-exporter repo...\n${NC}"
git -C /workspaces/elm-exporter lfs install
git -C /workspaces/elm-exporter lfs pull

echo -e "\n${GREEN}➡️ Installing elm-exporter deps...\n${NC}"

# Install Go tools for elm-exporter
mise --cd /workspaces/elm-exporter trust
mise --cd /workspaces/elm-exporter install

# Install dependencies using make deps
echo -e "\n${GREEN}➡️ Installing Go dependencies for elm-exporter...\n${NC}"
cd /workspaces/elm-exporter && make deps

echo -e "\n${GREEN}➡️ Adding /workspaces/elm-exporter folder to workspace...\n${NC}"
code --add /workspaces/elm-exporter

# Setup .netrc file for GOPROXY module auth
echo -e "\n${GREEN}➡️ Setting up .netrc file for GOPROXY module authentication...\n${NC}"
echo "machine goproxy.githubapp.com login nobody password $GITHUB_TOKEN" > "$HOME/.netrc"
chmod 600 "$HOME/.netrc"

echo -e ""
echo -e "${GREEN}🎉🎉 FINISHED! The github/migrations-vnext and github/elm-exporter repositories have been set up! 🎉🎉"
echo -e "Prior to running a live migration, you'll need to start GitHub in proxima mode. To do this, run the following commands:${NC}"
echo -e ""
echo -e "${ORANGE}cd /workspaces/github"
echo -e "${ORANGE}DOMAIN_NAME=avocado-gmbh.ghe.localhost script/mvnd-enabled-server"
echo -e ""
echo -e "${GREEN}To run a live migration, see https://github.com/github/migrations-vnext/blob/main/docs/testing-ghes-proxima-localhost-migration.md"
