#!/bin/bash
# Profile a test run (including boot) with Vernier.
#
# Usage:
#   script/profile-test test/baselines/model_baseline_test.rb
#   INTERVAL=500 script/profile-test test/baselines/model_baseline_test.rb
#   OUTPUT=tmp/vernier/custom.json script/profile-test test/baselines/model_baseline_test.rb
#
# Environment variables:
#   INTERVAL  - Sampling interval in microseconds (default: 10000)
#   OUTPUT    - Output file path (default: tmp/vernier/profile-boot-<timestamp>.vernier.json)
#
# View the profile at https://vernier.prof or with: vernier view <file>

set -e

RAILS_ROOT=$(dirname $(dirname $(readlink -f "$0")))
export RAILS_ENV=test

exec "$RAILS_ROOT/bin/safe-ruby" "$RAILS_ROOT/script/profile_test_runner.rb" "$@"
