#!/bin/bash
set -e

# This script sets up the github/blackbird repository for a github/github codespace.

RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
NC='\033[0m' # No Color

# Function to print help message
help() {
   echo "Sets up the github/blackbird repository for a github/github codespace."
   echo
   echo "Usage: setup-codespaces-blackbird [-b branch] [-d|h] "
   echo "Options:"
   echo "-d     Before starting, delete the existing blackbird directory in the codespace."
   echo "-w     Add the blackbird repo as a workspace in VS Code."
   echo "-h     Print this help message."
   echo "-b     Specify a branch to clone (default: main)."
   echo
}

BRANCH=main

# Get the options
while getopts ":hdwb:" opt; do
   case $opt in
      h) # display help message
         help
         exit;;
      d) # Delete the repository if it exists
         DELETE_REPO=true;;
      w) # Add the repository as a workspace in VS Code
         ADD_TO_WORKSPACE=true;;
      b) # If a branch was provided, re-set the variable
         BRANCH=$OPTARG;;
     :)
      echo -e "${RED}Error: Option -$OPTARG requires an argument.${NC}"
      exit 1;;
     \?) # Invalid option
         echo -e "${RED}Error: Invalid option -$OPTARG ${NC}"
         exit 1;;
   esac
done

# If the blackbird repo already exists and the delete argument hasn't been specified, echo a warning and exit.
if [[ -d "/workspaces/blackbird" && -z "$DELETE_REPO" ]]; then
  echo -e "${RED}The blackbird directory already exists in this codespace.${NC} \nYou can rerun the setup script with the -d argument to force the deletion of the existing repository."
  exit 1
fi

if [ "$DELETE_REPO" = true ]; then
  echo -e "\n${GREEN}➡️ Deleting the existing blackbird repo...\n${NC}"
  rm -rf /workspaces/blackbird
fi

# Do a shallow clone of blackbird to the same dir as the github/github repo.
# If a branch was supplied, use that branch for the clone.
echo -e "\n${GREEN}➡️ Cloning blackbird repo...\n${NC}"
git clone https://github.com/github/blackbird /workspaces/blackbird --branch "$BRANCH"

# Bootstrap blackbird
echo -e "\n${GREEN}➡️ Bootstrapping blackbird...\n${NC}"
( cd /workspaces/blackbird; script/bootstrap; cargo build --bin blackbird-local; )

# Add the blackbird repo as a workspace in VS Code
if [ "$ADD_TO_WORKSPACE" = true ]; then
   echo -e "\n${GREEN}➡️ Adding blackbird to VS Code workspace...\n${NC}"
   code --add /workspaces/blackbird
fi

echo -e ""
echo -e "${GREEN}🎉🎉 FINISHED! The blackbird repo has been set up! 🎉🎉${NC}"
echo -e ""
echo -e "${GREEN}The blackbird server will be started when you run script/server in /workspaces/github.${NC}"
echo -e ""
