#!/usr/bin/env safe-ruby
# frozen_string_literal: true

require_relative "../config/environment"
require_relative "./seeds/objects"
require_relative "./seeds/runners/issue_fields"

unless Rails.env.development?
  raise "This is a dev-only script"
end

# Check if the server is running (required for repository creation)
unless system("script/overmind-running")
  warn "Error: The development server is not running."
  warn ""
  warn "Please start the server first with:"
  warn "  script/server"
  warn ""
  warn "Then run this script again."
  exit 1
end

# Determine the correct URL for the running server.
# When script/server starts, it writes the actual GH_HOSTNAME (which may include
# a non-standard port) to tmp/.server.env. If GH_HOSTNAME in the current shell
# doesn't include a port, read it from the server env file so our output URLs
# match where the server is actually reachable.
server_env_file = File.join(Rails.root, "tmp", ".server.env")
dev_server_url = GitHub.url
if File.exist?(server_env_file)
  File.readlines(server_env_file).each do |line|
    if line.start_with?("GH_HOSTNAME=")
      hostname = line.strip.delete_prefix("GH_HOSTNAME=")
      unless hostname.empty?
        scheme = GitHub.ssl ? "https" : "http"
        dev_server_url = "#{scheme}://#{hostname}"
      end
      break
    end
  end
end

puts "Setting up Triage Agent development environment..."

# Create the sandbox repository under the github organization
puts "Creating triage-agent-sandbox repository..."

monalisa = Seeds::Objects::User.monalisa
org = Seeds::Objects::Organization.github(admin: monalisa)
repo_name = "triage-agent-sandbox"

repo = Repository.nwo("#{org.login}/#{repo_name}")

unless repo
  GH::Context.enabled do
    repo = Seeds::Objects::Repository.create(
      owner_name: org.login,
      repo_name: repo_name,
      setup_master: true,
      is_public: false,
      description: "Sandbox repository for testing the Triage Agent"
    )
  end
end

puts "=> Created #{dev_server_url}/#{repo.name_with_display_owner}"

# Add default labels to the repository (matching what the UI creates)
puts "Adding default labels to #{repo_name}..."
Label.initial_labels.each do |label_attrs|
  Seeds::Objects::Label.create(repo: repo, **label_attrs)
rescue Seeds::Objects::CreateFailed
  # Label already exists, skip
end
puts "=> Added #{Label.initial_labels.size} default labels"

# Setting up issue fields
puts "Setting up feature flags..."
Seeds::Runner::IssueFields.execute
github_org = Organization.find_by(login: "github")
monalisa = User.find_by(login: "monalisa")
FeatureFlag.vexi_management.add_feature_flag_actors(:issue_fields, [github_org])

# Add the issue-triage.agent.md file
puts "Adding .github/agents/issue-triage.agent.md..."

triage_prompt = <<~MARKDOWN
---
name: Issue Triage Agent
description: An agent that triages incoming issues in your repository
---
# Issue Triage Instructions

When triaging issues in this repository, follow these guidelines:

## Labels to Apply
- `bug` - For bug reports
- `enhancement` - For feature requests
- `question` - For questions or support requests
- `documentation` - For documentation improvements

## Priority Assessment
- **High**: Security issues, data loss, or complete feature breakage
- **Medium**: Functionality issues with workarounds available
- **Low**: Minor issues, cosmetic problems, or nice-to-haves

## Response Template
Thank the user for their report and acknowledge the issue within 24 hours.
MARKDOWN

begin
  GH::Context.enabled do
    Seeds::Objects::Commit.create(
      repo: repo,
      committer: monalisa,
      message: "Add triage agent instructions",
      branch_name: repo.default_branch,
      files: { ".github/agents/issue-triage.agent.md" => triage_prompt }
    )
  end
  puts "=> Added .github/agents/issue-triage.agent.md"
rescue => e
  puts "=> Warning: Could not add file (#{e.message}). The repository may already have this file."
end

# Create a repo where monalisa has no push permission.
# We use a separate org where monalisa is a regular member (not admin),
# so the org's default "read" permission applies and she can't push.
puts ""
puts "Creating triage-agent-no-push repository..."

no_push_org_admin = Seeds::Objects::User.create(login: "triage-no-push-admin", email: "triage-no-push-admin@github.test.com")
no_push_org = Seeds::Objects::Organization.create(login: "triage-test-org", admin: no_push_org_admin)
no_push_org.add_member(monalisa)

no_push_repo_name = "triage-agent-no-push"
no_push_repo = Repository.nwo("#{no_push_org.login}/#{no_push_repo_name}")

unless no_push_repo
  GH::Context.enabled do
    no_push_repo = Seeds::Objects::Repository.create(
      owner_name: no_push_org.login,
      repo_name: no_push_repo_name,
      setup_master: true,
      is_public: false,
      description: "Test repository where monalisa has no push permission"
    )
  end
end

puts "=> Created #{dev_server_url}/#{no_push_repo.name_with_display_owner}"

# Add triage-agent.md to the no-push repo
begin
  GH::Context.enabled do
    Seeds::Objects::Commit.create(
      repo: no_push_repo,
      committer: no_push_org_admin,
      message: "Add triage agent instructions",
      branch_name: no_push_repo.default_branch,
      files: { ".github/agents/issue-triage.agent.md" => triage_prompt }
    )
  end
  puts "=> Added .github/agents/issue-triage.agent.md to #{no_push_repo_name}"
rescue => e
  puts "=> Warning: Could not add file to #{no_push_repo_name} (#{e.message})."
end

# Add default labels to the no-push repository
puts "Adding default labels to #{no_push_repo_name}..."
Label.initial_labels.each do |label_attrs|
  Seeds::Objects::Label.create(repo: no_push_repo, **label_attrs)
rescue Seeds::Objects::CreateFailed
  # Label already exists, skip
end
puts "=> Added #{Label.initial_labels.size} default labels"

# Verify monalisa's permissions on the no-push repo
puts "  #{no_push_repo_name}: can push? #{no_push_repo.pushable_by?(monalisa)}"
puts "  #{no_push_repo_name}: can pull? #{no_push_repo.pullable_by?(monalisa)}"

puts ""
puts "Triage Agent development environment is ready!"
puts "Repository: #{dev_server_url}/#{repo.name_with_display_owner}"
puts "No-push repo: #{dev_server_url}/#{no_push_repo.name_with_display_owner} (monalisa has read-only access)"
