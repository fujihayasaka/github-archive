#!/bin/bash

# Usage: script/github-mcp-server-remote
# Start the github/github-mcp-server-remote web server if the repository has been cloned in the Codespace, or no-op otherwise.

set -e

if test -f /workspaces/github-mcp-server-remote/cmd/http/main.go; then
  echo "Starting GitHub MCP server..."
  cd /workspaces/github-mcp-server-remote

  # Set up environment variables
  export OTEL_RESOURCE_ATTRIBUTES="service.name=github-mcp-server-remote"
  export GITHUB_TELEMETRY_LOGS_LEVEL="debug"
  export GITHUB_API_URL="http://api.github.localhost"
  # By default the MCP server will run on port 2209, which will conflict with sweagentd.
  # uncomment this to change it if you're doing local development per https://github.com/github/sweagentd/blob/4b352702c703b92d81b8b69f0b40321406579d81/docs/service-dev-setup-with-github.md.
  # You'll need to be sure you set the [getCapiMcpUrl function](https://github.com/github/sweagentd/blob/e0f9dad1073803caf0b901266cc6090f0d0fb082/runtime/src/mcp-client/server-config-processor.ts#L289-L295) in the mcp client to match.
  # export PORT=9042 # an arbitrary port that doesn't conflict with other services

  go run ./cmd/http/main.go

else
  echo "github/github-mcp-server-remote repository has not been cloned, sleeping."
  echo "If you want to run the GitHub MCP server, first run 'script/setup-github-mcp-server',"
  echo "then 'overmind restart github-mcp-server-remote'."
  sleep infinity
fi
