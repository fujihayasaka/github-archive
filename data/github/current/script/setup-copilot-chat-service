#!/bin/bash
set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print help message
help() {
   echo "Sets up the github/copilot-chat repository for a github/github codespace."
   echo
   echo "Usage: setup-copilot-chat-service [-w] [-h]"
   echo "Options:"
   echo "-w     Add the copilot-chat repo as a workspace in VS Code."
   echo "-h     Print this help message."
   echo
}

# Initialize variables
ADD_TO_WORKSPACE=false

# Get the options
while getopts ":hw" opt; do
   case $opt in
      h) # display help message
         help
         exit;;
      w) # Add the repository as a workspace in VS Code
         ADD_TO_WORKSPACE=true;;
     \?) # Invalid option
         echo "Error: Invalid option -$OPTARG"
         exit 1;;
    esac
done

echo -e "\n${GREEN}➡️ Setting up Copilot Chat server...\n${NC}"

# Check if the Copilot Chat server repository already exists
if [ ! -d "/workspaces/copilot-chat" ]; then
  echo -e "${GREEN}➡️ Cloning Copilot Chat server repository...\n${NC}"
  cd /workspaces
  gh repo clone github/copilot-chat
  cd /workspaces/copilot-chat
  make build
else
  echo -e "${GREEN}➡️ Copilot Chat server repository already exists, rebuilding...\n${NC}"
  cd /workspaces/copilot-chat
  make build
fi

# Add the copilot-chat repo as a workspace in VS Code
if [ "$ADD_TO_WORKSPACE" = true ]; then
   echo -e "\n${GREEN}➡️ Adding copilot-chat to VS Code workspace...\n${NC}"
   code --add /workspaces/copilot-chat
fi

echo -e "\n${GREEN}➡️ Start the server through overmind or manually with 'script/copilot-chat'...\n${NC}"

