#!/bin/bash

if [ -z "$UI_MANIFEST_SHA" ]; then
  echo "UI_MANIFEST_SHA environment variable must be set"
  exit 1
fi

# Pull the manifest from the CDN
manifest_url="https://github.githubassets.com/assets/ui-manifest-${UI_MANIFEST_SHA}.json"
max_attempts=60
attempt=1

# Check if the manifest is available at the URL
while ! curl -fsI "$manifest_url" > /dev/null; do
  if [ "$attempt" -ge "$max_attempts" ]; then
    echo "UI manifest not available at ${manifest_url} after $max_attempts attempts."
    exit 1
  fi
  echo "UI manifest not available yet. Attempt $attempt/$max_attempts. Retrying in 5 seconds..."
  attempt=$((attempt + 1))
  sleep 5
done

echo "UI manifest is available at ${manifest_url}."
