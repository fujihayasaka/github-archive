#!/usr/bin/env ruby
# typed: true
# frozen_string_literal: true

require_relative "dx/telemetry/telemetry"

settings = [DX::Telemetry::USER_TAG, DX::Telemetry::RESILIENT]
metric_suffix = ARGV[0]
value = ARGV[1]

DX::Telemetry.monitor_script_runtime_with_value(
  "dx.monolith.extension_host.#{metric_suffix}",
  value.to_f,
  tags: [],
  settings: settings,
)
