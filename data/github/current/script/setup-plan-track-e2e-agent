#!/bin/bash
# Setup script for Memex end-to-end Copilot Coding Agent testing
#
# Thin wrapper around script/setup-codespaces-copilot-swe-agent-v2 that adds
# the Memex / Plan & Track flags and Projects processors needed to test the
# Copilot coding agent (assign Copilot to an issue → agent works → PR created).
#
# Service setup (CAPI, sweagentd, Mission Control, 1Password, sweagentd build,
# Docker image, app seeding, policies, env files) is owned by
# script/setup-codespaces-copilot-swe-agent-v2.
#
# Service start/health is owned by script/cca-start-e2e-servers (tmux session,
# port cleanup, dependency-ordered launch, health checks).
#
# Prerequisites:
#   - github/github codespace with the Coding Agent devcontainer (32-core, 256GB)
#   - 1Password CLI available (set up automatically by setup-codespaces-copilot-swe-agent-v2)
#
# Usage:
#   script/setup-plan-track-e2e-agent          # Full setup + start services
#   script/setup-plan-track-e2e-agent --setup  # Setup only (configure DB, flags)
#   script/setup-plan-track-e2e-agent --start  # Start services only (assumes setup done)
#
# For semantic search / duplicate issue detection, run separately:
#   script/setup-issues-semantic           # Semantic search feature flags + preview
#   script/setup-duplicate-issues --setup-es  # ES inference endpoint + duplicate detection

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/plan-track-agent-common"

# --- Parse arguments ---

MODE="all"
if [ "${1:-}" = "--setup" ]; then
  MODE="setup"
elif [ "${1:-}" = "--start" ]; then
  MODE="start"
fi

# =============================================================================
# PHASE 1: SETUP (configure database, feature flags)
# =============================================================================

run_setup() {
  log_step "Phase 1: Setup & Configuration"

  # Memex needs PROJECTS=1 so the Projects processors (denormalization,
  # events, live-updates, sub-issue recalculation) come up. ensure_rails_running
  # exports PROJECTS=1 and (re)starts the Rails server before v2 hits it.
  ensure_rails_running

  # Run the SWE agent setup (1Password, sweagentd clone/build, app + policies,
  # CAPI + Mission Control setup, env files, Docker image).
  # --no-start: we'll launch cca-start-e2e-servers ourselves AFTER applying
  # Memex/Issues flag overrides below.
  # NOTE: This calls enable-copilot-chat → toggle-global-flags --enable which
  # mirrors ALL production global flags locally. Any flag overrides below MUST
  # come AFTER this step to avoid being overwritten by production state.
  log_step "Running Copilot SWE Agent setup (this takes a few minutes)"
  cd "$GITHUB_DIR"
  script/setup-codespaces-copilot-swe-agent-v2 --capi --no-start

  # Enable Memex Projects feature flags via the dedicated setup script
  log_step "Enabling Memex feature flags"
  cd "$GITHUB_DIR"
  script/setup-memex

  # ==========================================================================
  # IMPORTANT: All flag overrides below MUST come AFTER the SWE agent setup.
  # The SWE agent setup mirrors production flags, which can re-enable flags
  # that break local development.
  # ==========================================================================

  enable_memex_agent_flags
  enable_issues_agent_flags

  restart_workers

  log_success "Setup complete!"
  echo ""
}

# =============================================================================
# PHASE 2: START SERVICES (delegated to script/cca-start-e2e-servers)
# =============================================================================

run_start() {
  log_step "Phase 2: Starting Services (via script/cca-start-e2e-servers)"
  cd "$GITHUB_DIR"
  exec script/cca-start-e2e-servers
}

# =============================================================================
# MAIN
# =============================================================================

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Plan & Track E2E Agent Setup"
echo "  Mode: $MODE"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

case "$MODE" in
  setup)
    run_setup
    echo ""
    echo "Setup complete. Run with --start to start services."
    ;;
  start)
    run_start
    ;;
  all)
    run_setup
    run_start
    ;;
esac
