#!/bin/bash
# Use this script to develop https://github.com/github/actions-data-stream in a gh/gh codespace.

set -e

workspace_dir="/workspaces/actions-data-stream"

if [ ! -d "$workspace_dir/.git" ]; then
  git clone https://github.com/github/actions-data-stream.git "$workspace_dir"
fi

(
   cd $workspace_dir
   echo "Setting up actions-data-stream..."
   script/setup
)

echo ""
echo "🎉 FINISHED! actions-data-stream has been set up!"
echo "Run the following to get started:"
echo ""
echo "  cd $workspace_dir"
echo "  make deps-status"
echo ""
