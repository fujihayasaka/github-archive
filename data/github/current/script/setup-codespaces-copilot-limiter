#!/bin/bash
set -e

# This script sets up the github/copilot-limiter repository for a github/github codespace.

RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
NC='\033[0m' # No Color

# Function to print help message
help() {
   echo "Sets up the github/copilot-limiter repository for a github/github codespace."
   echo
   echo "Usage: setup-codespaces-copilot-limiter [-b branch] [-d|h] "
   echo "Options:"
   echo "-d     Before starting, delete the existing copilot-limiter directory in the codespace."
   echo "-w     Add the copilot-limiter repo as a workspace in VS Code."
   echo "-h     Print this help message."
   echo "-c     Enable code review mode."
   echo
}

BRANCH=main

# Get the options
while getopts ":hdwb:c" opt; do
   case $opt in
      h) # display help message
         help
         exit;;
      d) # Delete the repository if it exists
         DELETE_REPO=true;;
      w) # Add the repository as a workspace in VS Code
         ADD_TO_WORKSPACE=true;;
      b) # If a branch was provided, re-set the variable
         BRANCH=$OPTARG;;
      c) # Enable code review mode
         if [ ! -z "$COPILOT_CODE_REVIEW" ]; then
           export COPILOT_CODE_REVIEW_MODE=true
         fi
         echo -e "${GREEN}Code review mode enabled";;
     :)
      echo -e "${RED}Error: Option -$OPTARG requires an argument."
      exit 1;;
     \?) # Invalid option
         echo -e "${RED}Error: Invalid option -$OPTARG"
         exit 1;;
   esac
done

# If the copilot-limiter repo already exists and the delete argument hasn't been specified, echo a warning and exit.
if [[ -d "/workspaces/copilot-limiter" && -z "$DELETE_REPO" ]]; then
  echo -e "${RED}The copilot-limiter directory already exists in this codespace.${NC} \nYou can rerun the setup script with the -d argument to force the deletion of the existing repository."
  exit 1
fi

if [ "$DELETE_REPO" = true ]; then
  echo -e "\n${GREEN}➡️ Deleting the existing copilot-limiter repo...\n${NC}"
  rm -rf /workspaces/copilot-limiter
fi

# Do a shallow clone of copilot-limiter to the same dir as the github/github repo.
# If a branch was supplied, use that branch for the clone.
echo -e "\n${GREEN}➡️ Cloning copilot-limiter repo...\n${NC}"
git clone https://github.com/github/copilot-limiter /workspaces/copilot-limiter --branch $BRANCH

# Bootstrap copilot-limiter
echo -e "\n${GREEN}➡️ Bootstrapping copilot-limiter...\n${NC}"
( cd /workspaces/copilot-limiter ; script/bootstrap-dotcom-codespaces; )

# Add the copilot-limiter repo as a workspace in VS Code
if [ "$ADD_TO_WORKSPACE" = true ]; then
   echo -e "\n${GREEN}➡️ Adding copilot-limiter to VS Code workspace...\n${NC}"
   code --add /workspaces/copilot-limiter
fi

echo -e ""
echo -e "${GREEN}🎉🎉 FINISHED! The copilot-limiter repo has been set up! 🎉🎉${NC}"
echo -e ""
