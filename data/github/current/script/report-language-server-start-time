#!/usr/bin/env ruby
# typed: true
# frozen_string_literal: true

require_relative "dx/telemetry/telemetry"

settings = [DX::Telemetry::USER_TAG, DX::Telemetry::RESILIENT]
elapsed_time = ARGV[0]
language_server = ARGV[1] || "unknown"

DX::Telemetry.monitor_script_runtime_with_value(
  "dx.monolith.language_server.start.time",
  elapsed_time.to_f,
  tags: ["language_server:#{language_server}"],
  settings: settings,
)
