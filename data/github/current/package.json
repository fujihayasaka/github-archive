{
  "private": true,
  "scripts": {
    "apply-patches": "patch-package --patch-dir ./ui/packages/patch-packages/patches",
    "build": "npm run webpack",
    "compile-css-modules": "tcm -p **/*.module.css",
    "compile-relay": "npm run compile-relay -w @github-ui/relay-build || npm run compile-relay-fallback",
    "compile-relay-fallback": "NODE_OPTIONS=\"--no-warnings\" node ./ui/packages/relay-build/compile-relay.js",
    "create-patch": "npm run apply-patches -- $2",
    "dependencies": "./script/npm-dependencies-changed",
    "eslint": "eslint --cache --max-warnings=0",
    "fingerprint-static-assets": "npm run start -w @github-ui/fingerprint-static-assets",
    "jest:coverage": "npm run pretest && jest --coverage",
    "jest:watch": "npm run pretest && jest --watch",
    "lint": "npm run nx:run -- --target=lint",
    "lint:dependencies": "depcruise --config .dependency-cruiser.js ui/packages/ app/assets/modules/ app/components/ --output-type err-long",
    "lint:fix": "npm run lint -- --skip-nx-cache --fix",
    "lint:packages": "npm run lint -- --exclude=@github-ui/memex,@github-ui/app-assets-modules",
    "lint:pr-files": "npm run eslint",
    "nx": "nx",
    "nx:affected": "nx affected --parallel=$(lscpu | egrep '^CPU\\(s\\):' | egrep -oEi '[0-9]+')",
    "nx:graph": "nx graph",
    "nx:run": "nx run-many --parallel=$(lscpu | egrep '^CPU\\(s\\):' | egrep -oEi '[0-9]+')",
    "postinstall": "./script/npm-dependencies-changed",
    "precompile-assets": "./bin/precompile-assets",
    "precompile-assets-for-tests": "npm run build-for-tests -w @github-ui/ui-manifest",
    "prejest:coverage": "npm run pretest",
    "prejest:watch": "npm run pretest",
    "pretest": "npm run compile-relay && NODE_ENV=test npm run ui-commands:compile",
    "pretest:smoke": "rm -rf tmp/smoke-test-assets/ && DESTINATION=tmp/smoke-test-assets npm run webpack:prod && ASSETS_BASE_PATH=tmp/smoke-test-assets npm run build -w @github-ui/ui-manifest",
    "pretsc": "npm run compile-css-modules",
    "primerize": "npm run primerize:setup && npm run primerize:start",
    "primerize:setup": "ts-node script/primerize.ts setup",
    "primerize:start": "ts-node script/primerize.ts start",
    "primerize:stop": "ts-node script/primerize.ts stop",
    "prod-js-size": "rm -rf tmp/prod-js-size && DESTINATION=tmp/prod-js-size npm run webpack:prod && gzip -k9 tmp/prod-js-size/*.js && echo Total File Size && wc -c tmp/prod-js-size/*.js | grep total && echo Gzipped File Size && wc -c tmp/prod-js-size/*.js.gz | grep total",
    "start": "./script/server",
    "storybook": "storybook dev -p 6006 -c ui/packages/storybook/.storybook",
    "storybook:build": "ruby ui/packages/storybook/generate_component_list.rb && NODE_OPTIONS=\"--max-old-space-size=8192\" storybook build -c ui/packages/storybook/.storybook",
    "storybook:test": "vitest --config ui/packages/vite/vitest-storybook.config.ts --project storybook --dangerouslyIgnoreUnhandledErrors",
    "storybook:test:watch": "npm run storybook:test -- --watch",
    "storybook:webpack": "WEBPACK=true storybook dev -p 6006 -c ui/packages/storybook/.storybook",
    "stylelint": "npm run nx:run -- --target=stylelint",
    "stylelint:add-disables": "./bin/stylelint-add-disables app/assets/stylesheets app/components/ packages/**/app/components/ ui/packages/",
    "stylelint:fix": "npm run stylelint -- --skip-nx-cache --fix",
    "stylelint:remove-disables": "./bin/stylelint-remove-disables app/assets/stylesheets app/components/ packages/**/app/components/ ui/packages/",
    "test": "npm run pretest && npm run nx:run -- --target=test -- --runInBand",
    "test:affected": "npm run pretest && npm run nx:affected -- --target=test -- --runInBand",
    "test:app": "npm run pretest && nx run @github-ui/app-assets-modules:test",
    "test:memex": "npm run pretest && nx run @github-ui/memex:test --shard=$SHARD_INDEX/$TOTAL_SHARDS",
    "test:memex:tsc": "npm run pretest && tsc -p ui/packages/memex/src/tests/tsconfig.json",
    "test:modules": "ui-test --project browser",
    "test:modules:debug": "ui-test --debug",
    "test:modules:headed": "ui-test --headed",
    "test:modules:watch": "ui-test --project browser --watch",
    "test:packages": "npm run pretest && npm run nx:run -- --target=test --exclude=@github-ui/memex,@github-ui/app-assets-modules -- --runInBand",
    "test:smoke": "ui-test --project prod-smoke",
    "test:unused-modules": "ts-node --skip-project script/find-unused-modules.ts test/js/**.js",
    "test:unused-modules:memex": "ts-node --skip-project script/find-unused-modules.ts --memex",
    "tsc": "npm run nx:run -- --target=tsc",
    "ui": "npm run dev --prefix ../ui",
    "ui-commands:compile": "NODE_ENV=test npm run compile -w @github-ui/ui-commands-scripts",
    "ui-commands:validate": "npm run validate -w @github-ui/ui-commands-scripts",
    "vite": "npm start -w @github-ui/vite",
    "vite:alloy": "npm run alloy -w @github-ui/vite",
    "webpack": "NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack.config.js",
    "webpack:alloy": "NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack-alloy.config.js",
    "webpack:alloy:prod": "NODE_ENV=production NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack-alloy.config.js",
    "webpack:alloy:prod:analyze": "WEBPACK_ANALYZE=true NODE_ENV=production NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack-alloy.config.js",
    "webpack:alloy:watch": "NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack-alloy.config.js --watch",
    "webpack:css": "NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack-css.config.js",
    "webpack:css:prod": "NODE_ENV=production NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack-css.config.js",
    "webpack:css:serve": "NODE_OPTIONS=\"--max-old-space-size=8192\" webpack serve --config ui/packages/webpack/webpack-css.config.js",
    "webpack:debug": "DEBUG=true NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack.config.js",
    "webpack:prod": "NODE_ENV=production NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack.config.js",
    "webpack:prod:analyze": "WEBPACK_ANALYZE=true NODE_ENV=production NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config ui/packages/webpack/webpack.config.js",
    "webpack:serve": "NODE_OPTIONS=\"--max-old-space-size=12288\" webpack serve --config ui/packages/webpack/webpack.config.js",
    "webpack:serve:debug": "DEBUG=true npm run webpack:serve"
  },
  "workspaces": [
    "npm-workspaces/*",
    "ui/packages/*",
    "app/assets/modules",
    "app/assets/preview_modules",
    "app/assets/types",
    "app/assets/stylesheets",
    "app/assets/workers",
    "app/components",
    "test/js"
  ],
  "dependencies": {
    "@github/markdown-toolbar-element": "2.2.3",
    "@oddbird/popover-polyfill": "0.5.2"
  },
  "devDependencies": {
    "esbuild": "0.25.2"
  },
  "overrides": {
    "@github/markdown-toolbar-element": "$@github/markdown-toolbar-element",
    "@oddbird/popover-polyfill": "$@oddbird/popover-polyfill",
    "esbuild": "$esbuild"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
