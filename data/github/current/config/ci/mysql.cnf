[mysqld]
key_buffer_size = 16M
max_allowed_packet = 16M
max_binlog_size = 100M
port = 3306
skip-external-locking
thread_stack = 256K

performance_schema=ON
performance_schema_consumer_events_statements_current=ON
performance_schema_consumer_events_statements_history_long=ON
performance_schema_consumer_events_transactions_history_long=ON
performance_schema_events_statements_history_long_size=50000
performance_schema_events_transactions_history_long_size=20000
performance_schema_max_sql_text_length=8192
performance_schema_max_digest_length=8192
performance_schema_digests_size=150000

# This replaces the startup script and checks MyISAM tables if needed
# the first time they are touched
max_connections         = 10000
max_connect_errors      = 30000
tmp_table_size          = 256M
max_heap_table_size     = 256M
sort_buffer_size        = 4M
read_buffer_size        = 4M
read_rnd_buffer_size    = 1M

#
# * InnoDB
#
# InnoDB is enabled by default with a 10MB datafile in /var/lib/mysql/.
# Read the manual for more InnoDB related options. There are many!
# You might want to disable InnoDB to shrink the mysqld process by circa 100MB.
#skip-innodb

# Default to InnoDB and UTF-8, in case clients forget.
default-storage-engine=innodb
character-set-server=utf8mb4

innodb_buffer_pool_size = 1G

innodb_flush_method = O_DIRECT_NO_FSYNC
innodb_lock_wait_timeout = 60
innodb_strict_mode=OFF
innodb_flush_log_at_trx_commit = 0

#
# * GitHub Prod Settings
#
# These are config settings to mimic production in CI

optimizer_switch='index_merge_intersection=OFF'
sql_mode=NO_ENGINE_SUBSTITUTION
log-error-verbosity=2

gtid_mode=ON
enforce_gtid_consistency=ON
server_id=1
log_bin=mysql-bin.log
expire_logs_days=1

sync_binlog = 0
innodb_doublewrite = OFF
innodb_adaptive_hash_index = OFF
innodb_log_file_size = 256M
innodb_log_buffer_size = 67108864
innodb_change_buffering = none
table_open_cache = 100000
table_open_cache_instances = 4
table_definition_cache = 100000
thread_cache_size = 512

secure_file_priv = /var/lib/mysql-files
