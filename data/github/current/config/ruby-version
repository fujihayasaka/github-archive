#!/bin/bash

# The "next" version of Ruby. Usually this tracks the upcoming version,
# released in December of each year and is bumped each week, but may be the
# previous version for some time after we upgrade.
# This is tested in CI but doesn't run in production.
RUBY_NEXT_SHA="36a22e04b7859c1b5887b0eab6b0d7ab5e186888"

# The current version of Ruby, which we run in production. This is
# Ruby 4.0.5, which addresses CVE-2026-46727, plus GitHub's thread
# scheduling backport. A reference PR with the backport recreated on
# top of the Ruby 4.0.5 ruby_4_0 branch is available at:
# https://github.com/github/ruby/pull/245
RUBY_SHA="c28a307939dc83cad533de2c231e1e9b283b35b2"

if [ -n "$JANKY_ENV_RUBY_SHA" ]; then
  echo -n "$JANKY_ENV_RUBY_SHA"
elif [ -n "$RUBY_NEXT" ]; then
  echo -n "$RUBY_NEXT_SHA"
else
  echo -n "$RUBY_SHA"
fi
