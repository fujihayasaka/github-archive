        "appIDs": [
          "VEKTX9H2N7.com.github.stormbreaker.dev",
          "VEKTX9H2N7.com.github.stormbreaker.prod"
        ],
        "components": [
          {
            "/": "/",
            "exclude": true,
            "comment": "Matches the GitHub.com landing page"
          },
          {
            "/": "/orgs/*/$(includedOrgPages)/*",
            "exclude": false,
            "comment": "Matches handleable org products and their subpages"
          },
          {
            "/": "/users/*/projects/*",
            "exclude": false,
            "comment": "Matches org projects and their subpages"
          },
          {
            "/": "/users/*/achievements/*",
            "exclude": false,
            "comment": "Matches achievements pages and their subpages"
          },
          {
            "/": "/users/*/achievements",
            "exclude": false,
            "comment": "Matches achievements page"
          },
          {
            "/": "/*/*/pull/*/$(includedPRPages)",
            "exclude": false,
            "comment": "Matches included PR subpaths"
          },
          {
            "/": "/$(excludedProducts)",
            "exclude": true,
            "comment": "Matches GitHub product pages"
          },
          {
            "/": "/$(excludedProducts)/*",
            "exclude": true,
            "comment": "Matches GitHub product subroutes"
          },
          {
            "/": "/*/*/$(excludedRepoPages)",
            "exclude": true,
            "comment": "Matches unsupported GitHub repo pages"
          },
          {
            "/": "/*/*/$(excludedRepoPages)/*",
            "exclude": true,
            "comment": "Matches unsupported GitHub repo subroutes"
          },
          {
            "/": "/*/*/actions",
            "exclude": false,
            "comment": "Matches supported actions subroute"
          },
          {
            "/": "/*/*/actions/workflows/*",
            "exclude": false,
            "comment": "Matches unsupported actions subroute"
          },
          {
            "/": "/*/*/actions/runs/*",
            "exclude": false,
            "comment": "Matches unsupported actions subroute"
          },
          {
            "/": "/*/*/actions/*",
            "exclude": true,
            "comment": "Matches unsupported actions subroute"
          },
          {
            "/": "/*/*/$(excludedRepoSearchPages)",
            "?": {
              "q": "?*"
            },
            "exclude": true,
            "comment": "Matches unsupported GitHub repo pages"
          },
          {
            "/": "/*",
            "?": {
              "tab": "$(includedProfileTabs)"
            },
            "exclude": false,
            "comment": "Enable links to specific tabs on profiles"
          },
          {
            "/": "/*",
            "?": {
              "tab": "?*"
            },
            "exclude": true,
            "comment": "Disable links to specific tabs on profiles"
          },
          {
            "/": "*",
            "comment": "Matches all remaining routes"
          }
        ]
      }
    ]
