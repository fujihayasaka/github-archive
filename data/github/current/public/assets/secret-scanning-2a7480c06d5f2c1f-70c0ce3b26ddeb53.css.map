$width-md: 768px;

.height-screen {
  height: 100vh;
}

.py-2\.5 {
  padding-top: var(--base-size-12);
  padding-bottom: var(--base-size-12);
}

.md\:flex-nowrap {
  @media (min-width: 768px) {
    flex-wrap: nowrap !important;
  }
}

.flex-basis-full {
  flex-basis: 100%;
}

.md\:flex-basis-auto {
  @media (min-width: 768px) {
    flex-basis: auto;
  }
}

.text-superbold {
  /* Diasbled cuz Primer docs doesn't have a 700 variable*/
  /* stylelint-disable-next-line primer/typography */
  font-weight: 700;
}
