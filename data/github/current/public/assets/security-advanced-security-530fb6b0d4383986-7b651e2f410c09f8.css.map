/* stylelint-disable primer/spacing, selector-max-type*/

/* TODO: Move to landing-pages*/

/* Makes sure the Rails footer is pushed down while React is loading.*/
.application-main {
  min-height: 100vh;
}

/* Improve contrast for focus outline since there is a blue background gradient*/
.HeaderMenu-link {
  --focus-outlineColor: currentColor;
}

/* Security React styles*/
/* Not meant to be shared with other marketing pages*/

.lp-Security {
  --lp-color-accent: #5fed83;
  --lp-color-on-accent: #033a16;

  /* Use Primer Brand default colors*/
  color: var(--brand-color-text-default);
  background: var(--base-color-scale-black-0);
}

/* Hero -------------*/

.lp-Hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
}

.lp-Hero-bg img {
  display: block;
  width: 100%;
  object-position: bottom center;
  max-height: 45vw; /* TODO: Cut image off a bit*/

  @media (max-width: 767px) {
    max-height: 60vw;
  }
}

.lp-Hero-label {
  --brand-Label-background:
    radial-gradient(40.83% 90.2% at 15.83% 40%, #5fed83 0%, rgba(158, 236, 255, 0) 100%),
    radial-gradient(148.17% 153.18% at -6.68% 31.43%, #9eecff 7.27%, #096bde 62.66%, #000aff 98.69%);

  margin-bottom: var(--base-size-16);
}

.lp-Hero-heading {
  @media (min-width: 768px) {
    width: 85%;
  }
}

.tertiary-cta {
  color: inherit;
  text-decoration-color: currentColor;
}

.lp-Hero-content {
  position: relative;
  padding-bottom: 0;
  animation: lp-Hero-animation 0.4s 0.1s cubic-bezier(0, 0, 0.2, 1) backwards;
}

@keyframes lp-Hero-animation {
  0% {
    opacity: 0;
    transform: translateY(20px);
  }
}

.lp-Hero-ctaButton {
  @media (max-width: 544px) {
    width: 100%;
  }
}

/* Hero Bentos*/

.lp-Hero-bentoItem {
  animation: lp-Hero-animation 0.6s cubic-bezier(0, 0, 0.2, 1) backwards;

  &:nth-child(1) {
    animation-delay: 0.3s;
  }

  &:nth-child(2) {
    animation-delay: 0.6s;
  }

  > div:first-child {
    padding: var(--base-size-32);
  }

  h2 {
    width: 64%;

    @media (max-width: 767px) {
      font-size: var(--text-title-size-large);
    }
  }

  a {
    @media (max-width: 543px) {
      margin-top: 0;
    }
  }

  picture,
  img {
    display: block;
    width: 100%;
  }
}

/* Features -----------------------------------------------------*/

.lp-Features-bentoVisual1.lp-Features-bentoVisual1.lp-Features-bentoVisual1 {
  padding: 60px 24px 44px;

  @media (max-width: 1011px) {
    padding: 36px 0 28px 24px;
  }
}

.lp-Features-bentoImg1.lp-Features-bentoImg1 {
  @media (max-width: 1011px) {
    object-fit: cover;
    object-position: 0 50% !important;
  }

  @media (max-width: 767px) {
    height: 338px;
  }
}

.lp-Features-bento2,
.lp-Features-bento3 {
  row-gap: 24px;

  @media (max-width: 767px) {
    grid-template-rows: auto;
    row-gap: 0;
  }

  .lp-BentoContent {
    padding: 24px;
    padding-bottom: 0;

    @media (min-width: 768px) {
      padding: 48px;
    }
  }

  .lp-Features-bentoImg {
    height: auto;
  }
}

.lp-Features-testimonial {
  --brand-Testimonial-quoteMarkColor-default: var(--lp-color-accent);

  @media (min-width: 768px) {
    text-align: center;

    figcaption {
      margin-inline: auto;
    }
  }
}

/* Resources ----------------------------------------------------*/

.lp-Resources-card {
  --brand-Icon-background-green: var(--lp-color-accent);
  --brand-Icon-color-green: var(--lp-color-on-accent);
  --brand-color-accent-primary: #0527fc;

  margin: 0 auto;
}

/* Layout ----------------------------------------------------*/

.lp-Container {
  max-width: 544px; /* keep narrow until we switch to 2 columns*/
  padding-right: var(--base-size-16);
  padding-left: var(--base-size-16);
  margin: 0 auto;

  @media (min-width: 768px) {
    max-width: none;
    padding-right: var(--base-size-40);
    padding-left: var(--base-size-40);
  }

  @media (min-width: 1012px) {
    padding-right: var(--base-size-64);
    padding-left: var(--base-size-64);
  }

  @media (min-width: 1280px) {
    max-width: 1408px; /* 1248px + 2x80px padding*/
    padding-right: var(--base-size-80);
    padding-left: var(--base-size-80);
  }
}

/* Utilities ----------------------------------------------------*/

.lp-has-fontSmoothing {
  /* Makes text a bit thinner*/
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.lp-break-whenWide {
  @media (max-width: 1279px) {
    display: none;
  }
}

.lp-textWrap--pretty {
  text-wrap: pretty;
}

.lp-borderRadiusNone {
  border-radius: 0 !important;
}

.lp-Bento--withBadge {
  position: relative;

  svg {
    position: relative;
    width: 48px;
    height: 48px;
    color: var(--brand-Icon-color-default, var(--lp-color-accent));
    z-index: 1;
  }
}

.lp-Bento--withAccentIcon > svg,
.lp-Color-accent {
  color: var(--lp-color-accent);
}
