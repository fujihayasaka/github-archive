$spacer-forty-percent: 40%;
$spacer-fifty-percent: 50%;
$spacer-negative-fifty-percent: -50%;

.centered-loading {
  position: absolute;
  /* stylelint-disable-next-line primer/spacing*/
  top: $spacer-forty-percent;
  /* stylelint-disable-next-line primer/spacing*/
  left: $spacer-fifty-percent;
  /* stylelint-disable-next-line primer/spacing*/
  margin-right: $spacer-negative-fifty-percent;
  transform: translate($spacer-negative-fifty-percent, $spacer-negative-fifty-percent);
}
