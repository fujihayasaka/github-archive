@import '@primer/css/support/index.scss';

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

/* Codespaces VSCode Loading Screen Color Variables*/
@include color-variables(
  (
    (vscode-editor-foreground, (light: #000000, dark: #C7D1DA)),
    (vscode-editor-background, (light: unset, dark: #0D1117)),
    (vscode-terminal-selectionBackground, (light: #CCCCCC, dark: #CCCCCC)),
    (sps-general-background, (light: unset, dark: #0D1117))
  )
);

/* Start V2 styles*/

.vso-splash-screen .container {
	display: flex;
	height: 100%;
	box-sizing: border-box;
 /* stylelint-disable-next-line primer/spacing*/
	padding-top: 120px;
 /* stylelint-disable-next-line primer/typography*/
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
 /* stylelint-disable-next-line primer/typography*/
	font-weight: 500;
	text-align: center;
	flex-direction: column;
	background: var(--sps-general-background);
}

.vso-splash-screen {
	background: var(--sps-general-background);
}

.vscs-splash-screen-steps-pane {
	box-sizing: border-box;
 /* stylelint-disable-next-line primer/spacing*/
	margin-top: 10px;
	flex-grow: 1;
}

/* stylelint-disable-next-line selector-max-type*/
.vso-splash-screen h4 {
 /* stylelint-disable-next-line primer/spacing*/
	margin-top: 3px;
 /* stylelint-disable-next-line primer/spacing*/
	margin-bottom: 2px;
	font-size: var(--text-title-size-small);
 /* stylelint-disable-next-line primer/typography*/
	font-weight: 500;
 /* stylelint-disable-next-line primer/colors*/
	color: var(--vscode-editor-foreground);
}

.vso-splash-screen__step-header {
	display: flex;
	align-items: center;
	justify-content: center;
}

.vso-splash-screen__step-header .title {
 /* stylelint-disable-next-line primer/spacing*/
	margin: 15px 7px var(--base-size-16);

	/* to match GH styles */
 /* stylelint-disable-next-line primer/colors*/
	color: var(--vscode-editor-foreground);
}

/* stylelint-disable-next-line selector-max-id, selector-max-specificity*/
#spinner-vscs-icon {
  fill: var(--fgColor-default, var(--color-fg-default));
}

.vso-splash-screen__status {
	position: relative;
	display: inline-block;
	width: 16px;
	height: 16px;
	overflow: hidden;
	vertical-align: middle;
}

/* stylelint-disable-next-line no-duplicate-selectors*/
.vscs-splash-screen-steps-pane, .vscs-splash-screen-steps-pane {
  /* stylelint-disable-next-line selector-max-type, selector-no-qualifying-type*/
  div.initializing {
    display: block;
  }

  /* stylelint-disable-next-line selector-max-type, selector-no-qualifying-type*/
  div.failed {
    display: none;
  }
}

.vscs-splash-screen-steps-pane[data-current-state="failed"], .vscs-splash-screen-steps-pane[data-current-state="stuck"] {
  /* stylelint-disable-next-line selector-max-type, selector-no-qualifying-type*/
  div.initializing {
    display: none;
  }

  /* stylelint-disable-next-line selector-max-type, selector-no-qualifying-type*/
  div.failed {
    display: block;
  }
}

.vso-splash-screen__status-icon-red {
 /* stylelint-disable-next-line primer/colors*/
	fill:  #cb2431;
}

.vso-splash-screen__status-icon-progress {
	animation-name: spin;
	animation-duration: 1s;
	animation-timing-function: linear;
	animation-iteration-count: infinite;
}
