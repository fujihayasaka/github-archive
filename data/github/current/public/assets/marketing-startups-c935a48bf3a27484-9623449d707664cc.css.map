/* stylelint-disable selector-max-type, selector-no-qualifying-type*/

:root {
  --mktg-accent-primary: #9867f0;
  --mktg-accent-secondary: #ed4e50;
}

summary.btn-mktg::before {
  details[open] > & {
    opacity: 1;
  }

  .details-overlay-dark[open] > & {
    background: var(--overlay-backdrop-bgColor, var(--color-primer-canvas-backdrop)) !important;
  }
}

label.required::after {
  position: absolute;
  display: inline-block;
  padding-left: 2px; /* stylelint-disable-line primer/spacing*/
  /* stylelint-disable-next-line primer/typography*/
  font-size: 12px;
  color: var(--fgColor-danger, var(--color-danger-emphasis));
  content: '*';
}
