@import '@primer/css/support/index.scss';

.education-splash-banner {
  position: relative;
  min-height: 220px;
  overflow: hidden;
  background-color: var(--bgColor-default, var(--color-canvas-default));
  border-color: var(--borderColor-default, var(--color-border-default));
}

.education-splash-content {
  position: relative;
  z-index: 2;
  display: flex;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: var(--base-size-32);

  @include breakpoint(lg) {
    max-width: 65%;
  }
}

.education-splash-image {
  display: none;

  @include breakpoint(lg) {
    display: block;
    position: absolute;
    top: -25%;
    right: -8%;
    width: 55%;
    height: 160%;
    z-index: 1;
    pointer-events: none;

    > * {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left center;
    }
  }
}
