/* stylelint-disable selector-max-type */
.Universe23Waitlist__Page {
  position: relative;
  min-height: 100vh;
}

.Universe23Waitlist__DesktopBackground {
  position: absolute;
  width: 100%;
  height: 100%;
  padding: 0;
}

.Universe23Waitlist__DesktopBackground__Right {
  height: 100%;
}

.Universe23Waitlist__Content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 0;
  margin-top: 0 !important; /* Overrides margin-top from Primer Brand's Grid */
}

.Universe23Waitlist__Consent {
  label {
    align-items: baseline;
    display: grid;
    gap: 0.5rem;
    grid-template-areas: 'checkbox label';
    grid-template-columns: 1rem auto;
    grid-template-rows: auto;
  }

  input {
    grid-area: checkbox;
  }

  p,
  ul {
    grid-column-start: label;
  }
}

.Universe23Waitlist__Consent,
.Universe23Waitlist__Notice {
  color: var(--brand-color-text-default);
}

/* Mobile-only styles */
@media screen and (max-width: 48rem) {
  .Universe23Waitlist__DesktopBackground {
    display: none;
  }

  .Universe23Waitlist__Content__Right {
    height: 100%;
  }
}
