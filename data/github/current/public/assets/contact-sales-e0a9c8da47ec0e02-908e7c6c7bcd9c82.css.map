/* stylelint-disable primer/borders */
/* stylelint-disable selector-max-type */

/* Have to set background-image of checkmark rather than importing and styling Primer Brand CheckIcon because the
   Korean version of the ConsentExperience has multiple checkboxes */
   $checkmark-svg: url("data:image/svg+xml;utf8,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20aria-hidden='true'%20focusable='false'%20role='img'%20class='octicon%20octicon-check'%20viewBox='0%200%2016%2016'%20width='16'%20height='16'%20fill='currentColor'%20style='display:inline-block;user-select:none;%20vertical-align:text-bottom;overflow:visible'%3E%3Cpath%20fill='%23fff'%20stroke='%23fff'%20d='M13.78%204.22a.75.75%200%20010%201.06l-7.25%207.25a.75.75%200%2001-1.06%200L2.22%209.28a.75.75%200%20011.04-1.04L6%2010.94l6.72-6.72a.75.75%200%20011.06%200z'%3E%3C/path%3E%3C/svg%3E");

.ContactSales__Page {
  min-height: 100vh;
}

.ContactSales__Consent {
  label {
    align-items: start;
    display: grid;
    gap: var(--base-size-8);
    grid-template-areas: 'checkbox label';
    grid-template-columns: var(--base-size-20) 1fr;
    grid-template-rows: auto;
  }

  input {
    grid-area: checkbox;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--base-size-20);
    height: var(--base-size-20);
    padding: 0;
    margin: 0;
    cursor: pointer;
    background-color: var(--brand-control-checkbox-bg-default);
    background-image: $checkmark-svg;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    border: solid var(--brand-borderWidth-thick, 1px) var(--brand-control-color-border-default);
    border-radius: var(--brand-borderRadius-small);
    appearance: none;
    outline: 1px solid var(--brand-control-checkbox-bg-default);
    /* stylelint-disable-next-line primer/box-shadow*/
    box-shadow: 0 0 0 3px transparent;
    transition:
      background-color 350ms var(--brand-control-animation-easing),
      border-color 350ms var(--brand-control-animation-easing),
      box-shadow 350ms var(--brand-control-animation-easing),
      outline-offset 350ms var(--brand-control-animation-easing);


    &:checked {
      background-color: var(--brand-control-checkbox-bg-checked);
      border-color: var(--brand-control-checkbox-bg-checked);
    }

    &:focus-visible {
      border: solid var(--brand-borderWidth-thick, 1px) var(--focus-outlineColor, var(--color-accent-fg));
      outline-offset: 0;
      box-shadow: none;
    }
  }

  p,
  ul {
    grid-column-start: label;
  }
}

.ContactSales__Consent,
.ContactSales__Notice {
  color: var(--brand-color-text-default);
}

/* Mobile-only styles */
@media screen and (max-width: 48rem) {
  .ContactSales__DesktopBackground {
    display: none;
  }
}
