/* stylelint-disable selector-max-id, selector-max-specificity*/

@import '@primer/css/support/index.scss';

.development-notice {
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  position: sticky;
}

#console-error-notice,
#bundle-error-notice,
#hydration-error-notice {
  font-family: var(--fontStack-monospace);
  font-size: var(--text-body-size-small);
  text-align: center;
}

.console-error {
  outline: 3px solid var(--borderColor-danger-emphasis, var(--color-danger-emphasis)) !important;
}
