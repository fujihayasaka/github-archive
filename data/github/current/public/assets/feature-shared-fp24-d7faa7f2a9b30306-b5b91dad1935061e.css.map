/* stylelint-disable primer/borders*/

/* Shared styles for /features pages*/

/* Makes sure the Rails footer is pushed down while React is loading.*/
.application-main {
  min-height: 100vh;
}

/* Layout ----------------------------------------------------*/

.fp-Section--isRaised {
  background: var(--brand-color-canvas-subtle);
  border-radius: var(--base-size-40);
}

/* keep narrow and centered until we switch to 2 columns*/

.fp-Section-container {
  max-width: 544px;
  padding-right: var(--base-size-16);
  padding-left: var(--base-size-16);
  margin: 0 auto;

  @media (min-width: 768px) {
    max-width: none;
    padding-right: var(--base-size-40);
    padding-left: var(--base-size-40);
  }

  @media (min-width: 1012px) {
    padding-right: var(--base-size-64);
    padding-left: var(--base-size-64);
  }

  @media (min-width: 1280px) {
    max-width: 1408px; /* 1248px + 2x80px padding */
    padding-right: var(--base-size-80);
    padding-left: var(--base-size-80);
  }
}

/* Utilities ----------------------------------------------------*/

.fp-hasFontSmoothing {
  -webkit-font-smoothing: antialiased; /* Makes text a bit thinner */
  -moz-osx-font-smoothing: grayscale;
}

.fp-gradientBorder {
  position: relative;
  border-color: transparent;

  &::before {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
    content: "";
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, .60), rgba(0, 0, 0, .40));
    border-color: #D8DEE4;
    border-radius: inherit;

    .fp-hasDarkGradientBorder & {
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, .60), rgba(0, 0, 0, .10));
      border: 1px solid var(--brand-color-border-default);
    }
  }
}


/* Spacers ----------------------------------------------------*/

/*    0px - 543px  (mobile)*/
/*  544px - 767px  (tablet - portrait)*/
/*  768px - 1011px (tablet - landscape)*/
/* 1012px - 1279px (laptop)*/
/* 1280px - ~      (desktop)*/

.fp-Spacer {
  display: block;
  height: var(--Spacer-size, 80px);
}

@media (min-width: 544px) {
  .fp-Spacer {
    height: var(--Spacer-size544, var(--Spacer-size, 96px));
  }
}

@media (min-width: 768px) {
  .fp-Spacer {
    height: var(--Spacer-size768, var(--Spacer-size544, var(--Spacer-size, 112px)));
  }
}

@media (min-width: 1012px) {
  .fp-Spacer {
    height: var(--Spacer-size1012, var(--Spacer-size768, var(--Spacer-size544, var(--Spacer-size, 128px))));
  }
}

@media (min-width: 1280px) {
  .fp-Spacer {
    height: var(--Spacer-size1280, var(--Spacer-size1012, var(--Spacer-size768, var(--Spacer-size544, var(--Spacer-size, 156px)))));
  }
}


/* Primer overrides ----------------------------------------------------*/

/* Remove default spacing*/

.fp-Hero,
.fp-SectionIntro,
.fp-RiverBreakout {
  padding-top: 0;
  padding-bottom: 0;
}

/* Hero*/

.fp-Hero-heading {
  /* stylelint-disable-next-line primer/typography*/
  line-height: 1;
}

/* River*/

/* Makes sure that the visual appears first on mobile*/
@media (max-width: 767px) {
  .fp-River-visual {
    order: -1;
  }
}

/* RiverBreakout*/

/* Makes sure image is not cut off*/
.fp-RiverBreakoutVisualImage {
  display: block;
}

/* `auto` makes sure that the text only takes up the space it needs*/
.fp-RiverBreakout-content {
  grid-template-rows: auto 1fr;
}

/* Animations ----------------------------------------------------*/

/* Reveal page on load*/

.fp-animateOnLoad {
  position: relative;
}

@media (prefers-reduced-motion: no-preference) {
  .fp-animateOnLoad::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 1;
    height: 100vh;
    pointer-events: none;
    content: "";
    background-color: var(--brand-color-canvas-default);
    animation: fp-animateOnLoad-anim 0.6s cubic-bezier(0.66, 0, 0.66, 1) forwards;
  }
}

@keyframes fp-animateOnLoad-anim {
  100% {
    visibility: hidden;
    opacity: 0;
  }
}


/* Accessibility ----------------------------------------------------*/

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition: none !important;
    animation: none !important;
  }
}

/* SubNav overrides -------------------------------------------------*/

.lp-Hero-subnav {
  z-index: 10;
  position: relative;
}

@media (min-width: 1011px) {
  .lp-Hero-subnav .sentinel {
    display: none; /* Temporary fix for the sentinel element being visible until the fix in primer/brand is released*/
  }
}

@media (max-width: 1011px) {
  .lp-Hero-subnav {
    position: absolute;
  }
}
