{
  "relative_to": "document",
  "prefetch": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "selector_matches": "[data-prefetch='immediate']" }
        ]
      },
      "eagerness": "immediate"
    },
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "selector_matches": "[data-prefetch='eager']" }
        ]
      },
      "eagerness": "eager"
    },
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "selector_matches": "[data-prefetch='moderate']" }
        ]
      },
      "eagerness": "moderate"
    },
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "selector_matches": "[data-prefetch='conservative']" }
        ]
      },
      "eagerness": "conservative"
    }
  ],
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "selector_matches": "[data-prerender='immediate']" }
        ]
      },
      "eagerness": "immediate"
    },
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "selector_matches": "[data-prerender='eager']" }
        ]
      },
      "eagerness": "eager"
    },
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "selector_matches": "[data-prerender='moderate']" }
        ]
      },
      "eagerness": "moderate"
    },
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "selector_matches": "[data-prerender='conservative']" }
        ]
      },
      "eagerness": "conservative"
    }
  ]
}
