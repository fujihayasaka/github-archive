# typed: strict
# frozen_string_literal: true

class MemexProjectItem
  sig { returns(T::Boolean) }
  def issue?; end
  sig { returns(T::Boolean) }
  def draft_issue?; end
  sig { returns(T::Boolean) }
  def pull_request?; end

  sig { returns(T.nilable(T.any(Issue, PullRequest, DraftIssue))) }
  def content; end

  # todo: figure out why association methods are not being generated by the tapioca active record compiler

  sig { returns(T::Boolean) }
  def archiver_changed?; end
end
