class Vonage::Voice < ::Vonage::Namespace
  # Create an outbound Call.
  #
  # @example
  #   response = client.voice.create({
  #   to: [{type: 'phone', number: '14843331234'}],
  #   from: {type: 'phone', number: '14843335555'},
  #   answer_url: ['https://example.com/answer']
  #   })
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @param params [Hash]
  # @return [Response]
  # @see https://developer.nexmo.com/api/voice#createCall
  def create(params); end

  # @return [DTMF]
  def dtmf; end

  # Earmuff an in progress call.
  #
  # @example
  #   response = client.voice.earmuff(id)
  # @param id [String]
  # @return [Response]
  # @see https://developer.nexmo.com/api/voice#updateCall
  def earmuff(id); end

  # Get detail of a specific call.
  #
  # @example
  #   response = client.voice.get(id)
  # @param id [String]
  # @return [Response]
  # @see https://developer.nexmo.com/api/voice#getCall
  def get(id); end

  # Hangup an in progress call.
  #
  # @example
  #   response = client.voice.hangup(id)
  # @param id [String]
  # @return [Response]
  # @see https://developer.nexmo.com/api/voice#updateCall
  def hangup(id); end

  # Get details of your calls.
  #
  # @example
  #   response = client.voice.list
  #   response.each do |item|
  #   puts "#{item.uuid} #{item.direction} #{item.status}"
  #   end
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @option params
  # @param params [Hash]
  # @return [ListResponse]
  # @see https://developer.nexmo.com/api/voice#getCalls
  def list(params = T.unsafe(nil), auto_advance = T.unsafe(nil)); end

  # Mute an in progress call.
  #
  # @example
  #   response = client.voice.mute(id)
  # @param id [String]
  # @return [Response]
  # @see https://developer.nexmo.com/api/voice#updateCall
  def mute(id); end

  # @return [Stream]
  def stream; end

  # @return [Talk]
  def talk; end

  # Transfer an in progress call.
  #
  # @example
  #   destination = {
  #   type: 'ncco',
  #   url: ['https://example.com/ncco.json']
  #   }
  #
  #   response = client.voice.transfer(id, destination: destination)
  # @param id [String]
  # @param destination [Hash]
  # @return [Response]
  # @see https://developer.nexmo.com/api/voice#updateCall
  def transfer(id, destination:); end

  # Unearmuff an in progress call.
  #
  # @example
  #   response = client.voice.unearmuff(id)
  # @param id [String]
  # @return [Response]
  # @see https://developer.nexmo.com/api/voice#updateCall
  def unearmuff(id); end

  # Unmute an in progress call.
  #
  # @example
  #   response = client.voice.unmute(id)
  # @param id [String]
  # @return [Response]
  # @see https://developer.nexmo.com/api/voice#updateCall
  def unmute(id); end

  # Modify an in progress call.
  #
  # @example
  #   response = client.voice.update(id, action: 'hangup')
  # @option params
  # @option params
  # @param id [String]
  # @param params [Hash]
  # @return [Response]
  # @see https://developer.nexmo.com/api/voice#updateCall
  def update(id, params); end

  # Validate a JSON Web Token from a Voice API Webhook.
  #
  # @param :token [String, required] The JWT from the Webhook's Authorization header
  # @param :signature_secret [String, optional] The account signature secret. Required, unless `signature_secret`
  #   is set in `Config`
  # @return [Boolean] true, if the JWT is verified, false otherwise
  def verify_webhook_token(token:, signature_secret: T.unsafe(nil)); end
end

