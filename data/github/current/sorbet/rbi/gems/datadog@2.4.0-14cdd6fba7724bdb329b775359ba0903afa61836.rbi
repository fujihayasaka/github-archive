  end
end

# Rails module includes middlewares that are required for Rails to be properly instrumented.
module Datadog::Tracing::Contrib::Rails; end

# The instrumentation target, {Rails::Command::RunnerCommand} is only loaded
# right before `bin/rails runner` is executed. This means there's not much
# opportunity to patch it ahead of time.
# To ensure we can patch it successfully, we patch it's caller, {Rails::Command}
# and promptly patch {Rails::Command::RunnerCommand} when it is loaded.
module Datadog::Tracing::Contrib::Rails::Command
  def find_by_namespace(*args, **_arg1); end
end

module Datadog::Tracing::Contrib::Rails::Configuration; end

# Custom settings for the Rails integration
