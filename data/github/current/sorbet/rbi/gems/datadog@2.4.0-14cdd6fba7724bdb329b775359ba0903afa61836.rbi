  def distributed_tags; end

  # Returns the value of attribute events.
  def events; end

  def finish_span(span, span_op, parent); end
  def reset; end

  # Returns the value of attribute root_span.
  def root_span; end

  # Track the root span
  def set_root_span!(span); end

  def start_span(span_op); end
end

