  # @return [CaseInsensitiveWrapper] a new instance of CaseInsensitiveWrapper
  def initialize(hash); end

  def [](key); end

  # @return [Boolean]
  def empty?; end

  # @return [Boolean]
  def key?(key); end

  def length; end
  def original_hash; end
end

