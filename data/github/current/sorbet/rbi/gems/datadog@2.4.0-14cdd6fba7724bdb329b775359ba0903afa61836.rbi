  include ::Datadog::Core::Workers::Polling
  include ::Datadog::Core::Workers::IntervalLoop
  include ::Datadog::Core::Workers::Async::Thread

  # @return [Worker] a new instance of Worker
  def initialize(heartbeat_interval_seconds:, metrics_aggregation_interval_seconds:, emitter:, metrics_manager:, dependency_collection:, enabled: T.unsafe(nil), shutdown_timeout: T.unsafe(nil), buffer_size: T.unsafe(nil)); end

  def enqueue(event); end

  # @return [Boolean]
  def failed_to_start?; end

  def perform(*args); end

  # @return [Boolean]
  def sent_started_event?; end

  def start; end
  def stop(force_stop = T.unsafe(nil), timeout = T.unsafe(nil)); end

  private

  def buffer_klass; end
  def dequeue; end
  def disable!; end
  def disable_on_not_found!(response); end
  def flush_events(events); end
  def heartbeat!; end
  def send_event(event); end
  def started!; end

  # @return [Boolean]
