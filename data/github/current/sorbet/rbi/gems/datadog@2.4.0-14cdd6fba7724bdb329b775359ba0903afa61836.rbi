  def method_missing(*args); end

  # Returns the value of attribute opts.
  def opts; end

  # Returns the value of attribute original_filename.
  def original_filename; end

  # @return [Boolean]
  def respond_to?(meth, include_all = T.unsafe(nil)); end

  class << self
