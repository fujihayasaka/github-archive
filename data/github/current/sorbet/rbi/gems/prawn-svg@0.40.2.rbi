  # source://prawn-svg//lib/prawn/svg/pattern_renderer.rb#16
  def draw; end

  private

  # Maps pattern space to page space WITHOUT patternTransform.
  # Used to shift stamp content (in page coords) to pattern-local coords.
  #
  # source://prawn-svg//lib/prawn/svg/pattern_renderer.rb#96
