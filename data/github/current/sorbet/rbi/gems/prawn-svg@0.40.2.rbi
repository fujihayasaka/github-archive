class Prawn::SVG::PatternRenderer
  include ::Prawn::SVG::PDFMatrix

  # @return [PatternRenderer] a new instance of PatternRenderer
  #
  # source://prawn-svg//lib/prawn/svg/pattern_renderer.rb#4
