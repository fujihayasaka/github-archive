  # source://stripe//lib/stripe/resources/balance.rb#169
  def instant_available; end

  # Attribute for field issuing
  #
  # source://stripe//lib/stripe/resources/balance.rb#171
  def issuing; end

  # Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
  #
  # source://stripe//lib/stripe/resources/balance.rb#173
  def livemode; end

  # String representing the object's type. Objects of the same type share the same value.
  #
  # source://stripe//lib/stripe/resources/balance.rb#175
  def object; end

  # Funds that aren't available in the balance yet. You can find the pending balance for each currency and each payment type in the `source_types` property.
  #
  # source://stripe//lib/stripe/resources/balance.rb#177
  def pending; end

  # Attribute for field refund_and_dispute_prefunding
  #
  # source://stripe//lib/stripe/resources/balance.rb#179
  def refund_and_dispute_prefunding; end

  class << self
    # source://stripe//lib/stripe/resources/balance.rb#13
    def object_name; end
  end
end

