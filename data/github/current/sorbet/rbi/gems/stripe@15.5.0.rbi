  # source://stripe//lib/stripe/resources/tax/transaction.rb#265
  def ship_from_details; end

  # The shipping cost details for the transaction.
  #
  # source://stripe//lib/stripe/resources/tax/transaction.rb#267
  def shipping_cost; end

  # Timestamp of date at which the tax rules and rates in effect applies for the calculation.
  #
  # source://stripe//lib/stripe/resources/tax/transaction.rb#269
  def tax_date; end

  # If `reversal`, this transaction reverses an earlier transaction.
