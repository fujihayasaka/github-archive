  # Unique identifier for the transaction.
  #
  # source://stripe//lib/stripe/resources/tax/transaction.rb#249
  def id; end

  # The tax collected or refunded, by line item.
  #
  # source://stripe//lib/stripe/resources/tax/transaction.rb#251
  def line_items; end

  # Retrieves the line items of a committed standalone transaction as a collection.
  #
  # source://stripe//lib/stripe/resources/tax/transaction.rb#294
  sig do
    params(
      params: T.any(::Stripe::Tax::Transaction::ListLineItemsParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(Stripe::ListObject)
  end
  def list_line_items(params = T.unsafe(nil), opts = T.unsafe(nil)); end

  # Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
  #
  # source://stripe//lib/stripe/resources/tax/transaction.rb#253
  def livemode; end

  # Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
  #
  # source://stripe//lib/stripe/resources/tax/transaction.rb#255
  def metadata; end

  # String representing the object's type. Objects of the same type share the same value.
