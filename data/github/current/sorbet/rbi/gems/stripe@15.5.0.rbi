    params(
      coupon: String,
      params: T.any(::Stripe::CouponService::RetrieveParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(Stripe::Coupon)
  end
  def retrieve(coupon, params = T.unsafe(nil), opts = T.unsafe(nil)); end

