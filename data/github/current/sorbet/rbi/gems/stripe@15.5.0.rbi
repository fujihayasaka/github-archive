# source://stripe//lib/stripe/resources/identity/verification_report.rb#5
module Stripe::Identity; end

# A VerificationReport is the result of an attempt to collect and verify data from a user.
# The collection of verification checks performed is determined from the `type` and `options`
# parameters used. You can find the result of each verification check performed in the
# appropriate sub-resource: `document`, `id_number`, `selfie`.
#
# Each VerificationReport contains a copy of any data collected by the user as well as
# reference IDs which can be used to access collected images through the [FileUpload](https://stripe.com/docs/api/files)
# API. To configure and create VerificationReports, use the
# [VerificationSession](https://stripe.com/docs/api/identity/verification_sessions) API.
#
# Related guide: [Accessing verification results](https://stripe.com/docs/identity/verification-sessions#results).
#
# source://stripe//lib/stripe/resources/identity/verification_report.rb#17
class Stripe::Identity::VerificationReport < ::Stripe::APIResource
  extend ::Stripe::APIOperations::List

  # A string to reference this user. This can be a customer ID, a session ID, or similar, and can be used to reconcile this verification with your internal systems.
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#260
  def client_reference_id; end

  # Time at which the object was created. Measured in seconds since the Unix epoch.
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#262
  def created; end

  # Result from a document check
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#264
  def document; end

  # Result from a email check
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#266
  def email; end

  # Unique identifier for the object.
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#268
  def id; end

  # Result from an id_number check
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#270
  def id_number; end

  # Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#272
  def livemode; end

  # String representing the object's type. Objects of the same type share the same value.
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#274
  def object; end

  # Attribute for field options
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#276
  def options; end

  # Result from a phone check
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#278
  def phone; end

  # Result from a selfie check
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#280
  def selfie; end

  # Type of report.
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#282
  def type; end

  # The configuration token of a verification flow from the dashboard.
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#284
  def verification_flow; end

  # ID of the VerificationSession that created this report.
  #
  # source://stripe//lib/stripe/resources/identity/verification_report.rb#286
  def verification_session; end

  class << self
    # List all verification reports.
    #
    # source://stripe//lib/stripe/resources/identity/verification_report.rb#289
    sig do
      params(
        params: T.any(::Stripe::Identity::VerificationReport::ListParams, T::Hash[T.untyped, T.untyped]),
        opts: T.untyped
      ).returns(Stripe::ListObject)
    end
    def list(params = T.unsafe(nil), opts = T.unsafe(nil)); end

    # source://stripe//lib/stripe/resources/identity/verification_report.rb#21
    def object_name; end
  end
end

