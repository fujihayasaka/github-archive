  def object; end

  # Reason for the event.
  #
  # source://stripe//lib/stripe/resources/v2/event.rb#34
  def reason; end

  # The type of the event.
  #
  # source://stripe//lib/stripe/resources/v2/event.rb#36
  def type; end

  class << self
    # source://stripe//lib/stripe/resources/v2/event.rb#9
    def object_name; end
  end
end

