# Invoice Payments represent payments made against invoices. Invoice Payments can
# be accessed in two ways:
# 1. By expanding the `payments` field on the [Invoice](https://stripe.com/docs/api#invoice) resource.
# 2. By using the Invoice Payment retrieve and list endpoints.
#
# Invoice Payments include the mapping between payment objects, such as Payment Intent, and Invoices.
# This resource and its endpoints allows you to easily track if a payment is associated with a specific invoice and
# monitor the allocation details of the payments.
#
# source://stripe//lib/stripe/resources/invoice_payment.rb#13
class Stripe::InvoicePayment < ::Stripe::APIResource
  extend ::Stripe::APIOperations::List

  # Amount that was actually paid for this invoice, in cents (or local equivalent). This field is null until the payment is `paid`. This amount can be less than the `amount_requested` if the PaymentIntent’s `amount_received` is not sufficient to pay all of the invoices that it is attached to.
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#83
  def amount_paid; end

  # Amount intended to be paid toward this invoice, in cents (or local equivalent)
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#85
  def amount_requested; end

  # Time at which the object was created. Measured in seconds since the Unix epoch.
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#87
  def created; end

  # Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#89
  def currency; end

  # Unique identifier for the object.
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#91
  def id; end

  # The invoice that was paid.
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#93
  def invoice; end

  # Stripe automatically creates a default InvoicePayment when the invoice is finalized, and keeps it synchronized with the invoice’s `amount_remaining`. The PaymentIntent associated with the default payment can’t be edited or canceled directly.
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#95
  def is_default; end

  # Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#97
  def livemode; end

  # String representing the object's type. Objects of the same type share the same value.
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#99
  def object; end

  # Attribute for field payment
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#101
  def payment; end

  # The status of the payment, one of `open`, `paid`, or `canceled`.
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#103
  def status; end

  # Attribute for field status_transitions
  #
  # source://stripe//lib/stripe/resources/invoice_payment.rb#105
  def status_transitions; end

  class << self
    # When retrieving an invoice, there is an includable payments property containing the first handful of those items. There is also a URL where you can retrieve the full (paginated) list of payments.
    #
    # source://stripe//lib/stripe/resources/invoice_payment.rb#108
    sig do
      params(
        params: T.any(::Stripe::InvoicePayment::ListParams, T::Hash[T.untyped, T.untyped]),
        opts: T.untyped
      ).returns(Stripe::ListObject)
    end
    def list(params = T.unsafe(nil), opts = T.unsafe(nil)); end

    # source://stripe//lib/stripe/resources/invoice_payment.rb#17
    def object_name; end
  end
end

