# A payment method domain represents a web domain that you have registered with Stripe.
# Stripe Elements use registered payment method domains to control where certain payment methods are shown.
#
# Related guide: [Payment method domains](https://stripe.com/docs/payments/payment-methods/pmd-registration).
#
# source://stripe//lib/stripe/resources/payment_method_domain.rb#9
class Stripe::PaymentMethodDomain < ::Stripe::APIResource
  include ::Stripe::APIOperations::Save
  extend ::Stripe::APIOperations::Create
  extend ::Stripe::APIOperations::List
  extend ::Stripe::APIOperations::Save::ClassMethods

  # Indicates the status of a specific payment method on a payment method domain.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#152
  def amazon_pay; end

  # Indicates the status of a specific payment method on a payment method domain.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#154
  def apple_pay; end

  # Time at which the object was created. Measured in seconds since the Unix epoch.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#156
  def created; end

  # The domain name that this payment method domain object represents.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#158
  def domain_name; end

  # Whether this payment method domain is enabled. If the domain is not enabled, payment methods that require a payment method domain will not appear in Elements.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#160
  def enabled; end

  # Indicates the status of a specific payment method on a payment method domain.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#162
  def google_pay; end

  # Unique identifier for the object.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#164
  def id; end

  # Indicates the status of a specific payment method on a payment method domain.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#166
  def klarna; end

  # Indicates the status of a specific payment method on a payment method domain.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#168
  def link; end

  # Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#170
  def livemode; end

  # String representing the object's type. Objects of the same type share the same value.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#172
  def object; end

  # Indicates the status of a specific payment method on a payment method domain.
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#174
  def paypal; end

  # Some payment methods might require additional steps to register a domain. If the requirements weren't satisfied when the domain was created, the payment method will be inactive on the domain.
  # The payment method doesn't appear in Elements or Embedded Checkout for this domain until it is active.
  #
  # To activate a payment method on an existing payment method domain, complete the required registration steps specific to the payment method, and then validate the payment method domain with this endpoint.
  #
  # Related guides: [Payment method domains](https://docs.stripe.com/docs/payments/payment-methods/pmd-registration).
  #
  # source://stripe//lib/stripe/resources/payment_method_domain.rb#212
  # Some payment methods might require additional steps to register a domain. If the requirements weren't satisfied when the domain was created, the payment method will be inactive on the domain.
  # The payment method doesn't appear in Elements or Embedded Checkout for this domain until it is active.
  # To activate a payment method on an existing payment method domain, complete the required registration steps specific to the payment method, and then validate the payment method domain with this endpoint.
  sig do
    params(
      params: T.any(::Stripe::PaymentMethodDomain::ValidateParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
