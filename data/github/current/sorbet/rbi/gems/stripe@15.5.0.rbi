  # Attribute for field after_completion
  #
  # source://stripe//lib/stripe/resources/payment_link.rb#1664
  def after_completion; end

  # Whether user redeemable promotion codes are enabled.
  #
  # source://stripe//lib/stripe/resources/payment_link.rb#1666
  def allow_promotion_codes; end

  # The ID of the Connect application that created the Payment Link.
  #
  # source://stripe//lib/stripe/resources/payment_link.rb#1668
  def application; end

  # The amount of the application fee (if any) that will be requested to be applied to the payment and transferred to the application owner's Stripe account.
  #
  # source://stripe//lib/stripe/resources/payment_link.rb#1670
  def application_fee_amount; end

  # This represents the percentage of the subscription invoice total that will be transferred to the application owner's Stripe account.
  #
  # source://stripe//lib/stripe/resources/payment_link.rb#1672
  def application_fee_percent; end

  # Attribute for field automatic_tax
  #
  # source://stripe//lib/stripe/resources/payment_link.rb#1674
  def automatic_tax; end

  # Configuration for collecting the customer's billing address. Defaults to `auto`.
  #
  # source://stripe//lib/stripe/resources/payment_link.rb#1676
  def billing_address_collection; end

  # When set, provides configuration to gather active consent from customers.
