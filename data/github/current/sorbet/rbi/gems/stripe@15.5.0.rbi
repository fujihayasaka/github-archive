      params: T.any(::Stripe::CouponService::ListParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(Stripe::ListObject)
  end
  def list(params = T.unsafe(nil), opts = T.unsafe(nil)); end

  # Retrieves the coupon with the given ID.
  #
  # source://stripe//lib/stripe/services/coupon_service.rb#181
