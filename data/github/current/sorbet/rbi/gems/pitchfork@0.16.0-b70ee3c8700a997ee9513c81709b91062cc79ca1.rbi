# This class and its members can be considered a stable interface
# and will not change in a backwards-incompatible fashion between
# releases of pitchfork.  Knowledge of this class is generally not
# needed for most users of pitchfork.
#
# Some users may want to access it in the after_worker_fork/after_mold_fork hooks.
# See the Pitchfork::Configurator RDoc for examples.
class Pitchfork::Worker
  # @return [Worker] a new instance of Worker
  def initialize(nr, pid: T.unsafe(nil), generation: T.unsafe(nil)); end

  # worker objects may be compared to just plain Integers
  def ==(other); end

  # this only runs when the Rack app.call is not running
  # act like a listener
  def accept_nonblock(exception: T.unsafe(nil)); end

  def after_fork_in_child; end

  # called in both the master (reaping worker) and worker (SIGQUIT handler)
  def close; end

  def create_socketpair!; end

  # called in the master process
  def deadline; end

  # called in the worker process
  def deadline=(value); end

  # @return [Boolean]
  def exiting?; end

  # call a signal handler immediately without triggering EINTR
  # We do not use the more obvious Process.kill(sig, $$) here since
  # that signal delivery may be deferred.  We want to avoid signal delivery
  # while the Rack app.call is running because some database drivers
  # (e.g. ruby-pg) may cancel pending requests.
  def fake_sig(sig); end

  def finish_promotion(control_socket); end

  # Returns the value of attribute generation.
  def generation; end

  # Sets the attribute generation
  #
  # @param value the value to set the attribute generation to.
  def generation=(_arg0); end

  def hard_kill(sig); end
  def increment_requests_count(by = T.unsafe(nil)); end

  # Returns the value of attribute master.
  def master; end

  def master=(socket); end

  # @return [Boolean]
  def mold?; end

  # Returns the value of attribute nr.
  def nr; end

  # Sets the attribute nr
  #
  # @param value the value to set the attribute nr to.
  def nr=(_arg0); end

  # @return [Boolean]
  def outdated?; end

  # @return [Boolean]
  def pending?; end

  # Returns the value of attribute pid.
  def pid; end

  # Sets the attribute pid
  #
  # @param value the value to set the attribute pid to.
  def pid=(_arg0); end

  def promote(generation); end
  def promote!(timeout); end
  def promoted!(timeout); end
  def register_to_master(control_socket); end

  # Returns the value of attribute requests_count.
  def requests_count; end

  def reset; end

  # @return [Boolean]
  def service?; end

  # master sends fake signals to children
  def soft_kill(sig); end

  def spawn_service(_new_service); end
  def spawn_worker(new_worker); end
  def start_promotion(control_socket); end

  # IO.select-compatible
  def to_io; end

  def to_log; end
  def update(message); end
  def update_deadline(timeout); end

  private

  def init_deadline; end

  # @raise [ArgumentError]
  def pipe=(socket); end

  def send_message_nonblock(message); end
end

