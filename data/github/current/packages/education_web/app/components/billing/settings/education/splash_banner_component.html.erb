<% content_for :head do %>
  <%= stylesheet_bundle 'signup_education_benefit' %>
<% end %>

<div class="Box tmp-mb-4 education-splash-banner" <%= test_selector("education-splash-banner") %>>

  <div class="education-splash-content">
    <h2 class="h1 tmp-mb-3 color-fg-default lh-condensed" <%= test_selector("education-splash-banner-title") %>>
      Free GitHub developer resources for students and teachers
    </h2>

    <p class="f4 color-fg-muted tmp-mb-4" <%= test_selector("education-splash-banner-description") %>>
      Get Copilot for free, 180 monthly Codespaces hours for cloud coding,
      unlimited private repositories with GitHub Pro or Team, and dozens of
      premium tools in the Student Developer Pack.
    </p>

    <%= render(Primer::Beta::Button.new(
      tag: :a,
      href: "https://github.com/education",
      test_selector: "education-splash-banner-cta",
      target: "_blank"
    )) { "Learn more" } %>
  </div>

  <div class="education-splash-image">
    <%= image_tag "education/education-settings-banner-background.png",
      alt: "",
      class: "d-block" %>
  </div>

</div>
