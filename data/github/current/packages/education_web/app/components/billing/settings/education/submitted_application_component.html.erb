<details
  class="Box-row billing-box-accordion details-reset p-0 flex-items-center color-fg-muted"
  data-deferred-details-content-url="<%= '' %>"
  <%= test_selector("submitted-application-row") %>
>
  <summary class="Details-element">
    <%= summary_content_component %>
  </summary>
  <%= render Primer::Alpha::IncludeFragment.new(
    src: settings_education_developer_pack_applications_metadatum_path(submitted_application),
    m: 4,
    display: :flex,
    direction: :column,
    align_items: :center
  ) do %>
    <%= render(Primer::Beta::Spinner.new) %>
    <div class="color-fg-muted no-wrap">Loading details</div>
  <% end %>
</details>
