<div id="developer-pack-history" class="Box mb-4">
  <div class="Box-header p-0">
    <div class="Box-row d-flex flex-items-center">
      <div class="d-flex flex-items-center">
        <%= render Primer::Beta::Octicon.new(icon: "mortar-board", height: 32, width: 32, color: :accent) %>
      </div>
      <div class="Box-title flex-auto ml-1 pl-2">
        <div>Developer Pack</div>

        <div class="text-small text-normal color-fg-muted px-md-0 px-6" <%= test_selector("edu-apply-text") %>>
          <% if current_coupon_holder? %>
            <%= already_applied_coupon_text %>
          <% elsif user_has_pending_application? %>
            <%= current_pending_application_text %>
          <% else %>
            Complete an application to unlock tools and resources for your educational journey.
          <% end %>
        </div>
      </div>

      <%= render Primer::Alpha::Dialog.new(
        title: "Developer Pack Application",
        variant: :large,
        size: :medium_portrait,
      ) do |dialog| %>
        <% dialog.with_show_button(
          scheme: :primary,
          size: :small,
          disabled: current_coupon_holder? || user_has_pending_application?,
          test_selector: "devpack-apply-button",
        ).with_content("Start an application") %>

        <% dialog.with_header(show_divider: true) do %>
          <div class="d-flex flex-items-center">
            <%= render Primer::Beta::Octicon.new(icon: "mortar-board", height: 32, width: 32, color: :accent) %>
            <div class="ml-2">
              <h3 class="mb-0">Developer Pack Application</h3>
            </div>
          </div>
        <% end %>

        <% dialog.with_body(m: 2) do %>
          <%= render Billing::Settings::Education::DeveloperPackApplicationComponent.new(user:) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if user_has_application? %>
    <% ordered_application_metadata.each do |submitted_application| %>
      <%= render Billing::Settings::Education::SubmittedApplicationComponent.new(submitted_application:) %>
    <% end %>
  <% else %>
    <div class="text-center py-3">
      <strong>
        You have not submitted an application for the Developer Pack.
      </strong>
    </div>
  <% end %>
</div>
