<div id="education-benefits" class="Box mb-4">
  <div class="Box-header p-0">
    <div class="Box-row d-flex flex-items-center flex-wrap">
      <div class="d-flex flex-items-center">
        <%= render Primer::Beta::Octicon.new(icon: "mortar-board", height: 32, width: 32, color: :accent) %>
      </div>
      <div class="Box-title flex-auto ml-1 pl-2">
        <div>Education Benefits</div>

        <div class="text-small text-normal color-fg-muted px-md-0 px-6" <%= test_selector("edu-apply-text") %>>
          <% if current_coupon_holder? %>
            <%= already_applied_coupon_text %>
          <% elsif user_has_pending_application? %>
            <%= current_pending_application_text %>
          <% else %>
            Complete a teacher or student application to unlock tools and
            resources for your educational journey.
          <% end %>
        </div>
      </div>

    <education-overview-component>
      <% if spammy_suspended_trade_restrictions_edu_blocked? %>
        <%= render(Primer::Beta::Link.new(
          href: pricing_path,
          color: :on_emphasis,
          classes: "btn btn-primary btn-sm",
          underline: false,
          test_selector: "devpack-apply-link",
        )) { dialog_button_label } %>
      <% else %>
        <%= render Primer::Alpha::Dialog.new(
          title: "Education Benefits Application",
          variant: :large,
          size: :medium_portrait,
          id: "education-benefits-dialog",
        ) do |dialog| %>
          <% dialog.with_show_button(
            scheme: :primary,
            size: :small,
            my: 2,
            disabled: dialog_button_disabled?,
            test_selector: "devpack-apply-button",
          ).with_content(dialog_button_label) %>

          <% dialog.with_header(show_divider: true) do %>
            <div class="d-flex flex-items-center">
              <%= render Primer::Beta::Octicon.new(icon: "mortar-board", height: 32, width: 32, color: :accent) %>
              <div class="ml-2">
                <h3 class="mb-0">Education Benefits Application</h3>
              </div>
            </div>
          <% end %>

          <% dialog.with_body(m: 2) do %>
            <%= render Billing::Settings::Education::DeveloperPackApplicationComponent.new(
              user:,
              utm_source:,
              utm_content:,
            ) %>
          <% end %>
        <% end %>
      <% end %>
    </education-overview-component>
    </div>
  </div>

  <% if user_has_application? %>
    <% ordered_application_metadata.each do |submitted_application| %>
      <%= render Billing::Settings::Education::SubmittedApplicationComponent.new(submitted_application:) %>
    <% end %>

    <% if show_pagination? %>
      <div class="Box-row border-top pt-2 pb-3 text-center" <%= test_selector("pagination-container") %>>
        <%= helpers.will_paginate(ordered_application_metadata, params: pagination_params) %>
      </div>
    <% end %>
  <% end %>
</div>
