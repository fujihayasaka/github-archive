<div>
  <% if applicant_is_teacher? %>
    <%= render Primer::Alpha::Banner.new(
      scheme: :warning,
      mb: 2,
    ).with_content("We need a little more proof to verify your academic status.") %>

    <p><strong>What helps with verification?</strong></p>
    <p>
      We can verify your application most easily when your proof includes your complete name, school name, and a current date. Faculty IDs, employment verification letters, and contracts with current dates are helpful. Clear, readable images help us process your application more quickly.
    </p>
  <% else %>
    <p>
      <strong>What helps with verification?</strong>
    </p>

    <p>
      We can verify your application most easily when your proof includes your complete name, school name, and a current date. Dated school IDs, current transcripts, and enrollment letters on official letterhead tend to work best. Clear, readable images help us process your application more quickly.
    </p>
  <% end %>
</div>

<% if form_errors[:photo_proof] %>
  <%= render(Primer::Beta::Octicon.new(:"alert-fill", color: :danger, size: :xsmall)) %>
  <%= render(Primer::Beta::Text.new(
    tag: :p,
    font_size: :small,
    font_weight: :bold,
    color: :danger,
    mt: 1,
    display: :inline_block,
  ).with_content(form_errors[:photo_proof])) %>
<% end %>

<%= render Billing::Settings::Education::WebcamUploadComponent.new(
  allow_file_upload: allow_file_upload?,
  form_field_id: "photo_proof",
) %>
