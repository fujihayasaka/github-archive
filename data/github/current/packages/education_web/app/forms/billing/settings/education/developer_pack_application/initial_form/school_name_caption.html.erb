<% if suggested_school %>
  <%= suggested_school_banner_content %>
<% end %>

<%= render Primer::Beta::AutoComplete.new(
  id: "js-school-name-search-container",
  list_id: "js-school-name-list",
  input_id: "js-school-name-search",
  label_text: "What is the name of your school? *",
  src: Rails.application.routes.url_helpers.settings_education_developer_pack_applications_schools_path,
  show_clear_button: true,
  full_width: true,
  input_name: "dev_pack_form[school_name]",
) do |component| %>
  <% component.with_leading_visual_icon(icon: :search) %>
<% end %>

<% if form_errors.include?(:school_name) %>
  <%= render(Primer::Beta::Text.new(
    tag: :p,
    font_size: :small,
    color: :danger,
    mt: 1,
    test_selector: "school-name-error",
  ).with_content(form_errors[:school_name])) %>
<% end %>

<%= render Education::DeveloperPackApplication::AutoCompleteSchoolsHelperComponent.new(
  location_shared_input_id:,
)%>

<p id="js-school-choice-caption" class="text-small color-fg-muted mt-1">
  If your school is not listed, then enter the full school name and continue.
  You will be asked to provide further information about your school on the next page.
  A minimum of two characters is required to find your school.
</p>

<p id="js-school-choice-2fa-error" class="text-small color-fg-danger mt-1" hidden>
  You have chosen a school that requires 2FA (two-factor authentication) to sign
  up for the Developer Pack. You do not currently have 2FA enabled on your account and cannot
  continue with this application.<br>
  <%= link_to(
    "Click here to enable 2FA.",
    Rails.application.routes.url_helpers.settings_user_2fa_intro_path,
    data: { turbo: false },
  ) %>
</p>

<%= chosen_school_has_allowlisted_domains_banner_content %>
