<%= render(Primer::Beta::NavList.new(
    selected_item_id: selected_item,
     **system_arguments,
  )) do |list| %>
    <% list.with_heading(title: title, font_size: 3) %>
    <% groups.each_with_index do |group, i| %>
      <% if group_has_divider?(group) && i > 0 %>
        <% list.with_divider %>
      <% end %>
      <% if group_is_folding?(group) %>
        <% list.with_group(classes: !group_has_divider?(group) ? "business-folding-group business-sidebar-flat" : "business-folding-group",) do |g| %>
          <% g.with_heading(title: title, display: :none) %>
          <% g.with_item(label: group.name) do |folding_group| %>
            <% folding_group.with_leading_visual_icon(icon: group.icon) %>
            <% if group.label.serialize == "private_preview" %>
              <% if user&.feature_enabled?(:lifecycle_label_name_updates) %>
                <% folding_group.with_trailing_visual_label(
                  scheme: :success,
                  title: "Feature Release Label: Private preview",
                  aria: { label: "Feature Release Label: Private preview" }) { "Private preview" } %>
              <% else %>
                <% folding_group.with_trailing_visual_label(
                  scheme: :success,
                  title: "Feature Release Label: Alpha",
                  aria: { label: "Feature Release Label: Alpha" }) { "Alpha" } %>
              <% end %>
            <% elsif group.label.serialize == "preview" %>
              <% if user&.feature_enabled?(:lifecycle_label_name_updates) %>
                <% folding_group.with_trailing_visual_label(
                  scheme: :success,
                  title: "Feature Release Label: Preview",
                  aria: { label: "Feature Release Label: Preview" }) { "Preview" } %>
              <% else %>
                <% folding_group.with_trailing_visual_label(
                  scheme: :success,
                  title: "Feature Release Label: Beta",
                  aria: { label: "Feature Release Label: Beta" }) { "Beta" } %>
              <% end %>
            <% end %>
            <% group.links.each_with_index do |menu_item, index| %>
              <% folding_group.with_item(
                test_selector: "business-sidebar-item",
                label: menu_item.link_name,
                href: menu_item.link_path,
                selected_by_ids: Array(menu_item.highlight)) do |item| %>
                <% if menu_item.icon %>
                  <% item.with_leading_visual_icon(icon: menu_item.icon) %>
                <% end %>
                <% if menu_item.label.serialize == "private_preview" %>
                  <% if user&.feature_enabled?(:lifecycle_label_name_updates) %>
                    <% item.with_trailing_visual_label(
                      scheme: :success,
                      title: "Feature Release Label: Private preview",
                      aria: { label: "Feature Release Label: Private preview" }) { "Private preview" } %>
                  <% else %>
                    <% item.with_trailing_visual_label(
                      scheme: :success,
                      title: "Feature Release Label: Alpha",
                      aria: { label: "Feature Release Label: Alpha" }) { "Alpha" } %>
                  <% end %>
                <% elsif menu_item.label.serialize == "preview" %>
                  <% if user&.feature_enabled?(:lifecycle_label_name_updates) %>
                    <% item.with_trailing_visual_label(
                      scheme: :success,
                      title: "Feature Release Label: Preview",
                      aria: { label: "Feature Release Label: Preview" }) { "Preview" } %>
                  <% else %>
                    <% item.with_trailing_visual_label(
                      scheme: :success,
                      title: "Feature Release Label: Beta",
                      aria: { label: "Feature Release Label: Beta" }) { "Beta" } %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <% group.links.each_with_index do |menu_item, index| %>
          <% list.with_item(
            classes: index == 0 && !group_has_divider?(group) ? "business-sidebar-flat" : "",
            test_selector: "business-sidebar-item",
            label: menu_item.link_name,
            href: menu_item.link_path,
            selected_by_ids: Array(menu_item.highlight)) do |item| %>
            <% if menu_item.icon %>
              <% item.with_leading_visual_icon(icon: menu_item.icon) %>
            <% end %>
            <% if menu_item.label.serialize == "private_preview" %>
              <% if user&.feature_enabled?(:lifecycle_label_name_updates) %>
                <% item.with_trailing_visual_label(
                  scheme: :success,
                  title: "Feature Release Label: Private preview",
                  aria: { label: "Feature Release Label: Private preview" }) { "Private preview" } %>
              <% else %>
                <% item.with_trailing_visual_label(
                  scheme: :success,
                  title: "Feature Release Label: Alpha",
                  aria: { label: "Feature Release Label: Alpha" }) { "Alpha" } %>
              <% end %>
            <% elsif menu_item.label.serialize == "preview" %>
              <% if user&.feature_enabled?(:lifecycle_label_name_updates) %>
                <% item.with_trailing_visual_label(
                  scheme: :success,
                  title: "Feature Release Label: Preview",
                  aria: { label: "Feature Release Label: Preview" }) { "Preview" } %>
              <% else %>
                <% item.with_trailing_visual_label(
                  scheme: :success,
                  title: "Feature Release Label: Beta",
                  aria: { label: "Feature Release Label: Beta" }) { "Beta" } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
