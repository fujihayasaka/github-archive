<%= render(Primer::Box.new(
  classes: "organization-ipm-banner dismissable js-notice tmp-mb-4",
  data: {
    test_selector: "organization-ipm-banner",
    **helpers.analytics_visible_attributes(
      context: nudge_category,
      category: nudge_category,
      organization: organization.id,
      plan: organization.plan.name,
      location: NUDGE_LOCATION,
      tag: 'promobanner',
    ),
  }
)) do %>
  <span class="d-none" <%= test_selector(nudge_category) %>></span>
  <% track_impression %>

  <div class="organization-ipm-banner-content">
    <%= render(Primer::Beta::Label.new(classes: "tmp-mb-3")) { banner_label } %>

    <h2 class="h2 my-1"><%= banner_title %></h2>

    <p class="color-fg-muted mb-0 organization-ipm-banner-description" style="max-width: 400px;">
      <%= banner_description %>
    </p>

    <div class="organization-ipm-banner-actions">
      <%= render(Primer::Beta::Button.new(
        scheme: :primary,
        tag: :a,
        href: primary_cta_href,
        mb: 0,
        test_selector: "banner-primary-cta",
        data: helpers.analytics_click_attributes(
          category: nudge_category,
          organization: organization.id,
          plan: organization.plan.name,
          action: primary_cta_action,
          location: NUDGE_LOCATION,
          tag: "button",
        )
      )) { primary_cta_text } %>

      <% if show_secondary_cta? %>
        <%= form_tag(
          secondary_cta_href,
          class: "js-notice-dismiss"
        ) do %>
          <%= render(Primer::Beta::Button.new(
            type: :submit,
            test_selector: "banner-secondary-cta",
            data: helpers.analytics_click_attributes(
              category: nudge_category,
              organization: organization.id,
              plan: organization.plan.name,
              action: secondary_cta_action,
              location: NUDGE_LOCATION,
              tag: "button",
            ),
            scheme: :invisible,
          )) do %>
            <%= render Primer::Beta::Octicon.new(:bell, classes: "organization-ipm-banner-remind-icon") %>
            <span class="organization-ipm-banner-remind-label"><%= secondary_cta_text %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="organization-ipm-banner-image-container">
    <img
      src="<%= helpers.image_path(banner_image_path_dark) %>"
      alt="<%= banner_image_alt_dark %>"
      class="organization-ipm-banner-image organization-ipm-banner-image-dark"
    >
    <img
      src="<%= helpers.image_path(banner_image_path_light) %>"
      alt="<%= banner_image_alt_light %>"
      class="organization-ipm-banner-image organization-ipm-banner-image-light"
    >
  </div>

  <%= form_tag(
    dismiss_path,
    class: "organization-ipm-banner-dismiss js-notice-dismiss"
  ) do %>
    <%= render Primer::Beta::CloseButton.new(
      type: :submit,
      test_selector: "banner-dismiss",
      data: helpers.analytics_click_attributes(
        category: nudge_category,
        organization: organization.id,
        plan: organization.plan.name,
        action: dismiss_action,
        location: NUDGE_LOCATION,
        tag: "button",
      )
    ) %>
  <% end %>
<% end %>
