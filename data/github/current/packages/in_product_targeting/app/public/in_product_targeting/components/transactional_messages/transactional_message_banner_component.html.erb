<div <%= test_selector(nudge_category) %> data-hpc>
  <%= form_tag dismiss_path, method: :post, class: "js-notice-dismiss", data: dismiss_analytics_data do %>
    <%= render(Primer::Alpha::Banner.new(
      scheme: :default,
      icon: :info,
      dismiss_scheme: :remove,
      dismiss_label: "Dismiss banner",
      test_selector: nudge_category,
      mt: banner_margin_top,
      data: {
        **visible_analytics_data,
      },
      classes: "tmp-mb-4")) do |component| %>
      <%= message_html %>
    <% end %>
  <% end %>
</div>
