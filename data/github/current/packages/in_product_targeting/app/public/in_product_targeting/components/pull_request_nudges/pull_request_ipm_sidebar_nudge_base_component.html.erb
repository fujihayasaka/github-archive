<%= content_tag(
  :span,
  nil,
  data: {
    **analytics_visible_attributes(
      category: nudge_category,
      organization: organization.id,
      plan: organization.plan.name,
      group: NUDGE_GROUP,
    ),
  },
  **test_selector_data_hash(nudge_category)
) %>

<div class="pull-request-ipm-sidebar-nudge-container">
  <div class="pull-request-ipm-sidebar-nudge-main">
    <h3 class="pull-request-ipm-sidebar-nudge-title" <%= test_selector("nudge-title") %>>
      <%= nudge_title %>
    </h3>

    <div class="pull-request-ipm-sidebar-nudge-description" <%= test_selector("nudge-description") %>>
      <%= nudge_description %>
    </div>

    <%= render Primer::Beta::Button.new(
      size: :medium,
      tag: :a,
      scheme: :primary,
      href: nudge_cta_href,
      classes: "text-small px-2",
      test_selector: "nudge-enable-button",
      data: analytics_click_attributes(
        category: nudge_category,
        action: nudge_cta_action,
        location: NUDGE_LOCATION,
        organization: organization.id,
        plan: organization.plan.name,
      )
    ) do %>
      <%= nudge_cta %>
    <% end %>
  </div>

  <div class="pull-request-ipm-sidebar-nudge-image-container">
    <img
      src="<%= image_path(nudge_image_path_dark) %>"
      alt="<%= nudge_image_alt_dark %>"
      class="pull-request-ipm-sidebar-nudge-image-dark"
    >
    <img
      src="<%= image_path(nudge_image_path_light) %>"
      alt="<%= nudge_image_alt_light %>"
      class="pull-request-ipm-sidebar-nudge-image-light"
    >
  </div>

  <%= form_tag(nudge_dismiss_form_path) do %>
    <div class="pull-request-ipm-sidebar-nudge-dismiss">
      <%= render(Primer::Beta::IconButton.new(
        type: :submit,
        icon: :x,
        scheme: :invisible,
        aria: { label: "Dismiss" },
        color: :muted,
        test_selector: "nudge-dismiss-button",
        data: analytics_click_attributes(
          action: "dismiss",
          category: nudge_category,
          group: NUDGE_GROUP,
          location: NUDGE_LOCATION,
          organization: organization.id,
          plan: organization.plan.name,
        ))) %>
    </div>
  <% end %>
</div>
