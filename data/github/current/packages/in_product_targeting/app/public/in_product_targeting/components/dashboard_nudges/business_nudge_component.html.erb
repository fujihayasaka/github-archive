<%
nudge_html_element       = "a"
nudge_location           = "dashboard"

nudges_to_render.each do |nudge|
  nudge_type = nudge.nudge_type
  nudge_id = nudge.nudge_id
  nudge_group = nudge.nudge_group
  destination_key = nudge.destination_key
  use_dismiss_and_redirect = false
%>
  <% case nudge_type %>
  <% when :cb %>
    <%
    nudge_category = "dfd_dashboard_enable_cb_nudge_1"

    title = "Copilot Business is available for #{business.safe_profile_name}"
    description = "Copilot Business is available to your enterprise free for 30 days. Activate AI-powered coding for your team by verifying your identity."
    icon_path = image_path("modules/dashboard/promos/general/copilot-menu-no-indicator-1746823169.svg")
    icon_alt = "Copilot logo"
    cta_title = "Enable Copilot Business"
    cta_action = "activate_copilot_business"
    %>
  <% when :org %>
    <%
    nudge_category = "dfd_dashboard_create_org_nudge_1"

    title = "Create the first organization in #{business.safe_profile_name}"
    description = "The first step to seeing the benefits of GitHub Enterprise is to add its first organization, which will provide a home for your developers, code, and workflows."
    icon_path = image_path("modules/dashboard/promos/general/org-menu-no-indicator-1749137782.svg")
    icon_alt = "Organization logo"
    cta_title = "Create organization"
    cta_action = "create_org"
    %>
  <% when :repo %>
    <%
    nudge_category = "dfd_dashboard_create_repo_nudge_1"

    title = "Create the first repository in #{business.safe_profile_name}"
    description = "Repositories are where you add code, collaborate, and utilize premium features, like GitHub Actions and Advanced Security."
    icon_path = image_path("modules/dashboard/promos/general/repo-menu-no-indicator-1749494944.svg")
    icon_alt = "Repository logo"
    cta_title = "Create repository"
    cta_action = "create_repo"
    %>
  <% when :code %>
    <%
    nudge_category = "dfd_dashboard_add_code_nudge_1"

    title = "Add code to #{oldest_repo.name}"
    description = "Put GitHub Secret scanning, Code scanning, and Actions to work in your enterprise for the first time by adding code to your repo."
    icon_path = image_path("modules/dashboard/promos/general/code-menu-no-indicator-1752091508.svg")
    icon_alt = "Code logo"
    cta_title = "Add code"
    cta_action = "add_code"
    %>
  <% when :ghas %>
    <%
    nudge_category = "dfd_dashboard_enable_ghas_nudge_1"

    title = "Enable Advanced Security for #{oldest_repo.name}"
    description = "Protect your repository's code by enabling GitHub to scan for secrets and security issues."
    icon_path = image_path("modules/dashboard/promos/general/ghas-menu-no-indicator-1758667123.svg")
    icon_alt = "Advanced Security logo"
    cta_title = "Enable Advanced Security"
    cta_action = "enable_ghas"
  when :ipm_accelerate_dashboard_business_copilot_cli_enabled
    nudge_category = "ipm_accelerate_dashboard_business_copilot_cli_enabled_nudge_1"

    title = "#{business.safe_profile_name} has enabled Copilot CLI for you"
    description = "Plan with Shift+Tab, switch your /model, /delegate work, or run /fleet in parallel."
    icon_path = image_path("modules/dashboard/promos/general/copilot-menu-no-indicator-1746823169.svg")
    icon_alt = "Copilot logo"
    cta_title = "Get started with Copilot CLI"
    cta_action = "get_started_with_copilot_cli"
    use_dismiss_and_redirect = true
    %>
  <% end %>

  <% current_user.track_nudge_impression(id: nudge_id, group: nudge_group, enterprise_id: business.id) %>
  <span <%= test_selector(nudge_category) %>></span>

  <div class="ipm-nudge-box dashboard">
    <div class="ipm-nudge-icon-wrapper" aria-hidden="true">
      <img class="ipm-nudge-icon" src="<%= icon_path %>" alt="<%= icon_alt %>" width="32" height="32">
    </div>

    <div class="ipm-nudge-content">
      <h3><%= title %></h3>
      <p><%= description %></p>

      <% endpoint = use_dismiss_and_redirect ? "dismiss-and-redirect" : "click-and-redirect" %>
      <%= link_to(cta_title, "/in-product-messaging/#{endpoint}?destination_key=#{destination_key}&business_id=#{business.id}&notice=#{nudge_id}&group=#{nudge_group}",
        data: {
          "test-selector": "enterprise-dashboard-#{business.id}-dfd-#{nudge.nudge_type}-nudge",
          **analytics_click_attributes(
            category: nudge_category,
            tag: nudge_html_element,
            enterprise: business.id,
            action: cta_action,
            location: nudge_location,
            group: nudge_group,
          ),
        },
        class: "ipm-nudge-cta btn btn-sm"
      ) %>
    </div>

    <%= form_tag(
      enterprise_dismiss_notice_path(
        notice: nudge_id,
        business_id: business.id,
        group: nudge_group
      ),
      data: analytics_visible_attributes(category: nudge_category, enterprise: business.id, group: nudge_group)
    ) do %>

      <div class="ipm-nudge-dismiss">
        <%= render(Primer::Beta::IconButton.new(
          type: :submit,
          icon: :x,
          scheme: :invisible,
          aria: { label: "Dismiss" },
          color: :on_emphasis,
          data: analytics_click_attributes(
            category: nudge_category,
            tag: nudge_html_element,
            action: "dismiss",
            location: nudge_location,
            group: nudge_group,
            enterprise: business.id,
          ))) %>
      </div>
    <% end %>
  </div>
<% end %>
