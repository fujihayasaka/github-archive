<%
nudge_html_element = "a"
nudge_location = "enterprise_organizations"

nudges_to_render.each do |nudge|
  nudge_type = nudge.nudge_type
  nudge_id = nudge.nudge_id
  nudge_group = nudge.nudge_group
  destination_key = nudge.destination_key
%>
  <% case nudge_type %>
  <% when :copilot_coding_agent_enablement %>
    <%
    nudge_category = "accelerate_ipm_enterprise_organizations_copilot_coding_agent_nudge_1"

    title = "Enable Copilot cloud agent for your organizations"
    description = "Copilot cloud agent is available to your enterprise. If enabled, users assigned a Copilot license from this enterprise will have access to it in repositories where it is enabled."
    icon_path = image_path("modules/dashboard/promos/general/copilot-menu-no-indicator-1746823169.svg")
    icon_alt = "Copilot logo"
    cta_title = "Configure cloud agent"
    cta_action = "enable_copilot_coding_agent"
    %>
  <% else %>
    <% next %>
  <% end %>

  <% InProductTargeting::NudgeMemory.new(user).save_a_copy_of_impression_analytics_to_dotcom(id: nudge_id, group: nudge_group, enterprise_id: business.id) if user %>
  <span <%= test_selector(nudge_category) %>></span>

  <div class="Box border rounded-2 color-border-default color-shadow-small tmp-mt-3 tmp-mb-4 overflow-hidden">
    <div class="ipm-nudge-box settings Box-header">
      <div class="ipm-nudge-icon-wrapper" aria-hidden="true">
        <img class="ipm-nudge-icon" src="<%= icon_path %>" alt="<%= icon_alt %>" width="32" height="32">
      </div>

      <div class="ipm-nudge-content">
        <h2 class="f4 text-bold mb-1"><%= title %></h2>
        <p class="mb-0 color-fg-muted"><%= description %></p>
      </div>

      <%= link_to(cta_title, "/in-product-messaging/click-and-redirect?destination_key=#{destination_key}&business_id=#{business.id}&notice=#{nudge_id}&group=#{nudge_group}&business_slug=#{business.slug}",
        data: {
          "test-selector": "enterprise-organizations-#{business.id}-#{nudge_type}-nudge",
          **analytics_click_attributes(
            category: nudge_category,
            tag: nudge_html_element,
            action: cta_action,
            enterprise: business.id,
            location: nudge_location,
            group: nudge_group,
          ),
        },
        class: "ipm-nudge-cta btn btn-sm btn-primary"
      ) %>

      <%= form_tag(
        enterprise_dismiss_notice_path(
          notice: nudge_id,
          business_id: business.id,
          group: nudge_group
        ),
        data: analytics_visible_attributes(category: nudge_category, enterprise: business.id, group: nudge_group)
      ) do %>

        <div class="ipm-nudge-dismiss">
          <%= render(Primer::Beta::IconButton.new(
            type: :submit,
            icon: :x,
            scheme: :invisible,
            aria: { label: "Dismiss" },
            color: :on_emphasis,
            data: analytics_click_attributes(
              category: nudge_category,
              tag: nudge_html_element,
              action: "dismiss",
              enterprise: business.id,
              location: nudge_location,
              group: nudge_group,
            ))) %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
