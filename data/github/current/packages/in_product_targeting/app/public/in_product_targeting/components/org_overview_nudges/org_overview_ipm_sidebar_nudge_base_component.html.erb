<%
html_element = "a"
location = "org_overview_right_sidebar"

%>
<%= content_tag(
  :span,
  nil,
  data: {
    **analytics_visible_attributes(
      category: nudge_category,
      organization: organization.id,
      plan: organization.plan.name,
      group: NUDGE_GROUP,
    ),
  },
  **test_selector_data_hash(nudge_category)
) %>

<div class="js-notice">
  <%= form_tag(
    organization_dismiss_notice_path(
      notice: nudge_id,
      organization_id: organization.id,
      group: NUDGE_GROUP
    ),
    class: "org-overview-ipm-sidebar-nudge-container js-notice-dismiss Box color-bg-subtle",
  ) do %>
    <div >
      <%= render(Primer::Beta::CloseButton.new(
        type: :submit,
        aria: { label: "Dismiss" },
        color: :default,
        classes: "org-overview-ipm-sidebar-nudge-dismiss",
        data: analytics_click_attributes(
          action: "dismiss",
          category: nudge_category,
          tag: html_element,
          organization: organization.id,
          plan: organization.plan.name,
          location: location,
        ))) %>
    </div>

  <img
    src="<%= image_path(nudge_image_path_dark) %>"
    alt="<%= nudge_image_alt_dark %>"
    class="org-overview-ipm-sidebar-nudge-image dark"
  >
  <img
    src="<%= image_path(nudge_image_path_light) %>"
    alt="<%= nudge_image_alt_light %>"
    class="org-overview-ipm-sidebar-nudge-image light"
  >

  <div class="org-overview-ipm-sidebar-nudge-date">
    <%= nudge_date %>
  </div>

  <div class="org-overview-ipm-sidebar-nudge-main"> 
    <h3 class="org-overview-ipm-sidebar-nudge-title" <%= test_selector("nudge-title") %>>
      <%= nudge_title %>
    </h3>

    <ul class="org-overview-ipm-sidebar-nudge-topics">
      <% nudge_topics.each do |topic| %>
        <li class="org-overview-ipm-sidebar-nudge-topic" <%= test_selector("nudge-topic-#{topic}") %>>
          <%= topic %>
        </li>
      <% end %>
    </ul>
    

    <%= render Primer::Beta::Button.new(
      size: :medium,
      tag: :a,
      scheme: :primary,
      href: nudge_cta_href,
      classes: "org-overview-ipm-sidebar-nudge-cta text-small px-2",
      data: analytics_click_attributes(
        category: nudge_category,
        action: nudge_cta_action,
        tag: html_element,
        location: NUDGE_LOCATION,
        organization: organization.id,
        plan: organization.plan.name,
      )
    ) do %>
      <%= nudge_cta %>
    <% end %>
  </div>
  <% end %>
</div>
