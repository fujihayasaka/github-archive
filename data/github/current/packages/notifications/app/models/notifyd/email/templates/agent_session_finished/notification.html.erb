<%# Primer-style email layout matching Mail::BorderedRowComponent / Mail::ButtonComponent / Mail::SpacerComponent %>
<table role="presentation" align="center" style="width: 100%; text-align: center;">
  <tr>
    <td style="display: block; padding: 16px;">
      <table role="presentation" border="0" cellspacing="0" cellpadding="0" align="center" style="width: 100%;">
        <tr>
          <td align="center">
            <%# Avatar %>
            <table role="presentation" border="0" cellspacing="0" cellpadding="0" align="center" width="100%">
              <tr>
                <td style="text-align: center;">
                  <% if @notification.agent_avatar_url.present? %>
                    <img src="<%= @notification.agent_avatar_url %>" width="64" height="64" alt="<%= @notification.agent_display_name %>" style="border-radius: 50%;">
                  <% end %>
                </td>
              </tr>
            </table>

            <%# Spacer 12px %>
            <table role="presentation"><tbody><tr><td height="12" style="font-size:12px;line-height:12px;">&#xA0;</td></tr></tbody></table>

            <%# Title (session name) %>
            <table role="presentation" border="0" cellspacing="0" cellpadding="0" align="center" width="100%">
              <tr>
                <td style="text-align: center;">
                  <h3 style="line-height: 1.25; margin: 0;"><%= @notification.title %></h3>
                </td>
              </tr>
            </table>

            <%# Spacer 12px %>
            <table role="presentation"><tbody><tr><td height="12" style="font-size:12px;line-height:12px;">&#xA0;</td></tr></tbody></table>

            <%# Session state + repository %>
            <table role="presentation" border="0" cellspacing="0" cellpadding="0" align="center" width="100%">
              <tr>
                <td style="text-align: center;">
                  <p style="margin: 0 0 4px 0; font-size: 14px; color: #24292e;">Session <%= @notification.session_state %></p>
                  <p style="margin: 0; font-size: 13px; color: #6a737d;"><%= repo_name %></p>
                </td>
              </tr>
            </table>

            <%# Spacer 16px %>
            <table role="presentation"><tbody><tr><td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td></tr></tbody></table>

            <%# Button %>
            <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
              <tr>
                <td>
                  <table role="presentation" border="0" cellspacing="0" cellpadding="0" width="100%">
                    <tr>
                      <td align="center">
                          <a href="<%= @notification.permalink %>" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 10px 20px; font-size: 14px; font-weight: 500; line-height: 20px; color: #fff; background-color: #2ea44f; border-radius: 6px; text-decoration: none;">View session</a>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <%# Spacer 16px %>
            <table role="presentation"><tbody><tr><td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td></tr></tbody></table>

            <%# Survey link %>
            <table role="presentation" border="0" cellspacing="0" cellpadding="0" align="center" style="width: 100%;">
              <tr>
                <td align="center" style="font-size: 12px; color: #6a737d;">
                  <a href="<%= survey_url %>" style="color: #0969da; text-decoration: none;">Share feedback on Copilot cloud agent</a>
                </td>
              </tr>
            </table>

            <%# Spacer 8px %>
            <table role="presentation"><tbody><tr><td height="8" style="font-size:8px;line-height:8px;">&#xA0;</td></tr></tbody></table>

            <%# Manage settings link %>
            <table role="presentation" border="0" cellspacing="0" cellpadding="0" align="center" style="width: 100%;">
              <tr>
                <td align="center" style="font-size: 12px;">
                  <a href="<%= notification_settings_url %>" style="color: #0969da; text-decoration: none;">Manage notification settings</a>
                </td>
              </tr>
            </table>

            <%# Spacer 16px %>
            <table role="presentation"><tbody><tr><td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td></tr></tbody></table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
