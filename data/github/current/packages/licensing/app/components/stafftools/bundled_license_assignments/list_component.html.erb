<% if @search_form_path.present? %>
  <%= render Stafftools::SimpleSearchFormComponent.new(
    query_label: "Search assignments",
    form_url: @search_form_path,
    form_group_test_selector: "bundled-license-assignment-search",
    query_placeholder: "Search by email address"
  ) %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(classes: "tmp-mt-3")) do |box| %>
  <% box.with_header(test_selector: "bundled-license-assignment-header") do %>
    <div class="d-flex flex-row width-full">
      <div class="col-5 text-bold color-fg-muted">Assignment</div>
      <div class="col-2 text-bold color-fg-muted">Status</div>
      <div class="col-2 text-bold color-fg-muted"></div>
      <div class="col-3 text-bold color-fg-muted text-right">Actions</div>
    </div>
  <% end %>
  <% if @assignments.empty? %>
    <% box.with_row do %>
      <%= render(Primer::Beta::Text.new(color: :muted)) { "No assignments found." } %>
    <% end %>
  <% else %>
    <% @assignments.each do |assignment| %>
      <% box.with_row(test_selector: "bundled-license-assignment-item") do %>
        <%= render Stafftools::BundledLicenseAssignments::ListItemComponent.new(assignment: assignment) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if pagination? %>
  <div class="paginate-container" <%= test_selector("bundled-license-assignment-pagination") %>>
    <div class="pagination">
      <%= helpers.will_paginate @assignments, params: {
        controller: PAGINATION_CONTROLLER,
        action: @action
      } %>
    </div>
  </div>
<% end %>
