<tr <%= test_selector "enterprise-agreement-row" %>>
  <td class="pt-3 pb-3">
    <%= render(Primer::Beta::Text.new(tag: :div, color: :muted, font_weight: :bold)) { @enterprise_agreement.agreement_id } %>
    <%= render(Primer::Beta::Text.new(tag: :div, color: :muted, font_size: :small, mt: 2)) { "Created #{@enterprise_agreement.created_at}" } %>
  </td>
  <td class="pt-3 pb-3"><%= render(Primer::Beta::Label.new) { @enterprise_agreement.category } %></td>
  <td class="pt-2 pb-2">
    <%= render(Primer::Box.new(bg: :subtle, p: 2, border_radius: 2)) do %>
      <%= render(Primer::Beta::Text.new(tag: :div, color: :muted, test_selector: "enterprise-agreement-seats")) { "#{@enterprise_agreement.seats} purchased" } %>
      <% if @enterprise_agreement.visual_studio_bundle? %>
        <%= render(Primer::Beta::Text.new(tag: :div, color: :muted, font_size: :small, mt: 2)) { "#{@billable_licenses} billable" } %>
        <%= render(Primer::Beta::Text.new(tag: :div, color: :muted, font_size: :small, mt: 2)) { "#{@non_linked_licenses} non-linked" } %>
      <% end %>
    <% end %>
  </td>
  <td class="pt-3 pb-3">
    <%= render(Primer::Beta::Label.new(scheme: (@enterprise_agreement.active? ? :success : :secondary))) do %>
      <%= @enterprise_agreement.status %>
    <% end %>
  </td>
  <td class="pt-3 pb-3">
    <div class="d-flex flex-column gap-1">
      <%= link_to "Edit", edit_stafftools_enterprise_agreement_path(@business, @enterprise_agreement), "data-test-selector": "edit-assignment-link" %>
      <% if @enterprise_agreement.visual_studio_bundle? && FeatureFlag.vexi.enabled?(:licensing_vss_agreement_backfill, @business, default: false) %>
        <%= render Primer::Alpha::Dialog.new(id: "backfill-enterprise-agreement-#{@enterprise_agreement.id}", title: "Backfill Enterprise Agreement") do |dialog| %>
        <% dialog.with_show_button(scheme: :link, align_content: :start, font_weight: :normal) do %>Backfill<% end %>
          <% dialog.with_body do %>
            Are you sure you want to backfill this enterprise agreement?
          <% end %>
          <% dialog.with_footer do %>
            <%= form_tag backfill_stafftools_enterprise_agreements_path(@business, id: @enterprise_agreement), method: "put" do %>
              <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary) do %>Backfill agreement<% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
