<div class="d-flex flex-row width-full flex-items-center">
  <div class="col-5 d-flex flex-items-center">
    <span class="mr-2">
      <%= icon %>
    </span>
    <span <%= test_selector("bundled-license-assignment-#{@assignment.id}-label") %>><%= label %></span>
  </div>

  <div class="col-2">
    <%= render(Primer::Beta::Label.new(scheme: linked_status_scheme)) do %>
      <%= linked_status %>
    <% end %>
  </div>

  <div class="col-2">
    <% if @assignment.revoked? %>
      <%= render(Primer::Beta::Label.new(scheme: :danger)) { "Revoked" } %>
    <% end %>
  </div>

  <div class="col-3 d-flex flex-justify-end">
    <% if show_perform_link_button %>
      <%= form_tag perform_user_link_job_stafftools_enterprise_bundled_license_assignment_path(@assignment.business, @assignment), method: :post do %>
        <%= render Primer::Beta::Button.new(
          type: :submit,
          size: :small,
          test_selector: "perform-user-link-button",
        ) do %>
          Match to user
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
