<%= render(Primer::Beta::BorderBox.new(test_selector: "enterprise-agreement-list", classes: "tmp-mb-3")) do |box| %>
  <% box.with_header do %>
    <div class="d-flex flex-row width-full">
      <div class="col-3 text-bold color-fg-muted">Agreement</div>
      <div class="col-3 text-bold color-fg-muted">Category</div>
      <div class="col-3 text-bold color-fg-muted">Purchased</div>
      <div class="col-1 text-bold color-fg-muted">Status</div>
      <div class="col-2 text-bold color-fg-muted text-right">Actions</div>
    </div>
  <% end %>
  <% if enterprise_agreements.empty? %>
    <% box.with_row do %>
      <%= render(Primer::Beta::Text.new(color: :muted)) { "There are no enterprise agreements on this account." } %>
    <% end %>
  <% else %>
    <% enterprise_agreements.each do |ea| %>
      <% box.with_row(test_selector: "enterprise-agreement-row") do %>
        <%= render Stafftools::EnterpriseAgreements::ListItemComponent.new(
          business: @business,
          enterprise_agreement: ea,
          billable_licenses: billable_seats_per_agreement[ea.agreement_id],
          non_linked_licenses: non_linked_seats_per_agreement[ea.agreement_id],
          vss_subscription_events: vss_events_per_agreement[ea.agreement_id]
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if !enterprise_agreements.empty? %>
  <%= render(Primer::Beta::Link.new(href: helpers.stafftools_enterprise_agreements_audit_log_path(@business, current_user), classes: "tmp-mb-6")) do %>
    View audit log events
  <% end %>
<% end %>
