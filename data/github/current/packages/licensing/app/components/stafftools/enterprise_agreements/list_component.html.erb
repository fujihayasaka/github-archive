<%= render Primer::Beta::Subhead.new do |component| %>
  <% component.with_heading(tag: :h2) do %>Enterprise agreement details<% end %>
  <% component.with_actions do %>
    <%= link_to "New Agreement", new_stafftools_enterprise_agreement_path(@business), class: "btn", "data-test-selector": "new-agreement-link" %>
  <% end %>
<% end %>

<table class="stafftools-table mb-1">
  <tr>
    <th>Agreement</th>
    <th>Category</th>
    <th class="nowrap">Volume Seats</th>
    <th>Status</th>
    <th>Actions</th>
  </tr>
  <% enterprise_agreements.each do |ea| %>
    <%= render Stafftools::EnterpriseAgreements::ListItemComponent.new(
      business: @business,
      enterprise_agreement: ea,
      billable_licenses: billable_seats_per_agreement[ea.agreement_id],
      non_linked_licenses: non_linked_seats_per_agreement[ea.agreement_id]
    ) %>
  <% end %>
  <% if enterprise_agreements.empty? %>
    <tr>
      <td colspan="5">There are no enterprise agreements on this account.</td>
    </tr>
  <% end %>
</table>

<% if !enterprise_agreements.empty? %>
  <a href="<%= helpers.stafftools_enterprise_agreements_audit_log_path(@business, current_user) %>" class="d-block mb-6">View audit log events</a>
<% end %>
