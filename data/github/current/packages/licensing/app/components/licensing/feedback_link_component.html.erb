<%= render(Primer::Alpha::Banner.new(full: true, test_selector: survey_id, **system_arguments)) do |component| %>
  <%= render(Primer::Box.new(flex: 1, display: :flex, direction: :column)) do %>
    <%= heading %>
    <%= description %>
  <% end %>
  <% component.with_action_content do %>
    <%= form_tag(dismiss_enterprise_licensing_survey_enterprise_licensing_path(slug: business_slug, id: survey_id), method: :delete) do %>
      <%= render(Primer::Beta::CloseButton.new(type: :submit,  aria: { label: "Dismiss feedback banner" })) %>
    <% end %>
  <% end %>
<% end %>
