{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Conditions for user roles",
  "definitions": {
    "target": {
      "description": "The selection of access to the child resources.",
      "enum": [
        "all_orgs",
        "some_orgs"
      ]
    },
    "targetIds": {
      "description": "The target ids that have been granted access on.",
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "type": "object",
  "properties": {
    "target": { "$ref": "#/definitions/target" },
    "target_ids": { "$ref": "#/definitions/targetIds" },
    "version": { "const": 1 }
  },
  "required": ["version", "target"],
  "anyOf": [
    {
      "properties": {
        "target": { "const": "all_orgs" }
      },
      "required": ["target", "version"],
      "not": { "required": ["target_ids"] }
    },
    {
      "properties": {
        "target": { "const": "some_orgs" }
      },
      "required": ["target", "target_ids", "version"]
    }
  ],
  "additionalProperties": false
}
