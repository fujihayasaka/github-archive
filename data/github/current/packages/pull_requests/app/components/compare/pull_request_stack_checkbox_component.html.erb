<div class="mx-2">
  <label>
    <input type="checkbox" name="create_stack">
    <% if previous_pull_request.stacked? %>
      Add to existing stack with <%= previous_pull_request_link %>
        and <%= pluralize(previous_pull_request.stack.entry_count - 1, "other pull request") %>
    <% else %>
      Create stack with <%= previous_pull_request_link %>
    <% end %>
  </label>
</div>
