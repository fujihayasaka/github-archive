<div class="d-flex flex-items-start gap-2 tmp-mt-3 tmp-mb-2 tmp-p-3 border rounded-2" style="padding-top: 14px !important;">
  <input type="checkbox" id="create-stack" name="create_stack" value="1" class="flex-shrink-0 mt-1" aria-describedby="create-stack-caption" <%= "checked" if stacked_by_default? %>>
  <div class="fgColor-muted"><%= primer_octicon("stack", size: :small) %></div>
  <div class="d-flex flex-column gap-1">
    <label for="create-stack" class="h5 cursor-pointer"><%= checkbox_label %></label>
    <span id="create-stack-caption" class="f6 fgColor-muted"><%= checkbox_caption %></span>
  </div>
</div>
