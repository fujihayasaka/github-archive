
<% if data.secret_scanning_partner_metadata_visible %>
  <div class="d-flex flex-md-row flex-column flex-md-items-center"
    <%= test_selector("secret-scanning-partner-metadata-settings") %>
  >
    <div class="mb-md-0 mb-2 mr-2 flex-auto col-md-10">
      <div class="d-flex">
        <h4>Extended metadata</h4>
        <div class="ml-2">
          <%= render(Primer::Beta::Label.new(scheme: :success)) { "Preview" } %>
        </div>
      </div>
      Automatically check for
      <%= render(Primer::Beta::Link.new(href: helpers.docs_url("code-security/enabling-extended-metadata-checks-for-your-repository", ghec: true), classes: "Link--inTextBlock")) { "extended metadata about a secret" } %>
      by sending it to the relevant partner.
    </div>
    <div>
      <div class="BtnGroup flex-auto">
        <% if restricted? %>
          <div <%= test_selector("secret-scanning-partner-metadata-restricted-status") %>>
            <%= render Primer::Beta::Octicon.new(:"shield-lock", color: :muted) if display_shield_icon? %>
            <% if is_currently_enabled? %>
              Enabled
            <% else %>
              Disabled
            <% end %>
          </div>
        <% elsif blocked_by_in_progress_setting? %>
          <% partner_metadata_enablement_action = is_currently_enabled? ? "Disable" : "Enable" %>
          <%= render Primer::Beta::Button.new(
            aria: { disabled: true, label: "#{partner_metadata_enablement_action} partner metadata" },
            scheme: is_currently_enabled? ? :default : :danger,
            test_selector: "partner-metadata-button-disabled-by-security-product-toggling-in-progress",
            title: "Org-level toggling in progress",
            classes: "tmp-px-3",
          ).with_content(partner_metadata_enablement_action) %>
        <% else %>
          <%= form_tag data.update_security_products_settings_path, method: :put do %>
            <% if is_currently_enabled? %>
              <input type="hidden" name="token_scanning_partner_metadata_enabled" value="0">
              <%= render Primer::Beta::Button.new(
                type: :submit,
                scheme: :danger,
                "aria-label": "Disable partner metadata",
                data: {
                  **analytics_click_attributes(
                    category: "repository_settings",
                    action: "token_scanning_partner_metadata.disable"
                  )},
                  classes: "tmp-px-3",
                ) do %>
                Disable
              <% end %>
            <% else %>
              <input type="hidden" name="token_scanning_partner_metadata_enabled" value="1">
              <%= render Primer::Beta::Button.new(
                type: :submit,
                "aria-label": "Enable partner metadata",
                data: {
                  **analytics_click_attributes(
                    category: "repository_settings",
                    action: "token_scanning_partner_metadata.enable"
                  )},
                classes: "tmp-px-3",
                ) do %>
                Enable
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <% if has_mixed_restrictions? %>
    <% if restricted_by_enterprise_policy? %>
      <%= render(SecurityProductsEnablement::RepositoryCodeSecurityPolicyNotificationComponent.new(business, mt: 1, mb: 2)) %>
    <% elsif restricted_by_security_configuration? %>
      <%= render(SecurityProductsEnablement::RepositoryCodeSecurityPolicyNotificationComponent.new(helpers.owner, mt: 1, mb: 2)) %>
    <% end %>
  <% end %>
<% end %>
