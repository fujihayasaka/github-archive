  <% if data.secret_scanning_delegated_closures_visible %>
    <div class="d-flex flex-md-row flex-column flex-md-items-center"
      <%= test_selector("secret-scanning-delegated-closures-settings") %>
    >
      <div class="mb-md-0 mb-2 flex-auto col-md-10">
        <h4>Prevent direct alert dismissals</h4>
        Actors must submit requests to dismiss an alert.
      </div>
      <div>
        <div class="BtnGroup flex-auto">
          <% if restricted? %>
            <div <%= test_selector("secret-scanning-delegated-closures-restricted-status") %>>
              <%= render Primer::Beta::Octicon.new(:"shield-lock", color: :muted) if display_shield_icon? %>
              <% if is_currently_enabled? %>
                Enabled
              <% else %>
                Disabled
              <% end %>
            </div>
          <% elsif data.secret_scanning_delegated_closures_blocked_by_in_progress_setting %>
            <% delegated_closures_enablement_action = is_currently_enabled? ? "Disable" : "Enable" %>
            <%= render Primer::Beta::Button.new(
              aria: { disabled: true, label: "#{delegated_closures_enablement_action} delegated alert dismissal" },
              scheme: is_currently_enabled? ? :default : :danger,
              test_selector: "delegated-closure-button-disabled-by-security-product-toggling-in-progress",
              title: "Org-level toggling in progress",
              px: 3,
            ).with_content(delegated_closures_enablement_action) %>
          <% else %>
            <%= form_tag data.update_security_products_settings_path, method: :put do %>
              <% if is_currently_enabled? %>
                <input type="hidden" name="token_scanning_delegated_closures_enabled" value="0">
                <%= render Primer::Beta::Button.new(
                  type: :submit,
                  scheme: :danger,
                  "aria-label": "Disable delegated closures",
                  data: {
                    **analytics_click_attributes(
                      category: "repository_settings",
                      action: "token_scanning_delegated_closures.disable"
                    )},
                    px: 3,
                  ) do %>
                  Disable
                <% end %>
              <% else %>
                <input type="hidden" name="token_scanning_delegated_closures_enabled" value="1">
                <%= render Primer::Beta::Button.new(
                  type: :submit,
                  "aria-label": "Enable delegated closures",
                  data: {
                    **analytics_click_attributes(
                      category: "repository_settings",
                      action: "token_scanning_delegated_closures.enable"
                    )},
                  px: 3,
                  ) do %>
                  Enable
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <% if has_mixed_restrictions? %>
      <% if restricted_by_enterprise_policy? %>
        <%= render(SecurityProductsEnablement::RepositoryCodeSecurityPolicyNotificationComponent.new(business, mt: 1, mb: 2)) %>
      <% elsif restricted_by_security_configuration? %>
        <%= render(SecurityProductsEnablement::RepositoryCodeSecurityPolicyNotificationComponent.new(helpers.owner, mt: 1, mb: 2)) %>
      <% end %>
    <% end %>
  <% end # end delegated closures %>
