      <div class="d-flex flex-md-row flex-column flex-md-items-center"
      <%= test_selector("secret-scanning-delegated-closures-settings") %>
    >
      <div class="mb-md-0 mb-2 flex-auto col-md-10">
        <h4>Delegated alert closures</h4>
        Require admin approval in order to close alerts.
         <% if data.secret_scanning_delegated_closures_enabled_by_organization %>
      <div <%= test_selector("secret-scanning-delegated-closures-org-enabled-warning")%>>
        <br>
        <%= render(Primer::Beta::Octicon.new(icon: :alert, color: :muted)) %>
        <%= render(Primer::Beta::Text.new(color: :muted)) { "This setting has been set by organization administrators." } %>
      </div>
    <% end %>
      </div>
      <div>
        <div class="BtnGroup flex-auto">
            <%= form_tag data.update_security_products_settings_path, method: :put do %>
              <% if is_currently_enabled? %>
                <input type="hidden" name="token_scanning_delegated_closures_enabled" value="0">
                <%= render Primer::Beta::Button.new(
                  type: :submit,
                  scheme: :danger,
                  test_selector: "delegated-closures-disable-button",
                  "aria-label": "Disable delegated alert closures",
                  px: 3,
                  disabled: data.secret_scanning_delegated_closures_enabled_by_organization
                  ) do %>
                  Disable
                <% end %>
              <% else %>
                <input type="hidden" name="token_scanning_delegated_closures_enabled" value="1">
                <%= render Primer::Beta::Button.new(
                  type: :submit,
                  test_selector: "delegated-closures-enable-button",
                  "aria-label": "Enable delegated alert closures",
                  px: 3,
                  disabled: data.secret_scanning_delegated_closures_enabled_by_organization
                  ) do %>
                  Enable
                <% end %>
              <% end %>
            <% end %>
        </div>
      </div>
    </div>
