<%= form_tag github_ui_preview_path, method: :post, class: "d-inline-block" do %>
  <%= render(Primer::Alpha::Dialog.new(
    title: "UI Previews",
    id: "ui-sha-preview-dialog",
    size: :large,
  )) do |d| %>
    <% d.with_header do %>
      <div class="h3 text-semibold">
        UI Previews
      </div>
    <% end %>

    <% d.with_show_button(
      scheme: :invisible,
      p: 0,
    ) do %>
      <%= render Primer::Beta::Truncate.new(
        classes: "current-branch",
        id: "show-ui-preview-dialog",
        "data-show-dialog-id": "ui-preview-dialog",
        m: 0,
      ) do |c| %>
        <% c.with_item(
          expandable: true,
          max_width: 100,
          display: :inline_block,
          vertical_align: :top,
          tag: hcs? ? :"staffbar-ui-version" : :span,
          test_selector: "current-ui-version",
        ) do %>
          <%= hcs? ? "" : "UI: #{GitHubUI::Version.current_ref}" %>
        <% end %>
      <% end %>
    <% end %>

    <% d.with_body do %>
      <p class="color-fg-muted lh-default">
        Current SHA: <code><%= GitHubUI::Version.current_ref %></code>
      </p>
      <p class="color-fg-muted lh-default">
        Copy current url <%= render(Primer::Beta::ClipboardCopy.new(value: current_url, "aria-label": "Copy current URL", classes: "btn-link", "data-copy-feedback": "Copied!", role: "button", ml: 2)) %>
      </p>
      <div>
        <div class="h4 text-semibold">
          Load a preview SHA
        </div>
        <p class="text-small text-normal color-fg-muted lh-default">
          Paste the SHA of the GitHub UI PR you want to preview. You must first deploy the PR using the <code>.deploy</code> chatop in #github-ui-ops.
        </p>
        <div class="form-group required m-0">
          <div class="form-group-header">
            <label for="_ui_sha" class="form-label">GitHub UI SHA:</label>
          </div>
          <div class="form-group-body">
            <input
              type="text"
              id="_ui_sha"
              name="_ui_sha"
              value="<%= params[:_ui_sha] %>"
              class="form-control"
              placeholder="Enter GitHub UI SHA"
              autocomplete="off"
            >
          </div>
        </div>
      </div>
    <% end %>

    <% d.with_footer do %>
      <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit)) { "Load" } %>
    <% end %>
  <% end %>
<% end %>
