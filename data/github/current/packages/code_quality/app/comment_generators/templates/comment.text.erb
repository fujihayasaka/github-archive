<%= CodeCoverage::CommentFinder::MARKER %>
### Code Coverage Overview

<% if languages.present? -%>
<b>Languages:</b> <%= languages.join(", ") %>
<% end -%>
<% categories.each do |category| -%>
  <%- head_coverage = category[:head_ref_coverage].to_i -%>
  <%- base_sha = category[:base_commit_sha].to_s -%>
  <%- cat_label = category[:label] -%>
  <%- cat_files = category[:sorted_files] -%>
  <%- has_base = base_data_available?(category) -%>
  <%- if category[:language_name].present? -%>
<%= category_heading(category) %>

  <%- end -%>
<% if has_base -%>
  <%- base_coverage = category[:base_ref_coverage].to_i -%>
<% if no_coverage_changes?(category) -%>
The overall coverage remains at <%= head_coverage %>%, unchanged from the <%= base_branch_link %> branch.
<% elsif coverage_unchanged?(category) -%>
The overall coverage in the <%= head_branch_link %> branch remains at <%= head_coverage %>%, unchanged from the <%= base_branch_link %> branch.
<% else -%>
The overall coverage in the <%= head_branch_link %> branch is <%= head_coverage %>%. The coverage in the <%= base_branch_link %> branch is <%= base_coverage %>%. 
<% end -%>
<% else -%>
The overall coverage in the <%= head_branch_link %> branch is <%= head_coverage %>%. Coverage data for the <%= base_branch_link %> branch is not yet available.
<% end -%>

<% if show_file_table?(category) -%>
  <details open>
  <summary>Show a code coverage summary of the most <% if has_base %>impacted<% else %>covered<% end %> files.</summary>

  <table>
  <tr>
  <td align="center"><b>File</b></td>
  <td align="center"><%= branch_link(base_ref) %><% if has_base %> <%= commit_sha_label(base_sha) %><% end %></td>
  <td align="center"><%= branch_link(head_ref) %> <%= commit_sha_label(head_sha) %></td>
  <td align="center"><b>+/-</b></td>
  </tr>
  <%   cat_files.each do |file| -%>
    <%- file_path = file[:path].to_s -%>
    <%- base = file[:base_file_coverage].to_i -%>
    <%- head = file[:head_file_coverage].to_i -%>
    <%- file_diff = head - base -%>
    <tr>
    <td width="<%= CodeCoverage::Comment::FILE_COLUMN_WIDTH_PX %>"><%= file_label(file_path) %></td>
    <td align="center"><%= format_coverage(file[:base_file_coverage], category) %></td>
    <td align="center"><%= head %>%</td>
    <td align="center"><%= format_diff(file_diff, category) %></td>
    </tr>
  <%   end -%>
  </table>

  </details>

<% end -%>
<% end -%>
---
<% if updated? -%>
<sub>Updated <relative-time datetime="<%= Time.now.utc.iso8601 %>"><%= Time.now.utc.to_fs(:long) %> UTC</relative-time><br><%= footer %></sub>
<% else -%>
<sub><%= footer %></sub>
<% end -%>

