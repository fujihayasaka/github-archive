{
  "name": "@github-ui/tests",
  "description": "Shared tools which enable testing UI code",
  "type": "module",
  "bin": {
    "ui-test": "ui-test"
  },
  "exports": {
    ".": "./tests.ts",
    "./browser": "./browser-tests.ts",
    "./eslint": "./eslint.ts",
    "./msw": "./msw.ts"
  },
  "scripts": {
    "lint": "eslint . --cache",
    "start": "node --experimental-strip-types --no-warnings tests.ts",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "ui-test",
    "tsc": "tsc"
  },
  "dependencies": {
    "@typescript-eslint/rule-tester": "*"
  },
  "devDependencies": {
    "@github-ui/analytics-test-utils": "*",
    "@github-ui/client-build-tools": "*",
    "@github-ui/client-env": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/find-codeowners": "*",
    "@github-ui/jest": "*",
    "@github-ui/mock-fetch": "*",
    "@github-ui/react-core": "*",
    "@github-ui/tests": "*",
    "@github-ui/vite": "*",
    "@open-wc/lit-helpers": "0.7.0",
    "@open-wc/testing": "4.0.0",
    "@testing-library/react": "*",
    "@vitest/browser": "3.1.1",
    "@vitest/ui": "3.1.1",
    "chai": "5.1.2",
    "chai-a11y-axe": "1.5.0",
    "chai-dom": "1.12.1",
    "globals": "16.0.0",
    "msw": "*",
    "vitest": "3.1.1",
    "vitest-fail-on-console": "0.7.1"
  },
  "dev": true,
  "private": true
}
