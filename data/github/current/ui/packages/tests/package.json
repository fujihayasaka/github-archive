{
  "name": "@github-ui/tests",
  "description": "Shared tools which enable testing UI code",
  "type": "module",
  "bin": {
    "ui-test": "ui-test"
  },
  "exports": {
    ".": "./tests.ts"
  },
  "scripts": {
    "lint": "eslint . --cache",
    "start": "node --experimental-strip-types --no-warnings tests.ts",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "ui-test",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@github-ui/browser-tests": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/vite": "*",
    "vitest": "3.0.5"
  },
  "dev": true,
  "private": true
}
