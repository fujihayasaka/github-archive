#!/bin/bash
set -e

# Determine the full config path relative to this file
# This file is symlinked so we need the original source dir
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CONFIG_PATH="$(cd "$DIR/../vite" && pwd)/vitest.config.js"

# Pass all args, except drop --runInBand, which is not supported by Vitest
args=("$@")
for i in "${!args[@]}"; do
  if [[ "${args[i]}" == "--runInBand" ]]; then
    unset 'args[i]'
  fi
done

# Run vitest, passing in the config, allowing empty suites to pass, and forwarding all args
vitest --config $CONFIG_PATH --passWithNoTests "${args[@]}"
