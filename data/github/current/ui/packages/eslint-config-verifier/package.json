{
  "name": "@github-ui/eslint-config-verifier",
  "description": "Verifies if the migration to flag config applies the same rules",
  "type": "module",
  "scripts": {
    "lint": "eslint . --cache",
    "start": "node --experimental-strip-types --no-warnings eslint-config-verifier.ts",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "jest",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@github-ui/client-build-tools": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/jest": "*",
    "@types/eslint": "*",
    "eslint": "*"
  },
  "dev": true,
  "private": true
}
