{
  "name": "@github-ui/alloy-smoke-test",
  "description": "Runs a pre-built alloy bundle in an Alloy-like environment as a smoke test before deploying",
  "type": "module",
  "scripts": {
    "lint": "eslint . --cache",
    "prestart": "npm run build -w @github-ui/ui-manifest",
    "start": "node --experimental-strip-types --no-warnings alloy-smoke-test.ts",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "jest",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@github-ui/client-build-tools": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/jest": "*"
  },
  "dev": true,
  "private": true
}
