// These commands are standardized on the web and shouldn't be changed or remapped. They can be used when it's more
// convenient to use ui-commands instead of keyboard event handlers.
{
  "serviceId": "github",
  "serviceName": "GitHub (site-wide)",
  "commands": {
    "submit-form": {
      "name": "Submit form",
      "description": "Submit the current form",
      "defaultBinding": "Mod+Enter"
    },
    "select": {
      "name": "Select item",
      "description": "Select the current item",
      // eslint-disable-next-line @github-ui/ui-commands/accessible-default-keybindings
      "defaultBinding": "Enter"
    },
    "select-multiple": {
      // Normally we don't use ui-commands to handle standard keyboard shortcuts like selection and multi-selection
      // (maybe we should?), however multi-selection conflicts with submit-form. This way we can use ScopedCommands to
      // intercept it and prevent accidental form submissions on multi-selection.
      "name": "Select multiple items",
      "description": "Add the current item to a multi-selection (or remove it if already added)",
      "defaultBinding": "Mod+Enter"
    },
    "cancel": {
      "name": "Cancel",
      "description": "Cancel the current operation",
      // eslint-disable-next-line @github-ui/ui-commands/accessible-default-keybindings
      "defaultBinding": "Escape"
    },
    "go-to-start": {
      "name": "Go to start",
      "description": "Go to the first item in a list",
      // eslint-disable-next-line @github-ui/ui-commands/accessible-default-keybindings
      "defaultBinding": "Home"
    },
    "go-to-end": {
      "name": "Go to end",
      "description": "Go to the last item in a list",
      // eslint-disable-next-line @github-ui/ui-commands/accessible-default-keybindings
      "defaultBinding": "End"
    },
    "up": {
      "name": "Up",
      "description": "Navigate up",
      // eslint-disable-next-line @github-ui/ui-commands/accessible-default-keybindings
      "defaultBinding": "ArrowUp"
    },
    "down": {
      "name": "Down",
      "description": "Navigate down",
      // eslint-disable-next-line @github-ui/ui-commands/accessible-default-keybindings
      "defaultBinding": "ArrowDown"
    },
    "focus-next": {
      "name": "Focus next item",
      "description": "Navigate to the next focusable item",
      // eslint-disable-next-line @github-ui/ui-commands/accessible-default-keybindings
      "defaultBinding": "Tab"
    }
  }
}
