{
  "name": "@github-ui/vite",
  "description": "Vite configuration and dependencies for building client-side code",
  "type": "module",
  "exports": {
    "./vite.config.ts": "./vite.config.ts"
  },
  "scripts": {
    "alloy": "node --experimental-strip-types --no-warnings --watch-path=./vite-alloy-server.ts --watch-path=./vite.config.ts --watch-path=./plugins vite-alloy-server.ts",
    "lint": "eslint . --cache",
    "start": "vite",
    "stats": "node --experimental-strip-types --no-warnings stats.ts",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "jest",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "0.25.0",
    "@github-ui/client-build-plugins": "*",
    "@github-ui/client-build-tools": "*",
    "@github-ui/error-serialization": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/jest": "*",
    "@github-ui/ssr-shims": "*",
    "@github-ui/swc": "*",
    "@vitejs/plugin-react-swc": "3.7.2",
    "esbuild": "0.25.0",
    "playwright": "1.35.0",
    "vite": "6.0.9",
    "vite-plugin-cjs-interop": "2.1.6",
    "vite-plugin-commonjs": "0.10.4",
    "vitest": "3.0.5"
  },
  "dev": true,
  "private": true
}
