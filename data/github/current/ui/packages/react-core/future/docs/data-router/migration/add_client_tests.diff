+/** @jest-environment node */
+import {serverRenderReact} from '@github-ui/ssr-test-utils/server-render'
+
+// Register with react-core before attempting to render
+import '../ssr-entry'
+import {getAdminMockPayload} from '../test-utils/mock-data'
+
+describe('Admin routes', () => {
+  it('renders admin page with SSR', async () => {
+    const payload = {admin: getAdminMockPayload()}
+
+    const view = await serverRenderReact({
+      name: 'example-app',
+      path: '/admin',
+      data: {payload},
+      data_router_enabled: true,
+    })
+
+    // Verify SSR was able to render key content from the payload
+    expect(view).toMatch('Admin Dashboard')
+    expect(view).toMatch('Users: 125')
+    expect(view).toMatch('Settings')
+  })
+})
+
