+import type {AdminPayload} from '../routes/AdminRoute'
+
+export function getAdminMockPayload(options = {}): AdminPayload {
+  const defaultOptions = {
+    showSettings: false,
+  }
+  
+  const mergedOptions = {...defaultOptions, ...options}
+  
+  return {
+    userCount: 125,
+    showSettingsPage: mergedOptions.showSettings
+  }
+}