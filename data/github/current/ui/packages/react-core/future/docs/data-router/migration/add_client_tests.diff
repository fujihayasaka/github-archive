+import {getAdminMockPayload} from '../test-utils/mock-data'
+import {render} from '@github-ui/react-core/future/test-utils/render'
+import {exampleApp} from '../example-app'
+import {screen} from '@testing-library/react'
+
+describe('Admin routes', () => {
+  it('renders admin page with CSR from embedded data', async () => {
+    const payload = {admin: getAdminMockPayload()}
+    render(exampleApp, '/admin', {
+      embeddedData: {
+        payload,
+        meta: {
+          title: 'Admin Dashboard',
+        },
+      },
+    })
+
+    expect(await screen.findByText('Admin Dashboard')).toBeInTheDocument()
+    expect(screen.getByText('Users: 125')).toBeInTheDocument()
+    expect(screen.getByText('Settings')).toBeInTheDocument()
+  })
+
+  it('renders admin settings page with CSR from embedded data', async () => {
+    const payload = {admin: getAdminMockPayload({showSettings: true})}
+    render(exampleApp, '/admin/settings', {
+      embeddedData: {
+        payload,
+        meta: {
+          title: 'Admin Settings',
+        },
+      },
+    })
+
+    expect(await screen.findByText('Admin Settings')).toBeInTheDocument()
+    expect(screen.getByLabelText('Enable feature flag')).toBeInTheDocument()
+  })
+})
+
