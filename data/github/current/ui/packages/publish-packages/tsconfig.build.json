{
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    "noEmit": false,
    "outDir": "${configDir}/dist"
  },
  "exclude": [
    "${configDir}/dist",
    "${configDir}/jest.config.js",
    "${configDir}/**/*.stories.tsx",
    "${configDir}/**/*.test.tsx",
    "${configDir}/__tests__/",
    "${configDir}/test-utils/",
    "${configDir}/eslint.config.mjs",
    "${configDir}/eslint.*",
    "${configDir}/tsconfig.*"
  ],
  "isolatedModules": true,
  "incremental": false
}
