#!/bin/bash

set -e

rm -rf dist/

PACKAGE_PATH=$PWD

# Bundle files and dependencies into JS and CSS
npm run build

# Create declaration files
npm run build:types

# Update package.json exports with dist/ and js
node ../publish-packages/scripts/pre-publish.mjs $PACKAGE_PATH

npm publish --dry-run

read -p "Continue with publishing? (y/n) " -n 1 -r -i n -e
echo

if [[ $REPLY =~ ^[Yy]$ ]]
then
  npm publish
else
  echo "Publish cancelled!"
fi

node ../publish-packages/scripts/post-publish.mjs $PACKAGE_PATH
