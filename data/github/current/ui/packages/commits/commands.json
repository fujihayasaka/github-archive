{
  "serviceId": "commit-diff-view",
  "serviceName": "Commits diff view",
  "commands": {
    "open-find": {
      "name": "Open up find and search on selection",
      "description": "Hotkey to open up the custom find and search on selection.",
      "defaultBinding": "Mod+e"
    },
    "create-permalink": {
      "name": "Create permalink",
      "description": "Hotkey to expand the current url to a full permalink.",
      "defaultBinding": "y"
    },
    "go-up-commit": {
      "name": "Go up commit",
      "description": "navigates up one commit",
      "defaultBinding": "k"
    },
    "go-up-commit-arrow": {
      "name": "Go up commit",
      "description": "navigates up one commit",
      // eslint-disable-next-line @github-ui/ui-commands/accessible-default-keybindings
      "defaultBinding": "ArrowUp"
    },
    "go-down-commit": {
      "name": "Go up commit",
      "description": "navigates up one commit",
      "defaultBinding": "j"
    },
    "go-down-commit-arrow": {
      "name": "Go up commit",
      "description": "navigates down one commit",
      // eslint-disable-next-line @github-ui/ui-commands/accessible-default-keybindings
      "defaultBinding": "ArrowDown"
    }
  }
}
