import {screen} from '@testing-library/react'
import {render} from '@github-ui/react-core/future/test-utils/render'
import {it, expect, describe, beforeEach, afterEach} from '@github-ui/tests'
import {msw} from '@github-ui/tests/msw'
import { {{~mockDataFn~}} } from './utils/mock-data'
import { {{~appNameVariable~}} } from '../{{packageName}}'
import {handlers} from './utils/handlers'

describe('{{packageName}}', () => {
  beforeEach(() => {
    msw.use(...handlers)
  })
  afterEach(() => {
    msw.resetHandlers()
  })
  it('Renders the {{routeComponent}} component', async () => {
    render({{appNameVariable}}, '{{routePath}}', {
      appPayload: {},
    })

    expect(await screen.findByText('{{routeComponent}} for {{packageName}}')).toBeInTheDocument()
  })

  it('Renders the {{routeComponent}} component with embedded data', async () => {
    const mainQuery = {{mockDataFn}}()

    render({{appNameVariable}}, '{{routePath}}', {
      embeddedData: {
        payload: {
          {{routeVariable}}: mainQuery,
        },
      },
    })

    expect(await screen.findByText('someValue')).toBeInTheDocument()
  })
})
