import {useRouteQuery} from '@github-ui/react-core/future/use-route-query'
import { {{~routeVariable~}} } from './{{routeFileName}}'

export function {{routeComponent}}() {
  const payload = useRouteQuery({{routeVariable}}, 'mainQuery')

  return (
    <>
      <h1 data-hpc>{{routeComponent}} for {{packageName}}</h1>
      <article>{payload.data.someField}</article>
    </>
  )
}
