{
  "name": "@github-ui/ui-packages-tooling",
  "description": "Build-time tooling for the ui packages directory",
  "private": true,
  "dev": true,
  "scripts": {
    "lint": "eslint . --cache",
    "scaffold-ui-package": "node --experimental-strip-types --no-warnings $(which plop) --plopfile=plopfile.ts",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "jest",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@github-ui/browser-tests": "*",
    "@github-ui/client-build-tools": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/jest": "*",
    "@github-ui/managed-dependencies": "*",
    "@github-ui/resolve-imports": "*",
    "@nx/nx-linux-x64-gnu": "20.4.4",
    "@types/inquirer-autocomplete-prompt": "3.0.0",
    "@vscode/ripgrep": "1.15.5",
    "change-case": "4.1.2",
    "glob": "7.1.4",
    "inquirer-autocomplete-prompt": "3.0.0",
    "node-plop": "0.31.0",
    "nx": "20.4.4",
    "plop": "3.1.1"
  }
}
