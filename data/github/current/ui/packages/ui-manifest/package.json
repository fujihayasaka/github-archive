{
  "name": "@github-ui/ui-manifest",
  "description": "Tools used to create and validate a manifest of ui assets",
  "type": "module",
  "exports": {
    "./types": "./manifest-types.ts"
  },
  "scripts": {
    "build": "node --experimental-strip-types --no-warnings ui-manifest.ts --build",
    "build-for-tests": "node --experimental-strip-types --no-warnings ui-manifest.ts --build-for-tests",
    "clean": "node --experimental-strip-types --no-warnings ui-manifest.ts --clean",
    "dev": "node --experimental-strip-types --no-warnings --watch ui-dev-server.ts",
    "lint": "eslint . --cache",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "ui-test",
    "tsc": "tsc",
    "validate": "node --experimental-strip-types --no-warnings ui-manifest.ts --validate"
  },
  "devDependencies": {
    "@github-ui/client-build-tools": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/feature-flags": "*",
    "@github-ui/tests": "*",
    "@vscode/ripgrep": "1.15.5"
  },
  "dev": true,
  "private": true,
  "dependencies": {
    "@github-ui/memex-feature-flags": "*"
  }
}
