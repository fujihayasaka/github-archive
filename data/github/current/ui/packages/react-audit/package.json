{
  "name": "@github-ui/react-audit",
  "description": "Tools for understanding React usage within this repo",
  "main": "react-audit.ts",
  "dev": true,
  "exports": {
    ".": "./react-audit.ts",
    "./utils": "./utils.ts"
  },
  "scripts": {
    "lint": "eslint . --cache",
    "react-audit": "node --experimental-strip-types --no-warnings react-audit.ts",
    "react-component-audit": "node --experimental-strip-types --no-warnings react-component-audit.ts",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "jest",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@github-ui/client-build-tools": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/jest": "*",
    "js-yaml": "3.13.1",
    "ts-morph": "18.0.0"
  },
  "nx": {
    "namedInputs": {
      "additionalInputs": [
        "{workspaceRoot}/ui/packages/**/*"
      ]
    }
  },
  "private": true
}
