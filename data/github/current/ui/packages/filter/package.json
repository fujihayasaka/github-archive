{
  "name": "@github-ui/filter",
  "version": "0.0.7",
  "description": "A resuable filter component that can provide suggestions and validation to users. It generates a consistant search string that can be used to query data.",
  "homepage": "https://ui.githubapp.com/storybook/?path=/docs/recipes-filter-overview--docs",
  "componentInfo": {
    "name": "Filter",
    "type": "Recipes",
    "status": "Ready",
    "links": {
      "tracking": "https://github.com/github/primer/issues/2665",
      "figma": ""
    }
  },
  "main": "Filter.tsx",
  "types": "./dist/Filter.d.ts",
  "exports": {
    ".": "./Filter.tsx",
    "./constants/*": "./constants/*.ts",
    "./parser": "./parser/index.ts",
    "./parser/string-breaker": "./parser/string-breaker.ts",
    "./providers": "./providers/index.ts",
    "./providers/type": "./providers/type.ts",
    "./test-utils": "./test-utils/index.ts",
    "./utils": "./utils/index.ts"
  },
  "scripts": {
    "build": "node ../publish-packages/scripts/build.js",
    "build:publish": "../publish-packages/scripts/publish",
    "build:types": "tsc --project ./tsconfig.build.json",
    "lint": "eslint . --cache",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "jest",
    "tsc": "tsc"
  },
  "dependencies": {
    "@github-ui/analytics-provider": "*",
    "@github-ui/aria-live": "*",
    "@github-ui/feature-flags": "*",
    "@github-ui/fuzzy-score": "*",
    "@github-ui/github-avatar": "*",
    "@github-ui/paths": "*",
    "@github-ui/react-core": "*",
    "@github-ui/safe-html": "*",
    "@github-ui/skeleton": "*",
    "@github-ui/test-id-props": "*",
    "@github-ui/use-analytics": "*",
    "@github-ui/use-layout-effect": "*",
    "@primer/behaviors": "*",
    "@primer/octicons-react": "*",
    "@primer/react": "*",
    "clsx": "*",
    "fzy.js": "*",
    "lodash-es": "4.17.21",
    "react": "*",
    "react-relay": "*",
    "relay-runtime": "*"
  },
  "devDependencies": {
    "@github-ui/analytics-test-utils": "*",
    "@github-ui/eslint-config-shared-components": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/jest": "*",
    "@github-ui/storybook": "*",
    "@github-ui/tsconfig": "*",
    "@storybook/react": "*",
    "@storybook/test": "*",
    "@testing-library/react": "*",
    "@types/dompurify": "2.4.0",
    "msw": "*",
    "relay-test-utils": "*"
  },
  "type": "module",
  "private": false
}
