{
  "name": "@github-ui/verify-package-versions",
  "description": "A script to check installed package versions and ensure there are no mismatched versions",
  "scripts": {
    "lint": "eslint --cache --max-warnings=0 . --ext .js,.ts,.tsx,.json",
    "start": "node --no-warnings --experimental-strip-types verify-package-versions.ts",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "jest",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@github-ui/eslintrc": "*",
    "@github-ui/jest": "*"
  },
  "dev": true,
  "private": true
}
