{
  "name": "@github-ui/stylelint",
  "description": "Stylelint config and dependencies",
  "exports": {
    "./stylelint.config": "./stylelint.config.js"
  },
  "scripts": {
    "codemods": "stylelint --fix -c ./codemods/stylelint.config.json -- ../../../app/assets/stylesheets/ ../../../ui/packages/**/*.scss",
    "lint": "eslint . --cache",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@github-ui/eslintrc": "*",
    "@github-ui/jest": "*",
    "@github-ui/swc": "*",
    "@primer/stylelint-config": "13.3.0",
    "postcss-value-parser": "4.2.0",
    "stylelint": "16.14.1",
    "stylelint-actions-formatters": "16.3.1"
  },
  "private": true,
  "dev": true
}
