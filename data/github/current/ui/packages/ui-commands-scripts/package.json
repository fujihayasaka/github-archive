{
  "name": "@github-ui/ui-commands-scripts",
  "description": "Webpack plugin to compile commands.json configs into ui-commands.json",
  "main": "ui-commands-plugin.js",
  "exports": {
    "./compile-ui-commands": "./compile-ui-commands.js",
    "./plugin": "./ui-commands-plugin.js",
    "./validate-ui-commands": "./validate-ui-commands.js"
  },
  "scripts": {
    "compile": "node ./compile-ui-commands.js",
    "lint": "eslint . --cache",
    "stylelint": "stylelint --aei --rd \"**/*.css\"",
    "test": "jest",
    "tsc": "tsc",
    "validate": "node ./validate-ui-commands.js"
  },
  "devDependencies": {
    "@github-ui/client-build-tools": "*",
    "@github-ui/eslintrc": "*",
    "@github-ui/jest": "*",
    "@github-ui/ui-commands": "*",
    "@github-ui/use-ignore-keyboard-actions-while-composing": "*",
    "@swc-node/register": "1.9.1",
    "json-schema-library": "9.1.2",
    "jsonc-parser": "3.3.1"
  },
  "dev": true,
  "private": true
}
