# Connecting to a dotcom service

# Override this value to your bp-dev instance or codespace if required
TARGET_GITHUB_URL="https://github.com/"
# When connecting to https://github.com, use our development GitHub App:
# https://github.com/apps/dependabot-dev
GITHUB_INTEGRATION_NAME="dependabot-dev"
GITHUB_INTEGRATION_ID="136965"
# Currently not set or used
GITHUB_INTEGRATION_WEBHOOK_SECRET=""
# Create your own private key via the app configuration page:
# # https://github.com/organizations/dsp-testing/settings/apps/dependabot-dev
#
# This is a real secret, so keep it safe and remember to rotate it!
GITHUB_INTEGRATION_PRIVATE_KEY=""

# Running jobs locally

# Allow updates running within containers to access Dependabot API
DEPENDABOT_API_CONTAINER_ENDPOINT="http://host.docker.internal:3001"

# Using advisory db locally

# Allows us to configure the source of GitHub Advisory data to a target other
# than the default GraphQL endpoint for TARGET_GITHUB_URL. In development, this
# ensures we pull data from dotcom instead of the local instance.
TARGET_GHSA_API_URL="https://api.github.com/graphql"

# Create a developer access token (https://github.com/settings/tokens)
# The token does not require any scopes.
GHSA_ACCESS_TOKEN="..."

# OpenTelemetry configuration
#
# To enable tracing in development, start a local Lightstep developer satellite
# and uncomment the following environment variables.
#
# See: https://thehub.github.com/epd/engineering/dev-practicals/observability/distributed-tracing/lightstep-development-mode/
# See: https://docs.lightstep.com/docs/use-developer-mode-to-quickly-see-traces
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://192.168.0.1:8360/traces/otlp/v0.9"
#OTEL_EXPORTER_OTLP_TRACES_HEADERS="lightstep-access-token=developer"
OTEL_LOG_LEVEL="debug"
