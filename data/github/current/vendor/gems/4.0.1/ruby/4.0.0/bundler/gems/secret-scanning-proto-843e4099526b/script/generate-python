#!/bin/bash
set -eu
mkdir -p gen/docs
IMAGE=secret-scanning-proto-generate-python

tar cf - \
    config/tools/generate-python \
	_template/python |
docker build --pull -f config/tools/generate-python/Dockerfile -t ${IMAGE} -

docker run --rm \
	--net=none \
	-v $(pwd)/proto:/go/src/github.com/github/secret-scanning-proto/proto \
	-v $(pwd)/gen:/go/src/github.com/github/secret-scanning-proto/gen \
	${IMAGE}
