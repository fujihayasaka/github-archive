# Conda version handling based on conda's version specification
# See: https://docs.conda.io/projects/conda/en/stable/user-guide/concepts/pkg-specs.html
#
# Version format: [epoch!]version[+local]
#
# Components:
# - Epoch (optional): Integer prefix with ! separator (e.g., "1!2.0")
# - Version: Main version identifier with segments separated by . or _
# - Local version (optional): Build metadata with + prefix (e.g., "1.0+abc.7")
#
# Special handling:
# - "dev" pre-releases sort before all other pre-releases
# - "post" releases sort after the main version
# - Underscores are normalized to dots
# - Case-insensitive string comparison
# - Fillvalue 0 insertion for missing segments
# - Integer < String in mixed-type segment comparison (numeric before pre-release)
#
# source://dependabot-conda//lib/dependabot/conda/version.rb#27
class Dependabot::Conda::Version < ::Dependabot::Version
  # @raise [ArgumentError]
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#57
  sig { override.params(version: T.nilable(T.any(::Gem::Version, ::Integer, ::String))).void }
  def initialize(version); end

  # source://dependabot-conda//lib/dependabot/conda/version.rb#79
  sig { override.params(other: T.untyped).returns(T.nilable(::Integer)) }
  def <=>(other); end

  # source://dependabot-conda//lib/dependabot/conda/version.rb#45
  sig { returns(::Integer) }
  def epoch; end

  # source://dependabot-conda//lib/dependabot/conda/version.rb#51
  sig { returns(T.nilable(T::Array[T.any(::Integer, ::String)])) }
  def local_parts; end

  # source://dependabot-conda//lib/dependabot/conda/version.rb#48
  sig { returns(T::Array[T.any(::Integer, ::String)]) }
  def version_parts; end

  private

  # Check if segment is alpha pre-release
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#246
  sig { params(lower_segment: ::String).returns(T::Boolean) }
  def alpha_prerelease?(lower_segment); end

  # Check if segment is beta pre-release
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#252
  sig { params(lower_segment: ::String).returns(T::Boolean) }
  def beta_prerelease?(lower_segment); end

  # Compares local version parts
  # - nil local version sorts before any local version
  # - Both nil: equal
  # - Otherwise compare using same rules as version parts
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#319
  sig do
    params(
      local1: T.nilable(T::Array[T.any(::Integer, ::String)]),
      local2: T.nilable(T::Array[T.any(::Integer, ::String)])
    ).returns(::Integer)
  end
  def compare_local_parts(local1, local2); end

  # Compares two arrays of version parts with fillvalue insertion
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#275
  sig do
    params(
      parts1: T::Array[T.any(::Integer, ::String)],
      parts2: T::Array[T.any(::Integer, ::String)]
    ).returns(::Integer)
  end
  def compare_parts(parts1, parts2); end

  # Compares two individual segments
  # Rules:
  # - Both integers: numeric comparison
  # - Both strings: case-insensitive lexicographic comparison
  # - Mixed types: Integer < String (numeric versions sort before pre-releases)
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#296
  sig { params(seg1: T.any(::Integer, ::String), seg2: T.any(::Integer, ::String)).returns(::Integer) }
  def compare_single_segment(seg1, seg2); end

  # Check if segment is dev pre-release
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#240
  sig { params(lower_segment: ::String).returns(T::Boolean) }
  def dev_prerelease?(lower_segment); end

  # Check if segment contains an embedded pre-release marker
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#176
  sig { params(lower_seg: ::String).returns(T::Boolean) }
  def embedded_prerelease?(lower_seg); end

  # Normalizes a pre-release or post-release segment
  # Only called for confirmed pre-release/post-release patterns
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#223
  sig { params(segment: ::String).returns(T.any(::Integer, ::String)) }
  def normalize_prerelease_segment(segment); end

  # Parses version components into normalized segments
  # Normalizes underscores to dots, handles special strings (dev, post)
  # Splits alphanumeric segments like "a1" into ["a", 1]
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#133
  sig { params(version_str: ::String).returns(T::Array[T.any(::Integer, ::String)]) }
  def parse_components(version_str); end

  # Parses epoch and local version from version string
  # Returns VersionParts struct with epoch, main, and local fields
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#110
  sig { params(version_str: ::String).returns(T.untyped) }
  def parse_epoch_and_local(version_str); end

  # Check if segment is post-release
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#264
  sig { params(lower_segment: ::String).returns(T::Boolean) }
  def post_release?(lower_segment); end

  # Process normal subsegments (no pre-release markers)
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#210
  sig { params(subsegments: T::Array[::String], segments: T::Array[T.any(::Integer, ::String)]).void }
  def process_normal_subsegments(subsegments, segments); end

  # Process subsegments that contain pre-release markers
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#190
  sig { params(subsegments: T::Array[::String], segments: T::Array[T.any(::Integer, ::String)]).void }
  def process_prerelease_subsegments(subsegments, segments); end

  # Process a single version segment and add results to segments array
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#158
  sig { params(segment: ::String, segments: T::Array[T.any(::Integer, ::String)]).void }
  def process_segment(segment, segments); end

  # Check if segment is rc pre-release
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#258
  sig { params(lower_segment: ::String).returns(T::Boolean) }
  def rc_prerelease?(lower_segment); end

  # Validates version string for malformed segments
  #
  # @raise [ArgumentError]
  #
  # source://dependabot-conda//lib/dependabot/conda/version.rb#98
  sig { params(version_str: ::String).void }
  def validate_version!(version_str); end

  class << self
    # source://dependabot-conda//lib/dependabot/conda/version.rb#33
    sig { override.params(version: T.nilable(T.any(::Gem::Version, ::Integer, ::String))).returns(T::Boolean) }
    def correct?(version); end

    # source://dependabot-conda//lib/dependabot/conda/version.rb#40
    sig do
      override
        .params(
          version: T.nilable(T.any(::Gem::Version, ::Integer, ::String))
        ).returns(::Dependabot::Conda::Version)
    end
    def new(version); end
  end
end

