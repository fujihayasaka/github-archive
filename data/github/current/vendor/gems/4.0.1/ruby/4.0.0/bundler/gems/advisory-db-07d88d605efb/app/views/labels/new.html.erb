<% content_for :breadcrumbs do %>
  <%= render "breadcrumbs", label: label %>
<% end %>

<header class="pagehead border-bottom pb-3 mb-4">
  <h1 class="mb-2 lh-condensed text-normal" <%= test_selector("label-title") %>>Create a label</h1>
</header>

<% if label.errors.any? %>
  <%= render Primer::Beta::Flash.new(scheme: :danger, icon: "hubot", spacious: true, test_selector: "flash-error") do %>
    The label could not be created. See details below.
    <% if label.errors.include?(:base) %>
      <ul class="list-style-none ml-5">
        <% label.errors.full_messages_for(:base).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>

<%= render Primer::Alpha::Layout.new(first_in_source: :main) do |layout| %>
  <% layout.with_sidebar(col_placement: :end) do %>
    <div class="position-sticky top-0 mt-n4 pt-4">
      <%= render(Primer::ButtonComponent.new(
        type: :submit,
        form: "label-form",
        display: :flex,
        align_items: :center,
        mb: 2,
        classes: "btn-large width-full"
      )) do %>
        <%= render IconComponent.new(icon: "plus", mr: 3) %>
        Create label
      <% end %>
    </div>
  <% end %>
  <% layout.with_main do %>
    <%= render "label_form", label: label %>
  <% end %>
<% end %>
