#!/bin/bash

usage() {
  echo "Usage: $0 {run|test|console}"
}

case "$1" in
  run)
    echo "Running adapter..."
    bundle exec rake run
    ;;
  test)
    echo "Running adapter tests..."
    bundle exec rake test && ./page_fetch.test
    ;;
  console)
    /bin/bash
    ;;
  *)
    usage
    exit 1
esac
