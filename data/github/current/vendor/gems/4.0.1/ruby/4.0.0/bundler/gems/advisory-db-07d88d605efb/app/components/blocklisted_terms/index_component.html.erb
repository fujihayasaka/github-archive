<% content_for :title, "Blocklisted terms" %>
<h2 class="mb-4 d-flex flex-justify-between flex-items-center">
  Blocklisted terms
  <%= render(Primer::ButtonComponent.new(tag: :a, href: new_blocklisted_term_path, scheme: :primary, variant: :small)) { "New blocklisted term" } %>
</h2>

<div class="d-flex flex-row">
  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      Level: <%= level.humanize %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(level: nil, page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (level == "all" ? :visible : :hidden)) %>
            All levels
          </a>
          <% BlocklistedTerm::LEVELS.each do |level_filter| %>
            <a role="menuitem" class="SelectMenu-item no-wrap"
              href="<%= url_for(request.query_parameters.merge(level: level_filter, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (level == level_filter ? :visible : :hidden)) %>
              <%= level_filter.humanize %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      Term type: <%= term_type.humanize %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(term_type: nil, page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (term_type == "all" ? :visible : :hidden)) %>
            All types
          </a>
          <% BlocklistedTerm::TYPES.each do |term_type_filter| %>
            <a role="menuitem" class="SelectMenu-item no-wrap"
              href="<%= url_for(request.query_parameters.merge(term_type: term_type_filter, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (term_type == term_type_filter ? :visible : :hidden)) %>
              <%= term_type_filter.humanize %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= form_tag(blocklisted_terms_path, method: :get, class: "d-flex flex-1") do %>
    <% hidden_search_fields.each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>

    <%= text_field_tag "query", query, placeholder: "Search for patterns", autocomplete: "on", class: "form-control flex-1 mb-3" %>
  <% end %>
</div>

<%= render(Primer::Beta::BorderBox.new) do |border_box| %>
  <% border_box.with_header(display: :flex) do %>
    <div class="flex-3">Pattern</div>
    <div class="flex-1 pl-3">Level</div>
    <div class="flex-1 pl-3">Term type</div>
  <% end %>

  <% blocklisted_terms.each do |blocklisted_term| %>
    <% border_box.with_row(display: :flex) do %>
      <%= render(Primer::Truncate.new(classes: "flex-3")) do %>
        <%= render(Primer::Beta::Link.new(
          href: blocklisted_term_path(blocklisted_term),
          font_weight: :bold,
          scheme: :primary,
          underline: false,
          pr: 2,
        )) { blocklisted_term.pattern } %>
      <% end %>
      <div class="flex-1 pl-3">
        <%= blocklisted_term.level %>
      </div>
      <div class="flex-1 pl-3">
        <%= blocklisted_term.term_type %>
      </div>
    <% end %>
  <% end %>

  <% if blocklisted_terms.empty? %>
    <% border_box.with_footer(display: :flex, justify_content: :center) { "No blocklisted terms to show" } %>
  <% end %>
<% end %>

<%= pagination(blocklisted_terms) %>
