#!/bin/bash

set -xe

usage() {
  echo "Usage: $0 {run|test|console}"
}

case "$1" in
  run)
    PYTHONPATH="/src/app/package_manager_adapters/pypi/packages:${PYTHONPATH}" DATA_DIR=/src/app/package_manager_adapters/pypi/data python3 lib/extractor.py "$@"
    ;;
  test)
    PYTHONPATH=lib:packages packages/bin/pytest -v
    ;;
  console)
    /bin/bash
    ;;
  *)
    usage
    exit 1
esac
