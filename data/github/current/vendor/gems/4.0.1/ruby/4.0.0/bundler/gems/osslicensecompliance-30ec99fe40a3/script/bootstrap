#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workflow="${repo_root}/.github/workflows/build.yaml"

if [[ ! -f "${workflow}" ]]; then
  echo "ERROR: cannot find workflow at ${workflow}" >&2
  exit 2
fi

# Extract lint-version from the github/go-linter step.
# Expected YAML fragment:
#   - name: Lint Code
#     uses: github/go-linter@...
#     with:
#       ...
#       lint-version: vX.Y.Z
lint_version="$(
  awk '
    $0 ~ /uses:[[:space:]]*github\/go-linter@/ { in_step=1 }
    in_step && $0 ~ /^[[:space:]]*lint-version:[[:space:]]*/ {
      sub(/^[[:space:]]*lint-version:[[:space:]]*/, "", $0)
      gsub(/"/, "", $0)
      print $0
      exit
    }
    in_step && $0 ~ /^[[:space:]]*-[[:space:]]name:/ { in_step=0 }
  ' "${workflow}"
)"

if [[ -z "${lint_version}" ]]; then
  echo "ERROR: No lint-version found in ${workflow}." >&2
  echo "Add it under the 'github/go-linter' step, e.g.: lint-version: v2.8.0" >&2
  exit 2
fi

# Security/robustness: ensure we parsed a plain version string (not arbitrary YAML content).
# We intentionally keep this strict: golangci-lint versions are expected to look like `v2.8.0`.
if [[ ! "${lint_version}" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "WARNING: Parsed lint-version from workflow is not a plain semver: ${lint_version}" >&2
  echo "  Expected something like: v2.8.0" >&2
  return 2
fi

mkdir -p "${repo_root}/bin"

echo "==> Installing golangci-lint ${lint_version} into ${repo_root}/bin" >&2
GOBIN="${repo_root}/bin" go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${lint_version}"

echo "==> Installed:" >&2
"${repo_root}/bin/golangci-lint" --version
