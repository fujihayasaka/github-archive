Dependabot::Uv::UpdateChecker::PipCompileVersionResolver::GIT_DEPENDENCY_URL_FROM_UV_REGEX = T.let(T.unsafe(nil), Regexp)

# source://dependabot-uv//lib/dependabot/uv/update_checker/pip_compile_version_resolver.rb#32
Dependabot::Uv::UpdateChecker::PipCompileVersionResolver::GIT_REFERENCE_NOT_FOUND_REGEX = T.let(T.unsafe(nil), Regexp)

