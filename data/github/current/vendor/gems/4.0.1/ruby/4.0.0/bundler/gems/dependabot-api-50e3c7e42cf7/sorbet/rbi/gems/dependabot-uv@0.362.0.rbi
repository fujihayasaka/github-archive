  def setup_files; end

  # source://dependabot-uv//lib/dependabot/uv/update_checker/pip_compile_version_resolver.rb#417
  sig { params(file: ::Dependabot::DependencyFile, updated_req: T.nilable(::String)).returns(::String) }
  def update_req_file(file, updated_req); end

  # source://dependabot-uv//lib/dependabot/uv/update_checker/pip_compile_version_resolver.rb#333
  sig { params(requirements_file: ::Dependabot::DependencyFile).returns(T::Array[::String]) }
  def uv_pip_compile_options_from_compiled_file(requirements_file); end

  # source://dependabot-uv//lib/dependabot/uv/update_checker/pip_compile_version_resolver.rb#409
  sig { void }
  def write_original_manifest_files; end

  # source://dependabot-uv//lib/dependabot/uv/update_checker/pip_compile_version_resolver.rb#389
  sig { params(updated_req: T.nilable(::String), update_requirement: T::Boolean).void }
  def write_temporary_dependency_files(updated_req: T.unsafe(nil), update_requirement: T.unsafe(nil)); end
end

