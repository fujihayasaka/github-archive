# source://dependabot-uv//lib/dependabot/uv/file_updater/requirement_file_updater.rb#13
Dependabot::Uv::FileUpdater::RequirementFileUpdater = Dependabot::Python::FileUpdater::RequirementFileUpdater

# UV uses the same requirement replacement logic as Python.
# Both ecosystems share RequirementParser, NativeHelpers, and NameNormaliser
# via aliases, so we reuse Python's implementation.
#
# source://dependabot-uv//lib/dependabot/uv/file_updater/requirement_replacer.rb#13
Dependabot::Uv::FileUpdater::RequirementReplacer = Dependabot::Python::FileUpdater::RequirementReplacer

