#!/bin/sh
# Run a rake command in the app's development environment.

set -e

[ -f /etc/app-env ] && exec bundle exec rake $@

cmd="$@"

image=${DOCKER_IMAGE:=web}

port_publish=""; [ "${BIND_DOCKER_SERVICE_PORTS:-}" = 1 ] && port_publish="--service-ports"
exec docker compose run $port_publish --rm $image bundle exec rake $cmd
