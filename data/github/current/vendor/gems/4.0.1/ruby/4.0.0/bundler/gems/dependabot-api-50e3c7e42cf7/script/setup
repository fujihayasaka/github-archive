#!/bin/bash

# Setup the application for first use after cloning. This is non-destructive by
# default.
#
# Arguments:
#  -- force - Recreates the MySQL database, destroying local data
set -e

cd "$(dirname "$0")/.."

mkdir -p tmp/pids tmp/logs

script/bootstrap
script/create-databases "$@"
script/dependabot check-github-app --warn
script/create-topics
script/install-terraform
script/install-gh-extensions
