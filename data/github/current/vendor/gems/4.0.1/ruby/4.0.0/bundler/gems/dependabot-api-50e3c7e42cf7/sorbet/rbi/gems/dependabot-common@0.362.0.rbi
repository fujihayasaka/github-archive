    params(
      name: ::String,
      detected_version: T.nilable(::Dependabot::Version),
      version: T.nilable(::Dependabot::Version),
      deprecated_versions: T::Array[::Dependabot::Version],
      supported_versions: T::Array[::Dependabot::Version],
      requirement: T.nilable(::Dependabot::Requirement)
    ).void
  end
  def initialize(name:, detected_version: T.unsafe(nil), version: T.unsafe(nil), deprecated_versions: T.unsafe(nil), supported_versions: T.unsafe(nil), requirement: T.unsafe(nil)); end

  # Checks if the current version is deprecated.
  # Returns true if the version is in the deprecated_versions array; false otherwise.
  #
  # @example
  #   deprecated? #=> true
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#114
  sig { returns(T::Boolean) }
  def deprecated?; end

  # Returns an array of deprecated versions of the package manager.
  #
  # @example
  #   deprecated_versions #=> [Version.new("1")]
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#79
  sig { returns(T::Array[::Dependabot::Version]) }
  def deprecated_versions; end

  # The current version of the package manager or language.
  #
  # @example
  #   detected_version #=> Dependabot::Version.new("2")
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#67
  sig { returns(T.nilable(::Dependabot::Version)) }
  def detected_version; end

  # The name of the package manager (e.g., "bundler", "npm").
  #
  # @example
  #   name #=> "bundler"
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#61
  sig { returns(::String) }
  def name; end

  # Raises an error if the current package manager or language version is unsupported.
  # If the version is unsupported, it raises a ToolVersionNotSupported error.
  #
  # @raise [ToolVersionNotSupported]
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#139
  sig { void }
  def raise_if_unsupported!; end

  # The current requirement of the package manager or language.
  #
  # @example
  #   requirement #=> nil
  #   requirement #=> Dependabot::Requirement.new(">= 2.1.4")
  #   requirement #=> Dependabot::Requirement.new(">= 2.1.4, < 3.0")
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#91
  sig { returns(T.nilable(::Dependabot::Requirement)) }
  def requirement; end

  # Indicates if the package manager supports later versions beyond those listed in supported_versions.
  # By default, returns false if not overridden in the subclass.
  #
  # @example
  #   support_later_versions? #=> true
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#159
  sig { returns(T::Boolean) }
  def support_later_versions?; end

  # Returns an array of supported versions of the package manager.
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#83
  sig { returns(T::Array[::Dependabot::Version]) }
  def supported_versions; end

  # Checks if the current version is unsupported.
  #
  # @example
  #   unsupported? #=> false
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#127
  sig { returns(T::Boolean) }
  def unsupported?; end

  # The current version of the package manager or language.
  #
  # @example
  #   version #=> Dependabot::Version.new("2.1.4")
  #
  # source://dependabot-common//lib/dependabot/ecosystem.rb#73
  sig { returns(T.nilable(::Dependabot::Version)) }
  def version; end

  # The raw version of the package manager or language.
  #
  # @example
  #   raw_version #=> "2.1.4"
  #
