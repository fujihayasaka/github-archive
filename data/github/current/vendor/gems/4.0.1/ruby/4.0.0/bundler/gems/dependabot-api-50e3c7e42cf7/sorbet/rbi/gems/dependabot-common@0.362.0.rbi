    #
    # source://dependabot-common//lib/dependabot/file_filtering.rb#73
    sig { params(path: ::String).returns(::String) }
    def normalize_path(path); end

    # Check for recursive pattern matches (patterns ending with /**)
    #
    # source://dependabot-common//lib/dependabot/file_filtering.rb#40
    sig { params(normalized_path: ::String, pattern: ::String).returns(T::Boolean) }
    def recursive_match?(normalized_path, pattern); end

    # Helper method to check if a file path should be excluded
    #
    # source://dependabot-common//lib/dependabot/file_filtering.rb#92
    sig { params(path: ::String, context: ::String, exclude_paths: T.nilable(T::Array[::String])).returns(T::Boolean) }
    def should_exclude_path?(path, context, exclude_paths); end
  end
end

