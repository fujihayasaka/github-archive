    def exact_or_directory_match?(normalized_path, pattern, normalized_pattern); end

    # Returns true if the given path matches any of the exclude patterns
    #
    # source://dependabot-common//lib/dependabot/file_filtering.rb#10
    sig { params(path: ::String, exclude_patterns: T.nilable(T::Array[::String])).returns(T::Boolean) }
    def exclude_path?(path, exclude_patterns); end

    # Check for glob pattern matches with various fnmatch flags
    #
    # source://dependabot-common//lib/dependabot/file_filtering.rb#56
    sig { params(normalized_path: ::String, pattern: ::String, normalized_pattern: ::String).returns(T::Boolean) }
    def glob_match?(normalized_path, pattern, normalized_pattern); end

    # Normalize a file path for consistent comparison
    # - Removes leading slashes
