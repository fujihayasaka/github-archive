# frozen_string_literal: true

lib = File.expand_path("lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
require "github/spokes/proto/version"

Gem::Specification.new do |s|
  s.name          = 'spokes-proto'
  s.version       = GitHub::Spokes::Proto::VERSION
  s.authors       = "GitHub"
  s.homepage      = "https://github.com/github/spokes-proto/tree/master/gen/ruby"
  s.summary       = "Generated client/server code for Spokes Access API."
  s.license       = "Nonstandard"

  s.files         = Dir["**/*.rb"]

  s.add_dependency "twirp", "<= 1.12.0"
  s.add_dependency "rack", ">= 2.2.3" # https://github.com/github/twirp-ruby/commit/aa4000f8ea9ff84447060ab8a7f425ed70e0bf56

  s.add_development_dependency "bundler"
  s.add_development_dependency "minitest", "~> 5.0"
  s.add_development_dependency "rake"
end
