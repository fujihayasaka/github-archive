{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // Environment variables are loaded directly from .env.local file.
    // VS Code will automatically load all variables defined in .env.local for debugging.
    // If .env.local doesn't exist, run 'make setup-env' to create it from the template.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/configsd",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.local"
        },
        {
            "name": "Debug Integration Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/integration-test",
            "buildFlags": "-tags=integration",
            "envFile": "${workspaceFolder}/.env.local",
            "args": [
                "-test.v"
            ]
        }
    ]
}
