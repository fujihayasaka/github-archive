<% content_for :title, "Advisory Inbox" %>
<div class="d-flex gutter">
  <div class="col-6">
    <div class="px-4 py-3 border rounded-3">
      <h2 class="f5">CVE reviews</h2>
      <div class="h1">
        <%= render Primer::Beta::Link.new(href: cve_review_triage_index_path, scheme: :primary, display: :inline_block, test_selector: "in-triage-cve-review-count") do %>
          <%= number_with_delimiter(in_triage_cve_review_count) %> in triage
        <% end %>
        <span class="mx-2">+</span>
        <%= render Primer::Beta::Link.new(href: cve_reviews_path, scheme: :primary, test_selector: "open-cve-review-count") do %>
          <%= number_with_delimiter(open_cve_review_count) %> open
        <% end %>
      </div>
      <p class="m-0"><%= cve_reviews.count %> new since yesterday</p>
    </div>
  </div>

  <div class="col-6">
    <div class="px-4 py-3 border rounded-3">
      <h2 class="f5">Advisory reviews</h2>
      <div class="h1">
        <%= render Primer::Beta::Link.new(href: advisory_reviews_path, scheme: :primary, display: :inline_block, test_selector: "open-advisory-review-count") do %>
          <%= number_with_delimiter(open_advisory_review_count) %> open
        <% end %>
        <span class="mx-2">+</span>
        <%= render Primer::Beta::Link.new(href: advisory_reviews_path(state: :ready), scheme: :primary, display: :inline_block, test_selector: "ready-advisory-review-count") do %>
          <%= number_with_delimiter(ready_advisory_review_count) %> ready
        <% end %>
      </div>
      <p class="m-0"><%= advisory_reviews.count %> new since yesterday</p>
    </div>
  </div>
</div>

<div class="mt-5">
  <p class="mb-2 text-bold color-fg-default">CVE reviews added since yesterday</p>
  <%= render CVEReviews::TableComponent.new(cve_reviews: cve_reviews) %>
</div>

<div class="mt-5">
  <p class="mb-2 text-bold color-fg-default">Advisory reviews added since yesterday</p>
  <%= render AdvisoryReviews::TableComponent.new(advisory_reviews: advisory_reviews) %>
  <%= will_paginate advisory_reviews,
    inner_window: 2,
    outer_window: 0,
    previous_label: "Previous",
    next_label: "Next",
    class: "pagination text-center mt-3"
  %>
</div>
