#!/bin/bash

set -e

cd "$(dirname "${BASH_SOURCE[0]}")/.."

function cleanup() {
    docker compose down -v
}

function main() {
  trap cleanup INT SIGINT SIGTERM EXIT

  script/docker

  if [ "$1" != "--proxima" ]; then
    script/overmind start -d $(pwd) -f script/all.dev
  else 
    script/overmind start -d $(pwd) -f script/all-proxima.dev
  fi
}

main $@