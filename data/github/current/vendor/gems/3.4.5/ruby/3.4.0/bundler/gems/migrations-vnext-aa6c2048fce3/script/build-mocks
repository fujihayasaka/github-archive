#!/bin/bash
set -e

docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir internal/pkg/dag --output internal/pkg/dag --inpackage --filename dag_mock.go --name DAG
docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir internal/pkg/dag --output internal/pkg/dag --inpackage --filename manager_mock.go --name Manager
docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir internal/pkg/dag --output internal/pkg/dag --inpackage --filename object_store_mock.go --name ObjectStore
docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir internal/pkg/kafka --output internal/pkg/kafka/mocks --name Producer --name Consumer
docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir internal/pkg/resource --output internal/pkg/resource/mocks --name Loader
docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir internal/pkg/events --output internal/pkg/events/mocks --name Loader
docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir internal/pkg/resourceworker --output internal/pkg/resourceworker --inpackage --filename object_store_mock.go --name ObjectStore
docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir internal/pkg/dlworker --output internal/pkg/dlworker --inpackage --filename object_store_mock.go --name ObjectStore
docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir pkg/mvnd/v1 --output internal/v1/migrations --inpackage --filename migrations_twirp_mock.go --name Migration
docker run -v "${PWD}:/src" -v "${GOPATH:-$HOME/go}/pkg/mod:/go/pkg/mod" -w /src vektra/mockery --dir internal/pkg/servermigrator --output internal/pkg/servermigrator --inpackage --filename migration_target_mock.go --name MigrationTargetAPI
