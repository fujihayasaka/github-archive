<% content_for :title, "Review campaign: #{campaign.name}" %>
<% content_for :breadcrumbs do %>
  <%= render "campaigns/breadcrumbs", campaign: campaign %>
<% end %>

<h2 class="mb-4 d-flex flex-justify-between flex-items-center">
  <%= campaign.name %>
  <div class="ml-4 flex-auto">
    <%= render "progress", campaign.progress_counts %>
  </div>
</h2>

<%= render AdvisoryReviews::FilterableTableComponent.new(sort: params[:sort], sort_by: params[:sort_by], state: params[:state], curator: params[:curator], source: params[:source], page: params[:page], query: params[:query], ecosystem: params[:ecosystem], label_ids: params[:label_ids], severity: params[:severity], campaign: campaign.id, campaign_review_state: params[:campaign_review_state]) %>

<div class="mt-6 text-right">
  <%= link_to "Delete campaign", campaign_path(campaign), method: :delete, data: { confirm: "Are you sure you want to delete this campaign?" }, class: "btn btn-danger btn-sm" %>
</div>
