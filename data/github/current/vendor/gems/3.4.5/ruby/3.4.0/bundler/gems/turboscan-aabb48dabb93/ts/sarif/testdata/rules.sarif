{
  "$schema":"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version":"2.1.0",
  "runs":[
    {
      "tool":{
        "driver":{
          "name":"CodeQL",
          "organization":"GitHub",
          "semanticVersion":"2.0.0",
          "rules":[
            {
              "id":"js/unused-local-variable",
              "deprecatedIds":[
                "OldIdentifier"
              ],
              "name":"js/unused-local-variable",
              "shortDescription":{
                "text":"Unused variable, import, function or class"
              },
              "fullDescription":{
                "text":"Unused variables, imports, functions or classes may be a symptom of a bug and should be examined carefully."
              },
              "help":{
                "text":"TextHelp",
                "markdown":"This **is** `help`"
              },
              "defaultConfiguration":{

              },
              "properties":{
                "tags":[
                  "maintainability"
                ],
                "kind":"problem",
                "precision":"very-high",
                "name":"Unused variable, import, function or class",
                "description":"Unused variables, imports, functions or classes may be a symptom of a bug\n              and should be examined carefully.",
                "id":"js/unused-local-variable",
                "problem.severity":"recommendation"
              }
            },
            {
              "id":"com.lgtm/python-queries:py/unnecessary-pass",
              "name":"com.lgtm/python-queries:py/unnecessary-pass",
              "shortDescription":{
                "text":"Unnecessary pass"
              },
              "fullDescription":{
                "text":"Unnecessary 'pass' statement"
              },
              "help":{
                "text":"TextHelp"
              },
              "helpUri":"http://lgtm.com",
              "defaultConfiguration":{

              }
            }
          ]
        }
      },
      "results":[
        {
          "ruleId":"js/unused-local-variable",
          "message":{
            "text":"Unused variable foo."
          },
          "locations":[
            {
              "physicalLocation":{
                "artifactLocation":{
                  "uri":"controllers/artists.js",
                  "uriBaseId":"%SRCROOT%"
                },
                "region":{
                  "startLine":126,
                  "startColumn":18,
                  "endColumn":51
                }
              }
            }
          ]
        },
        {
          "ruleIndex":0,
          "message":{
            "text":"Unused variable foo."
          },
          "locations":[
            {
              "physicalLocation":{
                "artifactLocation":{
                  "uri":"controllers/artists.js",
                  "uriBaseId":"%SRCROOT%"
                },
                "region":{
                  "startLine":126,
                  "startColumn":18,
                  "endColumn":51
                }
              }
            }
          ]
        },
        {
          "rule":{
            "id":"js/unused-local-variable"
          },
          "message":{
            "text":"Unused variable foo."
          },
          "locations":[
            {
              "physicalLocation":{
                "artifactLocation":{
                  "uri":"controllers/artists.js",
                  "uriBaseId":"%SRCROOT%"
                },
                "region":{
                  "startLine":126,
                  "startColumn":18,
                  "endColumn":51
                }
              }
            }
          ]
        },
        {
          "rule":{
            "index":0
          },
          "message":{
            "text":"Unused variable foo."
          },
          "locations":[
            {
              "physicalLocation":{
                "artifactLocation":{
                  "uri":"controllers/artists.js",
                  "uriBaseId":"%SRCROOT%"
                },
                "region":{
                  "startLine":126,
                  "startColumn":18,
                  "endColumn":51
                }
              }
            }
          ]
        },
        {
          "ruleId":"com.lgtm/python-queries:py/unnecessary-pass",
          "message":{
            "text":"Unnecessary pass."
          },
          "locations":[
            {
              "physicalLocation":{
                "artifactLocation":{
                  "uri":"controllers/artists.js",
                  "uriBaseId":"%SRCROOT%"
                },
                "region":{
                  "startLine":126,
                  "startColumn":18,
                  "endColumn":51
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
