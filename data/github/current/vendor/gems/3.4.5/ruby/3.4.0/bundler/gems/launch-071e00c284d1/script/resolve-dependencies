#!/usr/bin/env bash
#
# This script is run automatically, early, in Janky CI builds.
# It vendors the dependencies from our internal GOPROXY to be used in later stages.
# https://github.com/github/goproxy/blob/main/doc/user.md#janky

set -euo pipefail

echo "Download dependencies." >&2
echo "machine goproxy.githubapp.com login nobody password $BP_GITHUB_TOKEN" > "$HOME/.netrc"

export GOPROXY=https://goproxy.githubapp.com/mod,https://proxy.golang.org,direct
export GOPRIVATE=
export GONOPROXY=
export GONOSUMDB="github.com/github/*"

echo "%%%FOLD {Download Go modules}%%%"

docker run -e "GOPROXY=$GOPROXY" \
  -e "GONOSUMDB=$GONOSUMDB" \
  -v "$HOME/.netrc:/root/.netrc" \
  -v "$PWD:/go/src/github.com/github/launch" \
  -w /go/src/github.com/github/launch \
  --entrypoint bash \
  ghcr.io/github/gh-base-image/go-builder-focal:latest \
  -c "go mod vendor && chown -R $(id -u) vendor"

echo "%%%END FOLD%%%"
