
[
  {
    "value": {
      "name": "APP_ENV",
      "value": "production"
    },
    "op": "add",
    "path": "/spec/template/spec/containers/0/env/-"
  },
  # proxying is needed as per https://github.com/github/datacenter/blob/main/docs/services/network-proxy.md
  {
    "value": {
      "name": "HTTP_PROXY",
      "value": "network-proxy.service.github.net:3128"
    },
    "op": "add",
    "path": "/spec/template/spec/containers/0/env/-"
  },
  {
    "value": {
      "name": "HTTPS_PROXY",
      "value": "network-proxy.service.github.net:3128"
    },
    "op": "add",
    "path": "/spec/template/spec/containers/0/env/-"
  },
  {
    "value": {
      "name": "NO_PROXY",
      "value": "*.github.net,*.cluster.local"
    },
    "op": "add",
    "path": "/spec/template/spec/containers/0/env/-"
  },
  {
    "value": {
      "name": "KAFKA_BROKERS",
      "value": "hydro-kafka-potomac-boot-1.service.iad.github.net:9093,hydro-kafka-potomac-boot-2.service.iad.github.net:9093,hydro-kafka-potomac-boot-3.service.iad.github.net:9093"
    },
    "op": "add",
    "path": "/spec/template/spec/containers/0/env/-"
  },
  {
    "value": {
      "name": "MULTI_TENANT_ENTERPRISE",
      "value": "false"
    },
    "op": "add",
    "path": "/spec/template/spec/containers/0/env/-"
  }
]
