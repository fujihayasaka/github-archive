#!/usr/bin/env bash

#/ Usage:
# - script/buf                    -> Generate buf files
# - script/buf lint               -> Lint protobuf files
# - script/buf format -w          -> Format protobuf files

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)

IMAGE=hosted-compute-ims-buf
COMMAND="generate"
if [[ -n "$@" ]]; then
  COMMAND="$@"
fi

# Build the docker image with buf and create user with the same UID/GID as the host user
# To make sure that the files generated by buf are owned by the host user
HOST_UID=$(id -u)
HOST_GID=$(id -g)
docker build \
  --tag $IMAGE \
  --file tools/buf/Dockerfile \
  --build-arg USER_UID=$HOST_UID \
  --build-arg USER_GID=$HOST_GID \
  .

if [[ $COMMAND == generate* ]]; then
  echo "Cleaning up existing twirp generated files"
  if [ -d $REPO_ROOT/gen/twirp/go ]; then
    find $REPO_ROOT/gen/twirp/go -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} \;
  fi
  if [ -d $REPO_ROOT/gen/twirp/ruby ]; then
    # Exclude 3 files which are not auto-generated and should be preserved:
    # "hosted-compute-ims.gemspec", "hosted-compute-ims.rb", "buf/validate/validate_pb.rb"
    find $REPO_ROOT/gen/twirp/ruby -mindepth 1 -maxdepth 1 -type d ! -path '*/gen/twirp/ruby/buf' -exec rm -rf {} \;
  fi

  FILES_TO_CHECK=("$REPO_ROOT/gen/twirp/ruby/hosted-compute-ims.gemspec" "$REPO_ROOT/gen/twirp/ruby/hosted-compute-ims.rb" "$REPO_ROOT/gen/twirp/ruby/buf/validate/validate_pb.rb")
  for file in ${FILES_TO_CHECK[@]}; do
    echo "Checking $file"
    if [[ ! -f $file ]]; then
      echo "Looks like '$file' was accidentially removed. This file should be preserved for dotcom compatibility"
      exit 1
    fi
  done
fi

echo "Running: buf $COMMAND"
docker run --rm \
  --volume ${REPO_ROOT}:/workspaces \
  --workdir /workspaces/proto \
  ${IMAGE} \
  $COMMAND

echo "Finished: buf $COMMAND" 