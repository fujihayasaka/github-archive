#!/usr/bin/env bash
#
# Adds aum.local to hosts file
set -e
dir=$(dirname $0)

echo "Checking hosts"

MINIKUBE_PROFILE=aum
APP_IP="$(minikube ip -p $MINIKUBE_PROFILE)"
HOST_NAME="aum.local"
HOST_ENTRY="$APP_IP $HOST_NAME"
matches_in_hosts="$(grep -n $HOST_NAME /etc/hosts | cut -f1 -d:)"

if [ ! -z "$matches_in_hosts" ]; then
    echo "Host entry already exists"
else
    echo "Adding new hosts entry."
    echo "$HOST_ENTRY" | sudo tee -a /etc/hosts >/dev/null
fi
