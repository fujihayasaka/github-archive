#!/bin/bash

set -e

AQUEDUCT_URL=http://localhost:18081


magicWord="$(curl --silent --request "POST" \
     --header "Content-Type:application/json" \
     $AQUEDUCT_URL/admin/reset | jq .magic_word)"

curl --request "POST" \
     --header "Content-Type:application/json" \
     --data "{\"magic_word\":${magicWord}}" \
     $AQUEDUCT_URL/admin/reset

curl --request "GET" \
     --header "Content-Type:application/json" \
     $AQUEDUCT_URL/admin/queue_depth