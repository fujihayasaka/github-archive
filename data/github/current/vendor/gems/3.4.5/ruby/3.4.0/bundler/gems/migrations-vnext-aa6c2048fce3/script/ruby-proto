#!/bin/sh

set -e

CDPATH="" cd -- "$(dirname -- "$(dirname -- "$0")")"

# build required protoc tooling first
make -C tools

PATH="$(pwd)/tools/bin:$PATH"

protoc --proto_path=./proto --ruby_out=./client/ruby/lib --twirp_ruby_out=./client/ruby/lib ./proto/mvnd/v1/resources.proto ./proto/mvnd/v1/events.proto ./proto/mvnd/v1/migrations.proto ./proto/mvnd/v1/context.proto
