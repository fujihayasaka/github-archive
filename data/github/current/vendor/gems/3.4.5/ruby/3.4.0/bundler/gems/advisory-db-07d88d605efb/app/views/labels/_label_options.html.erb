<% if Label.count > 0 %>
  <% Label.find_each do |label| %>
    <% selected = advisory_reviews.all? { |review| review.labels.include?(label) } %>
    <label class="SelectMenu-item" role="menuitemcheckbox" aria-checked="<%= selected %>" tabindex="0" data-label-id="<%= label.id %>" data-targets="label-picker.labels" data-action="click:label-picker#toggleLabel">
      <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (selected ? :visible : :hidden)) %>
      <div>
        <input hidden type="checkbox" value="<%= label.id %>" name="labels[]" <% if selected %>checked<% end %>>
        <%= render IconComponent.new(icon: "dot-fill", mr: 1, style: "color: ##{label.color}") %>
        <%= label.name %>
        <div class="color-fg-muted css-truncate"><%= label.description %></div>
      </div>
    </label>
  <% end %>
<% else %>
  <div class="SelectMenu-item">No labels to select</div>
<% end %>
