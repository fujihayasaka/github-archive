#!/bin/bash

# wait for containers to be ready

echo -n "waiting for containers to be ready... "

# wait for redis to be ready
while ! redis-cli -p "$(echo $(docker compose port redis 6379 2>/dev/null) | cut -d':' -f 2)" ping; do
 sleep 1
done &> /dev/null

# wait for auzire to be ready
while curl -s -o /dev/null -w "%{http_code}" http://$(docker compose port azurite 1000 2>/dev/null)/devstoreaccount1 | grep -q "400"; do
 sleep 1
done

echo "ok"
