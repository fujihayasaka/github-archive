<div class="d-flex flex-items-center mt-2">
  <%= render status_icon %>
  <%= render(Primer::Alpha::Tooltip.new(for_id: @id, text: message, direction: :w, type: :description, w: :fit)) %>
  <span class="<%= "color-fg-muted" if waiting? %>" <%= test_selector("check-name") %>>
    <%= name %>
  </span>
</div>
