default-character-set=latin1
default-collation=latin1_swedish_ci
flavor=mysql:8.0

# testing on local dev machine or codespace
[enterprise-development]
schema=github_enterprise
host=localhost
port=3001
user=root
ignore-table=authentication_key_values|authentication_tokens|businesses|integration_installations|integrations|mobile_auth_requests|mobile_device_keys|oauth_accesses|oauth_applications|oauth_authorizations|organization_credential_authorizations|public_keys|scoped_integration_installations|site_scoped_integration_installations|user_sessions|users

[enterprise]
schema=github_enterprise
host=localhost
port=3307
user=github

[enterprise-schema-check]
schema=enterprise_schema_check
host=localhost
port=3001
user=root

[enterprise-schema-check-ci]
schema=enterprise_schema_check
host=db
port=3306
user=root
