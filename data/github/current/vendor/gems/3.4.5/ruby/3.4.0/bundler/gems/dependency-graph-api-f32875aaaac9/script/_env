#!/bin/bash
#
# Sets environment variables if necessary
#
# Usage:
#
#    script/_env
set -e

ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )"/.. && pwd )"

if [ -f "Brewfile" ] && [ "$(uname -s)" = "Darwin" ]; then
  MYSQLPATH=`brew --prefix mysql@5.7`
  export PATH=$MYSQLPATH/bin:$PATH
fi

export TREE_SITTER_PARSER_DIR="$ROOT/parsers"

function github_github_codespace {
  # There's an edge case we're accounting for here -- If DG_DEVCONTAINER is set and gh/gh is cloned,
  #  we still aren't technically on a gh/gh codespace.
  if [[ -n "$CODESPACES" ]] && [[ -d /workspaces/github ]] && [[ -z "$DG_DEVCONTAINER" ]]; then
    return 0 # yes, we are in a gh/gh codespace
  else
    return 1 # no, we are somewhere else
  fi
}
export -f github_github_codespace
