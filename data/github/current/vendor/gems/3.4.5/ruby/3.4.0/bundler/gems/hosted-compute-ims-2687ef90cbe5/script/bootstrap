#!/usr/bin/env bash

#/ Usage: script/bootstrap
#/ Install dependencies and initialize the project.
#/ Bootstrap script should be run once on codespace creation

set -e

if [ "$CODESPACES" != "true" ]; then
   echo "script/boostrap" should be ran in codespaces only.
   exit 1
fi

# clone the core repo if it doesn't exist
export HOSTED_COMPUTE_CORE_PATH="/workspaces/hosted-compute-core"
if [ ! -d "$HOSTED_COMPUTE_CORE_PATH" ]; then
  git clone https://github.com/github/hosted-compute-core.git "$HOSTED_COMPUTE_CORE_PATH"
fi
# clone the lcmproxy repo if it doesn't exist
export HOSTED_COMPUTE_PROTO_PATH="/workspaces/hosted-compute-proto"
if [ ! -d "$HOSTED_COMPUTE_PROTO_PATH" ]; then
  git clone https://github.com/github/hosted-compute-proto.git "$HOSTED_COMPUTE_PROTO_PATH"
fi

# initialize credentials for goproxy
/usr/local/share/goproxy-init.sh --override

# install some dependencies
make kustomize-install
make tools
