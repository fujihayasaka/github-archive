#!/bin/bash
# Examples:
# script/query-rwr-dates 1

set -e
dir="$(dirname "$0")"

if [ -z "$1" ]; then
  echo "Usage: $0 <owner_id>"
  exit 1
fi

offset=0
limit=10

date_range='DATE_RANGE_TYPE_CURRENT_WEEK'

echo "date_range: $date_range"

json=$($dir/hmac-curl -s -X POST aum.local:32474/twirp/actions_usage_metrics.api.v1.UsageApi/GetUsageByRepoWorkflowRunner -H "Content-Type: application/json" -d "{\"request_options\": { \"date_range\": \"$date_range\", \"owner_id\": $1, \"offset\": $offset, \"limit\": $limit}}")
start_time="$(echo "$json" | jq -r ".start_time")"

end_time="$(echo "$json" | jq -r ".end_time")"

echo "$(echo $start_time) start time"
echo "$(echo $end_time) end time"

date_range='DATE_RANGE_TYPE_LATEST_MONTH'

echo "date_range: $date_range"

json=$($dir/hmac-curl -s -X POST aum.local:32474/twirp/actions_usage_metrics.api.v1.UsageApi/GetUsageByRepoWorkflowRunner -H "Content-Type: application/json" -d "{\"request_options\": { \"date_range\": \"$date_range\", \"owner_id\": $1, \"offset\": $offset, \"limit\": $limit}}")
start_time="$(echo "$json" | jq -r ".start_time")"

end_time="$(echo "$json" | jq -r ".end_time")"

echo "$(echo $start_time) start time"
echo "$(echo $end_time) end time"

date_range='DATE_RANGE_TYPE_PREVIOUS_MONTH'

echo "date_range: $date_range"

json=$($dir/hmac-curl -s -X POST aum.local:32474/twirp/actions_usage_metrics.api.v1.UsageApi/GetUsageByRepoWorkflowRunner -H "Content-Type: application/json" -d "{\"request_options\": { \"date_range\": \"$date_range\", \"owner_id\": $1, \"offset\": $offset, \"limit\": $limit}}")
start_time="$(echo "$json" | jq -r ".start_time")"

end_time="$(echo "$json" | jq -r ".end_time")"

echo "$(echo $start_time) start time"
echo "$(echo $end_time) end time"

date_range='DATE_RANGE_TYPE_LAST_30_DAYS'

echo "date_range: $date_range"

json=$($dir/hmac-curl -s -X POST aum.local:32474/twirp/actions_usage_metrics.api.v1.UsageApi/GetUsageByRepoWorkflowRunner -H "Content-Type: application/json" -d "{\"request_options\": { \"date_range\": \"$date_range\", \"owner_id\": $1, \"offset\": $offset, \"limit\": $limit}}")
start_time="$(echo "$json" | jq -r ".start_time")"

end_time="$(echo "$json" | jq -r ".end_time")"

echo "$(echo $start_time) start time"
echo "$(echo $end_time) end time"

date_range='DATE_RANGE_TYPE_LAST_90_DAYS'

echo "date_range: $date_range"

json=$($dir/hmac-curl -s -X POST aum.local:32474/twirp/actions_usage_metrics.api.v1.UsageApi/GetUsageByRepoWorkflowRunner -H "Content-Type: application/json" -d "{\"request_options\": { \"date_range\": \"$date_range\", \"owner_id\": $1, \"offset\": $offset, \"limit\": $limit}}")
start_time="$(echo "$json" | jq -r ".start_time")"

end_time="$(echo "$json" | jq -r ".end_time")"

echo "$(echo $start_time) start time"
echo "$(echo $end_time) end time"
