#!/bin/bash

# usage: make_hydro_schema_protos <proto_file>
#
# example  script/make-hydro-schema-protos github/memex/v0/memex_project_event.proto

# visit https://hydro.githubapp.com/event_catalog/hydro and find the message you are looking to add to the project
# on the schema page, eg https://hydro.githubapp.com/schemas/github-memex-v0-MemexProjectEvent?tab=schema
# there is a link to edit the schema, this will give you the full git path
# all protofiles are in `proto/hydro/schemas` so copy the part after that `github/memex/v0/memex_project_event.proto`
# then run this script with the path to the proto file

set -eu

SCRIPT_DIR=$(cd -P -- "$(dirname -- "$0")" && pwd -P)

HYDRO_SCHEMAS_PATH="${SCRIPT_DIR}/../../hydro-schemas"
GENERATED_PROTO_PATH="${SCRIPT_DIR}/../generated"

[ -d ${HYDRO_SCHEMAS_PATH} ] || git clone https://github.com/github/hydro-schemas.git "${HYDRO_SCHEMAS_PATH}"

cd ${HYDRO_SCHEMAS_PATH}
./script/generate --go-out=${GENERATED_PROTO_PATH} --go-prefix "github.com/github/billing-platform/generated" proto/hydro/schemas/${1}
