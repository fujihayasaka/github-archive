#!/bin/bash
set -e

BASE_IMAGES=$(grep -E '^FROM' Dockerfile | awk '{print $2}' | sort | uniq)
exit_code=0
for image in $BASE_IMAGES; do
    echo "🌐 Pulling $image"
    if ! docker pull $image; then
        echo "❌ Failed to pull $image" >&2
        exit_code=1
    fi
    echo
done

exit $exit_code
