#!/usr/bin/env bash
#
# Get the count of databases for the user
#
set -e

user=${1:-${GITHUB_USER}}
source "$(dirname $0)/az-resource-helpers" &> /dev/null

if [ "$2" == "--list" ]; then
  getCosmosDatabaseList | grep $user
  exit 0
fi

n=$(getCosmosDatabaseList | grep $user | wc -l)
echo
echo "Found $n databases for $user in account $SQL_ACCOUNT_NAME"

# if number of databases is greater than 10 then show a message on how to list and clean them up
if [ $n -gt 10 ]; then
  # set color to yellow
  tput setaf 3
  echo
  echo "*** WARNING ***"
  echo "You have more than 10 databases. Please clean up the unused databases."
  echo "To list databases run the following command:"
  echo "./script/helpers/get-database-count $user --list"
  echo "*** WARNING ***"
  tput sgr0
  echo
fi