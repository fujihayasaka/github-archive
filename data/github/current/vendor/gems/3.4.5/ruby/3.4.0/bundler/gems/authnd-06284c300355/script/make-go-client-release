#!/usr/bin/env bash
root="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null 2>&1 && pwd )"
cd "$root"

# First, read the version out of the Go file
GO_VERSION=$(grep Version ./client/version.go | awk '{ print $4 }' | tr -d '"')

# Check that it's valid
if [ -z "$GO_VERSION" ]; then
    fatal "could not identify Go client version"
fi

RELEASE_VERSION=${GO_VERSION} TAG_PREFIX=client CHANGELOG_PATH="$root/client/CHANGELOG.md" TITLE_PREFIX="Go Client" $root/script/helpers/make-release