# This file is used to generate the .skeema file
allow-charset=utf8mb4
default-character-set=utf8mb4
default-collation=utf8mb4_general_ci
lint-display-width=ignore

[skeema-diff-ci]
host=127.0.0.1
port=3306
user=root
schema=skeema:trust_metadata_api_production

[development]
flavor=mysql:8.0
host=${TMA_MYSQL_HOST}
schema=${TMA_MYSQL_DATABASE}
port=${TMA_MYSQL_PORT}
user=root
password=${TMA_MYSQL_ROOT_PASSWORD}
