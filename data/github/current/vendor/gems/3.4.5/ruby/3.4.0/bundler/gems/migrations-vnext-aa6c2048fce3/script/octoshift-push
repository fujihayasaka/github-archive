#!/bin/bash

hidden_refs(){
  branches="$(grep -e "refs/pull/" -e "refs/__gh__/" packed-refs | awk '{print $2}')"
  for i in $branches; do
    echo $i:$(echo $i | sed 's:refs/:refs/mvn/:')
  done
}

cd /workspaces/octoshift/repositories/github/octoshift.git
git push --all "http://ghp_MonalisaTheOctoPatMonalisaTheOctoPat@github.localhost/github/octoshift.git"
git push --tags "http://ghp_MonalisaTheOctoPatMonalisaTheOctoPat@github.localhost/github/octoshift.git"

git push "http://ghp_MonalisaTheOctoPatMonalisaTheOctoPat@github.localhost/github/octoshift.git" $(hidden_refs)

cd -
script/preseed-octoshift-git
