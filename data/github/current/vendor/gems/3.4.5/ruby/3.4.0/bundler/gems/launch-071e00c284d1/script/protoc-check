#!/bin/bash

# If we're in CI lets delete files that might be generated by script/protoc
if [[ ($GITHUB_ACTIONS || $CI) ]]; then
	find ./ruby -type f -name '*_pb.rb' -exec rm -f {} +
	find ./services -type f -name '*.pb.go' -exec rm -f {} +
fi

script/protoc
if ! git diff --quiet; then
	echo "generated proto is out of sync, diff:"
	git diff
	exit 1
fi
