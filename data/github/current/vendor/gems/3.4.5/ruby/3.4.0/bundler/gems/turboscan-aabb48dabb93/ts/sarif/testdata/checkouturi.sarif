{
    "version": "2.1.0",
    "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
    "runs": [
        {
            "invocations": [
                {
                    "workingDirectory": {
                        "uri": "file:///C%3A"
                    },
                    "executionSuccessful": true
                }
            ],
            "tool": {
                "driver": {
                    "name": "Tool",
                    "rules": [
                        {
                            "id": "js/unused-local-variable",
                            "name": "js/unused-local-variable",
                            "shortDescription": {
                                "text": "Unused variable, import, function or class"
                            },
                            "fullDescription": {
                                "text": "Unused variables, imports, functions or classes may be a symptom of a bug and should be examined carefully."
                            },
                            "defaultConfiguration": {
                                "level": "note"
                            },
                            "properties": {
                                "tags": [
                                    "maintainability"
                                ],
                                "kind": "problem",
                                "precision": "very-high",
                                "name": "Unused variable, import, function or class",
                                "description": "Unused variables, imports, functions or classes may be a symptom of a bug\n              and should be examined carefully.",
                                "id": "js/unused-local-variable",
                                "problem.severity": "recommendation"
                            }
                        }
                    ]
                }
            },
            "results": [
                {
                    "ruleId": "js/unused-local-variable",
                    "message": {
                        "text": "This is an error description"
                    },
                    "level": "error",
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "file:///C%3A/include/geometry/BoundingBox.h"
                                },
                                "region": {
                                    "startLine": 1,
                                    "endLine": 1
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}