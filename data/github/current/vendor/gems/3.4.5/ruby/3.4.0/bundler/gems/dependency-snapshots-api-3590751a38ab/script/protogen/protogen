#!/usr/bin/env bash

# Builds the simple docker image that is adjacent, runs it to generate ruby proto client.

set -euo pipefail

pushd "$(dirname "$0")"

docker build -t snapshotproto .
root=$(realpath ../..)
docker run --rm \
    -v "${root}/proto":/proto \
    -v "${root}/gen":/gen \
    -v "${root}/pkg":/twirp \
    snapshotproto
popd
