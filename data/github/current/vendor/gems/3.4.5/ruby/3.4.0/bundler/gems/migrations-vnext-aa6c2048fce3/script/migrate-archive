#!/bin/bash

set -e

if [ "$1" == "octoshift-proxima" ]; then
    script/preseed-octoshift-proxima
    ARCHIVE_ROOT=integration/fixtures/octoshift script/archiveloader --default-user-id=25 --allowed-resources=organization,user,repository,protected_branch,issue,issue_comment,issue_event,milestone,pull_request,project,label,commit_comment,noop
fi

if [ "$1" == "acme-proxima" ]; then
    script/preseed-acme-proxima
    script/archiveloader --default-user-id=25 --allowed-resources=organization,user,repository,protected_branch,issue,issue_comment,issue_event,milestone,pull_request,project,label,commit_comment,noop
fi

if [ "$1" == "acme" ]; then
    script/preseed-acme
    script/archiveloader   
fi
