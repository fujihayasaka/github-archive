#!/usr/bin/env bash
root="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null 2>&1 && pwd )"
cd "$root"

# First, read the version out of the Go file
RUBY_VERSION=$(ruby -I ./ruby/lib/authnd-client -r version.rb -e "puts Authnd::VERSION")

# Check that it's valid
if [ -z "$RUBY_VERSION" ]; then
    fatal "could not identify Ruby client version"
fi

RELEASE_VERSION=${RUBY_VERSION} TAG_PREFIX=ruby CHANGELOG_PATH="$root/ruby/CHANGELOG.md" TITLE_PREFIX="Ruby Client" $root/script/helpers/make-release