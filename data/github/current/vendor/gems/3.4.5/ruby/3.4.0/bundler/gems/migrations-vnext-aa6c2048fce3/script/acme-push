#!/bin/bash

# Create a temporary directory to uncompress repo
temp_dir=$(mktemp -d)

# Function to clean up the temp directory on exit
cleanup() {
  echo "Cleaning up..."
  rm -rf "$temp_dir"
}

# Trap the EXIT signal to ensure cleanup is run when the script exits
trap cleanup EXIT

# uncompress to temp dir
tar xzvf integration/fixtures/repositories.tar.gz -C $temp_dir

cd ${temp_dir}/repositories/acme/widgets.git
git push --all "http://ghp_MonalisaTheOctoPatMonalisaTheOctoPat@github.localhost/Acme-Inc/widgets.git"

cd -
script/preseed-acme-git
