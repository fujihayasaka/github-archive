/*
DO NOT EDIT THIS FILE MANUALLY. PLEASE USE THE GENERATOR SCRIPTS LOCATED IN config/generator.
*/
terraform {
  backend "remote" {
    hostname     = "terraform.githubapp.com"
    organization = "package-security"
    workspaces {
      name = "trust-metadata-api-production-prod-weu-01"
    }
  }
}

provider "azurerm" {
  features {}
  tenant_id       = module.blobstorage.octovault_tenant_id
  client_id       = module.blobstorage.octovault_client_id
  client_secret   = module.blobstorage.octovault_client_secret
  subscription_id = var.subscription_id
  # needed to request a delegation key from the service principal to create a SAS token
  storage_use_azuread = true
}

module "blobstorage" {
  source = "../modules/blobstorage"

  # env is used for naming resources and choosing the Vault environment
  env                       = var.env
  azure_tenant_id           = var.azure_tenant_id
  azure_client_id           = var.azure_client_id
  azure_client_secret       = var.azure_client_secret
  pagerduty_integration_url = var.pagerduty_integration_url
  subscription_id           = var.subscription_id
  resource_location         = var.resource_location
}
