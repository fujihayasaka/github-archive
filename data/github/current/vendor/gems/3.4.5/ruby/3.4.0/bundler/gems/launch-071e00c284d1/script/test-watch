#!/bin/bash
# Usage: script/test-watch [--with-db] <packages-path>
#
# Watches the passed in packages and runs specified tests when they change.
#
#  --with-db
#      Also uses the running DB instance, skipped by default

set -o pipefail

skip_db=true
args=()

while [ $# -gt 0 ]; do
  case "$1" in
    --with-db)
      skip_db=false
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if $skip_db; then
  export LAUNCH_HAS_TEST_DB=y
fi

find . -name '*.go' | entr -cs "script/test ${args[*]}"