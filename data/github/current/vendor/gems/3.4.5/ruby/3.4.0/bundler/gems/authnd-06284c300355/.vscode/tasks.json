{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Make",
      "type": "shell",
      "group": { "kind": "build", "isDefault": true },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "make",
      "args": [ "all", "lint" ],
      "problemMatcher": "$go"
    },
    {
      "label": "Make Test",
      "type": "shell",
      "group": { "kind": "test", "isDefault": true },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "make test",
      "problemMatcher": "$go"
    },
    {
      "label": "Kafka lite",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "./script/kafka-lite",
      "problemMatcher": "$go"
    }
  ]
}