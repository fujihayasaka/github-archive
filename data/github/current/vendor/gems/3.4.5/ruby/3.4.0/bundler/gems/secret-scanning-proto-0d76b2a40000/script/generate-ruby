#!/bin/bash
set -eu

IMAGE=secret-scanning-proto-generate-ruby

tar cf - \
    config/tools/generate-ruby \
	_template/ruby |
docker build -f config/tools/generate-ruby/Dockerfile -t ${IMAGE} -

docker run --rm \
	--net=none \
	-v $(pwd)/proto:/go/src/github.com/github/secret-scanning-proto/proto \
	-v $(pwd)/gen:/go/src/github.com/github/secret-scanning-proto/gen \
	${IMAGE}
