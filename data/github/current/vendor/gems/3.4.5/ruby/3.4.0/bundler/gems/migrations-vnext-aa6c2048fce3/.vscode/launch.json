  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch mvnworker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/mvnworker",
      "envFile": "${workspaceFolder}/script/env.out/mvnworker.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Launch mvndagworker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/mvndagworker",
      "envFile": "${workspaceFolder}/script/env.out/mvndagworker.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Launch archiveloader",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/archiveloader",
      "envFile": "${workspaceFolder}/script/env.out/archiveloader.env",
      "cwd": "${workspaceFolder}"
    }
  ]
}
