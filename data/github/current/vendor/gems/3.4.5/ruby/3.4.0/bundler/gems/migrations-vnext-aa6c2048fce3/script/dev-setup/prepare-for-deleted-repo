#!/bin/bash

# this script preseeds Redis to retry a migration where the repo on the target
# codespace has been deleted and deletes state

# GHES_URL is the GHES URL to fetch GHES resources via public API from
GHES_URL=${GHES_URL}

# GHES_TOKEN is the token to fetch GHES resources via public API
MIGRATE_REPO=${MIGRATE_REPO:=acme/smc}


if [ -z "$GHES_URL" ]; then
	echo "GHES_URL is empty"
	exit 1
fi

org="$(echo "$MIGRATE_REPO" | cut -d'/' -f1)"

rm -f resource-bf.bin
script/preseed-key-value "$GHES_URL/$org" --str $org
script/preseed-key-value "$GHES_URL/$org" --int64 156
