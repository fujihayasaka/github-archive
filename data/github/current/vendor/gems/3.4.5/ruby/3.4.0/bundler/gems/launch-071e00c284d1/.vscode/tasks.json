{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "script/build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$go"
            ]
        },
        {
            "label": "Lint",
            "type": "shell",
            "command": "script/lint"
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "script/test",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Register Delve",
            "type": "shell",
            "linux": {
                // Note that GOPATH may be a hierarchy of paths (colon-delimited on Linux).  We want only the first element.
                "command": "PRIMARY_GOPATH=`go env GOPATH | egrep -o '^[^:]+'` ; sudo setcap 'CAP_SYS_PTRACE=+ep CAP_DAC_READ_SEARCH=+ep' $PRIMARY_GOPATH/bin/dlv"
            },
            "osx": {
                "command": "echo Delve registration not required on MacOS"
            },
            "windows": {
                "command": "echo Delve registration not required on Windows"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup Test DB",
            "detail": "Run this first to allow debugging unit tests that use the database.",
            "type": "shell",
            "command": "script/setup-test-db-for-dev --force",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
