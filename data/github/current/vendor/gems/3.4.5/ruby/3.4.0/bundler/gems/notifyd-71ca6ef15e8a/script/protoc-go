#!/bin/bash

set -ue
cd "$(dirname "$0")/.."

protoc --proto_path=. \
  --go_out=./proto/ \
  --twirp_out=./proto/ \
	--go_opt=paths=import \
  proto/monolith-twirp/notifyd/v1/notifyd_api.proto

twirp_proto_paths=$(find ./proto/services -name "*.proto")

for twirp_proto_path in $twirp_proto_paths
do
  protoc \
      --proto_path=. \
      --go_out=. \
      --twirp_out=. \
      $twirp_proto_path
done

layout_proto_paths=$(find ./proto/layouts -name "*.proto")

for layout_proto_path in $layout_proto_paths
do
  protoc \
    --proto_path=. \
    --go_out=. \
    $layout_proto_path
done
