#!/bin/bash

set -xe

usage() {
  echo "Usage: $0 {run|test}"
}

# In dotcom Moda deploy, we start postgres DB as a sidecar container in pod
if [ -z "$POSTGRES_MODA_SIDECAR_ENABLED" ]; then
  service postgresql start
fi

case "$1" in
  run)
    bundle exec ruby -Ilib run.rb
    ;;
  test)
    createdb rubygems
    bundle exec ruby -Ilib -Itest test/*.rb
    ;;
  console)
    /bin/bash
    ;;
  *)
    usage
    exit 1
esac
