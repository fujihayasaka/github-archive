                      "index": 95
                    }
                  }
                }
              ],
              "message": {
                "text": ""
              },
              "level": "none",
              "descriptor": {
                "id": "js/diagnostics/test",
                "index": 0
              },
              "properties": {
                "visibility": {
                  "statusPage": true
                },
                "helpLinks": ["https://github.com"]
              }
            },
            {
              "locations": [
                {
                  "physicalLocation": {
                    "artifactLocation": {
                      "uri": "lib/repository.js",
                      "uriBaseId": "%SRCROOT%",
                      "index": 95
                    }
                  }
                }
              ],
              "message": {
                "text": "test plain text",
                "markdown": "test markdown"
              },
              "level": "none",
