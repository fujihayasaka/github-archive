{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "semanticVersion": "2.10.5",
          "rules": [],
          "notifications": [
            {
              "id": "js/diagnostics/test",
              "name": "js/diagnostics/test",
              "shortDescription": {
                "text": "Testy McTestFace"
              },
              "fullDescription": {
                "text": "Test full description text."
              },
              "defaultConfiguration": {
                "enabled": true
              },
              "properties": {
                "description": "Test description text",
                "id": "js/diagnostics/test",
                "kind": "diagnostic",
                "name": "Testy McTestFace"
              }
            },
            {
              "id": "js/baseline/test-2",
              "name": "js/baseline/test-2",
              "shortDescription": {
                "text": "Test 2 description"
              },
              "fullDescription": {
                "text": "Test 2 full description text."
              },
              "defaultConfiguration": {
                "enabled": true
              }
            }
          ],
          "organization": "GitHub"
        }
      },
      "automationDetails": {
        "id": ".github/workflows/codeql-analysis.yml:analyze/language:test/"
