#!/bin/bash
# script/setup: Set up application for the first time after cloning, or set it
#               back to the initial first unused state.

set -eou pipefail

cd "$(dirname "$0")/.."

if [ -z "${IN_TURBOSCAN_DEVCONTAINER-}" ] || [ "${IN_TURBOSCAN_CODESPACE-}" ]; then
	source script/bootstrap
	docker compose up --build --wait
fi

# Create S3/Azure buckets.
script/dev-run make -j2 buckets

# Skeema
echo "Bringing schema up to date with skeema"
script/db-migrate

# Set-up the Elasticsearch index
script/dev-run go run ./cmd/repo-indexer --autoUpgrade --skipRepoSync
