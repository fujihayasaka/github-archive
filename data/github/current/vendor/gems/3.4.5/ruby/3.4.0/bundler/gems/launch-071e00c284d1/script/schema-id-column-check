#!/usr/bin/env bash
#/ Usage: script/schema-id-column-check
#/ Performs a check against out defined schemas to see if any(*_)?id column is using an int datatype
#/ instead of a bigint - because Actions is Web Scale™️

set -o errexit
set -o nounset
set -o pipefail

test -z "${DEBUG:-}" || {
    set -x
}

function log() {
  printf '[%s] %s\n' "$(date -R)" "${1}"
}

status=0

for schema in $(find schemas -type f -name "*.sql" | sort); do
  if cat "${schema}" | egrep -i '_?id' | egrep -qi '\bint\(\d+\)'; then
    log "❌ ${schema} failed"
    status=1
    continue
  fi
  log "✅ ${schema} passed"
done

exit $status