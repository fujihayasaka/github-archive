#!/usr/bin/env bash

set -e

KUBE_NAMESPACE="hosted-compute-ims"

mkdir -p logs

deployments_raw=$(kubectl get deployments --namespace $KUBE_NAMESPACE --output custom-columns=":metadata.name" --no-headers)
deployments_list=($deployments_raw)
for deployment in "${deployments_list[@]}"; do
    kubectl logs deployment/$deployment --all-containers=true --namespace $KUBE_NAMESPACE > logs/$deployment.log
done