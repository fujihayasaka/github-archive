#!/bin/bash

# Check if all three arguments are provided
if [[ -z "$1" || -z "$2" || -z "$3" ]]; then
    echo "Usage: $0 <key> <--str|--int64> <value>"
    exit 1
fi

KEY="$1"
FLAG="$2"
VALUE="$3"

# Create a temporary file
TEMP_FILE=$(mktemp)
trap "rm -rf $TEMP_FILE" EXIT

# Write JSON content to the temp file based on the flag
if [[ "$FLAG" == "--str" ]]; then
    cat <<EOF > "$TEMP_FILE"
[ { "key": "$KEY", "value_string": "$VALUE" } ]
EOF
elif [[ "$FLAG" == "--int64" ]]; then
    cat <<EOF > "$TEMP_FILE"
[ { "key": "$KEY", "value_int64": $VALUE } ]
EOF
else
    echo "Usage: $0 <key> <--str|--int64> <value>"
    exit 1
fi

PRESEED_PATH="$TEMP_FILE" ./script/preseed --namespace "enterprise:4"
