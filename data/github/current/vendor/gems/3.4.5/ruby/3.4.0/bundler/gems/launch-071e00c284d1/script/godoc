#!/usr/bin/env bash
#/ Usage: script/godoc
#/
#/ This script starts a godoc server to view documentation

set -o errexit
set -o nounset
set -o pipefail

test -z "${DEBUG:-}" || {
    set -x
}

port=6060
addr=$(printf "http://127.0.0.1:%d" "$port")
godoc -http=":$port" &
godoc_pid="$!"
trap "kill -9 $godoc_pid" EXIT
sleep 1 #This allows Go some time to index/scan the source before opening up the browser

printf "Started godoc server with pid=%d\n" "$godoc_pid"
printf "View at %s\n" "$addr"
open "$addr/pkg/github.com/github/launch"
wait "$godoc_pid"