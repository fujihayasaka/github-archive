#! /usr/bin/env bash
#
#/ Usage script/generate-hmac-key
#/
#/ Generates a random Request HMAC key for blackbird-query service. These should be shared only in vault.
#/
#/ 1. Generate a key:
#/   script/generate-hmac-key
#/ 2. Set in vault (this value is a comma delimited list of keys to support rolling secrets):
#/   vault-secret -a blackbird-mw --key BLACKBIRD_MW_QUERY_SERVICE_HMAC_KEYS --prompt
#/ 3. Update the vault secrets for any blackbird query service clients.
printf "blk_query_%s_%s\n" $(date +%Y%m%d) $(openssl rand -hex 32)
