#!/bin/bash
if [[ -z "$1" || -z "$2" ]]; then
    echo "Usage: $0 <repo-id> <oid>"
    exit 1
fi


source script/env.d/spokes-check

export GITHUB_TELEMETRY_LOGS_CONSOLE_ENCODING=json

go run cmd/spokes-check/main.go --ca-chain "$SPOKESD_CA_CHAIN" --client-cert "$SPOKESD_CLIENT_CERT" --hmac-key "$SPOKESD_HMAC" --client-key "$SPOKESD_CLIENT_KEY" --spokes-url "$SPOKESD_URL" --repo-id "$1" --oid "$2"

