#!/bin/bash
#/ Usage: script/build <option>
#/
#/ Builds the authnd project. By default, this only includes the authnd server binary
#/
#/ Options:
#/ --all      Builds all binaries (CLI and utilities)
#/ --cli      Builds CLI tool
#/ --server   Builds the authnd server binary (default)

set -e

TARGET="api"

# allows deciding what to build, only server gets build by default
if [ $# -gt 0 ]; then
  case "$1" in
    --all)
      TARGET="all"
      shift ;;
    --cli)
      TARGET="cli"
      shift ;;
    --server)
      TARGET="api"
      shift ;;
    *)
      cat "$0" | grep ^#/ | cut -c4-
      exit 1 ;;
  esac
fi

echo "building authnd $TARGET..."
start=$(date +%s)
make $TARGET
end=$(date +%s)

echo "finished building authnd in $((end-start)) seconds"
