#!/bin/bash
# Usage: script/migrate-mysql
# Applies migrations and updates Skeema with the updated with the latest schema
# afterwards.
set -e

. script/_serverenv

echo "applying migrations for deployer"
migratorctl migrate deployer -d ${DEPLOYER_DATABASE_URL}

echo "applying migrations for payloads"
migratorctl migrate payloads -d ${PAYLOADS_DATABASE_URL}

script/skeema pull --ignore-schema ".*_test|launch_development|test_*"
