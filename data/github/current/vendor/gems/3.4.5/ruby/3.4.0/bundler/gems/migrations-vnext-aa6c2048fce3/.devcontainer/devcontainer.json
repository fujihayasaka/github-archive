{
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "golang.Go",
        "github.copilot"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/github/features/goproxy:1": {}
  },
  "forwardPorts": [],
  "hostRequirements": {
    "memory": "8gb",
    "storage": "32gb"
  },
  "image": "mcr.microsoft.com/devcontainers/go",
  "onCreateCommand": "/usr/local/share/goproxy-init.sh",
  "postStartCommand": "/usr/local/share/goproxy-init.sh --override"
}
