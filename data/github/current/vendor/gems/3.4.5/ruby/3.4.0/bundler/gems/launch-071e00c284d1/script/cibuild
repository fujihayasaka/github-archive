#!/bin/bash
# used by script/cibuild-launch

source script/cibuild-lib.sh

export SKIP_RACY_TESTS=1

run script/build
run script/test

run go tool cover -func=tmp/coverage.out

COVERAGE_TOTAL=$(go tool cover -func=tmp/coverage.out | grep "^total" | sed -e 's/[^0-9\.]*//g')
if [ "$(echo $COVERAGE_TOTAL | sed -e 's/\..*//')" -gt 10 ]; then
echo %%%HIGHLIGHT {success}%%%
else
echo %%%HIGHLIGHT {danger}%%%
fi
echo "total statement coverage of packages with tests: ${COVERAGE_TOTAL}%"
echo %%%END HIGHLIGHT%%%
