#!/bin/bash
#/ Usage: script/percent-incomplete-workflows HOUR_INTERVAL

set -e
set -o nounset
set -x

main() {
  . script/_serverenv
  bin/job-cli --interval "$hours"
}

hours=
while [ $# -gt 0 ]; do
  if [[ "$1" =~ ^[0-9]+$ ]]; then
    hours="$1"
    shift
  else
    echo Unrecognized argument: "$1"
    cat "$0" | grep ^#/ | cut -c4-
    exit 1
  fi
done

if [ -z "$hours" ]; then
  cat "$0" | grep ^#/ | cut -c4-
  exit 1
fi

main