<div data-form-group class="form-group position-relative m-0 <%= form_group_class %>" <%= "hidden" if hidden %> <%= safe_data_attributes(data) %>>
  <% if label_content? %>
    <div class="form-group-header">
      <%= label_content %>
    </div>
  <% end %>
  <div class="form-group-body">
    <%= content %>
    <%= render Primer::Beta::Spinner.new(size: :small, color: :muted, classes: "input-icon", data: { spinner: true }, hidden: true) %>
    <%= render IconComponent.new(icon: "check", color: :success, classes: "input-icon", data: { check: true }, hidden: true) %>
  </div>
  <p data-note class="note error" <%= "hidden" unless message %>>
    <button type="button" class="btn-icon note-close js-note-close btn-octicon float-right ml-2">
      <%= render IconComponent.new(icon: "x") %>
    </button>
    <span data-message><%= message %></span>
  </p>
</div>
