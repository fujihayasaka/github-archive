<form-table-row data-targets="form-table.rows" data-action="deleteRow:form-table#ensureVisibleRow" class="Box-row color-bg-subtle p-2 d-flex flex-items-center" <%= "#{test_selector(name.parameterize.gsub("_", "-"))}-row" if value? %>>
  <div class="flex-1 px-2">
    <input
      type="text"
      name="<%= name %>"
      value="<%= value %>"
      placeholder="<%= placeholder %>"
      autocomplete="off"
      class="form-control width-full color-bg-default"
      data-target="form-table-row.firstFocus"
      data-targets="form-table-row.inputs"
      <%= "disabled" if disabled? %>
      <%= test_selector(name.parameterize.gsub("_", "-")) %>
    >
  </div>
  <div class="flex-grow-0" <%= "hidden" if disabled? %>>
    <button data-action="click:form-table-row#delete" class="btn-octicon btn-octicon-danger mx-1" type="button" aria-label="Remove row" title="Remove row">
      <%= render IconComponent.new(icon: "trash") %>
    </button>
  </div>
</form-table-row>
