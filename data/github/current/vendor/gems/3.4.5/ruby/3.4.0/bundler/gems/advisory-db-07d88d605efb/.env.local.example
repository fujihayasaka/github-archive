# Follow the instructions below to set the variables

# General page of the app
# GITHUB_APP_ID=
# GITHUB_APP_NAME=
# GITHUB_APP_EMAIL=

# The webhook secret used by your app, configured by app owner on general page
# GITHUB_WEBHOOK_SECRET=

# Private key is downloaded from the app general page
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----"

# Visit /settings/apps/<your-app-name-here>/installations, click the wheel icon on your installation and pull the ID from the URL.
# GITHUB_APP_INSTALLATION_ID=

# The user/repo the app was installed to
# GITHUB_CVELIST_REPO=
# GITHUB_ADVISORIES_REPO=

# Mitre CVE API credentials
# CVE_API_KEY=
# CVE_API_USER=
# CVE_API_ORG=
# CVE_SERVICES_API_URL=http://cve_services:4000
# FEATURE_FLAG_CVE_AUTOMATIC_ASSIGNMENT=true
# FEATURE_FLAG_CVE_AUTOMATIC_RESERVATION=true
# FEATURE_FLAG_RUN_PUSH_ADVISORIES_TO_REPO_JOB=true

# See DependencyGraph::Client for info on using these. You can leave them blank
# in development until you need an active connection.
DEPENDENCY_GRAPH_API_HMAC_KEY=
DEPENDENCY_GRAPH_API_SLOW_QUERY_URL=
DEPENDENCY_GRAPH_API_TEMP_HMAC_TOKEN=
DEPENDENCY_GRAPH_API_URL=

# COPILOT API CREDENTIALS:
# CLIENT_SECRETS_ADVISORYDB_PREDICTOR_DEV=

# Chatops credentials
# CHATOPS_AUTH_PUBLIC_KEY=
