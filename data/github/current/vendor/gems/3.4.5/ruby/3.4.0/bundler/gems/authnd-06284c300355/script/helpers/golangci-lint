#!/usr/bin/env bash

set -eo pipefail

cd "$(dirname "$0")/../.."

working_directory=$(pwd)
go_mod_cache="/go/pkg/mod"
agent_go_mod_cache="$(pwd)/.go_mod_cache/go/pkg/mod"
go_lint_image="${DOCKER_REGISTRY}golangci/golangci-lint:latest"

echo "using golangci-lint docker image"
docker run --rm -t -e GOPRIVATE -e GOPROXY \
  -e "GOFLAGS=-buildvcs=false" \
  -v ${agent_go_mod_cache}:${go_mod_cache} \
  -v ${working_directory}:${working_directory} \
  -w ${working_directory} \
  ${go_lint_image} \
  golangci-lint run
