#!/bin/sh
# This script is used to wrap a job that is run under istio. It will shutdown the istio proxy
# before exiting. This allows the job to exit with the exit code from the command and not care
# about whether or not the job is running under istio.

"$@"
rc=$?

curl --fail \
	--silent \
	--show-error \
	--retry 3 \
	--head \
	--request POST \
	http://localhost:15020/quitquitquit > /dev/null || true

exit "$rc"
