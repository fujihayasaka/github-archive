{{define "primer"}}
  <!DOCTYPE html>
    <html lang="en">
      <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
        <meta name="viewport" content="width=device-width">
        <title>{{.Subject}}</title>
      </head>
      <body>
        <table align="center" class="container-md width-full" width="100%">
          <tr>
            <td class="center p-3" align="center" valign="top">
              <center>
                <!-- Header -->
                <!-- Mail::ContainerComponent.new(classes: "container-md") do -->
                <table border="0" cellspacing="0" cellpadding="0" align="center" class="container-md mb-2" width="100%">
                  <tr>
                    <td align="center">
                      <!-- Mail::SpacerComponent.new(size: 16) -->
                      <table>
                        <tbody>
                          <tr>
                            <td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td>
                          </tr>
                        </tbody>
                      </table>
                      <!-- content -->
                      <table border="0" cellspacing="0" cellpadding="0" align="left" width="100%">
                        <tr>
                          <td class="text-left">
                            <img src="https://github.githubassets.com/images/email/global/octocat-logo.png" alt="GitHub" width="32">
                            <h2 class="lh-condensed mt-2 text-normal">
                              {{.Subject}}
                            </h2>
                          </td>
                        </tr>
                      </table>
                      <!-- Mail::SpacerComponent.new(size: 16) -->
                      <table>
                        <tbody>
                          <tr>
                            <td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td>
                          </tr>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                </table>

                <!-- Body -->
                <table width="100%" class="width-full">
                  <tr>
                    <td class="border rounded-2 d-block">
                      <table class="width-full text-left">
                        <tr>
                          <td class="p-3 p-sm-4">
                            <!-- Mail::ContainerComponent.new -->
                            <table border="0" cellspacing="0" cellpadding="0" align="center" class="" width="100%">
                              <tr>
                                <td align="left">{{template "body" .}}</td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <!-- Footer -->
                <!-- ContainerComponent.new(classes: "text-center") -->
                <table border="0" cellspacing="0" cellpadding="0" align="center" class="text-center" width="100%">
                  <tr>
                    <td align="center">
                      <!-- Mail::SpacerComponent.new(size: 16) -->
                      <table>
                        <tbody>
                          <tr>
                            <td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td>
                          </tr>
                        </tbody>
                      </table>
                      <!-- content -->
                      <!-- footer links -->
                      <p class="f6"></p>
                      <!-- Mail::SpacerComponent.new(size: 16) -->
                      <table>
                        <tbody>
                          <tr>
                            <td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td>
                          </tr>
                        </tbody>
                      </table>
                      <!-- footer text -->
                      <p class="f5 text-gray-light">
                        You are receiving this email because you are subscribed to a repository label
                      </p>
                      {{if (ne .URL "") }}
                        <p class="f5 text-gray-light mb-0">
                          <a href="{{.URL}}">View on GitHub</a>
                        </p>
                      {{ end }}
                    </td>
                  </tr>
                </table>

                <!-- Footer mailing address-->
                <!-- ContainerComponent.new(classes: "text-center") -->
                <table border="0" cellspacing="0" cellpadding="0" align="center" class="text-center" width="100%">
                  <tr>
                    <td align="center">
                      <!-- Mail::SpacerComponent.new(size: 16) -->
                      <table>
                        <tbody>
                          <tr>
                            <td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td>
                          </tr>
                        </tbody>
                      </table>
                      <!-- content -->
                      <p class="f6 text-gray-light">GitHub, Inc. ・88 Colin P Kelly Jr Street ・San Francisco, CA 94107</p>
                    </td>
                  </tr>
                </table>
              </center>
            </td>
          </tr>
        </table>
        <!-- prevent Gmail on iOS font size manipulation -->
        <div style="display:none; white-space:nowrap; font:15px courier; line-height:0;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </div>
        {{if (ne .URL "") }}
          <script type="application/ld+json">
            [{
              "@context": "http://schema.org",
              "@type": "EmailMessage",
              "potentialAction": {
                "@type": "ViewAction",
                "target": {{.URL}},
                "url": {{.URL}},
                "name": "View on GitHub"
              },
              "description": "View on GitHub",
              "publisher": {
                "@type": "Organization",
                "name": "GitHub",
                "url": "https://github.com"
              }
            }]
        </script>
      {{end}}
      </body>
  </html>
{{end}}
