<% content_for :breadcrumbs do %>
  <%= render "breadcrumbs", advisory_review: advisory_review %>
<% end %>

<header class="pagehead border-bottom pb-3 mb-4">
  <h1 class="mb-2 lh-condensed text-normal" <%= test_selector("review-title") %>>Create an advisory review</h1>
</header>

<% if advisory_review.errors.any? || advisory_payload.errors.any? %>
  <%= render Primer::Beta::Flash.new(scheme: :danger, icon: "hubot", spacious: true, test_selector: "flash-error") do %>
    The advisory review could not be created. See details below.
    <% if advisory_review.errors.include?(:base) || advisory_payload.errors.include?(:base) %>
      <ul class="list-style-none ml-5">
        <% advisory_review.errors.full_messages_for(:base).each do |message| %>
          <li><%= message %></li>
        <% end %>
        <% advisory_payload.errors.full_messages_for(:base).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>

<%= render Primer::Alpha::Layout.new(first_in_source: :main) do |layout| %>
  <% layout.with_sidebar(col_placement: :end) do %>
    <div class="position-sticky top-0 mt-n4 pt-4">
      <%= render(Primer::ButtonComponent.new(
        type: :submit,
        form: "advisory-review-form",
        display: :flex,
        align_items: :center,
        mb: 2,
        classes: "btn-large width-full",
        test_selector: "advisory-review-sidebar-button"
      )) do %>
        <%= render IconComponent.new(icon: "plus", mr: 3) %>
        Create advisory review
      <% end %>
    </div>
  <% end %>

  <% layout.with_main do %>
    <%= render AdvisoryReviews::FormComponent.new(advisory_review: advisory_review, advisory_payload: advisory_payload) %>
  <% end %>
<% end %>
