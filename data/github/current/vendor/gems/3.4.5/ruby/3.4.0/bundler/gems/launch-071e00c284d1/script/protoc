#!/bin/bash

NO_BUILD=${NO_BUILD:-}

set -e
set -o nounset

IMAGE=launch-protoc

if [[ -z $NO_BUILD ]]; then
  tar cf - \
    config/tools/protoc \
    Gemfile Gemfile.lock github-launch.gemspec ruby/lib |
    docker build -f config/tools/protoc/Dockerfile -t ${IMAGE} -
fi

docker run --rm \
  --net=none \
  -v $(pwd)/proto:/go/src/github.com/github/launch/proto \
  -v $(pwd)/ruby/proto:/go/src/github.com/github/launch/ruby/proto \
  -v $(pwd)/services:/go/src/github.com/github/launch/services \
  -v $(pwd)/pkg:/go/src/github.com/github/launch/pkg \
  ${IMAGE}
