{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Skaffold Debug (api-server)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "host": "localhost",
            "port": 56201,
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/go/src/app",
                },
            ],
            "dlvLoadConfig": {
                "followPointers": true,
                "maxVariableRecurse": 1,
                "maxStringLen": 1000,
                "maxArrayValues": 64,
                "maxStructFields": -1
            }
        },
    ]
}