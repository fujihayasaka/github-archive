#!/usr/bin/env bash

help="Usage: $0 [options]

Sends an invoice generation request to the Aqueduct job queue which will be picked up by the request handler.
Both a year and month must be provided, all other options are optional.

Options
  -a  Aqueduct application name
  -q  Aqueduct queue name
  -u  Aqueduct URL
  -c  Customer ID
  -p  Period
  -y  Year
  -m  Month
"

# Make sure arguments are provided
if [ $# -eq 0 ]; then
    >&2 echo -e "$help"
    exit 1
fi

# Set the default values
app="billing-platform-development"
queue="request-handler"
url="http://localhost:18081"
customer=""
period=""
year="0"
month="0"

# Parse the command-line options
while getopts ":a:q:u:c:p:y:m:" opt; do
    case $opt in
        a)
        app="$OPTARG"
        ;;
        q)
        queue="$OPTARG"
        ;;
        u)
        url="$OPTARG"
        ;;
        c)
        customer="$OPTARG"
        ;;
        p)
        period="$OPTARG"
        ;;
        y)
        year="$OPTARG"
        ;;
        m)
        month="$OPTARG"
        ;;
        \?)
        echo "$help"
        exit 1
        ;;
    esac
done

# Make sure year and month are provided
if [ "$year" == "0" ] || [ "$month" == "0" ]; then
    >&2 echo -e "Both a year and month must be provided"
    exit 1
fi

# Create the payload
request_type="schedule-invoice-generation"
data="{\"CustomerId\":\"$customer\",\"Period\":\"$period\",\"Year\":$year,\"Month\":$month}"
payload="{\"Type\":\"$request_type\",\"Data\":$data}"
hashed_payload=$(echo -n "$payload" | base64 | tr -d '[:space:]')

# Send the payload to the job queue
curl \
     --header "Content-Type:application/json" \
     --data '{"app": "'$app'", "queue":"'$queue'", "payload":"'$hashed_payload'"}' \
     "$url/twirp/aqueduct.api.v1.JobQueueService/Send"

# New line after the curl response
echo