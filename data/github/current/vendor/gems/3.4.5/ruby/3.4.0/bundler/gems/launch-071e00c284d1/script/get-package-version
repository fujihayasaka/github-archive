#!/bin/bash
#/ Usage: script/get-package-version GOPKG...
# This is not the most robust script to errors, but the go.mod format
# seems relatively usable at least.

usage() {
  cat "$0" | grep ^#/ | cut -c4-
}

main() {
  if [ $# -lt 1 ]; then
    usage 1>&2
    exit 1
  fi
  for pkg; do
    show $pkg
  done
}

show() {
  printf "%s %s\n" \
    "$(cat "$(git rev-parse --show-toplevel)/go.mod" | \
      grep "\t$1" | \
      cut -d ' ' -f 2)" \
    "$1"
}

main "$@"
