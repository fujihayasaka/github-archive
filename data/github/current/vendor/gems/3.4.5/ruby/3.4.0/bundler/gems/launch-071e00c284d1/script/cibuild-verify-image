#!/bin/bash
# used by the "launch-build-docker-image" build to verify that our prod
# docker image has all of its binaries.

if test -z "$DOCKER_IMAGE"; then
  echo "Please define the DOCKER_IMAGE variable and try again."
  exit 1
fi

ok=true
for c in launch-chatops launch-deployer launch-hydro-consumer launch-receiver job-cli migratorctl sleeper; do
  docker run --rm "$DOCKER_IMAGE" "$c" -version
  if [ $? -ne 0 ]; then
    echo Error verifying $c
    ok=false
  fi
done

if ! ls -l /etc/ssl/certs/ca-certificates.crt; then
  ok=false
fi

if ! ls -ld /tmp; then
  ok=false
fi

$ok
