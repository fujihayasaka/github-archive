#!/usr/bin/env bash

# Script that will bootstrap the github/github Codespaces environment to run the dependency-graph-api project.

set -e

cd "$(dirname "$0")/.."
source script/_env

DEBIAN_FRONTEND=noninteractive sudo apt-get -y install shellcheck

if command -v rbenv; then
  rbenv install -s
else
  echo "Unable to install Ruby. Please install rbenv and run 'rbenv install' to install the correct version of Ruby."
  exit 1
fi

sudo apt install -y acl
setfacl -bnR /workspaces/dependency-graph-api
chmod -R '=rwX' /workspaces/dependency-graph-api

go install github.com/twitchtv/twirp/protoc-gen-twirp@v8.1.0
go install github.com/arthurnn/twirp-ruby/protoc-gen-twirp_ruby@v1.11.0
