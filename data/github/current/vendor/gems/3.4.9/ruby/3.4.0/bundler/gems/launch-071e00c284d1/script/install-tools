#!/bin/bash
# Installing development related tools
# See https://github.com/github/go/blob/main/docs/tools.md
set -e

OS=$(uname)
ARCH=$(uname -m)
MOCKERY_VERSION=2.45.1

bin=$(go env GOBIN)
if [ -z "${bin}" ]; then
    bin="$(go env GOPATH)/bin"
fi

curl --location --silent -o mockery.tar.gz https://github.com/vektra/mockery/releases/download/v${MOCKERY_VERSION}/mockery_${MOCKERY_VERSION}_${OS}_${ARCH}.tar.gz &&
    sudo tar xzf mockery.tar.gz -C "$bin" &&
    rm -fr mockery.tar.gz

go install github.com/ddollar/forego@20180216151118
