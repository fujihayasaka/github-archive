{
  "name": "github/launch",
  "image": "ghcr.io/github/codespaces-base/codespaces-base:latest",
  "runArgs": ["--privileged", "--security-opt", "seccomp=unconfined"],
  "overrideCommand": false,
  "hostRequirements": {
    "storage": "64gb",
    "memory": "64gb"
  },
  "features": {
    "ghcr.io/github/features/goproxy:1": {}, // https://github.com/github/features/tree/main/src/goproxy
    "ghcr.io/mickeahlinder/devcontainer-features/tfenv:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "onCreateCommand": ".devcontainer/script/on-create-command.sh",
  "postCreateCommand": ".devcontainer/script/post-create-command.sh",
  "postStartCommand": ".devcontainer/script/post-start-command.sh",
  "customizations": {
    "codespaces": {
      "repositories": {
        // Required for goproxy
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "golang.go",
        "mutantdino.resourcemonitor",
        "HashiCorp.terraform"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/vendor": true,
          "**/.git": true,
          "**/tmp": true
        }
      }
    }
  }
}