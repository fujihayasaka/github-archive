# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
*.swp

# Ignore helper executables compiled into root directory.
/gomod2json
/gooneoff

# Ignore Byebug command history file.
.byebug_history

# Ignore data dumps
/*.sql
/*.sql.gz
/dumps/*.sql
/dumps/*.sql.gz

# generated by script/resolve-dependencies
go/.goproxytoken

# generated by script/bootstrap
config/dev/nginx.conf
Brewfile.lock.json
vendor/gems/
vendor/cache/ruby-tree-sitter-*

vendor/cache/*-darwin.gem

config/database.json
data/
*.pid
node_modules
tags
*.pyc
__pycache__
.py*
.cache

# generated by terraform
.terraform/
*.terraform.lock.*

# generated by RubyMine
.idea/
.DS_Store

# codespace-compose lockfile
.codespace-compose.yml.lock

# simplecov
/coverage

# Build secrets (contain sensitive data in production)
apt-auth-conf
pkg-mirror-host
