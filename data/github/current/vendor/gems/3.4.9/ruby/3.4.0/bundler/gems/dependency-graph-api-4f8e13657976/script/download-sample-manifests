#! /usr/bin/env ruby

# This script is used to download all the blobs from a given CSV file.
# The CSV file should be generated by a datadot query like:
#
#   SELECT repository_owner, repository_name, blob_oid
#   FROM hive.suez.metadata_current
#   WHERE filename = 'Package.resolved' AND repository_visibility = 'PUBLIC'
#   ORDER BY RAND()
#   LIMIT 1000;
#
# (see this example: https://data.githubapp.com/sql/share/d07612d4)
#
# NOTE: the CSV file is expected to have a header and the following columns:
#  - repository_owner
#  - repository_name
#  - blob_oid
#
# This will be the case if you use the above query.

require "csv"

def main
  csv_path = ARGV[0]
  if csv_path.nil?
    die! "Usage: script/download-sample-manifests <csv-path> [directory]"
  end
  csv_path = File.expand_path(csv_path)

  dest_dir = ARGV[1] || "sample-manifests"
  destination = File.expand_path(dest_dir)
  env_check!(destination)

  rows = load_csv(csv_path)
  puts "Downloading #{rows.length} blobs to #{destination}"
  rows.each do |row|
    owner = row[:owner]
    repo = row[:name]
    oid = row[:oid]
    download_blob(owner, repo, oid, destination)
    print "."
  end
  puts "\nDone!"
end

def die!(msg)
  $stderr.puts msg
  exit 1
end

def confirm_installed!(cmd)
  unless system("which #{cmd} > /dev/null")
    die! "Please install `#{cmd}`"
  end
end

def env_check!(destination)
  confirm_installed! "gh"
  confirm_installed! "jq"
  confirm_installed! "base64"
  File.directory?(destination) || Dir.mkdir(destination)
end

def download_blob(owner, repo, oid, dest_dir)
  `gh api \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    /repos/#{owner}/#{repo}/git/blobs/#{oid} \
    | jq .content -r | base64 -d \
    > #{dest_dir}/#{owner}_#{repo}_#{oid}`
  if $?.exitstatus != 0
    die! "Failed to download blob #{owner}/#{repo}/#{oid}"
  end
end

def format_csv_row(row)
  ["repository_owner", "repository_name", "blob_oid"].each do |key|
    if row[key].nil? || row[key].empty?
      die! "CSV row is missing key #{key}"
    end
  end
  {
    owner: row["repository_owner"],
    name: row["repository_name"],
    oid: row["blob_oid"]
  }
end

def load_csv(path)
  rows = []
  File.open(path) do |f|
    CSV.parse(f, headers: true) do |row|
      rows.push(format_csv_row(row))
    end
  end
  rows
end

main
