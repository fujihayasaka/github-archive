#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

#  attempts to find todos in the following format
#
#  //todo
#  //todo(foo)
#  //todo (foo)
#  // todo
#  // todo(foo)
#  // todo (foo)
#
todos=$(find . -type f -name '*.go' | xargs grep -inE '\/\/\s?todo(\s?\([^)]+\))?' | sort)
count=$(echo "${todos}" | sed '/^$/d' | wc -l | xargs)

if [ "${count}" != "0" ]; then
    printf "📝 There are %d todos:\n" "${count}"
    echo "\n${todos}"
    exit 1
fi

echo "🎉 There are ZERO todos!\n"
