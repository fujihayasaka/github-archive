{
  "$schema" : "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version" : "2.1.0",
  "runs" : [ {
    "tool" : {
      "driver" : {
        "name" : "CodeQL",
        "organization" : "GitHub",
        "semanticVersion" : "2.4.1",
        "rules" : [ {
          "id" : "test/error-critical",
          "name" : "test/error-critical",
          "shortDescription" : {
            "text" : "Error: Critical"
          },
          "fullDescription" : {
            "text" : "Error: Critical"
          },
          "defaultConfiguration" : {
            "level" : "error"
          },
          "properties" : {
            "problem.severity" : "error",
            "security-severity" : "9.0"
          }
        }, {
          "id" : "test/error-high",
          "name" : "test/error-high",
          "shortDescription" : {
            "text" : "Error: High"
          },
          "fullDescription" : {
            "text" : "Error: High"
          },
          "defaultConfiguration" : { 
            "level" : "error"
          },
          "properties" : {
            "problem.severity" : "error",
            "security-severity" : "7.0"
          }
        }, {
            "id" : "test/warning-medium",
            "name" : "test/warning-medium",
            "shortDescription" : {
              "text" : "Warning: Medium"
            },
            "fullDescription" : {
              "text" : "Warning: Medium"
            },
            "defaultConfiguration" : { },
            "properties" : {
              "problem.severity" : "warning",
              "security-severity" : "4.0"
            }
        }, {
            "id" : "test/warning-low",
            "name" : "test/warning-low",
            "shortDescription" : {
              "text" : "Warning: Low"
            },
            "fullDescription" : {
              "text" : "Warning: Low"
            },
            "defaultConfiguration" : { 
              "level" : "warning"
            },
            "properties" : {
              "problem.severity" : "warning",
              "security-severity" : "1.0"
            }
        }, {
            "id" : "test/note-none",
            "name" : "test/note-none",
            "shortDescription" : {
              "text" : "Note: None"
            },
            "fullDescription" : {
              "text" : "Note: None"
            },
            "defaultConfiguration" : { 
              "level" : "note"
            },
            "properties" : {
              "problem.severity" : "note"
            }
        } ]
      }
    },
