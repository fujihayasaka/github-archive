{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
      {
        "tool": {
          "driver": {
            "name": "CodeQL",
            "organization": "GitHub",
            "semanticVersion": "2.14.2",
            "notifications": [
              {
                "id": "py/diagnostics/recursion-error",
                "name": "py/diagnostics/recursion-error",
                "shortDescription": {
                  "text": "Recursion error in Python extractor"
                },
                "fullDescription": {
                  "text": "Recursion error in Python extractor"
                },
                "defaultConfiguration": {
                  "enabled": true
                }
              },
              {
                "id": "ruby/parse-error",
                "name": "ruby/parse-error",
                "shortDescription": {
                  "text": "Could not process some files due to syntax errors"
                },
                "fullDescription": {
                  "text": "Could not process some files due to syntax errors"
                },
                "defaultConfiguration": {
                  "enabled": true
                }
              }
            ],
            "rules": []
          }
        },
        "invocations": [
          {
            "toolExecutionNotifications": [
              {
                "locations": [
                  {
                    "physicalLocation": {
                      "artifactLocation": {
                        "uri": "test-root-directory/repo_dir/recursion_error.py",
                        "uriBaseId": "%SRCROOT%",
                        "index": 0
                      }
                    }
                  }
                ],
                "message": {
                  "text": "maximum recursion depth exceeded while calling a Python object"
                },
                "level": "error",
                "timeUtc": "2023-03-13T15:03:47.468+00:00",
                "descriptor": {
                  "id": "py/diagnostics/recursion-error",
                  "index": 0
                },
                "properties": {
                  "attributes": {
                    "args": [
                      "maximum recursion depth exceeded while calling a Python object"
                    ],
                    "traceback": [
                      "line1",
                      "line2",
                      "line3"
                    ]
                  },
                  "visibility": {
                    "statusPage": false,
                    "telemetry": true
                  }
                }
              },
              {
                "locations": [
                  {
                    "physicalLocation": {
                      "artifactLocation": {
                        "uri": "test-root-directory/bad.rb",
                        "uriBaseId": "%SRCROOT%",
                        "index": 1
                      },
                      "region": {
                        "startLine": 1,
                        "startColumn": 4,
                        "endColumn": 6
                      }
                    }
                  }
                ],
                "message": {
                  "text": "A parse error occurred. Check the syntax of the file. If the file is invalid, correct the error or [exclude](https://docs.github.com/en/code-security/code-scanning/automatically-scanning-your-code-for-vulnerabilities-and-errors/customizing-code-scanning) the file from analysis.",
                  "markdown": "A parse error occurred. Check the syntax of the file. If the file is invalid, correct the error or [exclude](https://docs.github.com/en/code-security/code-scanning/automatically-scanning-your-code-for-vulnerabilities-and-errors/customizing-code-scanning) the file from analysis."
                },
                "timeUtc": "1970-01-01T00:00:00.000+00:00",
                "descriptor": {
                  "id": "ruby/parse-error",
                  "index": 1
                },
                "properties": {
                  "helpLinks": [
                    "https://docs.github.com/en/code-security/code-scanning/automatically-scanning-your-code-for-vulnerabilities-and-errors/customizing-code-scanning"
                  ],
                  "visibility": {
                    "statusPage": false,
                    "telemetry": true
                  }
                }
              }
            ],
            "executionSuccessful": false
          }
        ],
        "artifacts": [
          {
            "location": {
              "uri": "test-root-directory/repo_dir/recursion_error.py",
              "uriBaseId": "%SRCROOT%",
              "index": 0
            }
          },
          {
            "location": {
              "uri": "test-root-directory/bad.rb",
              "uriBaseId": "%SRCROOT%",
              "index": 1
            }
          }
        ],
        "results": [],
        "newlineSequences": [
          "\r\n",
          "\n",
          "\u2028",
          "\u2029"
        ],
        "automationDetails": {
          "id": ".github/workflows/codeql-analysis.yml:analyze/language:python"
        },
        "columnKind": "utf16CodeUnits",
        "properties": {
          "jobRunUuid": "test-job-run-uuid",
          "semmle.formatSpecifier": "sarifv2.1.0"
        }
      }
    ]
  }