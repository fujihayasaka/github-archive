#!/bin/bash
# Usage: script/migrate-mysql-setup
# Creates initial databases as necessary
# afterwards.
set -e

. script/_serverenv

base_database_url="${BASE_DATABASE_URL}/"
echo "creating database for deployer"
migratorctl setup --name ${DEPLOYER_DATABASE_NAME} --url $base_database_url

echo "creating database for payloads"
migratorctl setup --name ${PAYLOADS_DATABASE_NAME} --url $base_database_url
