#!/bin/bash

set -e

cd "$(dirname "$0")/.."

PACKAGE_MANAGER=$1

usage() {
  echo "Usage: script/status PACKAGE_MANAGER"
  echo
  echo "Print package manager adapter status"
}

. script/utils

validate

CONTAINER_ID=$(docker ps --filter name=$(container-name) -q)

if [ -z ${CONTAINER_ID-} ]; then
  echo "$PACKAGE_MANAGER adapter is not running"
  echo "Check logs with 'docker logs package-adapters-$PACKAGE_MANAGER'"
  exit 1
else
  echo "$PACKAGE_MANAGER adapter running with container ID $CONTAINER_ID"
  exit 0
fi
