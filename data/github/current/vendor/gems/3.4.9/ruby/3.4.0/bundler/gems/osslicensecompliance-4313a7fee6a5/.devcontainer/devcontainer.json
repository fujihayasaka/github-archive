{
  "name": "default",
  "image": "mcr.microsoft.com/devcontainers/base:focal",
  "hostRequirements": {
    "cpus": 16,
    "memory": "32gb",
    "storage": "64gb"
  },
  "remoteEnv": {
    "OLC_DEVCONTAINER": "true"
  },
  "remoteUser": "root",
  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "features": {
    "ghcr.io/github/features/goproxy:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2.7.1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": true
    },
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/github/features/dev-vpn:1": {},
    "ghcr.io/github/features/timezone:1": {
      "timezone": "America/Los_Angeles"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "onCreateCommand": ".devcontainer/on-create-command.sh",
  "postCreateCommand": ".devcontainer/post-create-command.sh",
  "postAttachCommand": ".devcontainer/post-attach-command.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.codespaces",
        "EditorConfig.EditorConfig",
        "github.vscode-github-actions",
        "golang.go",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go"
      }
    },
    "codespaces": {
      "repositories": {
        "github/features": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/hydro-schemas": {
          "permissions": {
            "contents": "read",
            "packages": "read",
            "pull_requests": "write"
          }
        },
        "github/gh-kustomize": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        // Not all tools support the wildcard auth here, so individual access is still needed as above,
        // but this is convenient for building locally since it will grant Goproxy access to all packages in the GitHub org
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      }
    }
  }
}
