default-character-set=latin1
default-collation=latin1_swedish_ci
flavor=mysql:8.0
# tables to be globally ignored in all schemas
ignore-table=authentication_key_values|integration_installations|oauth_accesses|oauth_applications|organization_credential_authorizations|public_keys|user_sessions|users

###############################
######### DEVELOPMENT #########
###############################
# Development on a local dev's box
[development]
schema=github_development_authnd
host=localhost
port=3001
user=root

# Development against mysql default port
[development-default-port]
schema=github_development_authnd
host=localhost
port=3306
user=root

# Tests, run on a local dev's box
[test]
schema=github_test_authnd
host=localhost
port=3001
user=root

# Tests against mysql default port for local dev and codespaces testing
[test-default-port]
schema=github_test_authnd
host=localhost
port=3306
user=root

# Tests, run in CI (where they have to run in a container)
[test-ci]
schema=github_test_authnd
host=db
port=3306
user=root

[skeema-diff-ci]
schema=skeema:authnd_production

###############################
########### PROXIMA ###########
###############################

# Tests, run on a local dev's box
[test-proxima]
schema=github_test_proxima_authnd
host=localhost
port=3001
user=root

# Tests against mysql default port
[test-default-port-proxima]
schema=github_test_proxima_authnd
host=localhost
port=3306
user=root

# Tests, run in CI (where they have to run in a container)
[test-ci-proxima]
schema=github_test_proxima_authnd
host=db
port=3306
user=root

###############################
######### PRODUCTION ##########
###############################

# This environment is for automatic skeefree schema changes run in ci for the production cluster, used in the authnd production environment
[production]
flavor=mysql:8.0
host=db-mysql-authnd-rw.service.github.net
port=3306
user=authnd_production_rw_1
schema=authnd_production
workspace=docker

###############################
########## DOTCOM CI ##########
###############################

# In order to support sharded test databases in Dotcom, we need to be able to seed schemas
# into the github_test_authnd[1:15] and github_test[1:15] schemas.
# This environment variable templated config allows us to dynamically inject the
# database name based on the db configuration present in Dotcom CI.
#
# NOTE(chriskirkland): requires skeema v1.9.0 or newer to support environment variable templating

[dotcom_ci_test]
schema=$AUTHND_TEST_SCHEMA
host=localhost
port=3306
user=root