#!/usr/bin/env bash
set -e

dir=$(dirname $0)

AZURE_TENANT="${AZURE_TENANT:=398a6654-997b-47e9-b12b-9515b896b4de}"               # GITHUB INC
AZURE_SUBSCRIPTION="${AZURE_SUBSCRIPTION:="6cce5ec9-a487-4144-be96-f1a8f55ace8f"}" # GitHub - NonProd - actions-usage-metrics-nonprod

while [[ $# -gt 0 ]]; do
  case $1 in
  --tenant)
    shift
    AZURE_TENANT="$1"
    shift
    ;;
  -* | --*)
    echo "Unknown option $1"
    exit 1
    ;;
  esac
done

# az login if not yet logged in
if ! az account show -o none; then
  echo "🔑 Logging in to Azure..."
  az config set core.login_experience_v2=off # disable the subscription selector (v. 2.61.0 and up)
  az login --tenant "$AZURE_TENANT" -o none --use-device-code
  az account set --subscription "$AZURE_SUBSCRIPTION"
fi

$dir/ensure-az-mount
