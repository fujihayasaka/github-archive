#!/bin/bash

# Get absolute path of this script
script_dir=$(dirname "$(readlink -f "$0")")

feature_flags=$(jq -r '.[]' "$script_dir/feature-flags.json")
feature_flags_args=()

for flag in ${feature_flags[@]}; do
    feature_flags_args+=" -F $flag"
done

bin/toggle-feature-flag enable ${feature_flags_args[@]}
