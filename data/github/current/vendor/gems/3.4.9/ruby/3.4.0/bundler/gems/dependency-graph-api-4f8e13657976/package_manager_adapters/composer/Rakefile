#!/usr/bin/env rake

require "rake/testtask"
require_relative "lib/composer_importer"


Rake::TestTask.new do |t|
  t.libs << "test"
  t.test_files = FileList["test/*_test.rb"]
  t.warning = false
end

task default: :test

task :run do
  Composer.run_importer
end

task :full_import do
  Composer.run_importer(full_import: true)
end
