#!/usr/bin/env bash

help="Usage: $0 [options]

Sends an Azure emission request to the Aqueduct job queue which will be picked up by the request handler.

Options
  -a  Aqueduct application name
  -q  Aqueduct queue name
  -u  Aqueduct URL
  -y  Year
  -m  Month
  -d  Day
"

# Set the default values
app="billing-platform-development"
queue="request-handler"
url="http://localhost:18081"
year="0"
month="0"
day="0"

# Parse the command-line options
while getopts ":a:q:u:y:m:d:" opt; do
    case $opt in
        a)
        app="$OPTARG"
        ;;
        q)
        queue="$OPTARG"
        ;;
        u)
        url="$OPTARG"
        ;;
        y)
        year="$OPTARG"
        ;;
        m)
        month="$OPTARG"
        ;;
        d)
        day="$OPTARG"
        ;;
        \?)
        echo "$help"
        exit 1
        ;;
    esac
done

# Make sure year, month and day are provided
if [ "$year" == "0" ] || [ "$month" == "0" ] || [ "$day" == "0" ]; then
    >&2 echo -e "Year, month and day must be provided"
    exit 1
fi

# Create the payload
request_type="schedule-azure-emission"
data="{\"Year\":$year,\"Month\":$month,\"Day\":$day}"
payload="{\"Type\":\"$request_type\",\"Data\":$data}"
echo "Payload: $payload"
hashed_payload=$(echo -n "$payload" | base64 | tr -d '[:space:]')

# Send the request to the job queue
curl \
     --header "Content-Type:application/json" \
     --data '{"app": "'$app'", "queue":"'$queue'", "payload":"'$hashed_payload'"}' \
     "$url/twirp/aqueduct.api.v1.JobQueueService/Send"

# New line after the curl response
echo
