<% content_for :breadcrumbs do %>
  <%= render "breadcrumbs", advisory_review: advisory_review %>
<% end %>
<% content_for :navigation do %>
  <%= render "navigation", advisory_review: advisory_review %>
<% end %>

<% if diff.diff.present? %>
  <div class="diff-container diff-container-full border rounded-2 color-bg-subtle">
    <%= diff.to_s.html_safe %>
  </div>
<% else %>
  <%= render(Primer::BlankslateComponent.new) { "This advisory review matches the published advisory." } %>
<% end %>
