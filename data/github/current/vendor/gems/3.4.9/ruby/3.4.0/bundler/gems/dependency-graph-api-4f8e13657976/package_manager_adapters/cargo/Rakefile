#!/usr/bin/env rake

require "rake/testtask"

require_relative "lib/cargo_importer"

Rake::TestTask.new do |t|
  t.libs << "test"
  t.test_files = FileList["test/*_test.rb"]
  t.warning = false
end

task default: :test

task :run do
  Cargo.run_importer
end

task :full_import do
  Cargo.run_importer(full_import: true)
end

task :restart_publish, [:from_version_id] do |task, args|
  Cargo.run_importer(full_import: true, from_version_id: args[:from_version_id].to_i)
end
