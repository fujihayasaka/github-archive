default-character-set=utf8mb4
default-collation=utf8mb4_general_ci
flavor=mysql:8.0
lax-column-order

host=localhost
user=root

[development]
schema=turboscan_development_ks@master
port=13307

[development_without_vitess]
schema=turboscan_development
port=13806

[test]
schema=turboscan_test_ks@master
host=localhost
port=13307

[test_without_vitess]
schema=turboscan_test
port=13806

[enterprisetest]
schema=enterprise_test
port=13806

[production]
schema=turboscan_ks@master
port=3306
user=turboscan_rw
host=localhost

[proxima]
schema=turboscan
port=3306
user=turboscan
host=localhost

[skeema-diff-ci]
host=127.0.0.1
port=3306
user=root
schema=skeema:turboscan_ks

[enterprise]
schema=github_enterprise
port=3307
user=github
