#!/usr/bin/env bash

# Before landing breaking changes, please update the README documentation!

set -euo pipefail

echo ">>> Setting up version for generated code..."
if [ $# -eq 1 ]; then
  # use passed in version if provided
  VERSION=$1
elif [ -f "./proto/oss_license_compliance/v0/VERSION" ]; then
  # extract version from VERSION file if it exists
  VERSION=$(sed -n 's/.*VERSION *= *["'\'']\([^"\'']*\)["'\''].*/\1/p' ./proto/oss_license_compliance/v0/VERSION)
  if [ -z "$VERSION" ]; then
    echo "VERSION is required, but not found in ./proto/oss_license_compliance/v0/VERSION"
    exit 1
  fi
  REUSING_VERSION=True
else
  # stop if no version specified or extracted
  echo "VERSION is required, but missing.  This is not expected to happen as a version should always be defined in \`./proto/oss_license_compliance/v0/VERSION\`"
  echo "Options:"  
  echo " - Specify the version when you run this script using \`make proto VERSION=1.0.0\` (For local testing only.)"
  echo " - Set the version in \`./proto/oss_license_compliance/v0/VERSION\` (Required for CI generation.)"
  exit 1
fi

MAJOR_VERSION="$(echo "$VERSION" | cut -d '.' -f 1)"

echo ">>>    Full version:  $VERSION"
echo ">>>    Major version: $MAJOR_VERSION"
echo ">>> DONE Setting up version for generated code"
echo


# The local osslicensecompliance checkout root
REPO_ROOT=$(realpath .)

# Input: protobuf spec file trees
PROTO_BASE="${REPO_ROOT}/proto"
mkdir -p "${PROTO_BASE}"

# Output: OLC generated protobuf code will live
echo ">>> Re-setting output directories"
RUBY_GEN_BASE="${REPO_ROOT}/ruby/lib"
rm -rf "${RUBY_GEN_BASE}"
mkdir -p "${RUBY_GEN_BASE}"

GO_GEN_BASE="${REPO_ROOT}/pkg"
rm -rf "${GO_GEN_BASE}"
mkdir -p "${GO_GEN_BASE}"

DOC_GEN_FILE="${REPO_ROOT}/proto/README.md"
rm -f "${DOC_GEN_FILE}"
echo ">>> DONE -- Resetting output directories"
echo

# Build the code gen tools image
echo ">>> Building Dockerfile-gen into image olc_protogen"
docker build -f Dockerfile-gen -t olc_protogen .
echo ">>> DONE -- Building Dockerfile-gen into image olc_protogen"
echo

# Run a container of the generated image, mounting the local in/out dirs
echo ">>> Running docker image olc_protogen to generate code"
docker run --rm \
    -e VERSION="$VERSION" \
    -e MAJOR_VERSION="$MAJOR_VERSION" \
    -v "${PROTO_BASE}":/proto \
    -v "${RUBY_GEN_BASE}":/ruby/lib \
    -v "${GO_GEN_BASE}":/pkg \
    olc_protogen
echo ">>> DONE -- Running olc_protogen to generate code"
echo

if [ "${REUSING_VERSION:-}" != "True" ]; then
  echo
  echo "*******************************************************************"
  echo "WARNING: Using version specified on the command line: $VERSION"
  echo "   This will be overwritten when run in CI based on the version in:"
  echo "   ./proto/oss_license_compliance/v0/VERSION"
  echo "*******************************************************************"
  echo
fi
