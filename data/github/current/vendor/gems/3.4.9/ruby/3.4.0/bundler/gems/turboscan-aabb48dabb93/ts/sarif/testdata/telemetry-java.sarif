            }
          },
          {
            "rule": {
              "id": "java/telemetry/unsupported-external-api",
              "index": 1,
              "toolComponent": {
                "index": 0
              }
            },
            "ruleId": "java/telemetry/unsupported-external-api",
            "value": 1,
            "message": {
