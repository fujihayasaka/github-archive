<% content_for :title, "Advisory reviews" %>
<% content_for :breadcrumbs do %>
  <%= render(Primer::Beta::Breadcrumbs.new) do |breadcrumb| %>
    <% breadcrumb.with_item(href: advisory_reviews_path) { "Advisory reviews" } %>
  <% end %>
<% end %>

<h2 class="mb-4 d-flex flex-justify-between flex-items-center">
  Advisory Reviews
  <%= render(Primer::ButtonComponent.new(tag: :a, href: new_advisory_review_path, scheme: :primary, variant: :small)) { "New advisory review" } %>
</h2>

<%= render AdvisoryReviews::FilterableTableComponent.new(sort: params[:sort], sort_by: params[:sort_by], state: params[:state], curator: params[:curator], source: params[:source], page: params[:page], query: params[:query], ecosystem: params[:ecosystem], label_ids: params[:label_ids], severity: params[:severity]) %>
