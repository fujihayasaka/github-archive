{
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../",
    "args": {
      "CONTAINER_BUILDER_TOKEN": "${localEnv:CONTAINER_BUILDER_TOKEN}"
    }
  },
  "features": {
    "azure-cli": "latest",
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "azureDnsAutoDetection": false,
      "disableIp6tables": true,
      "dockerDefaultAddressPool": "base=192.168.0.0/16,size=24"
    },
    "ghcr.io/github/features/goproxy:1": {},
    "ghcr.io/github/features/go-linter:1": {},
    "ghcr.io/github/features/dev-vpn:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "onCreateCommand": ".devcontainer/on-create-command.sh",
  "postCreateCommand": ".devcontainer/post-create-command.sh",
  "postStartCommand": ".devcontainer/post-start-command.sh",
  "hostRequirements": {
    "cpus": 8,
    "memory": "16gb"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/features": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/go-linter": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/gh-base-image": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/gh-kustomize": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "golang.go",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-vscode.azurecli",
        "foxundermoon.shell-format",
        "HashiCorp.terraform",
        "ms-azuretools.vscode-azureterraform"
      ]
    }
  },
  "portsAttributes": {
    "32474": {
      "label": "ingress"
    }
  },
  "forwardPorts": [
    32474
  ]
}