#!/bin/bash
set -e
set -u

IMAGE=spokes-proto-generate-docs

tar cf - \
  config/tools/generate-docs \
  config/tools/shared |
docker build -f config/tools/generate-docs/Dockerfile -t ${IMAGE} -

mkdir -p gen/docs

docker run --rm \
  --net=none \
  -v $(pwd)/_template:/go/src/github.com/github/spokes-proto/_template:ro \
  -v $(pwd)/proto:/go/src/github.com/github/spokes-proto/proto \
  -v $(pwd)/gen:/go/src/github.com/github/spokes-proto/gen \
  ${IMAGE}
