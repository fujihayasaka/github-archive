#!/bin/bash
set -e

# Determine the script's directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}/.."

# shellcheck disable=SC1091
source "${SCRIPT_DIR}/setup-env"

# Build all applications found in cmd/ directory
echo "==> Discovering applications in cmd/ directory <=="
for cmd_dir in cmd/*/; do
    if [ -d "$cmd_dir" ]; then
        build_name=$(basename "$cmd_dir")
        echo "Building $build_name..."
        go build -gcflags=all="-N -l" -o "$BIN_DIR/$build_name" "./$cmd_dir"
    fi
done

echo "Build completed successfully."
