# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
/.bin

# Test binary, built with `go test -c`
*.test

# VS Code Debugger Files
**/__debug_bin*

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# MacOS Finder produces this directory
.DS_Store

# Ripgrep/ag configuration file, for example to allow
# ignoring the `vendor` directory using `/vendor/**`
/.ignore

# Ruby dependencies are installed when testing the gem
.bundle
vendor/bundle
vendor/ruby
.codespace-compose.yml.lock

node_modules
/.turboscan-test.lock

# Terraform state
/terraform/*/.terraform/
