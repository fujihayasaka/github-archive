{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HydroSVC",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}/cmd/turboscan",
      "env": {
        "MYSQL_SKEEMA_PATH": "${workspaceRoot}/schemas/.skeema"
      },
      "args": ["service", "start", "hydrosvc"]
    },
    {
      "name": "RepoSVC",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}/cmd/reposvc",
      "env": {
        "MYSQL_SKEEMA_PATH": "${workspaceRoot}/schemas/.skeema"
      },
    },
    {
      "name": "TurboscanSVC",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}/cmd/turboscan",
      "env": {
        "MYSQL_SKEEMA_PATH": "${workspaceRoot}/schemas/.skeema"
      },
      "args": ["service", "start", "turboscansvc"]
    },
    {
      "name": "RepoIndexer",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}/cmd/repo-indexer",
      "env": {
        "MYSQL_SKEEMA_PATH": "${workspaceRoot}/schemas/.skeema"
      },
      "args": ["-target","repo","-repoID","2"]
    },
    {
      "name": "Launch",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${fileDirname}",
      "env": {
        "MYSQL_SKEEMA_PATH": "${workspaceRoot}/schemas/.skeema"
      },
      "args": []
    }
  ]
}

