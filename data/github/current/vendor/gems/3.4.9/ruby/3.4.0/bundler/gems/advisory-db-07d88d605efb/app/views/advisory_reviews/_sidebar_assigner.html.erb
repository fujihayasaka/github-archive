<%= render Primer::Beta::Details.new(reset: true, overlay: :default, position: :relative, flex: 1, mb: 3, px: 1, classes: "assignment") do |details| %>
  <% details.with_summary(
    data: { targets: approval.approved_at.present? ? nil : "form-tracker.disableWhenChanged" },
    aria: { disabled: approval.approved_at.present?, haspopup: true },
    classes: "width-full"
  ) do %>
    <%= approval.user_id.present? ? approval.user.login : "Curator" %>
    <div class="dropdown-caret float-right mt-2"></div>
  <% end %>
  <% details.with_body(classes: "SelectMenu") do %>
    <%= form_for approval do %>
      <input type="hidden" name="ghsa_id" value="<%= advisory_review.ghsa_id %>">
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <% if approval&.user_id.present? %>
            <button type="submit" name="curator" value="" role="menuitem" class="SelectMenu-item no-wrap text-semibold">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: :hidden) %>
              Unassign
            </button>
          <% end %>
          <% curators.each do |curator| %>
            <button type="submit" name="curator" value="<%= curator %>" role="menuitem" class="SelectMenu-item no-wrap">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (approval&.user&.login == curator ? :visible : :hidden)) %>
              <%= curator %>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
