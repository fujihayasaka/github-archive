export CHATOPS_PRIVATE_KEY=${cert_dir}/chatops.private.key
export KREDZ_HTTP_PORT=${KREDZ_HTTP_PORT:-5008}
export VARZ_HTTP_PORT=${VARZ_HTTP_PORT:-5011}
