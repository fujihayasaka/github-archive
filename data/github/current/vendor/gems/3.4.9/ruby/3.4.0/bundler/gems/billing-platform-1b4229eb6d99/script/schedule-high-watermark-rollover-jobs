#!/usr/bin/env bash

help="Usage: $0 [options]

Sends a high-watermark-rollover job request to the Aqueduct job queue which will be picked up by the request handler.

Options
  -a  Aqueduct application name
  -q  Aqueduct queue name
  -u  Aqueduct URL
  -y  Year
  -m  Month
  -c  Customer ID
  -s  Product SKU
  -d  Duration
"

# Set the default values
app="billing-platform-development"
queue="request-handler"
url="http://localhost:18081"

# Parse the command-line options
while getopts ":a:q:u:y:m:c:s:d:" opt; do
    case $opt in
        a)
        app="$OPTARG"
        ;;
        q)
        queue="$OPTARG"
        ;;
        u)
        url="$OPTARG"
        ;;
        y)
        year="$OPTARG"
        ;;
        m)
        month="$OPTARG"
        ;;
        c)
        customer="$OPTARG"
        ;;
        s)
        sku="$OPTARG"
        ;;
        d)
        duration="$OPTARG"
        ;;
        \?)
        echo "$help"
        exit 1
        ;;
    esac
done

if [ "$year" == "" ] || [ "$month" == "" ]; then
    >&2 echo -e "Year, Month must be provided"
    exit 1
fi

# Create the payload
request_type="schedule-high-watermark-rollover-jobs"
data="{\"Year\":$year,\"Month\":$month,\"CustomerId\":\"$customer\",\"Sku\":\"$sku\",\"Duration\":\"$duration\"}"
payload="{\"Type\":\"$request_type\",\"Data\":$data}"
hashed_payload=$(echo -n "$payload" | base64 | tr -d '[:space:]')

# Send the request to the job queue
curl \
    --header "Content-Type:application/json" \
    --data '{"app": "'$app'", "queue":"'$queue'", "payload":"'$hashed_payload'"}' \
    "$url/twirp/aqueduct.api.v1.JobQueueService/Send"

# New line after the curl response
echo