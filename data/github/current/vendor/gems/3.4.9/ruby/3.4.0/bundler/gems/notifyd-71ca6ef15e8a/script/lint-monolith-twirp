#!/bin/sh

# This script uses the provided linting tools on github.com/github/monolith-twirp-tools to lint the
# monolith-twirp protobuf schemas. Since the image generates some leftovers it also removes them.
#
# NOTE: It requires devvpn connextion to pull the docker images.

set -e

docker run -e NAMESPACE=notifications \
           -e MODULE_ROOT=proto/monolith-twirp \
           -e NWO=github/monolith-twirp-notifications \
           --volume `pwd`:/repo  \
           octofactory.githubapp.com/monolith-twirp-tools-docker-releases-local/monolith-twirp-tools-lint:latest lint

echo "Removing lint leftovers..."
git checkout .ruby-version
rm proto/monolith-twirp/notifyd/Makefile
rm proto/monolith-twirp/buf.yaml
echo "Done!"