#!/bin/bash
#/ Usage: script/create-dependabot-app

set -e

dependabot_app_file="$GITHUB_PATH/tmp/dependabot-app"

if [ -f "$dependabot_app_file" ]; then
    exit 0
fi

. script/_serverenv

GITHUB_PATH=${GITHUB_PATH:-~/github/github}
if [ ! -x "$GITHUB_PATH/bin/create-dependabot-github-app.rb" ]; then
  echo "error: github/github not found"
  echo "I looked in '${GITHUB_PATH}', but it does not look like a bootstrapped github working directory."
  echo "Please 'export GITHUB_PATH=~/whatever/.../github' and run this script again."
  exit 1
fi

# Disable Hydro for this, we do not want to create audit-log (or other) events
export GH_HYDRO_UNAVAILABLE=1

GITHUB_OK=$(cd $GITHUB_PATH; bin/create-dependabot-github-app.rb)
if [[ $GITHUB_OK != *"Integration and install triggers created"* ]]; then
  echo "error: unable to use bin/create-dependabot-app.rb without errors"
  exit 1
fi