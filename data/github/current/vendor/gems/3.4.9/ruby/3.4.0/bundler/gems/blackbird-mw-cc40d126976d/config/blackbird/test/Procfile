# The integration tests require running multiple processes within the same
# container. This Procfile defines the processes to run.
indexer: blackbird-indexer --config /config/blackbird/test/blackbird-indexer.toml --disable-hmac --listen 0.0.0.0:4444 --incr-threads 1 --batch-threads 1
server: blackbird-server --config /config/blackbird/test/blackbird-server.toml --disable-hmac --listen 0.0.0.0:4443
