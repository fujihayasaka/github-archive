# Skeema's default environment is called "production",
# Our production environment is going to be called
# "launch". So, to make things easier in dev, skeema's
# "production" environment will be the same as launch's
# "dev" environment.

default-character-set=utf8mb4
default-collation=utf8mb4_general_ci
generator=skeema:1.5.0-community
ignore-table=^_.*

# "production" is skeema's default environment, but it's our dev environment.
[production]
flavor=mysql:8.0
host=db
user=root
password=rootsekrit

# "enterprise" is used for on-premise enterprise installs
[enterprise]
host=localhost:3307

# "test" is used by script/test.
[test]
user=root
password=rootsekrit
host=db

# "ci" is used by script/cibuild-launch.
[ci]
user=root
password=my-secret-pw
host=mysql
port=3306

# "launch" is the production mysql database.
[launch]
host=vtgate-mysql-launch-production.service.iad.github.net
alter-wrapper=/data/github/shell/bin/gh-migrate-ghost -c "launch" -t "{TABLE}" -s "{SCHEMA}" -d {CLAUSES}
ddl-wrapper=/data/github/shell/bin/gh-migrate-skeema -c launch -T {TYPE} -s {SCHEMA} -t {TABLE} -d '{DDL}'

[skeema-diff-ci]
host=127.0.0.1
port=3306
user=root
