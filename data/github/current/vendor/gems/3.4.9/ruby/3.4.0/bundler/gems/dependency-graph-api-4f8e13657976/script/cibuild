#!/bin/bash

# docker-compose uses this to decide which config file(s) to use
# If another script sets COMPOSE_FILE already we will use that one
export COMPOSE_FILE=${COMPOSE_FILE:-docker-compose.golden.yaml}

#
# Builds and runs the container for the Ruby-based (spec) tests.
# Run as an Action in the CI workflow.
# TODO(adonovan): document the causal chain.
#
# May be run on Mac OS if Docker reserves at least 2GB of swap.

set -e

docker -v

cd "$(dirname "$0")/.."

output_fold() {
  # Exit early if no label provided
  if [ -z "$1" ]; then
    echo "output_fold(): requires a label argument."
    return
  fi

  exit_value=0  # exit_value is used to record exit status of the given command
  label=$1      # human-readable label describing what's being folded up
  shift 1       # having retrieved the output_fold()-specific arguments, strip them off $@

  # Only echo the tags when in CI_MODE
  if [ "$CI_MODE" ]; then
    echo "%%%FOLD {$label}%%%"
  fi

  # run the remaining arguments. If the command exits non-0, the `||` will
  # prevent the `-e` flag from seeing the failure exit code, and we'll see
  # the second echo execute
  "$@" || exit_value=$?

  # Only echo the tags when in CI_MODE
  if [ "$CI_MODE" ]; then
    echo "%%%END FOLD%%%"
  fi

  # preserve the exit code from the subcommand.
  return $exit_value
}

function cleanup() {
  echo
  echo "%%%FOLD {Shutting down services...}%%%"
  docker-compose down
  echo "%%%END FOLD%%%"
}

trap cleanup EXIT

export CI_MODE=true
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

if [ -f "/.github-full-larger-runner" ]; then
  ruby /usr/local/bin/create-pkg-mirror-files --pkg-mirror-file --os focal --apt-auth-file
fi
echo "Pre-pulling images"
docker pull docker.io/docker/dockerfile:1.2
docker pull docker.io/library/jruby:9.4.10.0
output_fold "Bootstrapping container..." docker-compose build
output_fold "Setting up database and running tests..." docker-compose run --rm app
