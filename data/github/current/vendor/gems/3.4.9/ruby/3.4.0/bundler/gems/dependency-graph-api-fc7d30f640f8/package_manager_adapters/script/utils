validate() {
  if [ -z ${PACKAGE_MANAGER-} ]; then
    echo "Error: Missing PACKAGE_MANAGER"
    usage
    exit 1
  fi

  if [ ! -d $PACKAGE_MANAGER ]; then
    echo "Error: Unsupported package manager '$PACKAGE_MANAGER'"
    echo "Supported package managers: $(supported-package-managers)"
    exit 1
  fi
}

supported-package-managers() {
  find . -type d -maxdepth 1 | \
    grep -v script | \
    sed 's/[\.\/]//g' | \
    xargs
}

container-name() {
  echo "package-adapters-$PACKAGE_MANAGER"
}

container-tag() {
  echo "package-adapters:$PACKAGE_MANAGER"
}
