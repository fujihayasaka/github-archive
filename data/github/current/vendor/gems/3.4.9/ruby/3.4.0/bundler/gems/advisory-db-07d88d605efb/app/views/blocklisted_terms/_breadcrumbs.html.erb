<%= render Primer::Beta::Breadcrumbs.new  do |breadcrumb| %>
  <% breadcrumb.with_item(href: blocklisted_terms_path) { "Blocklisted Terms" } %>

  <% breadcrumb.with_item(href: "#{blocklisted_terms_path}/#{blocklisted_term.id || "new"}") do %>
    <% if blocklisted_term.id %>
      <%= blocklisted_term.pattern %>
    <% else %>
      New blocklisted term
    <% end %>
  <% end %>
<% end %>
