# This files is an example of the type of configuration you can use to run
# notifyd locally if you need to.
#
# The defaults on the .env file are meant to be used to run it alongside with
# dotcom on its development codespace, while these are meant to be used to run
# it in isolation on its own codespace.
#
# If you want to use it just copy it to .env.local
AUTHZD_URL=http://localhost:8088
MONOLITH_TWIRP_API_HMAC_KEY=secret
MONOLITH_TWIRP_API_URL=http://localhost:8088
PRIMARY_DB_URL="root@tcp(localhost)/notifyd_development"
REPLICA_DB_URL="root@tcp(localhost)/notifyd_development"
STATSD_ADDR=IGNORE
TEST_DB_URL="root@tcp(localhost)/notifyd_test"
TWIRP_API_HMAC_KEY=secret
AQUEDUCT_APP=notifyd-development
AQUEDUCT_QUEUE=test
RETRIES_QUEUE=retries
KAKFA_SET_VERSION=1.1.1.0

# vim:set filetype=sh:
