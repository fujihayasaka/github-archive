#!/bin/bash

set -e

if ! which golangci-lint >/dev/null; then
    echo "golangci was not found, installing..."
    script/install-golangci-lint
fi

has_deadline=false
for arg; do
  if [ "$arg" = "--timeout" ]; then
    has_deadline=true
  fi
done

test $# -gt 0 || set -- ./...
echo Linting "$@"

if ! $has_deadline; then
  # Set deadline to be more realistic
  set -- --timeout='60s' "$@"
fi
set -x; time golangci-lint run "$@"

echo 'OK!'
