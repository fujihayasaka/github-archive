<% if show_dialog?(BOTH_STAGES_PENDING) %>
  <%= render(Primer::Alpha::Dialog.new(id: dialog_id(BOTH_STAGES_PENDING), test_selector: test_selector(BOTH_STAGES_PENDING), title: "Stage one and two prerequsites not met", visually_hide_title: true, animation: :fade_in, classes: "fast no-outline")) do |dialog| %>
    <% dialog.with_body(font_size: 4) do %>
      <p class="mb-0">This advisory cannot be <%= stage_two.past_tense_action %> until all checks are passing.</p>
    <% end %>
    <% dialog.with_footer(display: :flex, justify_content: :flex_end) do %>
      <%= render(Primer::ButtonComponent.new(mr: 2, data: { "close-dialog-id": dialog_id(BOTH_STAGES_PENDING) })) { "Close" } %>
    <% end %>
  <% end %>
<% end %>

<% if show_dialog?(STAGE_ONE_ALREADY_COMPLETE) %>
  <%= render(Primer::Alpha::Dialog.new(id: dialog_id(STAGE_ONE_ALREADY_COMPLETE), test_selector: test_selector(STAGE_ONE_ALREADY_COMPLETE), title: "Stage one already complete", visually_hide_title: true, animation: :fade_in, classes: "fast no-outline")) do |dialog| %>
    <% dialog.with_body(font_size: 4) do %>
      <p class="mb-0">This advisory has already been marked as <%= stage_one.past_tense_action %> and is ready to <%= stage_two.action %>.</p>
    <% end %>
    <% dialog.with_footer(display: :flex, justify_content: :flex_end) do %>
      <%= render(Primer::ButtonComponent.new(mr: 2, data: { "close-dialog-id": dialog_id(STAGE_ONE_ALREADY_COMPLETE) })) { "Close" } %>
    <% end %>
  <% end %>
<% end %>

<% if show_dialog?(STAGE_ONE_CONFIRMATION) %>
  <%= render(Primer::Alpha::Dialog.new(id: dialog_id(STAGE_ONE_CONFIRMATION), test_selector: test_selector(STAGE_ONE_CONFIRMATION), title: "Confirm stage one", visually_hide_title: true, animation: :fade_in, classes: "fast no-outline")) do |dialog| %>
    <% dialog.with_body(font_size: 4) do %>
      <p class="mb-0">Are you sure this advisory is ready to <%= stage_two.action %>?</p>
    <% end %>
    <% dialog.with_footer(display: :flex, justify_content: :flex_end) do %>
      <%= render(Primer::ButtonComponent.new(mr: 2, data: { "close-dialog-id": dialog_id(STAGE_ONE_CONFIRMATION) })) { "Cancel" } %>
      <%= button_to stage_one.confirmation_url, { method: :put, params: stage_one.confirmation_params, class: "btn btn-primary"} do %>
        <%= stage_one.label.capitalize %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if show_dialog?(PENDING_STAGE_ONE) %>
  <%= render(Primer::Alpha::Dialog.new(id: dialog_id(PENDING_STAGE_ONE), test_selector: test_selector(PENDING_STAGE_ONE), title: "Stage two is pending completion of stage one", visually_hide_title: true, animation: :fade_in, classes: "fast no-outline")) do |dialog| %>
    <% dialog.with_body(font_size: 4) do %>
      <p class="mb-0">This advisory cannot be <%= stage_two.past_tense_action %> until it has been <%= stage_one.past_tense_action %>.</p>
    <% end %>
    <% dialog.with_footer(display: :flex, justify_content: :flex_end) do %>
      <%= render(Primer::ButtonComponent.new(mr: 2, data: { "close-dialog-id": dialog_id(PENDING_STAGE_ONE) })) { "Close" } %>
    <% end %>
  <% end %>
<% end %>

<% if show_dialog?(STAGE_TWO_CONFIRMATION) %>
  <%= render(Primer::Alpha::Dialog.new(id: dialog_id(STAGE_TWO_CONFIRMATION), test_selector: test_selector(STAGE_TWO_CONFIRMATION), title: "Confirm stage two", visually_hide_title: true, animation: :fade_in, classes: "fast no-outline #{"col-5" if stage_two_confirmation_diff.present?}")) do |dialog| %>
    <% dialog.with_body(font_size: 4) do %>
      <%= stage_two_confirmation_preamble %>
      <%= stage_two_confirmation_diff %>
      <p class="mb-0">Are you sure you want to <%= stage_two.action %>? This is not reversible!</p>
    <% end %>
    <% dialog.with_footer(display: :flex, justify_content: :flex_end, show_divider: true) do %>
      <%= render(Primer::ButtonComponent.new(mr: 2, data: { "close-dialog-id": dialog_id(STAGE_TWO_CONFIRMATION) })) { "Cancel" } %>
      <%= button_to stage_two.confirmation_url, { method: :put, params: stage_two.confirmation_params, class: "btn btn-primary"} do %>
        <%= stage_two.label.capitalize %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
