default-character-set=latin1
default-collation=latin1_swedish_ci
flavor=mysql:8.0

# We're just mirroring the dotcom db in this (for testing the code that talks directly to mysql1)
# So we allow normally "undesirable" things here so that those schema scripts
# can run mostly unmodified and mirror the real dotcom.
allow-auto-inc=int, bigint, int unsigned, bigint unsigned
allow-charset=utf8, latin1, utf8mb4

###############################
######### DEVELOPMENT #########
###############################

# Development on a local dev's box
[development]
schema=github_development_collab
host=localhost
port=3001
user=root

# Tests, run on a local dev's box
[test]
schema=github_test_collab
host=localhost
port=3001
user=root

# Tests against mysql default port for local dev and codespaces testing
[test-default-port]
schema=github_test_collab
host=localhost
port=3306
user=root

# Tests, run in CI (where they have to run in a container)
[test-ci]
schema=github_test_collab
host=db
port=3306
user=root


###############################
########### GHES ##############
###############################

[enterprise-development]
schema=github_enterprise
host=localhost
port=3001
user=root
ignore-table=authentication_key_values|authentication_tokens|businesses|integration_installations|integrations|mobile_auth_requests|mobile_device_keys|oauth_accesses|oauth_applications|oauth_authorizations|organization_credential_authorizations|programmatic_access_tokens|public_keys|user_sessions|users

###############################
########### PROXIMA ###########
###############################

# Tests, run on a local dev's box
[test-proxima]
schema=github_test_proxima_collab
host=localhost
port=3001
user=root

# Tests against mysql default port
[test-default-port-proxima]
schema=github_test_proxima_collab
host=localhost
port=3306
user=root

# Tests, run in CI (where they have to run in a container)
[test-ci-proxima]
schema=github_test_proxima_collab
host=db
port=3306
user=root