// This parser is copied from Geyser: https://github.com/github/geyser/blob/master/search/transport/syntax/githubv0/grammar.peg
package geyser

type geyserParser Peg {
    gHQuery *parsedGHQuery
    gHClause *gHClause
}

Search          <- { p.start() } Space OpClause+ !.
OpClause        <- ( MinusClause / QualifierClause )  { p.finalizeClause() }
MinusClause     <- ( Minus /  Not Space ) QualifierClause {  p.captureNegation() }
QualifierClause <- ( Qualifier Colon )? Clause
Clause          <- ( QuotedValue / LikelyValue )
Qualifier       <- <QualifierKey> {  p.captureQualifier(text)  }
QuotedValue     <- Quote <QuotedChar+> Quote Space {  p.captureQuotedValue(text)  }
LikelyValue     <- < !ForbiddenStartChar [^ \t]+ > Space  { p.captureLikelyValue(text) }


QualifierKey       <- ( 'language_id' /
                        'language' /
                        'extension' /
                        'filename' /
                        'repo_id' /
                        'repo' /
                        'user_id' /
                        'user' /
                        'org_id' /
                        'org' /
                        'fork' /
                        'path' /
                        'size' /
                        'sort' /
                        'in' )
ForbiddenStartChar <- [-"(+]
QuotedChar         <- '\\"' / '\\\\' / [^"\\]
Not                <- 'NOT'
Colon              <- ':'
Minus              <- '-'
Quote              <- '"'
Space              <- ( ' ' / '\t' )*  # TODO consider expanding to other forms of whitespace
