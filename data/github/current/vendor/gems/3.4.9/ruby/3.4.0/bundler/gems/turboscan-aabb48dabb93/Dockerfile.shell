ARG base_image
FROM ${base_image}
USER root
RUN apt-get update && \
	apt-get install --yes \
		curl \
		kafkacat \
		less \
		screen \
		vim \
		xz-utils \
	&& \
	mkdir /opt/kt/ && \
	curl --fail --location --output /tmp/kt.tar.xz "https://github.com/fgeller/kt/releases/download/v13.0.0/kt-v13.0.0-linux-amd64.txz" && \
	echo "0283f26bf861092f868442a44185ccc0f9ee7f35263054fed60289a7f3845bbf /tmp/kt.tar.xz" | sha256sum --check - && \
	tar -xvf /tmp/kt.tar.xz -C /opt/kt/ && \
	rm -rf /tmp/*
COPY ./docker/shell/root/ /
CMD ["sleep", "infinity"]
USER turboscan
