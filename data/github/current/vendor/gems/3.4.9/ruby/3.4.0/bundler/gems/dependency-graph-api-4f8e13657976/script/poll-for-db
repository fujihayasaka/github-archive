#!/bin/bash

set -uo pipefail

# Need to source the _env file to get
# the correct MySQL path for mysqladmin on Mac
source "$(dirname "$0")/_env"

DB_HOST="${1-}"
if [[ -z "$DB_HOST" ]]; then
  DB_HOST="db"
fi

DB_PORT="${2-}"
if [[ -z "$DB_PORT" ]]; then
  DB_PORT=3306
fi

DB_USER="${3-}"
if [[ -z "$DB_USER" ]]; then
  DB_USER="root"
fi


echo "==> Polling database ($DB_USER@$DB_HOST:$DB_PORT)..."
for i in {1..60}; do
  mysqladmin ping -h "$DB_HOST" -P "$DB_PORT" -u"$DB_USER" && exit
  sleep 1
done

echo "Unable to reach database!"
exit 1
