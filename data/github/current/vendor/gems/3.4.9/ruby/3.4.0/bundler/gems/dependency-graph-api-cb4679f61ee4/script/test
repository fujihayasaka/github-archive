#!/bin/bash
# Run the Rails-based tests.
#
# Usage:
#
#   script/test
#
#   script/test spec/some_spec.rb
#
# After the first run, consider using bin/rspec instead of script/test for
# a quicker test-iteration cycle.

set -e

cd "$(dirname "$0")/.."
source "script/_env"

# set the number of generative test examples for the rantly tests to 15 by default
export RANTLY_COUNT=${RANTLY_COUNT:-15}

# Don't bother setting the db:environment if we're in CI, but it's helpful to do it locally
if [ -z "$JOB_NAME" ]; then
  bundle exec rails db:environment:set RAILS_ENV=test
fi
RAILS_ENV="test" bundle exec rspec --format progress --format RspecJSONDumper::Formatter "$@"
