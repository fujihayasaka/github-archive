#!/usr/bin/env bash
#/ Generates twirp and protobuf code in the proto/ folder
#/ It generates both go and ruby code
#/

source "script/helpers/_utils.sh"

set -e

if [ "${CODESPACES:-false}" = "true" ] && [ "${GITHUB_REPOSITORY}" = "github/authzd" ] ; then
  # for docker-in-docker buildx doesn't get installed with our current image
  export DOCKER_BUILDKIT=0
fi

highlight ">> building authnd-protoc image..."
docker build --platform linux/amd64 -t authnd-protoc -f Dockerfile.proto .

# See https://developers.google.com/protocol-buffers/docs/reference/go-generated for Protobuf generator options
# See https://twitchtv.github.io/twirp/docs/command_line.html for Twirp generator options

# Generate Go code
highlight ">> generating Go protobuf..."
docker run --rm -v "$(pwd)":/go/src -w /go/src \
    authnd-protoc \
    --proto_path=proto --twirp_out=client/proto --go_out=client/proto --go_opt=paths=source_relative --twirp_opt=paths=source_relative \
    proto/authentication/v0/*.proto

# Generate Ruby code
highlight ">> generating Ruby protobuf..."
docker run --rm -v "$(pwd)":/go/src -w /go/src \
    authnd-protoc \
    --proto_path=proto --ruby_out=ruby/lib/authnd-client/proto \
    proto/authentication/v0/*.proto
docker run --rm -v "$(pwd)":/go/src -w /go/src \
    authnd-protoc \
    --proto_path=proto --twirp_ruby_out=ruby/lib/authnd-client/proto \
    proto/authentication/v0/authentication_api.proto

# trim autogenerated class prefix from Ruby twirp protobufs
# TODO(chriskirkland): if would be great if we figured out how to eliminate this prefix from the twirp generation above
if [[ $OSTYPE == 'darwin'* ]]; then
  # sed on OSX is 🙈
  sed -i '' 's/Github::Authentication::V0:://g' ruby/lib/authnd-client/proto/authentication/v0/authentication_api_twirp.rb
else
  sed -i 's/Github::Authentication::V0:://g' ruby/lib/authnd-client/proto/authentication/v0/authentication_api_twirp.rb
fi

# vendor updated dependencies
highlight ">> vendoring client dependencies"
( cd client && go mod vendor )
echo 

highlight ">> vendoring server dependencies"
go mod vendor

