#!/bin/bash
# Usage: script/create-migration <name>
#
# Creates a new migration for the relevant database cluster in the migrations
# directory, which is expected to be located at the root level of your repo.
# migrate will create the directory if it does not already exist.

set -e

cd "$(dirname "$0")/.."

if [ $# -eq 0 ]; then
    echo "The migration name must be supplied as an argument"
    exit 1
fi

migrate create -dir migrations -ext sql "$1"
