#!/bin/bash
#/ Outputs the variables required to debug unit tests that use database into an .env file

mkdir -p "./tmp"
echo "LAUNCH_DEPLOYER_TEST_DATABASE_URL=$LAUNCH_DEPLOYER_TEST_DATABASE_URL" >> "./tmp/test-db.env"
echo "ACTIONS_PAYLOADS_TEST_DATABASE_URL=$ACTIONS_PAYLOADS_TEST_DATABASE_URL" >> "./tmp/test-db.env"
echo "AZURITE_BLOB_HOST=$AZURITE_BLOB_HOST" >> "./tmp/test-db.env"
