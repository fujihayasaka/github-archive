#!/bin/bash
#/ Usage: called by the script/bootstrap script.
#/ Installs all the Go stuff so that you can develop in this repo.

set -e

cd $(git rev-parse --show-toplevel)

if [[ ! -x "$(which go)" ]]; then
  echo >&2 "launch requires an installation of Go to build."
  exit 1
fi

echo Installing Overmind
brew install overmind

echo Installing protobuf
brew install protobuf

echo Installing pre-commit
brew install pre-commit

echo Installing Terraform
brew install terraform

echo Installing Azure CLI
brew install az

echo Installing pre-commit in local repo .git folder
pre-commit install

echo Installing Go tools...
make tools

echo Done.
