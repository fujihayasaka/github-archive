<% content_for :breadcrumbs do %>
  <%= render "breadcrumbs", campaign: campaign %>
<% end %>

<header class="pagehead border-bottom pb-3 mb-4">
  <h1 class="mb-2 lh-condensed text-normal" <%= test_selector("campaign-title") %>>Create a review campaign</h1>
</header>

<% if campaign.errors.any? %>
  <%= render Primer::Beta::Flash.new(scheme: :danger, icon: "hubot", spacious: true, test_selector: "flash-error") do %>
    The review campaign could not be created. See details below.
    <% if campaign.errors.include?(:base) %>
      <ul class="list-style-none ml-5">
        <% campaign.errors.full_messages_for(:base).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>

<%= render Primer::Alpha::Layout.new(first_in_source: :main) do |layout| %>
  <% layout.with_sidebar(col_placement: :end) do %>
    <div class="position-sticky top-0 mt-n4 pt-4">
      <%= render(Primer::ButtonComponent.new(
        type: :submit,
        form: "campaign-form",
        display: :flex,
        align_items: :center,
        mb: 2,
        classes: "btn-large width-full",
        test_selector: "campaign-submit-button"
      )) do %>
        <%= render IconComponent.new(icon: "plus", mr: 3) %>
        Create review campaign
      <% end %>
    </div>
  <% end %>

  <% layout.with_main do %>
    <%= form_for campaign, html: { id: "campaign-form", **test_selector_data_hash("campaign-form") } do |form| %>
      <h2 class="mb-2 h4">
        <%= form.label :name %>
      </h2>

      <%= render FormFieldWithErrorsComponent.new(object: campaign, attribute: :name) do %>
        <%= form.text_field :name, class: "form-control width-full", placeholder: "e.g. NuGet backfill" %>
      <% end %>

      <h2 class="mt-4 mb-2 h4">
        <label for="cve_or_ghsa_ids">CVE and/or GHSA IDs</label>
        <span class="text-small text-normal text-italic color-fg-muted">(can be separated by newline, comma, space, or comma space)</span>
      </h2>

      <%= render FormFieldWithErrorsComponent.new(object: campaign, attribute: :advisory_reviews) do %>
        <%= text_area_tag "cve_or_ghsa_ids", cve_or_ghsa_ids, class: "form-control width-full", placeholder: "e.g. GHSA-j9rr-wvg3-2vh3, CVE-2022-0007, GHSA-5c2r-2q5v-rv85", rows: 30 %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
