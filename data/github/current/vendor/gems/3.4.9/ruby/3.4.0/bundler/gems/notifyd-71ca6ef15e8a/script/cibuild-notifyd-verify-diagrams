#!/bin/bash

imgs=$(find docs/images -name "*.png" -not -name "_*")

exit_code=0
# for each file in imgs, use strings to ensure it contains "tEXt"
for img in $imgs; do
    strings $img | grep -q "tEXtapplication/vnd.excalidraw+json"
    if [ $? -ne 0 ]; then
        echo "Missing excalidraw data in $img, did you forget to export from excalidraw with 'Embed scene into exported file' set?"
        exit_code=1
    fi
done


if [ $exit_code -ne 0 ]; then
  echo -e "\nFor more information on working with diagrams read: https://github.com/github/notifyd/docs/images/README.md\n"
fi

exit $exit_code
