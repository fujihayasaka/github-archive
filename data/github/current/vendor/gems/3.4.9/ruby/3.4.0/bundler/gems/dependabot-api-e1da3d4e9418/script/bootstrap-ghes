#!/bin/sh

set -ex

/bin/tools/install-manifest /etc/dependabot/dpkg.manifest

/bin/tools/install-cleanup

rm -r \
  /lib/systemd \
  /usr/bin/dpkg* \

mkdir -p /opt/dependabot

# uid selected in https://github.com/github/enterprise2/pull/26269
groupadd -g 640 dependabot && useradd -r -u 640 -g dependabot dependabot
chown -R dependabot:dependabot /opt/dependabot
touch /etc/app-env
