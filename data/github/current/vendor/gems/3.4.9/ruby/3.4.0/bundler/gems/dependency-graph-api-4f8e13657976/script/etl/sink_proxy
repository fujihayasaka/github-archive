#!/usr/bin/env ruby
#
# Usage: script/etl/sink_proxy [start|stop|restart|status]

require_relative "./daemon"
require_relative "../../config/environment"
require_relative "../../etl/sink_proxy"

PORT = 7777

def start_sink
  # Use thread-local default sink
  SinkProxy.set :package_release_sink, nil
  SinkProxy.run!(port: PORT)
end

if ENV.fetch("NO_DAEMON", false.to_s) != false.to_s
  start_sink
else
  Daemon.run(__FILE__) do |logger, config|
    start_sink
  end
end
