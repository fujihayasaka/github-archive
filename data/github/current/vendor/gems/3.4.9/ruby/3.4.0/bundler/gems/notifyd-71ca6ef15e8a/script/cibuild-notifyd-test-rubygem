#!/bin/bash

set -e
source script/bash_fns

function cleanup() {
  echo
  echo "%%%FOLD {Shutting down services...}%%%"
  docker compose down
  echo "%%%END FOLD%%%"
}

trap cleanup EXIT

export CI_MODE=true

output_fold "Running RBI check" make tapioca
output_fold "Running type checks" make sorbet
output_fold "Starting servers and running tests..." make ci-test-ruby
