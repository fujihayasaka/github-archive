<dt class="<%= unknown? ? "color-bg-danger" : "color-bg-subtle" %> px-3 py-2 mt-2 width-full js-cwe-link rounded-1 d-flex flex-row flex-justify-between"
  data-cwe-id="<%= cwe_id %>"
  title="<%= cwe_id %>"
  data-targets="cwe-autocomplete.linkedCWEs"
  <%= test_selector("cwe-form-row") if visible? %>
>
  <div>
    <% if unknown? %>
      <%= render IconComponent.new(icon: "alert", mr: 1, color: :danger) %>
      <span class="color-fg-subtle"><span <%= test_selector("unknown-cwe-id") %>><%= cwe_id %></span> unknown</span>
    <% else %>
      <span class="color-fg-default" <%= test_selector("cwe-name") %>><%= cwe_name %></span>
      <span class="color-fg-subtle">(<span <%= test_selector("cwe-id") %>><%= cwe_id %></span>)</span>
    <% end %>
  </div>

  <button
    type="button"
    class="float-right ml-2 btn-link Link--muted"
    data-action="click:cwe-autocomplete#removeLinkedCWE"
    aria-label="Remove <%= cwe_id %>"
    <%= "hidden" if disabled? %>>
    <%= render(IconComponent.new(icon: "x")) %>
  </button>
  <input type="hidden" name="<%= name_prefix %>[cwe_ids][]" value="<%= cwe_id %>">
  <input type="hidden" name="<%= name_prefix %>[problemtype_values][]" value="<%= cwe_id %>: <%= cwe_name %>">
</dt>
