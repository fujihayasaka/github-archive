<div class="Box-row px-2 py-1 d-flex flex-justify-between">
  <div class="p-2 col-4">
    <h4 class="h6 color-fg-muted d-inline-block">Ecosystem</h4>
    <% if ecosystem.present? %>
      <span class="f4 wb-break-all text-bold" <%= test_selector("ecosystem") %>><%= ecosystem %></span>
    <% else %>
      <span class="f4 color-fg-subtle" <%= test_selector("no-ecosystem") %>>None</span>
    <% end %>
  </div>

  <div class="p-2 col-8">
    <h4 class="h6 color-fg-muted d-inline-block">Package</h4>
    <% if package.present? %>
      <span class="f4 wb-break-all text-bold" <%= test_selector("package") %>><%= package %></span>
    <% else %>
      <span class="f4 color-fg-subtle" <%= test_selector("no-package") %>>None</span>
    <% end %>
  </div>
</div>
