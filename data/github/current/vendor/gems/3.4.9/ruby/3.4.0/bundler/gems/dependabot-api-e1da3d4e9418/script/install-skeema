#!/bin/bash

appdir=$(cd $(dirname "$0")/.. && pwd)
[ -f /etc/app-env ] || exec "$appdir/script/app-env" $0 $@

set -e

cd "$(dirname "$0")/.."

if [ ! -f bin/skeema ] ; then
  echo "installing skeema/skeema"
  curl -s -L https://github.com/skeema/skeema/releases/download/v1.4.0/skeema_1.4.0_linux_amd64.tar.gz > tmp/skeema.tar.gz
  tar --directory bin -xzf  tmp/skeema.tar.gz skeema
fi
