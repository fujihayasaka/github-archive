<%
  current_page =
    case action_name
    when "timeline" then :timeline
    else :form # Fall back to the form since many failed actions render it
    end
%>
<%= render(Primer::Alpha::UnderlineNav.new(label: "CVE review pages")) do |underline_nav| %>
  <% underline_nav.with_tab(href: cve_review_path(cve_review), selected: current_page == :form) do |t| %>
    <% t.with_icon(icon: :pencil) %>
    <% t.with_text { "CVE review" } %>
  <% end %>
  <% underline_nav.with_tab(href: timeline_cve_review_path(cve_review), selected: current_page == :timeline) do |t| %>
    <% t.with_icon(icon: :clock) %>
    <% t.with_text { "Timeline" } %>
  <% end %>
<% end %>
