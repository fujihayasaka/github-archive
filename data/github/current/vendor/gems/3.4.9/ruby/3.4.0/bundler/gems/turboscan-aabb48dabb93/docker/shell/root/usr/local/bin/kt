#!/usr/bin/env sh
set -eu
export KT_BROKERS="$KAFKA_BROKERS"
KT_AUTH="/tmp/kt-auth.json"
if [ ! -f "$KT_AUTH" ] && [ -n "${KAFKA_CA_CERT:-}" ]; then
	cat > "$KT_AUTH" << EOF
{
	"mode": "TLS-1way",
	"ca-certificate": "$KAFKA_CA_CERT"
}
EOF
fi
if [ -f "$KT_AUTH" ]; then
	export KT_AUTH
fi
exec /opt/kt/kt "$@"
