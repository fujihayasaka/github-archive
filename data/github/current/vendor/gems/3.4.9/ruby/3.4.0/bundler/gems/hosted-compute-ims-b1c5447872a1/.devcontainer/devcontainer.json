// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.245.2/containers/go
{
    "name": "hosted-compute-ims",
    "build": {
        "dockerfile": "Dockerfile",
    },
    "runArgs": [
        "--cap-add=SYS_PTRACE"
    ],
    "hostRequirements": {
        "storage": "64gb"
    },
    "remoteUser": "vscode",
    "postCreateCommand": "script/bootstrap",
    "postStartCommand": "/usr/local/share/goproxy-init.sh --override",
    "remoteEnv": {
        // Set telemetry environment variables, to produce less noisy logs.
        "GITHUB_TELEMETRY_LOGS_INCLUDE_RESOURCE_ATTRIBUTES": "",
        "GITHUB_TELEMETRY_LOGS_CONSOLE_ENCODING": "console",
        "GITHUB_TELEMETRY_LOGS_PRECISION": "second"
    },
    // Configure tool-specific properties.
    "customizations": {
        // Configure properties specific to VS Code.
        "vscode": {
            // Set *default* container specific settings.json values on container create.
            "settings": {
                "go.toolsManagement.checkForUpdates": "local",
                "go.useLanguageServer": true,
                "go.gopath": "/go"
            },
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "golang.Go",
                "github.copilot",
                "ms-azuretools.vscode-docker",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "bierner.markdown-preview-github-styles",
                "terrastruct.d2",
                "mutantdino.resourcemonitor"
            ],
            "recommendations": [
                "zxh404.vscode-proto3"
            ]
        },
        "codespaces": {
            "repositories": {
                "github/*": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                },
                "github/hosted-compute-ims": {
                    "permissions": {
                        "contents": "write",
                        "pull_requests": "write"
                    }
                },
                "github/hosted-compute-core": {
                    "permissions": {
                        "contents": "write",
                        "pull_requests": "write",
                        "workflows": "write"
                    }
                },
                "github/hosted-compute-proto": {
                    "permissions": {
                        "contents": "write",
                        "pull_requests": "write",
                        "workflows": "write"
                    }
                },
                "github/features": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                }
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/go:1": {
            "version": "1.23"
        },
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}, // Docker
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {}, // Minikube & kubectl
        "ghcr.io/devcontainers/features/github-cli:1": {}, // GitHub CLI
        "ghcr.io/devcontainers/features/azure-cli:1": {}, // Azure CLI
        "ghcr.io/github/features/goproxy:1": {}, // Go Proxy
        "ghcr.io/github/features/dev-vpn:1": {}, // Dev VPN
        "ghcr.io/devcontainers/features/sshd:1": {} // SSH
    }
}
