#!/bin/bash
#/ Usage: script/bootstrap <option>
#/
#/ Bootstraps hookshot-go dev dependencies

if [ "$OSTYPE" == "darwin" ]; then
  # Install homebrew dependencies. This will only run on macOS for now,
  # not taking into account people who might have linuxbrew set up
  if which brew > /dev/null; then
    brew bundle
  else
    echo "homebrew not installed so cannot install brew deps"
  fi
fi

# Migrate development and test dbs
APP_ENV=development script/migrate-mysql
APP_ENV=test script/migrate-mysql
