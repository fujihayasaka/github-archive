#!/bin/bash

set -e

# Ensure mockery is installed and the correct version
# Version differences often result in differences in generated mocks
if ! which mockery >/dev/null; then
	echo "Mockery was not found, install it with script/install-tools" >&2
	exit 1
fi

current_mockery_version=$(mockery --version | tail -n 1 | cut -d' ' -f1)
expected_mockery_version=v$(grep -o 'MOCKERY_VERSION=.*' script/install-tools | cut -d'=' -f2)

if [ "$current_mockery_version" != "$expected_mockery_version" ]; then
	echo "Mockery version mismatch: expected $expected_mockery_version, got $current_mockery_version" >&2
	echo "Run script/install-tools to install the correct version of mockery." >&2
	exit 1
fi

# Set core.autocrlf setting to input just in case.
git config --global core.autocrlf input
echo "Removing current mocks..."
grep -Rl --include \*.go  '// Code generated by mockery' $(git rev-parse --show-toplevel) | xargs rm
echo "Re-generating mocks..."
mockery

if ! git diff --exit-code ; then
	echo "Go generated mocks are out of sync somehow." >&2
	echo "Run './script/mock-check' locally and commit the result, confirming it matches changes you have made." >&2
	exit 1
fi
echo 'OK!'
