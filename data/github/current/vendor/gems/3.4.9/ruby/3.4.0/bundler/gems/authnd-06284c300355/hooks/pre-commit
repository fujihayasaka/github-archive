#!/bin/bash

# ensure enterprise schemas stay in sync
\cp schemas/authnd/programmatic_access_tokens.sql schemas/authnd/enterprise/
if git diff --name-only | grep -qE schemas/authnd/enterprise; then
    git update-index --add schemas/authnd/enterprise/*
    echo "synced enterprise schemas and dotcom schemas..."
fi

# ensure kustomize changes are synced to kubernetes manifests
if git diff --name-only | grep -qE config/kustomize; then
  echo "syncing kustomize files..."
  script/kustomize || exit 1
fi
