default-character-set=utf8mb4
default-collation=utf8mb4_general_ci

# "production" is skeema's default environment, but it's our dev environment.
[production]
allow-unsafe
schema=actions_workflow_payloads_development

# "enterprise" is used for on-premise enterprise installs
[enterprise]
schema=actions_workflow_payloads_enterprise

# "test" is used by script/test.
[test]
allow-unsafe
schema=actions_workflow_payloads_test

# "ci" is used by script/cibuild-launch.
[ci]
allow-unsafe
schema=actions_workflow_payloads_test

# "launch" is the production mysql database.
[launch]
schema=actions_workflow_payloads_production

# skeema-diff-ci is used by the .github/workflows/skeema-diff Action. The schema name is used to hint to skeefree where this needs to be deployed in production
[skeema-diff-ci]
schema=skeema:actions_workflow_payloads_production
