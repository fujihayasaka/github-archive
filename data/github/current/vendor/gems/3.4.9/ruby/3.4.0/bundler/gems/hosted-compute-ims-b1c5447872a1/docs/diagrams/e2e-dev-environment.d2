title: e2e dev environment {
  near: top-center
  shape: text
  style: {
    font-size: 29
    bold: true
  }
}

vars: {
  d2-config: {
    theme-id: 0
    sketch: true
    layout-engine: elk
  }
}

hc-ims: Hosted Compute IMS API
hc-ims-worker: Hosted Compute IMS Worker

dotcom: Dotcom {
  shape: image
  icon: https://icons.terrastruct.com/dev/github.svg
}
runner: Runner

azure: Azure {
  shape: cloud
  style.multiple: true
}

services: docker {
  aqueduct: Aqueuduct Lite {
    shape: square
    style.multiple: true
  }
  redis: Redis {
    shape: image
    icon: https://icons.terrastruct.com/dev/redis.svg
  }
  mysql: MySQL Cluster {
    shape: cylinder
  }
}

services.aqueduct <-> services.redis

dotcom -> hc-ims: get image 1 (Hmac signed request) {
  style: {
    stroke: deepskyblue
  }
}
hc-ims -> services.mysql: select image version where id = 1 {
  style: {
    stroke: deepskyblue
  }
}
hc-ims -> dotcom: return image 1 {
  style: {
    stroke: deepskyblue
  }
}

dotcom -> runner: create pool 1 {
  style: {
    stroke: deepskyblue
  }
}

runner -> hc-ims: get image reference 1 {
  style: {
    stroke: deepskyblue
  }
}

runner -> azure: Create VM {
  style: {
    stroke: deepskyblue
  }
}

dotcom <-> hc-ims: upload image (SAS URI) (Hmac signed request) {
  style: {
    stroke: orange
  }
}

hc-ims -> services.aqueduct: queue provision image {
  style: {
    stroke: orange
  }
}

hc-ims-worker <-> services.aqueduct: process queue {
  style: {
    stroke: orange
  }
}

hc-ims-worker -> services.mysql: insert image version {
  style: {
    stroke: orange
  }
}

services.mysql -> hc-ims-worker: return image version 1 {
  style: {
    stroke: orange
  }
}

hc-ims-worker -> Azure: copy image & create image version {
  style: {
    stroke: orange
  }
}
