default-character-set=utf8mb4
default-collation=utf8mb4_unicode_ci

[development]
schema=blackbird_development
host=mysql
port=3306
user=root
allow-unsafe
skip-alter-wrapper
skip-alter-algorithm
skip-alter-lock

[test]
schema=blackbird_test
host=mysql
port=3306
user=root
allow-unsafe
skip-alter-wrapper
skip-alter-algorithm
skip-alter-lock

[localhost-test]
schema=blackbird_test
host=localhost
port=9945
user=root
allow-unsafe
skip-alter-wrapper
skip-alter-algorithm
skip-alter-lock

[skeema-diff-ci]
schema=skeema:blackbird
host=127.0.0.1
port=3306
user=root

