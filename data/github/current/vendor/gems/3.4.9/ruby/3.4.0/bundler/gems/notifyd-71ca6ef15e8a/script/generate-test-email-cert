#!/bin/bash


# This is generating the certificate and key used in the test server for
# testing sends in the `internal/email` package

cd internal/email/testdata

echo "Generating cert..."
openssl req -new -subj "/C=DE/ST=Berlin/CN=localhost" -newkey rsa:2048 -nodes -keyout localhost.key -out localhost.csr

echo "Signing cert with key..."
openssl x509 -req -days 365 -in localhost.csr -signkey localhost.key -out localhost.crt

