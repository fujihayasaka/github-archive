<cwe-autocomplete>
  <h2 class="mt-4 mb-2 h4">
    <label for="autocomplete-cwes-input">Common weakness enumerator (CWE)</label>
  </h2>
  <%= render(Primer::Beta::AutoComplete.new(
    label_text: "Common weakness enumerator (CWE)",
    visually_hide_label: true,
    src: cwes_path,
    input_id: "autocomplete-cwes-input",
    list_id: "autocomplete-cwes-search",
    full_width: true,
    placeholder: "Search by CWE",
    disabled: disabled?,
    inset: true,
  )) do |auto_complete| %>
    <% auto_complete.with_leading_visual_icon(icon: :search) %>
    <% auto_complete.with_input(
      data: { target: "cwe-autocomplete.autoCompleteInput" },
    ) %>
  <% end %>

  <dl data-target="cwe-autocomplete.linkedCWEList">
    <% cwes.each do |cwe| %>
      <%= render CWEs::LinkedCWERowComponent.new(name_prefix: name_prefix, cwe_id: cwe.cwe_id, cwe_name: cwe.name, disabled: disabled?) %>
    <% end %>
  </dl>

  <template data-target="cwe-autocomplete.linkedCWETemplate">
    <%= render CWEs::LinkedCWERowComponent.new(name_prefix: name_prefix, disabled: disabled?) %>
  </template>
</cwe-autocomplete>
