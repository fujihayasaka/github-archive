#!/usr/bin/env bash

set -e

RUN_PREFIX="$1"
if [[ -z "${RUN_PREFIX}" ]]; then
    echo "Unknown run prefix"
    exit 1
fi

RUN_PREFIX="${RUN_PREFIX,,}" # to lower
RUN_PREFIX="${RUN_PREFIX//-/}" # remove dash symbol

DB_RESPONSE=$(script/db-shell --execute 'SELECT subscription_id, resources_prefix FROM azure_subscription WHERE image_type = "Mixed" LIMIT 1;' --raw-output)
AZURE_SUBSCRIPTION_ID=$(echo $DB_RESPONSE | cut -f1 -d' ')
AZURE_RESOURCES_PREFIX=$(echo $DB_RESPONSE | cut -f2 -d' ')

AQUEDUCT_APP="${RUN_PREFIX}-${AZURE_RESOURCES_PREFIX}"
AZURE_RESOURCE_GROUP="hostedcomputeims-${RUN_PREFIX}-${AZURE_RESOURCES_PREFIX}"


echo "Resources identifiers for IMS"
echo "  - Aqueduct app: $AQUEDUCT_APP"
echo "  - Azure subscription: $AZURE_SUBSCRIPTION_ID"
echo "  - Azure resource group: $AZURE_RESOURCE_GROUP"
echo ""