#!/bin/bash
#/ Usage: script/setup-test-db-for-dev [--force]
#/ Create test databases and an .env file for debugging unit tests that use the database

usage_and_exit() {
  cat "$0" | grep '^#/' | cut -c4-
  exit 1
}

CHECK_ENV=1
while [ $# -gt 0 ]; do
  case "$1" in
    --force)
      CHECK_ENV=0
      shift;;
    *)
      usage_and_exit;;
  esac
done

cd $(git rev-parse --show-toplevel)

if [ $CHECK_ENV -eq 1 ]; then
  if [ -s "./tmp/test-db.env" ]; then
    script/start-db
    echo "Launch test DB already set up. Run $0 --force to set up again."
    exit 0
  fi
fi

script/with-test-db -- bash script/_gen-test-db-env