#!/bin/bash

set -eu

SCRIPT_DIR=$(cd -P -- "$(dirname -- "$0")" && pwd -P)

if [[ "$GITHUB_REPOSITORY" == "github/github" ]]; then
    echo "Skipping AQUEDUCT-lite . Dotcom AQUEDUCT-lite is used instead."
    echo "Make sure that dotcom script/server is running"
    # cat = infinite sleep. Terminating the process here would cause Overmind to terminate the whole script/server.
    cat
fi

${SCRIPT_DIR}/dc up aqueduct-lite
