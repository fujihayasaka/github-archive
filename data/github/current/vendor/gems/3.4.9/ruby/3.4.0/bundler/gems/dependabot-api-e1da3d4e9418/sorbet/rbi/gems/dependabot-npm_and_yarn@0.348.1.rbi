# source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#12
module Dependabot::NpmAndYarn::Helpers
  class << self
    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#342
    sig { returns(T.nilable(::String)) }
    def bun_version; end

    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#119
    sig { params(_bun_lock: T.nilable(::Dependabot::DependencyFile)).returns(::Integer) }
