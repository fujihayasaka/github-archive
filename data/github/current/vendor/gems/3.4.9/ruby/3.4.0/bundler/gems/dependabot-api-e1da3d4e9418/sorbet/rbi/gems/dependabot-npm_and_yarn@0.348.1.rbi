    #
    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#100
    sig { params(pnpm_lock: T.nilable(::Dependabot::DependencyFile)).returns(::Integer) }
    def pnpm_version_numeric(pnpm_lock); end

