    def yarn_berry_disable_scripts?; end

    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#217
    sig { returns(T::Boolean) }
    def yarn_berry_skip_build?; end

    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#152
    sig { returns(T.any(::Integer, T.noreturn)) }
    def yarn_major_version; end

    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#198
    sig { returns(T::Boolean) }
    def yarn_offline_cache?; end

    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#84
    sig { params(yarn_lock: T.nilable(::Dependabot::DependencyFile)).returns(::Integer) }
