    sig { params(lockfile: T.nilable(::Dependabot::DependencyFile)).returns(::Integer) }
    def npm_version_numeric(lockfile); end

    # Prepare the package manager for use by using corepack
    #
    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#477
    sig { params(name: ::String, version: ::String).returns(::String) }
    def package_manager_activate(name, version); end

    # Install the package manager for specified version by using corepack
    #
    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#465
    sig { params(name: ::String, version: ::String, env: T.nilable(T::Hash[::String, ::String])).returns(::String) }
    def package_manager_install(name, version, env: T.unsafe(nil)); end

