  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#829
  sig do
    params(
      handler: T.proc.params(message: ::String, error: ::Dependabot::DependabotError, params: T::Hash[::Symbol, T.untyped]).returns(::Dependabot::DependabotError),
      message: ::String,
      error: ::Dependabot::SharedHelpers::HelperSubprocessFailed,
      params: T::Hash[::Symbol, ::String]
    ).returns(::Dependabot::DependabotError)
  end
  def create_error(handler, message, error, params); end

  # Extracts "Usage Error:" messages from error messages
  #
  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#737
  sig { params(error_message: ::String).returns(T.nilable(::String)) }
  def find_usage_error(error_message); end

  # Main error handling method
  #
  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#747
  sig { params(error: ::Dependabot::SharedHelpers::HelperSubprocessFailed, params: T::Hash[::Symbol, ::String]).void }
  def handle_error(error, params); end

  # Handles errors based on group patterns
  #
  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#799
  sig do
    params(
      error: ::Dependabot::SharedHelpers::HelperSubprocessFailed,
      usage_error_message: ::String,
      params: T::Hash[::Symbol, ::String]
    ).void
  end
  def handle_group_patterns(error, usage_error_message, params); end

  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#876
  sig do
    params(
      error_message: ::String,
      yarn_lock: ::Dependabot::DependencyFile
    ).returns(T::Hash[T.any(::String, ::Symbol), T.nilable(::String)])
  end
  def handle_package_not_found(error_message, yarn_lock); end

  # Handles errors with specific to yarn error codes
  #
  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#763
  sig { params(error: ::Dependabot::SharedHelpers::HelperSubprocessFailed, params: T::Hash[::Symbol, ::String]).void }
  def handle_yarn_error(error, params); end

  # Checks if a package is missing from the error message
  #
  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#912
  sig { params(error_message: ::String).returns(T::Boolean) }
  def package_missing(error_message); end

  # Checks if a pattern is in a message
  #
  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#861
  sig { params(patterns: T::Array[T.any(::Regexp, ::String)], message: ::String).returns(T::Boolean) }
  def pattern_in_message(patterns, message); end

  # Raises a resolvability error for a dependency file
  #
  # @raise [Dependabot::DependencyFileNotResolvable]
  #
  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#848
  sig { params(error_message: ::String, yarn_lock: ::Dependabot::DependencyFile).void }
  def raise_resolvability_error(error_message, yarn_lock); end

  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#919
  sig { params(package_name: T.nilable(::String)).returns(T.nilable(::String)) }
  def sanitize_package_name(package_name); end

  private

  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#728
  sig { returns(T::Array[::Dependabot::Dependency]) }
  def dependencies; end

  # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/file_updater/yarn_lockfile_updater.rb#731
  sig { returns(T::Array[::Dependabot::DependencyFile]) }
  def dependency_files; end
end

