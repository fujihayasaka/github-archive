      params(
        name: ::String,
        command: ::String,
        fingerprint: T.nilable(::String),
        output_observer: T.nilable(T.proc.params(data: ::String).returns(T::Hash[::Symbol, T.untyped])),
        env: T.nilable(T::Hash[::String, ::String])
      ).returns(::String)
    end
    def package_manager_run_command(name, command, fingerprint: T.unsafe(nil), output_observer: T.unsafe(nil), env: T.unsafe(nil)); end

    # Get the version of the package manager by using corepack
    #
    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#498
    sig { params(name: ::String).returns(::String) }
    def package_manager_version(name); end

