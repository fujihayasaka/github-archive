    sig { returns(T.nilable(::String)) }
    def setup_yarn_berry; end

    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#227
    sig { returns(T::Boolean) }
    def yarn_4_or_higher?; end

    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#142
    sig { params(yarn_lock: T.nilable(::Dependabot::DependencyFile)).returns(T::Boolean) }
    def yarn_berry?(yarn_lock); end

    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#204
    sig { returns(::String) }
    def yarn_berry_args; end

    # source://dependabot-npm_and_yarn//lib/dependabot/npm_and_yarn/helpers.rb#222
