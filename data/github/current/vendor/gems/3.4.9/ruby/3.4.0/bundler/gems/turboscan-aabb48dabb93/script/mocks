#!/bin/bash
set -eu
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/ensure-devcontainer.sh"

go install go.uber.org/mock/mockgen

cd "$DIR"/..

echo "==> running mockgen ..."
mockgen -source ts/enabled_status/enabled.go -destination ts/mocks/enabled_status.go -package mocks -mock_names Publisher=HydroEnabledStatusPublisher Publisher
mockgen -source ts/mysql/managedanalysis/managed_analysis.go -destination ts/mocks/managed_analysis.go -package mocks CodeqlRunPublisher
mockgen -source ts/repository.go -destination=ts/mocks/repository.go -package=mocks RepositoriesDatabaseService, Indexer
mockgen -source ts/twirp/clients/ghgh/repository_api.go -destination ts/mocks/repository_api.go -package mocks RepositoryAPI
mockgen -source ts/twirp/clients/ghgh/managed_analyses_api.go -destination ts/mocks/managed_analyses_api.go -package mocks ManagedAnalysesAPI
mockgen -source ts/twirp/clients/ghgh/suggested_fixes_api.go -destination ts/mocks/suggested_fixes_api.go -package mocks SuggestedFixesAPI
mockgen -destination ts/mocks/logger.go -package mocks github.com/github/github-telemetry-go/log Logger
mockgen -destination ts/mocks/stats.go -package mocks -mock_names Client=MockStatsClient github.com/github/go-stats Client
mockgen -source ts/twirp/clients/actions/actions.go -destination ts/mocks/actions.go -package mocks DynamicWorkflowRunner
mockgen -source ts/hydro/consumers/analysis_trigger_processor.go -destination ts/mocks/analysis_trigger_processor.go -package mocks CodeQLRequirement
mockgen -source ts/hydro/publishers/insights_alert_handler.go -destination ts/mocks/insights_publisher.go -package mocks InsightsPublisher
mockgen -source ts/hydro/publishers/alert_handler.go -destination ts/mocks/alert_handler.go -package mocks AlertPublisher
mockgen -source cmd/repo-deleter/root/repo-deleter.go -destination ts/mocks/repo_deleter.go -package mocks
mockgen -source ts/ghapi/repos_audit.go -destination ts/mocks/repos_audits_getter.go -package mocks ReposAuditsGetter
mockgen -source ts/ghapi/workflow_run_annotations.go -destination ts/mocks/workflow_run_annotations_getter.go -package mocks WorkflowRunAnnotationsGetter
mockgen -source ts/delivery_processor/delivery_service.go -destination ts/mocks/delivery_service.go -package mocks DeliveryService
mockgen -source ts/delivery_processor/delivery_processor.go -destination ts/mocks/delivery_processor.go -package mocks Processor AnalysisPublisher StatusService
mockgen -source ts/sarif/store/store.go -destination ts/mocks/sarif_store.go -package mocks SarifStore
mockgen -source ts/managedanalyses/status_service.go -destination ts/mocks/managedanalyses/status_service.go -package mocks StatusService
mockgen -source ts/alertlinks/alert_links.go -destination ts/mocks/alertlinks/alert_links.go -package mocks HydroPublisher
