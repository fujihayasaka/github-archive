#!/bin/bash
# Usage: script/dbdump
# Dumps the production db to a timestamped file

set -e

ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )"/.. && pwd )"
FILE="$ROOT/dumps/dependency_graph_prod.$(date +%s).dump.sql"

$ROOT/bin/dependency-graph-api-rbexec mysqldump --host $DEPENDENCYGRAPH_DB_HOST \
  --user $DEPENDENCYGRAPH_DB_USERNAME \
  --password=$DEPENDENCYGRAPH_DB_PASSWORD \
  $DEPENDENCYGRAPH_DB > $FILE

gzip $FILE
ln -s $FILE "$ROOT/dumps/dependency_graph_prod.latest.sql.gz"

echo Dumped db to $FILE. To download and load, run the following:
echo "scp $(hostname):$FILE.gz ."
