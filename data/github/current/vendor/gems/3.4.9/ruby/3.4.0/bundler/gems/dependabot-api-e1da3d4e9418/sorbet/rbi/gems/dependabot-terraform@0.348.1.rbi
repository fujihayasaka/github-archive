  # source://dependabot-terraform//lib/dependabot/terraform/requirements_updater.rb#160
  sig do
    params(
      new_version: ::Dependabot::Terraform::Version,
      old_version: ::Dependabot::Terraform::Version
    ).returns(::String)
  end
  def at_same_precision(new_version, old_version); end

  # source://dependabot-terraform//lib/dependabot/terraform/requirements_updater.rb#98
  sig { returns(::Dependabot::Terraform::Version) }
  def latest_version; end

  # source://dependabot-terraform//lib/dependabot/terraform/requirements_updater.rb#218
  sig { returns(T.class_of(Dependabot::Terraform::Requirement)) }
  def requirement_class; end

