  sig { returns(T::Array[T::Hash[::Symbol, T.untyped]]) }
  def requirements; end

  # source://dependabot-terraform//lib/dependabot/terraform/requirements_updater.rb#101
  sig { returns(T.nilable(::String)) }
  def tag_for_latest_version; end

  # source://dependabot-terraform//lib/dependabot/terraform/requirements_updater.rb#104
