#!/bin/bash
# Usage: script/run-transition <deployer/actions_workflow_payloads> <version>
#
# Example: script/run-transition deployer 20220322142609
#
# Runs a specific transition version on the specified database
# By default, this script builds launch's binaries, too. The --no-build
# or --fast option disables this.

set -e
set -o pipefail

. script/_serverenv

echo Running transition "$2" on "$1"...
migratorctl transition specific --dbname "$1" --version $2
