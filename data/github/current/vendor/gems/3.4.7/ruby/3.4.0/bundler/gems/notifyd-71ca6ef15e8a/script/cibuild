#!/bin/bash

set -e

source script/bash_fns

# docker compose uses this to decide which config file(s) to use
# If another script sets COMPOSE_FILE already we will use that one
export COMPOSE_FILE=${COMPOSE_FILE:-docker-compose.yml}

function cleanup() {
  echo
  echo "%%%FOLD {Shutting down services...}%%%"
  docker compose down
  echo "%%%END FOLD%%%"
}

trap cleanup EXIT

export CI_MODE=true

output_fold "Starting servers and running tests..." make ci
