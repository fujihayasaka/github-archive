#!/bin/bash

usage() {
  echo "Usage: $0 {run|import|restart <FROM_VERSION_ID>|test|console}"
}

case "$1" in
  run)
    echo "Running adapter..."
    bundle exec rake run
    ;;
  import)
    echo "Running adapter (in full import mode)..."
    bundle exec rake full_import
    ;;
  restart)
    shift
    VERSION_ID="$1"
    echo "Restarting full import from partial event publish at version ID ${VERSION_ID}..."
    bundle exec rake restart_publish["$VERSION_ID"]
    ;;
  test)
    echo "Running adapter tests..."
    bundle exec rake test
    ;;
  console)
    /bin/bash
    ;;
  *)
    usage
    exit 1
esac
