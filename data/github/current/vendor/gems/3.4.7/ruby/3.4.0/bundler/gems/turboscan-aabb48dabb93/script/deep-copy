#!/bin/bash

set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
. "$DIR/ensure-devcontainer.sh"

go install github.com/globusdigital/deep-copy

echo "==> generating deep copy methods ..."
# Skip associations, as we have the IDs
deep-copy -pointer-receiver -o ts/ts_deepcopy.go \
          -type PhysicalAlert \
          -skip Analysis,LastSeenAnalysis,LogicalAlert,Snippet \
          github.com/github/turboscan/ts
