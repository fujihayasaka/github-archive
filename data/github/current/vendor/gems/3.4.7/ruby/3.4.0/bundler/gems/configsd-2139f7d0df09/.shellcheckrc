# ShellCheck configuration file
# This file is automatically picked up by shellcheck in both local development and CI

# Set default shell for files without shebang
shell=bash

# SC1091: Not following sourced files
# Disable this because we often source files that may not exist during static analysis
# (like .env files, generated configs, etc.)
disable=SC1091,SC2155

# You can add more exclusions here as needed:
# disable=SC1091,SC2034,SC2086

# Ignore patterns - exclude files/directories from shellcheck analysis
# Use glob patterns relative to the project root
exclude-dir=.git
exclude-dir=.vscode
exclude-dir=node_modules
exclude-dir=vendor
exclude-dir=bin
exclude-dir=.devcontainer

# Exclude specific file patterns
# exclude=*.example

# To Do: Enable all optional checks
# enable=add-default-case
# enable=avoid-nullary-conditions
# enable=check-unassigned-uppercase
# enable=deprecate-which
# enable=require-variable-braces
# enable=quote-safe-variables
