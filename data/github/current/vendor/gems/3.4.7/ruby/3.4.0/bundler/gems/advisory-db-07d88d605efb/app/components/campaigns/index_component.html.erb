<h2 class="mb-4 d-flex flex-justify-between flex-items-center">
  Review Campaigns
  <%= render(Primer::ButtonComponent.new(tag: :a, href: new_campaign_path, scheme: :primary, variant: :small)) { "New review campaign" } %>
</h2>

<div class="d-flex flex-row">
  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      Status: <%= status.humanize %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <% Campaign::STATUSES.each do |status_filter| %>
            <a role="menuitem" class="SelectMenu-item no-wrap"
              href="<%= url_for(request.query_parameters.merge(status: status_filter, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (status == status_filter ? :visible : :hidden)) %>
              <%= status_filter.humanize %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<%= render(Campaigns::TableComponent.new(campaigns: campaigns, sort: sort)) %>
<%= pagination(campaigns) %>
