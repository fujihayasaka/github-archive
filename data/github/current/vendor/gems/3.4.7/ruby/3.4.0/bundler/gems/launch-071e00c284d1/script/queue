#!/bin/bash
#/ Usage: script/queue '<some-json>'
#/
#/ Queues up the passed in sample payload via aqueduct

set -e

. script/_serverenv

input=$*

encoded=$(echo "$input" | base64)
echo "input: $input encoded: $encoded"

curl -i \
  --header "Content-Type:application/json" \
  --data "{\"app\": \"$AQUEDUCT_APP\", \"queue\":\"$AQUEDUCT_QUEUE_WEBHOOKS\", \"payload\":\"$encoded\", \"redelivery_timeout_secs\":20}" \
  $AQUEDUCT_URL/twirp/aqueduct.api.v1.JobQueueService/Send