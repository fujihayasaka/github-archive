#!/bin/sh

set -e

cd "$(dirname "$0")/.."

# Prime the build context for OS X hosts
if [ "$(uname -s)" = "Darwin" ]; then
  mkdir -p .go_mod_cache/go/pkg/mod
  go mod vendor
fi

docker build --secret id=apt-auth-conf,src=${WORKSPACE}/apt-auth-conf --secret id=pkg-mirror-host,src=${WORKSPACE}/pkg-mirror-host -t github-chatops-template-ci -f Dockerfile.ruby .
