<div class="col-6 p-2 d-flex flex-column">
  <h3 class="h6">
    <% if header_link %>
      <%= render(Primer::Beta::Link.new(href: header_link, target: :_blank, underline: false, scheme: :primary)) { header } %>
    <% else %>
      <%= header %>
    <% end %>
  </h3>
  <div class="flex-1 diff-container mt-2 border rounded-2 color-bg-subtle">
    <%= payload_diff %>
  </div>
</div>
