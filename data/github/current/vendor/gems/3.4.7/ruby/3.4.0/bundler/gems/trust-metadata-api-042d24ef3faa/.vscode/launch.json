    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Server (mysql backend - config/development.json)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "./cmd/tma",
            "args": ["server", "-c", "config/development.yaml"],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Launch Server (in-memory backend)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "./cmd/tma",
            "args": ["server", "-c", "config/development.yaml", "--backend", "memory"],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "debug test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${file}",
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
