<markdown-editor>
  <% if toolbar %>
    <markdown-toolbar data-target="markdown-editor.toolbar" for="<%= text_area_id %>" class="float-right d-flex mt-1 p-2" <%= "hidden" if disabled? %>>
      <div class="mr-3">
        <md-header class="btn-octicon">
          <%= render IconComponent.new(icon: "heading") %>
        </md-header>
        <md-bold class="btn-octicon">
          <%= render IconComponent.new(icon: "bold") %>
        </md-bold>
        <md-italic class="btn-octicon">
          <%= render IconComponent.new(icon: "italic") %>
        </md-italic>
      </div>
      <div class="mr-3">
        <md-quote class="btn-octicon">
          <%= render IconComponent.new(icon: "quote") %>
        </md-quote>
        <md-code class="btn-octicon">
          <%= render IconComponent.new(icon: "code") %>
        </md-code>
        <md-link class="btn-octicon">
          <%= render IconComponent.new(icon: "link") %>
        </md-link>
      </div>
      <div>
        <md-unordered-list class="btn-octicon">
          <%= render IconComponent.new(icon: "list-unordered") %>
        </md-unordered-list>
        <md-ordered-list class="btn-octicon">
          <%= render IconComponent.new(icon: "list-ordered") %>
        </md-ordered-list>
        <md-task-list class="btn-octicon">
          <%= render IconComponent.new(icon: "tasklist") %>
        </md-task-list>
      </div>
    </markdown-toolbar>
  <% end %>
  <%= render(Primer::Alpha::TabPanels.new(label: "Markdown #{attribute}", my: 2, px: px)) do |c| %>
    <% c.with_tab(selected: true, data: { action: disabled? ? nil : "click:markdown-editor#showToolbar" }, classes: "no-outline", panel_id: "#{id_prefix}markdown-editor-component-panel-1", id: "#{id_prefix}markdown-editor-component-tab-1") do |t| %>
      <% t.with_text { "Write" } %>
      <% t.with_panel(mx: px, my: 2, p: 0) do %>
        <%= render FormFieldWithErrorsComponent.new(object: object, attribute: attribute) do %>
          <remote-input src="<%= markdown_preview_path %>" aria-owns=<%= "md-preview-#{component_id}" %> param="content">
            <% text_area_options = {
              id: text_area_id,
              placeholder: placeholder,
              class: "form-control width-full #{text_area_classes}",
              rows: 10,
              disabled: disabled?,
              required: required?,
              data: text_area_data,
              **test_selector_data_hash(attribute)
            } %>
            <% if form %>
              <%= form.text_area attribute, **text_area_options %>
            <% else %>
              <%= text_area_tag attribute, content, **text_area_options %>
            <% end %>
          </remote-input>
        <% end %>
      <% end %>
    <% end %>
    <% c.with_tab(data: { action: disabled? ? nil : "click:markdown-editor#hideToolbar" }, classes: "no-outline", panel_id: "#{id_prefix}markdown-editor-component-panel-2", id: "#{id_prefix}markdown-editor-component-tab-2") do |t| %>
      <% t.with_text { "Preview" } %>
      <% t.with_panel(mx: px, mt: 3, mb: 2, border: :bottom) do %>
        <%= render Primer::Beta::Markdown.new(id: "md-preview-#{component_id}", font_size: 5, p: 1, pb: 3, border: :bottom, style: "min-height: 219px") do %>
          <include-fragment src="<%= markdown_preview_path(content: content) %>">
            <p>Loading preview…</p>
          </include-fragment>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</markdown-editor>
