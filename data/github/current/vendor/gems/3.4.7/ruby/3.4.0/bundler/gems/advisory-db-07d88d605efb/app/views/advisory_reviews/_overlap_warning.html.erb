<% overlapping_advisory_reviews = advisory_review.overlapping_advisory_reviews.to_a %>

<% if overlapping_advisory_reviews.any? %>
  <%= render Primer::Beta::Flash.new(scheme: :warning, icon: "alert", spacious: true, test_selector: "flash-warning") do %>
    This advisory review overlaps with
    <%= pluralize(overlapping_advisory_reviews.count, "advisory review") %>
    based on CVE ID:

    <table class="mt-2 ml-5">
      <% overlapping_advisory_reviews.each do |overlapping_advisory_review| %>
        <tr>
          <td class="pr-3 no-wrap">
            <%= render ReviewStateIconComponent.new(review: overlapping_advisory_review, m: 0) %>
          </td>
          <td class="pr-3 no-wrap">
            <%= render Primer::Beta::Link.new(
              href: advisory_review_path(overlapping_advisory_review),
              scheme: :primary,
              underline: false,
              font_weight: :bold,
            ) do %>
              <%= overlapping_advisory_review.ghsa_id %>
            <% end %>
          </td>
          <td class="no-wrap">
            <%= advisory_review.cve_id || overlapping_advisory_review.cve_id %>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>
<% end %>
