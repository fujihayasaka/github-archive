#!/bin/bash

appdir=$(cd $(dirname "$0")/.. && pwd)
[ -f /etc/app-env ] || exec "$(pwd)/script/app-env" $0 $@

echo "running rubocop..."

if [ ${1:-""} = "--regenerate-todo" ] ; then
  bundle exec rubocop --regenerate-todo
elif [ ${1:-""} = "--strict" ] ; then
  git diff --name-only --staged | grep -v '\.\(json\|ya\?ml\)' | xargs bundle exec rubocop -a -c .rubocop_strict.yml --format offenses "${@:2}"
else
  git diff --name-only --staged | grep -v '\.\(json\|ya\?ml\)' | xargs bundle exec rubocop -a "${@:2}"
fi

echo "done"
