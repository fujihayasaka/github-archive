<%= form_for label, html: { id: "label-form" } do |form| %>
  <h2 class="mb-2 h4">
    <%= form.label :name %>
  </h2>

  <%= render FormFieldWithErrorsComponent.new(object: label, attribute: :name) do %>
    <%= form.text_field :name, class: "form-control width-full", placeholder: "e.g. Do not publish" %>
  <% end %>

  <h2 class="my-2 h4">
    <%= form.label :description %>
  </h2>

  <%= render FormFieldWithErrorsComponent.new(object: label, attribute: :description) do %>
    <%= form.text_field :description, class: "form-control width-full", placeholder: "e.g. A fix commit can't be found but is expected to be available" %>
  <% end %>

  <h2 class="my-2 h4">
    <%= form.label :color %>
  </h2>

  <%= render FormFieldWithErrorsComponent.new(object: label, attribute: :color) do %>
    #
    <%= form.text_field :color, class: "form-control js-color-hex-input" %>
    <% label_component = Labels::LabelComponent.new(name: "", color: label.color) %>
    <button type="button" class="btn-link btn-octicon rounded-2 js-color-preview-button" style="background-color: #<%= label_component.background_color %>; color: #<%= label_component.text_color %>">
      <%= render Primer::Beta::Octicon.new(icon: "sync") %>
    </button>
  <% end %>

  <h2 class="my-2 h4">
    <%= form.label :label_settings %>
  </h2>

  <%= form.fields_for :label_settings, label.label_settings do |settings_fields| %>
    <%= settings_fields.label :hold_publication, class: "mx-2" %>
    <%= settings_fields.check_box :hold_publication, class: "form-control mx-2" %>
  <% end %>
<% end %>
