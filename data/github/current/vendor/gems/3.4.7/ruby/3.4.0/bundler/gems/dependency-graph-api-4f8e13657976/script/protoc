#!/usr/bin/env bash
# Generate Ruby and Go client code from protobuf definition files

set -e
cd "$(dirname "$0")/.."

PROTO_PATH="./proto/twirp/v1"
RUBY_OUTPUT_PATH="./gen/ruby/lib/proto/dependency-graph-api/v1"
GO_OUTPUT_PATH="./gen/go"
GO_VERSION="1.23"

# Ensure output directories exist
mkdir -p "$RUBY_OUTPUT_PATH"
mkdir -p "$GO_OUTPUT_PATH"

# Check if Docker is installed
if ! command -v docker &> /dev/null; then
  echo "Docker is not installed. Please install Docker and try again."
  exit 1
fi

# Build Docker image for protoc
docker build --build-arg GO_VERSION=${GO_VERSION} -t dgapi-protoc config/tools/protoc

# Generate client code for clients
docker run --rm \
  -v $(pwd):/workspace/github.com/github/dependency-graph-api \
  -w /workspace/github.com/github/dependency-graph-api \
  dgapi-protoc \
  --proto_path="$PROTO_PATH" \
  --ruby_out="$RUBY_OUTPUT_PATH" \
  --twirp_ruby_out="$RUBY_OUTPUT_PATH" \
  --go_out="$GO_OUTPUT_PATH" \
  --twirp_out="$GO_OUTPUT_PATH" \
  --experimental_allow_proto3_optional \
  "$PROTO_PATH"/*.proto
