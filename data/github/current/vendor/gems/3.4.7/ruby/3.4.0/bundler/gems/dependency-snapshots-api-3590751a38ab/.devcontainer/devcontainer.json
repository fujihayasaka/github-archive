{
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/github/features/goproxy:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2.11.0": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": {
    "memory": "4gb",
    // Want several CPUs to effectively test concurrency
    "cpus": 4
  },
  "onCreateCommand": ".devcontainer/on-create-command",
  "postCreateCommand": ".devcontainer/post-create-command",
  "postAttachCommand": ".devcontainer/post-attach-command",
  "forwardPorts": [
    9597
  ],
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      }
    }
  },
  "containerEnv": {
    // Set OpenTelemetry log level high enough to reduce noise in the logs.
    // See the repository for more configuration:
    //   https://github.com/github/github-telemetry-ruby#in-development
    "OTEL_LOG_LEVEL": "warn",

    // Set GitHub Telemetry log level to debug since we're in development.
    "GITHUB_TELEMETRY_LOGS_LEVEL": "debug",

    // Env vars for the local services
    "DEPENDENCY_SNAPSHOTS_DB_HOST": "127.0.0.1",
    "DEPENDENCY_SNAPSHOTS_DB_PORT": "3001",
    "DEPENDENCY_SNAPSHOTS_DB": "dependency_snapshots_development",
    "AZURE_STORAGE_BLOB_ENDPOINT": "http://127.0.0.1:20100/devstoreaccount1",

    // Our default docker-compose setup should use MySQL 8
    "COMPOSE_FILE": "docker-compose.yml:docker-compose.mysql8.yml"
  }
}
