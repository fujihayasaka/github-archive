# frozen_string_literal: true

require "bundler/gem_tasks"
require 'rake/testtask'

task default: %i[]

Rake::TestTask.new do |t|
  t.pattern = FileList['test/**/*_test.rb']
  t.verbose = true
end

desc "Run tests against live server"
task :"test-live" do
  ENV['ATTESTER_TEST_SERVER'] = "1"
  Rake::Task['test'].invoke
end

desc "Generate Sorbet RBI files"
task :tapioca do
  sh 'bundle exec tapioca gem'
  sh 'bundle exec tapioca annotations'
  sh 'bundle exec tapioca dsl'
end

desc "Run sorbet type checker"
task :srb do
  sh 'srb tc'
end
