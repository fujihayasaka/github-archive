#!/bin/bash

set -e
set -o nounset

echo Starting mysql...
docker compose up -d

mysql_up() {
  docker compose exec -T mysql mysql -e 'SELECT 1' github_development_spokes >&/dev/null
}

if ! mysql_up; then
  echo Waiting up to 30s for mysql to start...
  for _ in $(seq 1 30); do
    sleep 1
    if mysql_up; then
      break
    fi
  done
fi

exec docker compose up
