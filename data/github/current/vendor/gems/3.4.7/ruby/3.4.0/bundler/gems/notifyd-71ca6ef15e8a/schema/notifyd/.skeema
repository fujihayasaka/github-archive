allow-charset=latin1,utf8mb4,utf8,utf8mb3
default-character-set=utf8mb3
default-collation=utf8mb3_general_ci
lint-display-width=ignore

[development]
flavor=mysql:8.0
host=127.0.0.1
port=3306
schema=notifyd_development

[development_docker]
flavor=mysql:8.0
host=testdb
port=3306
schema=notifyd_development

[staging]
host=db-mysql-7a4f578.azure-eastus.github.net
port=3306
schema=notifyd_staging
user=notifyd_staging_super_0
workspace=docker

[skeema-diff-ci]
host=127.0.0.1
port=3306
schema=skeema:notifyd
user=root
