#!/bin/bash
# This script runs all the usage summary queries for all the different date ranges

set -e

dir=$(dirname $0)

date_ranges=(DATE_RANGE_TYPE_LATEST_MONTH DATE_RANGE_TYPE_PREVIOUS_MONTH DATE_RANGE_TYPE_CURRENT_WEEK DATE_RANGE_TYPE_LAST_30_DAYS DATE_RANGE_TYPE_LAST_90_DAYS DATE_RANGE_TYPE_LAST_YEAR)

for date_range in ${date_ranges[@]}; do
  echo "Running $endpoint with $date_range"
  $dir/../query-usagesummary "" "" $date_range
done
