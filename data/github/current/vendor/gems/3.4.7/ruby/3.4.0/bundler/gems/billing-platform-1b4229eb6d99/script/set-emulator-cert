#!/bin/bash
set -e

EMULATOR_CERT_PATH="/usr/local/share/ca-certificates/emulatorcert.crt"
# The emulator cert file type has been known to switch between the file and directory, hence the -rf option
sudo rm -rf $EMULATOR_CERT_PATH

script/download-emulator-cert

echo "Copying emulator certificate to /usr/local/share/ca-certificates"

# The emulator cert uses Windows style line endings, so we need to convert them to Unix style
sudo sed -i 's/\r /\n/g' emulatorcert.crt
sudo cp emulatorcert.crt $EMULATOR_CERT_PATH
sudo update-ca-certificates