#!/usr/bin/env bash
if [[ -f $HOME/.netrc ]]; then
  # ~/.netrc exists, so we need to filter out any existing entries for goproxy.githubapp.com
  if grep -vq 'machine goproxy.githubapp.com' $HOME/.netrc; then
    grep -v 'machine goproxy.githubapp.com' $HOME/.netrc > $HOME/.netrc.new
    mv $HOME/.netrc.new $HOME/.netrc
  fi
fi

# Add the entry for goproxy to ~/.netrc
echo -e "\nmachine goproxy.githubapp.com login nobody password $GITHUB_TOKEN\n" >> $HOME/.netrc
