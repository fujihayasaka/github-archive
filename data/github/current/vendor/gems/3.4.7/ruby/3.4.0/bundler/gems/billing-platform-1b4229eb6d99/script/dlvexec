#!/bin/bash

if [ -z "$1" ]; then
  echo "Usage: $0 <app_path> <port>"
  exit 1
fi

if [ -z "$2" ]; then
  echo "Usage: $0 <app_path> <port>"
  exit 1
fi

PORT=$1
APP_PATH=$2

# Run the dlv exec command with the provided app path and port
dlv exec --headless --listen :$PORT --api-version=2 --accept-multiclient --continue "$APP_PATH"