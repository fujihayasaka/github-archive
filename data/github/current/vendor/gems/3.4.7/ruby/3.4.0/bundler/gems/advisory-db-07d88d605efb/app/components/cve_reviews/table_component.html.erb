<%= render(Primer::Beta::BorderBox.new) do |border_box| %>
  <% border_box.with_header(display: :flex) do %>
    <div class="review-table-state">State</div>
    <div class="flex-4 pr-1">Title</div>
    <div class="flex-2 pr-1">Package</div>
    <div class="flex-1 pr-1">Severity</div>
    <div class="flex-1 pr-1">Affected versions</div>
    <div class="flex-1 pr-1">Patched versions</div>
    <% if sort.present? %>
      <a class="flex-1 no-underline color-fg-inherit table-date" href="<%= url_for(request.query_parameters.merge(sort: change_sort_param(sort))) %>">
        Date <%= render(IconComponent.new(icon: sort_icon(sort))) %>
      </a>
    <% else %>
      <div class="flex-1 table-date">Date</div>
    <% end %>
  <% end %>

  <% cve_reviews.each do |cve_review| %>
    <% cve_request = current_cve_request(cve_review) %>
    <% border_box.with_row(display: :flex, test_selector: "cve-review-row") do %>
      <div class="review-table-state">
        <%= render(Primer::Beta::Link.new(href: cve_reviews_path(request.query_parameters.merge(state: cve_review.curation_state, page: nil)))) do %>
          <%= render ReviewStateIconComponent.new(review: cve_review) %>
        <% end %>
      </div>
      <%= render(Primer::Truncate.new(classes: "flex-4 pr-1")) do %>
        <%= render(Primer::Beta::Link.new(
          href: cve_review_path(cve_review),
          font_weight: :bold,
          scheme: :primary,
          underline: false,
          pr: 2,
        )) { cve_review.title || cve_request.title } %>
      <% end %>
      <%= render(Primer::Truncate.new(classes: "flex-2 pr-1")) do %>
        <% if package_for(cve_request).present? %>
          <%= render(IconComponent.new(icon: "package", mr: 1)) %>
          <%= package_for(cve_request) %>
        <% else %>
          <span class="color-fg-muted text-italic">None</span>
        <% end %>
      <% end %>
      <div class="flex-1 pr-1">
        <%= render(CVEReviews::SeverityIconComponent.new(severity: cve_request.severity)) %>
      </div>
      <%= render(Primer::Truncate.new(classes: "flex-1 pr-1")) do %>
        <% if affected_versions_for(cve_request).present? %>
          <%= affected_versions_for(cve_request) %>
        <% else %>
          <span class="color-fg-muted text-italic">None</span>
        <% end %>
      <% end %>
      <%= render(Primer::Truncate.new(classes: "flex-1 pr-1")) do %>
        <% if patches_for(cve_request).present? %>
          <%= patches_for(cve_request) %>
        <% else %>
          <span class="color-fg-muted text-italic">None</span>
        <% end %>
      <% end %>
      <div class="table-date flex-1">
        <%= render(Primer::Beta::RelativeTime.new(datetime: cve_request.created_at, tense: :past)) %>
      </div>
    <% end %>
  <% end %>

  <% if cve_reviews.empty? %>
    <% border_box.with_footer(display: :flex, justify_content: :center, test_selector: "no-cve-reviews") { "No CVE reviews to show" } %>
  <% end %>
<% end %>
