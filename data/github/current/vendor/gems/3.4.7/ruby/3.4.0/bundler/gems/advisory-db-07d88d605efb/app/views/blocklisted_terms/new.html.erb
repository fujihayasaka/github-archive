<% content_for :breadcrumbs do %>
  <%= render "breadcrumbs", blocklisted_term: blocklisted_term %>
<% end %>

<header class="pagehead border-bottom pb-3 mb-4">
  <h1 class="mb-2 lh-condensed text-normal">Create a blocklisted term</h1>
</header>

<% if blocklisted_term.errors.any? %>
  <%= render Primer::Beta::Flash.new(scheme: :danger, icon: "hubot", spacious: true, test_selector: "flash-error") do %>
    The blocklisted term could not be created. See details below.
    <% if blocklisted_term.errors.include?(:base) %>
      <ul class="list-style-none ml-5">
        <% blocklisted_term.errors.full_messages_for(:base).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>

<%= render Primer::Alpha::Layout.new(first_in_source: :main) do |layout| %>
  <% layout.with_sidebar(col_placement: :end) do %>
    <div class="position-sticky top-0 mt-n4 pt-4">
      <%= render(Primer::ButtonComponent.new(
        type: :submit,
        form: "blocklisted-term-form",
        display: :flex,
        align_items: :center,
        mb: 2,
        classes: "btn-large width-full"
      )) do %>
        <%= render IconComponent.new(icon: "plus", mr: 3) %>
        Create blocklisted term
      <% end %>
    </div>
  <% end %>

  <% layout.with_main do %>
    <%= form_for blocklisted_term, html: { id: "blocklisted-term-form" } do |form| %>
      <h2 class="mb-2 h4">
        <%= form.label :pattern %>
      </h2>

      <%= render FormFieldWithErrorsComponent.new(object: blocklisted_term, attribute: :pattern) do %>
        <%= form.text_field :pattern, class: "form-control width-full", placeholder: "e.g. Apache Traffic Server" %>
      <% end %>

      <h2 class="my-2 h4">
        <%= form.label :level %>
      </h2>

      <%= render FormFieldWithErrorsComponent.new(object: blocklisted_term, attribute: :type) do %>
        <%= form.select :level, BlocklistedTerm::LEVELS, {}, class: "form-select" %>
      <% end %>

      <h2 class="my-2 h4">
        <%= form.label :term_type %>
      </h2>

      <%= render FormFieldWithErrorsComponent.new(object: blocklisted_term, attribute: :type) do %>
        <%= form.select :term_type, BlocklistedTerm::TYPES, {}, class: "form-select" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
