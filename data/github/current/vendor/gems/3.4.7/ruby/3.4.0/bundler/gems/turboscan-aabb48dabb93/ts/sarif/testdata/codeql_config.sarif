{
  "$schema" : "https://json.schemastore.org/sarif-2.1.0.json",
  "version" : "2.1.0",
  "runs" : [ {
    "tool" : {
      "driver" : {
        "name" : "CodeQL",
        "organization" : "GitHub",
        "semanticVersion" : "0.0.0+removed.for.stability.in.testing",
        "rules" : [ ]
      },
      "extensions" : [ {
        "name" : "pack-scope/ql-pack",
        "semanticVersion" : "0.0.1",
        "locations" : [ {
          "uri" : "file:///placeholder",
          "description" : {
            "text" : "The QL pack root directory."
          }
        }, {
          "uri" : "file:///placeholder",
          "description" : {
            "text" : "The QL pack definition file."
          }
        } ]
      } ]
    },
    "originalUriBaseIds" : {
      "%SRCROOT%" : {
        "uri" : "file:///opt/src",
        "description" : {
          "text" : "The root source location."
        }
      }
    },
    "results" : [ ],
    "columnKind" : "utf16CodeUnits",
    "properties" : {
      "codeqlConfigSummary" : {
        "disableDefaultQueries" : true,
        "queries" : [ {
          "type" : "localQuery",
          "uses" : "./path/to/query.ql"
        }, {
          "type" : "builtinSuite",
          "uses" : "security-extended"
        }, {
          "type" : "externalRepo",
          "uses" : "github/mona/my/awesome/query/suite.qls@main"
        } ]
      },
      "semmle.formatSpecifier" : "sarifv2.1.0",
      "semmle.sourceLanguage" : "java"
    }
  } ]
}
