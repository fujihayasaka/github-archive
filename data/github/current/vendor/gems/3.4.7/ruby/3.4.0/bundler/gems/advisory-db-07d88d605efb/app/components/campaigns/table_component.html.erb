<%= render(Primer::Beta::BorderBox.new) do |border_box| %>
    <% border_box.with_header(display: :flex) do %>
      <div class="flex-1">Name</div>
      <div class="flex-3 px-3">Progress</div>
      <% if sort.present? %>
        <a class="flex-1 no-underline color-fg-inherit table-date" href="<%= url_for(request.query_parameters.merge(sort: change_sort_param(sort))) %>">
          Date <%= render(IconComponent.new(icon: sort_icon(sort))) %>
        </a>
      <% else %>
        <div class="flex-1 table-date">Date</div>
      <% end %>
    <% end %>

    <% campaigns.each do |campaign| %>
      <% border_box.with_row(display: :flex, test_selector: "campaign-row") do %>
        <%= render(Primer::Truncate.new(classes: "flex-1")) do %>
          <%= render(Primer::Beta::Link.new(
            href: campaign_path(campaign),
            font_weight: :bold,
            scheme: :primary,
            underline: false,
            pr: 2,
          )) { campaign.name } %>
        <% end %>
        <div class="flex-3 px-3">
          <%= render "inbox/progress", campaign.progress_counts %>
        </div>
        <div class="table-date flex-1">
          <%= render(Primer::Beta::RelativeTime.new(datetime: campaign.created_at, tense: :past)) %>
        </div>
      <% end %>
    <% end %>

    <% if campaigns.empty? %>
      <% border_box.with_footer(display: :flex, justify_content: :center, test_selector: "no-campaigns") { "No campaigns to show" } %>
    <% end %>
  <% end %>
