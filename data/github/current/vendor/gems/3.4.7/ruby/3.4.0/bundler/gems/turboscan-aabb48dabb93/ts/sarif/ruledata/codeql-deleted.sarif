                "precision": "medium",
                "problem.severity": "recommendation",
                "queryURI": "https://github.com/github/codeql/blob/b7f0b7afb5f0a65fb53b868ebe77b2e5d1b8d29a/java/ql/src/Security/CWE/CWE-611/XXELocal.ql",
                "security-severity": "9.1",
