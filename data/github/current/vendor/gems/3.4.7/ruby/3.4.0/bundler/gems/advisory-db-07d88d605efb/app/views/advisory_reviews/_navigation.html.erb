<%
  current_page =
    case action_name
    when "timeline" then :timeline
    when "diff" then :diff
    else :form # Fall back to the form since many failed actions render it
    end
%>

<%= render(Primer::Alpha::UnderlineNav.new(label: "Advisory review pages")) do |underline_nav| %>
  <% underline_nav.with_tab(href: advisory_review_path(advisory_review), selected: current_page == :form) do |t| %>
    <% t.with_icon(icon: :pencil) %>
    <% t.with_text { "Advisory review" } %>
  <% end %>
  <% underline_nav.with_tab(href: timeline_advisory_review_path(advisory_review), selected: current_page == :timeline) do |t| %>
    <% t.with_icon(icon: :clock) %>
    <% t.with_text { "Timeline" } %>
  <% end %>
  <% if advisory_review.advisory %>
    <% underline_nav.with_tab(href: diff_advisory_review_path(advisory_review), selected: current_page == :diff) do |t| %>
      <% t.with_icon(icon: "file-diff") %>
      <% t.with_text { "Diff" } %>
    <% end %>
  <% end %>
<% end %>
