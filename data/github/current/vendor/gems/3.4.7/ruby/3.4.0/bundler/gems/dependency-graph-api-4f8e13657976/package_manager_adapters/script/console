#!/bin/bash

set -e

cd "$(dirname "$0")/.."

PACKAGE_MANAGER=$1

usage() {
  echo "Usage: script/console PACKAGE_MANAGER [args]"
  echo
  echo "Start bash in the package manager adapter's container"
}

. script/utils

validate
shift

script/build $PACKAGE_MANAGER

docker run \
  --interactive \
  --network host \
  --tty \
  --volume "$(pwd)/data:/data" \
  $(container-tag) \
  console $@
