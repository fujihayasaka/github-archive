{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "launch-worker",
            "type": "go",
            "preLaunchTask": "Register Delve",
            "request": "attach",
            "mode": "local",
            "processId": "launch-worker"
        },
        {
            "name": "launch-deployer",
            "type": "go",
            "preLaunchTask": "Register Delve",
            "request": "attach",
            "mode": "local",
            "processId": "launch-deployer"
        },
        {
            "name": "launch-receiver",
            "type": "go",
            "preLaunchTask": "Register Delve",
            "request": "attach",
            "mode": "local",
            "processId": "launch-receiver"
        },
        {
            "name": "launch-hydro-consumer",
            "type": "go",
            "preLaunchTask": "Register Delve",
            "request": "attach",
            "mode": "local",
            "processId": "launch-hydro-consumer"
        },
        {
            "name": "launch-remote",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 44711,
            "host": "127.0.0.1",
            "debugAdapter": "dlv-dap",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/go/src/github.com/github/launch/",
                },
            ],
        }
    ],
    "inputs": [
        {
            "type": "promptString",
            "id": "pid",
            "description": "PID to debug"
        }
    ]
}
