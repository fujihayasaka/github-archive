{
  "name": "Blackbird Middleware",
  "build": {
    "dockerfile": "../Dockerfile.vscode",
    "context": ".."
  },
  "remoteEnv": {
    "CGO_LDFLAGS": "-g -O2 -L/workspaces/blackbird-mw/lib -ldl -lm"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined",
    "--network=host",
    "--privileged",
    "--init"
  ],
  "hostRequirements": {
		// Specs for 16 cores, 32 RAM, 128 Gb storage for running Blackbird
		"storage": "128gb",
		"memory": "64gb",
		"cpus": 16
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v1",
      "installDockerBuildx": true
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    // This is required to build the blackbirdcore CGO library.
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "minimal"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/blackbird": {
          "permissions": {
            "actions": "write"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "tamasfe.even-better-toml",
        "typespec.typespec-vscode",
        "formulahendry.vscode-mysql",
        "github.copilot",
        "golang.go",
        "hashicorp.terraform",
        "matklad.rust-analyzer",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "ms-vsliveshare.vsliveshare",
        "mutantdino.resourcemonitor",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "mutantdino.resourcemonitor",
        "vadimcn.vscode-lldb",
        "visualstudioexptteam.vscodeintellicode",
        "zxh404.vscode-proto3"
      ],
      "settings": {
        "lldb.executable": "/usr/bin/lldb"
      }
    }
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  "forwardPorts": [
    3001
  ],
  "appPort": [
    3001
  ],
  "portsAttributes": {
    "3001": {
      "label": "mw admin-frontend"
    }
  },
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": ".devcontainer/post-create-command.sh"
}
