#!/usr/bin/env bash
source "script/helpers/_utils.sh"
source "script/helpers/_mysql_utils.sh"
MYSQL_CMD=$(get_mysql_command)

SCHEMA=${1:-github_development_authnd}

if ! $MYSQL_CMD --user=root --port=3001 --protocol=tcp -D $SCHEMA -e "SELECT 1" &> /dev/null ; then
  highlight ">> schema '$SCHEMA' doesn't exist. connecting with no schema..."
  echo
  exec $MYSQL_CMD --user=root --port=3001 --protocol=tcp
else
  highlight ">> connecting to '$SCHEMA' schema..."
  echo
  exec $MYSQL_CMD --user=root --port=3001 --protocol=tcp -D $SCHEMA
fi
