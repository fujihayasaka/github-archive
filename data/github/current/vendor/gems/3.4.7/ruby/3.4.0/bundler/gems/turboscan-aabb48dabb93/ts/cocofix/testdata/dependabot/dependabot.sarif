{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Dependabot",
          "semanticVersion": "2.17.6",
          "rules": [
            {
              "id": "js/breaking-change",
              "name": "BreakingChange",
              "shortDescription": {
                "text": "Breaking change detected when updating axios from version 0.27.2 to 1.7.7"
              },
              "fullDescription": {
                "text": "A breaking change was detected in the updated dependency axios from version 0.27.2 to 1.7.7"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/breaking-change",
          "rule": {
            "id": "js/breaking-change",
            "index": 0
          },
          "level": "error",
          "message": {
            "text": "Cannot use import statement outside a module"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 1,
                  "endLine": 10,
                  "endColumn": 17
                }
              }
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "message": {
                          "text": "const axios = require('axios');"
                        },
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "src/index.js",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 1,
                            "startColumn": 1,
                            "endLine": 1,
                            "endColumn": 32
                          }
                        }
                      }
                    },
                    {
                      "location": {
                        "message": {
                          "text": "const axios = require('axios');"
                        },
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "src/index.test.js",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 2,
                            "startColumn": 1,
                            "endLine": 2,
                            "endColumn": 32
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}