{{define "simple"}}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <title>{{.Subject}}</title>
  <!-- <link href="https://unpkg.com/@primer/css@^16.0.0/dist/primer.css" rel="stylesheet" /> -->
</head>

<body>
  <table class="container-md width-full ml-0">
    <tr>
      <td class="center p-3" valign="top">
        <!-- Header -->
        <table border="0" cellspacing="0" cellpadding="0" class="mb-2" width="100%">
          <tr>
            <td class="mr-2 color-text-tertiary">
              {{ .Subject }}
            </td>
            <td class="color-text-tertiary">
              <!-- eventual place to put trigger -->
              &#xA0;
            </td>
          </tr>
        </table>
        <table border="0" cellspacing="0" cellpadding="0" class="mb-2" width="100%">
          <tr>
            <td>
              <!-- Mail::SpacerComponent.new(size: 16) -->
              <table>
                <tbody>
                  <tr>
                    <td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td>
                  </tr>
                </tbody>
              </table>
            </td>
          </tr>
        </table>

        <!-- Body -->
        <table width="100%" class="width-full">
          <tr>
            <td class="border rounded-2 d-block">
              <table class="width-full text-left">
                <tr>
                  <td class="p-3 p-sm-4">
                    <!-- Mail::ContainerComponent.new -->
                    <table border="0" cellspacing="0" cellpadding="0" class="" width="100%">
                      <tr>
                        <td align="left">{{ .Body }}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>

        <!-- Footer -->
        <table border="0" cellspacing="0" cellpadding="0" width="100%">
          <tr>
            <td>
              <!-- Mail::SpacerComponent.new(size: 16) -->
              <table>
                <tbody>
                  <tr>
                    <td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td>
                  </tr>
                </tbody>
              </table>
              <!-- footer text -->
              <p class="f5 color-text-tertiary">
                &mdash;&mdash;<br>
                You are receiving this email because {{ .Reason }}.
                {{if (ne .URL "") }}
                <a href="{{.URL}}">View on GitHub</a>
                {{ end }}

                {{if (ne .UnsubscribeURL "") }}
                or <a href="{{.UnsubscribeURL}}">unsubscribe</a>
                {{ end }}.
              </p>
              <p class="f5 color-text-tertiary mb-0">
                Triage notifications on the go with GitHub Mobile for
                <a
                  href="https://apps.apple.com/app/apple-store/id1477376905?ct=notification-email&amp;mt=8&amp;pt=524675">iOS</a>
                or
                <a
                  href="https://play.google.com/store/apps/details?id=com.github.android&amp;referrer=utm_campaign%3Dnotification-email%26utm_medium%3Demail%26utm_source%3Dgithub">Android</a>.
              </p>
            </td>
          </tr>
        </table>

        <!-- Footer mailing address-->
        <!-- ContainerComponent.new(classes: "text-center") -->
        <table border="0" cellspacing="0" cellpadding="0" width="100%">
          <tr>
            <td>
              <!-- Mail::SpacerComponent.new(size: 16) -->
              <table>
                <tbody>
                  <tr>
                    <td height="16" style="font-size:16px;line-height:16px;">&#xA0;</td>
                  </tr>
                </tbody>
              </table>
              <!-- content -->
              <p class="f6 color-text-tertiary">GitHub, Inc. ・88 Colin P Kelly Jr Street ・San Francisco, CA 94107</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  <!-- prevent Gmail on iOS font size manipulation -->
  <div style="display:none; white-space:nowrap; font:15px courier; line-height:0;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </div>

  {{if (ne .URL "") }}
  <script type="application/ld+json">
            [{
              "@context": "http://schema.org",
              "@type": "EmailMessage",
              "potentialAction": {
                "@type": "ViewAction",
                "target": {{.URL}},
                "url": {{.URL}},
                "name": "View on GitHub"
              },
              "description": "View on GitHub",
              "publisher": {
                "@type": "Organization",
                "name": "GitHub",
                "url": "https://github.com"
              }
            }]
        </script>
  {{end}}
</body>

</html>
{{end}}