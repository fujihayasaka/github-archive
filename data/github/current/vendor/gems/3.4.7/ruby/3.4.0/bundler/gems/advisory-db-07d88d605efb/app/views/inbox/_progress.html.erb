<%
  total_count ||= 0
  opened_count ||= 0
  published_count ||= 0
  closed_count ||= 0
  skipped_count ||= 0
%>

<% if total_count > 0 %>
  <% done_count = opened_count + published_count + closed_count + skipped_count %>
  <div class="d-flex flex-items-baseline">
    <div class="text-small color-fg-muted mr-2" <%= test_selector("progress-text") %>>
      <%= number_with_delimiter(done_count) %>
      of
      <%= number_with_delimiter(total_count) %>
    </div>

    <div class="flex-1">
      <%= render Primer::Beta::ProgressBar.new(test_selector: "progress-bar") do |progress_bar| %>
        <% if done_count > 0 %>
          <% progress_bar.with_item(percentage: (100 * opened_count / total_count), bg: :accent_emphasis, test_selector: "progress-bar-opened", title: "#{opened_count} opened") if opened_count > 0 %>
          <% progress_bar.with_item(percentage: (100 * published_count / total_count), bg: :done_emphasis, test_selector: "progress-bar-published", title: "#{published_count} published") if published_count > 0 %>
          <% progress_bar.with_item(percentage: (100 * closed_count / total_count), bg: :danger_emphasis, test_selector: "progress-bar-closed", title: "#{closed_count} closed") if closed_count > 0 %>
          <% progress_bar.with_item(percentage: (100 * skipped_count / total_count), bg: :emphasis, test_selector: "progress-bar-skipped", title: "#{skipped_count} skipped") if skipped_count > 0 %>
        <% else %>
          <% progress_bar.with_item(percentage: 0) %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
