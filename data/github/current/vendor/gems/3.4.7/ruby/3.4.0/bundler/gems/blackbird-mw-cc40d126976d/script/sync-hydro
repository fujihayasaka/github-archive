#! /usr/bin/env bash
#/ Usage: sync-hydro [path/to/github/hydro-schemas]
#/
#/   Generate the Hydro protocol buffers required for this application,
#/   using the github/hydro-schemas generator.
#/
#/
#/   The script will check out a copy of github/hydro-schemas in a temporary
#/    directory if the path to a copy is not provided.
#/
#/   OPTIONS:
#/     -h    Show this message and exit.
#/
#/   EXAMPLES:
#/
#/     sync-hydro
#/     sync-hydro ~/github/hydro-schemas
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")/.."

function usage {
    grep "^#/" "${BASH_SOURCE[0]}" | cut -c 4-
}

while getopts ":h" arg; do
    case ${arg} in
        h)
            usage
            exit 1
    esac
done

if [[ $# -eq 0 ]]; then
    echo "Cloning github/hydro-schemas..."
    hydro_dir=$(mktemp -d)
    git clone https://github.com/github/hydro-schemas.git $hydro_dir
else
    hydro_dir=$1
fi

mkdir -p proto/hydro/schemas/blackbird

cp $hydro_dir/proto/hydro/schemas/blackbird/v0/entities/symbol_kind.proto proto/hydro/schemas/blackbird/v0/entities
cp $hydro_dir/proto/hydro/schemas/blackbird/v0/entities/epoch_mode.proto proto/hydro/schemas/blackbird/v0/entities
cp $hydro_dir/proto/hydro/schemas/blackbird/v0/entities/accessible_resources.proto proto/hydro/schemas/blackbird/v0/entities

if [[ $# -eq 0 ]]; then
    rm -rf $hydro_dir
fi
