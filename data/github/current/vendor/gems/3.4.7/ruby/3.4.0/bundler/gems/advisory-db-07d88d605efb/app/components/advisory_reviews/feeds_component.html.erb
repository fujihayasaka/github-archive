<h2 class="mb-2 h4">Feeds Vs. Current Review</h2>

<div class="border rounded-2" <%= test_selector("advisory-review-feeds") %>>
  <%= render(Primer::Alpha::TabPanels.new(label: "Advisory Review Feed Entries", mb: 0, pt: 2, px: 2, bg: :subtle)) do |tab_nav| %>
    <% tab_nav.with_tab(selected: true, panel_id: "unpublished-feeds", id: "unpublished-feeds") do |tab| %>
      <% tab.with_text { "Unpublished" } %>
      <% tab.with_panel(display: :flex, align_items: :stretch, classes: "flex-wrap") do %>
        <% if feed_entries_since_publish.any? %>
          <% feed_entries_since_publish.each do |feed_entry| %>
            <%= render AdvisoryReviews::FeedPayloadComponent.new(feed_entry: feed_entry) %>
          <% end %>
        <% else %>
          <div class="p-4"> No feed updates since last publish.</div>
        <% end %>
      <% end %>
    <% end %>
    <% tab_nav.with_tab(id: "all-feeds", panel_id: "all-feeds") do |tab| %>
      <% tab.with_text { "All" } %>
      <% tab.with_panel(display: :flex, align_items: :stretch, classes: "flex-wrap") do %>
        <% feed_entries.each do |feed_entry| %>
          <%= render AdvisoryReviews::FeedPayloadComponent.new(feed_entry: feed_entry) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
