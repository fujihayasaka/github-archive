{
    "image": "ghcr.io/github/codespaces-base/codespaces-base:latest",
    "onCreateCommand": ".devcontainer/on-create-command.sh",
    "postCreateCommand": ".devcontainer/new-and-improved/post-create-command.sh",
    "postAttachCommand": ".devcontainer/post-attach-command.sh",
    "forwardPorts": [
        3000
    ],
    "containerEnv": {
        "BUNDLE_RUBYGEMS__PKG__GITHUB__COM": "${localEnv:GITHUB_USER}:${localEnv:GITHUB_TOKEN}"
    },
    "privileged": true,
    "customizations": {
        "codespaces": {
            "repositories": {
                "github/features": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                },
                "github/failbot": {
                    "permissions": {
                        "packages": "read"
                    }
                },
                "github/*": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                }
            }
        },
        "vscode": {
            "extensions": [
                "bierner.github-markdown-preview",
                "bierner.markdown-checkbox",
                "bierner.markdown-preview-github-styles",
                "castwide.solargraph",
                "kaiwood.endwise",
                "ms-azuretools.vscode-docker",
                "zxh404.vscode-proto3",
                "Shopify.ruby-extensions-pack"
            ]
        }
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "features": {
        "ghcr.io/github/features/dev-vpn:1": {}
    }
}
