#!/bin/bash
# Usage: start-azurite
# Starts the Azurite docker container.

set -e

. script/_serverenv

# app config
APP_ROOT="$(git rev-parse --show-toplevel)"

start_azurite() {
  quiesce_unless_error \
    script/docker-compose up -d azurite
  quiesce_unless_error \
    script/retry script/docker-compose up azurite_init
}

quiesce_unless_error() {
  if ! "$@" &> "$APP_ROOT/tmp/azurite.log"; then
    echo "$* failed:"
    cat "$APP_ROOT/tmp/azurite.log"
    exit 1
  fi
}

(cd "$APP_ROOT" && start_azurite)
