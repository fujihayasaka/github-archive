#!/bin/bash

set -uo pipefail

appdir=$(cd $(dirname "$0")/.. && pwd)
[ -f /etc/app-env ] || exec "$appdir/script/app-env" $0 $@

mysql_user="root"
mysql_host="db" ; [ "${CODESPACES:-}" = "true" ] && mysql_host="127.0.0.1"
mysql_port="3307"
for i in {1..180}; do
  mysql -h $mysql_host -P $mysql_port -u $mysql_user -e "select 1" >/dev/null && exit
  sleep 1
done

echo "Unable to reach database!"
exit 1
