  Customer: Customer images
}

IMSProxima2: IMS Proxima 2 {
  Customer: Customer images
}

Runner.CurMar <-> IMSProduction.CurMar
Runner.Customer <-> IMSProduction.Customer

IMSProduction.CurMar <-> RunnerProxima1.CurMar
IMSProduction.CurMar <-> RunnerProxima2.CurMar

RunnerProxima1.Customer <-> IMSProxima1.Customer
RunnerProxima2.Customer <-> IMSProxima2.Customer
