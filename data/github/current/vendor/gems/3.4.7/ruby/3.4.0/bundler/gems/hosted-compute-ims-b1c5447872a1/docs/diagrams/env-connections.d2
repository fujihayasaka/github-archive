direction: down
vars: {
  d2-config: {
    theme-id: 0
    layout-engine: elk
  }
}

Runner: Runner (All rings) {
  CurMar: Curated & Marketplace\nimages
  Customer: Customer images
}

RunnerProxima1: Runner Proxima 1 {
  CurMar: Curated & Marketplace\nimages
  Customer: Customer images
}

RunnerProxima2: Runner Proxima 2 {
  CurMar: Curated & Marketplace\nimages
  Customer: Customer images
}

IMSProduction: IMS Production {
  CurMar: Curated & Marketplace\nimages
  Customer: Customer images
}

IMSLab: IMS Lab {
  CurMar: Curated & Marketplace\nimages
  Customer: Customer images
}

