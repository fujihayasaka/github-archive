# This class does version resolution for pip-compile. Its approach is:
# - Unlock the dependency we're checking in the requirements.in file
# - Run `pip-compile` and see what the result is
#
# source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#27
class Dependabot::Python::UpdateChecker::PipCompileVersionResolver
  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#64
  sig do
    params(
      dependency: ::Dependabot::Dependency,
      dependency_files: T::Array[::Dependabot::DependencyFile],
      credentials: T::Array[::Dependabot::Credential],
      repo_contents_path: T.nilable(::String)
    ).void
  end
  def initialize(dependency:, dependency_files:, credentials:, repo_contents_path:); end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#48
  sig { returns(T::Array[::Dependabot::Credential]) }
  def credentials; end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#42
  sig { returns(::Dependabot::Dependency) }
  def dependency; end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#45
  sig { returns(T::Array[::Dependabot::DependencyFile]) }
  def dependency_files; end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#54
  sig { returns(::Dependabot::Python::PipCompileErrorHandler) }
  def error_handler; end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#74
  sig { params(requirement: T.nilable(::String)).returns(T.nilable(::Dependabot::Python::Version)) }
  def latest_resolvable_version(requirement: T.unsafe(nil)); end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#51
  sig { returns(T.nilable(::String)) }
  def repo_contents_path; end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#89
  sig { params(version: ::Gem::Version).returns(T::Boolean) }
  def resolvable?(version:); end

  private

  # Needed because pip-compile's resolver isn't perfect.
  # Note: We raise errors from this method, rather than returning a
  # boolean, so that all deps for this repo will raise identical
  # errors when failing to update
  #
  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#238
  sig { returns(T::Boolean) }
  def check_original_requirements_resolvable; end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#421
  sig { params(message: ::String).returns(::String) }
  def clean_error_message(message); end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#162
  sig { params(error: ::Dependabot::SharedHelpers::HelperSubprocessFailed).returns(T::Boolean) }
  def compilation_error?(error); end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#122
  sig { params(filename: ::String).returns(T::Boolean) }
  def compile_file(filename); end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#444
  sig { params(filename: ::String).returns(T.nilable(::Dependabot::DependencyFile)) }
  def compiled_file_for_filename(filename); end

  # source://dependabot-python//lib/dependabot/python/update_checker/pip_compile_version_resolver.rb#462
