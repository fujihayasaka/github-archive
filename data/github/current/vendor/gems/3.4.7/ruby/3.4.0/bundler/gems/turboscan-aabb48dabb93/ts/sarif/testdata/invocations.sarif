time/instance.ts"}},{"location":{"uri":"file:///codacy/packages/element/src/api/watch.ts"}},{"location":{"uri":"file:///codacy/packages/element/src/runtime/compiler.ts"}},{"location":{"uri":"file:///codacy/packages/html/src/shared.ts"}}]},{"tool":{"driver":{"name":"Remark-lint (reported by Codacy)","version":"7.0.1","informationUri":"https://www.codacy.com","rules":[{"id":"remark-lint-list-item-spacing","name":"Warn when list looseness is incorrect, such as being tight when it should","shortDescription":{"text":"Warn when list looseness is incorrect, such as being tight when it should"},"help":{"text":"Warn when list looseness is incorrect, such as being tight when it should","markdown":"Warn when list looseness is incorrect, such as being tight when it should\nbe loose, and vice versa.\n\nAccording to the [`markdown-style-guide`](http://www.cirosantilli.com/markdown-style-guide/),\nif one or more list items in a list spans more than one line, the list is\nrequired to have blank lines between each item.\nAnd otherwise, there should not be blank lines between items.\n\nBy default, all items must be “loose” (a blank line must be between them)\nif one or more items are multiline (span more than one line).\nOtherwise, the list must be tight (no blank line must be between items).\n\nIf you pass `{checkBlanks: true}`, all items must be “loose” if one or more\nitems contain blank lines.\nOtherwise, the list must be tight."},"properties":{"category":"CodeStyle"}},{"id":"remark-lint-table-pipe-alignment","name":"Warn when table pipes are not aligned.","shortDescription":{"text":"Warn when table pipes are not aligned."},"help":{"text":"Warn when table pipes are not aligned.","markdown":"Warn when table pipes are not aligned.\n\n## Fix\n\n[`remark-stringify`](https://github.com/remarkjs/remark/tree/HEAD/packages/remark-stringify)\ntries to align tables by default.\nPass\n[`paddedTable: false`](https://github.com/remarkjs/remark/tree/HEAD/packages/remark-stringify#optionspaddedtable)\nto not align cells.\n\nAligning cells perfectly is impossible as some characters (such as emoji or\nChinese characters) are rendered differently in different browsers,\nterminals, and editors.\nYou can pass your own\n[`stringLength`](https://github.com/remarkjs/remark/tree/HEAD/packages/remark-stringify#optionsstringlength)\nfunction to customize how cells are aligned.\nIn that case, this rule must be turned off.\n\nSee [Using remark to fix your Markdown](https://github.com/remarkjs/remark-lint#using-remark-to-fix-your-markdown)\non how to automatically fix warnings for this rule."},"properties":{"category":"CodeStyle"}},{"id":"remark-lint-no-shortcut-reference-link","name":"Warn when shortcut reference links are used.","shortDescription":{"text":"Warn when shortcut reference links are used."},"help":{"text":"Warn when shortcut reference links are used.","markdown":"Warn when shortcut reference links are used.\n\nShortcut references render as links when a definition is found, and as\nplain text without definition.\nSometimes, you don’t intend to create a link from the reference, but this\nrule still warns anyway.\nIn that case, you can escape the reference like so: `\\[foo]`."},"properties":{"category":"CodeStyle"}},{"id":"remark-lint-no-undefined-references","name":"Warn when references to undefined definitions are found.","shortDescription":{"text":"Warn when references to undefined definitions are found."},"help":{"text":"Warn when references to undefined definitions are found.","markdown":"Warn when references to undefined definitions are found.\n\nOptions: `Object`, optional.\n\nThe object can have an `allow` field, set to an array of strings that may\nappear between `[` and `]`, but that should not be treated as link\nidentifiers."},"properties":{"category":"CodeStyle"}},{"id":"remark-lint-no-consecutive-blank-lines","name":"Warn for too many consecutive blank lines.","shortDescription":{"text":"Warn for too many consecutive blank lines."},"help":{"text":"Warn for too many consecutive blank lines.","markdown":"Warn for too many consecutive blank lines.\nKnows about the extra line needed between a list and indented code, and two\nlists.\n\n## Fix\n\n[`remark-stringify`](https://github.com/remarkjs/remark/tree/HEAD/packages/remark-stringify)\nalways uses one blank line between blocks if possible, or two lines when\nneeded.\n\nSee [Using remark to fix your Markdown](https://github.com/remarkjs/remark-lint#using-remark-to-fix-your-markdown)\non how to automatically fix warnings for this rule."},"properties":{"category":"CodeStyle"}},{"id":"remark-lint-heading-increment","name":"Warn when headings increment with more than 1 level at a time.","shortDescription":{"text":"Warn when headings increment with more than 1 level at a time."},"help":{"text":"Warn when headings increment with more than 1 level at a time.","markdown":"Warn when headings increment with more than 1 level at a time."},"properties":{"category":"CodeStyle"}}]}},"results":[{"ruleIndex":4,"ruleId":"remark-lint-no-consecutive-blank-lines","message":{"text":"[no-consecutive-blank-lines] Remove 1 line before node"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"index":10,"uri":"file:///codacy/packages/store/CHANGELOG.md"},"region":{"startLine":9,"startColumn":1}}}],"partialFingerprints":{"primaryLocationStartColumnFingerprint":"1","primaryLocationLineHash":"77cb843eaec379d6834b1088072e1f58"}},{"ruleIndex":4,"ruleId":"remark-lint-no-consecutive-blank-lines","message":{"text":"[no-consecutive-blank-lines] Remove 1 line before node"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"index":10,"uri":"file:///codacy/packages/store/CHANGELOG.md"},"region":{"startLine":4,"startColumn":1}}}],"partialFingerprints":{"primaryLocationStartColumnFingerprint":"1","primaryLocationLineHash":"74e82b65e64396b41df65cdd53c0211f"}},{"ruleIndex":5,"ruleId":"remark-lint-heading-increment","message":{"text":"[heading-increment] Heading levels should increment by one level at a time"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"index":10,"uri":"file:///codacy/packages/store/CHANGELOG.md"},"region":{"startLine":4,"startColumn":1}}}],"partialFingerprints":{"primaryLocationStartColumnFingerprint":"1","primaryLocationLineHash":"34830b661a9fb43ae94f33a2df46e588"}},{"ruleIndex":5,"ruleId":"remark-lint-heading-increment","message":{"text":"[heading-increment] Heading levels should increment by one level at a time"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"index":5,"uri":"file:///codacy/packages/shared/CHANGELOG.md"},"region":{"startLine":4,"startColumn":1}}}],"partialFingerprints":{"primaryLocationStartColumnFingerprint":"1","primaryLocationLineHash":"c69533e1950194e0400d1435a942726a"}},{"ruleIndex":4,"ruleId":"remark-lint-no-consecutive-blank-lines","message":{"text":"[no-consecutive-blank-lines] Remove 1 line before node"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"index":5,"uri":"file:///codacy/packages/shared/CHANGELOG.md"},"region":{"startLine":4,"startColumn":1}}}],"partialFingerprints":{"primaryLocationStartColumnFingerprint":"1","primaryLocationLineHash":"10d3f6321ad8f2f28d9295b8dae0d1fd"}},{"ruleIndex":0,"ruleId":"remark-lint-list-item-spacing","message":{"text":"[list-item-spacing] Missing new line after list item"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"index":2,"uri":"file:///codacy/README.md"},"region":{"startLine":99,"startColumn":1}}}],"partialFingerprints":{"primaryLocationStartColumnFingerprint":"1","primaryLocationLineHash":"9aca85b06490aee174a93553d19d8f91"}},{"ruleIndex":0,"ruleId":"remark-lint-list-item-spacing","message":{"text":"[list-item-spacing] Missing new line after list item"},"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"index":2,"uri":"file:///codacy/README.md"},"region":{"startLine":107,"startColumn":1}}}],"partialFingerprints":{"primaryLoc