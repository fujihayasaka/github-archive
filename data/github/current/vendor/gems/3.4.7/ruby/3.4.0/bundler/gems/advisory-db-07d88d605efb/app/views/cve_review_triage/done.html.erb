<div class="d-flex">
  <div class="col-6 offset-3">
    <%= render "progress", {
      opened_count: opened_count,
      closed_count: closed_count,
      skipped_count: skipped_count,
      total_count: total_count,
    } %>

    <%= render Primer::BlankslateComponent.new(
      icon: "smiley",
      title: "Triage zero!",
      narrow: true,
      large: true,
      spacious: true,
      test_selector: "triage-zero",
    ) do %>
      <% if skipped_count.zero? %>
        <p>Every CVE review has been triaged.</p>
      <% else %>
        <p class="mb-4">
          Well… <em>almost</em> zero!
          You skipped <%= number_with_delimiter(skipped_count) %> <%= "review".pluralize(skipped_count) %>.
        </p>
        <p>
          <%= render Primer::ButtonComponent.new(tag: :a, href: cve_review_triage_index_path, test_selector: "cve-review-triage-link", autofocus: true) do %>
            Triage remaining CVE <%= "review".pluralize(skipped_count) %>
          <% end %>
        </p>
      <% end %>

      <p>
        <%= render Primer::ButtonComponent.new(scheme: :invisible, tag: :a, href: cve_reviews_path, test_selector: "cve-reviews-link", autofocus: skipped_count.zero?) do %>
          See all open CVE reviews
        <% end %>
      </p>
    <% end %>
  </div>
</div>
