#!/usr/bin/env bash
#
#/ Usage: script/ci/detect_uncommitted_changes
#/ Intended to be run by CI to verify that any auto-generated file changes have been committed

set -e

# --exit-code returns 0 if no changes, 1 if changes
if [[ $(git diff --exit-code) ]]; then
  echo "Some files have changed. Please regenerate files locally, commit and push the changes."
  git diff
  exit 1
fi

echo "No uncommitted changes detected"