#!/usr/bin/env bash

set -eo pipefail

# Usage:
#   script/seed-dev-data [--reset]
# This script will seed the database with enough test data to run
# basic queries. If you pass `--reset`, it will also clear the
# database first.

# check if --clear was passed in
if [ "$1" = "--reset" ]; then
  echo "Resetting database..."
  ./bin/ds-migrate reset
fi

# switch to the root of the project
cd "$(dirname "$0")/.."

mysql -u root dependency_snapshots_development -h 127.0.0.1 -P 3001 < script/helpers/dev-data.sql
echo "Seed data has been added to the database."

