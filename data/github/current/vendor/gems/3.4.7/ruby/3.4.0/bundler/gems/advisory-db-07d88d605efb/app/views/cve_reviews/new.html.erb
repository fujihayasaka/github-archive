<%= render Primer::Alpha::Layout.new(first_in_source: :main) do |layout| %>
  <% layout.with_sidebar(col_placement: :end) do %>
    <div class="position-sticky top-0 mt-n4 pt-4">
      <%= render(Primer::ButtonComponent.new(
        type: :submit,
        form: "cve-review-form",
        display: :flex,
        align_items: :center,
        mb: 2,
        classes: "btn-large width-full",
        test_selector: "cve-review-sidebar-button"
      )) do %>
        <%= render IconComponent.new(icon: "plus", mr: 3) %>
        Create CVE review
      <% end %>
    </div>
  <% end %>

  <% layout.with_main do %>
    <%= render(CVEReviews::FormComponent.new(cve_review: @cve_review, cve_request: @cve_request, can_edit_confirm_reference: true, can_edit_internal: true, can_edit_vendor_name_and_product: true, expanded_edit_confirm_reference: true, expanded_internal: true, read_only_form: false)) %>
  <% end %>
<% end %>
