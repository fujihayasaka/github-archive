<% if flash[:notice] %>
  <%= render Primer::Beta::Flash.new(scheme: :success, icon: "thumbsup", spacious: true, test_selector: "flash-notice") do %>
    <%= flash[:notice] %>
  <% end %>
<% end %>
<% if flash[:alert] %>
  <%= render Primer::Beta::Flash.new(scheme: :danger, icon: "hubot", spacious: true, test_selector: "flash-alert") do %>
    <%= flash[:alert] %>
  <% end %>
<% end %>
<% if flash[:warning] %>
  <%= render Primer::Beta::Flash.new(scheme: :warning, icon: "alert", spacious: true, test_selector: "flash-warning") do %>
    <%= flash[:warning] %>
  <% end %>
<% end %>
