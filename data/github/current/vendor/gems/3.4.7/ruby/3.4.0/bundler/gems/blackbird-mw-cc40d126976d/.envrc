# Use https://direnv.net/ to load this automatically.

# Source in .env
dotenv

# Set CGO_LDFLAGS (platform specific) so that we can build/link against the blackbird clibs.
export CGO_LDFLAGS="-g -O2 -L$(pwd)/lib"
if [[ $OSTYPE == "darwin"* ]]; then
   # This reqwest PR requires linking SystemConfiguration on macOS: https://github.com/seanmonstar/reqwest/pull/1955
   export CGO_LDFLAGS="$CGO_LDFLAGS -framework SystemConfiguration"
   # This is still required for ARM macs for some reason.
   export CGO_LDFLAGS="$CGO_LDFLAGS -L$(brew --prefix openssl)/lib"
else
   export CGO_LDFLAGS="$CGO_LDFLAGS -ldl -lm"
fi
