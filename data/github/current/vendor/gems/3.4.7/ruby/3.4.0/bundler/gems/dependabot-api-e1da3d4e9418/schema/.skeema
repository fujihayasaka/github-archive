allow-auto-inc="int unsigned, bigint unsigned, bigint"
allow-charset="utf8, utf8mb3, utf8mb4"
default-character-set=utf8mb4
default-collation=utf8mb4_general_ci
ignore-schema=dependabot_test|enterprise_*

[dependabot]
host=db-mysql-dependabot-rw.service.github.net
port=3306

[development]
flavor=mysql:8.0
host=db
port=3307
user=root

[development-codespaces]
flavor=mysql:8.0
host=127.0.0.1
port=3307
user=root

[skeema-diff-ci]
host=127.0.0.1
port=3306
user=root
