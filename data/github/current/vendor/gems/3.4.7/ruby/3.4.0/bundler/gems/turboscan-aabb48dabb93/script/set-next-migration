#!/bin/bash

set -eu
set -o pipefail
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
. "$DIR/ensure-devcontainer.sh"

usage() {
cat << USAGE
  usage: $0 <timestamp>
USAGE
  if [[ ! -z "${1-}" ]]; then
    printf "\n!! ERROR: $1\n"
  fi
  exit 1
}

if [[ $# -lt 1 ]]; then
  usage``
fi

# add a comment to the previous migration to allow verification of migration ordering
echo -e "# IF YOU ARE ADDING A NEW MIGRATION THIS FILE SHOULD POINT TO YOUR MIGRATION\n# this file is autogenerated to ensure that\n# your migration is always added to the end of the migration chain\n# if this file conflicts, please make sure to update your transition timestamp to be higher\n# than the new latest transition and then update this file\n\n$1" | tee "$DIR/../migrations/LATEST" > /dev/null
