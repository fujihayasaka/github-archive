# Note: if you change any of the MySQL hosts in here, you'll also need to
# change the values in config/kustomize/overlays

# Skeema's default environment is called "production",
# Our production environment is going to be called
# "osslicensecompliance". So, to make things easier in dev, skeema's
# "production" environment will be the same as OLC's
# "dev" environment.

default-character-set=utf8mb4
default-collation=utf8mb4_general_ci
flavor=mysql:8.0
lax-column-order

# "production" is skeema's default environment, but it's our dev environment.
[production]
schema=olc_dev
host=127.0.0.1
port=3306
user=root

# Note: the below _cannot_ be correct for schema migrations, but we're
# working on getting Skeefree working.
[staging]
schema=osslicensecompliance_staging
host=$OLC_MYSQL_STAGING_HOST
port=$OLC_MYSQL_STAGING_PORT
user=osslicensecompliance_st_super_0
workspace=docker
default-character-set=utf8mb3
default-collation=utf8mb3_general_ci

# See https://github.com/github/skeefree/blob/master/docs/adding-repository.md
[skeema-diff-ci]
host=127.0.0.1
port=3306
user=root
