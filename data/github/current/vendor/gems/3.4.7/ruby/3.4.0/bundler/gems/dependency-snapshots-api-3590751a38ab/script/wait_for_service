#!/bin/bash

# wait_for_service waits 10 seconds for the ds-api "_ping" endpoint to return a 200
# When it becomes healthy, it returns 0.
# If the service does not come up, it returns 1.
function wait_for_service() {
  echo "waiting for _ping endpoint to return 200..."

  for i in {1..10}
  do
    status=$(curl -s http://localhost:9597/_ping)
    if [ "$status" = "pong" ]; then
      echo "service is ready"
      exit 0
    fi
    echo "service is not ready yet"
    sleep 1
  done

  echo "Service failed to start within 10 seconds"
}

wait_for_service
