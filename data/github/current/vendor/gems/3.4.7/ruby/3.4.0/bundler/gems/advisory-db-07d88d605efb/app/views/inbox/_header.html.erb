<div class="Header">
  <div class="Header-item mr-5">
    <%= link_to root_path, class: "Header-link d-flex flex-items-center" do %>
      <%= render IconComponent.new(icon: "mark-github", height: 32, mx: 3, classes: ApplicationComponent.staging? ? "staging-gradient-icon" : "") %>
      <span class="f3-light">Advisory Inbox</span>
      <% if ApplicationComponent.staging? %>
        <span class="staging-title-label h6">Staging</span>
      <% end %>
    <% end %>
  </div>

  <div class="Header-item ml-3">
    <%= link_to cve_review_triage_index_path, class: "Header-link" do %>
      CVE triage
      <%= render Primer::Beta::Counter.new(count: in_triage_cve_review_count, ml: 1, scheme: :primary) %>
    <% end %>
  </div>

  <div class="Header-item ml-3">
    <%= link_to cve_reviews_path, class: "Header-link" do %>
      CVE review
      <%= render Primer::Beta::Counter.new(count: open_cve_review_count, ml: 1, scheme: :primary) %>
    <% end %>
  </div>

  <div class="Header-item ml-3">
    <%= link_to advisory_reviews_path, class: "Header-link" do %>
      Advisory review
      <%= render Primer::Beta::Counter.new(count: open_advisory_review_count, ml: 1, scheme: :primary) %>
    <% end %>
  </div>

  <div class="Header-item ml-3">
    <%= link_to advisory_reviews_path(state: :ready), class: "Header-link" do %>
      Advisory publication
      <%= render Primer::Beta::Counter.new(count: ready_advisory_review_count, ml: 1, scheme: :primary) %>
    <% end %>
  </div>

  <div class="Header-item ml-3">
    <%= render Primer::Beta::Details.new(reset: true, overlay: :default, position: :relative) do |details| %>
      <% details.with_summary(button: false, classes: "no-outline Header-link", aria: { haspopup: true }) do %>
        Tools
        <div class="dropdown-caret ml-1"></div>
      <% end %>

      <% details.with_body(left: false, classes: "SelectMenu") do %>
        <div class="SelectMenu-modal">
          <div class="SelectMenu-list">
            <%= link_to blocklisted_terms_path, role: "menuitem", class: "SelectMenu-item" do %>
              Blocklisted Terms
            <% end %>
            <%= link_to cves_path, role: "menuitem", class: "SelectMenu-item" do %>
              CVEs
            <% end %>
            <%= link_to labels_path, role: "menuitem", class: "SelectMenu-item" do %>
              Labels
            <% end %>
            <%= link_to campaigns_path, role: "menuitem", class: "SelectMenu-item" do %>
              Review Campaigns
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>


  <div class="Header-item--full"></div>

  <div class="Header-item">
    <%= form_tag(search_path, method: :get) do %>
      <%= hidden_field_tag "search_type", params[:search_type] %>
      <%= text_field_tag "search_query", params[:search_query], placeholder: "Search CVE/GHSA IDs...", autocomplete: "off", class: "form-control" %>
    <% end %>
  </div>

  <% if current_user %>
    <div class="Header-item">
      <%= render Primer::Beta::Details.new(reset: true, overlay: :default, position: :relative) do |details| %>
        <% details.with_summary(button: false, classes: "no-outline", aria: { haspopup: true }) do %>
          <%= render(Primer::Beta::Avatar.new(src: current_user.avatar_url, alt: current_user.login, size: 20)) %>
          <div class="dropdown-caret"></div>
        <% end %>

        <% details.with_body(right: false, classes: "SelectMenu") do %>
          <div class="SelectMenu-modal">
            <header class="SelectMenu-header">
              <h3 class="SelectMenu-title color-fg-muted">Signed in as <span class="color-fg-default"><%= current_user.login %></span></h3>
            </header>
            <div class="SelectMenu-list">
              <div class="SelectMenu-divider">Appearance Settings</div>
              <%= button_to set_color_mode_path,
                params: { mode: "auto" },
                role: "menuitem",
                class: "SelectMenu-item",
                data: { set_color_mode: "auto" },
                aria: { checked: current_user.color_mode == "auto" },
                remote: true do %>
                <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
                Color Mode: Auto
              <% end %>
              <%= button_to set_color_mode_path,
                params: { mode: "light" },
                role: "menuitem",
                class: "SelectMenu-item",
                data: { set_color_mode: "light" },
                aria: { checked: current_user.color_mode.nil? || current_user.color_mode == "light" },
                remote: true do %>
                <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
                Color Mode: Light
              <% end %>
              <%= button_to set_color_mode_path,
                params: { mode: "dark"},
                role: "menuitem",
                class: "SelectMenu-item",
                data: { set_color_mode: "dark" },
                aria: { checked: current_user.color_mode == "dark" },
                remote: true do %>
                <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon SelectMenu-icon--check") %>
                Color Mode: Dark
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<% if content_for?(:breadcrumbs) || content_for?(:navigation) %>
  <div class="px-5 pt-2 border-bottom color-bg-subtle">
    <% if content_for?(:breadcrumbs) %>
      <div class="pt-2 pb-3">
        <%= content_for(:breadcrumbs) %>
      </div>
    <% end %>

    <% if content_for?(:navigation) %>
      <div class="secondary-nav">
        <%= content_for(:navigation) %>
      </div>
    <% end %>
  </div>
<% end %>
