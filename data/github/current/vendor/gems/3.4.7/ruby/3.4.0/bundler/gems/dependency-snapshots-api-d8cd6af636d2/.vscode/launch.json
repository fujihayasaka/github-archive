{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CosmosDB Test",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/cosmosdb-test",
    },
    {
      "name": "Launch Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/cmd/api",
      "env": {
        // Want to test HMAC authentication locally? Uncomment below
        // "DEV_FORCE_HMAC_AUTHENTICATION": "1",

        // Want to test tracing locally? Uncomment the next line
        //
        // "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://127.0.0.1:4318/v1/traces",
        //
        // And run:
        // docker run --rm --name jaeger \
        //  -e COLLECTOR_ZIPKIN_HOST_PORT=:9411 \
        //  -e COLLECTOR_OTLP_ENABLED=true \
        //  -p 6831:6831/udp \
        //  -p 6832:6832/udp \
        //  -p 5778:5778 \
        //  -p 16686:16686 \
        //  -p 4317:4317 \
        //  -p 4318:4318 \
        //  -p 14250:14250 \
        //  -p 14268:14268 \
        //  -p 14269:14269 \
        //  -p 9411:9411 \
        //  jaegertracing/all-in-one:latest
        //
        //  And visit http://localhost:16686/search to see traces

        "CGO_ENABLED": "0",
        // Want to fake gitaccess locally (e.g. not running in a dotcom env)?
        // "DEV_STANDALONE_MODE": true,
        // Want to have stats output go to the console?
        // "USE_CONSOLE_STATTER": true,
      },
    },
    {
      "name": "Launch Migrator",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/cmd/migrate",
      "args": ["all"],
      "env": {
        "CGO_ENABLED": "0",
      },
    },
  ]
}
