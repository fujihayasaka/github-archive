#!/bin/bash
set -e

ALLOWED_COUNT=107

FOUND_COUNT=$(grep --include \*.go --exclude \*_test.go --exclude \mock_*.go --exclude \*_test.go -r "\"github.com/github/launch/pkg/mu" . | wc -l)

if [ "$FOUND_COUNT" -gt "$ALLOWED_COUNT" ]; then
  echo "Oh noes. It seems like you have added a usage of github.com/github/launch/pkg/mu"
  echo "because $((FOUND_COUNT)) usages were found and the currently allowed count"
  echo "is only $ALLOWED_COUNT"
  exit 1
fi

if [ "$FOUND_COUNT" -lt "$ALLOWED_COUNT" ]; then
  echo "Yay, well done! You have removed a use of github.com/github/launch/pkg/mu !!!"
  echo "Feel free to update the value of ALLOWED_COUNT to $((FOUND_COUNT)) in script/check-mu-uses"
  echo "to improve this script going forward"
  exit 1
fi

echo "Looking good. Found $FOUND_COUNT usages of mu. Keep on keeping on! (or remove some mu usages if you want!)"
