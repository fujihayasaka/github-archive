#!/bin/bash
# script/setup-go-auth: Helper script that can be used in arbitrary codespaces to setup go auth easily. 

set -e

cd "$(dirname "$0")/.."

# Use GOPROXY_TOKEN if set, otherwise use GITHUB_TOKEN
token="${GOPROXY_TOKEN:-${GITHUB_TOKEN}}"

if [[ -z "${token-}" ]]; then
  echo "You don't have a GOPROXY_TOKEN or GITHUB_TOKEN set in your env. GITHUB_TOKEN should always be set in a codespace. It can be overridden with GOPROXY_TOKEN by adding it as a codespace secret for the repository this will be run on."
  read -p 'GOPROXY_TOKEN PAT: ' goproxy_token
  export token=$goproxy_token
fi

echo "machine goproxy.githubapp.com login nobody password ${token}" > "$HOME/.netrc"

# This could has duplication with .devcontainer/post-create-command.sh , feel free to clean it up but make sure it stays in sync!
sudo cp .devcontainer/goproxy.sh /etc/profile.d/
echo ". /etc/profile.d/goproxy.sh" | sudo tee -a /etc/bash.bashrc
echo ". /etc/profile.d/goproxy.sh" | sudo tee -a /etc/zsh/zshrc

echo "Please open a new shell or 'source .devcontainer/goproxy.sh'"
