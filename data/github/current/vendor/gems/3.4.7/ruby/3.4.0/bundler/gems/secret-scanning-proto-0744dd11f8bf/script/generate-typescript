#!/bin/bash
set -eu

IMAGE=secret-scanning-proto-generate-typescript

tar cf - \
    config/tools/generate-typescript \
	_template/typescript |
docker build --pull -f config/tools/generate-typescript/Dockerfile -t ${IMAGE} -

docker run --rm \
	--net=none \
	-v $(pwd)/proto:/workspace/proto \
	-v $(pwd)/gen:/workspace/gen \
	${IMAGE}
