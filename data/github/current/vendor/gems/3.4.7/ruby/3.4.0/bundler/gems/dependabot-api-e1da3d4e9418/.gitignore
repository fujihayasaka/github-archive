# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore macOS directory attributes
.DS_Store

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*

# Ignore Ruby `debug` gem command history file.
.rdbg_history

# Ignore environment variables.
/.env.local

# Ignore spec stats.
/spec/examples.txt

# Ignore local file storage
storage/

# Ignore the skeema executable
bin/skeema

# Ignore Docker build secret files
/apt-auth-conf
/pkg-mirror-host

# Ignore the Brew lockfile
Brewfile.lock.json

# Ignore the codespace-compose lock file
.codespace-compose.yml.lock

# Ignore the read database structure
db/reading_structure.sql

# Ignore local terraform directories
**/.terraform/*

# Ignore spoom coverage report
spoom_data/
spoom_report.html
