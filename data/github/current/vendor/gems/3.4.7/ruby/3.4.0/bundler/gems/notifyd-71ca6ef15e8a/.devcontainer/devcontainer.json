{
  "image": "mcr.microsoft.com/vscode/devcontainers/universal:focal",
  "containerEnv": {
    "IS_CODESPACE": "true",
    "CONTAINER_BUILDER_TOKEN": "${localEnv:CONTAINER_BUILDER_TOKEN}",
    "GITHUB_USER": "${localEnv:GITHUB_USER:prebuild}"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/github/features/goproxy:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/github/features/go-linter:2": {}
  },
  "onCreateCommand": "/workspaces/notifyd/.devcontainer/on-create-command.sh",
  "postStartCommand": "/workspaces/notifyd/.devcontainer/post-start-command.sh",
  "prebuildHashPaths": [
    "docker-compose.yml",
    "Dockerfile.dev",
    "Dockerfile.test-ruby",
    "Makefile"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "vsls-contrib.codetour",
        "golang.go",
        "github.copilot"
      ]
    },
    "codespaces": {
      "repositories": {
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/features": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/go-linter": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/hydro-schemas": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/gh-kustomize": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      }
    }
  }
}
