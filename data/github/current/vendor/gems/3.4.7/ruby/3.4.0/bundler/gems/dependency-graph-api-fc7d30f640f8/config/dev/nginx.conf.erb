upstream <%= name %> {
 server 127.0.0.1:9596;
}

server {
  access_log <%= root %>/log/<%= name %>.access.log;
  listen 8080;
  listen [::]:8080;

  root <%= root %>/public;
  server_name <%= name %>.localhost;

  location / {
    proxy_pass http://<%= name %>;
    proxy_set_header Host <%= name %>.localhost;
  }
}
