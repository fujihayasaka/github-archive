#!/bin/bash

set -e
set -o nounset

update_image() {
  local repo="$1"
  local url="https://github.com/github/$repo"
  commit="$(git ls-remote "$url" HEAD | awk '{print $1}')"
  if [ -z "$commit" ]; then
    echo "No HEAD found for $url."
    return
  fi
  echo Updating $repo to $commit.
  sed -i.bak -E -e "s@$repo/$repo:[^}]+@$repo/$repo:$commit@" docker-compose*
  rm -f docker-compose*.bak
}

update_image spokesd
update_image gitrpcd
