#!/bin/bash

# Create the development and test databases, by default we will not recreate.
#
# Arguments:
#   --force - force recreation even if they exist
set -e

cd "$(dirname "$0")/.."

appdir=$(cd "$(dirname "$0")/.." && pwd)
if [ -f /etc/app-env ] ; then
  # If we are running in a container, we need to make sure the db container
  # is ready before we proceed.
  script/poll-for-db
else
  exec "$appdir/script/app-env" "$0" "$@"
fi

echo "==> Creating databases..."
if [ -n "$RACK_ENV" ] && [ "${RACK_ENV:-}" != "development" ] ; then
  echo "Can only be executed in development!"
  exit 1
fi

export BUNDLE_IGNORE_CONFIG=1

echo "Creating databases..."
# I'm 7/10 sure that we hit https://github.com/rails/rails/issues/50038
# in the rails 7.1 upgrade.  Explicitly creating the DBs first seems to
# let us proceed setting up the DBs without error.
RAILS_ENV="development" bin/rails db:create
RAILS_ENV="test" bin/rails db:create

if [ "${1:-""}" = "--force" ] ; then
  RAILS_ENV="development" bin/rails db:reset:primary
  RAILS_ENV="test" bin/rails db:reset:primary
else
  RAILS_ENV="development" bin/rails db:setup:primary
  RAILS_ENV="test" bin/rails db:setup:primary
fi

# Guard against recursive script calls when ENTERPRISE=1
[ "${ENTERPRISE:-""}" = "1" ] && exit 0
ENTERPRISE=1 script/create-databases "$@"
