{
  "name": "billing-platform",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/github/features/goproxy:1": {},
    "ghcr.io/devcontainers/features/azure-cli": {},
    "ghcr.io/devcontainers/features/docker-in-docker": {},
    "ghcr.io/devcontainers/features/ruby": {
      "version": "3.2.1"
    },
    "ghcr.io/devcontainers/features/go": {
      "version": "1.23.4",
      "golangciLintVersion": "latest"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1":{
      "version": "latest"
    },
    "ghcr.io/github/features/dev-vpn:1" : {},
    "ghcr.io/github/features/fm-lite:1": {}
  },
  "forwardPorts": [
    8950,
    8888,
    8899,
    8989
  ],
  "portsAttributes": {
    "8950": {
      "label": "Cosmos DB Emulator"
    },
    "8888": {
      "label": "API"
    },
    "8899": {
      "label": "Admin w/oktaproxy (use this one)"
    },
    "8989": {
      "label": "Admin"
    }
  },
  "hostRequirements": {
    "cpus": 32,
    "memory": "64gb",
    "storage": "128gb"
  },
  "remoteEnv": {
    "TFENV_TERRAFORM_VERSION": "1.4.4"
  },
  "onCreateCommand": "/workspaces/billing-platform/.devcontainer/scripts/onCreateCommand.sh",
  "postAttachCommand": "/workspaces/billing-platform/.devcontainer/scripts/initialize-dev.sh",
  "postCreateCommand": "/workspaces/billing-platform/.devcontainer/scripts/setup-terraform",
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/*": {
          "permissions": "read-all"
        },
        "github/feature-management-lite": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/features": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "golang.Go",
        "zxh404.vscode-proto3",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "GitHub.Copilot",
        "github.codespaces"
      ]
    }
  }
}
