<%= render Primer::Beta::Breadcrumbs.new  do |breadcrumb| %>
  <% breadcrumb.with_item(href: campaigns_path) { "Review campaigns" } %>

  <% breadcrumb.with_item(href: "#{campaigns_path}/#{campaign.id || "new"}") do %>
    <% if campaign.id %>
      <%= campaign.name %>
    <% else %>
      New review campaign
    <% end %>
  <% end %>
<% end %>
