#!/bin/bash
set -e

_term() {
  echo "Terminating bin/api-coverage"
  kill -TERM $coverage_process_pid
}

trap _term SIGINT

echo "Starting bin/api-coverage for test run";

SCRIPT_DIR=$(cd -P -- "$(dirname -- "$0")" && pwd -P)
source ${SCRIPT_DIR}/../dev.env
GOCOVERDIR=./coverage/integration/ ./bin/api-coverage $@ &

coverage_process_pid=$!
wait "$coverage_process_pid"