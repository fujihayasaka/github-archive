#!/bin/bash
# This script runs all the usage queries for the different endpoints and date ranges

set -e

dir=$(dirname $0)

endpoints=(GetUsageByRepoWorkflowRunner GetJobUsage GetRepoUsage GetRunnerTypeUsage GetRunnerRuntimeUsage)
date_ranges=(DATE_RANGE_TYPE_LATEST_MONTH DATE_RANGE_TYPE_PREVIOUS_MONTH DATE_RANGE_TYPE_CURRENT_WEEK DATE_RANGE_TYPE_LAST_30_DAYS DATE_RANGE_TYPE_LAST_90_DAYS DATE_RANGE_TYPE_LAST_YEAR)

for endpoint in ${endpoints[@]}; do
  for date_range in ${date_ranges[@]}; do
    echo "Running $endpoint with $date_range"
    $dir/../query-usage $endpoint "" "" $date_range
  done
done
