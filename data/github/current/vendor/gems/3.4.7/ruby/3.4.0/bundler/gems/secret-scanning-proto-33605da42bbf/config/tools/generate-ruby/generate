#!/bin/bash
#
# Expected to execute inside the docker container built from config/tools/protoc/Dockerfile
#
set -e

echo "Cleaning older version..."

rm -rf gen/ruby

echo "Applying template..."

cp -r _template/ruby gen

echo "Generating proto files..."

ruby_out=./gen/ruby/lib/github/proto/secret_scanning/

packages=('api/v1'
'api/v2'
'blobs/v1'
'businesses/v1'
'repositories/v1'
'organizations/v1'
'scans/v1'
'users/v1'
'api/v3'
'scans/v2'
'metrics/v1'
'types/v1'
'issues/v1'
'pull_requests/v1'
'discussions/v1'
'tenant/v1'
)

for p in "${packages[@]}"; do
  set -x
  protoc --proto_path=proto \
    --ruby_out=$ruby_out \
    --twirp_ruby_out=$ruby_out \
    ./proto/"${p}"/*.proto
    { set +x; } 2>/dev/null
done
