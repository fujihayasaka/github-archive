#! /usr/bin/env bash
#
#/ Usage: script/gather-profiles
set -e

ts=$(date -u +%Y%m%d-%H%M%S)
curl "https://blackbird-ingest-production.service.iad.github.net/debug/pprof/allocs" --output "ingest-allocs-$ts.prof"
curl "https://blackbird-ingest-production.service.iad.github.net/debug/pprof/heap?gc=1" --output "ingest-heap-$ts.prof"

go tool pprof "ingest-heap-$ts.prof"
