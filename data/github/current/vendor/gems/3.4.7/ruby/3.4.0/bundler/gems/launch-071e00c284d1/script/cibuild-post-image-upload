#!/usr/bin/env sh

set -e

echo "%%%FOLD {Post build image script}%%%"
# extract registry from github/registry
REPO_NAME=$(echo $BUILD_NWO | cut -d "/" -f2)
LOCAL_IMAGE_TAG="$REPO_NAME:$BUILD_SHA"
# extract the image manifest digest from the docker image manifest.
MANIFEST_DIGEST=$(docker inspect --format "{{index .RepoDigests 0}}" $LOCAL_IMAGE_TAG | cut -d "@" -f 2)

echo
echo "To include this image in github/enterprise2 please add or edit this line in docker-image-list-ghe"
echo "${REPO_NAME}=octofactory.githubapp.com/moda-artifacts-docker/${REPO_NAME}:$BUILD_SHA@$MANIFEST_DIGEST"
echo "%%%END FOLD%%%"
