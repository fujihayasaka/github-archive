<% content_for :title, "Advisory: #{advisory_review.ghsa_id}" %>
<% advisory_payload ||= AdvisoryPayload.new(data: advisory_review.advisory_payload) %>
<% vulnerability_prediction_attributes ||= [] %>
<% body_version ||= advisory_review.body_version %>

<% content_for :breadcrumbs do %>
  <%= render "advisory_reviews/breadcrumbs", advisory_review: advisory_review %>
<% end %>

<% content_for :navigation do %>
  <%= render "advisory_reviews/navigation", advisory_review: advisory_review %>
<% end %>

<% if advisory_payload.errors.any? %>
  <%= render Primer::Beta::Flash.new(scheme: :danger, icon: "hubot", spacious: true, test_selector: "flash-error") do %>
    The advisory review could not be saved. See details below.
    <% if advisory_payload.errors.include?(:base) %>
      <ul class="list-style-none ml-5">
        <% advisory_payload.errors.full_messages_for(:base).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>

<%= render "advisory_reviews/overlap_warning", advisory_review: advisory_review %>

<%= render ReviewHeaderComponent.new(review: advisory_review) %>

<form-tracker>
  <%= render Primer::Alpha::Layout.new(first_in_source: :main) do |layout| %>
    <% layout.with_sidebar(col_placement: :end) do %>
      <%= render AdvisoryReviews::SidebarComponent.new(advisory_review: advisory_review) %>
    <% end %>

    <% layout.with_main do %>
      <%= render AdvisoryReviews::FormComponent.new(advisory_review: advisory_review, advisory_payload: advisory_payload, vulnerability_prediction_attributes: vulnerability_prediction_attributes, body_version: body_version) %>
    <% end %>
  <% end %>
</form-tracker>

<hr class="mt-4">

<%= render AdvisoryReviews::FeedsComponent.new(advisory_review: advisory_review) %>
