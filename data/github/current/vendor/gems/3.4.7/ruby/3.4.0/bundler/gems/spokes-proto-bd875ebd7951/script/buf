#!/bin/bash
set -e
set -u

IMAGE=script-proto-buf

tar cf - \
    config/tools/buf |
docker build -f config/tools/buf/Dockerfile -t ${IMAGE} -

extra_args=()
if [ "$(uname -s)" = "Linux" ]; then
  extra_args=( -u "$(id -u):$(id -g)" --env XDG_CACHE_HOME=/tmp/xdghome )
fi

docker run --rm \
	"${extra_args[@]}" \
	--net=none \
	-v $(pwd)/.git:/go/src/github.com/github/spokes-proto/.git \
	-v $(pwd)/proto:/go/src/github.com/github/spokes-proto/proto \
	${IMAGE} "$@"
