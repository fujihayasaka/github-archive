#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

echo "==> ruby linting"

# Check for accidental use of pry-byebug in product code
bad_patterns=(
    'require "pry-byebug"'
    'binding\.pry'
    'binding\.irb'
)

IFS=""
for pattern in ${bad_patterns[@]}; do
    echo "checking for '$pattern' in ruby code..."
    if grep -rn $pattern ./ruby; then
        echo "you left a $pattern in the ruby code!" 1>&2
        exit 1
    fi
done

# Now do ruby linting with rubocop
bundle exec rubocop ./ruby