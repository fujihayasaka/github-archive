# In the special case of Java, the version string may also contain
# optional "update number" and "identifier" components.
# See https://www.oracle.com/java/technologies/javase/versioning-naming.html
# for a description of Java versions.
#
# source://dependabot-helm//lib/dependabot/helm/version.rb#16
class Dependabot::Helm::Version < ::Dependabot::Version
  # source://dependabot-helm//lib/dependabot/helm/version.rb#24
  sig { override.params(version: T.nilable(T.any(::Gem::Version, ::Integer, ::String))).void }
  def initialize(version); end

  # source://dependabot-helm//lib/dependabot/helm/version.rb#88
  sig { params(other: ::Dependabot::Helm::Version).returns(T.nilable(::Integer)) }
  def <=>(other); end

  # source://dependabot-helm//lib/dependabot/helm/version.rb#85
  sig { returns(::Dependabot::Version) }
  def release_part; end

  # source://dependabot-helm//lib/dependabot/helm/version.rb#71
  sig { returns(T::Array[::String]) }
  def segments; end

  # source://dependabot-helm//lib/dependabot/helm/version.rb#93
  sig { returns(T::Array[::Dependabot::Version]) }
  def sort_criteria; end

  # source://dependabot-helm//lib/dependabot/helm/version.rb#76
  sig { returns(T.nilable(::String)) }
  def to_s; end

  # source://dependabot-helm//lib/dependabot/helm/version.rb#66
  sig { override.returns(::String) }
  def to_semver; end

  class << self
    # source://dependabot-helm//lib/dependabot/helm/version.rb#45
    sig { override.params(version: T.nilable(T.any(::Gem::Version, ::Integer, ::String))).returns(T::Boolean) }
    def correct?(version); end
  end
end

# The regex has limits for the 0,255 and 1,255 repetitions to avoid infinite limits which makes codeql angry.
# A docker image cannot be longer than 255 characters anyways.
#
# source://dependabot-helm//lib/dependabot/helm/version.rb#21
Dependabot::Helm::Version::HELM_VERSION_REGEX = T.let(T.unsafe(nil), Regexp)
