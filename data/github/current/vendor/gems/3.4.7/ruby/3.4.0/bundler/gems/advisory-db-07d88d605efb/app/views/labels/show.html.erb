<% content_for :breadcrumbs do %>
  <%= render "breadcrumbs", label: label %>
<% end %>

<div class="mb-4">
  <h2 class="d-flex flex-justify-between flex-items-center">
    <%= label.name %>
    <span>
      <%= link_to "Edit label", edit_label_path(label), class: "btn btn-sm" %>
      <%= link_to "Delete label", label_path(label), method: :delete, data: { confirm: "Are you sure you want to delete this label?" }, class: "btn btn-danger btn-sm" %>
    </span>
  </h2>
  <% if label.description.present? %>
    <div class="mt-1 color-fg-muted">
      <%= label.description %>
    </div>
  <% end %>
</div>

<%= render(AdvisoryReviews::TableComponent.new(advisory_reviews: labeled_reviews)) %>

<%= will_paginate labeled_reviews,
      params: request.query_parameters,
      inner_window: 2,
      outer_window: 0,
      previous_label: "Previous",
      next_label: "Next",
      class: "pagination text-center mt-3"
%>
