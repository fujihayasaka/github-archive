#!/usr/bin/env bash

# Before landing breaking changes, please update the REAME documentation!

set -euo pipefail

# The local dependency-graph-platform-proto checkout root
REPO_ROOT=$(realpath .)

# Input: protobuf spec file trees
PROTO_BASE="${REPO_ROOT}/proto"
mkdir -p "${PROTO_BASE}"

# Output: DGP generated protobuf code will live
GEN_BASE="${REPO_ROOT}/gen"
rm -rf "${GEN_BASE}"
mkdir -p "${GEN_BASE}"

# Build the code gen tools image
docker build -t dgp_protogen .

# Run a container of the generated image, mounting the local in/out dirs
docker run --rm \
    -v "${PROTO_BASE}":/proto \
    -v "${GEN_BASE}":/gen \
    dgp_protogen
