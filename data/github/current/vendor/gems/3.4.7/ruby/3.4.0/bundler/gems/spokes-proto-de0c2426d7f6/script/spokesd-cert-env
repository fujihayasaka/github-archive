#!/bin/bash
# This is a shim that runs inside a docker container and loads the root CA cert
# into the environment before exec'ing the given spokesd or spokesctl command.

export SPOKESD_TLS_CA_CERT_PEM="$(cat /etc/spokesd/certs/spokes-api-dev-ca.crt)"
export SPOKESD_TLS_CA_KEY_PEM="$(cat  /etc/spokesd/certs/spokes-api-dev-ca.key)"
exec "$@"
