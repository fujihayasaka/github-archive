#!/bin/bash
# Usage: script/dc [args]
#
# Proxies the flags/arguments to docker-compose, but also adds the correct
# compose files for the current environment.

set -e
SCRIPT_DIR=$(cd -P -- "$(dirname -- "$0")" && pwd -P)
cd "${SCRIPT_DIR}/.."
FILES="-f docker-compose.yml"
if [[ $GITHUB_REPOSITORY == "github/github" ]]; then
    FILES=" $FILES -f docker-compose-dotcom.yml"
else
    FILES=" $FILES -f docker-compose-billing-platform.yml"
fi

docker compose $FILES $@
