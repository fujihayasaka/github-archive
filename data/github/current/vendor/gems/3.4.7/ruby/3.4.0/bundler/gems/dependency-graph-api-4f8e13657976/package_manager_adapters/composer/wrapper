#!/bin/bash

usage() {
  echo "Usage: $0 {run|import|test|console}"
}

case "$1" in
  run)
    echo "Running adapter..."
    bundle exec rake run
    ;;
  import)
    echo "Running adapter (in full import mode)..."
    bundle exec rake full_import
    ;;
  test)
    echo "Running adapter tests..."
    bundle exec rake test
    ;;
  console)
    /bin/bash
    ;;
  *)
    usage
    exit 1
esac
