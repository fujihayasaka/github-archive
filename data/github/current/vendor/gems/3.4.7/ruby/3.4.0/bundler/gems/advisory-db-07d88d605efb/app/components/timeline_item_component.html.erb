<%= render Primer::Beta::TimelineItem.new(
  condensed: !primary?,
  id: id,
  test_selector: test_selector
) do |item| %>
  <% item.with_badge(icon: badge_icon, bg: badge_bg, color: badge_color) %>

  <% item.with_body do %>
    <% if show_data? %>
      <%= render(Primer::ButtonComponent.new(variant: :small, float: :right, ml: 3, mt: -1, data: { toggles: toggle_id})) { "View details" } %>
    <% elsif show_diff? %>
      <%= render(Primer::ButtonComponent.new(variant: :small, float: :right, ml: 3, mt: -1, data: { toggles: toggle_id})) { "View changes" } %>
    <% end %>

    <% if phrase_override %>
      <%= phrase_override %>
    <% elsif actor %>
      <%= render actor_avatar(display: :inline_block) %>
      <strong><%= actor.login %></strong>
      <%= active_verb %>
      <%= identified_noun %>
    <% else %>
      <%= identified_noun(capitalize: true) %>
      was <%= passive_verb %>
    <% end %>

    <%= render(Primer::Beta::Link.new(href: "##{id}", scheme: :secondary, data: { turbolinks: false })) do %>
      <%= render(Primer::Beta::RelativeTime.new(datetime: timestamp, tense: :past)) if timestamp %>
    <% end %>

    <% if show_data? %>
      <div class="diff-container mt-3 mb-2 border rounded-2 color-bg-subtle" id="<%= toggle_id %>" hidden>
        <pre><%= version.data %></pre>
      </div>
    <% elsif show_diff? %>
      <div class="diff-container mt-3 mb-2 border rounded-2 color-bg-subtle" id="<%= toggle_id %>" hidden>
        <%= diff %>
      </div>
    <% end %>
  <% end %>
<% end %>
