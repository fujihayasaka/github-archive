{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "organization": "GitHub",
          "semanticVersion": "2.0.0",
          "rules": [],
          "notifications": [
            {
              "id": "exampleid1",
              "name": "Example 1 name",
              "shortDescription": {
                "text": "Example 1 short description"
              },
              "fullDescription": {
                "text": "Example 1 full description"
              },
              "defaultConfiguration": {
                "enabled": true
              }
            },
            {
              "id": "exampleid2",
              "name": "Example 2 name",
              "shortDescription": {
                "text": "Example 2 short description"
              },
              "fullDescription": {
                "text": "Example 2 full description"
              },
              "defaultConfiguration": {
                "enabled": true
              }
            }
          ]
        },
        "extensions": [
          {
            "name": "Extension 1",
            "organization": "GitHub",
            "semanticVersion": "2.0.0",
            "rules": [],
            "notifications": [
              {
                "id": "ext-exampleid1",
                "name": "Extension Example 1 name",
                "shortDescription": {
                  "text": "Extension Example 1 short description"
                },
                "fullDescription": {
                  "text": "Extension Example 1 full description"
                },
                "defaultConfiguration": {
                  "enabled": true
                }
              },
              {
                "id": "ext-exampleid2",
                "name": "Extension Example 2 name",
                "shortDescription": {
                  "text": "Extension Example 2 short description"
                },
                "fullDescription": {
                  "text": "Extension Example 2 full description"
                },
                "defaultConfiguration": {
                  "enabled": true
                }
              }
            ]
          }
        ]
      },
      "artifacts": [],
      "results": [],
      "newlineSequences": [
        "\r\n",
        "\n"
      ],
      "columnKind": "utf16CodeUnits",
      "properties": {
        "semmle.formatSpecifier": "sarif-latest"
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "message": {
                "text": "some text 1-1",
                "markdown": "some markdown 1-1"
              },
              "level": "error",
              "descriptor": {
                "id": "exampleid2",
                "index": 1
              },
              "properties": {
                "visibility": {
                  "statusPage": true
                },
                "helpLinks": [
                  "https://github.com"
                ]
              }
            },
            {
              "message": {
                "text": "some text 1-2",
                "markdown": "some markdown 1-2"
              },
              "level": "error",
              "descriptor": {
                "toolComponent": {
                  "index": 0
                },
                "id": "ext-exampleid2",
                "index": 1
              },
              "properties": {
                "visibility": {
                  "statusPage": true
                },
                "helpLinks": [
