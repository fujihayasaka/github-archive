# Sets up a process to keep the codespace alive while editing files over ssh
inotifywait --monitor --format '%T' --timefmt '%s' /workspaces/github 2> /dev/null > /workspaces/.codespaces/shared/active-clients-monitor.json &

# Adds go to the path when connecting via ssh
if ! grep -q ':/usr/local/go/bin' /etc/profile; then
  echo 'export PATH="$PATH:/usr/local/go/bin"' | sudo tee -a /etc/profile
fi

if ! grep -q 'cd /workspaces/turboscan' /etc/profile; then
  echo 'cd /workspaces/turboscan &> /dev/null' | sudo tee -a /etc/profile
fi
