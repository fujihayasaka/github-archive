{
    "data": {
        "attributes": {
            "command": "version",
            "allowed-updates": [
                {
                    "dependency-type": "direct",
                    "update-type": "all"
                }
            ],
            "credentials-metadata": [
                <% if Dependabot.proxima? %>
                {
                    "type": "git_source",
                    "host": "staffship-01.ghe.com"
                },
                <% end %>
                {
                    "type": "git_source",
                    "host": "github.com"
                }
            ],
            "debug": null,
            "dependencies": null,
            "dependency-group-to-refresh": null,
            "dependency-groups": [],
            "enable-beta-ecosystems": false,
            "exclude-paths": null,
            "existing-pull-requests": [
                {
                    "pr-number": 1011,
                    "dependencies": [
                        {
                            "dependency-name": "business",
                            "dependency-version": "1.8.0",
                            "directory": "/"
                        }
                    ]
                }
            ],
            "existing-group-pull-requests": [],
            <%
            experiments_hash = {}
            experiments_hash["record-ecosystem-versions"] = true unless Dependabot.enterprise?
            experiments_hash["record-update-job-unknown-error"] = true unless Dependabot.enterprise?
            %>
            "experiments": <%= experiments_hash.to_json %>,
            "ignore-conditions": [
                {
                    "dependency-name": "business",
                    "version-requirement": null,
                    "update-types": ["version-update:semver-patch"],
                    "source": "@dependabot ignore command",
                    "updated-at": "<%= updated_at %>"
                },
                {
                    "dependency-name": "business",
                    "version-requirement": ">= 2.0, < 3",
                    "update-types": null,
                    "source": "@dependabot ignore command",
                    "updated-at": "<%= updated_at %>"
                }
            ],
            "lockfile-only": false,
            "max-updater-run-time": 2700,
            "package-manager": "bundler",
            "proxy-log-response-body-on-auth-failure": false,
            "source": {
                "provider": "github",
                "repo": "hmarr/business",
                "directory": "/",
                "branch": null,
                "api-endpoint": "<%= Dependabot.proxima? ? 'https://api.staffship-01.ghe.com/' : 'https://api.github.com/' %>",
                "hostname": "<%= Dependabot.proxima? ? 'staffship-01.ghe.com' : 'github.com' %>"
            },
            "updating-a-pull-request": false,
            "update-subdependencies": false,
            "requirements-update-strategy": null,
            "security-advisories": [],
            "security-updates-only": false,
            "vendor-dependencies": true,
            "reject-external-code": false,
            "repo-private": true,
            "multi-ecosystem-update": false,
            "commit-message-options": {
                "include-scope": null,
                "prefix": null,
                "prefix-development": null
            }
        },
        "id": "1001",
        "type": "update-jobs"
    }
}
