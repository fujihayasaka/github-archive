; Ignore any tables starting with '_'
; Ignore any tables starting with 'dependabot_'
;   These relate to db/enterprise_structure.sql and are not relevant to skeema
ignore-table=^_.*|^dependabot_*

[dependabot]
schema=deltaforce_production

[development]
schema=dependabot_development

[development-codespaces]
schema=dependabot_development

[skeema-diff-ci]
schema=skeema:deltaforce_production
