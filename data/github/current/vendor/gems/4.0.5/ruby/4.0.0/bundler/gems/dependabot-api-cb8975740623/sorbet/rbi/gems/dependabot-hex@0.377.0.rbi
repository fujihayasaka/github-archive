# pkg:gem/dependabot-hex#lib/dependabot/hex/requirement.rb:12
class Dependabot::Hex::Requirement < ::Dependabot::Requirement
  # Patches Gem::Requirement to make it accept requirement strings like
  # "~> 4.2.5, >= 4.2.5.1" without first needing to split them.
  #
  # pkg:gem/dependabot-hex#lib/dependabot/hex/requirement.rb:46
  sig { params(requirements: T.any(::String, T::Array[::String])).void }
  def initialize(*requirements); end

  # pkg:gem/dependabot-hex#lib/dependabot/hex/requirement.rb:73
  sig { params(version: T.any(::Dependabot::Version, ::Gem::Version, ::String)).returns(T::Boolean) }
  def satisfied_by?(version); end

  class << self
    # Override the parser to create Hex::Versions
    #
    # pkg:gem/dependabot-hex#lib/dependabot/hex/requirement.rb:59
    sig { params(obj: T.any(::Gem::Version, ::String)).returns(T::Array[T.any(::Gem::Version, ::String)]) }
    def parse(obj); end

    # Returns an array of requirements. At least one requirement from the
    # returned array must be satisfied for a version to be valid.
    #
    # pkg:gem/dependabot-hex#lib/dependabot/hex/requirement.rb:36
    sig { override.params(requirement_string: T.nilable(::String)).returns(T::Array[::Dependabot::Hex::Requirement]) }
    def requirements_array(requirement_string); end
  end
end

