  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug sweagentd (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "cmd/http/main.go"
    },
    {
      "name": "Debug sweagentd-twirp (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "cmd/twirp/main.go",
      "env": {
        "PORT": "2209"
      }
    },
    {
      "name": "Debug sweagentd-worker (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "cmd/worker/main.go"
    },
    {
      "name": "Debug oidctester (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "cmd/oidctester/main.go",
      "args": [
        "-config", "${workspaceFolder}/testdata/copilot/settings.json",
        "-actor-id", "1",
        "-actor", "monalisa",
        "-owner-id", "4",
        "-owner", "github",
        "-repo-id", "6",
        "-repo", "private-server",
        "-job-id", "job-id-123456"
      ]
    },
    {
      "name": "Debug plugintester info (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "cmd/plugintester/main.go",
      "args": [
        "info",
        "-spec", "github/awesome-copilot:plugins/software-engineering-team",
      ]
    },
    {
      "name": "Debug plugintester agent (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "cmd/plugintester/main.go",
      "args": [
        "agent",
        "-spec", "github/awesome-copilot:plugins/software-engineering-team",
        "-agent", "se-security-reviewer"
      ]
    }
  ]
}
