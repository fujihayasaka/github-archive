
<form-table-row data-targets="form-table.rows" data-action="deleteRow:form-table#ensureVisibleRow" <%= test_selector("affected-product-row") %>>
  <div class="Box mb-3">
  <div class="d-flex flex-items-start m-2">
    <div class="flex-1">
      <div class="d-flex mb-2">
        <div class="flex-1">
          <label class="h4">Vendor Name</label>
          <input
            type="text"
            name="cve_review[affected_products][][vendor]"
            value="<%= vendor %>"
            placeholder="e.g. github"
            autocomplete="off"
            class="form-control width-full"
            data-target="form-table-row.firstFocus"
            data-targets="form-table-row.inputs"
            <%= "disabled" if disabled? %>
            <%= test_selector("affected-product-vendor") %>
          >
        </div>
        <div class="flex-1 ml-3">
          <label class="h4">Product</label>
          <input
            type="text"
            name="cve_review[affected_products][][product]"
            value="<%= product %>"
            placeholder="e.g. advisory-inbox"
            autocomplete="off"
            class="form-control width-full"
            data-targets="form-table-row.inputs"
            <%= "disabled" if disabled? %>
            <%= test_selector("affected-product-product") %>
          >
        </div>
      </div>
      <div>
        <label class="f6 color-fg-muted">Version ranges</label>
        <form-table class="d-block" data-action="initialized:form-tracker#reset">
          <div class="Box">
            <div data-target="form-table.body">
              <% version_strings.each do |version_value| %>
                <%= render FormRowComponent.new(value: version_value, name: "cve_review[affected_products][][versions][]", placeholder: "e.g. < 0.2.13", disabled: disabled?) %>
              <% end %>
            </div>
          </div>

          <template data-target="form-table.rowTemplate">
            <%= render FormRowComponent.new(name: "cve_review[affected_products][][versions][]", placeholder: "e.g. < 0.2.13", disabled: disabled?) %>
          </template>

          <%= render Primer::ButtonComponent.new(
            scheme: :link,
            mt: 2,
            classes: "Link--secondary no-underline",
            data: { action: "click:form-table#addRow" },
            hidden: disabled? ) do |button| %>
            <%= render IconComponent.new(icon: "plus", mr: 1) %>
            Add a version value
          <% end %>
        </form-table>
      </div>
    </div>
    <div class="flex-grow-0 ml-2 pt-4" <%= "hidden" if disabled? %>>
      <button data-action="click:form-table-row#delete" class="btn-octicon btn-octicon-danger" type="button" aria-label="Remove affected product" title="Remove affected product">
        <%= render IconComponent.new(icon: "trash") %>
      </button>
    </div>
  </div>
  </div>
</form-table-row>

