#!/usr/bin/env ruby

# Advisory team : This custom section is part of the Rails application setup process.
# Don't remove unless necessary after rails upgrade. Modify if required for your rails environment.
if ENV["RAILS_ENV"] != "production" && !File.exist?("/etc/app-env") && ENV["FAST_DEV_LOOP"] != "1"
  exec("#{__dir__}/../script/app-env", $PROGRAM_NAME, *ARGV)
end

APP_PATH = File.expand_path("../config/application", __dir__)
require_relative "../config/boot"
require "rails/commands"
