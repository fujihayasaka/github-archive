# syntax = docker/dockerfile:1.3-labs

FROM alpine:3.21.3 AS base

RUN apk add --no-cache rust ruby cargo ruby-dev git libffi make linux-headers autoconf libtool automake

RUN apk add --no-cache ruby-ffi ruby-bundler

WORKDIR /src

FROM base

RUN --mount=target=/src,type=bind,source=. BUNDLE_FROZEN=true bundle install

ENTRYPOINT ["rake"]
