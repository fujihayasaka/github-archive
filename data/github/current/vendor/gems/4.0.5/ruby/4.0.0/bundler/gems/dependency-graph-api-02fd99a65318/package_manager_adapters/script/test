#!/bin/bash

set -e

cd "$(dirname "$0")/.."

PACKAGE_MANAGER=$1

usage() {
  echo "Usage: script/test PACKAGE_MANAGER [args]"
  echo
  echo "Run a package manager adapter's tests"
}

. script/utils

validate
shift

script/build $PACKAGE_MANAGER

if [ -t 1 ] ; then
  TTY="--tty"
fi

docker run \
  --interactive $TTY \
  $(container-tag) \
  test "$@"
