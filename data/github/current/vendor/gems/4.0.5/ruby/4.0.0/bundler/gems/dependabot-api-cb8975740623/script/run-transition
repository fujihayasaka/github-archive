#!/bin/bash

app_dir="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "Usage: $0 <transition-file-name> <arguments>"
  echo
  echo "where <transition-file-name> is a transition file under lib/dependabot/transitions/"
  echo
  echo "Example: $0 20231201094108_my_transition.rb -v -w"
  exit 0
}

if ! [ -f "$app_dir/lib/dependabot/transitions/$1" ]; then
  usage
fi

if [ -f /etc/app-env ]; then
  exec bundle exec ruby "/app/lib/dependabot/transitions/$1" "${@:2}"
else
  exec "$app_dir/script/app-env" bundle exec ruby "/app/lib/dependabot/transitions/$1" "${@:2}"
fi
