#!/bin/bash

set -e
set -o nounset
set -x

if ! which unzip >&/dev/null; then
  apt-get update
  apt-get install -y unzip
fi

case $(dpkg --print-architecture) in
  amd64)
    export arch=x86_64
    ;;
  arm64)
    export arch=aarch_64
    ;;
esac

curl -sL https://github.com/google/protobuf/releases/download/v21.8/protoc-21.8-linux-${arch}.zip -o /tmp/protoc.zip

unzip /tmp/protoc.zip -d /tmp/protoc
chmod -R go+rX /tmp/protoc
mv /tmp/protoc/bin/protoc /usr/local/bin/protoc
mv /tmp/protoc/include/google /usr/local/include/

rm -rf /tmp/protoc.zip /tmp/protoc
