
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Needs to be present for local docker builds to enable goproxy access, but should never be committed
.netrc

# Go Tools directory
_tools/

# Bin output dir
bin/

# Null Application persisted sqlite data file
olc_sqlite.db
