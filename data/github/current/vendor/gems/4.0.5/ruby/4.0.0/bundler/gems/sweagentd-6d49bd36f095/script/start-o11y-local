#!/bin/bash

set -eu -o pipefail

# test if docker is running
if ! docker ps > /dev/null 2>&1; then
	echo "Docker is not running. Please start Docker and try again."
	exit 1
fi

start_jaeger() {
	# test if jaeger is already running
	if docker ps | grep -q "jaeger"; then
		echo "Jaeger is already running"
		return 0
	fi

	# documentation: https://www.jaegertracing.io/docs/2.5/getting-started/
	# access Jaeger Web UI at http://localhost:16686
	docker run --rm --detach --name jaeger \
			-e COLLECTOR_ZIPKIN_HOST_PORT=:9411 \
			-p 16686:16686 \
			-p 4317:4317 \
			-p 4318:4318 \
			-p 14250:14250 \
			-p 14268:14268 \
			-p 14269:14269 \
			-p 9411:9411 \
			jaegertracing/all-in-one
}

start_jaeger

echo "Observability stack is running:"
echo "  - [Traces] Jaeger Web UI: http://localhost:16686"
echo ""
echo "Make sure your .env file has the following variables set:"
echo "  OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces"
echo "  OTEL_SERVICE_NAME=sweagentd"
