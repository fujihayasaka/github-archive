<div class="d-flex flex-row">
  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      State: <%= curation_state_label(curation_state) %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(state: "all", page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (curation_state == "all" ? :visible : :hidden)) %>
            All states
          </a>
          <% curation_states.each do |state_filter| %>
            <a role="menuitem" class="SelectMenu-item no-wrap"
              href="<%= url_for(request.query_parameters.merge(state: state_filter, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (curation_state == state_filter ? :visible : :hidden)) %>
              <span class="d-inline-block mr-2">
                <%= render ReviewStateIconComponent.new(curation_state: state_filter) %>
              </span>
              <%= curation_state_label(state_filter) %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      Source: <%= source_label(source) %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(source: nil, page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (source == "all" ? :visible : :hidden)) %>
            All sources
          </a>
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(source: "pending_trusted", page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (source == "pending_trusted" ? :visible : :hidden)) %>
            Pending sources trusted
          </a>
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(source: "pending_untrusted", page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (source == "pending_untrusted" ? :visible : :hidden)) %>
            Pending sources untrusted
          </a>
          <% sources.each do |source_filter| %>
            <a role="menuitem" class="SelectMenu-item no-wrap"
              href="<%= url_for(request.query_parameters.merge(source: source_filter, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (source == source_filter ? :visible : :hidden)) %>
              <span class="d-inline-block mr-2">
                <%= render(AdvisoryReviews::SourceIconComponent.new(source: source_filter, with_link: false)) %>
              </span>
              <%= source_label(source_filter) %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      Ecosystem: <%= ecosystem_label(ecosystem) %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(ecosystem: nil, page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (ecosystem == "all" ? :visible : :hidden)) %>
            All ecosystems
          </a>
          <a role="menuitem" class="SelectMenu-item no-wrap color-fg-muted"
            href="<%= url_for(request.query_parameters.merge(ecosystem: "none", page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (ecosystem == "none" ? :visible : :hidden)) %>
            <span class="d-inline-block mr-2">
              <%= render IconComponent.new(icon: "dot", mr: 1, color: :muted) %>
            </span>
            No ecosystem
          </a>
          <% ecosystems.each do |ecosystem_filter| %>
            <a role="menuitem" class="SelectMenu-item no-wrap"
              href="<%= url_for(request.query_parameters.merge(ecosystem: ecosystem_filter, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (ecosystem == ecosystem_filter ? :visible : :hidden)) %>
              <span class="d-inline-block mr-2">
                <%= render IconComponent.new(icon: "dot-fill", mr: 1, style: "color: ##{ecosystem_color(ecosystem_filter)}") %>
              </span>
              <%= ecosystem_label(ecosystem_filter) %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      Labels: <%= labels_label %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <% if Label.count > 0 %>
            <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
              href="<%= url_for(request.query_parameters.merge(label_ids: nil, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (label_ids.blank? ? :visible : :hidden)) %>
              Any labels
            </a>
            <div class="SelectMenu-divider">Including labels</div>
            <% Label.find_each do |label_filter| %>
              <% selected = label_ids.include?(label_filter.id.to_s) %>
              <a role="menuitem" class="SelectMenu-item no-wrap"
                href="<%= selected ? uninclude_label_link(label_filter.id) : include_label_link(label_filter.id) %>">
                <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (selected ? :visible : :hidden)) %>
                <%= render Labels::LabelComponent.new(name: label_filter.name, color: label_filter.color) %>
              </a>
            <% end %>
            <div class="SelectMenu-divider">Excluding labels</div>
            <% Label.find_each do |label_filter| %>
              <% selected = label_ids.include?("-#{label_filter.id}") %>
              <a role="menuitem" class="SelectMenu-item no-wrap"
                href="<%= selected ? unexclude_label_link(label_filter.id) : exclude_label_link(label_filter.id) %>">
                <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (selected ? :visible : :hidden)) %>
                <%= render Labels::LabelComponent.new(name: label_filter.name, color: label_filter.color) %>
              </a>
            <% end %>
          <% else %>
            <div class="SelectMenu-item">No labels to select</div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      Curator: <%= curator_label(curator) %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(curator: "all", page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (curator == "all" ? :visible : :hidden)) %>
            All curators
          </a>
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(curator: "none", page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (curator == "none" ? :visible : :hidden)) %>
            No curator
          </a>
          <% curators.each do |curator_filter| %>
            <a role="menuitem" class="SelectMenu-item no-wrap"
              href="<%= url_for(request.query_parameters.merge(curator: curator_filter, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (curator == curator_filter ? :visible : :hidden)) %>
              <%= curator_label(curator_filter) %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      Severity: <% if severity == "all" %>
                  All
                <% else %>
                  <%= render AdvisoryReviews::SeverityIconComponent.new(severity: severity) %>
                  <%= severity_label(severity) %>
                <% end %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(severity: "all", page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (severity == "all" ? :visible : :hidden)) %>
            All severities
          </a>
          <% severities.each do |severity_filter| %>
            <a role="menuitem" class="SelectMenu-item no-wrap"
              href="<%= url_for(request.query_parameters.merge(severity: severity_filter, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (severity == severity_filter ? :visible : :hidden)) %>
              <span class="d-inline-block mr-2">
                <%= render AdvisoryReviews::SeverityIconComponent.new(severity: severity_filter) %>
              </span>
              <%= severity_label(severity_filter) %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if campaign.present? %>
    <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
      <% details.with_summary(aria: { haspopup: true }) do %>
        Campaign review state: <%= campaign_review_state.humanize %>
        <div class="dropdown-caret"></div>
      <% end %>

      <% details.with_body(classes: "SelectMenu") do %>
        <div class="SelectMenu-modal width-full">
          <div class="SelectMenu-list">
            <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
              href="<%= url_for(request.query_parameters.merge(campaign_review_state: "all", page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (campaign_review_state == "all" ? :visible : :hidden)) %>
              All states
            </a>
            <% AdvisoryReviewsCampaign::CAMPAIGN_REVIEW_STATES.each do |state_filter| %>
              <a role="menuitem" class="SelectMenu-item no-wrap"
                href="<%= url_for(request.query_parameters.merge(campaign_review_state: state_filter, page: nil)) %>">
                <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (campaign_review_state == state_filter ? :visible : :hidden)) %>
                <%= state_filter.humanize %>
              </a>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= form_tag(request.path, method: :get, class: "d-flex flex-1 ml-1") do %>
    <% hidden_search_fields.each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>

    <%= text_field_tag "query", query, placeholder: "Search CVE or GHSA IDs...", autocomplete: "off", class: "form-control flex-1 mb-3" %>
  <% end %>
</div>

<%= render(AdvisoryReviews::TableComponent.new(advisory_reviews: advisory_reviews, sort: sort, sort_by: sort_by)) %>

<%= pagination(advisory_reviews) %>
