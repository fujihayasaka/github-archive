{
  "name": "cli",
  "image": "mcr.microsoft.com/devcontainers/go:1.25-trixie",
  "onCreateCommand": "/usr/local/share/goproxy-init.sh",
  "postStartCommand": "/usr/local/share/goproxy-init.sh --override",
  "postCreateCommand": ".devcontainer/cli/post-create-command.sh",
  "hostRequirements": {
    "storage": "64gb",
    "memory": "64gb"
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/github/features/goproxy:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/copilot-cli:1": {
      "version": "prerelease"
    }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/features": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/copilot-agent-runtime": {
          "permissions": {
            "contents": "write",
            "packages": "read"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "bierner.github-markdown-preview",
        "bierner.markdown-checkbox",
        "bierner.markdown-emoji",
        "bierner.markdown-footnotes",
        "bierner.markdown-mermaid",
        "bierner.markdown-preview-github-styles",
        "bierner.markdown-yaml-preamble",
        "davidanson.vscode-markdownlint",
        "yzhang.markdown-all-in-one",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.codespaces",
        "github.copilot",
        "github.copilot-chat",
        "golang.go",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/vendor": true,
          "**/.git": true,
          "**/node_modules": true
        },
        "editor.formatOnSave": true,
        "go.alternateTools": {
          "customFormatter": "golangci-lint-v2"
        },
        "go.formatFlags": [
          "fmt",
          "--stdin"
        ],
        "go.formatTool": "custom",
        "go.lintFlags": [
          "--path-mode=abs"
        ],
        "go.lintTool": "golangci-lint-v2",
        "go.lintOnSave": "package",
        "go.testTimeout": "200s",
        "go.toolsManagement.autoUpdate": true,
        "go.useLanguageServer": true,
        "gopls": {
          "staticcheck": true,
          "usePlaceholders": false,
          "ui.semanticTokens": true
        },
        "[go][go.mod]": {
          "editor.defaultFormatter": "golang.go",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}