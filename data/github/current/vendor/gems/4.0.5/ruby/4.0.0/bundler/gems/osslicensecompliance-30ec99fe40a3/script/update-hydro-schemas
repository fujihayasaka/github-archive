
#!/bin/bash

set -euo pipefail

# Clone the github/hydro-schemas repository as a sibling directory to
# github/osslicensecompliance, and run this script.

root=$(realpath "$(dirname "$0")/..")

if [[ ! -d "$root/../hydro-schemas" ]]; then
  echo "Cloning github/hydro-schemas to $(realpath "${root}"/..)/hydro-schemas..."
  git clone https://github.com/github/hydro-schemas.git "$root/../hydro-schemas"
else
  echo "Updating github/hydro-schemas..."
  cd "$root/../hydro-schemas" || exit 1
  git pull
fi

cd "${root}/../hydro-schemas" || exit 1

script/generate \
  --go-prefix github.com/github/osslicensecompliance/hydroproto \
  --go-out ../osslicensecompliance/hydroproto \
  proto/hydro/schemas/github/dependencygraph/v1/snapshot_processed.proto \
  proto/hydro/schemas/github/dependencygraph/v1/pull_request_license_check_complete.proto \
  proto/hydro/schemas/github/dependencygraph/v1/license_compliance_alert_status_changed.proto \
  proto/hydro/schemas/github/dependencygraph/v1/license_policy_changed.proto \
  proto/hydro/schemas/github/dependencygraph/v1/pull_request_license_check_progressed.proto
