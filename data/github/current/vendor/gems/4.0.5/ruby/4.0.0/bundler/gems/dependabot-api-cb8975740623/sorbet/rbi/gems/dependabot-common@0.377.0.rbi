  # pkg:gem/dependabot-common#lib/dependabot/dependency_graphers/base.rb:102
  sig { params(dependency: ::Dependabot::Dependency).returns(T::Array[::Dependabot::Dependency]) }
  def safe_fetch_subdependencies(dependency); end
