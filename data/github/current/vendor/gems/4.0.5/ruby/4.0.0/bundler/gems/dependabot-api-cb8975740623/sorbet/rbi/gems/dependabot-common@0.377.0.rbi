    #
    # pkg:gem/dependabot-common#lib/dependabot/file_filtering.rb:92
    sig { params(path: ::String, context: ::String, exclude_paths: T.nilable(T::Array[::String])).returns(T::Boolean) }
    def should_exclude_path?(path, context, exclude_paths); end
  end
end

