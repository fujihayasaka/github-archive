# @abstract It cannot be directly instantiated. Subclasses must implement the `abstract` methods below.
#
# pkg:gem/dependabot-common#lib/dependabot/requirement.rb:7
class Dependabot::Requirement < ::Gem::Requirement
  abstract!

  # Returns all requirement constraints as an array of strings
  #
  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:27
  sig { returns(T::Array[::String]) }
  def constraints; end

  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:88
  sig { params(version: ::Dependabot::Version).returns(::Dependabot::Version) }
  def handle_greater_than_for_min(version); end

  # Methods for handling minimum constraints
  #
  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:83
  sig { params(version: ::Dependabot::Version).returns(::Dependabot::Version) }
  def handle_greater_than_or_equal_for_min(version); end

  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:104
  sig { params(version: ::Dependabot::Version).returns(::Dependabot::Version) }
  def handle_less_than_max(version); end

  # Methods for handling maximum constraints
  #
  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:99
  sig { params(version: ::Dependabot::Version).returns(::Dependabot::Version) }
  def handle_less_than_or_equal_for_max(version); end

  # Dynamically handles maximum operators
  #
  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:73
  sig { params(operator: ::String, version: ::Dependabot::Version).returns(T.nilable(::Dependabot::Version)) }
  def handle_max_operator(operator, version); end

  # Dynamically handles minimum operators
  #
  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:63
  sig { params(operator: ::String, version: ::Dependabot::Version).returns(T.nilable(::Dependabot::Version)) }
  def handle_min_operator(operator, version); end

  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:93
  sig { params(version: ::Dependabot::Version).returns(::Dependabot::Version) }
  def handle_tilde_pessimistic_for_min(version); end

  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:109
  sig { params(version: ::Dependabot::Version).returns(::Dependabot::Version) }
  def handle_tilde_pessimistic_max(version); end

  # Returns the lowest upper limit among all maximum constraints.
  #
  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:48
  sig { returns(T.nilable(::Dependabot::Version)) }
  def max_version; end

  # Returns the highest lower limit among all minimum constraints.
  #
  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:33
  sig { returns(T.nilable(::Dependabot::Version)) }
  def min_version; end

  private

  # pkg:gem/dependabot-common#lib/dependabot/requirement.rb:123
  sig { params(version: ::Dependabot::Version).returns(::Dependabot::Version) }
  def bump_major_segment(version); end

