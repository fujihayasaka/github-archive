# Composes a final PR title from a base title + prefix.
#
# Works in two modes:
# 1. With a full PrNamePrefixer (updater path — has source/credentials for
#    commit style auto-detection)
# 2. With just commit_message_options (API path — explicit prefix only,
#    no network calls needed)
#
# pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:19
class Dependabot::PullRequestCreator::MessageBuilder::TitleBuilder
  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:42
  sig do
    params(
      base_title: ::String,
      prefixer: T.nilable(::Dependabot::PullRequestCreator::PrNamePrefixer),
      commit_message_options: T.nilable(T::Hash[::Symbol, T.untyped]),
      dependencies: T.nilable(T::Array[::Dependabot::Dependency])
    ).void
  end
  def initialize(base_title:, prefixer: T.unsafe(nil), commit_message_options: T.unsafe(nil), dependencies: T.unsafe(nil)); end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:23
  sig { returns(::String) }
  def base_title; end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:57
  sig { returns(::String) }
  def build; end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:29
  sig { returns(T.nilable(T::Hash[::Symbol, T.untyped])) }
  def commit_message_options; end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:32
  sig { returns(T.nilable(T::Array[::Dependabot::Dependency])) }
  def dependencies; end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:26
  sig { returns(T.nilable(::Dependabot::PullRequestCreator::PrNamePrefixer)) }
  def prefixer; end

  private

  # Builds prefix from explicit commit_message_options only.
  # Same logic as PrNamePrefixer#prefix_from_explicitly_provided_details
  # but without requiring source/credentials.
  #
  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:87
  sig { returns(::String) }
  def build_explicit_prefix; end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:77
  sig { returns(T::Boolean) }
  def capitalize?; end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:102
  sig { returns(::String) }
  def explicit_prefix_string; end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:66
  sig { returns(::String) }
  def prefix; end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:113
  sig { returns(T::Boolean) }
  def production_dependencies?; end

  # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:120
  sig { returns(::String) }
  def scope; end

  class << self
    # Generates a base title for multi-ecosystem combined PR updates.
    #
    # pkg:gem/dependabot-common#lib/dependabot/pull_request_creator/message_builder/title_builder.rb:51
    sig { params(group_name: ::String, update_count: ::Integer).returns(::String) }
    def multi_ecosystem_base_title(group_name:, update_count:); end
  end
end

