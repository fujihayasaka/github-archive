  #
  # pkg:gem/dependabot-gradle#lib/dependabot/gradle/package/release_date_extractor.rb:150
  sig { params(link: ::Nokogiri::XML::Element, version: ::String).returns(T.nilable(::Time)) }
  def extract_release_date_from_link(link, version); end

  # pkg:gem/dependabot-gradle#lib/dependabot/gradle/package/release_date_extractor.rb:139
  sig { params(link: ::Nokogiri::XML::Element).returns(T.nilable(::String)) }
  def extract_version_from_link(link); end

  # Parses Gradle Plugin Portal maven-metadata.xml for release dates.
  #
  # pkg:gem/dependabot-gradle#lib/dependabot/gradle/package/release_date_extractor.rb:118
  sig do
    params(
      repository_details: T::Hash[::String, T.untyped],
      release_date_info: T::Hash[::String, T::Hash[::Symbol, T.untyped]],
