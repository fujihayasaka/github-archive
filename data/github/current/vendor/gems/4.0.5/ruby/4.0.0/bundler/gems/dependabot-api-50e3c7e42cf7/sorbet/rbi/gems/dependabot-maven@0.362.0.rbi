  def extract_version_suffix(version_string); end

  # Extracts the major Java version number from a JRE/JDK version suffix.
  #
  # @example
  #   java_major_version("jre8")  # => 8
  #   java_major_version("jdk17") # => 17
  #
  # source://dependabot-maven//lib/dependabot/maven/shared/shared_version_finder.rb#118
  sig { params(jre_jdk_suffix: ::String).returns(::Integer) }
  def java_major_version(jre_jdk_suffix); end

  # Matches if the current version is a JDK version suffix.
  #
  # @example
  #   jdk?("jre8")  # => false
  #   jdk?("jdk8") # => true
  #
  # source://dependabot-maven//lib/dependabot/maven/shared/shared_version_finder.rb#145
  sig { params(version: T.nilable(::String)).returns(T::Boolean) }
  def jdk?(version); end

  # Matches if the current version is a JRE version suffix.
  #
  # @example
  #   jre?( "jre8") # => true
  #   jre?("jdk8") # => false
  #
  # source://dependabot-maven//lib/dependabot/maven/shared/shared_version_finder.rb#133
  sig { params(version: T.nilable(::String)).returns(T::Boolean) }
  def jre?(version); end

  # source://dependabot-maven//lib/dependabot/maven/shared/shared_version_finder.rb#123
