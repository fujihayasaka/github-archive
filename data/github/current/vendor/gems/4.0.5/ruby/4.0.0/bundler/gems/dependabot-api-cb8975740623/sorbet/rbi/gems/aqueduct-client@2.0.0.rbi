# pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:6
class Aqueduct::Worker::Worker
  # Public: Build a new aqueduct worker.
  #
  # backend - The Backend used for receiving and ACKing jobs (required).
  # queues  - An Array<String> of queues to receive from (required).
  # logger  - A Logger (required).
  # config  - An Aqueduct::Worker config to inject the job handler, error
  #           handler, callbacks, etc.
  #
  # @return [Worker] a new instance of Worker
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:16
  def initialize(backend:, queues:, logger:, config: T.unsafe(nil)); end

  # Returns the value of attribute backend.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:7
  def backend; end

  # Returns the value of attribute config.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:7
  def config; end

  # Returns the value of attribute current_job.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:7
  def current_job; end

  # Returns the value of attribute current_job_started_at.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:7
  def current_job_started_at; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:181
  def id; end

  # Returns the value of attribute idle_ms.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:7
  def idle_ms; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:174
  def inspect; end

  # Returns the value of attribute last_heartbeat_at.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:7
  def last_heartbeat_at; end

  # Returns the value of attribute logger.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:7
  def logger; end

  # Stop processing jobs after the current one has completed (if we're
  # currently running one).
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:185
  def pause_processing; end

  # Returns the value of attribute queues.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:7
  def queues; end

  # @return [Boolean]
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:170
  def send_heartbeat?; end

  # Schedule this worker for shutdown. Will finish processing the
  # current job.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:198
  def shutdown; end

  # Kill the child and shutdown immediately.
  # If not forking, abort this process.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:211
  def shutdown!(signal = T.unsafe(nil)); end

  # Should this worker shutdown as soon as current job is finished?
  #
  # @return [Boolean]
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:205
  def shutdown?; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:145
  def start_heartbeat; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:166
  def stop_heartbeat; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:178
  def to_s; end

  # Start processing jobs again after a pause
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:191
  def unpause_processing; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:59
  def work(interval = T.unsafe(nil), &block); end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:55
  def worker_id; end

  private

  # chomp'd hostname of this worker's machine
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:341
  def hostname; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:317
  def kill_child; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:356
  def monotonic_now_ms; end

  # are we paused?
  #
  # @return [Boolean]
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:220
  def paused?; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:260
  def perform(job); end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:285
  def perform_with_fork(job, &block); end

  # Given a status, sets the procline ($0) and logs.
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:346
  def procline(status); end

  # @return [Boolean]
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:224
  def quiesced?; end

  # Registers the various signal handlers a worker responds to.
  #
  # TERM: If terminating gracefully, shut down after the current job has
  #       been processed. Otherwise, shutdown immediately. Either way, don't
  #       process any new jobs.
  #  INT: Shutdown immediately, stop processing jobs.
  # QUIT: Shutdown after the current job has finished processing.
  # USR1: Kill the forked child immediately, continue processing jobs.
  # USR2: Don't process any new jobs
  # CONT: Start processing jobs again after a USR2
  #
  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:238
  def register_signal_handlers; end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:310
  def reject(job); end

  # pkg:gem/aqueduct-client#lib/aqueduct/worker/worker.rb:254
  def validate_queues; end
end

