#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")/.."

# Install skeema if necessary
if [[ ! -f _tools/bin/skeema ]]; then
    script/install-tools
fi

# NOTE: skeema recurses into subdirectories looking for .skeema files unless it
# finds one in the current working directory.
#
# By cd'ing to the schemas directory, we avoid errors from skeema hitting
# recursion limits.
#
# See: https://www.skeema.io/docs/config/#execution-model-and-per-directory-option-files
cd schemas
../_tools/bin/skeema "$@"
