        "PORT": "2209"
      }
    },
    {
      "name": "Debug sweagentd-worker (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "cmd/worker/main.go"
    }
  ]
