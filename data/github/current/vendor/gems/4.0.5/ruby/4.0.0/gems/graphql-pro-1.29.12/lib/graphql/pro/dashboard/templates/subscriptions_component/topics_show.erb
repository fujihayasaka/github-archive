<div class="page-header">
  <h3>Topic: <code><%= topic_name %></code></h3>
</div>
<p>Last triggered: <%= localize_date(topic_last_triggered_at) %></p>
<br>
<p><%= pluralize("Subscription", subscriptions_count) %></p>

<table>
  <thead>
    <tr>
      <th>Subscription ID</th>
      <th>Created At</th>
      <th>Subscribed?</th>
      <th>Broadcast?</th>
      <% if show_broadcast_subscribers_count %><th>Subscribers</th><% end %>
    </tr>
  </thead>
  <tbody>
    <% subscriptions.each do |subscription| %>
      <tr>
        <td><%= link_to(subscription[:id], subscriptions_show_path(subscription_id: subscription[:id])) %></td>
        <td><%= localize_date(subscription[:created_at]) %></td>
        <td><code><%= subscription[:still_subscribed] ? "YES" : "NO" %></code></td>
        <td><code><%= subscription[:is_broadcast] ? "YES" : "NO" %></code></td>
        <% if show_broadcast_subscribers_count %><td><%= subscription[:subscribers_count] %></td><% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render_partial("_pagination") %>
