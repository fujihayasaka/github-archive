<%= render Primer::BaseComponent.new(tag: :div, **system_arguments) do %>
  <%= render(Primer::ButtonComponent.new(**stage_one.button_attributes)) do |button| %>
    <%= render IconComponent.new(icon: stage_one.icon, mr: 3, flex_shrink: 0) %>
    <%= stage_one.label.capitalize %>
  <% end %>
  <%= render(Primer::ButtonComponent.new(**stage_two.button_attributes)) do |button| %>
    <%= render IconComponent.new(icon: stage_two.icon, mr: 3, flex_shrink: 0) %>
    <%= stage_two.label.capitalize %>
  <% end %>
  <%= render(dialogs) do |dialogs| %>
    <% dialogs.with_stage_two_confirmation_preamble_content(stage_two_confirmation_preamble) %>
    <% dialogs.with_stage_two_confirmation_diff_content(stage_two_confirmation_diff) %>
  <% end %>
<% end %>
