# Development environment configuration with Cosmos DB Emulator
# This file provides environment variables for using the Cosmos DB emulator in development.
#
# To use this configuration:
# 1. Start the Cosmos emulator: script/cosmos-dev start
# 2. Load this file by copying to .env or sourcing it
#
# The emulator provides a more realistic development environment that can help catch
# race conditions and other issues that only appear with real Cosmos DB.

# Cosmos DB Emulator configuration
# For the emulator, we use connection string only (not endpoint) to avoid Azure auth
# AZURE_COSMOSDB_ENDPOINT="https://localhost:8181/"
AZURE_COSMOSDB_CONNECTION_STRING="AccountEndpoint=https://localhost:8181/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==;"

# Default database and container names
AZURE_COSMOSDB_DATABASE="sweagentd"
AZURE_COSMOSDB_CONTAINER_ASSIGNMENT="assignments"
AZURE_COSMOSDB_CONTAINER_JOBS="jobs"
AZURE_COSMOSDB_CONTAINER_LOGS="job-logs"
AZURE_COSMOSDB_CONTAINER_COMMANDS="job-commands"
AZURE_COSMOSDB_CONTAINER_MEMORY="memory"
AZURE_COSMOSDB_CONTAINER_REPOSITORY_AGENTS="repo-agents"
AZURE_COSMOSDB_CONTAINER_ORGANIZATION_AGENTS="org-agents"
AZURE_COSMOSDB_CONTAINER_ENTERPRISE_AGENTS="enterprise-agents"