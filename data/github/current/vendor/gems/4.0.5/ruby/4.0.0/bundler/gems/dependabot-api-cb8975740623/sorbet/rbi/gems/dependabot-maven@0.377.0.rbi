Dependabot::Maven::Shared::SharedVersionFinder::MAVEN_PRE_RELEASE_QUALIFIERS = T.let(T.unsafe(nil), Regexp)

# Regex to match common Maven release qualifiers that indicate stable releases.
# See https://github.com/apache/maven/blob/848fbb4bf2d427b72bdb2471c22fced7ebd9a7a1/maven-artifact/src/main/java/org/apache/maven/artifact/versioning/ComparableVersion.java#L315-L320
#
# pkg:gem/dependabot-maven#lib/dependabot/maven/shared/shared_version_finder.rb:20
Dependabot::Maven::Shared::SharedVersionFinder::MAVEN_RELEASE_QUALIFIERS = T.let(T.unsafe(nil), Regexp)

# pkg:gem/dependabot-maven#lib/dependabot/maven/shared/shared_version_finder.rb:49
Dependabot::Maven::Shared::SharedVersionFinder::MAVEN_SNAPSHOT_QUALIFIER = T.let(T.unsafe(nil), Regexp)

# pkg:gem/dependabot-maven#lib/dependabot/maven/shared/shared_version_finder.rb:53
