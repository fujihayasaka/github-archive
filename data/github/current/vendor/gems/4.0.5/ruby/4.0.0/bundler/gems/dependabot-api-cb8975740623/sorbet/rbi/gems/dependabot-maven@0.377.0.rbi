# Regex for a valid Git SHA
# - Only hexadecimal characters (0-9, a-f)
# - Case-insensitive
# - At least one letter a-f to avoid purely numeric strings
#
# pkg:gem/dependabot-maven#lib/dependabot/maven/shared/shared_version_finder.rb:59
