#!/usr/bin/env bash
#
# Builds a docker image for the bootstrap-skeema container in docker-compose.yml.
#
# - BLACKBIRD_BUILD_IMAGE - This env var can point to e.g. a
#   ghcr.io/github/blackbird/blackbird-build-image image, which could be cached
#   locally. But if it is not set, then a gh-builder-focal image is downloaded
#   and used.

set -euo pipefail

cd "$(dirname "$0")/.."

if [[ ! -v BLACKBIRD_BUILD_IMAGE ]]; then
  BLACKBIRD_BUILD_IMAGE="ghcr.io/github/gh-base-image/gh-builder-focal:20250725-230644-gc2200759f@sha256:cdad63d2312e8ad1f889159a39985c7e8e43492a6c930a87d1123f12c3e02d18"
  export DOCKER_DEFAULT_PLATFORM="linux/amd64"
fi

docker build \
  --file Dockerfile.build-mw-binaries \
  --build-arg "BUILDER_IMAGE=$BLACKBIRD_BUILD_IMAGE" \
  --target setup \
  --tag blackbird-mw-bootstrap-skeema \
  --progress plain \
  .
