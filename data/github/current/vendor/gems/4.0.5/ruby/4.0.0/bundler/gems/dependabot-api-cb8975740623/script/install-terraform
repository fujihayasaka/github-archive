#!/bin/bash

# This script is used to install terraform in codespace.

set -e

TERRAFORM_VERSION="1.4.4"
echo "==> Downloading terraform..."
curl -LO https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip

echo "==> Installing terraform..."
sudo unzip -o terraform_${TERRAFORM_VERSION}_linux_amd64.zip -d /usr/local/bin/

echo "==> Moving downloaded terraform package to /tmp directory..."
mv terraform_${TERRAFORM_VERSION}_linux_amd64.zip /tmp/
