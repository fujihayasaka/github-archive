    sig { params(parsed_composer_json: T::Hash[::String, T.untyped]).returns(T.nilable(::String)) }
    def capture_platform_php(parsed_composer_json); end

    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:150
    sig { params(output: ::String, regex: ::Regexp).returns(T.nilable(::String)) }
    def capture_version(output, regex); end

    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:51
    sig do
      params(
        composer_json: T::Hash[::String, T.untyped],
        parsed_lockfile: T.nilable(T::Hash[::String, T.untyped])
      ).returns(::String)
    end
    def composer_version(composer_json, parsed_lockfile = T.unsafe(nil)); end

    # Capture extension version constraint from composer.json
    #
    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:175
    sig { params(parsed_composer_json: T::Hash[::String, T.untyped], name: ::String).returns(T.nilable(::String)) }
    def dependency_constraint(parsed_composer_json, name); end

    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:88
    sig { params(message: ::String).returns(T.nilable(::String)) }
    def dependency_url_from_git_clone_error(message); end

    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:94
    sig { params(message: ::String, regex: ::Regexp).returns(T.nilable(::String)) }
    def extract_and_clean_dependency_url(message, regex); end

    # Example output:
    # [dependabot] ~ $ composer --version
    # Composer version 2.7.7 2024-06-10 22:11:12
    # PHP version 7.4.33 (/usr/bin/php7.4)
    # Run the "diagnose" command to get more detailed diagnostics output.
    # Get the version of the composer and php form the command output
    # => { composer: "2.7.7", php: "7.4.33" }
    #
    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:134
