    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:108
    sig { params(command: ::String, fingerprint: T.nilable(::String)).returns(::String) }
    def package_manager_run_command(command, fingerprint: T.unsafe(nil)); end

    # Capture PHP version constraint from composer.json
    #
    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:169
    sig { params(parsed_composer_json: T::Hash[::String, T.untyped]).returns(T.nilable(::String)) }
    def php_constraint(parsed_composer_json); end

    private

    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:190
    sig { params(dependency_url: ::String).returns(::String) }
    def clean_dependency_url(dependency_url); end

    # pkg:gem/dependabot-composer#lib/dependabot/composer/helpers.rb:180
    sig { params(composer_json: T::Hash[::String, T.untyped]).returns(T::Boolean) }
    def invalid_v2_requirement?(composer_json); end
  end
end

