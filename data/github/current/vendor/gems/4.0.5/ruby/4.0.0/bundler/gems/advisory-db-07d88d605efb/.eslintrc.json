{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "compat", "delegated-events", "filenames", "escompat", "import", "github"],
  "extends": ["plugin:github/internal", "plugin:github/recommended","plugin:github/browser", "plugin:escompat/typescript", "plugin:github/typescript"],
  "rules": {
    "prettier/prettier": ["error", {"semi": false, "singleQuote": true}],
    "compat/compat": ["error"],
    "delegated-events/global-on": ["error"],
    "delegated-events/no-high-freq": ["error"],
    "filenames/match-regex": ["error", "^[a-z0-9-]+(.d)?$"],
    "eslint-comments/no-use": 1,
    "escompat/no-dynamic-imports": "off",
    "i18n-text/no-en": "off",
    "import/extensions": "error",
    "import/no-amd": "error",
    "import/no-commonjs": "error",
    "import/no-dynamic-require": "error",
    "import/no-extraneous-dependencies": [0, {"devDependencies": false}],
    "import/no-nodejs-modules": "error",
    "import/no-unresolved": "error",
    "import/no-webpack-loader-syntax": "error",
    "no-console": ["warn"],
    "no-sequences": ["error"],
    "no-shadow": "off",
    "one-var": ["error", "never"],
    "sort-imports": "error",
    "semi": "off",
    "quotes": "off",
    "@typescript-eslint/semi": ["error", "never"],
    "@typescript-eslint/no-shadow": "error",
    "@typescript-eslint/no-unused-vars": ["error", {"varsIgnorePattern": "^[A-Z][a-zA-Z]+(Controller|Element)$"}],
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "NewExpression[callee.name='URL'][arguments.length=1]",
        "message": "Please pass in `window.location.origin` as the 2nd argument to `new URL()`"
      }
    ]
  },
  "settings": {
    "polyfills": ["Request", "window.customElements", "window.requestIdleCallback"],
    "import/resolver": {
      "node": {
        "extensions": [".js", ".ts"],
        "moduleDirectory": ["node_modules", "app/assets/modules"]
      }
    }
  },
  "overrides": [
    {
      "files": ["karma-config.js", "*.config.js", "test/linting/*.js"],
      "extends": ["plugin:github/internal", "plugin:escompat/typescript"],
      "parser": "espree",
      "env": {
        "node": true,
        "browser": false
      },
      "globals": {
        "process": true,
        "__dirname": true
      },
      "rules": {
        "@typescript-eslint/no-var-requires": "off",
        "escompat/no-object-rest-spread": "off",
        "escompat/no-optional-catch": "off",
        "filenames/match-regex": "off",
        "import/no-commonjs": "off",
        "import/no-nodejs-modules": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["*.d.ts"],
      "rules": {
        "@typescript-eslint/no-unused-vars": "off",
        "no-var": "off"
      }
    }
  ]
}
