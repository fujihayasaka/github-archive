#!/bin/bash

set -e


SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

echo "Building runtime..."

cd $SCRIPT_DIR/../runtime
npm install
npm run prebuild
npm run build:msbench

echo "Building MCP client..."
npm run build:mcp-client

echo "Building CPD runner..."

cd $SCRIPT_DIR/../runtime/benchmarks/msbench/cpd-msbench-runner
npm install
npm run build
