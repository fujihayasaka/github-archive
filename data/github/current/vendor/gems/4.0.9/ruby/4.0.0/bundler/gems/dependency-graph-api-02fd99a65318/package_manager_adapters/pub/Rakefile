#!/usr/bin/env rake

require "rake/testtask"

require_relative "lib/pub_importer"

Rake::TestTask.new do |t|
  t.libs << "test"
  t.test_files = FileList["test/*_test.rb"]
  t.warning = false
end

task default: :test

task :run do
  Pub.run_importer
end

task :full_import do
  Pub.run_importer(full_import: true)
end

task :restart_publish, [:from_page] do |t, args|
  Pub.run_importer(from_page: args[:from_page].to_i)
end

task :single_import, [:package_name, :versions]  do |t, args|
  Pub.import_package(
    target_package: args[:package_name].to_s,
    target_versions: args[:versions].to_s,
  )
end
