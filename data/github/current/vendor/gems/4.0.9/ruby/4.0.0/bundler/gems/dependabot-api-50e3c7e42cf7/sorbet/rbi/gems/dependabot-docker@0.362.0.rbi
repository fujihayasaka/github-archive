  def <=>(other); end

  # source://dependabot-docker//lib/dependabot/docker/version.rb#71
  sig { returns(::Dependabot::Version) }
  def release_part; end

  # source://dependabot-docker//lib/dependabot/docker/version.rb#66
  sig { returns(T::Array[::String]) }
  def segments; end

  # source://dependabot-docker//lib/dependabot/docker/version.rb#79
  sig { returns(T::Array[::Dependabot::Version]) }
  def sort_criteria; end

  # source://dependabot-docker//lib/dependabot/docker/version.rb#61
