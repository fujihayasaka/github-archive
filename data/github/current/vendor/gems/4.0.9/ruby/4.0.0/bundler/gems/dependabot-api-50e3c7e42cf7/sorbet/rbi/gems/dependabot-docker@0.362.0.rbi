  class << self
    # source://dependabot-docker//lib/dependabot/docker/version.rb#42
    sig { override.params(version: T.nilable(T.any(::Gem::Version, ::Integer, ::String))).returns(T::Boolean) }
    def correct?(version); end
  end
end

# The regex has limits for the 0,255 and 1,255 repetitions to avoid infinite limits which makes codeql angry.
# A docker image cannot be longer than 255 characters anyways.
#
# source://dependabot-docker//lib/dependabot/docker/version.rb#21
Dependabot::Docker::Version::DOCKER_VERSION_REGEX = T.let(T.unsafe(nil), Regexp)

