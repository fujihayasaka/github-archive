  sig { params(other: ::BasicObject).returns(T.nilable(::Integer)) }
  def <=>(other); end

  # source://dependabot-devcontainers//lib/dependabot/devcontainers/version.rb#15
  sig { params(other: ::Dependabot::Devcontainers::Version).returns(T::Boolean) }
  def same_precision?(other); end

  # source://dependabot-devcontainers//lib/dependabot/devcontainers/version.rb#20
  sig { params(requirement: ::Dependabot::Requirement).returns(T::Boolean) }
  def satisfies?(requirement); end

  protected

  # source://dependabot-devcontainers//lib/dependabot/devcontainers/version.rb#36
  sig { returns(::Integer) }
  def precision; end
end
