# pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:12
class Dependabot::Python::Requirement < ::Dependabot::Requirement
  # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:71
  sig { params(requirements: T.nilable(T.any(::String, T::Array[::String]))).void }
  def initialize(*requirements); end

  # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:94
  sig { returns(T::Boolean) }
  def exact?; end

  # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:87
  sig { params(version: T.any(::Gem::Version, ::String)).returns(T::Boolean) }
  def satisfied_by?(version); end

  private

  # Poetry uses ^ requirements
  # https://github.com/sdispater/poetry#caret-requirement
  #
  # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:133
  sig { params(req_string: ::String).returns(T::Array[::String]) }
  def convert_caret_req(req_string); end

  # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:173
  sig { params(req_string: ::String).returns(T.any(::String, T::Array[::String])) }
  def convert_exact(req_string); end

  # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:103
  sig { params(req_string: T.nilable(::String)).returns(T.nilable(T.any(::String, T::Array[::String]))) }
  def convert_python_constraint_to_ruby_constraint(req_string); end

  # Poetry uses ~ requirements.
  # https://github.com/sdispater/poetry#tilde-requirements
  #
  # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:123
  sig { params(req_string: ::String).returns(::String) }
  def convert_tilde_req(req_string); end

  # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:154
  sig { params(req_string: ::String).returns(::String) }
  def convert_wildcard(req_string); end

  class << self
    # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:35
    sig { params(obj: T.any(::Gem::Version, ::String)).returns([::String, ::Gem::Version]) }
    def parse(obj); end

    # Returns an array of requirements. At least one requirement from the
    # returned array must be satisfied for a version to be valid.
    #
    # NOTE: Or requirements are only valid for Poetry.
    #
    # pkg:gem/dependabot-python#lib/dependabot/python/requirement.rb:58
    sig do
      override
        .params(
          requirement_string: T.nilable(::String)
        ).returns(T::Array[::Dependabot::Python::Requirement])
    end
    def requirements_array(requirement_string); end
  end
end

