#!/bin/bash

set -uo pipefail

if [ -z ${FAST_DEV_LOOP+x} ]; 
then 
  export FAST_DEV_LOOP=0 
fi

appdir=$(cd $(dirname "$0")/.. && pwd)
[ -f /etc/app-env ] || [ "$FAST_DEV_LOOP" = "1" ] || exec "$appdir/script/app-env" $0 $@

for i in {1..60}; do
  if [ "$FAST_DEV_LOOP" = "1" ]
  then
    netcat -z 127.0.0.1 3307 && exit
  else
    netcat -z db 3306 && exit
  fi
  sleep 1
done

echo "Unable to reach database!"
exit 1
