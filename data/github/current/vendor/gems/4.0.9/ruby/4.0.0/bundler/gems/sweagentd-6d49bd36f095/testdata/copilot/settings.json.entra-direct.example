{
  "oidcConfig": [
    {
      "secretSuffix": "OIDC_TEST",
      "audience": "api://AzureADTokenExchange",
      "endpoints": {
        "base": "https://login.microsoftonline.com/{tenant_id}/v2.0",
        "failure": "http://some-location.com/auth-failed"
      },
      "client": "{client_id}",
      "scope": "{client_id}/.default offline_access"
    }
  ]
}
