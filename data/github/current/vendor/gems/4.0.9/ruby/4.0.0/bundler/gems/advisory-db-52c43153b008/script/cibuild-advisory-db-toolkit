#!/bin/bash

set -eu

cd "$(dirname "$0")/.."

DIR=$(pwd)
RUBY_VARIANT=${RUBY_VARIANT:-3.2}

set -x

docker run -v ${DIR}/packages/advisory_db_toolkit:/workspace -i ghcr.io/github/gh-base-image/ruby-builder:v${RUBY_VARIANT}-noble /bin/bash <<EOF
cd /workspace
bundle install
bundle exec rake test /
EOF
