<h4 class="h6 color-fg-muted">EPSS score</h4>
<% if epss_data? %>
  <div><span class="sidebar-key" >Percentage</span><span <%= test_selector("epss-percentage") %>><%= epss_percentage %></span></div>
  <div><span class="sidebar-key" >Percentile</span><span <%= test_selector("epss-percentile") %>><%= epss_percentile %></span></div>
<% elsif epss_error? %>
  <%= render IconComponent.new(id: "epss_failure_icon", mr: 2, icon: "x-circle-fill", color: :danger, test_selector: "failed-epss-fetch-icon") %>
  <%= render(Primer::Alpha::Tooltip.new(for_id: "epss_failure_icon", text: "#{epss_error.to_s}", direction: :w, type: :description, w: :fit)) %>
  <span <%= test_selector("epss-error-text") %>>
    Error fetching EPSS data
  </span>
<% else %>
  <span <%= test_selector("epss-no-data-text") %>>
    No EPSS data found for advisory.
  </span>
<% end %>
