{"name":"GIMP Interpreter Definition","scopeName":"source.interp","patterns":[{"include":"#main"}],"repository":{"binfmt":{"name":"meta.binfmt-spec.interp","match":"(?x)^\n(\\S) # Initial character specifies delimiter\n((?:(?!\\1)[^\\r\\n])*+) (\\1) # Name\n((?:(?!\\1)[^\\r\\n])*+) (\\1) # Type\n((?:(?!\\1)[^\\r\\n])*+) (\\1) # Offset\n((?:(?!\\1)[^\\r\\n])*+) (\\1) # Match\n((?:(?!\\1)[^\\r\\n])*+) (\\1) # Mask ANDed with match (only if magic number)\n((?:(?!\\1)[^\\r\\n])*+) (\\1) # Interpreter\n((?:(?!\\1)[^\\r\\n])*+)       # Flags","captures":{"1":{"patterns":[{"include":"#delim"}]},"10":{"name":"string.quoted.other.mask.interp","patterns":[{"include":"#esc"}]},"11":{"patterns":[{"include":"#delim"}]},"12":{"name":"string.quoted.other.filename.interp"},"13":{"patterns":[{"include":"#delim"}]},"14":{"name":"meta.association-flags.interp","patterns":[{"name":"storage.modifier.flag.preserve-argv.interp","match":"P"},{"name":"storage.modifier.flag.open-binary.interp","match":"O"},{"name":"storage.modifier.flag.credentials.interp","match":"C"},{"name":"storage.modifier.flag.fix-binary.interp","match":"F"},{"name":"invalid.illegal.argument.unrecognised-flag.interp","match":"[^POCF\\s]"}]},"2":{"name":"entity.name.interpreter.interp"},"3":{"patterns":[{"include":"#delim"}]},"4":{"name":"meta.association-type.interp","patterns":[{"name":"storage.type.association.magic.interp","match":"^(M)$"},{"name":"storage.type.association.extension.interp","match":"^(E)$"},{"name":"invalid.illegal.argument.interp","match":"^.*\\S.*$"}]},"5":{"patterns":[{"include":"#delim"}]},"6":{"name":"meta.match-offset.interp","patterns":[{"include":"etc#intNoExp"},{"name":"invalid.illegal.argument.interp","match":"^.*\\D.*$"}]},"7":{"patterns":[{"include":"#delim"}]},"8":{"name":"string.quoted.other.match.interp","patterns":[{"include":"#esc"}]},"9":{"patterns":[{"include":"#delim"}]}}},"delim":{"name":"punctuation.delimiter.separator.field.interp","match":"^\\S+","captures":{"0":{"name":"subl