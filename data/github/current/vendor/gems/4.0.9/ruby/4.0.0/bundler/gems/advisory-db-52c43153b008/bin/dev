#!/usr/bin/env ruby

# Advisory team : This custom section is part of the Rails application setup process.
# Don't remove unless necessary after rails upgrade. Modify if required for your rails environment.
def command_exists?(command)
  system("command -v #{command} > /dev/null 2>&1")
end

unless command_exists?("foreman")
  puts "Installing foreman..."
  system("gem install foreman")
end

exec("foreman start -f Procfile.dev", *ARGV)
