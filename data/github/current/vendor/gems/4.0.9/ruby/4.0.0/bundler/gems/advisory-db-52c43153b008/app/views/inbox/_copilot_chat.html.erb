<% unless AdvisoryDB::Config::CurationMCP.chat_disabled? %>
  <copilot-chat>
    <%= render(Primer::Alpha::Dialog.new(
      title: "Copilot Chat",
      id: "copilot-chat-dialog",
      position: :right
    )) do |d| %>
      <% d.with_show_button(icon: :copilot, scheme: :invisible, p: 0, size: :small, "aria-label": "Copilot Chat") %>
      <% d.with_body do %>
        <p class="color-fg-muted mb-3">Ask Copilot Chat for help with this advisory review.</p>
        <div data-target="copilot-chat.responseContainer"></div>
      <% end %>
      <% d.with_footer(show_divider: true) do %>
        <%= text_area_tag "message", nil, rows: 4, cols: 100, style: 'width:100%;', autofocus: true, data: {target: "copilot-chat.requestMessageInput" } %>
        <%= render Primer::Beta::Button.new(
          scheme: :primary,
          data: { action: "click:copilot-chat#fetchResponse", target: "copilot-chat.sendButton" }
        ) do %>
          Send
        <% end %>
      <% end %>
    <% end %>
  </copilot-chat>
<% end %>