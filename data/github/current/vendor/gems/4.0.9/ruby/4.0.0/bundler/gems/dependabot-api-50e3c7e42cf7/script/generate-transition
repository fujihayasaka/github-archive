#!/bin/bash
appdir=$(cd $(dirname "$0")/.. && pwd)

if [ -f /etc/app-env ]; then
  exec bundle exec ruby $0 $@
else
  exec "$appdir/script/app-env" bundle exec ruby $0 $@
fi

#!/usr/bin/env ruby
# frozen_string_literal: true
#
#/ Usage: generate-transition <name>
#/
#/ This generates a transition file with some content
#/ as well as a test file.

unless (name = ARGV.shift)
  abort "usage: #$0 <name>"
end

require_relative "../config/boot.rb"
require "active_support/all"
require "erb"
require "fileutils"

now = Time.now.utc.strftime "%Y%m%d%H%M%S"
file = "lib/dependabot/transitions/#{now}_#{name.underscore}.rb"
test_file = "spec/lib/dependabot/transitions/#{now}_#{name.underscore}_spec.rb"
class_name = name.underscore.camelize

FileUtils.mkdir_p File.dirname file
FileUtils.mkdir_p File.dirname test_file

if File.exist? file
  abort "#$0: exists: #{file}"
end

template =<<'END'
# frozen_string_literal: true

require_relative "../../../config/environment"
require "slop"
require "dependabot/transition"

# rubocop:disable Layout/LineLength
#
# Transitions are orchestrated by the GitHub transitions service and are run
# via chatops:
#
#   .transitions run <pr-url> <environment> <arguments>
#
# A pull request is required to run a transition, so the first step is to
# create one for the transition files.
#
# To run a transition in a particular stamp, specify the stamp as the
# <environment>, e.g., prod-weu-01. To run a transition in all stamps,
# specify * as the <environment>.
#
# Before running a transition you should lock dependabot-api deployments.
#
# To run this transition in dry-run mode, issue the following chatop in the
# #dependabot-ops channel:
#
#   .transitions run <pr-url> <environment> <%= "#{now}_#{name.underscore}.rb" %> -v
#
# To run this transition in write mode, issue the following chatop in the
# #dependabot-ops channel:
#
#   .transitions run <pr-url> <environment> <%= "#{now}_#{name.underscore}.rb" %> -v -w
#
# Once the transition is complete, merge the pull request.
#
# rubocop:enable Layout/LineLength
module Dependabot
  module Transitions
    class <%= class_name %> < Dependabot::Transition
      # Transitions provide an alternative to running arbitrary code in
      # production without code review.
      #
      # When designing a transition, favor an approach that can be run in small
      # batches and ensure your script is idempotent and safe to resume/re-run.
      #
      # Database connections default to writing, so be sure to test dry runs
      # thoroughly.

      # Recommended batch size number, but you can modify for your use case
      BATCH_SIZE = 100

      attr_reader :iterator

      def after_initialize
        # Define the record set you plan to address, ensuring it is retrieved
        # in batches.
        # @iterator = MyModel.scope.in_batches(of: BATCH_SIZE)
      end

      # Returns nothing.
      def perform
        # iterator.each do |rows|
        #   process(rows)
        # end
      end

      def process(rows)
        # rows.each do |item|
        #   log "doing something with #{item}" if verbose?
        #   item.update(attribute: "new_value") unless dry_run?
        # end
      end
    end
  end
end

# Run as a single process if this script is run directly
if $PROGRAM_NAME == __FILE__
  slop = Slop.parse(help: true, strict: true) do |options|
    options.bool "-w",
                 "--write",
                 "Enable writes - this defaults to false for safety.",
                 default: false

    options.bool "-v",
                 "--verbose",
                 "Log verbose output"
  end

  options = slop.to_hash
  options = options.merge(dry_run: !options[:write])

  transition = Dependabot::Transitions::<%= class_name %>.new(**options)
  transition.run
end
END

test_template =<<END
# frozen_string_literal: true

require "rails_helper"

# rubocop:disable Layout/LineLength
require_relative "../../../../<%= file %>"
# rubocop:enable Layout/LineLength

RSpec.describe Dependabot::Transitions::<%= class_name %> do
  let(:transition) do
    described_class.new(dry_run: false)
  end

  let(:dry_run_transition) do
    described_class.new
  end

  before do
    # setup any fixtures, etc
  end

  context "write" do
    it "performs the transition" do
      # setup or verify initial state

      transition.perform

      # check that the db has changed as expected
    end
  end

  context "dry run" do
    it "does nothing on a dry run" do
      # setup or verify initial statedb

      dry_run_transition.perform

      # check that nothing has changed in the db
    end
  end
end
END

File.open file, "wb" do |f|
  erb = ERB.new template
  erb.filename = file
  f.write erb.result binding
end

File.open test_file, "wb" do |f|
  erb = ERB.new test_template
  erb.filename = test_file
  f.write erb.result binding
end

puts file
puts test_file
