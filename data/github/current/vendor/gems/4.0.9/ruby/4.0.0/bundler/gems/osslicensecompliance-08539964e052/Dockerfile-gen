# gh-builder-noble installs protoc
FROM ghcr.io/github/gh-base-image/gh-builder-noble:20260514-212954-gc1c861a8d AS base

ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org

RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.31.0
RUN go install github.com/twitchtv/twirp/protoc-gen-twirp@v8.1.3
RUN go install github.com/arthurnn/twirp-ruby/protoc-gen-twirp_ruby@v1.11.0
RUN go install github.com/pseudomuto/protoc-gen-doc/cmd/protoc-gen-doc@v1.5.1

COPY entrypoint-gen entrypoint-gen

# Needed for generating ruby/lib/oss_license_compliance/errors.rb
COPY script/generate-twirp-custom-errors-rb script/generate-twirp-custom-errors-rb
COPY internal/twirp/twcerr internal/twirp/twcerr

RUN chmod +x entrypoint-gen script/generate-twirp-custom-errors-rb

ENTRYPOINT [ "./entrypoint-gen" ]
