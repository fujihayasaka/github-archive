#!/bin/bash

# script/sideload-ds-api: Temporary script to make sideloading ds-api easier in dg-api codespace.
#  should be replaced by fixing ds-api's current codespace-compose compatibility issues.

set -e

cd "$(dirname "$0")/../../"

git clone https://github.com/github/dependency-snapshots-api.git

cd "dependency-snapshots-api"
script/setup-go-auth
source .devcontainer/goproxy.sh
make build

echo "Run 'cd /workspaces/dependency-snapshots-api/ && DEPENDENCY_SNAPSHOTS_DB_PORT=3306 script/server' to start ds-api!"
