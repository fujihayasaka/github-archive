--dir
.
--ignore=tmp/
--ignore=vendor/

# Suppress net-imap 0.6.2 class inheritance change (Data vs DataLite)
# See: https://srb.help/5012
--suppress-payload-superclass-redefinition-for=Net::IMAP::CommandData

# Suppress rdoc 6.15.0 class inheritance change (Struct vs RDoc::Markup::Element)
# See: https://srb.help/5012
--suppress-payload-superclass-redefinition-for=RDoc::Markup::Heading

# github/github does this, the schemas fail typechecking
--ignore=/lib/hydro/schemas/

# generated files -- would be nice to typecheck these in the future but currently fails
--ignore=/gen/

# there's some wacky things going on here
--ignore=/spec/

# these are not Ruby files
--ignore=/config/kubernetes
--ignore=/config/kustomize
