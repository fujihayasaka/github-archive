#!/bin/bash
# Pull specific repo nwo's from list to churn out dependency graphs for.
#
# Usage:
# script/export_dep_graph [line # to start on, default is line 1] [# of lines to churn though, default 1000]
#
# script/export_dep_graph 1 200
#

set -e
cd "$(dirname "$0")/.."


start=${1:-1}
len=${2:-1000}
repos_list=./script/one_off/archive_export/archive_repos_list.txt

echo "starting on line $start"
echo "processing $len repos"

for i in $(seq $len); do
  x=$((start+i-1))
  repo=$(awk "NR==$x" $repos_list)

  echo "$i: starting graph export for $repo (line $x).."
  ./script/one_off/archive_export/repo_archive_data_export.rb -s -r $repo
done

echo "all done!"

