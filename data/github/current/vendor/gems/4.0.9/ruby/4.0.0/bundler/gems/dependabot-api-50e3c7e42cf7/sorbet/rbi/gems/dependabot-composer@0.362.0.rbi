# source://dependabot-composer//lib/dependabot/composer/helpers.rb#9
module Dependabot::Composer::Helpers
  class << self
    # Capture the platform extension from composer.json
    #
    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#154
    sig { params(parsed_composer_json: T::Hash[::String, T.untyped], name: ::String).returns(T.nilable(::String)) }
    def capture_platform(parsed_composer_json, name); end

    # Capture the platform PHP version from composer.json
    #
    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#148
    sig { params(parsed_composer_json: T::Hash[::String, T.untyped]).returns(T.nilable(::String)) }
    def capture_platform_php(parsed_composer_json); end

    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#141
    sig { params(output: ::String, regex: ::Regexp).returns(T.nilable(::String)) }
    def capture_version(output, regex); end

    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#50
    sig do
      params(
        composer_json: T::Hash[::String, T.untyped],
        parsed_lockfile: T.nilable(T::Hash[::String, T.untyped])
      ).returns(::String)
    end
    def composer_version(composer_json, parsed_lockfile = T.unsafe(nil)); end

    # Capture extension version constraint from composer.json
    #
    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#166
    sig { params(parsed_composer_json: T::Hash[::String, T.untyped], name: ::String).returns(T.nilable(::String)) }
    def dependency_constraint(parsed_composer_json, name); end

    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#79
    sig { params(message: ::String).returns(T.nilable(::String)) }
    def dependency_url_from_git_clone_error(message); end

    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#85
    sig { params(message: ::String, regex: ::Regexp).returns(T.nilable(::String)) }
    def extract_and_clean_dependency_url(message, regex); end

    # Example output:
    # [dependabot] ~ $ composer --version
    # Composer version 2.7.7 2024-06-10 22:11:12
    # PHP version 7.4.33 (/usr/bin/php7.4)
    # Run the "diagnose" command to get more detailed diagnostics output.
    # Get the version of the composer and php form the command output
    # => { composer: "2.7.7", php: "7.4.33" }
    #
    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#125
    sig { returns(T::Hash[::Symbol, T.nilable(::String)]) }
    def fetch_composer_and_php_versions; end

    # Run single composer command returning stdout/stderr
    #
    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#99
    sig { params(command: ::String, fingerprint: T.nilable(::String)).returns(::String) }
    def package_manager_run_command(command, fingerprint: T.unsafe(nil)); end

    # Capture PHP version constraint from composer.json
    #
    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#160
    sig { params(parsed_composer_json: T::Hash[::String, T.untyped]).returns(T.nilable(::String)) }
    def php_constraint(parsed_composer_json); end

    private

    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#181
    sig { params(dependency_url: ::String).returns(::String) }
    def clean_dependency_url(dependency_url); end

    # source://dependabot-composer//lib/dependabot/composer/helpers.rb#171
    sig { params(composer_json: T::Hash[::String, T.untyped]).returns(T::Boolean) }
    def invalid_v2_requirement?(composer_json); end
  end
end

