#!/usr/bin/env ruby

# Generates the Ruby Twirp custom errors helper.
#
# Source of truth: Go error files under internal/twirp/twcerr/*_error.go
# Output: prints Ruby code to stdout.

repo_root = File.expand_path('..', __dir__)
twcerr_glob = File.join(repo_root, 'internal/twirp/twcerr/*_error.go')

error_files = Dir.glob(twcerr_glob).sort
basenames = error_files.map { |p| File.basename(p, '_error.go') }

puts "# frozen_string_literal: true"
puts
puts "# Auto-generated by ./script/generate-twirp-custom-errors-rb. DO NOT EDIT!"
puts
puts "require 'twirp'"
puts
puts "module OSSLicenseCompliance"
puts "  module Errors"
puts "    META_ERROR_NAME = 'error_name'"
puts "    META_CAUSE = 'error_cause'"
puts
puts "    # Custom errors from internal/twirp/twcerr/*_error.go"

# Generate constants
basenames.each do |basename|
  const_name = "ERROR_#{basename.upcase}"
  puts "    #{const_name} = '#{basename}_error'"
end

puts
puts "    class << self"
puts "      # Returns the root cause of the error if available, or an empty string otherwise."
puts "      def root_cause(err)"
puts "        meta = err.respond_to?(:meta) ? err.meta : nil"
puts "        meta.is_a?(Hash) ? (meta[META_CAUSE] || \"\") : \"\""
puts "      end"
puts
# Generate predicate methods
basenames.each do |basename|
  const_name = "ERROR_#{basename.upcase}"
  puts "      # Returns true if the error returned by the Twirp server is #{basename}_error."
  puts "      def #{basename}_error?(err)"
  puts "        custom_error?(err, #{const_name})"
  puts "      end"
  puts
end

puts "      private"
puts
puts "      def custom_error?(err, error_name)"
puts "        return false unless err.is_a?(::Twirp::Error)"
puts
puts "        meta = err.respond_to?(:meta) ? err.meta : nil"
puts "        return false unless meta.is_a?(Hash)"
puts
puts "        meta[META_ERROR_NAME] == error_name"
puts "      end"
puts "    end"
puts "  end"
puts "end"
puts
