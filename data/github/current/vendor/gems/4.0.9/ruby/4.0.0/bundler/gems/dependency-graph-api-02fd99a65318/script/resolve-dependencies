#!/usr/bin/env bash
#
# This script is run automatically, early, in CI builds.
# It saves the authentication token for Go dependency resolution in later stages.

set -euo pipefail

echo "Saving goproxy authentication token." >&2
echo "$BP_GITHUB_TOKEN" > go/.goproxytoken
echo "machine goproxy.githubapp.com login nobody password $BP_GITHUB_TOKEN" > "$HOME/.netrc"

export GOPROXY=https://goproxy.githubapp.com/mod,https://proxy.golang.org,direct
export GOPRIVATE=
export GONOPROXY=
export GONOSUMDB=github.com/github/*

echo "Vendoring Go module dependencies." >&2
cd go && go mod vendor
