# Development environment configuration with local Redis
# This file provides environment variables for using a local Redis server in development.
#
# To use this configuration:
# 1. Start Redis: script/redis-dev start
# 2. Load this file by copying to .env or sourcing it
#
# Using a real Redis server in development provides a more realistic environment
# and helps catch issues that only appear with actual Redis instead of in-memory cache.

# Redis configuration for local development
REDIS_PROVIDER="LOCAL"
# Use different port to avoid conflicts with existing Redis instances
REDIS_HOST="localhost:6381"
REDIS_DB=0
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2

# Development encryption key for token storage
ENCRYPTION_KEY=fc2dc5e64f8b23bae130addae216c3d8259d8247c3fd058113984afe5e55a195
