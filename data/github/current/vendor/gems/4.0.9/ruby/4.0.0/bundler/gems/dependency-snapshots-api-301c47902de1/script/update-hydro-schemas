#!/bin/bash

set -euo pipefail

# Clone the github/hydro-schemas repository as a sibling directory to
# github/depenency-snapshots-api, and run this script.

root=$(realpath "$(dirname "$0")/..")

if [[ ! -d "$root/../hydro-schemas" ]]; then
  echo "Cloning github/hydro-schemas to $(realpath "${root}"/..)/hydro-schemas..."
  git clone https://github.com/github/hydro-schemas.git "$root/../hydro-schemas"
else
  echo "Updating github/hydro-schemas..."
  cd "$root/../hydro-schemas" || exit 1
  git pull
fi

cd "${root}/../hydro-schemas" || exit 1

## We no longer depend on any protos from hydro-schemas in this project.

script/generate \
  --go-prefix github.com/github/dependency-snapshots-api \
  --go-out ../dependency-snapshots-api/ \
  proto/hydro/schemas/dependency_graph/v0/dependabot_snapshot_received.proto \
  proto/hydro/schemas/dependency_graph/v0/entities/ecosystem.proto \
  proto/hydro/schemas/dependency_graph/v0/update_graph_event.proto \
  proto/hydro/schemas/github/actions/v0/compute_usage.proto \
  proto/hydro/schemas/github/dependencygraph/v1/enroll_manifests.proto \
  proto/hydro/schemas/github/dependencygraph/v1/repository_push.proto \
  proto/hydro/schemas/github/dependencygraph/v1/reset_manifests.proto
