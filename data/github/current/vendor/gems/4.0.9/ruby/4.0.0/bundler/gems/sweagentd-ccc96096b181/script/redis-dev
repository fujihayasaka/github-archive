#!/bin/bash
#
# SWE Agent Redis for Development
#
# This script manages a Redis container for local development.
# It provides a consistent development environment for services that depend on Redis
# for caching, session storage, or pub/sub messaging.
#
# Usage:
#   script/redis-dev start   - Start the Redis container
#   script/redis-dev stop    - Stop and remove the Redis container
#   script/redis-dev status  - Check if Redis is running
#   script/redis-dev logs    - Show Redis logs
#   script/redis-dev reset   - Stop, remove, and restart Redis (fresh start)
#   script/redis-dev cli     - Open Redis CLI connected to the container
#
# Environment Variables:
#   REDIS_CONTAINER_NAME     - Name of the container (default: sweagentd-redis-dev)
#   REDIS_HOST_PORT          - Host port to map to (default: 6381)
#

set -e

# Configuration
CONTAINER_NAME="${REDIS_CONTAINER_NAME:-sweagentd-redis-dev}"
HOST_PORT="${REDIS_HOST_PORT:-6381}"
REDIS_IMAGE="redis:7-alpine"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if Docker is available
check_docker() {
    if ! command -v docker &> /dev/null; then
        error "Docker is not installed or not in PATH"
        exit 1
    fi

    if ! docker info &> /dev/null; then
        error "Docker is not running or accessible"
        exit 1
    fi
}

# Check if container is running
is_running() {
    docker ps --filter "name=${CONTAINER_NAME}" --format "{{.Names}}" | grep -q "^${CONTAINER_NAME}$"
}

# Check if container exists (running or stopped)
container_exists() {
    docker ps -a --filter "name=${CONTAINER_NAME}" --format "{{.Names}}" | grep -q "^${CONTAINER_NAME}$"
}

# Wait for Redis to be ready
wait_for_redis() {
    info "Waiting for Redis to be ready..."
    local max_attempts=30
    local attempt=1
    
    while [ $attempt -le $max_attempts ]; do
        # Check if Redis responds to PING
        if docker exec "${CONTAINER_NAME}" redis-cli ping 2>/dev/null | grep -q "PONG"; then
            success "Redis is ready!"
            return 0
        fi
        
        echo -n "."
        sleep 1
        ((attempt++))
    done
    
    echo ""
    error "Redis did not become ready within ${max_attempts} seconds"
    return 1
}

# Start Redis
start_redis() {
    check_docker
    
    if is_running; then
        warning "Redis is already running"
        show_connection_info
        
        # If we're being run as part of a process manager (like overmind),
        # we should keep running to monitor the container instead of exiting
        if [ "${OVERMIND_SOCKET:-}" != "" ] || [ "${PROCFILE_MODE:-}" != "" ]; then
            info "Running in process manager mode..."
        fi
        return 0
    fi
    
    if container_exists; then
        info "Starting existing Redis container..."
        docker start "${CONTAINER_NAME}"
    else
        info "Creating and starting new Redis container..."
        info "Using image: ${REDIS_IMAGE}"
        
        docker run -d \
            --name "${CONTAINER_NAME}" \
            -p "${HOST_PORT}:6379" \
            "${REDIS_IMAGE}" \
            redis-server --appendonly yes
    fi

    if wait_for_redis; then
        show_connection_info
        show_setup_instructions
        
        # If we're being run as part of a process manager, keep monitoring
        if [ "${OVERMIND_SOCKET:-}" != "" ] || [ "${PROCFILE_MODE:-}" != "" ]; then
            info "Running in process manager mode..."
        fi
    else
        error "Failed to start Redis"
        return 1
    fi
}

# Stop Redis
stop_redis() {
    check_docker
    
    if ! container_exists; then
        warning "Redis container does not exist"
        return 0
    fi
    
    info "Stopping Redis..."
    docker stop "${CONTAINER_NAME}" 2>/dev/null || true
    docker rm "${CONTAINER_NAME}" 2>/dev/null || true
    success "Redis stopped and removed"
}

# Show status
show_status() {
    check_docker
    
    if is_running; then
        success "Redis is running"
        docker ps --filter "name=${CONTAINER_NAME}" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        show_connection_info
        
        # Show some Redis info
        info "Redis server info:"
        docker exec "${CONTAINER_NAME}" redis-cli info server 2>/dev/null | grep -E "^(redis_version|uptime_in_seconds|connected_clients):" || true
    elif container_exists; then
        warning "Redis container exists but is not running"
        docker ps -a --filter "name=${CONTAINER_NAME}" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
    else
        info "Redis is not running"
    fi
}

# Show logs
show_logs() {
    check_docker
    
    if ! container_exists; then
        error "Redis container does not exist"
        return 1
    fi
    
    docker logs -f "${CONTAINER_NAME}"
}

# Open Redis CLI
open_cli() {
    check_docker
    
    if ! is_running; then
        error "Redis is not running. Start it first with: $0 start"
        return 1
    fi
    
    info "Connecting to Redis CLI..."
    docker exec -it "${CONTAINER_NAME}" redis-cli
}

# Reset (stop and restart)
reset_redis() {
    info "Resetting Redis..."
    stop_redis
    start_redis
}

# Show connection information
show_connection_info() {
    echo ""
    success "Redis Connection Details:"
    echo "  Host: localhost"
    echo "  Port: ${HOST_PORT}"
    echo "  URL: redis://localhost:${HOST_PORT}"
    echo ""
}

# Show setup instructions
show_setup_instructions() {
    echo "To use Redis in your development environment:"
    echo ""
    echo "1. Set these environment variables in your .env file:"
    echo "   REDIS_URL=redis://localhost:${HOST_PORT}"
    echo "   REDIS_HOST=localhost"
    echo "   REDIS_PORT=${HOST_PORT}"
    echo ""
    echo "2. Or export them in your shell:"
    echo "   export REDIS_URL='redis://localhost:${HOST_PORT}'"
    echo "   export REDIS_HOST='localhost'"
    echo "   export REDIS_PORT='${HOST_PORT}'"
    echo ""
    echo "3. Start your application with 'script/server' or 'overmind start'"
    echo ""
    echo "4. Use Redis CLI to interact with Redis:"
    echo "   $0 cli"
    echo ""
    info "Data persists in the container with AOF (append-only file)."
    info "Use '$0 reset' to start fresh with no data."
}

# Show help
show_help() {
    echo "SWE Agent Redis for Development"
    echo ""
    echo "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  start    Start the Redis container"
    echo "  stop     Stop and remove the Redis container"
    echo "  status   Check if Redis is running"
    echo "  logs     Show Redis logs (follows)"
    echo "  reset    Stop, remove, and restart Redis (fresh start)"
    echo "  cli      Open Redis CLI connected to the container"
    echo "  help     Show this help message"
    echo ""
    echo "Environment Variables:"
    echo "  REDIS_CONTAINER_NAME  Name of the container (default: ${CONTAINER_NAME})"
    echo "  REDIS_HOST_PORT       Host port to map to (default: ${HOST_PORT})"
    echo ""
}

# Main command handling
case "${1:-help}" in
    start)
        start_redis
        ;;
    stop)
        stop_redis
        ;;
    status)
        show_status
        ;;
    logs)
        show_logs
        ;;
    reset)
        reset_redis
        ;;
    cli)
        open_cli
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
