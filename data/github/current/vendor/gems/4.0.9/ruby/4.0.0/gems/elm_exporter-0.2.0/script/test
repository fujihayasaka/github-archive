#!/bin/bash
#
# Runs the elm_exporter gem's unit tests.
#
# Generated protobuf/twirp sources must already exist in
#   lib/mvnd/elm_exporter/api/v1/
# Run `script/generate` first if they are missing.

set -euo pipefail

CDPATH="" cd -- "$(dirname -- "$(dirname -- "$0")")"
ruby_dir="$(pwd)"

# Sanity check: generated sources must be present.
gen_dir="${ruby_dir}/lib/mvnd/elm_exporter/api/v1"
if [ -z "$(ls -A "${gen_dir}"/*_pb.rb 2>/dev/null)" ]; then
    echo "Error: generated protobuf sources not found in ${gen_dir}" >&2
    echo "Please run 'script/generate' first." >&2
    exit 1
fi

bundle install

shopt -s nullglob
testfiles=(test/*_test.rb)
if [ "${#testfiles[@]}" -eq 0 ]; then
    echo "No test files found in test/ — nothing to run yet." >&2
    exit 0
fi

for testfile in "${testfiles[@]}"; do
    bundle exec ruby "${testfile}" "$@"
done
