<h2 class="mb-4 d-flex flex-justify-between flex-items-center">
  Labels
  <%= render(Primer::ButtonComponent.new(tag: :a, href: new_label_path, scheme: :primary, variant: :small)) { "New label" } %>
</h2>

<div class="d-flex flex-row">
  <%= form_tag(labels_path, method: :get, class: "d-flex flex-1") do %>
    <% hidden_search_fields.each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>

    <%= text_field_tag "query", query, placeholder: "Search for names", autocomplete: "on", class: "form-control flex-1 mb-3" %>
  <% end %>
</div>

<%= render(Primer::Beta::BorderBox.new) do |border_box| %>
  <% border_box.with_header(display: :flex) do %>
    <div class="flex-1">Name</div>
    <div class="flex-3 pl-3">Description</div>
    <div class="flex-1 pl-3">Advisory reviews</div>
  <% end %>

  <% labels.each do |label| %>
    <% border_box.with_row(display: :flex) do %>
      <div class="flex-1">
        <%= render Labels::LabelComponent.new(name: label.name, color: label.color, link: label_path(label)) %>
      </div>
      <%= render(Primer::Truncate.new(classes: "flex-3 pl-3")) do %>
        <%= label.description %>
      <% end %>
      <div class="flex-1 pl-3">
        <%= label.advisory_reviews.count %>
      </div>
    <% end %>
  <% end %>

  <% if labels.empty? %>
    <% border_box.with_footer(display: :flex, justify_content: :center) { "No labels to show" } %>
  <% end %>
<% end %>

<%= pagination(labels) %>
