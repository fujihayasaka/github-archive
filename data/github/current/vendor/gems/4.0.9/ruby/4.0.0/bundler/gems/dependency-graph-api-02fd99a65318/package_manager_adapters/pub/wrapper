#!/bin/bash

usage() {
  echo "Usage: $0 {run|import|restart <FROM_PAGE>|package <NAME> [VERSION1;VERSION2;...]|test|console}"
}

case "$1" in
  run)
    echo "Running adapter..."
    bundle exec rake run
    ;;
  import)
    echo "Running adapter (in full import mode)..."
    bundle exec rake full_import
    ;;
  restart)
    # Example:
    # ./wrapper restart 54
    shift
    FROM_PAGE="$1"
    echo "Restarting full import at page ${FROM_PAGE}..."
    bundle exec rake restart_publish["$FROM_PAGE"]
    ;;
  package)
    # Examples:
    # ./wrapper package http
    # ./wrapper package http 0.3.2
    # ./wrapper package http "0.3.2;0.3.1"
    shift
    PACKAGE_NAME="$1"
    shift
    VERSIONS_LIST="$1"
    bundle exec rake "single_import[$PACKAGE_NAME , $VERSIONS_LIST]"
    ;;
  test)
    echo "Running adapter tests..."
    bundle exec rake test
    ;;
  console)
    /bin/bash
    ;;
  *)
    usage
    exit 1
esac
