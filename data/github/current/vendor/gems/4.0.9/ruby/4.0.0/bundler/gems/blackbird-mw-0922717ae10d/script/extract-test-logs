#!/bin/bash

# Tries to find some useful error messages from the integration test
# and surfaces them (if possible) via annotations

echo "## Failing tests:"
failing_tests=$(cat $1 | sed -nr "s/^.*\-\-\- FAIL: (\S+) .*$/\1/p")
echo $failing_tests

while IFS= read -r line; do
   echo " - $line"
done <<< $failing_tests

echo "## Possibly related logs:"

while IFS= read -r line; do
   echo "\`\`\`"
   cat $1 | egrep --color -A 50 -i "=== RUN.*$line$"
   echo "\`\`\`"
done <<< $failing_tests

echo
echo
echo "## Stack traces:"

echo "\`\`\`"
cat $1 | egrep --color -B 5 -A 10 -i 'blackbird-mw/.*.go:[0-9]+'
echo "\`\`\`"
