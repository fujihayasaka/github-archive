  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Dependabot",
          "semanticVersion": "2.17.6",
          "rules": [
            {
              "id": "js/breaking-change",
              "name": "BreakingChange",
              "shortDescription": {
                "text": "Breaking change detected when updating styled-components from version 5.3.5 to 6.1.13"
              },
              "fullDescription": {
                "text": "A breaking change detected when updating styled-components from version 5.3.5 to 6.1.13"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/breaking-change",
          "rule": {
            "id": "js/breaking-change",
            "index": 0
          },
          "level": "error",
          "message": {
            "text": "This JSX tag's 'children' prop expects type 'never' which requires multiple children, but only a single child was provided.---Type 'string' is not assignable to type 'never'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 82,
                  "startColumn": 1,
                  "endLine": 82,
                  "endColumn": 32
                }
              }
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "message": {
                          "text": "import styled from 'styled-components'"
                        },
                        "physicalLocation": {
