# pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:18
class Dependabot::Sbt::Package::PackageDetailsFetcher < ::Dependabot::Maven::Shared::SharedPackageDetailsFetcher
  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:28
  sig do
    params(
      dependency: ::Dependabot::Dependency,
      dependency_files: T::Array[::Dependabot::DependencyFile],
      credentials: T::Array[::Dependabot::Credential]
    ).void
  end
  def initialize(dependency:, dependency_files:, credentials:); end

  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:89
  sig { override.returns(::String) }
  def central_repo_url; end

  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:45
  sig { override.returns(T::Array[::Dependabot::Credential]) }
  def credentials; end

  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:39
  sig { override.returns(::Dependabot::Dependency) }
  def dependency; end

  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:42
  sig { returns(T::Array[::Dependabot::DependencyFile]) }
  def dependency_files; end

  # Override to always use "jar" for the HEAD check. The SBT parser sets
  # packaging_type to "cross-versioned" as metadata for %% dependencies, but the
  # actual Maven artifact is always a .jar file.
  #
  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:97
  sig { override.params(repository_url: ::String, version: ::Dependabot::Version).returns(::String) }
  def dependency_files_url(repository_url, version); end

  # Override to handle SBT plugin cross-versioning.
  # SBT plugins are published with a double-suffix: artifact_scalaVersion_sbtVersion
  # e.g., sbt-jmh_2.12_1.0 for SBT 1.x plugins.
  #
  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:108
  sig { override.returns([::String, ::String]) }
  def dependency_parts; end

  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:48
  sig { returns(::Dependabot::Package::PackageDetails) }
  def fetch; end

  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:68
  sig { returns(T::Array[::Dependabot::Package::PackageRelease]) }
  def releases; end

  # Assembles the list of Maven repositories to search: credential repos + SBT resolver repos.
  #
  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:74
  sig { override.returns(T::Array[T::Hash[::String, T.untyped]]) }
  def repositories; end

  private

  # SBT 1.x plugins use Scala 2.12; SBT 2.x plugins use Scala 3.
  #
  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:148
  sig { returns(::String) }
  def plugin_scala_version; end

  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:123
  sig { returns(::Dependabot::Sbt::FileParser::RepositoriesFinder) }
  def repository_finder; end

  # SBT binary version for plugin cross-versioning: "1.0" for SBT 1.x, "2.0" for SBT 2.x.
  #
  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:154
  sig { returns(::String) }
  def sbt_binary_version; end

  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:159
  sig { returns(::Integer) }
  def sbt_major_version; end

  # SBT plugins are identified by having "plugins" in their groups.
  #
  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:142
  sig { returns(T::Boolean) }
  def sbt_plugin?; end

  # Returns the repository details discovered from SBT build files.
  #
  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/package/package_details_fetcher.rb:132
  sig { returns(T::Array[T::Hash[::String, T.untyped]]) }
  def sbt_repository_details; end
end

