# SBT typically uses exact versions ("org" % "artifact" % "1.2.3"),
# but Maven-style version ranges are valid since artifacts resolve
# from Maven repositories.
#
# pkg:gem/dependabot-sbt#lib/dependabot/sbt/requirement.rb:16
class Dependabot::Sbt::Requirement < ::Dependabot::Maven::Shared::SharedRequirement
  # pkg:gem/dependabot-sbt#lib/dependabot/sbt/requirement.rb:56
  sig { override.params(version: ::Gem::Version).returns(T::Boolean) }
  def satisfied_by?(version); end

  class << self
    # pkg:gem/dependabot-sbt#lib/dependabot/sbt/requirement.rb:35
    sig { override.params(obj: T.any(::Gem::Version, ::String)).returns([::String, ::Gem::Version]) }
    def parse(obj); end

    # pkg:gem/dependabot-sbt#lib/dependabot/sbt/requirement.rb:25
    sig { override.returns(::Regexp) }
    def pattern; end

    # pkg:gem/dependabot-sbt#lib/dependabot/sbt/requirement.rb:49
    sig { override.params(requirement_string: T.nilable(::String)).returns(T::Array[::Dependabot::Sbt::Requirement]) }
    def requirements_array(requirement_string); end

    # pkg:gem/dependabot-sbt#lib/dependabot/sbt/requirement.rb:30
    sig { override.returns(::Regexp) }
    def ruby_style_pattern; end
  end
end

