<% content_for :breadcrumbs do %>
  <%= render "breadcrumbs", cve_review: cve_review %>
<% end %>

<% content_for :navigation do %>
  <%= render "navigation", cve_review: cve_review %>
<% end %>

<%= render Primer::Alpha::Layout.new(first_in_source: :main) do |component| %>
  <% component.with_main do %>
    <%= render CVEReviews::TimelineComponent.new(cve_review) %>
  <% end %>
  <% component.with_sidebar(col_placement: :end) %>
<% end %>
