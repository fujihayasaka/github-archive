<!DOCTYPE html>
<html>
  <head data-is-staging="<%= ApplicationComponent.staging? ? true : false %>">
    <title><%= content_for?(:title) ? yield(:title) : "Advisory Inbox" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- This application would not work with @primer/css >= v19.2.0 if it directly
      imported the @primer/css/index.scss file. The implementation of sass currently
      used in this application -- libsass or sassc -- does not support some of the
      functions used in the primer scss code. As such, we import the already-compiled
      css to get around not being able to use the dart sass implementation.
      If this application is ever updated to use dart sass, you can change it back
      to simply @import '@primer/css' in application.scss. -->
    <link href="https://unpkg.com/@primer/css@<%= ApplicationComponent.primer_css_version %>/dist/primer.css" rel="stylesheet" />
    <link href="https://unpkg.com/@primer/primitives@<%= ApplicationComponent.primer_primitives_version %>/dist/css/primitives.css" rel="stylesheet" />
    <link href="https://unpkg.com/@primer/primitives@<%= ApplicationComponent.primer_primitives_version %>/dist/css/functional/themes/light.css" rel="stylesheet" />
    <link href="https://unpkg.com/@primer/primitives@<%= ApplicationComponent.primer_primitives_version %>/dist/css/functional/themes/dark-dimmed.css" rel="stylesheet" />
    <link href="https://unpkg.com/@primer/view-components@<%= ApplicationComponent.primer_components_version %>/app/assets/styles/primer_view_components.css" rel="stylesheet" />

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag "application", "data-turbolinks-track": "reload", defer: true %>
    <%= favicon_link_tag asset_path(ApplicationComponent.staging? ? 'icons/staging.svg' : 'icons/favicon.svg') %>
  </head>

  <body data-color-mode="<%= current_user.color_mode.presence || "auto" %>" data-light-theme="light" data-dark-theme="dark_dimmed" >
    <%= render "header" %>

    <div class="container-xl px-3 px-md-4 px-lg-5 pt-5 pb-6">
      <%= render "flash" %>

      <%= yield %>
    </div>
  </body>
</html>
