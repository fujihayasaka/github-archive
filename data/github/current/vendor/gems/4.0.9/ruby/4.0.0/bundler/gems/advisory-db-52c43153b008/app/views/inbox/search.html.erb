<% content_for :breadcrumbs do %>
  <%= render Primer::Beta::Breadcrumbs.new  do |breadcrumb| %>
    <% breadcrumb.with_item(href: search_path) { "Search" } %>
    <% breadcrumb.with_item(href: search_path(search_query: search_query)) { search_query } if search_query.present? %>
  <% end %>
<% end %>

<% content_for :navigation do %>
  <%= render(Primer::Alpha::UnderlineNav.new(label: "Search type")) do |underline_nav| %>
    <% underline_nav.with_tab(href: search_path(search_type: "advisory_review", search_query: search_query), selected: search_type == "advisory_review") do |t| %>
      <% t.with_text { "Advisory reviews" } %>
      <% t.with_counter(count: counts[:advisory_reviews], test_selector: "advisory-review-count") %>
    <% end %>
    <% underline_nav.with_tab(href: search_path(search_type: "cve_review", search_query: search_query), selected: search_type == "cve_review") do |t| %>
      <% t.with_text { "CVE reviews" } %>
      <% t.with_counter(count: counts[:cve_reviews], test_selector: "cve-review-count") %>
    <% end %>
  <% end %>
<% end %>

<% if search_type == "advisory_review" %>
  <%= render(AdvisoryReviews::TableComponent.new(advisory_reviews: results)) %>
<% elsif search_type == "cve_review" %>
  <%= render(CVEReviews::TableComponent.new(cve_reviews: results)) %>
<% else %>
  <%= render Primer::Beta::Flash.new(scheme: :danger, icon: "hubot", spacious: true) do %>
    I'm not sure how to search for <%= search_type.pluralize %>!
  <% end %>
<% end %>

<% if results.present? %>
  <%= will_paginate results,
    inner_window: 2,
    outer_window: 0,
    previous_label: "Previous",
    next_label: "Next",
    class: "pagination text-center mt-3"
  %>
<% end %>
