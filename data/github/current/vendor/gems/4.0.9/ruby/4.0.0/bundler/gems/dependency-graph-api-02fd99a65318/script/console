#!/bin/bash
#
# script/console: Launch the rails console
#

set -e

cd "$(dirname "$0")/.."
if [[ $1 == "writing" ]]; then
    echo "WARNING: You're connected to the WRITING database. BE CAREFUL."
elif [[ $1 == "analytics" ]]; then
    echo "NOTE: Connected to the ANALYTICS database. Data may be up to 24hr out of date."
    export DEPENDENCYGRAPH_DB="$DEPENDENCYGRAPH_ANALYTICS_DB"
    export DEPENDENCYGRAPH_DB_USERNAME="$DEPENDENCYGRAPH_ANALYTICS_DB_USERNAME"
    export DEPENDENCYGRAPH_DB_PASSWORD="$DEPENDENCYGRAPH_ANALYTICS_DB_PASSWORD"
    export DEPENDENCYGRAPH_DB_HOST="$DEPENDENCYGRAPH_ANALYTICS_DB_HOST"
    export DEPENDENCYGRAPH_READING_DB="$DEPENDENCYGRAPH_ANALYTICS_DB"
    export DEPENDENCYGRAPH_READING_DB_USERNAME="$DEPENDENCYGRAPH_ANALYTICS_DB_USERNAME"
    export DEPENDENCYGRAPH_READING_DB_PASSWORD="$DEPENDENCYGRAPH_ANALYTICS_DB_PASSWORD"
    export DEPENDENCYGRAPH_READING_DB_HOST="$DEPENDENCYGRAPH_ANALYTICS_DB_HOST"
else
    if [[ $RAILS_ENV == "production" ]]; then
        echo "Connected to the READING database."
    fi
    export DEPENDENCYGRAPH_DB="$DEPENDENCYGRAPH_READING_DB"
    export DEPENDENCYGRAPH_DB_USERNAME="$DEPENDENCYGRAPH_READING_DB_USERNAME"
    export DEPENDENCYGRAPH_DB_PASSWORD="$DEPENDENCYGRAPH_READING_DB_PASSWORD"
    export DEPENDENCYGRAPH_DB_HOST="$DEPENDENCYGRAPH_READING_DB_HOST"
fi

bin/rails console
