# pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirement.rb:13
class Dependabot::Opentofu::Requirement < ::Dependabot::Requirement
  # Patches Gem::Requirement to make it accept requirement strings like
  # "~> 4.2.5, >= 4.2.5.1" without first needing to split them.
  #
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirement.rb:47
  sig { params(requirements: T.any(::String, T::Array[::String])).void }
  def initialize(*requirements); end

  class << self
    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirement.rb:23
    sig do
      params(
        obj: T.any(::Gem::Version, ::String)
      ).returns(T::Array[T.any(::Dependabot::Opentofu::Version, ::String)])
    end
    def parse(obj); end

    # For consistency with other languages, we define a requirements array.
    # OpenTofu doesn't have an `OR` separator for requirements, so it
    # always contains a single element.
    #
    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirement.rb:40
    sig do
      override
        .params(
          requirement_string: T.nilable(::String)
        ).returns(T::Array[::Dependabot::Opentofu::Requirement])
    end
    def requirements_array(requirement_string); end
  end
end

