# Opentofu::RegistryClient is a basic API client to interact with a
# OpenTofu registry: https://api.opentofu.org/
#
# pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:17
class Dependabot::Opentofu::RegistryClient
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:37
  sig { params(hostname: ::String, credentials: T::Array[::Dependabot::Credential]).void }
  def initialize(hostname: T.unsafe(nil), credentials: T.unsafe(nil)); end

  # Fetch all the versions of a module, and return a Version
  # representation of them.
  #
  # "hashicorp/consul/aws"
  #
  # @raise [Dependabot::DependabotError] when the versions cannot be retrieved
  #
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:160
  sig { params(identifier: ::String).returns(T::Array[::Dependabot::Opentofu::Version]) }
  def all_module_versions(identifier:); end

  # Fetch all the versions of a provider, and return a Version
  # representation of them.
  #
  # "hashicorp/aws"
  #
  # @raise [Dependabot::DependabotError] when the versions cannot be retrieved
  #
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:141
  sig { params(identifier: ::String).returns(T::Array[::Dependabot::Opentofu::Version]) }
  def all_provider_versions(identifier:); end

  # Perform service discovery and return the absolute URL for
  # the requested service.
  #
  # @raise [Dependabot::PrivateSourceAuthenticationFailure] when the service is not available
  #
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:211
  sig { params(service_key: ::String).returns(::String) }
  def service_url_for_registry(service_key); end

  # Fetch the "source" for a module or provider. We use the API to fetch
  # the source for a dependency, this typically points to a source code
  # repository, and then instantiate a Dependabot::Source object that we
  # can use to fetch Metadata about a specific version of the dependency.
  #
  # we're attempting to find
  #
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:178
  sig { params(dependency: ::Dependabot::Dependency).returns(T.nilable(::Dependabot::Source)) }
  def source(dependency:); end

  private

  # @return [String]
  #
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:341
  def api_base_url; end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:448
  sig { params(message: ::String).returns(::Dependabot::DependabotError) }
  def error(message); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:352
  sig { params(hostname: ::String).returns(T::Hash[::String, ::String]) }
  def headers_for(hostname); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:341
  sig { returns(::String) }
  def hostname; end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:406
  sig { params(url: T.any(::String, ::URI::Generic)).returns(::Excon::Response) }
  def http_get(url); end

  # @raise [Dependabot::PrivateSourceAuthenticationFailure]
  #
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:416
  sig { params(url: ::URI::Generic).returns(::Excon::Response) }
  def http_get!(url); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:394
  sig { params(type: ::String).returns(::String) }
  def service_key_for(type); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:358
  sig { returns(T::Hash[::String, ::String]) }
  def services; end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:344
  sig { returns(T::Hash[::String, ::String]) }
  def tokens; end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:437
  sig { params(path: ::String).returns(::String) }
  def url_for_api(path); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:426
  sig { params(path: ::String).returns(::String) }
  def url_for_registry(path); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:347
  sig { returns(T.class_of(Dependabot::Opentofu::Version)) }
  def version_class; end

  class << self
    # Fetch all tags for an OCI module artifact via the Distribution v2
    # `GET /v2/<repo>/tags/list` endpoint. Returns Version objects whose
    # to_s preserves the original tag string (so `v1.0.0` round-trips).
    #
    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:100
    sig do
      params(
        artifact_identifier: ::String,
        credentials: T::Array[::Dependabot::Credential]
      ).returns(T::Array[::Dependabot::Opentofu::Version])
    end
    def all_oci_tags(artifact_identifier:, credentials: T.unsafe(nil)); end

    # See https://opentofu.org/docs/language/modules/sources/#http-urls for
    # details of how OpenTofu handle HTTP(S) sources for modules
    #
    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:59
    sig { params(raw_source: ::String).returns(::String) }
    def get_proxied_source(raw_source); end

    private

    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:262
    sig { params(www_authenticate: T.nilable(::String)).returns(T.nilable(::String)) }
    def oci_anonymous_bearer_token(www_authenticate); end

    # Basic for username/password pairs (OCI Distribution v2), Bearer for
    # token-only creds (existing OpenTofu HTTP registry behaviour).
    #
    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:313
    sig { params(cred: ::Dependabot::Credential).returns(::String) }
    def oci_auth_header(cred); end

    # Parses a `WWW-Authenticate: Bearer realm="...",service="...",scope="..."`
    # challenge and returns the token endpoint URL, or nil if not a Bearer challenge.
    #
    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:285
    sig { params(www_authenticate: T.nilable(::String)).returns(T.nilable(::String)) }
    def oci_bearer_token_url(www_authenticate); end

    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:235
    sig do
      params(
        url: ::String,
        host: ::String,
        credentials: T::Array[::Dependabot::Credential]
      ).returns(::Excon::Response)
    end
    def oci_get(url, host:, credentials:); end

    # Parses RFC 5988 `Link: <…>; rel="next"` from /tags/list responses.
    #
    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:324
    sig { params(link_header: T.nilable(::String), base: ::String).returns(T.nilable(::String)) }
    def oci_next_page_url(link_header, base:); end

    # localhost registries are commonly served over plain HTTP in dev.
    #
    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:222
    sig { params(host: ::String).returns(::String) }
    def oci_scheme_for(host); end

    # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/registry_client.rb:301
    sig { returns(T::Hash[::String, T::Hash[::Symbol, T.untyped]]) }
    def oci_token_cache; end
  end
end

