# Takes an array of `requirements` hashes for a dependency at the old
# version and a new version, and generates a set of new `requirements`
# hashes at the new version.
#
# A requirements hash is a basic description of a dependency at a certain
# version constraint, and it includes the data that is needed to update the
# manifest (i.e. the `.tf` file) with the new version.
#
# A requirements hash looks like this for a registry hosted requirement:
# ```ruby
# {
#   requirement: "~> 0.2.1",
#   groups: [],
#   file: "main.tf",
#   source: {
#     type: "registry",
#     registry_hostname: "registry.opentofu.org",
#     module_identifier: "hashicorp/consul/aws"
#   }
# }
#
# And like this for a git requirement:
# ```ruby
# {
#   requirement: nil,
#   groups: [],
#   file: "main.tf",
#   source: {
#     type: "git",
#     url: "https://github.com/cloudposse/terraform-null-label.git",
#     branch: nil,
#     ref: nil
#   }
# }
#
# pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:50
class Dependabot::Opentofu::RequirementsUpdater
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:63
  sig do
    params(
      requirements: T::Array[T::Hash[::Symbol, T.untyped]],
      latest_version: T.nilable(T.any(::Gem::Version, ::Integer, ::String)),
      tag_for_latest_version: T.nilable(::String)
    ).void
  end
  def initialize(requirements:, latest_version:, tag_for_latest_version:); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:79
  sig { returns(T::Array[T::Hash[::Symbol, T.untyped]]) }
  def updated_requirements; end

  private

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:175
  sig do
    params(
      new_version: ::Dependabot::Opentofu::Version,
      old_version: ::Dependabot::Opentofu::Version
    ).returns(::String)
  end
  def at_same_precision(new_version, old_version); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:99
  sig { returns(::Dependabot::Opentofu::Version) }
  def latest_version; end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:233
  sig { returns(T.class_of(Dependabot::Opentofu::Requirement)) }
  def requirement_class; end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:96
  sig { returns(T::Array[T::Hash[::Symbol, T.untyped]]) }
  def requirements; end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:102
  sig { returns(T.nilable(::String)) }
  def tag_for_latest_version; end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:105
  sig { params(req: T::Hash[::Symbol, T.untyped]).returns(T::Hash[::Symbol, T.untyped]) }
  def update_git_requirement(req); end

  # Updates the version in a "<" or "<=" constraint to allow the given
  # version
  #
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:200
  sig do
    params(
      requirement: ::Dependabot::Requirement,
      version_to_be_permitted: T.any(::Dependabot::Opentofu::Version, ::String)
    ).returns(::Dependabot::Opentofu::Requirement)
  end
  def update_greatest_version(requirement, version_to_be_permitted); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:113
  sig { params(req: T::Hash[::Symbol, T.untyped]).returns(T::Hash[::Symbol, T.untyped]) }
  def update_oci_requirement(req); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:155
  sig { params(req_string: ::String).returns(T::Array[::Dependabot::Opentofu::Requirement]) }
  def update_range(req_string); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:127
  sig { params(req: T::Hash[::Symbol, T.untyped]).returns(T::Hash[::Symbol, T.untyped]) }
  def update_registry_requirement(req); end

  # Updates the version in a "~>" constraint to allow the given version
  #
  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:147
  sig { params(req_string: ::String).returns(::String) }
  def update_twiddle_version(req_string); end

  # pkg:gem/dependabot-opentofu#lib/dependabot/opentofu/requirements_updater.rb:228
  sig { returns(T.class_of(Dependabot::Opentofu::Version)) }
  def version_class; end
end

