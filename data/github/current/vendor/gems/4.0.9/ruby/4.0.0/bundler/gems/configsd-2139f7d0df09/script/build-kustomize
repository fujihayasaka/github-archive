#!/usr/bin/env bash
#/ Usage: script/build-kustomize [--env <ENVIRONMENT>] [--help]
#/ Installs dependencies required to build and run authnd.
#/
#/  --env <ENVIRONMENT>
#/      (optional) Only build kustomize configuration for a specified environment. Uses 'default' when not provided.
#/  --help
#/      Shows this help
#/

root="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null 2>&1 && pwd )"
cd "$root"

set -e

environment=""
while [[ "$#" -gt 0 ]]; do
  key="$1"
  shift

  case "$key" in
    --env)
      environment="$1"
      shift
      ;;
    --help)
      grep ^#/ "$0" | cut -c4-
      exit 1 ;;
  esac
done

if [ -z "$environment" ]; then
  gh kustomize build
else
  echo "Running Kustomize for the '$environment' environment"
  gh kustomize build -e "$environment"
fi
