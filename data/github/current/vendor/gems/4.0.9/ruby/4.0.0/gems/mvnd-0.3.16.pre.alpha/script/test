#!/bin/bash

set -e

CDPATH="" cd -- "$(dirname -- "$(dirname -- "$0")")"
ruby_dir="$(pwd)"
repo_root="$(cd "$ruby_dir/../.." && pwd)"

# Check if protobuf gems exist
twirp_gems_dir="$repo_root/tmp/twirp-gems/files"
if [ ! -d "$twirp_gems_dir" ] || [ -z "$(ls -A "$twirp_gems_dir" 2>/dev/null)" ]; then
  echo "Error: Protobuf gems not found in $twirp_gems_dir"
  echo "Please run 'make generate-protobuf-gems' first"
  exit 1
fi

cd "$ruby_dir"
bundle install

for testfile in test/*_test.rb; do
  bundle exec ruby "$testfile" "$@"
done
