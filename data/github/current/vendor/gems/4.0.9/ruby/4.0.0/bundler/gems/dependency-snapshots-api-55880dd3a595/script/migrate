#!/bin/bash
# Usage: script/migrate [environment]
# Applies migrations and updates Skeema with the updated with the latest schema
# afterwards.
set -e

cd "$(dirname "$0")/.."

if ! which skeema > /dev/null; then
    echo "Running 'make tools' to install skeema..."
    make tools
fi

echo "Applying migrations..."
make migration-tool
bin/ds-migrate all

# capture first argument as environment, default to empty
ENV=${1:-}

echo "Updating skeema..."
skeema pull ${ENV}
