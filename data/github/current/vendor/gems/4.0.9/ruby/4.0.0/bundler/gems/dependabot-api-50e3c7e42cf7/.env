# This environment file is only loaded in Development and Test environments, it contains:
# - Placeholder values for required keys so script/setup can run
# - Any values that developers should not need to override as part of normal workflows

# Dependabot GitHub App configuration for our development
# GitHub App: https://github.com/apps/dependabot-dev
GITHUB_INTEGRATION_NAME="dependabot-dev"
GITHUB_INTEGRATION_WEBHOOK_SECRET=""
GITHUB_INTEGRATION_PRIVATE_KEY=""
# Used to generate integration tokens and filter integration installation hydro messages
GITHUB_INTEGRATION_ID="0"
# Used to identify the Dependabot GitHub app to the Credz service
# when retrieving secrets
GITHUB_INTEGRATION_NODE_ID=""
GITHUB_INTEGRATION_NEXT_GLOBAL_ID=""
# Used to generate global access tokens
GITHUB_ORG_ID="9919"

# GitHub access
TARGET_GITHUB_URL="https://github.com/"

# A GitHub Access Token we use to access the Internal GraphQL API,
# the corresponding value is set as DELTAFORCE_SERVICE_TOKEN in dotcom
DEPENDABOT_SERVICE_TOKEN="..."

# For accessing a local github/github service over twirp
GITHUB_INTERNAL_TWIRP_HMAC_KEY="dependabotapihmac"

# The endpoint dependabot-api is publically exposed on to other services
# on this host.
#
# In production this is "https://dependabot-api.githubapp.com"
DEPENDABOT_API_ENDPOINT="http://localhost:3001"

# For receiving requests from other services
DEPENDABOT_API_HMAC_KEYS="dotcomhmac dotcomhmacRotated"

# This is used as the actor_id in calls to the dotcom Audit Log
GITHUB_DEPENDABOT_USER_ID="49699333"

# For storing encrypted arguments in Redis
REDIS_ENCRYPTION_KEY="JgDuKrOdOBvO6EmySIPba0HWsbsK7WWm5kA8g+u22UQ="

# For storing encrypted files on S3
TEMPORARY_FILE_ENCRYPTION_KEY="wJO76S7FaKwRMpzilaGZaIKJB9AtIXmBDLGqB6cRK2c="

# The Kubernetes region the system is deployed in, mocked out for development
KUBE_REGION="iad"

AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
DEPENDENCY_FILES_S3_BUCKET="..."
STAGE_AWS_ACCESS_KEY_ID="staging_aws_access_key_id_123"
STAGE_AWS_SECRET_ACCESS_KEY="..."
UPDATE_JOB_LOG_BUCKET="prod_update_job_log_bucket_123"
STAGE_UPDATE_JOB_LOG_BUCKET="stage_update_job_log_bucket_123"

TURBOSCAN_INTERNAL_URL="http://localhost:8888"
TURBOSCAN_INTERNAL_HMAC_KEY="turboscanhmac"

DSAPI_INTERNAL_URL="http://localhost:9597"
DSAPI_HMAC_KEY="dsapihmac"

# Azure Blob Storage configuration
AZURE_STORAGE_ACCOUNT="..."
AZURE_STORAGE_ACCESS_KEY="..."
AZURE_STORAGE_CONTAINER="..."

