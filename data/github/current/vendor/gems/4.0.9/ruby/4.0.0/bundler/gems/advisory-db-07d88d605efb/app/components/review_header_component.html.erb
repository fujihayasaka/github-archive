<header class="pagehead border-bottom pb-3 mb-4">
  <h1 class="mb-2 lh-condensed text-normal" <%= test_selector("review-title") %>><%= title %></h1>

  <div class="d-flex flex-items-center">
    <div class="flex-shrink-0 mr-2">
      <%= render(Primer::Beta::State.new(title: curation_state_label(curation_state), scheme: curation_state_scheme(curation_state), test_selector: "review-state")) do %>
        <%= render(IconComponent.new(icon: curation_state_icon(curation_state), mr: 1)) %>
        <%= curation_state_label(curation_state) %>
      <% end %>
    </div>

    <% if read_only? %>
      <div class="flex-shrink-0 mr-2">
        <%= render(Primer::Beta::State.new(title: read_only_title, classes: "color-bg-default color-fg-muted color-border-muted", test_selector: "read-only-badge")) do %>
          <%= render(IconComponent.new(icon: "lock", mr: 1)) %>
          Read-only
        <% end %>
      </div>
    <% end %>

    <div class="flex-auto color-fg-muted">
      Created <%= render(Primer::Beta::RelativeTime.new(datetime: created_at, tense: :past)) %>
      ·
      Updated <%= render(Primer::Beta::RelativeTime.new(datetime: updated_at, tense: :past)) %>
      <% if review.try(:advisory_review) %>
        ·
        <%= render(Primer::Beta::Link.new(href: advisory_review_path(review.advisory_review), target: :_blank, scheme: :secondary)) do %>
          <%= render ReviewStateIconComponent.new(review: review.advisory_review, vertical_align: :middle) %> Corresponding advisory review
        <% end %>
      <% end %>
      <% if review.try(:cve_review) %>
        ·
        <%= render(Primer::Beta::Link.new(href: cve_review_path(review.cve_review), target: :_blank, scheme: :secondary)) do %>
          <%= render ReviewStateIconComponent.new(review: review.cve_review, vertical_align: :middle) %> Corresponding CVE review
        <% end %>
      <% end %>
    </div>
  </div>
</header>
