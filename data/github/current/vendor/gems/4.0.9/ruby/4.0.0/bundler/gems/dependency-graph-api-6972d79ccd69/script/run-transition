#!/bin/bash
# copied from https://github.com/github/github/blob/ed00a5ee8b47340bd691a83ea3a3444bad4399ae/script/run-automated-transition

# Usage: run-transition <transition-file-name> <arguments>
USAGE="Usage: run-transition <transition-file-name> <arguments>"

set -e

if [[ $# -eq 0 ]]; then
  # No arguments given, nothing to do. This usually happens when
  # the transition-job-template is deployed.
  exit 0
fi

if [ "$1" == "--help" ] || [ "$1" == "-h" ]; then
  echo "${USAGE}" 1>&2
  exit 1
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../" && pwd)"

"$ROOT_DIR/script/transitions/$@"
