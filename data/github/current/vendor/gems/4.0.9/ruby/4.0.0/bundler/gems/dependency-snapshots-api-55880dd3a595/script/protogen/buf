#!/usr/bin/env bash

# Builds the simple docker image that is adjacent, runs it to generate ruby proto client.

set -euo pipefail

pushd "$(dirname "$0")"

docker build -t snapshotproto .
root=$(realpath ../..)

CMD="${CMD:-generate}"
echo "Running buf in a container with command: $CMD"

docker run --rm \
    --user "$(id -u):$(id -g)" \
    -v "${root}/proto":/proto \
    -v "${root}/gen":/gen \
    -v "${root}/pkg":/pkg \
    snapshotproto $CMD

# We don't need the jobs protos for ruby client
rm -r "${root}/gen/ruby/lib/jobs"

popd
