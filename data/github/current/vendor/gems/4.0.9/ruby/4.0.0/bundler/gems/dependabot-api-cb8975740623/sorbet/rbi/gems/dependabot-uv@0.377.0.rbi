# pkg:gem/dependabot-uv#lib/dependabot/uv/name_normaliser.rb:10
Dependabot::Uv::NameNormaliser = Dependabot::Python::NameNormaliser

# Uv and Python ecosystems share the same native Python helpers.
# Both point to the same helpers/python directory.
#
# pkg:gem/dependabot-uv#lib/dependabot/uv/native_helpers.rb:10
Dependabot::Uv::NativeHelpers = Dependabot::Python::NativeHelpers

