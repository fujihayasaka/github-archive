# UV uses the same pip version resolution logic as Python.
# Both ecosystems share LanguageVersionManager, LatestVersionFinder,
# and PythonRequirementParser via aliases, so we reuse Python's implementation.
#
# pkg:gem/dependabot-uv#lib/dependabot/uv/update_checker/pip_version_resolver.rb:13
Dependabot::Uv::UpdateChecker::PipVersionResolver = Dependabot::Python::UpdateChecker::PipVersionResolver

# UV uses the same requirements update logic as Python.
# Both ecosystems share Version and Requirement classes (via aliases),
# so we reuse Python's RequirementsUpdater implementation.
#
# pkg:gem/dependabot-uv#lib/dependabot/uv/update_checker/requirements_updater.rb:13
Dependabot::Uv::UpdateChecker::RequirementsUpdater = Dependabot::Python::UpdateChecker::RequirementsUpdater

# UV uses Python's version scheme, so we delegate to Python::Version
#
# pkg:gem/dependabot-uv#lib/dependabot/uv/version.rb:11
Dependabot::Uv::Version = Dependabot::Python::Version
