  def credentials; end

  # pkg:gem/dependabot-uv#lib/dependabot/uv/update_checker/pip_compile_version_resolver.rb:53
  sig { returns(::Dependabot::Dependency) }
  def dependency; end

  # pkg:gem/dependabot-uv#lib/dependabot/uv/update_checker/pip_compile_version_resolver.rb:56
  sig { returns(T::Array[::Dependabot::DependencyFile]) }
