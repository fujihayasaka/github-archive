# This class does version resolution for pip-compile. Its approach is:
# - Unlock the dependency we're checking in the requirements.in file
# - Run `pip-compile` and see what the result is
#
# pkg:gem/dependabot-uv#lib/dependabot/uv/update_checker/pip_compile_version_resolver.rb:28
class Dependabot::Uv::UpdateChecker::PipCompileVersionResolver
  # pkg:gem/dependabot-uv#lib/dependabot/uv/update_checker/pip_compile_version_resolver.rb:75
  sig do
    params(
      dependency: ::Dependabot::Dependency,
