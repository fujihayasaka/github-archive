<%= render Primer::Beta::Breadcrumbs.new  do |breadcrumb| %>
  <% breadcrumb.with_item(href: labels_path) { "Labels" } %>

  <% breadcrumb.with_item(href: "#{labels_path}/#{label.id || "new"}") do %>
    <% if label.id %>
      <%= label.name %>
    <% else %>
      New label
    <% end %>
  <% end %>
<% end %>
