#!/bin/bash

set -eu

# docker-compose uses this to decide which config file(s) to use
# If another script sets COMPOSE_FILE already we will use that one
export COMPOSE_FILE=${COMPOSE_FILE:-docker-compose.yml:docker-compose.cibuild.yml}

function cleanup() {
  echo
  echo "%%%FOLD {Shutting down services...}%%%"
  docker-compose down
  echo "%%%END FOLD%%%"
}

trap cleanup EXIT

echo "%%%FOLD {Setting environment...}%%%"
set -ex
. "$(dirname $0)/../script/bintools"
echo "%%%END FOLD%%%"

export CI_MODE=true

output_fold "Bootstrapping container..." docker-compose build
output_fold "Installing dependencies..." script/install-dependencies
output_fold "Bringing up services..." docker-compose up -d

if [ ${JANKY_ENV_TEST_SUBSET:-} ]; then
  tests=$JANKY_ENV_TEST_SUBSET
else
  tests=""
fi
output_fold "Running tests..." script/lint $tests
