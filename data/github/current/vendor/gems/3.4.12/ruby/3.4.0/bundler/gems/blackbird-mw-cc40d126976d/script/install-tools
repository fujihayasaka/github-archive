#! /usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")/.."

echo "Installing tools..."
tools=$(pwd)/_tools
export GOBIN=$tools/bin

if [[ -d $tools ]]; then
    echo "Deleting old tools cache: $tools"
    rm -rf "$tools"
fi

mkdir -p "$GOBIN"

cd $tools
go mod init tools
go install github.com/pointlander/peg@latest
go install github.com/skeema/skeema@v1.5.1
go install github.com/maxbrunsfeld/counterfeiter/v6@latest
# Sane test output (wrapper around go test): https://github.com/gotestyourself/gotestsum
go install gotest.tools/gotestsum@v1.7.0
