    # source://dependabot-conda//lib/dependabot/conda/update_checker/requirement_translator.rb#38
    sig { params(wildcard_requirement: ::String).returns(::String) }
    def convert_wildcard_requirement(wildcard_requirement); end
  end
end

# Conda version handling delegates to Python version since conda primarily manages Python packages
#
# source://dependabot-conda//lib/dependabot/conda/version.rb#10
class Dependabot::Conda::Version < ::Dependabot::Python::Version
  class << self
    # Conda supports the same version formats as Python packages from PyPI
    # This includes standard semver, epochs, pre-releases, dev releases, etc.
    #
    # source://dependabot-conda//lib/dependabot/conda/version.rb#16
    sig do
      override
        .params(
          version: T.nilable(T.any(::Gem::Version, ::Integer, ::String))
        ).returns(::Dependabot::Conda::Version)
    end
    def new(version); end
  end
end
