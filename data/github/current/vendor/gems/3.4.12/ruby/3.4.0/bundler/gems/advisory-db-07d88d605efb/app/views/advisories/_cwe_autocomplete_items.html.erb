<% cwes.each do |cwe_id, cwe_name| %>
  <li
    role="option"
    class="autocomplete-item p-2"
    data-autocomplete-value="<%= cwe_id %>"
    data-autocomplete-name="<%= cwe_name %>"
    data-action="click:cwe-autocomplete#addLinkedCWE">
    <span class="text-bold mr-1"><%= cwe_name %></span>
    <span class="text-normal no-wrap">(<%= cwe_id %>)</span>
  </li>
<% end %>
