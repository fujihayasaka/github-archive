<% content_for :title, "CVE reviews" %>
<div class="d-flex flex-justify-between flex-items-center mb-4">
  <h2>CVE Reviews</h2>
  <%= render(Primer::ButtonComponent.new(tag: :a, href: new_cve_review_path, scheme: :primary, variant: :small)) { "New CVE review" } %>
</div>
<div class="d-flex flex-row">
  <%= render Primer::Beta::Details.new(reset: true, overlay: :default, display: :inline_block, position: :relative, mb: 3, mr: 1) do |details| %>
    <% details.with_summary(aria: { haspopup: true }) do %>
      State: <%= curation_state_label(curation_state) %>
      <div class="dropdown-caret"></div>
    <% end %>

    <% details.with_body(classes: "SelectMenu") do %>
      <div class="SelectMenu-modal width-full">
        <div class="SelectMenu-list">
          <a role="menuitem" class="SelectMenu-item no-wrap text-semibold"
            href="<%= url_for(request.query_parameters.merge(state: "all", page: nil)) %>">
            <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (curation_state == "all" ? :visible : :hidden)) %>
            All states
          </a>
          <% curation_states.each do |state_filter| %>
            <a role="menuitem" class="SelectMenu-item no-wrap"
              href="<%= url_for(request.query_parameters.merge(state: state_filter, page: nil)) %>">
              <%= render IconComponent.new(icon: "check", classes: "SelectMenu-icon", visibility: (curation_state == state_filter ? :visible : :hidden)) %>
              <span class="d-inline-block mr-2">
                <%= render ReviewStateIconComponent.new(curation_state: state_filter) %>
              </span>
              <%= curation_state_label(state_filter) %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= form_tag(cve_reviews_path, method: :get, class: "d-flex flex-1") do %>
    <% hidden_search_fields.each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>

    <%= text_field_tag "query", query, placeholder: "Search CVE or GHSA IDs...", autocomplete: "off", class: "form-control flex-1 mb-3" %>
  <% end %>
</div>

<%= render(CVEReviews::TableComponent.new(cve_reviews: cve_reviews, sort: sort)) %>

<%= pagination(cve_reviews) %>
