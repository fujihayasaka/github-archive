// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go
{
    "name": "Go",
    "image": "mcr.microsoft.com/devcontainers/go:1.25",
    "onCreateCommand": ".devcontainer/on-create-command.sh",
    "postStartCommand": ".devcontainer/post-start-command.sh",
    "containerEnv": {
        "GOPROXY": "https://goproxy.githubapp.com/mod,https://proxy.golang.org,direct",
        "GOPRIVATE": "",
        "GONOPROXY": "",
        "GONOSUMDB": "github.com/github/*"
    },
    // Features to add to the dev container. More info: https://containers.dev/features.
    "features": {
        "ghcr.io/github/features/goproxy:1": {},
        "ghcr.io/github/features/protoc:latest": {},
        "ghcr.io/github/features/go-linter:2": {},
        "ghcr.io/github/features/mysql:1": {},
        "ghcr.io/devcontainers/features/sshd:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/github-cli": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "moby": false,
            "dockerDashComposeVersion": "v2"
        },
        "ghcr.io/github/features/dev-vpn:1": {
            "pullImage": true
        },
        "ghcr.io/github/features/fm-lite:1": {
            "port": "8090"
        }
    },
    "hostRequirements": {
        "cpus": 8,
        "memory": "16gb"
    },
    "customizations": {
        "codespaces": {
            "repositories": {
                "github/*": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                },
                // Prebuilds need to explicitly request access and then authorize instead of using the /* syntax.
                // Ref: https://github.com/github/codespaces/issues/11743
                "github/features": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                },
                "github/go-linter": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                },
                "github/feature-management-lite": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                },
                "github/go-server": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                },
                "github/gh-kustomize": {
                    "permissions": {
                        "contents": "read",
                        "packages": "read"
                    }
                }
            }
        },
        "vscode": {
            "extensions": [
                "golang.go",
                "GitHub.copilot",
                "GitHub.codespaces",
                "GitHub.copilot-chat",
                "timonwong.shellcheck",
                "humao.rest-client"
            ],
            "settings": {
                "files.insertFinalNewline": true,
                "files.trimFinalNewlines": true,
                "files.trimTrailingWhitespace": true,
                "chat.agent.enabled": true,
                "chat.mcp.discovery.enabled": true,
                "files.watcherExclude": {
                    "**/.git": true
                }
            }
        }
    }
}
