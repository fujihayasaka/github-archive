<% content_for :breadcrumbs do %>
  <%= render "breadcrumbs", blocklisted_term: blocklisted_term %>
<% end %>

<h2 class="mb-4 d-flex flex-justify-between flex-items-center">
  <%= blocklisted_term.pattern %>
  <%= link_to "Delete blocklisted term", blocklisted_term_path(blocklisted_term), method: :delete, data: { confirm: "Are you sure you want to delete this blocklisted term?" }, class: "btn btn-danger btn-sm" %>
</h2>

<%= render(AdvisoryReviews::TableComponent.new(advisory_reviews: blocklisted_reviews)) %>

<%= will_paginate blocklisted_reviews,
      params: request.query_parameters,
      inner_window: 2,
      outer_window: 0,
      previous_label: "Previous",
      next_label: "Next",
      class: "pagination text-center mt-3"
%>
