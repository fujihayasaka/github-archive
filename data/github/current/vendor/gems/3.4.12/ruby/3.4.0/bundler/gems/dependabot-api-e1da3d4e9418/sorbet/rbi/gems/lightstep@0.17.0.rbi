# source://lightstep//lib/lightstep/transport/base.rb#2
module LightStep::Transport; end

# Base Transport type
#
# source://lightstep//lib/lightstep/transport/base.rb#4
class LightStep::Transport::Base
  # source://lightstep//lib/lightstep/transport/base.rb#5
  def report(_report); end
end

# source://lightstep//lib/lightstep/transport/callback.rb#5
class LightStep::Transport::Callback < ::LightStep::Transport::Base
  # @return [Callback] a new instance of Callback
  #
  # source://lightstep//lib/lightstep/transport/callback.rb#6
  def initialize(callback:); end

  # source://lightstep//lib/lightstep/transport/callback.rb#10
  def report(report); end
end

# HTTPJSON is a transport that sends reports via HTTP in JSON format.
# It is thread-safe.
#
# source://lightstep//lib/lightstep/transport/http_json.rb#8
class LightStep::Transport::HTTPJSON < ::LightStep::Transport::Base
  # Initialize the transport
  #
  # @param host [String] host of the domain to the endpoint to push data
  # @param port [Numeric] port on which to connect
  # @param verbose [Numeric] verbosity level. Right now 0-3 are supported
  # @param encryption [ENCRYPTION_TLS, ENCRYPTION_NONE] kind of encryption to use
  # @param access_token [String] access token for LightStep server
  # @param ssl_verify_peer [Boolean]
  # @param open_timeout [Integer]
  # @param read_timeout [Integer]
  # @param continue_timeout [Integer]
  # @param keep_alive_timeout [Integer]
  # @param logger [Logger]
  # @raise [Tracer::ConfigurationError]
  # @return [HTTPJSON] a new instance of HTTPJSON
  #
  # source://lightstep//lib/lightstep/transport/http_json.rb#33
  def initialize(access_token:, host: T.unsafe(nil), port: T.unsafe(nil), verbose: T.unsafe(nil), encryption: T.unsafe(nil), ssl_verify_peer: T.unsafe(nil), open_timeout: T.unsafe(nil), read_timeout: T.unsafe(nil), continue_timeout: T.unsafe(nil), keep_alive_timeout: T.unsafe(nil), logger: T.unsafe(nil)); end

  # Queue a report for sending
  #
  # source://lightstep//lib/lightstep/transport/http_json.rb#65
  def report(report); end

  private

  # @param report [Hash]
  # @return [Net::HTTP::Post]
  #
  # source://lightstep//lib/lightstep/transport/http_json.rb#82
  def build_request(report); end

  # @return [Net::HTTP]
  #
  # source://lightstep//lib/lightstep/transport/http_json.rb#94
  def connection; end
end

