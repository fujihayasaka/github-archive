  #   Span will be finished automatically after the block is executed.
  #
  # source://lightstep//lib/lightstep/tracer.rb#108
  def start_active_span(operation_name, child_of: T.unsafe(nil), references: T.unsafe(nil), start_time: T.unsafe(nil), tags: T.unsafe(nil), ignore_active_scope: T.unsafe(nil), finish_on_close: T.unsafe(nil)); end

  # Starts a new span.
  #
  # @param operation_name [String] The operation name for the Span
  # @param child_of [SpanContext] SpanContext that acts as a parent to
  #   the newly-started Span. If a Span instance is provided, its
  #   .span_context is automatically substituted.
  # @param references [Array<SpanContext>] An array of SpanContexts that
  #   identify any parent SpanContexts of newly-started Span. If Spans
  #   are provided, their .span_context is automatically substituted.
  # @param start_time [Time] When the Span started, if not now
  # @param tags [Hash] Tags to assign to the Span at start time
  # @param ignore_active_scope [Boolean] whether to create an implicit
  #   References#CHILD_OF reference to the ScopeManager#active.
  # @return [Span, Object] If passed an optional block, start_span will return
  #   the block's return value, otherwise it returns the newly-started Span
  #   instance, which has not been automatically registered via the
  #   ScopeManager
  # @yield [Span] If passed an optional block, start_span will yield the
  #   newly-created span to the block. The span will be finished automatically
  #   after the block is executed.
  #
  # source://lightstep//lib/lightstep/tracer.rb#169
  def start_span(operation_name, child_of: T.unsafe(nil), references: T.unsafe(nil), start_time: T.unsafe(nil), tags: T.unsafe(nil), ignore_active_scope: T.unsafe(nil)); end

  protected

  # @raise [ConfigurationError]
  #
  # source://lightstep//lib/lightstep/tracer.rb#247
  def configure(component_name:, access_token: T.unsafe(nil), transport: T.unsafe(nil), tags: T.unsafe(nil), propagator: T.unsafe(nil)); end
end

