{
  "hostRequirements": { // Require specs of the extremeLinux machine type for codespaces
    "storage": "64gb",
    "memory": "64gb"
  },
  "build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
  "runArgs": ["--privileged", "--security-opt", "seccomp=unconfined"],
  "overrideCommand": true,
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/github/features/dev-vpn:1" : {}
  },
  "remoteEnv": {
    "BUNDLE_RUBYGEMS__PKG__GITHUB__COM": "${localEnv:GITHUB_USER}:${localEnv:GITHUB_TOKEN}",
    "COMPOSE_FILE": "docker-compose.codespaces.yml"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      }
    },

    // These may be overridden by user settings. See also ../settings.json for
    // settings that we want to always have applied in the codespace.
    "settings": {
      "rubocop.commandPath": "${userHome}/.rbenv/shims/rubocop",
      "rubyLsp.rubyVersionManager": {
        "identifier": "rbenv"
      }
    },

    // Add the IDs of VS Code extensions you want installed when the container
    // is created.
    "vscode": {
      "extensions": [
        "rubocop.vscode-rubocop",
        "Shopify.ruby-lsp"
      ]
    }
  },
  // Lifecycle events - All of these commands run as the container user (vscode)
  // and are run from the workspace folder in a /bin/dash or /bin/sh shell.
  "onCreateCommand": ".devcontainer/on-create-command.sh"
}
