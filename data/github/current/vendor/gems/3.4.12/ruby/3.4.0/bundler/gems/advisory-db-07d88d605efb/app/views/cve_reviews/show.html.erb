<% content_for :breadcrumbs do %>
  <%= render "breadcrumbs", cve_review: cve_review %>
<% end %>

<% content_for :navigation do %>
  <%= render "navigation", cve_review: cve_review %>
<% end %>

<%= render ReviewHeaderComponent.new(review: cve_review) %>

<form-tracker>
  <%= render Primer::Alpha::Layout.new(first_in_source: :main) do |layout| %>
    <% layout.with_sidebar(col_placement: :end) do %>
      <%= render CVEReviews::SidebarComponent.new(cve_review: cve_review, cve_request: cve_request, reject_modal_error: local_assigns[:reject_modal_error], rejection: local_assigns[:rejection], show_reject_modal: local_assigns[:show_reject_modal]) %>
    <% end %>

    <% layout.with_main do %>
      <%= render CVEReviews::FormComponent.new(cve_review: cve_review, cve_request: cve_request, can_edit_vendor_name_and_product: cve_review.ghsl_request.present?) %>
    <% end %>
  <% end %>
</form-tracker>
