#!/bin/bash
set -e

arch=$([ "$(uname -m)" = "aarch64" ] && echo "aarch_64" || echo "x86_64")
version="${1:-3.6.1}"
protoc_dir="/tmp/protoc-${version}"
url="https://github.com/protocolbuffers/protobuf/releases/download/v${version}/protoc-${version}-linux-${arch}.zip"

curl -s -L -o /tmp/protoc.zip "$url" && \
  mkdir -p "$protoc_dir" && \
  unzip -o -d "$protoc_dir" /tmp/protoc.zip && \
  chmod -R a+r "$protoc_dir/include/google/protobuf" && \
  rm /tmp/protoc.zip

echo "$protoc_dir"
