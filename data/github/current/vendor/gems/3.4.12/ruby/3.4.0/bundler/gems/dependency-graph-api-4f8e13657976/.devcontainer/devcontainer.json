{
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".."
  },
  "onCreateCommand": ".devcontainer/on-create-command.sh",
  "postCreateCommand": ".devcontainer/post-create-command.sh",
  "postAttachCommand": ".devcontainer/post-attach-command.sh",
  "hostRequirements": {
    "memory": "16gb"
  },
  "features": {
    "ghcr.io/github/features/goproxy:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/go:1": {}
  },
  "forwardPorts": [
    // Main service port
    9596
  ],
  "containerEnv": {
    "AQUEDUCT_URL": "http://localhost:18081/twirp",
    "OTEL_LOG_LEVEL": "warn",
    "GITHUB_TELEMETRY_LOGS_LEVEL": "info",
    "GITHUB_TELEMETRY_LOGS_LIB_LEVEL": "info",
    "GITHUB_TELEMETRY_LOGS_STDOUT": "true",
    "GITHUB_TELEMETRY_LOGS_ENABLE_SYNC_APPENDER": "true",
    "GITHUB_TELEMETRY_LOGS_FILE": "true"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/*": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/features": {
          "permissions": {
              "contents": "read",
              "packages": "read"
          }
        },
        "github/dependency-snapshots-api": {
          "permissions": {
            "contents": "write",
            "packages": "write"
        }
        },
        "github/aqueduct-client-ruby": {
          "permissions": {
            "contents": "read",
            "packages": "read"
        }
        },
        "github/feature-flags-client-ruby": {
          "permissions": {
            "contents": "read",
            "packages": "read"
        }
        },
        "github/github-telemetry-ruby": {
          "permissions": {
            "contents": "read",
            "packages": "read"
        }
        },
        "github/monolith-twirp-features": {
          "permissions": {
            "contents": "read",
            "packages": "read"
        }
        }
      }
    }
  }
}
