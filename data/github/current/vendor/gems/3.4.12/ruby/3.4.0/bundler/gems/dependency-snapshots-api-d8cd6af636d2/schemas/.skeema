default-character-set=utf8mb4
default-collation=utf8mb4_unicode_520_ci
flavor=mysql:8.4
generator=skeema:1.8.1-community

[skeema-diff-ci]
host=127.0.0.1
port=3306
schema=skeema:dependency_snapshots_api
user=root

[production]
host=db
port=3306
schema=dependency_snapshots_development
user=root

[test]
host=localhost
port=3001
schema=dependency_snapshots_test
user=root

[skeema-local]
flavor=mysql:8.4
host=localhost
port=3001
schema=dependency_snapshots_development
user=root

[skeema-local-cs]
host=db
port=3306
schema=dependency_snapshots_development
user=root

[dependency_snapshots_api]
schema=dependency_snapshots_api
