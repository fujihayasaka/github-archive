#!/bin/bash
# script/configure-codespace-compose: Helper script used by codespace-compose's exec to get dg-api into a ready state.

set -e

cd "$(dirname "$0")/.."

# Try not to append to /etc/hosts more than once
if ! grep -q 'github.localhost' /etc/hosts; then
  echo "127.0.0.1 api.github.localhost" | sudo tee -a /etc/hosts
  echo "127.0.0.1 github.localhost" | sudo tee -a /etc/hosts
fi

# Create a file that indicates that this codespace is under the control of codespace-compose now!
sudo touch /etc/dg.codespace-compose
