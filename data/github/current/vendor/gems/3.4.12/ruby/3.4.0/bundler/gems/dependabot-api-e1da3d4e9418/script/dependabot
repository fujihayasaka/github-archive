#!/bin/bash
appdir=$(cd $(dirname "$0")/.. && pwd)

if [ -f /etc/app-env ]; then
  exec bundle exec ruby $0 $@
else
  exec "$appdir/script/app-env" bundle exec ruby $0 $@
fi

#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Provides the entry point for Stafftools::Cli
#
# For usage see:
#   script/dependabot help
require_relative "../config/environment"

require 'stafftools/cli'

Rails.logger.level = :warn
Stafftools::Cli.start(ARGV)
