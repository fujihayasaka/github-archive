#!/bin/bash
set -euo pipefail

echo "Installing Terraform"

# Fail if GitHub CLI is not installed
if ! [ -x "$(command -v gh)" ]; then
  echo 'Error: gh is not installed. GitHub CLI is required to proceed.' >&2
  exit 1
fi

# Install tfenv
if command -v tfenv &> /dev/null
then
  echo "tfenv already installed, skipping"
else
  git clone --depth=1 https://github.com/tfutils/tfenv.git ~/.tfenv
  sudo ln -s ~/.tfenv/bin/* /usr/local/bin
  echo "tfenv installed"
fi

# Install Terraform
# The version to use is resolved automatically via TFENV_TERRAFORM_VERSION environment variable or .terraform-version files,
# in that order of precedence, i.e. TFENV_TERRAFORM_VERSION, then .terraform-version.
# The default is 'latest' if none are found.
tfenv install
tfenv use
echo "Terraform installed"

echo "Finished installing Terraform"
