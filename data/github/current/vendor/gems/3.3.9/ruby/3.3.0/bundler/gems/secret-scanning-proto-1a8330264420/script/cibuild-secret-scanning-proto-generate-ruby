#!/bin/bash
set -e
set -u

echo "%%%FOLD {generating ruby code}%%%"
script/generate-ruby
echo "%%%END FOLD%%%"

echo "%%%FOLD {checking for changes}%%%"
if [[ $(git status --porcelain) != "" ]]; then
    echo "modified files:"
    git --no-pager diff --name-only
    git ls-files --others
    exit 1
fi
echo "%%%END FOLD%%%"
