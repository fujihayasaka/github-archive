#!/usr/bin/env bash

set -euo pipefail

root="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null 2>&1 && pwd )"
cd "$root"

gems_dir="$root/gems"

# note: the order of the gems is important, because the vexi_management gem depends on the vexi gem
gem_array=("$gems_dir/vexi.gem" "$gems_dir/vexi_management.gem")
# Loop through the array and build each gem per gemspec
for gem in "${gem_array[@]}"
do
  gem_file=$(basename $gem)

  echo "----- Installing gem: $gem_file "-----
  if !(gem install --local "$gem"); then
      echo "Failed to install gem: $gem"
      exit 1
  fi
done
