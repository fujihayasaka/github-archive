#!/usr/bin/env bash

if [[ $GITHUB_REPOSITORY != "github/github" ]]; then
  # Runner auth is only required in github/github codespace
  exit 0
fi

# Copy existing certificate locally, convert back to pem and then put it in bin so that we pick it up for deployment.
CERTIFICATE_PATH="/home/vscode/.actions-dev/certificates/imsoauths2ssigningcertthumbprint"

# Check if the certificate file exists
if [ ! -f "$CERTIFICATE_PATH" ]; then
  echo "Certificate file not found: $CERTIFICATE_PATH"
else
  mkdir -p bin
  pushd bin
  openssl pkcs12 -in $CERTIFICATE_PATH -nocerts -nodes -out token.pem -passin pass:
  chmod 777 token.pem
  popd
fi