{
	"name": "github/turboscan",
	"workspaceFolder": "/workspaces/turboscan/",
	// Runs automatically after Prebuild Template environment is created.
	"onCreateCommand": ".devcontainer/on-create-command.sh",
	// Runs _inside_ the container after it is created, for user-specific configuration.
	"postCreateCommand": ".devcontainer/post-create-command.sh",
	// Runs automatically after Codespace environment is attached.
	"postAttachCommand": ".devcontainer/post-attach-command.sh",
	"dockerComposeFile": [
		"docker-compose.yml"
	],
	"service": "turboscan",
	"settings": {
		"terminal.integrated.shell.linux": "/bin/bash",
		"go.useLanguageServer": true
	},
	"hostRequirements": { // Require specs of the standard machine type for codespaces
		"storage": "64gb",
		"memory": "16gb"
	},
	"extensions": [
		"golang.go",
		"zxh404.vscode-proto3"
	],
	"forwardPorts": [
		8888,
		9000,
		9202,
		10000,
		13307
	],
	"portsAttributes": {
		"8888": {
			"label": "turboscansvc"
		},
		"9000": {
			"label": "s3"
		},
		"10000": {
			"label": "azurite"
		},
		"9202": {
			"label": "elasticsearch"
		},
		"13307": {
			"label": "mysql"
		},
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2.11.0": {}
	},
	"customizations": {
		"codespaces": {
			"repositories": {
				"github/*": {
					"permissions": {
						"contents": "read"
					}
				},
				"github/codeml-autofix": {
					"permissions": {
						"contents": "read",
						"packages": "read"
					}
				}
			}
		}
	}
}
