  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch api",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/api/main.go",
      "envFile": "${workspaceFolder}/dev.vscode.env",
    },
    {
      "name": "Launch queue-worker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/queue-worker/main.go",
      "envFile": "${workspaceFolder}/dev.vscode.env",
    },
    {
      "name": "Launch hydro-processor",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/hydro-processor/main.go",
      "envFile": "${workspaceFolder}/dev.vscode.env",
    },
    {
      "name": "Launch transition",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/transition/main.go",
      "envFile": "${workspaceFolder}/dev.vscode.env",
      "args": [
        "--dry_run=false",
        "--name=add_license_status",
        "--start_customer_id=1",
        "--end_customer_id=4",
      ]
    }
  ]
}