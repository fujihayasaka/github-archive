#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
NC='\033[0m' # No Color

# Stop and remove the container if it already exists
docker rm -f kaja-twirp &> /dev/null || true

# Run the container
docker run --pull always --name kaja-twirp -d -p 41520:41520 \
    -v /workspaces/billing-platform/proto:/app/proto/proto \
    -e BASE_URL="http://host.docker.internal:8989" --add-host=host.docker.internal:host-gateway kajatools/kaja-twirp:latest

# Open kaja-twirp in a default web browser
echo -e "${GREEN}Opening kaja-twirp URL http://127.0.0.1:41520/ in your default web browser${NC}"
python3 -m webbrowser http://127.0.0.1:41520/

echo -e "${ORANGE}Nothing happening? Try running this script again or open http://127.0.0.1:41520/ manually.${NC}"
echo -e "${ORANGE}Got 5XX error? Try refreshing the page.\n${NC}"