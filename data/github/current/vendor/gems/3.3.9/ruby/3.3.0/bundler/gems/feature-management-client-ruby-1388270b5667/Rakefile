# frozen_string_literal: true
# typed: true

require "minitest/test_task"
require "sorbet-runtime"

T.bind(self, T.all(Rake::DSL, Object))

Minitest::TestTask.create :test do |t|
  t.libs << "vexi/lib" unless ENV["VEXI_GENERATED_TEST"]
  t.libs << "generated/vexi/lib" if ENV["VEXI_GENERATED_TEST"]
  t.libs << "vexi_management/lib"
  t.test_globs = ["test/**/*_test.rb"]
  t.warning = true
end

Minitest::TestTask.create :benchmark do |t|
  t.libs << "generated/vexi/lib"
  t.test_globs = ["benchmark/benchmarks/*.rb"]
  t.warning = false
end

task default: [:test]
