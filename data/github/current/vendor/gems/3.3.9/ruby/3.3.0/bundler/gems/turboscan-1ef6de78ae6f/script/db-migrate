#!/bin/bash

set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
. "$DIR/ensure-devcontainer.sh"

pushd "$DIR/../schemas"
    skeema push development_without_vitess --allow-unsafe
    skeema push test_without_vitess --allow-unsafe
popd

# Run Transitions on dev env:

# Uncomment next line if there are any transitions to run
make bin/migratorctl

# Copy and paste this line inserting the transition name that you want to run
#   ./bin/migratorctl --transition XXXXXX
./bin/migratorctl --transition 20230707090130_populate_physical_alerts_last_stage_change_at.go
./bin/migratorctl --transition 20230912095551_add_initial_languages_to_codeql_configs.go
./bin/migratorctl --transition 20231020093718_complete-old-deliveries.go
./bin/migratorctl --transition 20231027133705_update-default-setup-languages.go
./bin/migratorctl --transition 20231208125151_backfill-severities-from-physical-alerts-to-logical-alerts.go
./bin/migratorctl --transition 20240125122156_copy_using_cs_runner_label_to_codeql_repo.go
./bin/migratorctl --transition 20240409102643_populate_codeql_repo_enabled_at.go
./bin/migratorctl --transition 20240805095102_remove_old_analysis_messages.go
./bin/migratorctl --transition 20241018112917_backfill_configurations.go
./bin/migratorctl --transition 20241112093614_backfill_logical_alerts_for_default_ref.go
./bin/migratorctl --transition 20241114150730_backfill_remaining_logical_alerts.go
