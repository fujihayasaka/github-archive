#!/bin/bash

set -e
dir="$(dirname "$0")"

if [ -z "$1" ]; then org=1; else org=$1; fi

requestBody="{\"owner_id\": $org }"
echo "Request Body: $requestBody"

json=$($dir/hmac-curl -s -X POST aum.local:32474/twirp/actions_usage_metrics.api.v1.UsageApi/GetSignedUsageExportUrl -H "Content-Type: application/json" -d "$requestBody")
echo ==============
echo $json
echo ==============

# Get "signed_url" from the response
signed_url=$(echo $json | jq -r '.signed_url')
echo "Signed URL: $signed_url"

curl -s -X POST $signed_url
