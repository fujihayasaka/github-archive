#! /usr/bin/env bash

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "Checking if any generated rbi files have changed"
rbiFileChanges=$(git status | grep -i -c sorbet/ || true) # grep returns an error if no match

if [[ $rbiFileChanges -gt 0 ]]; then
    echo -e "${RED}Found updates in generated rbi files, please run 'make install-gems' and commit the changes${NC}"

    # Ouput the files with diffs to the console
    echo -e "${RED}Diff of generated rbi files${NC}"
    git status -s sorbet/ > sorbet.txt
    cat sorbet.txt
    rm sorbet.txt
else
    echo -e "${GREEN}No changes found in generated rbi files${NC}"
fi

echo "Checking if any of the generated sorbet erased vexi code has changed"
vexiGeneratedFileChanges=$(git status | grep -i -c generated/ || true) # grep returns an error if no match

if [[ $vexiGeneratedFileChanges -gt 0 ]]; then
    echo -e "${RED}Found updates in generated vexi files, please run 'make erasesrb' and commit the changes${NC}"

    # Ouput the files with diffs to the console
    echo -e "${RED}Diff of generated vexi files${NC}"
    git status -s generated/ > generated.txt
    cat generated.txt
    rm generated.txt
else
    echo -e "${GREEN}No changes found in generated vexi files${NC}"
fi

if [[ $rbiFileChanges -gt 0 || $vexiGeneratedFileChanges -gt 0 ]]; then
  exit 1
fi
