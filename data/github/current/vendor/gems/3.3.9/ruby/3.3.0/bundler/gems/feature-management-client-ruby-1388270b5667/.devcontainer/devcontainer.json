{
  "name": "github/feature-management-client-ruby",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/feature-management-protos": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/features": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/gh-base-image": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "github/*": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    },
    "vscode": {
      "settings": {
        "files.watcherExclude": {
          "**/.git": true
        }
      },
      "extensions": [
        "misogi.ruby-rubocop",
        "wingrunr21.vscode-ruby",
        "sorbet.sorbet-vscode-extension"
      ]
    }
  },
  "onCreateCommand": "./script/bootstrap",
  "postStartCommand": "./script/setup-gem-credentials"
}