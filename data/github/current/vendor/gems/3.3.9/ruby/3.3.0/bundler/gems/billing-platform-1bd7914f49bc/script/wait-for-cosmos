#!/bin/bash
set -e

# This script is used to wait for the Cosmos emulator to be ready to accept connections.

while true; do
    if docker logs cosmos-db | grep -q 11/11; then
        echo "Cosmos Emulator is ready"
        break
    else
        echo "Cosmos Emulator is not ready, waiting 5 seconds..."
        sleep 5
    fi
done