#!/bin/bash

set -euo pipefail

source_dir=$(bundle info feature_management_feature_flags --path)
# Destination directory
dest_dir="./sorbet/rbi/gems"

# Create the destination directory if it doesn't exist
mkdir -p "$dest_dir"

# Copy the .rbi files
find "$source_dir" -type f -name '*.rbi' | while read -r file; do
    # Remove the source directory part from the file path and replace '/' with '_'
    relative_path="${file#$source_dir/}"
    modified_filename="${relative_path//\//_}"

    # Remove 'lib_' prefix from the filename
    modified_filename="${modified_filename#lib_}"

    # Copy the file to the destination directory with the new name
    cp "$file" "$dest_dir/$modified_filename"
done