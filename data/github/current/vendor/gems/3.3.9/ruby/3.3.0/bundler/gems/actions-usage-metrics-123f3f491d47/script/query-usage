#!/bin/bash
# Examples:
# script/query-usage GetUsageByRepoWorkflowRunner
# script/query-usage GetJobUsage
# script/query-usage GetRepoUsage
# script/query-usage GetRunnerTypeUsage
# script/query-usage GetRunnerRuntimeUsage

set -e
dir="$(dirname "$0")"
echo "Usage: $0 [GetUsageByRepoWorkflowRunner | GetJobUsage | GetRepoUsage | GetRunnerTypeUsage | GetRunnerRuntimeUsage | GetWorkflowPerformance] [owner_id] [repo_id] [version_override e.g. v1] [date_range e.g. DATE_RANGE_TYPE_CURRENT_WEEK] [repositoryFilter e.g. 3] [offset] [limit]"

if [ -z "$1" ]; then endpoint='GetWorkflowPerformance'; else endpoint=$1; fi
if [ -z "$2" ]; then org=1; else org=$2; fi
if [ -z "$3" ]; then scope="{\"owner_id\": $org, \"scope_type\": \"SCOPE_TYPE_ORG\"}"; else scope="{\"owner_id\": $org, \"repository_id\": $3, \"scope_type\": \"SCOPE_TYPE_REPO\"}"; fi
if [ -z "$4" ]; then version='v2'; else version=$4; fi
if [ -z "$5" ]; then date_range='DATE_RANGE_TYPE_LATEST_MONTH'; else date_range=$5; fi
if [ -z "$6" ]; then repositoryFilter=''; else repositoryFilter=$6; fi
if [ -z "$7" ]; then offset=0; else offset=$7; fi
if [ -z "$8" ]; then limit=10; else limit=$8; fi

if [ -z "$repositoryFilter" ]; then repositoryFilterJson=""; else repositoryFilterJson=", \"filters\":[{\"key\":\"repository_id\",\"operator\":1,\"values\":[\"$repositoryFilter\"]}]"; fi

requestBody="{\"request_options\": { \"date_range\": \"$date_range\", \"scope\": $scope, \"offset\": $offset, \"limit\": $limit, \"projection_options\":{ \"version_override\":\"$version\" }$repositoryFilterJson }}"
echo "Request Body: $requestBody"

json=$($dir/hmac-curl -s -X POST aum.local:32474/twirp/actions_usage_metrics.api.v1.UsageApi/$endpoint -H "Content-Type: application/json" -d "$requestBody")

echo ==============
echo $json
echo ==============

case "$endpoint" in
"GetUsageByRepoWorkflowRunner")
    echo "$json" | jq -r ".items[] | [.repository_id, .workflow_file_path, .runner_type, .runner_runtime, .total_minutes, .workflow_executions.count, .jobs.count] | @tsv" | column -t
    ;;
"GetJobUsage")
    echo "$json" | jq -r ".items[] | [.repository_id, .workflow_file_path, .job_name, .runner_type, .runner_runtime, .total_minutes, .job_executions] | @tsv" | column -t
    ;;
"GetRepoUsage")
    echo "$json" | jq -r ".items[] | [.repository_id, .total_minutes, .workflows_executions.count, .workflows.count] | @tsv" | column -t
    ;;
"GetRunnerRuntimeUsage")
    echo "$json" | jq -r ".items[] | [.runner_runtime, .total_minutes, .workflows_executions.count, .workflows.count] | @tsv" | column -t
    ;;
"GetRunnerTypeUsage")
    echo "$json" | jq -r ".items[] | [.runner_type, .total_minutes, .workflows_executions.count, .workflows.count] | @tsv" | column -t
    ;;
"GetWorkflowPerformance")
    echo "$json" | jq -r ".items[] | [.repository_id, .workflow_file_path, .jobs.count, .workflow_executions, .average_run_time, .failure_rate] | @tsv" | column -t
    ;;
*)
    echo "Unkown endpoint $endpoint, use GetUsageByRepoWorkflowRunner | GetJobUsage | GetRepoUsage | GetRunnerTypeUsage | GetRunnerRuntimeUsage"
    ;;
esac

if [ ! -z "$json" ]; then echo "$(echo "$json" | jq -r ".total_items") items total"; fi
