#!/bin/bash

GREEN='\033[0;32m'
ORANGE='\033[0;33m'
NC='\033[0m' # No Color

KAJA_TWIRP_PORT=41520
KAJA_TWIRP_URL="http://127.0.0.1:${KAJA_TWIRP_PORT}"

# Stop and remove the container if it already exists
docker rm -f kaja-twirp &> /dev/null || true

# Run the container
docker run --pull always --name kaja-twirp -d -p ${KAJA_TWIRP_PORT}:41520 \
    -v /workspaces/licensify/proto:/workspace \
    -e BASE_URL="http://host.docker.internal:12345" --add-host=host.docker.internal:host-gateway kajatools/kaja-twirp:latest

# Wait until the status endpoint returns "OK"
echo -en "${GREEN}Waiting for kaja-twirp URL ${KAJA_TWIRP_URL}/status to become ready:${NC}"
until [ "`curl -s ${KAJA_TWIRP_URL}/status`" == "OK" ]; do
    echo -n "."
    sleep 0.1;
done;
echo \n;

# Open kaja-twirp in the default web browser
echo -en "${GREEN}Opening kaja-twirp URL ${KAJA_TWIRP_URL} in your default web browser${NC}"
python3 -m webbrowser ${KAJA_TWIRP_URL}
echo -e "${ORANGE}Nothing happening? Try running this script again or open ${KAJA_TWIRP_URL} manually.${NC}"