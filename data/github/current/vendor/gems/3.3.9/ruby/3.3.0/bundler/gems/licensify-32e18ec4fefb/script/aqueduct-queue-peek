#!/bin/bash

AQUEDUCT_URL=http://localhost:18081
QUEUE=${1:-"licensify-development"}
COUNT=${2:-1}

# From: https://github.com/github/aqueduct/blob/main/docs/api.md
curl --header "Content-Type:application/json" \
     --data '{"app": "licensify-development", "queue":"'${QUEUE}'", "count":'${COUNT}'}' \
     $AQUEDUCT_URL/twirp/aqueduct.api.v1.JobQueueService/Peek

# New line after the curl response
echo