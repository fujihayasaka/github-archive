#!/bin/bash

set -euo pipefail

root="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null 2>&1 && pwd )"
cd "$root"

echo "-------------------"
echo "Running in memory adapter with management demo"
echo ""

ruby -I $root/vexi/lib -I $root/vexi_management/lib $root/examples/demo_in_memory_adapter_management.rb
