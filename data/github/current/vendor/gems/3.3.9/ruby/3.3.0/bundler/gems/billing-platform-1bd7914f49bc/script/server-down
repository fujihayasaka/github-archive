#!/bin/bash
# Usage: script/server-down
# Tears down the containers spun up by script/server.
#
# Normally this is done by script/server, but if you started script/server in detached mode (script/server -d)
# then it needs to manually cleaned up.
#
# This also helps reset the docker network in case of any issues.

set -e

cd "$(dirname "$0")/.."

script/dc down
