#!/bin/bash

set -euo pipefail

if [ ! -d ~/.gem ]; then
    mkdir ~/.gem
fi

[ -e ~/.gem/credentials ] && rm ~/.gem/credentials
echo "---"  >> ~/.gem/credentials
echo ":github: Bearer ${GITHUB_TOKEN}" >> ~/.gem/credentials
chmod 0600 ~/.gem/credentials

bundle config https://rubygems.pkg.github.com/github nobody:${GITHUB_TOKEN}