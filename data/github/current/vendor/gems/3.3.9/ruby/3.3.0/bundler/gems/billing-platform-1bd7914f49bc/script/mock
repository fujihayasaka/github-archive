#!/usr/bin/env bash

echo "== Generating mock for $1 ==="

INTERFACE_NAME=$1

if [ -z "$INTERFACE_NAME" ]; then
  echo "Interface name is required"
  echo "Usage: ./script/mock <interface_name>"
  exit 1
fi

pegomock generate --output-dir=/workspaces/billing-platform/testing/fakes --package fakes "$INTERFACE_NAME"

echo "== Mock generated in /workspaces/billing-platform/testing/fakes ==="