#!/bin/bash
#
# Expected to execute inside the docker container built from /config/tools/protoc/Dockerfile
#
set -e


SCRIPT_DIR=$(cd -P -- "$(dirname -- "$0")" && pwd -P)
ROOT_DIR=${SCRIPT_DIR}/../..

RUBY_CLIENT_PATH=${ROOT_DIR}/ruby/lib

echo "Generating proto files for GO, ruby and typescript"

mkdir -p ${RUBY_CLIENT_PATH}
${ROOT_DIR}/bin/protoc \
    --proto_path=${ROOT_DIR} \
    --twirp_out=./ \
    --go_out=./ \
    --ruby_out="$RUBY_CLIENT_PATH" \
    --twirp_ruby_out="$RUBY_CLIENT_PATH" \
    ${ROOT_DIR}/proto/*.proto


printf " \033[32m✔︎\033[0m\n"