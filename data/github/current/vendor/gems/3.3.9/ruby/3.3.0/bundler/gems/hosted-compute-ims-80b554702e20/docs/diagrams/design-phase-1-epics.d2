direction: down

Legend: {
  notstarted: "Not Started"
  active: "In Progress"
  finished: "Finished"
  near: center-left
  notstarted -> active -> finished
}

epic0: "" {
  Description: |md
    # Epic 0 - Design and planning
    ### Scope:
    - Design IMS
    - Draft design for cross-service interaction
    - Prepare ADRs for internal processes
  |
}

epic1: "" {
  Description: |md
    # Epic 1 - Upload curated & custom images
    ### Scope:
    - Setup dev environment
    - Setup local database and aqueduct
    - Implement worker application
    - Implement promotion module
    - Add Unit Tests

    ### Outcome:
    IMS can promote curated and custom images<br/>
    (copy VHD and create gallery image version from vhd file)
  |
}

epic2: "" {
  Description: |md
    # Epic 2 - Implement API layer
    ### Scope:
    - Implement Images API for Curated and Custom images
    - Implement Admin API for Curated images
    - Add E2E tests

    ### Outcome:
    IMS has Images API and Admin API for Curated and Custom images
  |
}

epic3: "" {
  Description: |md
    # Epic 3 - Production infrastructure and deployment
    ### Scope:
    - Deploy Moda application
    - Setup deployment environments
    - Setup MySQL and Aqueduct dependencies
    - Setup Azure resources on productions

    ### Outcome:
    IMS is deployed on production and available inside GitHub network. <br/>
    Dotcom can render the list of images from IMS under FF
  |
}

epic4: "" {
  Description: |md
    # Epic 4 - Implement replication support
    ### Scope:
    - Support multiple regions
    - Add image replication to different regions
    - Add integration with GCAS / Runner
    - Add support for "Latest" image definitions
    - Add support for "Latest" image versions
    - Add support for images enablement via dotcom FFs

    Estimation: ~4 weeks

    ### Outcome:
    IMS can replicate images to different regions<br/>
    based on  Runner recommendations
  |
}

epic5: "" {
  Description: |md
    # Epic 5 - Prepare for Curated images integration
    ### Scope:
    - Implement internal API for Runner
    - Implement dotcom internal API for curated images
    - Implement IMS client in Runner service
    - Modify Runner to use IMS for test images under FF
    - Security review
    - Integrate IMS dev environment with dotcom codespace

    Estimation: ~4 weeks

    ### Outcome:
    As a result of this epic, we will be able to craete a new pool with<br/>
    special image from IMS on production in bbq-beets org.
    Runner service will call IMS service for all operations related to this pool.
  |
}

epic6: "" {
  Description: |md
    # Epic 6 - Migrate Larger Runners to use IMS for curated images
    ### Scope:
    - Update curated images deployment pipeline to upload images to IMS
    - Implement approach for safe migration of existing runners to use IMS
    - Migrate existing runners to use IMS
    - Revisit and setup monitors, playbooks, alerts and DRI shifts

    Estimation: ~3-4 weeks

    ### Outcome:
    Runner service uses IMS for all pools with curated images
  |
}

epic7: "" {
  Description: |md
    # Epic 7 - Migrate Larger Runners to use IMS for custom images
    ### Scope:
    - Implement images retention policies
    - Implement a Runner job for migrating existing custom images to IMS
    - Migrate existing custom images
    - Migrate existing runners to use IMS

    Estimation: ~3 weeks

    ### Outcome:
    Runner service uses IMS for all pools with custom images
  |
}

epic8: "" {
  Description: |md
    # Epic 8 - Migrate Larger Runners to use IMS for marketplace images
    ### Scope:
    - Implement support for marketplace images in IMS
        - Azure calls for Marketplace images
        - Database changes
        - API changes
    - Migrate existing runners to use IMS

    Estimation: ~3 weeks

    ### Outcome:
    Runner service uses IMS for all pools with marketplace images
  |
}

*.style.border-radius: 25
classes: {
  notstarted
  active: {
    style.fill: "#f7d658"
  }
  finished: {
    style.fill: "#b8ffc5"
  }
}

Legend.notstarted.class: notstarted
Legend.active.class: active
Legend.finished.class: finished
epic0.class: finished
epic1.class: finished
epic2.class: finished
epic3.class: finished
epic4.class: active
epic5.class: notstarted
epic6.class: notstarted
epic7.class: notstarted
epic8.class: notstarted

epic0 -> epic1
epic1 -> epic2
epic2 -> epic3
epic2 -> epic4
epic3 -> epic5
epic4 -> epic5
epic5 -> epic6
epic6 -> epic7
epic6 -> epic8
