						"locations": [
							{
								"uri": "file:///home/runner/.codeql/packages/github/test-extension-pack/0.0.1/",
								"description": {
									"text": "The QL pack root directory."
								}
							},
							{
								"uri": "file:///home/runner/.codeql/packages/github/test-extension-pack/0.0.1/codeql-pack.yml",
