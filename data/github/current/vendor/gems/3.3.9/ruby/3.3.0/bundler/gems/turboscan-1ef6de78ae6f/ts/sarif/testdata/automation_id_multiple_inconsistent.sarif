							"shortDescription": {
								"text": "Inconsistent action input"
							},
							"fullDescription": {
								"text": "If multiple actions define an input with the same name, then the input must be defined in an identical way to avoid confusion for the user. This also makes writing queries like required-action-input.ql easier."
