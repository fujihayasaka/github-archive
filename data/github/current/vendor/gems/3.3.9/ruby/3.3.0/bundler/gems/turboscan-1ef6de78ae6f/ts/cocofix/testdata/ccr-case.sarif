{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "ccr/generic-alert",
              "name": "ReviewOne",
              "shortDescription": {
                "text": "A problem found by Copilot Code Review"
              },
              "fullDescription": {
                "text": "A problem found by Copilot Code Review"
              }
            }
          ]
        }
      },
      "artifacts": [
        {
          "location": {
            "uri": "violation.rb"
          },
          "contents": {
            "text": "[1, 2, 3].each do |n| puts n end\nvalue = false\nif not value\nputs \"Value is false\"\nend"
          }
        }
      ],
      "results": [
        {
          "ruleId": "ccr/generic-alert",
          "rule": {
            "id": "ccr/generic-alert",
            "index": 0
          },
          "message": {
            "text": "A problem found by Copilot Code Review"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "violation.rb",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 1,
                  "endLine": 3,
                  "endColumn": 60
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
