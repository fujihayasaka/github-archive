    "configurations": [
        {
            "name": "Launch cli",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/cli/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "args": [
                "--query"
            ],
        },{
            "name": "Launch api",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/api/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
        },
        {
            "name": "Launch api timetravel",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/api/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "args": [
                "--timeTravel",
                "--timetravelDate=1789-03-18T09:00:00Z"
            ]
        },
        {
            "name": "Launch azure-emission",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/queue-worker/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "env": {
                "WORKER_TYPE":"azure-emission"
            }
        },
        {
            "name": "Launch emission-handler",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/queue-worker/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "env": {
                "WORKER_TYPE":"emission-handler"
            }
        },
        {
            "name": "Launch daily-job limited",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/queue-worker/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "env": {
                "WORKER_TYPE":"customer-daily-rollup"
            },
        },
        {
            "name": "Launch customer-monthly-job",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/queue-worker/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "env": {
                "WORKER_TYPE":"customer-monthly-rollup"
            },
        },
        {
            "name": "Launch usage-ingestion",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/queue-worker/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "env": {
                "WORKER_TYPE":"usage-ingestion"
            }
        },
        {
            "name": "Launch limited usage-ingestion",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/queue-worker/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "env": {
                "WORKER_TYPE":"usage-ingestion"
            },
        },
        {
            "name": "Launch test-producer",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/test-producer/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "args": [
                "--amount=10",
                "--customer_id=1",
                "--organization_id=4",
                "--repo_id=1",
                "--actor_id=2",
                "--days_span=0",
                "--hours_interval=1",
                "--timeTravel",
                "--timeTravelDate=2023-01-01T00:00:00Z",
            ]
        },
        {
            "name": "Launch invoice-generation",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/queue-worker/main.go",
            "envFile": "${workspaceFolder}/dev.vscode.env",
            "env": {
                "WORKER_TYPE":"invoice-generation"
            }
        },

        {
           "name": "Attach to Go Server",
           "type": "go",
           "request": "attach",
           "mode": "local",
           "remotePath": "${workspaceFolder}",
        },
        {
            "name": "Zero Out Quantities",
            "type": "go",
            "request": "launch",
            "mode": "debug",
