#!/bin/bash
set -eu
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
. "$DIR/ensure-devcontainer.sh"

go install github.com/simon-engledew/generate/cmd/schema-generate github.com/mailru/easyjson/easyjson

cd "$DIR/../"

rm -f ts/verify.go

echo "==> running go generate ..."
go generate ./...

echo "==> running go fmt ..."
go fmt ./...
