nt/template/attributes-order","shortDescription":{"text":"Ensures that HTML attributes and Angular bindings are sorted based on an expected order"}},{"id":"@typescript-eslint/brace-style","name":"@typescript-eslint/brace-style","shortDescription":{"text":"Enforce consistent brace style for blocks"}},{"id":"@typescript-eslint/explicit-function-return-type","name":"@typescript-eslint/explicit-function-return-type","shortDescription":{"text":"Require explicit return types on functions and class methods"}},{"id":"@typescript-eslint/explicit-member-accessibility","name":"@typescript-eslint/explicit-member-accessibility","shortDescription":{"text":"Require explicit accessibility modifiers on class properties and methods"}},{"id":"@typescript-eslint/explicit-module-boundary-types","name":"@typescript-eslint/explicit-module-boundary-types","shortDescription":{"text":"Require explicit return and argument types on exported functions' and classes' public class methods"}},{"id":"@typescript-eslint/func-call-spacing","name":"@typescript-eslint/func-call-spacing","shortDescription":{"text":"Require or disallow spacing between function identifiers and their invocations"}},{"id":"@typescript-eslint/lines-between-class-members","name":"@typescript-eslint/lines-between-class-members","shortDescription":{"text":"Require or disallow an empty line between class members"}},{"id":"@typescript-eslint/no-empty-function","name":"@typescript-eslint/no-empty-function","shortDescription":{"text":"Disallow empty functions"}},{"id":"@typescript-eslint/no-extra-semi","name":"@typescript-eslint/no-extra-semi","shortDescription":{"text":"Disallow unnecessary semicolons"}},{"id":"@typescript-eslint/no-non-null-assertion","name":"@typescript-eslint/no-non-null-assertion","shortDescription":{"text":"Disallow non-null assertions using the `!` postfix operator"}},{"id":"@typescript-eslint/no-shadow","name":"@typescript-eslint/no-shadow","shortDescription":{"text":"Disallow variable declarations from shadowing variables declared in the outer scope"}},{"id":"@typescript-eslint/no-unnecessary-type-assertion","name":"@typescript-eslint/no-unnecessary-type-assertion","shortDescription":{"text":"Disallow type assertions that do not change the type of an expression"}},{"id":"@typescript-eslint/no-use-before-define","name":"@typescript-eslint/no-use-before-define","shortDescription":{"text":"Disallow the use of variables before they are defined"}},{"id":"@typescript-eslint/no-var-requires","name":"@typescript-eslint/no-var-requires","shortDescription":{"text":"Disallow `require` statements except in import statements"}},{"id":"@typescript-eslint/prefer-promise-reject-errors","name":"@typescript-eslint/prefer-promise-reject-errors","shortDescription":{"text":"Require using Error objects as Promise rejection reasons"}},{"id":"@typescript-eslint/restrict-template-expressions","name":"@typescript-eslint/restrict-template-expressions","shortDescription":{"text":"Enforce template literal expressions to be of `string` type"}},{"id":"@typescript-eslint/semi","name":"@typescript-eslint/semi","shortDescription":{"text":"Require or disallow semicolons instead of ASI"}},{"id":"brace-style","name":"brace-style","shortDescription":{"text":"Enforce consistent brace style for blocks"}},{"id":"camelcase","name":"camelcase","shortDescription":{"text":"Enforce camelcase naming convention"}},{"id":"eqeqeq","name":"eqeqeq","shortDescription":{"text":"Require the use of `===` and `!==`"}},{"id":"functional/immutable-data","name":"functional/immutable-data","shortDescription":{"text":"Enforce treating data as immutable."}},{"id":"global-require","name":"global-require","shortDescription":{"text":"Require `require()` calls to be placed at top-level module scope"}},{"id":"import/export","name":"import/export","shortDescription":{"text":"Forbid any invalid exports, i.e. re-export of the same name."}},{"id":"import/first","name":"import/first","shortDescription":{"text":"Ensure all imports appear before other statements."}},{"id":"import/no-cycle","name":"import/no-cycle","shortDescription":{"text":"Forbid a module from importing a module with a dependency path back to itself."}},{"id":"import/no-unresolved","name":"import/no-unresolved","shortDescription":{"text":"Ensure imports point to a file/module that can be resolved."}},{"id":"import/prefer-default-export","name":"import/prefer-default-export","shortDescription":{"text":"Prefer a default export if module exports a single name or multiple names."}},{"id":"jest/no-disabled-tests","name":"jest/no-disabled-tests","shortDescription":{"text":"Disallow disabled tests"}},{"id":"jest/padding-around-all","name":"jest/padding-around-all","shortDescription":{"text":"Enforce padding around Jest functions"}},{"id":"jest/padding-around-expect-groups","name":"jest/padding-around-expect-groups","shortDescription":{"text":"Enforce padding around `expect` groups"}},{"id":"multiline-comment-style","name":"multiline-comment-style","shortDescription":{"text":"Enforce a particular style for multiline comments"}},{"id":"n/no-unsupported-features/es-builtins","name":"n/no-unsupported-features/es-builtins","shortDescription":{"text":"disallow unsupported ECMAScript built-ins on the specified version"}},{"id":"no-restricted-syntax","name":"no-restricted-syntax","shortDescription":{"text":"Disallow specified syntax"}},{"id":"no-underscore-dangle","name":"no-underscore-dangle","shortDescription":{"text":"Disallow dangling underscores in identifiers"}},{"id":"no-use-before-define","name":"no-use-before-define","shortDescription":{"text":"Disallow the use of variables before they are defined"}},{"id":"prefer-const","name":"prefer-const","shortDescription":{"text":"Require `const` declarations for variables that are never reassigned after declared"}},{"id":"prefer-template","name":"prefer-template","shortDescription":{"text":"Require template literals instead of string concatenation"}},{"id":"prettier/prettier","name":"prettier/prettier","shortDescription":{"text":"Ensure code is properly formatted, use insertion, deletion, or replacement to obtain desired formatting."}},{"id":"react/prop-types","name":"react/prop-types","shortDescription":{"text":"Disallow missing props validation in a React component definition"}},{"id":"security/detect-non-literal-fs-filename","name":"security/detect-non-literal-fs-filename","shortDescription":{"text":"Detects variable in filename argument of \"fs\" calls, which might allow an attacker to access anything on your system."}},{"id":"space-before-blocks","name":"space-before-blocks","shortDescription":{"text":"Enforce consistent spacing before blocks"}},{"id":"space-infix-ops","name":"space-infix-ops","shortDescription":{"text":"Require spacing around infix operators"}},{"id":"unicorn/consistent-destructuring","name":"unicorn/consistent-destructuring","shortDescription":{"text":"Use destructured variables over properties."}}]}}}]}