{"$schema":"","version":"2.1.0","runs":[{"tool":{"driver":{"name":"ESLint","rules":[{"id":"constructor-super","name":"constructor-super","shortDescription":{"text":"Require `super()` calls in constructors"}},{"id":"for-direction","name":"for-direction","shortDescription":{"text":"Enforce \"for\" loop update clause moving the counter in the right direction"}},{"id":"getter-return","name":"getter-return","shortDescription":{"text":"Enforce `return` statements in getters"}},{"id":"no-async-promise-executor","name":"no-async-promise-executor","shortDescription":{"text":"Disallow using an async function as a Promise executor"}},{"id":"no-case-declarations","name":"no-case-declarations","shortDescription":{"text":"Disallow lexical declarations in case clauses"}},{"id":"no-class-assign","name":"no-class-assign","shortDescription":{"text":"Disallow reassigning class members"}},{"id":"no-compare-neg-zero","name":"no-compare-neg-zero","shortDescription":{"text":"Disallow comparing against -0"}},{"id":"no-cond-assign","name":"no-cond-assign","shortDescription":{"text":"Disallow assignment operators in conditional expressions"}},{"id":"no-const-assign","name":"no-const-assign","shortDescription":{"text":"Disallow reassigning `const` variables"}},{"id":"no-constant-binary-expression","name":"no-constant-binary-expression","shortDescription":{"text":"Disallow expressions where the operation doesn't affect the value"}},{"id":"no-constant-condition","name":"no-constant-condition","shortDescription":{"text":"Disallow constant expressions in conditions"}},{"id":"no-control-regex","name":"no-control-regex","shortDescription":{"text":"Disallow control characters in regular expressions"}},{"id":"no-debugger","name":"no-debugger","shortDescription":{"text":"Disallow the use of `debugger`"}},{"id":"no-delete-var","name":"no-delete-var","shortDescription":{"text":"Disallow deleting variables"}},{"id":"no-dupe-args","name":"no-dupe-args","shortDescription":{"text":"Disallow duplicate arguments in `function` definitions"}},{"id":"no-dupe-class-members","name":"no-dupe-class-members","shortDescription":{"text":"Disallow duplicate class members"}},{"id":"no-dupe-else-if","name":"no-dupe-else-if","shortDescription":{"text":"Disallow duplicate conditions in if-else-if chains"}},{"id":"no-dupe-keys","name":"no-dupe-keys","shortDescription":{"text":"Disallow duplicate keys in object literals"}},{"id":"no-duplicate-case","name":"no-duplicate-case","shortDescription":{"text":"Disallow duplicate case labels"}},{"id":"no-empty","name":"no-empty","shortDescription":{"text":"Disallow empty block statements"}},{"id":"no-empty-character-class","name":"no-empty-character-class","shortDescription":{"text":"Disallow empty character classes in regular expressions"}},{"id":"no-empty-pattern","name":"no-empty-pattern","shortDescription":{"text":"Disallow empty destructuring patterns"}},{"id":"no-empty-static-block","name":"no-empty-static-block","shortDescription":{"text":"Disallow empty static blocks"}},{"id":"no-ex-assign","name":"no-ex-assign","shortDescription":{"text":"Disallow reassigning exceptions in `catch` clauses"}},{"id":"no-extra-boolean-cast","name":"no-extra-boolean-cast","shortDescription":{"text":"Disallow unnecessary boolean casts"}},{"id":"no-fallthrough","name":"no-fallthrough","shortDescription":{"text":"Disallow fallthrough of `case` statements"}},{"id":"no-func-assign","name":"no-func-assign","shortDescription":{"text":"Disallow reassigning `function` declarations"}},{"id":"no-global-assign","name":"no-global-assign","shortDescription":{"text":"Disallow assignments to native objects or read-only global variables"}},{"id":"no-import-assign","name":"no-import-assign","shortDescription":{"text":"Disallow assigning to imported bindings"}},{"id":"no-invalid-regexp","name":"no-invalid-regexp","shortDescription":{"text":"Disallow invalid regular expression strings in `RegExp` constructors"}},{"id":"no-irregular-whitespace","name":"no-irregular-whitespace","shortDescription":{"text":"Disallow irregular whitespace"}},{"id":"no-loss-of-precision","name":"no-loss-of-precision","shortDescription":{"text":"Disallow literal numbers that lose precision"}},{"id":"no-misleading-character-class","name":"no-misleading-character-class","shortDescription":{"text":"Disallow characters which are made with multiple code points in character class syntax"}},{"id":"no-new-native-nonconstructor","name":"no-new-native-nonconstructor","shortDescription":{"text":"Disallow `new` operators with global non-constructor functions"}},{"id":"no-nonoctal-decimal-escape","name":"no-nonoctal-decimal-escape","shortDescription":{"text":"Disallow `\\8` and `\\9` escape sequences in string literals"}},{"id":"no-obj-calls","name":"no-obj-calls","shortDescription":{"text":"Disallow calling global object properties as functions"}},{"id":"no-octal","name":"no-octal","shortDescription":{"text":"Disallow octal literals"}},{"id":"no-prototype-builtins","name":"no-prototype-builtins","shortDescription":{"text":"Disallow calling some `Object.prototype` methods directly on objects"}},{"id":"no-redeclare","name":"no-redeclare","shortDescription":{"text":"Disallow variable redeclaration"}},{"id":"no-regex-spaces","name":"no-regex-spaces","shortDescription":{"text":"Disallow multiple spaces in regular expressions"}},{"id":"no-self-assign","name":"no-self-assign","shortDescription":{"text":"Disallow assignments where both sides are exactly the same"}},{"id":"no-setter-return","name":"no-setter-return","shortDescription":{"text":"Disallow returning values from setters"}},{"id":"no-shadow-restricted-names","name":"no-shadow-restricted-names","shortDescription":{"text":"Disallow identifiers from shadowing restricted names"}},{"id":"no-sparse-arrays","name":"no-sparse-arrays","shortDescription":{"text":"Disallow sparse arrays"}},{"id":"no-this-before-super","name":"no-this-before-super","shortDescription":{"text":"Disallow `this`/`super` before calling `super()` in constructors"}},{"id":"no-undef","name":"no-undef","shortDescription":{"text":"Disallow the use of undeclared variables unless mentioned in `/*global */` comments"}},{"id":"no-unexpected-multiline","name":"no-unexpected-multiline","shortDescription":{"text":"Disallow confusing multiline expressions"}},{"id":"no-unreachable","name":"no-unreachable","shortDescription":{"text":"Disallow unreachable code after `return`, `throw`, `continue`, and `break` statements"}},{"id":"no-unsafe-finally","name":"no-unsafe-finally","shortDescription":{"text":"Disallow control flow statements in `finally` blocks"}},{"id":"no-unsafe-negation","name":"no-unsafe-negation","shortDescription":{"text":"Disallow negating the left operand of relational operators"}},{"id":"no-unsafe-optional-chaining","name":"no-unsafe-optional-chaining","shortDescription":{"text":"Disallow use of optional chaining in contexts where the `undefined` value is not allowed"}},{"id":"no-unused-labels","name":"no-unused-labels","shortDescription":{"text":"Disallow unused labels"}},{"id":"no-unused-private-class-members","name":"no-unused-private-class-members","shortDescription":{"text":"Disallow unused private class members"}},{"id":"no-unused-vars","name":"no-unused-vars","shortDescription":{"text":"Disallow unused variables"}},{"id":"no-useless-backreference","name":"no-useless-backreference","shortDescription":{"text":"Disallow useless backreferences in regular expressions"}},{"id":"no-useless-catch","name":"no-useless-catch","shortDescription":{"text":"Disallow unnecessary `catch` clauses"}},{"id":"no-useless-escape","name":"no-useless-escape","shortDescription":{"text":"Disallow unnecessary escape characters"}},{"id":"no-with","name":"no-with","shortDescription":{"text":"Disallow `with` statements"}},{"id":"require-yield","name":"require-yield","shortDescription":{"text":"Require generator functions to contain `yield`"}},{"id":"use-isnan","name":"use-isnan","shortDescription":{"text":"Require calls to `isNaN()` when