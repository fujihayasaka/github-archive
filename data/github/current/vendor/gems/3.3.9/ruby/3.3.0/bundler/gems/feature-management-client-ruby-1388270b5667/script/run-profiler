#!/bin/bash

set -euo pipefail

root="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null 2>&1 && pwd )"
cd "$root"

echo "-------------------------------------------------------"
echo "Running profiler for common vexi operations"
echo "-------------------------------------------------------"

ruby -I $root/generated/vexi/lib $root/benchmark/profiles/vexi_with_in_memory_adapter_only.rb
