#!/usr/bin/env bash
set -e

if [[ ! $CODESPACE_NAME == *"github-github"* ]]; then
    echo "This script should only be run if you are developing on your local machine. All setup is built in if using a codepsace."
    read -p "Do you want to continue? y/n" -n 1 -r
    echo    # (optional) move to a new line
    if [[ ! $REPLY =~ ^[Yy]$ ]]
    then
        exit 1
    fi
fi

echo "Setting up usage-ingestion for development"

echo "- Installing tools"
make tools

echo "- Building"
make build

echo
echo "All set! Next steps:"
echo "- make - to run code generation, build, and test"
echo "- make test - to run the tests"
echo "- script/server - to run the server"
