{
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "[go]": {
    "editor.formatOnSave": true,
  },
  "go.toolsEnvVars": {
    "GOFLAGS": "-tags=integration",
  },
  "go.testFlags": ["-v", "-test.timeout", "0", "-count=1"],
  "go.testEnvFile": "${workspaceFolder}/dev.vscode.env",
  "jest.enable": false,
}
