{
  "name": "licensify",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/github/features/goproxy:1": {},
    "ghcr.io/devcontainers/features/azure-cli": {},
    "ghcr.io/devcontainers/features/docker-in-docker": {},
    "ghcr.io/devcontainers/features/ruby:1": {
      "version": "3.3.2"
    },
    "ghcr.io/devcontainers/features/go": {
      "golangciLintVersion": "latest"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/github/features/dev-vpn:1": {},
    "ghcr.io/github/features/go-linter:1": {}
  },
  "forwardPorts": [
    12345
  ],
  "hostRequirements": {
    "cpus": 32,
    "memory": "64gb",
    "storage": "128gb"
  },
  "remoteEnv": {
    "TFENV_TERRAFORM_VERSION": "1.4.4"
  },
  "onCreateCommand": "/workspaces/licensify/.devcontainer/scripts/onCreateCommand.sh",
  "postAttachCommand": "/workspaces/licensify/.devcontainer/scripts/postAttachCommand.sh",
  "postCreateCommand": "/workspaces/licensify/.devcontainer/scripts/postCreateCommand.sh",
  "postStartCommand": "/workspaces/licensify/.devcontainer/scripts/postStartCommand.sh",
  "customizations": {
    "codespaces": {
      "repositories": {
        "github/go-linter": {
          "permissions": {
              "contents": "read",
              "packages": "read"
          }
        },
        "github/features": {
          "permissions": {
              "contents": "read",
              "packages": "read"
          }
        },
        "github/*": {
          "permissions": "read-all"
        }
      }
    },
    "vscode": {
      "extensions": [
        "golang.Go",
        "zxh404.vscode-proto3",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "GitHub.Copilot",
        "github.codespaces",
        "ms-azuretools.vscode-azureterraform"
      ]
    }
  }
}