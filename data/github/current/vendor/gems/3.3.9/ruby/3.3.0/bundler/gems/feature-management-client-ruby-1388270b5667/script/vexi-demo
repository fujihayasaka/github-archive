#!/bin/bash

set -euo pipefail

root="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null 2>&1 && pwd )"
cd "$root"

echo "-------------------"
echo "Running demo"
echo ""

echo "Running demo with vexi-development code"
ruby -I $root/vexi/lib $root/examples/demo.rb

echo "Running demo with vexi generated code"
ruby -I $root/generated/vexi/lib $root/examples/demo.rb
