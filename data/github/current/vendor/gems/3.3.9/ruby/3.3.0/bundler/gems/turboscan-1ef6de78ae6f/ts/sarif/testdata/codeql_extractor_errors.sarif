{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "organization": "GitHub",
          "semanticVersion": "2.15.1",
          "notifications": [
            {
              "id": "py/diagnostics/syntax-error",
              "name": "py/diagnostics/syntax-error",
              "shortDescription": {
                "text": "Could not process some files due to syntax errors"
              },
              "fullDescription": {
                "text": "Could not process some files due to syntax errors"
              },
              "defaultConfiguration": {
                "enabled": true
              },
              "properties": {}
            },
            {
              "id": "py/diagnostics/warning",
              "name": "py/diagnostics/warning",
              "shortDescription": {
                "text": "Warning message"
              },
              "fullDescription": {
                "text": "Warning message"
              },
              "defaultConfiguration": {
                "enabled": true
              },
              "properties": {}
            },
            {
              "id": "py/diagnostics/no-message",
              "name": "py/diagnostics/no-message",
              "shortDescription": {
                "text": "Notification with no message"
              },
              "fullDescription": {
                "text": "Notification with no message"
              },
              "defaultConfiguration": {
                "enabled": true
              },
              "properties": {}
            },
            {
              "id": "html/diagnostics/warning",
              "name": "html/diagnostics/warning",
              "shortDescription": {
                "text": "Warning message"
              },
              "fullDescription": {
                "text": "Warning message"
              },
              "defaultConfiguration": {
                "enabled": true
              },
              "properties": {
                "tags": [
                  "expected-extracted-files"
                ]
              }
            },
            {
              "id": "py/diagnostics/successfully-extracted-files",
              "name": "py/diagnostics/successfully-extracted-files",
              "shortDescription": {
                "text": "Successfully extracted files"
              },
              "fullDescription": {
                "text": "Lists all files in the source code directory that were extracted without encountering an error in the file."
              },
              "defaultConfiguration": {
                "enabled": true
              },
              "properties": {
                "tags": [
                  "successfully-extracted-files"
                ],
                "description": "Lists all files in the source code directory that were extracted without encountering an error in the file.",
                "id": "py/diagnostics/successfully-extracted-files",
                "kind": "diagnostic",
                "name": "Successfully extracted files"
              }
            },
            {
              "id": "py/diagnostics/expected-extracted-files",
              "name": "py/diagnostics/expected-extracted-files",
              "shortDescription": {
                "text": "Expected extracted files"
              },
              "fullDescription": {
                "text": "Files appearing in the source archive that are expected to be extracted."
              },
              "defaultConfiguration": {
                "enabled": true
              },
              "properties": {
                "tags": [
                  "expected-extracted-files",
                  "telemetry"
                ]
              }
            }
          ],
          "rules": []
        }
      },
