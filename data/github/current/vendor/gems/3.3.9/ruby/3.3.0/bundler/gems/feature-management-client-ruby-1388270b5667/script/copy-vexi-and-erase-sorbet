#!/bin/bash

set -euo pipefail

# Copy all .rb files from vexi/ to generated/vexi/
find vexi -name "*.rb" -exec cp --parents \{\} generated/ \;

# Replace 'require "sorbet-runtime"' with a blank newline in all .rb files
find generated -name "*.rb" -exec sed -i '/require "sorbet-runtime"/c\\' {} \;

bundle exec sorbet-eraser 'generated/**/*.rb'