{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "ruby",
  "packages": {
    "vexi": {
      "package-name": "vexi",
      "version-file": "lib/vexi/version.rb"
    },
    "vexi_management": {
      "package-name": "vexi_management",
      "version-file": "lib/vexi_management/version.rb"
    }
  },
  "bump-patch-for-minor-pre-major": true,
  "bump-minor-pre-major": true,
  "separate-pull-requests": true,
  "plugins": [
    {
      "type": "sentence-case"
    }
  ]
}