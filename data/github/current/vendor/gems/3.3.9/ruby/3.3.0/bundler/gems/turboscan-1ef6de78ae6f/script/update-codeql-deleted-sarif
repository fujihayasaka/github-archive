#!/bin/bash

# This script adds newly deleted CodeQL SARIF rules to
# ts/sarif/ruledata/codeql-deleted.sarif. To use this script, copy the new
# CodeQL SARIF rules into ts/sarif/ruledata/codeql.sarif and run this script.
# It will compare codeql.sarif in the local checkout with the version in main
# and add deleted rules into codeql-deleted.sarif as needed.

set -euo pipefail

set -eu
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
. "$DIR/ensure-devcontainer.sh"

go run ./cmd/ruledel
