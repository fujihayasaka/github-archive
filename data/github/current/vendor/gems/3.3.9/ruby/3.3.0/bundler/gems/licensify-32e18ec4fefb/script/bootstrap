#!/bin/bash
# Usage: script/bootstrap
set -e

cd "$(dirname "$0")/.."

script/set-remote

source dev.env
script/build

if [[ "$GITHUB_REPOSITORY" == "github/github" ]]; then
    echo "Skipping aqueduct-lite and kafka-lite. Dotcom aqueduct-lite and kafka-lite are used instead."
    echo "Make sure that dotcom script/server is running"
    exit 0
fi

script/dc up -d "$@"