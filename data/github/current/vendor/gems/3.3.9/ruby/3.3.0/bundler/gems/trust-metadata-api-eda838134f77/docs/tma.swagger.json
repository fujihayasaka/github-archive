      "description": "Fields: payload, payloadType, signatures",
      "type": "object",
      "title": "An authenticated message of arbitrary type.",
      "properties": {
        "payload": {
          "type": "string",
          "format": "byte",
          "title": "Message to be signed. (In JSON, this is encoded as base64.) REQUIRED."
        },
        "payloadType": {
          "type": "string",
          "title": "String unambiguously identifying how to interpret payload. REQUIRED."
        },
        "signatures": {
          "type": "array",
          "title": "Signature over: PAE(type, payload) Where PAE is defined as: PAE(type, payload) = \"DSSEv1\" + SP + LEN(type) + SP + type + SP + LEN(payload) + SP + payload +               = concatenation SP              = ASCII space [0x20] \"DSSEv1\"        = ASCII [0x44, 0x53, 0x53, 0x45, 0x76, 0x31] LEN(s)          = ASCII decimal encoding of the byte length of s, with no leading zeros REQUIRED (length \u003e= 1).",
          "items": {
            "$ref": "#/definitions/io.intoto.Signature"
          }
        }
      }
    },
