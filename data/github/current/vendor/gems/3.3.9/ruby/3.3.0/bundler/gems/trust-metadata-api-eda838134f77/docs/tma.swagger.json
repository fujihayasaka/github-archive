  "definitions": {
    "dev.sigstore.bundle.v1.Bundle": {
      "description": "Fields: mediaType, verificationMaterial, messageSignature, dsseEnvelope",
      "type": "object",
      "properties": {
        "dsseEnvelope": {
          "title": "A DSSE envelope can contain arbitrary payloads. Verifiers must verify that the payload type is a supported and expected type. This is part of the DSSE protocol which is defined here: \u003chttps://github.com/secure-systems-lab/dsse/blob/master/protocol.md\u003e",
          "$ref": "#/definitions/io.intoto.Envelope"
        },
        "mediaType": {
          "type": "string",
          "title": "MUST be application/vnd.dev.sigstore.bundle.v0.3+json when when encoded as JSON. Clients must to be able to accept media type using the previously defined formats: * application/vnd.dev.sigstore.bundle+json;version=0.1 * application/vnd.dev.sigstore.bundle+json;version=0.2 * application/vnd.dev.sigstore.bundle+json;version=0.3"
        },
        "messageSignature": {
          "$ref": "#/definitions/dev.sigstore.common.v1.MessageSignature"
        },
        "verificationMaterial": {
          "title": "When a signer is identified by a X.509 certificate, a verifier MUST verify that the signature was computed at the time the certificate was valid as described in the Sigstore client spec: \"Verification using a Bundle\". \u003chttps://docs.google.com/document/d/1kbhK2qyPPk8SLavHzYSDM8-Ueul9_oxIMVFuWMWKz0E/edit#heading=h.x8bduppe89ln\u003e If the verification material contains a public key identifier (key hint) and the `content` is a DSSE envelope, the key hints MUST be exactly the same in the verification material and in the DSSE envelope.",
          "$ref": "#/definitions/dev.sigstore.bundle.v1.VerificationMaterial"
        }
      }
    },
    "dev.sigstore.bundle.v1.TimestampVerificationData": {
      "description": "Fields: rfc3161Timestamps",
      "type": "object",
      "title": "Various timestamped counter signatures over the artifacts signature. Currently only RFC3161 signatures are provided. More formats may be added in the future.",
      "properties": {
        "rfc3161Timestamps": {
          "type": "array",
          "title": "A list of RFC3161 signed timestamps provided by the user. This can be used when the entry has not been stored on a transparency log, or in conjunction for a stronger trust model. Clients MUST verify the hashed message in the message imprint against the signature in the bundle.",
          "items": {
            "$ref": "#/definitions/dev.sigstore.common.v1.RFC3161SignedTimestamp"
          }
        }
      }
    },
    "dev.sigstore.bundle.v1.VerificationMaterial": {
      "description": "Fields: tlogEntries, timestampVerificationData, publicKey, x509CertificateChain, certificate",
      "type": "object",
      "title": "VerificationMaterial captures details on the materials used to verify signatures. This message may be embedded in a DSSE envelope as a signature extension. Specifically, the `ext` field of the extension will expect this message when the signature extension is for Sigstore. This is identified by the `kind` field in the extension, which must be set to application/vnd.dev.sigstore.verificationmaterial;version=0.1 for Sigstore. When used as a DSSE extension, if the `public_key` field is used to indicate the key identifier, it MUST match the `keyid` field of the signature the extension is attached to.",
      "properties": {
        "certificate": {
          "$ref": "#/definitions/dev.sigstore.common.v1.X509Certificate"
        },
        "publicKey": {
          "$ref": "#/definitions/dev.sigstore.common.v1.PublicKeyIdentifier"
        },
        "timestampVerificationData": {
          "title": "Timestamp may also come from tlog_entries.inclusion_promise.signed_entry_timestamp.",
          "$ref": "#/definitions/dev.sigstore.bundle.v1.TimestampVerificationData"
        },
        "tlogEntries": {
          "type": "array",
          "title": "An inclusion proof and an optional signed timestamp from the log. Client verification libraries MAY provide an option to support v0.1 bundles for backwards compatibility, which may contain an inclusion promise and not an inclusion proof. In this case, the client MUST validate the promise. Verifiers SHOULD NOT allow v0.1 bundles if they're used in an ecosystem which never produced them.",
          "items": {
            "$ref": "#/definitions/dev.sigstore.rekor.v1.TransparencyLogEntry"
          }
        },
        "x509CertificateChain": {
          "$ref": "#/definitions/dev.sigstore.common.v1.X509CertificateChain"
        }
      }
    },
    "dev.sigstore.common.v1.DistinguishedName": {
      "description": "Fields: organization, commonName",
      "type": "object",
      "properties": {
        "commonName": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        }
      }
    },
    "dev.sigstore.common.v1.HashOutput": {
      "description": "Fields: algorithm, digest",
      "type": "object",
      "title": "HashOutput captures a digest of a 'message' (generic octet sequence) and the corresponding hash algorithm used.",
      "properties": {
        "algorithm": {
          "$ref": "#/definitions/dev.sigstore.common.v1.HashAlgorithm"
        },
        "digest": {
          "type": "string",
          "format": "byte",
          "title": "This is the raw octets of the message digest as computed by the hash algorithm."
        }
      }
    },
    "dev.sigstore.common.v1.LogId": {
      "description": "Fields: keyId",
      "type": "object",
      "title": "LogId captures the identity of a transparency log.",
      "properties": {
        "keyId": {
          "type": "string",
          "format": "byte",
          "title": "The unique id of the log, represented as the SHA-256 hash of the log's public key, calculated over the DER encoding of the key represented as SubjectPublicKeyInfo. See https://www.rfc-editor.org/rfc/rfc6962#section-3.2"
        }
      }
    },
    "dev.sigstore.common.v1.MessageSignature": {
      "description": "Fields: messageDigest, signature",
      "type": "object",
      "title": "MessageSignature stores the computed signature over a message.",
      "properties": {
        "messageDigest": {
          "title": "Message digest can be used to identify the artifact. Clients MUST NOT attempt to use this digest to verify the associated signature; it is intended solely for identification.",
          "$ref": "#/definitions/dev.sigstore.common.v1.HashOutput"
        },
        "signature": {
          "type": "string",
          "format": "byte",
          "title": "The raw bytes as returned from the signature algorithm. The signature algorithm (and so the format of the signature bytes) are determined by the contents of the 'verification_material', either a key-pair or a certificate. If using a certificate, the certificate contains the required information on the signature algorithm. When using a key pair, the algorithm MUST be part of the public key, which MUST be communicated out-of-band."
        }
      }
    },
    "dev.sigstore.common.v1.ObjectIdentifier": {
      "description": "Fields: id",
      "type": "object",
      "title": "An ASN.1 OBJECT IDENTIFIER",
      "properties": {
        "id": {
          "type": "array",
          "format": "int32",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "dev.sigstore.common.v1.ObjectIdentifierValuePair": {
      "description": "Fields: oid, value",
      "type": "object",
      "title": "An OID and the corresponding (byte) value.",
      "properties": {
        "oid": {
          "$ref": "#/definitions/dev.sigstore.common.v1.ObjectIdentifier"
        },
        "value": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "dev.sigstore.common.v1.PublicKey": {
      "description": "Fields: rawBytes, keyDetails, validFor",
      "type": "object",
      "properties": {
        "keyDetails": {
          "title": "Key encoding and signature algorithm to use for this key.",
          "$ref": "#/definitions/dev.sigstore.common.v1.PublicKeyDetails"
        },
        "rawBytes": {
          "type": "string",
          "format": "byte",
          "title": "DER-encoded public key, encoding method is specified by the key_details attribute."
        },
        "validFor": {
          "title": "Optional validity period for this key, *inclusive* of the endpoints.",
          "$ref": "#/definitions/dev.sigstore.common.v1.TimeRange"
        }
      }
    },
    "dev.sigstore.common.v1.PublicKeyIdentifier": {
      "description": "Fields: hint",
      "type": "object",
      "title": "PublicKeyIdentifier can be used to identify an (out of band) delivered key, to verify a signature.",
      "properties": {
        "hint": {
          "type": "string",
          "title": "Optional unauthenticated hint on which key to use. The format of the hint must be agreed upon out of band by the signer and the verifiers, and so is not subject to this specification. Example use-case is to specify the public key to use, from a trusted key-ring. Implementors are RECOMMENDED to derive the value from the public key as described in RFC 6962. See: \u003chttps://www.rfc-editor.org/rfc/rfc6962#section-3.2\u003e"
        }
      }
    },
    "dev.sigstore.common.v1.RFC3161SignedTimestamp": {
      "description": "Fields: signedTimestamp",
      "type": "object",
      "title": "This message holds a RFC 3161 timestamp.",
      "properties": {
        "signedTimestamp": {
          "type": "string",
          "format": "byte",
          "title": "Signed timestamp is the DER encoded TimeStampResponse. See https://www.rfc-editor.org/rfc/rfc3161.html#section-2.4.2"
        }
      }
    },
    "dev.sigstore.common.v1.SubjectAlternativeName": {
      "description": "Fields: type, regexp, value",
      "type": "object",
      "properties": {
        "regexp": {
          "type": "string",
          "title": "A regular expression describing the expected value for the SAN."
        },
        "type": {
          "$ref": "#/definitions/dev.sigstore.common.v1.SubjectAlternativeNameType"
        },
        "value": {
          "type": "string",
          "title": "The exact value to match against."
        }
      }
    },
    "dev.sigstore.common.v1.TimeRange": {
      "description": "Fields: start, end",
      "type": "object",
      "title": "The time range is closed and includes both the start and end times, (i.e., [start, end]). End is optional to be able to capture a period that has started but has no known end.",
      "properties": {
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "start": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "dev.sigstore.common.v1.X509Certificate": {
      "description": "Fields: rawBytes",
      "type": "object",
      "properties": {
        "rawBytes": {
          "type": "string",
          "format": "byte",
          "title": "DER-encoded X.509 certificate."
        }
      }
    },
    "dev.sigstore.common.v1.X509CertificateChain": {
      "description": "This \"chain\" can be used in multiple contexts, such as providing a root CA\ncertificate within a TUF root of trust or multiple untrusted certificates for\nthe purpose of chain building.\n\nFields: certificates",
      "type": "object",
      "title": "A collection of X.509 certificates.",
      "properties": {
        "certificates": {
          "description": "In some contexts (such as `VerificationMaterial.x509_certificate_chain`), this sequence\nhas an imposed order. Unless explicitly specified, there is otherwise no\nguaranteed order.",
          "type": "array",
          "title": "One or more DER-encoded certificates.",
          "items": {
            "$ref": "#/definitions/dev.sigstore.common.v1.X509Certificate"
          }
        }
      }
    },
    "dev.sigstore.rekor.v1.Checkpoint": {
      "description": "Fields: envelope",
      "type": "object",
      "title": "The checkpoint MUST contain a signature of the tree head (root hash), size of the tree and the transparency log's unique identifier (log ID). It MAY also be followed by any optional data. The result is a string, the format is described here https://github.com/transparency-dev/formats/blob/main/log/README.md The details are here https://github.com/sigstore/rekor/blob/a6e58f72b6b18cc06cefe61808efd562b9726330/pkg/util/signed_note.go#L114 The signature has the same format as InclusionPromise.signed_entry_timestamp. See below for more details.",
      "properties": {
        "envelope": {
          "type": "string"
        }
      }
    },
    "dev.sigstore.rekor.v1.InclusionPromise": {
      "description": "Fields: signedEntryTimestamp",
      "type": "object",
      "title": "The inclusion promise is calculated by Rekor. It's calculated as a signature over a canonical JSON serialization of the persisted entry, the log ID, log index and the integration timestamp. See https://github.com/sigstore/rekor/blob/a6e58f72b6b18cc06cefe61808efd562b9726330/pkg/api/entries.go#L54 The format of the signature depends on the transparency log's public key. If the signature algorithm requires a hash function and/or a signature scheme (e.g. RSA) those has to be retrieved out-of-band from the log's operators, together with the public key. This is used to verify the integration timestamp's value and that the log has promised to include the entry.",
      "properties": {
        "signedEntryTimestamp": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "dev.sigstore.rekor.v1.InclusionProof": {
      "description": "Fields: logIndex, rootHash, treeSize, hashes, checkpoint",
      "type": "object",
      "title": "InclusionProof is the proof returned from the transparency log. Can be used for offline or online verification against the log.",
      "properties": {
        "checkpoint": {
          "title": "Signature of the tree head, as of the time of this proof was generated. See above info on 'Checkpoint' for more details.",
          "$ref": "#/definitions/dev.sigstore.rekor.v1.Checkpoint"
        },
        "hashes": {
          "type": "array",
          "format": "byte",
          "title": "A list of hashes required to compute the inclusion proof, sorted in order from leaf to root. Note that leaf and root hashes are not included. The root hash is available separately in this message, and the leaf hash should be calculated by the client.",
          "items": {
            "type": "string"
          }
        },
        "logIndex": {
          "type": "string",
          "format": "int64",
          "title": "The index of the entry in the tree it was written to."
        },
        "rootHash": {
          "type": "string",
          "format": "byte",
          "title": "The hash digest stored at the root of the merkle tree at the time the proof was generated."
        },
        "treeSize": {
          "type": "string",
          "format": "int64",
          "title": "The size of the merkle tree at the time the proof was generated."
        }
      }
    },
    "dev.sigstore.rekor.v1.KindVersion": {
      "description": "Fields: kind, version",
      "type": "object",
      "title": "KindVersion contains the entry's kind and api version.",
      "properties": {
        "kind": {
          "type": "string",
          "title": "Kind is the type of entry being stored in the log. See here for a list: https://github.com/sigstore/rekor/tree/main/pkg/types"
        },
        "version": {
          "type": "string",
          "title": "The specific api version of the type."
        }
      }
    },
    "dev.sigstore.rekor.v1.TransparencyLogEntry": {
      "description": "Fields: logIndex, logId, kindVersion, integratedTime, inclusionPromise, inclusionProof, canonicalizedBody",
      "type": "object",
      "title": "TransparencyLogEntry captures all the details required from Rekor to reconstruct an entry, given that the payload is provided via other means. This type can easily be created from the existing response from Rekor. Future iterations could rely on Rekor returning the minimal set of attributes (excluding the payload) that are required for verifying the inclusion promise. The inclusion promise (called SignedEntryTimestamp in the response from Rekor) is similar to a Signed Certificate Timestamp as described here https://www.rfc-editor.org/rfc/rfc6962.html#section-3.2.",
      "properties": {
        "canonicalizedBody": {
          "description": "If set, clients MUST verify that the signature referenced in the\n`canonicalized_body` matches the signature provided in the\n`Bundle.content`.\nIf not set, clients are responsible for constructing an equivalent\npayload from other sources to verify the signature.",
          "type": "string",
          "format": "byte",
          "title": "Optional. The canonicalized transparency log entry, used to reconstruct the Signed Entry Timestamp (SET) during verification. The contents of this field are the same as the `body` field in a Rekor response, meaning that it does **not** include the \"full\" canonicalized form (of log index, ID, etc.) which are exposed as separate fields. The verifier is responsible for combining the `canonicalized_body`, `log_index`, `log_id`, and `integrated_time` into the payload that the SET's signature is generated over. This field is intended to be used in cases where the SET cannot be produced determinisitically (e.g. inconsistent JSON field ordering, differing whitespace, etc)."
        },
        "inclusionPromise": {
          "title": "The inclusion promise/signed entry timestamp from the log. Required for v0.1 bundles, and MUST be verified. Optional for \u003e= v0.2 bundles, and SHOULD be verified when present. Also may be used as a signed timestamp.",
          "$ref": "#/definitions/dev.sigstore.rekor.v1.InclusionPromise"
        },
        "inclusionProof": {
          "title": "The inclusion proof can be used for offline or online verification that the entry was appended to the log, and that the log has not been altered.",
          "$ref": "#/definitions/dev.sigstore.rekor.v1.InclusionProof"
        },
        "integratedTime": {
          "type": "string",
          "format": "int64",
          "title": "The UNIX timestamp from the log when the entry was persisted."
        },
        "kindVersion": {
          "title": "The kind (type) and version of the object associated with this entry. These values are required to construct the entry during verification.",
          "$ref": "#/definitions/dev.sigstore.rekor.v1.KindVersion"
        },
        "logId": {
          "title": "The unique identifier of the log.",
          "$ref": "#/definitions/dev.sigstore.common.v1.LogId"
        },
        "logIndex": {
          "type": "string",
          "format": "int64",
          "title": "The global index of the entry, used when querying the log by index."
        }
      }
    },
