#!/bin/bash

while true; do

    RESPONSE=$(curl -sk https://localhost:8081/_explorer/emulator.pem)
    EXIT_STATUS=$?

    if [[ "$EXIT_STATUS" -ne 0 || "$RESPONSE" == '{"code":"NotFound","message":"Not Found"}' ]]; then
        # The emulator's webserver is up, but not ready to serve the cert yet
        echo "Cosmos Emulator cert not available, waiting 5 seconds..."
        sleep 5
    else
        echo "Cosmos Emulator cert is ready"
        echo $RESPONSE > emulatorcert.crt
        break
    fi
done